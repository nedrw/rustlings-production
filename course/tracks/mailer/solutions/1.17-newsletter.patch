+/// rather than `201 Created`, and the difference is the step in one word: the *issue* is created
+/// (and is there when this returns), while the *sending* is work that has been accepted and has not
+/// happened yet.
+///
+/// The order of the two calls below is the whole design: [`newsletter::publish`] is one transaction
+/// — the issue and every copy it is owed to, or nothing — and [`newsletter::fan_out`] runs *after*
+/// it commits. Handing work to the queue inside the transaction would make a full queue into a
+/// rolled-back issue, and a published issue is the one thing this step must not lose.
+async fn newsletter(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    body: Result<Json<NewsletterRequest>, JsonRejection>,
+) -> Response {
+    let Ok(Json(request)) = body else {
+        return (
+            StatusCode::BAD_REQUEST,
+            Json(Body::new(
+                "the body is not an issue: it has to be a JSON object with `subject` and `body`",
+            )),
