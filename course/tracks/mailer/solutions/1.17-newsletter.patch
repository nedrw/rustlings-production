+    let (Some(database), Some(delivery)) = (state.database(), state.delivery()) else {
+        warn!("an issue was published with no database configured");
+        return not_ready("no database is configured");
+    };
+    let identity = match identity(database.pool(), &headers).await {
+        Ok(identity) => identity,
+        Err(error) => return answer(error),
+    };
