+/// The name of the cookie a session travels in.
+///
+/// One name, in one place: the login that sets it, the logout that clears it, and the lookup that
+/// reads it all have to agree, and a constant is how they do.
+const SESSION_COOKIE: &str = "session";
+
+/// `POST /login`: credentials in, a session out (step `mailer/1.16-sessions`).
+///
+/// The answer carries the token twice — in the body it is not, and in a `Set-Cookie` header it is —
+/// and the attributes of that cookie are decisions rather than decorations:
+///
+/// * `HttpOnly` keeps it away from scripts, so a cross-site scripting bug cannot read it;
+/// * `SameSite=Lax` keeps it away from cross-site requests, so another site cannot make a browser
+///   carry it (a form POST is exactly what the confirmation link is not: a GET);
+/// * `Path=/` and `Max-Age` are the scope and the lifetime. The lifetime is *stated* even though the
+///   row has one too, because the two ends should agree about when the session ends.
+///
+/// `Secure` is deliberately absent: this build has no TLS (step `mailer/1.21-container` puts it
+/// behind something that does), and a `Secure` cookie that never arrives is a login that does not
+/// work. The TRAP of this step says what has to change before that is true.
+async fn login(
+    State(state): State<AppState>,
+    body: Result<Json<Credentials>, JsonRejection>,
+) -> Response {
+    let Ok(Json(credentials)) = body else {
+        return (
+            StatusCode::BAD_REQUEST,
+            Json(Body::new(
+                "the body is not a login: it has to be a JSON object with `email` and `password`",
+            )),
+        )
+            .into_response();
+    };
+
+    let Some(database) = state.database() else {
+        warn!("a login arrived with no database configured");
+        return not_ready("no database is configured");
+    };
+
+    match log_in(database.pool(), credentials).await {
+        Ok((token, email)) => {
+            let cookie = format!(
+                "{SESSION_COOKIE}={}; Path=/; HttpOnly; SameSite=Lax; Max-Age={}",
+                token.as_str(),
+                session::SESSION_LIFETIME_SECS as u64
+            );
+            (
+                StatusCode::OK,
+                [(SET_COOKIE, cookie)],
+                Json(SubscriberState {
+                    status: "active",
+                    email: email.to_string(),
+                }),
+            )
+                .into_response()
+        }
+        Err(error) => answer(error),
+    }
+}
