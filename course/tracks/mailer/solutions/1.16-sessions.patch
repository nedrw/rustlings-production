+/// The session token a request carries, from either of the two places one may arrive.
+///
+/// * `Authorization: Bearer <token>` is what a program sends: one header, no browser semantics, and
+///   the same token a browser would have had in a cookie;
+/// * `Cookie: session=<token>` is what a browser sends, and it is a *header with a grammar* — read
+///   as a list of `name=value` pairs, not as a string that happens to contain the token.
+///
+/// # Errors
+///
+/// Reports [`Error::InvalidInput`] when a credential is there but is not a session token: a 400, not
+/// a 401, because the caller has a bug rather than a session that ended.
+fn credential(headers: &HeaderMap) -> Result<Option<SessionToken>, Error> {
+    if let Some(value) = headers.get(AUTHORIZATION) {
+        let value = value.to_str().map_err(|_| Error::NotAuthenticated)?;
+        let token = value
+            .strip_prefix("Bearer ")
+            .ok_or(Error::NotAuthenticated)?;
+        return SessionToken::parse(token.trim()).map(Some);
+    }
+    let Some(value) = headers.get(COOKIE) else {
+        return Ok(None);
+    };
+    let cookies = value.to_str().map_err(|_| Error::NotAuthenticated)?;
+    let token = cookies.split(';').find_map(|pair| {
+        let (name, value) = pair.split_once('=')?;
+        (name.trim() == SESSION_COOKIE).then_some(value.trim())
+    });
+    let Some(token) = token else {
+        return Ok(None);
+    };
+    SessionToken::parse(token).map(Some)
+}
