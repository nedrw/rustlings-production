@@ -0,0 +1,89 @@
+//! Logging in: credentials in, a session out (step `mailer/1.16-sessions`).
+//!
+//! Signing up and logging in are two different questions, and this file exists so that they do not
+//! get mixed up. `POST /signup` asks "is this address free, and can the person at it be reached?";
+//! `POST /login` asks "is this the person who subscribed?" and the answer is a session — a value the
+//! service issues, remembers the hash of, and can end (step `mailer/1.16-sessions`).
+//!
+//! Three things this file is careful about:
+//!
+//! * **the password is verified, never compared.** What the table holds is a PHC string with a salt
+//!   of its own (step `mailer/1.11-signup`), so the check is Argon2 verifying a candidate against
+//!   it — the same algorithm and the same work, whoever says what. A string comparison would be both
+//!   wrong (the salt) and cheap enough to be worth attacking;
+//! * **an unconfirmed subscriber cannot log in.** The address was never proven, so there is nobody
+//!   to authenticate yet, and letting them in would make confirmation a decoration;
+//! * **a login opens a *new* session**. Nothing a caller brought is adopted — the token comes from
+//!   [`session::open`], and the cookie (or `Authorization` header) the client used is only ever read
+//!   from, never trusted as an identity.
+
+use argon2::{Argon2, PasswordHash, PasswordVerifier};
+use serde::Deserialize;
+use sqlx::PgPool;
+
+use crate::domain::{Email, Password};
+use crate::error::Error;
+use crate::session::{self, Token};
+
+/// The body of `POST /login`: the two things a caller knows about themselves.
+///
+/// Raw strings, for the same reason the signup body is (step `mailer/1.11-signup`): what arrives is
+/// text, and the text is parsed where it enters.
+#[derive(Debug, Deserialize)]
+pub struct Credentials {
+    /// The address the subscriber signed up with, as it was sent.
+    pub email: String,
+    /// The password, as it was sent.
+    pub password: String,
+}
+
+/// Verify credentials and open a session for the subscriber they belong to.
+///
+/// The answer is the token (which becomes the `Set-Cookie` of the response) and the address the
+/// session belongs to (which becomes its body). Everything else about the subscriber is looked up
+/// later, by id, when a handler needs it.
+///
+/// # Errors
+///
+/// Reports [`Error::InvalidInput`] when the email or the password is not a value this service
+/// accepts (the field is named, the value is not), [`Error::InvalidCredentials`] when the address
+/// has no subscriber or the password does not match one, [`Error::NotConfirmed`] when it matches a
+/// subscriber who never confirmed their address, [`Error::PasswordHash`] when the stored hash cannot
+/// be read at all (a row this service wrote and cannot use — a deployment problem, not a caller's),
+/// and [`Error::Database`] when the session cannot be written.
+pub async fn log_in(pool: &PgPool, credentials: Credentials) -> Result<(Token, Email), Error> {
+    let email = Email::parse(&credentials.email)?;
+    let password = Password::parse(&credentials.password)?;
+
+    let row = sqlx::query!(
+        "SELECT id, password_hash, status FROM subscribers WHERE email = $1",
+        email.as_str()
+    )
+    .fetch_optional(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "find a subscriber to log in",
+        source: Box::new(source),
+    })?;
+
+    // One answer for "no such address" and "the password is wrong": which of the two it was is a
+    // fact about this service's subscribers, and a caller who is neither does not need it.
+    let Some(row) = row else {
+        return Err(Error::InvalidCredentials);
+    };
+    let stored = PasswordHash::new(&row.password_hash).map_err(|source| Error::PasswordHash {
+        source: source.into(),
+    })?;
+    if Argon2::default()
+        .verify_password(password.as_str().as_bytes(), &stored)
+        .is_err()
+    {
+        return Err(Error::InvalidCredentials);
+    }
+    if row.status != "active" {
+        return Err(Error::NotConfirmed);
+    }
+
+    let token = session::open(pool, row.id).await?;
+    Ok((token, email))
+}
