+impl Error {
+    /// The exit code this failure ends the process with.
+    ///
+    /// The table is the contract a script sees:
+    ///
+    /// | failure | code | who has to act |
+    /// | --- | --- | --- |
+    /// | the caller asked for something this service does not have — an unknown argument, a missing value, a value a setting cannot use, an unknown setting | `2` | whoever started the process |
+    /// | the configuration could not be read or parsed | `1` | whoever deployed it |
+    ///
+    /// Two codes are enough to tell those two apart, and a script that sees `2` knows not to
+    /// retry.
+    #[must_use]
+    pub fn exit_code(&self) -> ExitCode {
+        match self {
+            Error::UnknownArgument { .. }
+            | Error::MissingValue { .. }
+            | Error::InvalidSetting { .. }
+            | Error::UnknownSetting { .. } => ExitCode::from(2),
+            Error::UnreadableConfig { .. } | Error::InvalidConfig { .. } => ExitCode::FAILURE,
+        }
+    }
+}
