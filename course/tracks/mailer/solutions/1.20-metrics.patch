+/// `GET /metrics`: what this process has counted, in the text format a scraper reads
+/// (step `mailer/1.20-metrics`).
+///
+/// Unauthenticated on purpose, and that is a deployment decision rather than an oversight: a scraper
+/// is not a subscriber, and the usual answer is to keep this route somewhere the internet cannot
+/// reach (step `mailer/1.21-container` is where a process gets more than one listener). What is *not*
+/// safe is what the TRAP of this step describes: a metric that carries an address or an id.
+async fn exposition(State(state): State<AppState>) -> Response {
+    (
+        StatusCode::OK,
+        [("content-type", "text/plain; version=0.0.4")],
+        state.metrics().render(),
+    )
+        .into_response()
+}
+
+/// Time every request and count it, by matched route and status (step `mailer/1.20-metrics`).
+///
+/// A middleware rather than a line in each handler, for the reason the whole step exists: a metric
+/// that has to be remembered at nine call sites is a metric that is wrong at three of them. What it
+/// records is the *matched* route — `MatchedPath` is the pattern
+/// (`/subscribers/{id}/deliveries`), not the concrete path — and a request that matched nothing is
+/// one series called `unmatched`, because a path a stranger chose is not a label this service wants.
+async fn measure(
+    State(state): State<AppState>,
+    matched: Option<MatchedPath>,
+    request: Request<axum::body::Body>,
+    next: Next,
+) -> Response {
+    let started = Instant::now();
+    let route = matched.map(|path| path.as_str().to_owned());
+    let response = next.run(request).await;
+    state.metrics().record_request(
+        route.as_deref(),
+        response.status().as_u16(),
+        started.elapsed(),
+    );
+    response
+}
