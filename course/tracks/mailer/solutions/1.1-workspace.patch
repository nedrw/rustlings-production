+//! `mailer` — a subscription service for a newsletter.
+//!
+//! The library is the service; `src/main.rs` is a shell around it. Every decision lives here,
+//! where a test can reach it without starting a process.
+//!
+//! Nothing in this file prints: [`parse`] answers with a [`Request`], and [`Request::exit_code`]
+//! says how the process ends. Turning that into text on a terminal is the binary's job, and it is
+//! what keeps the library usable from a test, a second binary or a future HTTP front end.
+
+use std::process::ExitCode;
+
+/// What the command line asked for, once it has been parsed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Request {
+    /// Print [`USAGE`] and exit successfully.
+    Help,
+    /// Print the version and exit successfully.
+    Version,
+    /// Nothing to do yet: the service has no listener.
+    Idle,
+    /// A flag the service does not know.
+    Unknown(String),
+}
+
+impl Request {
+    /// The exit code this request ends in.
+    ///
+    /// The policy lives here rather than in `main.rs` so a test can pin it: an unknown flag is a
+    /// usage error (2), everything else succeeded.
+    #[must_use]
+    pub fn exit_code(&self) -> ExitCode {
+        match self {
+            Request::Unknown(_) => ExitCode::from(2),
+            _ => ExitCode::SUCCESS,
+        }
+    }
+}
+
+/// Usage text, printed by `--help` and after a bad argument.
+pub const USAGE: &str = "\
+usage: mailer [OPTIONS]
+
+OPTIONS:
+    --help       print this help and exit
+    --version    print the version and exit
+";
+
+/// Parse the arguments a process was started with, program name included.
+///
+/// `--help` and `--version` are recognised here; everything else is a usage error until step 4
+/// replaces this with real configuration.
+#[must_use]
+pub fn parse<I, S>(args: I) -> Request
+where
+    I: IntoIterator<Item = S>,
+    S: AsRef<str>,
+{
+    match args.into_iter().nth(1) {
+        None => Request::Idle,
+        Some(flag) => match flag.as_ref() {
+            "--help" => Request::Help,
+            "--version" => Request::Version,
+            other => Request::Unknown(other.to_owned()),
+        },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Request, parse};
+
+    #[test]
+    fn the_flags_the_service_promises_are_recognised() {
+        assert_eq!(parse(["mailer", "--help"]), Request::Help);
+        assert_eq!(parse(["mailer", "--version"]), Request::Version);
+        assert_eq!(parse(["mailer"]), Request::Idle);
+        assert_eq!(
+            parse(["mailer", "--nope"]),
+            Request::Unknown("--nope".to_owned())
+        );
+    }
+}
