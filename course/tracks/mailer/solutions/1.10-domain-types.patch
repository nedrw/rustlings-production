+
+/// A password must not reach a log line through `{:?}`, so this is written by hand instead of
+/// derived (step `mailer/1.6-logging` is where log lines became a place secrets do not go).
+///
+/// It says that there is a secret, and nothing else about it: not the characters, and not how many
+/// there are — a length is a fact about the secret too.
+impl fmt::Debug for Password {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Password(<redacted>)")
+    }
+}
+
+/// The failure a refused value becomes, with the field that was wrong.
+fn invalid(field: &'static str, expected: &'static str) -> Error {
+    Error::InvalidInput { field, expected }
+}
+
+/// `true` when the part before the `@` is shaped the way this service accepts.
+fn is_local_part(local: &str) -> bool {
+    const ALLOWED: &str = "abcdefghijklmnopqrstuvwxyz0123456789._+-";
+    !local.starts_with('.')
+        && !local.ends_with('.')
+        && !local.contains("..")
+        && local.chars().all(|c| ALLOWED.contains(c))
+}
+
+/// `true` when one label of a domain is a run of letters, digits and `-`.
+fn is_label(label: &str) -> bool {
+    !label.is_empty()
+        && !label.starts_with('-')
+        && !label.ends_with('-')
+        && label.chars().all(|c| c.is_ascii_alphanumeric() || c == '-')
+}
