+/// # Errors
 ///
-/// The scaffold installs no subscriber, so nothing is logged yet.
-pub fn init(_log: &Log, _id: &RunId) -> Result<(), Error> {
-    Ok(())
+/// Reports [`Error::Logging`] when a subscriber is already installed. That cannot happen in this
+/// binary, and it is not swallowed: a service whose logs go somewhere else than it thinks is a
+/// service nobody can debug.
+pub fn init(log: &Log, _id: &RunId) -> Result<(), Error> {
+    let builder = fmt()
+        .with_max_level(filter(log.level))
+        // Colour is for a person watching a terminal. A line a collector stores has to be the
+        // line: escape sequences around the field names make `host=127.0.0.1` unfindable.
+        .with_ansi(std::io::stdout().is_terminal());
+    let installed = match log.format {
+        LogFormat::Json => builder.json().try_init(),
+        LogFormat::Pretty => builder.try_init(),
+    };
+    installed.map_err(|source| Error::Logging { source })
 }
 
-/// Announce what this process is and what it is about to do (step `mailer/1.6-logging`).
+/// Announce what this process is and what it is about to do.
 ///
-/// The scaffold logs nothing: the events, their fields and the span they run inside are the
-/// step's work.
-pub fn announce(_config: &Config, _id: &RunId) {}
+/// The span is the unit of work: it has a name (`run`) and the id every line of this process
+/// carries. `skip_all` keeps the configuration out of the span fields — the fields below are
+/// chosen one by one, because a configuration printed on every line is how secrets leak.
+#[instrument(name = "run", skip_all, fields(run.id = %id.as_str()))]
+pub fn announce(config: &Config, id: &RunId) {
+    let database = if config.database.url.is_some() {
+        "set"
+    } else {
+        "unset"
+    };
+    info!(
+        host = %config.listen.host,
+        port = config.listen.port,
+        log_format = %config.log.format,
+        database = database,
+        "mailer is starting"
+    );
+    debug!("configuration loaded");
+}
+
+/// The configuration's level, as the one the subscriber filters with.
+fn filter(level: ConfigLevel) -> Level {
+    match level {
+        ConfigLevel::Error => Level::ERROR,
+        ConfigLevel::Warn => Level::WARN,
+        ConfigLevel::Info => Level::INFO,
+        ConfigLevel::Debug => Level::DEBUG,
+        ConfigLevel::Trace => Level::TRACE,
+    }
+}
