--- 0001 — the first migration: the `subscribers` table (step `mailer/1.9-postgres`).
+-- 0001 — the `subscribers` table (step `mailer/1.9-postgres`).
 --
 -- `sqlx::migrate!` embeds every file in this directory into the binary at compile time and applies
 -- them in version order: the version is in the file name, `_sqlx_migrations` records what ran, and
 -- a migration that has run anywhere is never edited — the next one is the way to change a schema.
 --
--- The step's TASK lists the table the later steps need. Write it here: this file is what a fresh
--- database becomes.
+-- The columns are the ones steps 1.10–1.18 build on: who a subscriber is (`email`, unique), where
+-- they are in the confirmation dance (`status`, `confirmation_token`, `confirmation_expires_at`,
+-- `confirmed_at`), and when they arrived (`subscribed_at`).
+
+CREATE TABLE subscribers (
+    id                      BIGSERIAL   PRIMARY KEY,
+    email                   TEXT        NOT NULL UNIQUE,
+    name                    TEXT        NOT NULL,
+    password_hash           TEXT        NOT NULL,
+    status                  TEXT        NOT NULL DEFAULT 'pending',
+    confirmation_token      TEXT        UNIQUE,
+    confirmation_expires_at TIMESTAMPTZ,
+    confirmed_at            TIMESTAMPTZ,
+    subscribed_at           TIMESTAMPTZ NOT NULL DEFAULT now(),
+
+    -- The status is a value from a set this code knows, not whatever a caller sends.
+    CONSTRAINT subscribers_status_known
+        CHECK (status IN ('pending', 'active', 'unsubscribed')),
+
+    -- `active` means confirmed. The converse is deliberately *not* asserted: unsubscribing somebody
+    -- who was confirmed must stay possible (step `mailer/1.18-authz-boundary`), so `confirmed_at`
+    -- keeps its value while the status moves on.
+    CONSTRAINT subscribers_active_is_confirmed
+        CHECK (status <> 'active' OR confirmed_at IS NOT NULL)
+);
