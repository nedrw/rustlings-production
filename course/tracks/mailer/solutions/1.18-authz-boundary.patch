+/// One copy of one issue, as the subscriber it belongs to sees it (step `mailer/1.18-authz-boundary`).
+///
+/// This is a *read* of somebody's own data, and it is deliberately shaped as one: the query is scoped
+/// by the subscriber it is asked for, so there is no list of other people's rows to filter afterwards
+/// — and no way to forget to filter it.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct DeliveryRecord {
+    /// The issue this copy is of.
+    pub issue: i64,
+    /// What the issue is about.
+    pub subject: String,
+    /// When the message was handed to the sender, if it has been.
+    pub sent_at: Option<String>,
+    /// How many times it was attempted.
+    pub attempts: i32,
+}
+
+/// The copies of the issues one subscriber was owed, newest first.
+///
+/// The one parameter is the subscriber, and it comes from the *session* (step `mailer/1.16-sessions`),
+/// never from the request: a handler that passes an id it was given in a path has handed the
+/// authorization decision to whoever asked.
+///
+/// # Errors
+///
+/// Reports [`Error::Database`] when the rows cannot be read.
+pub async fn history(pool: &PgPool, subscriber: i64) -> Result<Vec<DeliveryRecord>, Error> {
+    // `sent_at::text` rather than a timestamp: this service reads and writes clocks in SQL
+    // (`now()`), and the type a timestamp would come back as is a dependency on a time crate that
+    // nothing else here needs. What a client wants is a string anyway.
+    let rows = sqlx::query!(
+        "SELECT issue_deliveries.issue_id, \
+                issues.subject, \
+                issue_deliveries.sent_at::text, \
+                issue_deliveries.attempts \
+           FROM issue_deliveries \
+           JOIN issues ON issues.id = issue_deliveries.issue_id \
+          WHERE issue_deliveries.subscriber_id = $1 \
+          ORDER BY issues.id DESC",
+        subscriber
+    )
+    .fetch_all(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "read a subscriber's delivery history",
+        source: Box::new(source),
+    })?;
+
+    Ok(rows
+        .into_iter()
+        .map(|row| DeliveryRecord {
+            issue: row.issue_id,
+            subject: row.subject,
+            sent_at: row.sent_at,
+            attempts: row.attempts,
+        })
+        .collect())
+}
