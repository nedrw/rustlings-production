+/// `GET /subscribers/{id}/deliveries`: the messages one subscriber was owed
+/// (step `mailer/1.18-authz-boundary`).
+///
+/// The id is in the path, and the first thing this handler does is compare it with the identity the
+/// session carries. That comparison is not the authorization, it is the *answer*: a caller asking for
+/// somebody else's id gets the same `404` as a caller asking for an id that was never created, so the
+/// boundary does not double as a way to find out which ids exist.
+///
+/// The query behind it is scoped by the subscriber as well (see [`newsletter::history`]), and that is
+/// deliberate belt-and-braces: the check above is a fact about this handler, while the `WHERE` is a
+/// fact about the statement — and a later route that forgets to compare has still not written the
+/// leak into SQL.
+async fn deliveries_of(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+    headers: HeaderMap,
+) -> Response {
+    let Some(database) = state.database() else {
+        warn!("a delivery history was asked for with no database configured");
+        return not_ready("no database is configured");
+    };
+    let identity = match identity(database.pool(), &headers).await {
+        Ok(identity) => identity,
+        Err(error) => return answer(error),
+    };
+    if identity.subscriber != id {
+        warn!(
+            asked = id,
+            subscriber = identity.subscriber,
+            "a subscriber asked for somebody else's deliveries"
+        );
+        return answer(Error::NotFound { what: "subscriber" });
+    }
+
+    match newsletter::history(database.pool(), identity.subscriber).await {
+        Ok(history) => (StatusCode::OK, Json(history)).into_response(),
+        Err(error) => answer(error),
+    }
+}
