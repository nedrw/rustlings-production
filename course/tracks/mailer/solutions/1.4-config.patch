+/// `mailer.toml` as it is written: every setting optional, so a file may mention one of them, and
+/// unknown ones refused — a misspelled key is a setting the service does not have.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FileConfig {
+    /// `[listen]` section.
+    listen: Option<FileListen>,
+    /// `[log]` section.
+    log: Option<FileLog>,
+    /// `[database]` section.
+    database: Option<FileDatabase>,
+}
+
+/// The `[listen]` section of a configuration file.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FileListen {
+    /// Interface to bind.
+    host: Option<String>,
+    /// Port to bind.
+    port: Option<u16>,
+}
+
+/// The `[log]` section of a configuration file.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FileLog {
+    /// Most verbose level that is printed.
+    level: Option<Level>,
+    /// How a line is rendered.
+    format: Option<LogFormat>,
+}
+
+/// The `[database]` section of a configuration file.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FileDatabase {
+    /// Connection string of the database.
+    url: Option<String>,
+}
+
+/// Read a port out of a string some source handed over.
+///
+/// `u16` already refuses everything outside the range; the message is what turns that into a
+/// sentence about the setting.
+fn port(value: &str) -> Result<u16, BadValue> {
+    value
+        .parse()
+        .map_err(|_| BadValue::new(value, PORT_EXPECTED))
+}
+
