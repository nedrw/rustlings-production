+/// Where the service sends email from (step `mailer/1.19-test-layering`).
+///
+/// Named `EmailSettings` rather than `Email` because `mailer::domain::Email` is a *parsed address*,
+/// and two types with one name in one library is a review comment waiting to happen.
+///
+/// No SMTP host is the default, and it is not a mistake: the adapter then writes messages to the log
+/// (step `mailer/1.13-email-port`), which is what lets every step before this one run without a mail
+/// server. A host is what turns that into SMTP.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct EmailSettings {
+    /// Host of the SMTP server a message is handed to.
+    pub smtp_host: Option<String>,
+    /// Port that server listens on. `None` means the port a mail server is expected on.
+    pub smtp_port: Option<u16>,
+}
