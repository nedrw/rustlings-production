+/// Look again until the condition holds, and fail loudly when the deadline passes.
+///
+/// A drill waits for a *fact* — the queue has moved — and never for a number of seconds: a sleep is
+/// either too short on a loaded machine or wasted time on an idle one, and neither is a statement
+/// about the queue.
+fn wait(postgres: &Postgres, what: &str, condition: impl Fn() -> bool) {
+    let until = Instant::now() + DRILL_DEADLINE;
+    while Instant::now() < until {
+        if condition() {
+            return;
+        }
+        std::thread::sleep(RETRY);
     }
+    panic!(
+        "the drill waited {DRILL_DEADLINE:?} for {what}, and it did not happen (the service is in \
+         {}, and this drill signed up {DRILL_EMAIL})",
+        postgres.query("SELECT count(*) FROM subscribers")
+    );
+}
+
+/// How many times the service has offered this message to a mail server.
+fn attempts(postgres: &Postgres) -> i64 {
+    number(
+        postgres,
+        &format!(
+            "SELECT COALESCE(max(confirmation_attempts), 0) FROM subscribers WHERE email = \
+             '{DRILL_EMAIL}'"
+        ),
+    )
+}
+
+/// Messages the service stopped trying to send: nothing sent, and the attempts it allows are spent.
+fn given_up(postgres: &Postgres) -> usize {
+    number(
+        postgres,
+        &format!(
+            "SELECT count(*) FROM subscribers WHERE confirmation_sent_at IS NULL AND \
+             confirmation_attempts >= {MAX_ATTEMPTS}"
+        ),
+    ) as usize
+}
+
+/// One integer out of one query.
+fn number(postgres: &Postgres, sql: &str) -> i64 {
+    let answered = postgres.query(sql);
+    answered.parse().unwrap_or_else(|_| {
+        panic!("`{sql}` was expected to answer one number, and it answered `{answered}`")
+    })
 }
