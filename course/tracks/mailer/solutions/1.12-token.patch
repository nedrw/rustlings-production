+/// Confirm the subscriber a token was issued for, answering the address it confirmed.
+///
+/// # Errors
+///
+/// Reports [`Error::TokenUnknown`] when no subscriber has that token, [`Error::TokenExpired`] when
+/// the subscriber has it and it is past its expiry, [`Error::AlreadyConfirmed`] when that subscriber
+/// is not waiting for a confirmation any more, and [`Error::Database`] when the statements do not
+/// run.
+///
+/// The address comes back as text rather than as an [`Email`](crate::domain::Email): it came out of
+/// the table, which only ever holds addresses that went through `Email::parse` on their way in, so
+/// there is nothing left to check.
+pub async fn confirm(pool: &PgPool, token: &Token) -> Result<String, Error> {
+    // One statement decides everything: the token has to match, the subscriber has to be waiting,
+    // and the token has to be inside its window. `RETURNING` is how the caller of this statement
+    // learns which of the two it was.
+    let confirmed: Option<String> = sqlx::query_scalar!(
+        "UPDATE subscribers SET status = 'active', confirmed_at = now() WHERE confirmation_token = $1 AND status = 'pending' AND confirmation_expires_at > now() RETURNING email",
+        token.as_str()
+    )
+    .fetch_optional(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "confirm a subscriber",
+        source: Box::new(source),
+    })?;
+
+    if let Some(email) = confirmed {
+        return Ok(email);
+    }
+
+    // The decision is made; this second question only turns "no" into a sentence. The row it reads
+    // is the same one the update just looked at: the token matched (or the update would have failed
+    // on that condition too), the subscriber is not waiting any more, or the window is closed —
+    // and a subscriber who *is* still waiting can only have been refused by the expiry.
+    let refused = sqlx::query!(
+        "SELECT email, status FROM subscribers WHERE confirmation_token = $1",
+        token.as_str()
+    )
+    .fetch_optional(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "read a subscriber",
+        source: Box::new(source),
+    })?;
+
+    match refused {
+        None => Err(Error::TokenUnknown),
+        // `active` is the status a replay meets; `unsubscribed` (step `mailer/1.18-authz-boundary`)
+        // is the other way a subscriber stops waiting, and it gets the same sentence until that step
+        // decides whether it deserves its own.
+        Some(row) if row.status != "pending" => Err(Error::AlreadyConfirmed { email: row.email }),
+        Some(_) => Err(Error::TokenExpired),
+    }
+}
