+/// `GET /confirm?token=…`: confirm the subscriber a token was issued for
+/// (step `mailer/1.12-token`).
+///
+/// The token arrives as text from a stranger, so it is *parsed* before anything else happens
+/// (step `mailer/1.10-domain-types`) — and a value that is not a token at all is a different answer
+/// from a token that nobody was given: a 400 says "you sent something that is not a link", and the
+/// 404 that follows says "that link is not good any more".
+async fn confirm(
+    State(state): State<AppState>,
+    query: Result<Query<ConfirmQuery>, QueryRejection>,
+) -> Response {
+    let Ok(Query(query)) = query else {
+        return (
+            StatusCode::BAD_REQUEST,
+            Json(Body::new(
+                "the confirmation link has no token: it has to be `/confirm?token=<token>`",
+            )),
+        )
+            .into_response();
+    };
+
+    let token = match Token::parse(&query.token) {
+        Ok(token) => token,
+        Err(error) => return answer(error),
+    };
+
+    let Some(database) = state.database() else {
+        warn!("a confirmation arrived with no database configured");
+        return not_ready("no database is configured");
+    };
+
+    match confirmation::confirm(database.pool(), &token).await {
+        Ok(email) => (
+            StatusCode::OK,
+            Json(SubscriberState {
+                status: "active",
+                email,
+            }),
+        )
+            .into_response(),
+        Err(error) => answer(error),
+    }
+}
