@@ -0,0 +1,89 @@
+//! The database: one pool, the schema, and the two questions the service asks it
+//! (step `mailer/1.9-postgres`).
+//!
+//! This file is the scaffold: the types and the signatures below are the shape the step needs (and
+//! the shape its spec talks to), and the bodies are what the step is about. **The scaffold proves
+//! nothing about a database** — it never opens a connection, applies no migration, and answers
+//! `ready` without asking — so every test in the spec fails until the step fills these in.
+
+use std::time::Duration;
+
+use sqlx::PgPool;
+use sqlx::postgres::PgPoolOptions;
+use tracing::info;
+
+use crate::error::Error;
+
+/// How many connections one process keeps open.
+///
+/// Small on purpose: the pool is a budget, and a process that may only use five connections is one
+/// that cannot take a database down by itself.
+pub const MAX_CONNECTIONS: u32 = 5;
+
+/// How long the pool may take to hand out a connection before it gives up.
+///
+/// A deadline a rollout can wait for. sqlx' default is thirty seconds, which turns a database that
+/// is away into a service that looks hung.
+pub const ACQUIRE_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// The database this process talks to.
+///
+/// Cloneable because it travels in the application state (one pool, many handlers): cloning a
+/// [`PgPool`] clones a handle, not a connection.
+#[derive(Debug, Clone)]
+pub struct Database {
+    pool: PgPool,
+}
+
+impl Database {
+    /// Connect, and prove it.
+    ///
+    /// # Errors
+    ///
+    /// Reports [`Error::Database`] with the operation `connect` when the URL cannot be parsed or no
+    /// connection can be established within [`ACQUIRE_TIMEOUT`].
+    ///
+    /// The scaffold parses the URL and describes the pool; it does not connect, and it does not
+    /// check that the database is there.
+    pub async fn connect(url: &str) -> Result<Self, Error> {
+        let pool = PgPoolOptions::new()
+            .max_connections(MAX_CONNECTIONS)
+            .acquire_timeout(ACQUIRE_TIMEOUT)
+            .connect_lazy(url)
+            .map_err(|source| Error::Database {
+                operation: "connect",
+                source: Box::new(source),
+            })?;
+        info!(max_connections = MAX_CONNECTIONS, "database configured");
+        Ok(Self { pool })
+    }
+
+    /// Bring the schema up to date: every migration in `migrations/`, in version order.
+    ///
+    /// # Errors
+    ///
+    /// Reports [`Error::Migration`] when a migration fails, and when the database holds a version
+    /// this build does not know — a schema from the future is not something to serve from.
+    ///
+    /// The scaffold applies nothing: an empty database stays empty.
+    pub async fn migrate(&self) -> Result<(), Error> {
+        Ok(())
+    }
+
+    /// Whether the schema this process needs is there and answering.
+    ///
+    /// # Errors
+    ///
+    /// Reports [`Error::Database`] with the operation `readiness` when the query does not run.
+    ///
+    /// The scaffold answers yes without asking, which is exactly the difference the step is about.
+    pub async fn ready(&self) -> Result<(), Error> {
+        Ok(())
+    }
+
+    /// The pool, for the queries the later steps add.
+    #[must_use]
+    pub fn pool(&self) -> &PgPool {
+        &self.pool
+    }
+}
