index 0000000..56e02e4
--- /dev/null
+++ b/src/confirmation.rs
@@ -0,0 +1,115 @@
+//! Confirmation tokens: issued at signup, good for one confirmation, until they expire
+//! (step `mailer/1.12-token`).
+//!
+//! This file is the scaffold: the token type, the window it is good for, and the two ways a token is
+//! ever made — issued (random) or parsed (out of a link). **It proves nothing about a token**: the
+//! scaffold's `issue` answers the same value every time, and the confirmation itself is not written
+//! yet, so the spec fails here until the step fills these in.
+//!
+//! A token is the one thing that turns "somebody typed an address into a form" into "somebody who can
+//! read that address agreed to it", and three failures are designed against: **tampered** (so the
+//! token is 32 random bytes and is looked up, never checked), **expired** (so the window is stamped
+//! and compared by the database's clock), and **replayed** (so the statement that confirms a
+//! subscriber also checks that it may). The step's TRAP section names what each of them looks like
+//! when it was never designed for.
+
+use std::fmt;
+
+use crate::error::Error;
+
+/// How many bytes of randomness a token is made of.
+///
+/// 256 bits: an attacker who tries a million tokens a second for the age of the universe gets
+/// nowhere near the odds of a coin landing heads a hundred times in a row.
+pub const TOKEN_BYTES: usize = 32;
+
+/// How long a confirmation link is good for, in seconds.
+///
+/// A day: long enough that somebody can find the email tomorrow morning, short enough that a mailbox
+/// left open on a shared machine is not a standing offer.
+pub const CONFIRMATION_WINDOW_SECS: f64 = 24.0 * 60.0 * 60.0;
+
+/// A confirmation token, as it travels in a link.
+///
+/// The field is private and there is no constructor that takes text: a `Token` is either issued
+/// (random bytes) or *parsed* from what arrived in the URL, and nothing else can make one. What
+/// leaves this type is a string; what never leaves it by accident is a `Display` — there is none, so
+/// a token cannot be interpolated into a message or a log line without saying so out loud.
+#[derive(Clone, PartialEq, Eq)]
+pub struct Token(String);
+
+impl Token {
+    /// Issue a token nobody can guess: [`TOKEN_BYTES`] bytes from the system, as lower-case hex.
+    ///
+    /// # Errors
+    ///
+    /// Reports the failure the step's TASK adds to [`Error`] when the system's random number
+    /// generator fails. There is no fallback on purpose: a token this service invented would be a
+    /// token an attacker can invent too, so a request that cannot get randomness does not get a
+    /// token.
+    ///
+    /// The scaffold does not ask the system for anything: it answers the same value for every
+    /// subscriber, which is the first thing `spec/1.12/confirmation.rs` catches.
+    pub fn issue() -> Result<Self, Error> {
+        Ok(Self(hex(&[0u8; TOKEN_BYTES])))
+    }
+
+    /// Read a token out of what a caller sent.
+    ///
+    /// # Errors
+    ///
+    /// Reports [`Error::InvalidInput`] with the field `token` when the text is not what this service
+    /// issues: lower-case hex, [`TOKEN_BYTES`] bytes of it. A well-formed token that belongs to
+    /// nobody is *not* this failure — it is [`Error::TokenUnknown`], and the difference matters,
+    /// because the first is "you sent something that is not a token" (400) and the second is "that
+    /// link is not good" (404).
+    pub fn parse(value: &str) -> Result<Self, Error> {
+        let hex = invalid_token();
+        if value.len() != TOKEN_BYTES * 2 {
+            return Err(hex);
+        }
+        if !value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        {
+            return Err(hex);
+        }
+        Ok(Self(value.to_owned()))
+    }
+
+    /// The token as it travels: lower-case hex.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+/// A token is a secret: anybody holding one can confirm that address, so `{:?}` says that there is
+/// one and nothing else (step `mailer/1.10-domain-types` made the same call for a password).
+impl fmt::Debug for Token {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Token(<redacted>)")
+    }
+}
+
+/// The failure a token that is not a token becomes.
+fn invalid_token() -> Error {
+    Error::InvalidInput {
+        field: "token",
+        expected: "a confirmation token: 64 characters of lower-case hex",
+    }
+}
+
+/// The lower-case hex spelling of some bytes.
+///
+/// Hex rather than the raw bytes or a base64: a confirmation link is text somebody may have to copy
+/// by hand, and every character here survives a URL, an email client's line wrapping and a shell.
+fn hex(bytes: &[u8]) -> String {
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push(DIGITS[usize::from(byte >> 4)] as char);
+        out.push(DIGITS[usize::from(byte & 0x0f)] as char);
+    }
+    out
+}
