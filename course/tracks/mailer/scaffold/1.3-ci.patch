+//! `cargo xtask` — this project's own tasks, so CI and a human run exactly the same thing.
+//!
+//! The dispatch below is the shape to keep; `ci` is the one that has to be filled in
+//! (step `mailer/1.3-ci`).
+
+use std::process::ExitCode;
+
+fn main() -> ExitCode {
+    let task = std::env::args().nth(1).unwrap_or_default();
+    match task.as_str() {
+        "ci" => ci(),
+        "" => {
+            eprintln!("usage: cargo xtask ci");
+            ExitCode::from(2)
+        }
+        other => {
+            eprintln!("unknown task `{other}`: try `cargo xtask ci`");
+            ExitCode::from(2)
+        }
+    }
+}
+
+/// Run every check CI runs, and fail on the first one that does.
+fn ci() -> ExitCode {
+    eprintln!("cargo xtask ci is not implemented yet — see mailer/1.3-ci");
+    ExitCode::from(1)
+}
