index 0000000..8390e34
--- /dev/null
+++ b/migrations/0004_newsletter.sql
@@ -0,0 +1,46 @@
+-- 0004 — publishing an issue, and who is owed a copy (step `mailer/1.17-newsletter`).
+--
+-- The newsletter changes the shape of the work: a confirmation is one message per subscriber, while
+-- an issue is one message *per subscriber per issue*. That is what the second table is for — the
+-- delivery of one issue to one subscriber, with the same three states the confirmation uses
+-- (claimed / sent / attempts), and a key that says exactly what the row is:
+--
+--     UNIQUE (issue_id, subscriber_id)
+--
+-- The uniqueness is the idempotency of this step, and it is what makes the fan-out safe to run
+-- twice: the rows are written once per (issue, subscriber) and a second attempt inserts nothing.
+--
+-- Why the two tables are written together: an issue without deliveries is an issue nobody will ever
+-- receive, and deliveries without an issue are rows pointing at nothing. They are one change to the
+-- database, so they are written in one transaction (the step's whole point) — and the queue is filled
+-- *after* that transaction commits, because a full queue is a reason to try again later, not a
+-- reason to throw away a published issue.
+--
+-- The two `CHECK`s are the database's half of a rule the code also enforces (step
+-- `mailer/1.10-domain-types` makes the same argument for the domain types): a subject that is empty
+-- is not a subject, and a body that is empty is not a newsletter. The code's half turns a bad value
+-- into a `400` with a sentence; the database's half is what a second caller — a migration, a script,
+-- a person with `psql` — cannot get around.
+
+CREATE TABLE issues (
+    id           BIGSERIAL   PRIMARY KEY,
+    subject      TEXT        NOT NULL CHECK (length(subject) BETWEEN 1 AND 200),
+    body         TEXT        NOT NULL CHECK (length(body) BETWEEN 1 AND 4000),
+    published_by BIGINT      NOT NULL REFERENCES subscribers(id),
+    published_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
+CREATE TABLE issue_deliveries (
+    id            BIGSERIAL   PRIMARY KEY,
+    issue_id      BIGINT      NOT NULL REFERENCES issues(id) ON DELETE CASCADE,
+    subscriber_id BIGINT      NOT NULL REFERENCES subscribers(id) ON DELETE CASCADE,
+    claimed_at    TIMESTAMPTZ,
+    sent_at       TIMESTAMPTZ,
+    attempts      INTEGER     NOT NULL DEFAULT 0,
+    UNIQUE (issue_id, subscriber_id)
+);
+
+-- The question the fan-out asks ("which copies of this issue are still owed?") is a question about
+-- the issue, and the question a worker asks ("which copies are still owed at all?") is a question
+-- about what has not been sent.
+CREATE INDEX issue_deliveries_unsent_idx ON issue_deliveries (issue_id) WHERE sent_at IS NULL;
