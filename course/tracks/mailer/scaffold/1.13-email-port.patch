index 0000000..d1e4ff0
--- /dev/null
+++ b/src/email.rs
@@ -0,0 +1,126 @@
+//! Sending email: a port, and the first adapter behind it (step `mailer/1.13-email-port`).
+//!
+//! What this service needs is not "an SMTP client": it is *somewhere a message goes*. Writing that
+//! down as a trait is what makes the difference between a service that can only be tested with a
+//! mail server running and one whose tests hand it a fake and read what it was given.
+//!
+//! Two shapes in this file are decisions rather than taste:
+//!
+//! * **the future is boxed**. The state holds `Arc<dyn EmailSender>` (a handler cannot be generic
+//!   over the state), and a trait's `async fn` is not dispatchable through a trait object, so every
+//!   send pays for one allocation. That is the price of a seam a test can put a fake in, and it is
+//!   paid once per message;
+//! * **the port says nothing about SMTP** — no host, no credentials, no retry. An adapter that needs
+//!   those reads them from its own construction (step `mailer/1.9-postgres` does the same for the
+//!   database), and the caller only learns whether the message was taken.
+//!
+//! The adapter this build runs with is [`Logging`]: T1 has no mail server until step
+//! `mailer/1.19-test-layering`, so a message is a log line today, and the fake the tests use is not
+//! in this file at all — it is part of the test harness, where a fake belongs.
+
+use std::error::Error as StdError;
+use std::fmt;
+use std::future::Future;
+use std::pin::Pin;
+
+use tracing::info;
+
+use crate::domain::Email;
+
+/// The subject every confirmation email carries.
+pub const CONFIRMATION_SUBJECT: &str = "Confirm your subscription";
+
+/// Where the link in that email points.
+///
+/// A constant for now, and deliberately: nothing in this step deploys the service anywhere, so there
+/// is nothing for a setting to be *set* to. A real deployment makes this a configuration setting —
+/// and the TRAP of this step says why that has to happen before the first real mail goes out.
+pub const CONFIRMATION_BASE_URL: &str = "http://localhost:8080";
+
+/// One message this service wants delivered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Message {
+    /// Who it goes to, as an address that has already been parsed: nothing downstream has to check
+    /// it again (step `mailer/1.10-domain-types`).
+    pub to: Email,
+    /// What the message is about.
+    pub subject: String,
+    /// What it says: plain text, which every mail client can read.
+    pub body: String,
+}
+
+/// Why an adapter could not take a message.
+///
+/// The cause is kept, because "the email could not be sent" is never enough to act on: step
+/// `mailer/1.5-errors`'s rule about sources holds for an adapter's failures too, and the adapter is
+/// the only layer that knows what a mail server actually said.
+pub struct SendError(Box<dyn StdError + Send + Sync>);
+
+impl SendError {
+    /// Wrap what the adapter reported.
+    #[must_use]
+    pub fn new(source: impl Into<Box<dyn StdError + Send + Sync>>) -> Self {
+        Self(source.into())
+    }
+}
+
+impl fmt::Display for SendError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("the email could not be sent")
+    }
+}
+
+impl fmt::Debug for SendError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("SendError").field(&self.0).finish()
+    }
+}
+
+impl StdError for SendError {
+    fn source(&self) -> Option<&(dyn StdError + 'static)> {
+        Some(&*self.0)
+    }
+}
+
+/// The port: everything this service needs from "something that can send email".
+///
+/// `Debug` is a supertrait so that the state holding an `Arc<dyn EmailSender>` can still be printed
+/// in a panic message or a `{:?}` field; `Send + Sync + 'static` are what an `Arc` held across
+/// `await` points and moved between threads needs.
+pub trait EmailSender: Send + Sync + fmt::Debug + 'static {
+    /// Hand one message over.
+    ///
+    /// # Errors
+    ///
+    /// Reports [`SendError`] when the adapter could not take it — a mail server that is away, a
+    /// mailbox that is full. Whether that ends the operation that wanted the message sent is the
+    /// *caller's* decision, and it is the decision this step is about.
+    fn send(
+        &self,
+        message: Message,
+    ) -> Pin<Box<dyn Future<Output = Result<(), SendError>> + Send + '_>>;
+}
+
+/// The adapter this build runs with: it writes the message to the log.
+///
+/// What it prints is the envelope — the address and the subject — and not the body: the body of a
+/// confirmation email carries the token, and a token in a log line is a token anybody with the logs
+/// can use (step `mailer/1.6-logging`).
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Logging;
+
+impl EmailSender for Logging {
+    fn send(
+        &self,
+        message: Message,
+    ) -> Pin<Box<dyn Future<Output = Result<(), SendError>> + Send + '_>> {
+        Box::pin(async move {
+            info!(
+                to = %message.to,
+                subject = %message.subject,
+                "an email would be sent"
+            );
+            Ok(())
+        })
+    }
+}
diff --git a/tests/support/app.rs b/tests/support/app.rs
new file mode 100644
index 0000000..7710a41
--- /dev/null
+++ b/tests/support/app.rs
@@ -0,0 +1,170 @@
+//! An app fixture built with the sender a test chose (step `mailer/1.13-email-port`).
+//!
+//! The factory of step `mailer/1.8-test-harness` (`tests/support/mod.rs`) builds its state with
+//! `AppState::start`, and it cannot grow a second constructor: the only regions this project's
+//! scaffolds may write into are the marked blocks in `Cargo.toml`. So the fixture that takes a
+//! sender lives here, and a spec pulls it in with `#[path = "support/app.rs"] mod app;`.
+//!
+//! Same shape, same promises as `TestApp` — the state is built before the socket is armed, the port
+//! is the operating system's choice, the runtime lives in a thread so a test can be an ordinary
+//! `#[test]`, and dropping the value stops the app — with one difference: the port is an argument.
+
+use std::io::{Read, Write};
+use std::net::{SocketAddr, TcpListener as StdListener, TcpStream};
+use std::sync::Arc;
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+use mailer::config::{Config, Flags};
+use mailer::email::EmailSender;
+use mailer::http::{self, AppState};
+use mailer::logging::RunId;
+use serde_json::json;
+use tokio::sync::oneshot;
+
+/// How long the harness waits for the service to accept connections.
+const READY_DEADLINE: Duration = Duration::from_secs(20);
+/// How often it tries again.
+const RETRY: Duration = Duration::from_millis(20);
+
+/// A service built with the sender a test chose.
+pub struct App {
+    address: SocketAddr,
+    shutdown: Option<oneshot::Sender<()>>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl App {
+    /// Start the service on a free port, with this configuration and this sender.
+    pub fn start(config: Config, sender: Arc<dyn EmailSender>) -> Self {
+        let listener = StdListener::bind("127.0.0.1:0")
+            .unwrap_or_else(|error| panic!("no port could be bound for the test app: {error}"));
+        let address = listener
+            .local_addr()
+            .expect("a bound listener has an address");
+        listener
+            .set_nonblocking(true)
+            .expect("the listener can be made non-blocking");
+
+        let (shutdown, stopped) = oneshot::channel();
+        let id = RunId::of_this_process();
+        let thread = std::thread::Builder::new()
+            .name("test-app".to_owned())
+            .spawn(move || {
+                let runtime = tokio::runtime::Builder::new_multi_thread()
+                    .enable_all()
+                    .build()
+                    .expect("the test app's runtime starts");
+                runtime.block_on(async move {
+                    let state = match AppState::start_with_sender(config, &id, sender).await {
+                        Ok(state) => state,
+                        Err(error) => {
+                            eprintln!("the test app could not start: {error}");
+                            return;
+                        }
+                    };
+                    let listener = tokio::net::TcpListener::from_std(listener)
+                        .expect("the listener is handed to the runtime");
+                    tokio::select! {
+                        result = http::serve_on(listener, state, &id) => {
+                            if let Err(error) = result {
+                                eprintln!("the test app stopped: {error}");
+                            }
+                        }
+                        _ = stopped => {}
+                    }
+                });
+            })
+            .expect("the test app's thread starts");
+
+        let app = Self {
+            address,
+            shutdown: Some(shutdown),
+            thread: Some(thread),
+        };
+        app.wait_until_ready();
+        app
+    }
+
+    /// One `POST` with a JSON body, answered as `(status, body)`.
+    pub fn post(&self, path: &str, body: &str) -> (u16, String) {
+        let mut stream = TcpStream::connect(self.address).unwrap_or_else(|error| {
+            panic!(
+                "the test app at {} is not accepting connections: {error}",
+                self.address
+            )
+        });
+        stream
+            .set_read_timeout(Some(READY_DEADLINE))
+            .expect("a read deadline can be set");
+        let request = format!(
+            "POST {path} HTTP/1.1\r\nhost: {}\r\ncontent-type: application/json\r\n\
+             content-length: {}\r\nconnection: close\r\n\r\n{body}",
+            self.address,
+            body.len()
+        );
+        stream
+            .write_all(request.as_bytes())
+            .unwrap_or_else(|error| panic!("the request could not be sent: {error}"));
+        let mut raw = String::new();
+        stream
+            .read_to_string(&mut raw)
+            .unwrap_or_else(|error| panic!("the answer could not be read: {error}"));
+
+        let (head, body) = raw
+            .split_once("\r\n\r\n")
+            .unwrap_or_else(|| panic!("an HTTP answer has a head and a body: `{raw}`"));
+        let status = head
+            .lines()
+            .next()
+            .and_then(|line| line.split_whitespace().nth(1))
+            .and_then(|code| code.parse().ok())
+            .unwrap_or_else(|| panic!("the status line has a code: `{head}`"));
+        (status, body.to_owned())
+    }
+
+    /// Wait until the service accepts connections, so no test has to sleep and hope.
+    fn wait_until_ready(&self) {
+        let deadline = Instant::now() + READY_DEADLINE;
+        while Instant::now() < deadline {
+            if TcpStream::connect(self.address).is_ok() {
+                return;
+            }
+            std::thread::sleep(RETRY);
+        }
+        panic!(
+            "the test app at {} never started accepting connections",
+            self.address
+        );
+    }
+}
+
+impl Drop for App {
+    fn drop(&mut self) {
+        if let Some(shutdown) = self.shutdown.take() {
+            let _ = shutdown.send(());
+        }
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+/// The configuration a test starts the service with: the defaults, plus what the test adds.
+#[must_use]
+pub fn config(env: &[(String, String)]) -> Config {
+    Config::load(&Flags::default(), env).expect("the fixture configuration is valid")
+}
+
+/// The setting a service reads its database from (step `mailer/1.4-config`).
+#[must_use]
+pub fn database_setting(url: &str) -> (String, String) {
+    ("MAILER__DATABASE__URL".to_owned(), url.to_owned())
+}
+
+/// One signup body, as a caller writes it.
+#[must_use]
+pub fn signup_body(email: &str) -> String {
+    json!({ "email": email, "name": "Ada Lovelace", "password": "correct horse battery staple" })
+        .to_string()
+}
