index 0000000..3571169
--- /dev/null
+++ b/tests/support/email.rs
@@ -0,0 +1,108 @@
+//! A sender that records what it was given (step `mailer/1.13-email-port`).
+//!
+//! This is part of the *harness*, not of the service: a spec pulls it in with
+//! `#[path = "support/email.rs"] mod email;` and gets a sender that keeps every message it was
+//! handed, so a test can ask what the service tried to send. Nothing about it is in `src/`.
+//!
+//! Two decisions worth naming, because they are what "a fake instead of a mock" means:
+//!
+//! * **failure injection is a constructor's business** — [`Recording::fail_with`] makes the next
+//!   sends fail and [`Recording::clear_failure`] lets them through again. A test writes "and the mail
+//!   server is away" without a network, a server, or a mocking framework that has to be told what a
+//!   `send` call looks like;
+//! * **the fake keeps the *envelope*, not a summary of it** — the whole [`Message`], because the
+//!   questions a test asks about an email (`who`, `what subject`, and does the body carry the link
+//!   with the token the row holds) are all questions about the message itself.
+
+// A spec reaches this module through the drill it declares, and uses the part of the harness that
+// drill needs: the same rule the four other support files follow.
+#![allow(dead_code)]
+
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Mutex;
+
+use mailer::email::{EmailSender, Message, SendError};
+
+/// A sender that remembers, and can be told to fail.
+#[derive(Debug, Default)]
+pub struct Recording {
+    /// Every message handed over, whether it was delivered or refused.
+    attempted: Mutex<Vec<Message>>,
+    /// The messages that were actually taken.
+    delivered: Mutex<Vec<Message>>,
+    /// The reason every send fails with, while it is set.
+    failure: Mutex<Option<String>>,
+}
+
+impl Recording {
+    /// A sender that has been given nothing and refuses nothing.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Make every send fail from now on, with this reason.
+    pub fn fail_with(&self, reason: &str) {
+        *self
+            .failure
+            .lock()
+            .expect("the fixture lock is not poisoned") = Some(reason.to_owned());
+    }
+
+    /// Let sends through again.
+    pub fn clear_failure(&self) {
+        *self
+            .failure
+            .lock()
+            .expect("the fixture lock is not poisoned") = None;
+    }
+
+    /// Every message this sender was handed, delivered or not.
+    #[must_use]
+    pub fn attempted(&self) -> Vec<Message> {
+        self.attempted
+            .lock()
+            .expect("the fixture lock is not poisoned")
+            .clone()
+    }
+
+    /// The messages this sender took.
+    #[must_use]
+    pub fn delivered(&self) -> Vec<Message> {
+        self.delivered
+            .lock()
+            .expect("the fixture lock is not poisoned")
+            .clone()
+    }
+
+    /// What this sender is about to answer with.
+    fn failing(&self) -> Option<String> {
+        self.failure
+            .lock()
+            .expect("the fixture lock is not poisoned")
+            .clone()
+    }
+}
+
+impl EmailSender for Recording {
+    fn send(
+        &self,
+        message: Message,
+    ) -> Pin<Box<dyn Future<Output = Result<(), SendError>> + Send + '_>> {
+        Box::pin(async move {
+            self.attempted
+                .lock()
+                .expect("the fixture lock is not poisoned")
+                .push(message.clone());
+            if let Some(reason) = self.failing() {
+                return Err(SendError::new(std::io::Error::other(reason)));
+            }
+            self.delivered
+                .lock()
+                .expect("the fixture lock is not poisoned")
+                .push(message);
+            Ok(())
+        })
+    }
+}
