index 0000000..d1e4ff0
--- /dev/null
+++ b/src/email.rs
@@ -0,0 +1,126 @@
+//! Sending email: a port, and the first adapter behind it (step `mailer/1.13-email-port`).
+//!
+//! What this service needs is not "an SMTP client": it is *somewhere a message goes*. Writing that
+//! down as a trait is what makes the difference between a service that can only be tested with a
+//! mail server running and one whose tests hand it a fake and read what it was given.
+//!
+//! Two shapes in this file are decisions rather than taste:
+//!
+//! * **the future is boxed**. The state holds `Arc<dyn EmailSender>` (a handler cannot be generic
+//!   over the state), and a trait's `async fn` is not dispatchable through a trait object, so every
+//!   send pays for one allocation. That is the price of a seam a test can put a fake in, and it is
+//!   paid once per message;
+//! * **the port says nothing about SMTP** — no host, no credentials, no retry. An adapter that needs
+//!   those reads them from its own construction (step `mailer/1.9-postgres` does the same for the
+//!   database), and the caller only learns whether the message was taken.
+//!
+//! The adapter this build runs with is [`Logging`]: T1 has no mail server until step
+//! `mailer/1.19-test-layering`, so a message is a log line today, and the fake the tests use is not
+//! in this file at all — it is part of the test harness, where a fake belongs.
+
+use std::error::Error as StdError;
+use std::fmt;
+use std::future::Future;
+use std::pin::Pin;
+
+use tracing::info;
+
+use crate::domain::Email;
+
+/// The subject every confirmation email carries.
+pub const CONFIRMATION_SUBJECT: &str = "Confirm your subscription";
+
+/// Where the link in that email points.
+///
+/// A constant for now, and deliberately: nothing in this step deploys the service anywhere, so there
+/// is nothing for a setting to be *set* to. A real deployment makes this a configuration setting —
+/// and the TRAP of this step says why that has to happen before the first real mail goes out.
+pub const CONFIRMATION_BASE_URL: &str = "http://localhost:8080";
+
+/// One message this service wants delivered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Message {
+    /// Who it goes to, as an address that has already been parsed: nothing downstream has to check
+    /// it again (step `mailer/1.10-domain-types`).
+    pub to: Email,
+    /// What the message is about.
+    pub subject: String,
+    /// What it says: plain text, which every mail client can read.
+    pub body: String,
+}
+
+/// Why an adapter could not take a message.
+///
+/// The cause is kept, because "the email could not be sent" is never enough to act on: step
+/// `mailer/1.5-errors`'s rule about sources holds for an adapter's failures too, and the adapter is
+/// the only layer that knows what a mail server actually said.
+pub struct SendError(Box<dyn StdError + Send + Sync>);
+
+impl SendError {
+    /// Wrap what the adapter reported.
+    #[must_use]
+    pub fn new(source: impl Into<Box<dyn StdError + Send + Sync>>) -> Self {
+        Self(source.into())
+    }
+}
+
+impl fmt::Display for SendError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("the email could not be sent")
+    }
+}
+
+impl fmt::Debug for SendError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("SendError").field(&self.0).finish()
+    }
+}
+
+impl StdError for SendError {
+    fn source(&self) -> Option<&(dyn StdError + 'static)> {
+        Some(&*self.0)
+    }
+}
+
+/// The port: everything this service needs from "something that can send email".
+///
+/// `Debug` is a supertrait so that the state holding an `Arc<dyn EmailSender>` can still be printed
+/// in a panic message or a `{:?}` field; `Send + Sync + 'static` are what an `Arc` held across
+/// `await` points and moved between threads needs.
+pub trait EmailSender: Send + Sync + fmt::Debug + 'static {
+    /// Hand one message over.
+    ///
+    /// # Errors
+    ///
+    /// Reports [`SendError`] when the adapter could not take it — a mail server that is away, a
+    /// mailbox that is full. Whether that ends the operation that wanted the message sent is the
+    /// *caller's* decision, and it is the decision this step is about.
+    fn send(
+        &self,
+        message: Message,
+    ) -> Pin<Box<dyn Future<Output = Result<(), SendError>> + Send + '_>>;
+}
+
+/// The adapter this build runs with: it writes the message to the log.
+///
+/// What it prints is the envelope — the address and the subject — and not the body: the body of a
+/// confirmation email carries the token, and a token in a log line is a token anybody with the logs
+/// can use (step `mailer/1.6-logging`).
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Logging;
+
+impl EmailSender for Logging {
+    fn send(
+        &self,
+        message: Message,
+    ) -> Pin<Box<dyn Future<Output = Result<(), SendError>> + Send + '_>> {
+        Box::pin(async move {
+            info!(
+                to = %message.to,
+                subject = %message.subject,
+                "an email would be sent"
+            );
+            Ok(())
+        })
+    }
+}
