diff --git a/migrations/0002_confirmation_delivery.sql b/migrations/0002_confirmation_delivery.sql
new file mode 100644
index 0000000..19dc6e2
--- /dev/null
+++ b/migrations/0002_confirmation_delivery.sql
@@ -0,0 +1,28 @@
+-- 0002 — the confirmation delivery state machine (step `mailer/1.15-idempotent-delivery`).
+--
+-- A confirmation email is a side effect, and what has to happen exactly once per subscriber is the
+-- *delivery* of it. `confirmation_sent_at` is that fact: while it is null, something is still owed
+-- to this subscriber, and a worker may claim it.
+--
+-- The three columns are the states of one transition:
+--
+-- * `confirmation_claimed_at` — a worker is sending this right now. It is what makes a claim
+--   *exclusive*: `UPDATE … WHERE confirmation_claimed_at IS NULL` hands its `RETURNING` row to
+--   exactly one caller, which is the same trick step `mailer/1.11-signup` plays with a unique
+--   constraint, one table over;
+-- * `confirmation_sent_at` — the message was handed to the sender. It is written *after* the send,
+--   and it is what makes every later job for the same subscriber do nothing;
+-- * `confirmation_attempts` — how many times a worker claimed it. A row that ran out of attempts is
+--   a message this service gave up on, and counting is what makes "gave up" visible instead of
+--   silent.
+--
+-- Why columns rather than a `deliveries` table: there is one kind of message today, so "the
+-- confirmation email of subscriber X" is one fact about X. A second kind of message — the
+-- newsletter issue of step `mailer/1.17-newsletter` — is where `deliveries` with
+-- `UNIQUE (subscriber_id, kind)` earns its place; the identity of a delivery is what must not
+-- collide, and a table is how more than one identity is spelled.
+
+ALTER TABLE subscribers
+    ADD COLUMN confirmation_claimed_at TIMESTAMPTZ,
+    ADD COLUMN confirmation_sent_at    TIMESTAMPTZ,
+    ADD COLUMN confirmation_attempts   INTEGER NOT NULL DEFAULT 0;
diff --git a/src/deliveries.rs b/src/deliveries.rs
