index 0000000..eeb8eaa
--- /dev/null
+++ b/src/deliveries.rs
@@ -0,0 +1,165 @@
+//! The confirmation delivery state machine: claim, send, record (step
+//! `mailer/1.15-idempotent-delivery`).
+//!
+//! Step `mailer/1.14-worker` moved the send off the request path. This step is about what happens
+//! when the same message is *offered* twice: the request that queued it may lose its answer, the
+//! process may be restarted, two workers may hold a job for one subscriber, and the worker itself
+//! retries. A mail server can only do what it is told, so "one email per subscriber" is not a
+//! property of the sender — it is a property of this file, and it is decided in the database.
+//!
+//! Three decisions, and each of them is a way to get it wrong:
+//!
+//! * **the key is the intent, not the message.** What must not happen twice is *telling this
+//!   subscriber about their confirmation*, so that is what the state records. Hashing the message
+//!   instead would make a rotated token a different message — and the same intent — which is
+//!   exactly how a deduplication key ends up deduplicating nothing;
+//! * **the claim is a conditional write, and its answer is the truth.** [`claim`] does not read and
+//!   then decide (step `mailer/1.11-signup` already taught why: there is a window between the two
+//!   halves of a read-then-write, and two callers arriving in it both win). The `UPDATE` carries
+//!   its conditions and hands its `RETURNING` row to one caller: the one that won;
+//! * **the record is written after the send, and given back if it fails.** `sent_at` is set only
+//!   once the message was *taken*; a send that failed releases the claim, so the message can be
+//!   delivered by a later claim instead of being stuck as "someone is on it" forever.
+//!
+//! # What this scaffold proves
+//!
+//! Nothing yet, and the hole is the middle decision: [`claim`] below **reads** the row and answers
+//! whatever it finds. Two callers asking at the same time both get the message, the worker sends it
+//! twice, and `confirmation_attempts` stays at zero — the count that is supposed to make "we gave
+//! up on this message" a fact about the row. The step's spec
+//! (`tests/spec_idempotent_delivery.rs`) fails here until the read becomes a write that only one
+//! caller can win, and until the caller that loses believes it.
+//!
+//! What this file does not do even when it is finished is make delivery *durable*: a worker that
+//! dies between the claim and the send leaves a subscriber claimed and unsent, and a reaper
+//! (`WHERE confirmation_claimed_at < now() - interval '…'`) or an outbox is where that gets fixed.
+//! Neither is this step's work.
+
+use sqlx::PgPool;
+
+use crate::confirmation::Token;
+use crate::domain::Email;
+use crate::error::Error;
+
+/// What a claimed delivery needs in order to be sent: where it goes, and the token that makes the
+/// link work.
+///
+/// Both are parsed values (step `mailer/1.10-domain-types`), built from the row the claim came
+/// back with — the service never invents a message it cannot check.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Delivery {
+    /// The address in the row, as an address.
+    pub email: Email,
+    /// The confirmation token that is *in the row*: the only thing `GET /confirm` accepts
+    /// (step `mailer/1.12-token`).
+    pub token: Token,
+}
+
+/// Claim the confirmation email of one subscriber, or answer that there is nothing to claim.
+///
+/// # Errors
+///
+/// Reports [`Error::Database`] when the question cannot be asked, and [`Error::InvalidInput`] when a
+/// value the row holds cannot be parsed as the domain type it was written as.
+///
+/// The scaffold reads: `pending`, not yet told, token present — and answers `Some` for every caller
+/// that asks. Making it an `UPDATE … WHERE confirmation_claimed_at IS NULL RETURNING …` (and
+/// counting the attempt in the same statement) is what turns "may I?" into "I did", which is the
+/// whole of this step's idempotency.
+pub async fn claim(pool: &PgPool, subscriber: i64) -> Result<Option<Delivery>, Error> {
+    let row = sqlx::query!(
+        "SELECT email, confirmation_token AS \"confirmation_token!\" FROM subscribers \
+          WHERE id = $1 \
+            AND status = 'pending' \
+            AND confirmation_sent_at IS NULL \
+            AND confirmation_token IS NOT NULL",
+        subscriber
+    )
+    .fetch_optional(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "claim a confirmation email",
+        source: Box::new(source),
+    })?;
+
+    row.map(|row| {
+        Ok(Delivery {
+            email: Email::parse(&row.email)?,
+            token: Token::parse(&row.confirmation_token)?,
+        })
+    })
+    .transpose()
+}
+
+/// Record that the message went out, and let go of the claim.
+///
+/// This is the write every later job for this subscriber runs into: with `confirmation_sent_at` set,
+/// [`claim`] answers `None` without sending anything.
+///
+/// # Errors
+///
+/// Reports [`Error::Database`] when the record does not run.
+pub async fn mark_sent(pool: &PgPool, subscriber: i64) -> Result<(), Error> {
+    sqlx::query!(
+        "UPDATE subscribers \
+            SET confirmation_sent_at = now(), confirmation_claimed_at = NULL \
+          WHERE id = $1",
+        subscriber
+    )
+    .execute(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "record a delivered confirmation email",
+        source: Box::new(source),
+    })?;
+    Ok(())
+}
+
+/// Give the claim back without recording a delivery.
+///
+/// A send that failed leaves the message owed and nobody sending it: releasing the claim is what
+/// makes it claimable again, by the retry of this worker or by a later job.
+///
+/// # Errors
+///
+/// Reports [`Error::Database`] when the release does not run.
+pub async fn release(pool: &PgPool, subscriber: i64) -> Result<(), Error> {
+    sqlx::query!(
+        "UPDATE subscribers SET confirmation_claimed_at = NULL WHERE id = $1",
+        subscriber
+    )
+    .execute(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "release a confirmation claim",
+        source: Box::new(source),
+    })?;
+    Ok(())
+}
+
+/// The subscriber this address belongs to, when the service still owes them a confirmation.
+///
+/// A second signup for an address that is taken is a `409` (step `mailer/1.11-signup`), and it is
+/// also the only way a client can say "try that delivery again": this is the question behind that
+/// answer, and `None` — the address is unknown, already confirmed, or already told — is what makes
+/// the second signup leave the queue alone.
+///
+/// # Errors
+///
+/// Reports [`Error::Database`] when the question cannot be asked.
+pub async fn outstanding(pool: &PgPool, email: &Email) -> Result<Option<i64>, Error> {
+    let row = sqlx::query!(
+        "SELECT id FROM subscribers \
+          WHERE email = $1 \
+            AND status = 'pending' \
+            AND confirmation_sent_at IS NULL",
+        email.as_str()
+    )
+    .fetch_optional(pool)
+    .await
+    .map_err(|source| Error::Database {
+        operation: "look up an outstanding confirmation",
+        source: Box::new(source),
+    })?;
+    Ok(row.map(|row| row.id))
+}
