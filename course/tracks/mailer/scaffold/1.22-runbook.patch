+//! The outage drill (step `mailer/1.22-runbook`) — the shape of one, and not a drill yet.
+//!
+//! What is here is what a first version usually looks like: the service is started with a mail
+//! server that refuses every message, a subscriber signs up, the drill waits a moment, and then it
+//! reports that the message arrived. Nothing in it asks the service anything — `Report` below is an
+//! answer this file *decided on* rather than one it measured, and `Recovery` is accepted and
+//! ignored.
+//!
+//! That is the shape the spec's second test goes after: a drill that reports success whatever the
+//! mail server does cannot be the evidence a runbook rests on. Turning this into a drill means
+//! making the outage and the recovery real, and taking the numbers from the service's own records —
+//! which is what the runbook you are writing is supposed to describe.
+//!
+//! The parts it does not use are still here to be read: `sender.attempted()` is what the mail server
+//! was asked to send, `sender.delivered()` is what it took, and `Recovery::Never` is the world this
+//! version cannot tell apart from the other one.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+#[path = "app.rs"]
+mod app;
+#[path = "email.rs"]
+mod email;
+#[path = "postgres.rs"]
+mod postgres;
+
+use email::Recording;
+use postgres::Postgres;
+
+/// How long this version gives the queue before it reports what it hopes happened.
+const SETTLE: Duration = Duration::from_millis(500);
+/// The address this drill signs up.
+const DRILL_EMAIL: &str = "drill@example.com";
+
+/// Whether the mail server comes back before the service gives up.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Recovery {
+    /// The outage ends: the server answers again, inside the retry budget.
+    ComesBack,
+    /// The outage outlasts the retry budget: the service stops trying.
+    Never,
+}
+
+/// What one replay found.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Report {
+    /// Messages the service accepted while the mail server was away.
+    pub accepted: usize,
+    /// Messages the mail server took.
+    pub delivered: usize,
+    /// Messages the service stopped trying to deliver.
+    pub given_up: usize,
+}
+
+impl Report {
+    /// `true` when the promise the runbook makes held: nothing the service accepted was lost.
+    #[must_use]
+    pub fn nothing_was_lost(&self) -> bool {
+        self.accepted > 0 && self.delivered == self.accepted && self.given_up == 0
+    }
+}
+
+/// Replay the drill: take the mail server away, accept a subscriber, and answer what happened.
+///
+/// Nothing about this version depends on `recovery`, and that is the hole: both replays answer the
+/// same thing.
+#[must_use]
+pub fn replay(recovery: Recovery) -> Report {
+    let postgres = Postgres::start();
+    let sender = Arc::new(Recording::new());
+    sender.fail_with("the mail server is away");
+    let config = app::config(&[app::database_setting(&postgres.url())]);
+    let service = app::App::start(config, sender.clone());
+
+    let (status, body) = service.post("/signup", &app::signup_body(DRILL_EMAIL));
+    let accepted = usize::from((200..300).contains(&status));
+    assert!(
+        accepted == 1,
+        "the service refused a signup during the outage ({status}): {body}"
+    );
+
+    // What a drill measures, looked at and then ignored: this version reports what it expects the
+    // queue to have done rather than what the records say it did.
+    let offered = sender.attempted().len();
+    let taken = sender.delivered().len();
+    let _ = (offered, taken);
+
+    if recovery == Recovery::ComesBack {
+        // The recovery is here — and so is the hole: the report below is the same in both worlds.
+        sender.clear_failure();
+    }
+    std::thread::sleep(SETTLE);
+
+    Report {
+        accepted,
+        delivered: accepted,
+        given_up: 0,
+    }
+}
