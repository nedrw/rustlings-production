+//! Signing a subscriber up: parse, hash, insert (step `mailer/1.11-signup`).
+//!
+//! This file is the scaffold: the shape of the request, and the one function the step is *about*.
+//! **It proves nothing about a signup** — `hash` answers the password itself, and the insert is not
+//! written yet — so the spec fails here until the step fills this in.
+//!
+//! What the step completes is the rest of the pipeline the module doc of step
+//! `mailer/1.10-domain-types` describes: parse what arrived into [`Email`], [`SubscriberName`] and
+//! [`Password`], hash the password, and let the database decide whether the address is already
+//! taken.
+
+use serde::Deserialize;
+
+use crate::domain::Password;
+use crate::error::Error;
+
+/// The body of `POST /signup`, as it arrives: three raw strings.
+///
+/// Deliberately raw. Deserialising straight into the domain types would be a door around step
+/// `mailer/1.10-domain-types`'s parsers — a value that never went through `parse` would reach code
+/// that trusts it — so what comes off the wire is text, and the text is parsed where it enters.
+#[derive(Debug, Deserialize)]
+pub struct SignupRequest {
+    /// The address to subscribe, exactly as it was sent.
+    pub email: String,
+    /// The name to greet, exactly as it was sent.
+    pub name: String,
+    /// The password to store a hash of, exactly as it was sent.
+    pub password: String,
+}
+
+/// Hash a password for storage.
+///
+/// # Errors
+///
+/// Reports the hashing failure the step's TASK adds to [`Error`] when the hasher refuses the input
+/// or the system's random number generator fails — neither is something a caller can act on, so
+/// both end as a 500.
+///
+/// The scaffold does not hash: it answers what it was given, which is what a table full of
+/// passwords looks like.
+pub fn hash(password: &Password) -> Result<String, Error> {
+    Ok(password.as_str().to_owned())
+}
