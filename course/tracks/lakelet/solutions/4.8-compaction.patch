+fn length_of(path: &Path) -> Result<u64, Error> {
+    std::fs::metadata(path)
+        .map(|metadata| metadata.len())
+        .map_err(store)
+}
+
+/// The manifest this store directory holds, or an empty one when it holds no manifest at all.
+///
+/// A directory with no manifest is a store that has closed no segment yet — not a store whose index
+/// went missing, because the index is *created* by the first seal, and the directory is what a store
+/// that has accepted one frame has. A manifest that is there and cannot be read is a different
+/// answer: this returns an error, because guessing would be a store with a hole in it.
+fn read_manifest(directory: &Path) -> Result<Manifest, Error> {
+    let path = directory.join(MANIFEST);
+    match std::fs::read(&path) {
+        Ok(bytes) => Manifest::decode(&bytes, &path),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(Manifest::empty()),
+        Err(error) => Err(store(error)),
+    }
+}
+
+/// Delete what the manifest does not name: the segment of a merge no crash installed, the segments
+/// of a merge whose deletion a crash interrupted, and the manifest a swap did not finish.
+fn discard(directory: &Path, manifest: &Manifest) -> Result<(), Error> {
+    let _ = std::fs::remove_file(directory.join(PENDING));
+    let names: Vec<String> = manifest
+        .segments()
+        .iter()
+        .map(|info| file_name(info.index))
+        .collect();
+    let entries = match std::fs::read_dir(directory.join(DIRECTORY)) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(store(error)),
