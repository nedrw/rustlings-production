+/// One `Error::Store` around an I/O failure.
+fn store(source: std::io::Error) -> Error {
+    Error::Store {
+        source: Box::new(source),
+    }
+}
+
+/// One `Error::Protocol` about a manifest or a segment that is not what the store wrote.
+fn refused(detail: String) -> Error {
+    Error::Protocol { detail }
+}
+
+/// Wait for the device on `path`: `sync_all`, not `fsync`, for the reason
+/// `docs/adr/0001-write-path.md` measured.
+fn flush(path: &Path) -> Result<(), Error> {
+    std::fs::File::open(path)
+        .map_err(store)?
+        .sync_all()
+        .map_err(store)
+}
