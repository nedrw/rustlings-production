+
+/// The batch one cycle ingests: the ingest mode's workload, moved on so that its first record is at
+/// `from` — or where the workload starts, when there is nothing to resume — and every later cycle
+/// is one window past the one before it.
+///
+/// The offset is what keeps the loop's numbers checkable. Every cycle's records advance by one
+/// batch's worth of time, so the question a cycle asks meets the segment that cycle just sealed and
+/// no other — which is why `decode` is exactly `records` on every run.
+fn workload(load: &super::Options, cycle: u64, from: Option<i64>) -> Vec<Record> {
+    let mut records = super::simulate(load);
+    let base = records.first().map_or(0, |record| record.ts_millis);
+    let start = from.unwrap_or(base);
+    let advance = i64::try_from(cycle)
+        .unwrap_or(i64::MAX)
+        .saturating_mul(step_millis(records.len()));
+    let offset = start.saturating_sub(base).saturating_add(advance);
+    for record in &mut records {
+        record.ts_millis = record.ts_millis.saturating_add(offset);
+    }
+    records
+}
+
+/// The workload as the frames a client would send, read back out of their own bytes.
+///
+/// Answers what the wire carried and how many bytes it took, so what the store holds is what the
+/// protocol carried rather than what the generator meant, and `bytes=` is this program's own account
+/// of the workload it sent.
+fn ingest(records: &[Record], batch: usize) -> Result<(Vec<Record>, u64), Refusal> {
+    let mut carried: Vec<Record> = Vec::with_capacity(records.len());
+    let mut bytes = 0u64;
+    for chunk in records.chunks(batch.max(1)) {
+        let wire = Frame::new(batch::encode(chunk)).encode();
+        bytes = bytes.saturating_add(wire.len() as u64);
+        let payload = match frame::decode(&wire) {
+            Decoded::Frame(frame, _) => frame.payload,
+            // Neither of these can happen to bytes this process has just written, and both are
+            // reported rather than unwrapped: a frame codec that answered `Incomplete` about its own
+            // output is a deployment to go and look at, not a reason to stop explaining.
+            Decoded::Incomplete { needed } => {
+                return Err(Refusal::broken(format!(
+                    "the frame this cycle wrote needs {needed} more byte(s) to be read back, which \
+                     is not a frame it wrote"
+                )));
+            }
+            Decoded::Invalid { reason } => {
+                return Err(Refusal::broken(format!(
+                    "the frame this cycle wrote cannot be read back: {reason}"
+                )));
+            }
+        };
+        carried.extend(batch::decode(&payload).map_err(Refusal::failed)?);
+    }
+    Ok((carried, bytes))
+}
+
+/// One question about the span `records` just wrote, and what it cost.
+fn ask(segments: &Segments, records: &[Record]) -> Result<exec::Outcome, Refusal> {
+    let (from, to) = span(records);
+    let window = step_millis(records.len());
+    let text = format!(
+        "SELECT count(value) FROM {METRIC} WHERE ts BETWEEN {from} AND {to} \
+         GROUP BY time({window}ms)"
+    );
+    let query = match parse::parse(&text) {
+        Ok(Statement::Query(query) | Statement::Explain(query)) => query,
+        Err(refusal) => return Err(Refusal::refused(&refusal)),
+    };
+    exec::execute(&segments.snapshot(), &query).map_err(|by| Refusal::refused(&by))
+}
+
+/// The half-open span one cycle's question covers: from the first timestamp it wrote to one sample
+/// past the last, which is all of what it just sealed and none of what came before.
+fn span(records: &[Record]) -> (i64, i64) {
+    let mut first = i64::MAX;
+    let mut last = i64::MIN;
+    for record in records {
+        first = first.min(record.ts_millis);
+        last = last.max(record.ts_millis);
+    }
+    (first, last.saturating_add(SAMPLE_MILLIS))
 }
 
