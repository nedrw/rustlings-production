+# in-process endpoint that speaks the five operations this build uses (`tests/s3_stub.rs`) — so the
+# port is judged against a real socket, a real request line and a real `authorization` header, with
+# no MinIO, no container and no credentials. A deployment points `KILN_S3_ENDPOINT` at a MinIO or a
+# real bucket instead and nothing else changes.
+backends = ["local", "s3"]
