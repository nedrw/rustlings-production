+
+/// The value of a flag that needs one.
+fn value<'a>(flags: &[&'a str], index: usize, flag: &str) -> Result<&'a str, Outcome> {
+    flags.get(index + 1).copied().ok_or_else(|| {
+        Outcome::refused(WRONG, format!("`{flag}` takes a value and did not get one"))
+    })
+}
+
+/// A flag that may not be given twice.
+fn taken<'a>(slot: Option<&'a str>, value: &'a str, flag: &str) -> Result<&'a str, Outcome> {
+    if slot.is_some() {
+        return Err(Outcome::refused(WRONG, format!("`{flag}` was given twice")));
+    }
