+/// A store that is there, which every one of the three operations is about.
+///
+/// The same rule `lakeletq query` and `lakeletq backup` follow: a store that is not there is not a
+/// store with nothing in it (`3`), and a *file* where the store should be is a broken deployment
+/// (`1`).
+fn present(store: &str) -> Result<(), Outcome> {
+    match std::fs::metadata(store) {
+        Ok(metadata) if metadata.is_dir() => Ok(()),
+        Ok(_) => Err(Outcome::refused(
+            BROKEN,
+            format!("`{store}` is not a directory, so it is not a store this tool can read"),
+        )),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Err(Outcome::refused(
+            ABSENT,
+            format!("there is no store at `{store}`"),
+        )),
+        Err(error) => Err(Outcome::refused(
+            BROKEN,
+            format!("`{store}` cannot be read: {error}"),
+        )),
+    }
+}
+
+/// Where the ring of `store` lives.
+fn ring_dir(store: &str) -> std::path::PathBuf {
+    Path::new(store).join(keys::DIRECTORY)
+}
