+/// Write a key file: `--add`.
+fn add(store: &str, id: &str, secret: &str, from: Option<&str>, json: bool) -> Outcome {
+    if let Err(error) = keys::secret_bytes(secret) {
+        return Outcome::refused(WRONG, format!("`--secret` is not a secret: {error}"));
+    }
+    let not_before = match from {
+        Some(text) => match millis(text, "--from") {
+            Ok(millis) => millis,
+            Err(outcome) => return outcome,
+        },
+        None => now_millis(),
+    };
