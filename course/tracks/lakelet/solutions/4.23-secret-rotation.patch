+impl Shown {
+    /// One key, as the ring reads it.
+    fn of(ring: &KeyRing, key: &keys::Key) -> Self {
+        Self {
+            id: key.id().to_string(),
+            not_before: key.not_before_millis(),
+            not_after: key.not_after_millis(),
+            preferred: ring.preferred().is_some_and(|signs| signs.id() == key.id()),
+            safe_retire: ring.earliest_safe_retirement(key.id()),
