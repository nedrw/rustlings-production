+/// The ring of `store`, or the refusal that says why it could not be read.
+fn loaded(store: &str) -> Result<KeyRing, Outcome> {
+    KeyRing::load(ring_dir(store)).map_err(|error| {
+        Outcome::refused(
+            REFUSED,
+            format!("the ring of `{store}` could not be read: {error}"),
+        )
+    })
