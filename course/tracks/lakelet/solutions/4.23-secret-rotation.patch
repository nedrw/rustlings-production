+        Ok(ring) => ring,
+        Err(outcome) => return outcome,
+    };
+    let Some(key) = ring.keys().iter().find(|key| key.id() == &id) else {
+        return Outcome::refused(ABSENT, format!("the ring holds no key `{id}`"));
+    };
+    if let Some(retired) = key.not_after_millis() {
+        return Outcome::refused(
+            REFUSED,
+            format!("`{id}` was retired at {retired} already: a retirement is written once"),
+        );
+    }
