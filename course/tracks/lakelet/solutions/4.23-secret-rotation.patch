+        Ok(ring) => ring,
+        Err(outcome) => return outcome,
+    };
+    let retired: Vec<Shown> = ring
+        .keys()
+        .iter()
+        .filter(|key| key.id() == &id)
+        .map(|key| Shown::of(&ring, key))
+        .collect();
+    answered(&retired, json)
+}
+
+/// The key file with its end written into it, everything else left as it was.
+///
+/// The secret is not read back out of the ring to do this (a key type has no accessor for its own
+/// secret, on purpose — `relay/2.11-hmac-signing`'s rule), so a retirement is the one line it is
+/// about, appended to the file an operator already has.
+fn retired_text(path: &Path, instant: u64) -> Result<String, String> {
+    let text = std::fs::read_to_string(path)
+        .map_err(|error| format!("{} cannot be read: {error}", path.display()))?;
+    let mut kept: Vec<&str> = text
+        .lines()
+        .filter(|line| !line.trim_start().starts_with("not_after_millis"))
+        .collect();
+    let end = format!("not_after_millis={instant}");
+    kept.push(&end);
+    let mut retired = kept.join("\n");
+    retired.push('\n');
+    Ok(retired)
+}
+
+/// Answer the ring: `--list`.
+fn list(store: &str, json: bool) -> Outcome {
+    let ring = match loaded(store) {
+        Ok(ring) => ring,
+        Err(outcome) => return outcome,
+    };
+    let rows: Vec<Shown> = ring
+        .keys()
+        .iter()
+        .map(|key| Shown::of(&ring, key))
+        .collect();
+    answered(&rows, json)
+}
+
+/// One answer in both formats: one line per key, or the same objects as JSON.
+fn answered(rows: &[Shown], json: bool) -> Outcome {
+    if json {
+        return match serde_json::to_string(rows) {
+            Ok(document) => Outcome::answered(format!("{document}\n")),
+            Err(error) => Outcome::refused(
+                BROKEN,
+                format!("the answer could not be written as JSON: {error}"),
+            ),
+        };
+    }
+    let mut stdout = String::new();
+    for row in rows {
+        stdout.push_str(&row.line());
+        stdout.push('\n');
+    }
+    Outcome::answered(stdout)
+}
+
+/// One instant a caller typed.
+fn millis(text: &str, flag: &str) -> Result<u64, Outcome> {
+    text.parse::<u64>().map_err(|_| {
+        Outcome::refused(
+            WRONG,
+            format!("`{flag}` takes milliseconds since the Unix epoch and got `{text}`"),
+        )
+    })
+}
