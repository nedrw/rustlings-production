+                    return Outcome::refused(
+                        REFUSED,
+                        format!(
+                            "`{id}` is the key this ring signs with, and nothing newer has taken \
+                             that over: add its successor first, and retire `{id}` at the instant \
+                             that key's name turns into a number here"
+                        ),
+                    );
+                }
+                Some(_) => asked,
+            },
+            Err(outcome) => return outcome,
+        },
+        (None, Some(safe)) => safe,
+        (None, None) => {
+            return Outcome::refused(
+                REFUSED,
+                format!(
+                    "`{id}` is the key this ring signs with, and nothing newer has taken that \
+                     over: add its successor first, and retire `{id}` at the instant that key's \
+                     name turns into a number here"
+                ),
+            );
+        }
