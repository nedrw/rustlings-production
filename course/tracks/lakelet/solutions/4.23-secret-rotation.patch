+/// A key name this tool may turn into a file name.
+///
+/// The name becomes `<id>.key` in the ring, so it is not free text: it may not be empty, it may not
+/// be `.` or `..`, and every byte of it is a letter, a digit, `-`, `_` or `.`. A name that could
+/// walk out of the directory (`../k1`, `a/b`) is refused here, where the caller can read why,
+/// rather than written somewhere an operator did not mean.
+fn id_checked(id: &str) -> Result<&str, Outcome> {
+    let simple = !id.is_empty()
+        && id.len() <= 64
+        && id != "."
+        && id != ".."
+        && id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'));
+    if simple {
+        return Ok(id);
+    }
+    Err(Outcome::refused(
+        WRONG,
+        format!(
+            "`{id}` is not a key name: a name is one to sixty-four characters of letters, digits, \
+             `-`, `_` and `.`, and it becomes the key's file name `<id>.key`"
+        ),
+    ))
