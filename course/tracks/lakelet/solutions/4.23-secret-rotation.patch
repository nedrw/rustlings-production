+/// Write `bytes` to `path` through a file beside it, so that a reader either sees the whole record
+/// or the one before it — never half of either.
+///
+/// A daemon reads this directory once per connection, and a key file that was caught halfway
+/// through a write is a ring that refuses to load, which refuses clients. `rename` inside one
+/// directory is atomic, which is the whole reason a retirement is not written in place.
+fn write_whole(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    let temporary = path.with_extension("key.pending");
+    std::fs::write(&temporary, bytes)?;
+    std::fs::rename(&temporary, path)
 }
