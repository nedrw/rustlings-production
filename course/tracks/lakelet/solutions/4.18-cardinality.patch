     /// How many series the answer may cover, or `null`.
     limit: Option<u64>,
 }
+
+/// Run one `inspect` command: what a store *holds*, rather than a question about what is in it.
+///
+/// The split is the tool's own and it is worth one sentence: `query` answers a question about
+/// records and needs a range, a window and an aggregate; `inspect` answers a question about the
+/// *store* — how much cardinality it carries, and what each series has cost — and needs nothing but
+/// the directory. `lakelet/4.18-cardinality-cost` is the step that makes the second question
+/// answerable.
+fn inspect(flags: &[&str], json: bool) -> Outcome {
+    let Some((what, rest)) = flags.split_first() else {
+        return Outcome::refused(
+            WRONG,
+            "`inspect` needs something to inspect: this build knows `inspect series`",
+        );
+    };
+    match *what {
+        "series" => inspect_series(rest, json),
+        other => unknown(other, "the one thing `inspect` knows is `series`"),
+    }
+}
+
+/// Answer `inspect series --store <DIR>`: the store's ledger of series, one line per series.
+///
+/// The order is the same one every other path takes — the caller's mistakes before the store is
+/// opened (a missing `--store` is class `2`, a path that is not there is class `3`, a path that is
+/// not a directory is class `1`), then the store's own answer or its refusal. A read does not
+/// create a store: [`directory`] is what makes that true here as well.
+///
+/// The ledger is rebuilt from the store itself ([`Registry::of_store`]) rather than kept in a file
+/// the store would have to maintain, and the cap passed to it is not the question this command asks
+/// — seeding a ledger from records the store already holds is not judged by a cap, so the number
+/// below decides nothing about the answer. What it *does* decide is the same thing it decides in
+/// the daemon: the ledger shows the series a store holds, and the segments it still has are what
+/// say which of them those are (`lakelet/4.14-index-pruning`).
+fn inspect_series(flags: &[&str], json: bool) -> Outcome {
+    let mut store: Option<&str> = None;
+    let mut rest = flags.iter();
+    while let Some(argument) = rest.next() {
+        match *argument {
+            "--store" => match rest.next() {
+                Some(path) => store = Some(path),
+                None => {
+                    return Outcome::refused(
+                        WRONG,
+                        "`--store` needs the directory a store was written to",
+                    );
+                }
+            },
+            other => {
+                return unknown(other, "`inspect series` reads `--store <DIR>`");
+            }
+        }
+    }
+    let Some(store) = store else {
+        return Outcome::refused(
+            WRONG,
+            "`inspect series` did not say `--store`: `lakeletq --help` lists what it takes",
+        );
+    };
+    let path = Path::new(store);
+    if let Err(outcome) = directory(path) {
+        return outcome;
+    }
+    let ledger = match Registry::of_store(path, Cap::DEFAULT) {
+        Ok(ledger) => ledger,
+        Err(error) => return class(&error, "the store's ledger could not be read"),
+    };
+    match render_ledger(&ledger, json) {
+        Ok(stdout) => Outcome::answered(stdout),
+        Err(outcome) => outcome,
+    }
+}
+
+/// The ledger in the shape that was asked for: one line per series, or one JSON array.
+///
+/// One line per series and not a summary, because the question this command answers is *which*
+/// series are being paid for: a total would say a store is expensive and not which label is the
+/// reason. The fields are space-separated and the series name comes first, so `cut -d' ' -f1` and
+/// `sort -k3 -n` are the whole of the tooling a reader needs on the line.
+fn render_ledger(ledger: &Registry, json: bool) -> Result<String, Outcome> {
+    if json {
+        let shown: Vec<ShownSeries> = ledger.tracked().map(ShownSeries::of).collect();
+        return match serde_json::to_string(&shown) {
+            Ok(document) => Ok(format!("{document}\n")),
+            Err(error) => Err(Outcome::refused(
+                BROKEN,
+                format!("the ledger could not be written as JSON: {error}"),
+            )),
+        };
+    }
+    let mut stdout = String::new();
+    for (series, cost) in ledger.tracked() {
+        stdout.push_str(&format!(
+            "{series} {} {} {} {}\n",
+            cost.records(),
+            cost.bytes(),
+            cost.first_millis(),
+            cost.last_millis()
+        ));
+    }
+    Ok(stdout)
+}
+
+/// One series of the ledger as `--json` writes it: five fields, in the order a script reads them.
+///
+/// A struct rather than a map, for the reason the bucket shape is one: this order is part of what a
+/// script is written against, and a map's is not.
+#[derive(Debug, serde::Serialize)]
+struct ShownSeries {
+    /// The series name, exactly as the store holds it.
+    series: String,
+    /// How many records have been charged to it.
+    records: u64,
+    /// How many bytes have been charged to it.
+    bytes: u64,
+    /// The earliest millisecond it was seen at.
+    first_millis: u64,
+    /// The latest millisecond it was seen at.
+    last_millis: u64,
+}
+
+impl ShownSeries {
+    /// One line of a ledger as the JSON shape states it.
+    fn of((series, cost): (&str, &Cost)) -> Self {
+        Self {
+            series: series.to_owned(),
+            records: cost.records(),
+            bytes: cost.bytes(),
+            first_millis: cost.first_millis(),
+            last_millis: cost.last_millis(),
+        }
+    }
+}
