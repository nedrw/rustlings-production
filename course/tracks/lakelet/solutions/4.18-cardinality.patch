+/// The series one payload's records name, and what each of them carried: grouped by name, in name
+/// order.
+///
+/// Two decisions live here, and they are the ones a caller cannot make for itself:
+///
+/// * **the payload's bytes are shared out by how many records each series carried**, with the
+///   remainder going to the last name in name order. A payload of 64 records over eight series is
+///   eight records each, and a payload with a ragged split is still one payload's bytes and no
+///   more: the shares add up to the payload's length exactly, which is what makes a store's
+///   per-series bytes add up to the bytes it accepted;
+/// * **a record's timestamp is the millisecond it happened**, unsigned with a negative timestamp
+///   counted as zero — the rule the manifest's own entry states and the zone map repeats
+///   (`lakelet/4.14-index-pruning`), because a ledger whose window disagreed with the store's would
+///   make two documents out of one fact.
+///
+/// `None` when these bytes are not a batch this build can read, or are a batch holding no records:
+/// there is no series to charge either way.
+fn carried(payload: &[u8]) -> Option<Vec<(String, Cost)>> {
+    let records = batch::decode(payload).ok()?;
+    if records.is_empty() {
+        return None;
+    }
+    let mut grouped: BTreeMap<String, Cost> = BTreeMap::new();
+    for record in &records {
+        let at = millis_of(record.ts_millis);
+        match grouped.get_mut(&record.series) {
+            Some(cost) => cost.absorb(Cost::carrying(1, 0, at, at)),
+            None => {
+                grouped.insert(record.series.clone(), Cost::carrying(1, 0, at, at));
+            }
+        }
+    }
+    let total = records.len() as u64;
+    let length = payload.len() as u64;
+    let count = grouped.len();
+    let mut shared = 0u64;
+    let mut carried: Vec<(String, Cost)> = Vec::with_capacity(count);
+    for (index, (name, cost)) in grouped.into_iter().enumerate() {
+        let bytes = if index + 1 == count {
+            // The last name takes what is left, so the shares are the payload's bytes exactly and
+            // not a rounding down of them.
+            length.saturating_sub(shared)
+        } else {
+            (length / total).saturating_mul(cost.records())
+        };
+        shared = shared.saturating_add(bytes);
+        carried.push((
+            name,
+            Cost::carrying(
+                cost.records(),
+                bytes,
+                cost.first_millis(),
+                cost.last_millis(),
+            ),
+        ));
+    }
+    Some(carried)
