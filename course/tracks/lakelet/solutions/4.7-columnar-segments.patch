+        return Err(refused(format!(
+            "a series name starts at byte {at} and the payload does not hold the two bytes of its \
+             length"
+        )));
+    };
+    let start = at + NAME;
+    let Some(end) = start.checked_add(length) else {
+        return Err(refused(format!(
+            "the series name at byte {at} says it is {length} bytes, which is further than this \
+             machine can address"
+        )));
+    };
+    let Some(name) = payload.get(start..end) else {
+        return Err(refused(format!(
+            "the series name at byte {at} says it is {length} bytes and the payload holds {} from \
+             byte {start}",
+            payload.len().saturating_sub(start)
+        )));
+    };
