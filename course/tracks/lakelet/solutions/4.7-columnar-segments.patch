+/// One column's framing, read back: its tag, its payload and where the next column starts.
+struct Framed<'a> {
+    /// Which encoding the column was written with.
+    tag: u8,
+    /// The column's payload, exactly as it was framed.
+    payload: &'a [u8],
+    /// Byte after the payload: where the next column's tag is.
+    next: usize,
+}
+
+/// Read one framed column at `at`, or refuse by naming the column.
+fn framed<'a>(block: &'a [u8], at: usize, column: &str) -> Result<Framed<'a>, Error> {
+    let Some(tag) = block.get(at).copied() else {
+        return Err(refused(format!(
+            "the {column} column's tag would be at byte {at} and the block holds {} — the column(s) \
+             before it did not end where they said",
+            block.len()
+        )));
+    };
+    let Some(length) = at
+        .checked_add(encode::TAG)
+        .and_then(|offset| u32_at(block, offset))
+        .map(|value| value as usize)
+    else {
+        return Err(refused(format!(
+            "the {column} column states its payload's length at byte {} and the block does not hold \
+             four bytes there",
+            at + encode::TAG
+        )));
+    };
+    let start = at + encode::FRAME;
+    let Some(end) = start.checked_add(length) else {
+        return Err(refused(format!(
+            "the {column} column says its payload is {length} bytes, which starting at {start} runs \
+             past the end of this machine's addresses"
+        )));
+    };
+    let Some(payload) = block.get(start..end) else {
+        return Err(refused(format!(
+            "the {column} column says its payload is {length} bytes and the block holds {} from \
+             byte {start}",
+            block.len().saturating_sub(start)
+        )));
+    };
+    Ok(Framed {
+        tag,
+        payload,
+        next: end,
+    })
+}
+
+/// The series column's names, `count` of them, in order.
+fn names(tag: u8, payload: &[u8], count: usize) -> Result<Vec<String>, Error> {
+    match tag {
+        PLAIN => {
+            let mut names = Vec::with_capacity(count.min(payload.len()));
+            let mut cursor = 0usize;
+            for _ in 0..count {
+                let (name, next) = name_at(payload, cursor)?;
+                names.push(name.to_owned());
+                cursor = next;
+            }
+            consumed(payload, cursor, "series")?;
+            Ok(names)
+        }
+        DIC => {
+            let Some(entries) = u32_at(payload, 0).map(|value| value as usize) else {
+                return Err(refused(
+                    "a series dictionary starts with a four-byte name count and the payload does not \
+                     hold four bytes",
+                ));
+            };
+            let mut dictionary: Vec<String> = Vec::with_capacity(entries.min(payload.len()));
+            let mut cursor = encode::LENGTH;
+            for _ in 0..entries {
+                let (name, next) = name_at(payload, cursor)?;
+                dictionary.push(name.to_owned());
+                cursor = next;
+            }
+            let Some(run_count) = u32_at(payload, cursor).map(|value| value as usize) else {
+                return Err(refused(format!(
+                    "the series dictionary's {entries} name(s) end at byte {cursor} and the payload \
+                     holds no four-byte run count there"
+                )));
+            };
+            cursor += encode::LENGTH;
+            let mut series: Vec<String> = Vec::with_capacity(count.min(payload.len()));
+            for _ in 0..run_count {
+                let (Some(length), Some(number)) =
+                    (u32_at(payload, cursor), number_at(payload, cursor))
+                else {
+                    return Err(refused(format!(
+                        "the series column states {run_count} run(s) and the one at byte {cursor} \
+                         is cut before its eight bytes"
+                    )));
+                };
+                let length = length as usize;
+                let number = number as usize;
+                if number >= dictionary.len() {
+                    return Err(refused(format!(
+                        "the series run at byte {cursor} names entry {number} and the dictionary \
+                         holds {} name(s)",
+                        dictionary.len()
+                    )));
+                }
+                let Some(total) = series.len().checked_add(length) else {
+                    return Err(refused(format!(
+                        "the series run at byte {cursor} is longer than this machine can address"
+                    )));
+                };
+                if total > count {
+                    return Err(refused(format!(
+                        "the series runs add up to more than the {count} record(s) the block states \
+                         — a run that outlives the records it describes is a damaged block"
+                    )));
+                }
+                let Some(name) = dictionary.get(number) else {
+                    return Err(refused(format!(
+                        "the series run at byte {cursor} names entry {number}"
+                    )));
+                };
+                series.resize(total, name.clone());
+                cursor += encode::LENGTH * 2;
+            }
+            consumed(payload, cursor, "series")?;
+            if series.len() != count {
+                return Err(refused(format!(
+                    "the series runs add up to {} record(s) and the block states {count}",
+                    series.len()
+                )));
+            }
+            Ok(series)
+        }
+        other => Err(other_tag("series", other)),
+    }
+}
