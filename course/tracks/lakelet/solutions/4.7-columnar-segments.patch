+
+/// The entry number a series run names, at the offset a run starts at.
+fn number_at(payload: &[u8], at: usize) -> Option<u32> {
+    at.checked_add(encode::LENGTH)
+        .and_then(|offset| u32_at(payload, offset))
+}
+
+/// The bit pattern a value run carries, at the offset the run starts at.
+fn bits_at(payload: &[u8], at: usize) -> Option<u64> {
+    at.checked_add(encode::LENGTH)
+        .and_then(|offset| u64_at(payload, offset))
+}
+
+/// Read one unsigned varint at `at`, or refuse naming the byte it starts at.
+fn varint(payload: &[u8], at: usize) -> Result<(u64, usize), Error> {
+    let mut value = 0u64;
+    let mut shift = 0u32;
+    let mut cursor = at;
+    loop {
+        let Some(byte) = payload.get(cursor).copied() else {
+            return Err(refused(format!(
+                "the delta that starts at byte {at} runs past the end of the payload — a varint whose \
+                 last byte is missing is not a stamp this reader may guess at"
+            )));
+        };
+        cursor += 1;
+        if shift > 63 {
+            return Err(refused(format!(
+                "the delta at byte {at} is longer than the eight bytes a varint of an `i64` can \
+                 occupy"
+            )));
+        }
+        let bits = u64::from(byte & 0x7f);
+        if shift == 63 && bits > 1 {
+            return Err(refused(format!(
+                "the delta at byte {at} carries bits above the 64th — the difference of two `i64`s \
+                 is not this"
+            )));
+        }
+        value |= bits << shift;
+        if byte & 0x80 == 0 {
+            return Ok((value, cursor));
+        }
+        shift += 7;
+    }
