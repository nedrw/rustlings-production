+        PLAIN => {
+            let Some(used) = count.checked_mul(size_of::<i64>()) else {
+                return Err(refused(format!(
+                    "the timestamp column says it is plain with {count} record(s), which is more \
+                     bytes than this machine can address"
+                )));
+            };
+            let mut stamps = Vec::with_capacity(count.min(payload.len()));
+            for index in 0..count {
+                let at = index * size_of::<i64>();
+                let Some(stamp) = i64_at(payload, at) else {
+                    return Err(refused(format!(
+                        "the timestamp column is plain and states {count} record(s): the eight bytes \
+                         at byte {at} are not there, and the payload holds {}",
+                        payload.len()
+                    )));
+                };
+                stamps.push(stamp);
+            }
+            consumed(payload, used, "timestamp")?;
+            Ok(stamps)
+        }
+        DELTA => {
+            let Some(first) = i64_at(payload, 0) else {
+                return Err(refused(
+                    "a delta-encoded timestamp column starts with its first stamp in eight bytes and \
+                     the payload does not hold them",
+                ));
+            };
+            let mut stamps = Vec::with_capacity(count.min(payload.len()));
+            stamps.push(first);
+            let mut cursor = size_of::<i64>();
+            let mut previous = first;
+            for _ in 1..count {
+                let (value, next) = varint(payload, cursor)?;
+                // The step is put back the way it was taken: `wrapping_add` of a wrapped difference is
+                // the identity for every pair of `i64`s, which is what makes `i64::MIN` next to
+                // `i64::MAX` a round trip instead of an arithmetic fault.
+                previous = previous.wrapping_add(zigzag_decode(value));
