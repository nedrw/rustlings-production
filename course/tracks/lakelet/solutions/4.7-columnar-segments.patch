+        return Err(refused(format!(
+            "the series name at byte {at} is empty — a record's series is a metric and its labels, \
+             and a name no client can write is not one a segment may hold"
+        )));
+    }
+    let name = std::str::from_utf8(name).map_err(|error| {
+        refused(format!(
+            "the series name at byte {at} is not UTF-8: {error}"
+        ))
+    })?;
