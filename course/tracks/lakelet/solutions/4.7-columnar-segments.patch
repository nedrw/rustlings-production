+/// The timestamp column's values, `count` of them, in order.
+fn stamps(tag: u8, payload: &[u8], count: usize) -> Result<Vec<i64>, Error> {
+    // A timestamp column with no records is a column with no bytes: both encodings it speaks write
+    // eight bytes per record and nothing else, so the empty column is answered once here instead of
+    // in each arm — and a payload that is not empty under a count of zero is a damaged column, not
+    // an empty one. The other two columns cannot say this: a dictionary of no names still has its
+    // name table, and a run-length of no runs still has its count.
+    if count == 0 {
+        consumed(payload, 0, "timestamp")?;
