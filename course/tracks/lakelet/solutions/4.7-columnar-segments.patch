+
+/// The value column's bit patterns, `count` of them, in order.
+fn values(tag: u8, payload: &[u8], count: usize) -> Result<Vec<u64>, Error> {
+    match tag {
+        PLAIN => {
+            let Some(used) = count.checked_mul(size_of::<u64>()) else {
+                return Err(refused(format!(
+                    "the value column says it is plain with {count} record(s), which is more bytes \
+                     than this machine can address"
+                )));
+            };
+            let mut values = Vec::with_capacity(count.min(payload.len()));
+            for index in 0..count {
+                let at = index * size_of::<u64>();
+                let Some(bits) = u64_at(payload, at) else {
+                    return Err(refused(format!(
+                        "the value column is plain and states {count} record(s): the eight bytes at \
+                         byte {at} are not there, and the payload holds {}",
+                        payload.len()
+                    )));
+                };
+                values.push(bits);
+            }
+            consumed(payload, used, "value")?;
+            Ok(values)
+        }
+        RLE => {
+            let Some(run_count) = u32_at(payload, 0).map(|value| value as usize) else {
+                return Err(refused(
+                    "a run-length value column starts with a four-byte run count and the payload does \
+                     not hold four bytes",
+                ));
+            };
+            let mut values: Vec<u64> = Vec::with_capacity(count.min(payload.len()));
+            let mut cursor = encode::LENGTH;
+            for _ in 0..run_count {
+                let (Some(length), Some(bits)) =
+                    (u32_at(payload, cursor), bits_at(payload, cursor))
+                else {
+                    return Err(refused(format!(
+                        "the value column states {run_count} run(s) and the one at byte {cursor} is \
+                         cut before its twelve bytes"
+                    )));
+                };
