+
+/// `Ok` when the payload holds exactly `used` bytes, and a refusal naming the column otherwise.
+fn consumed(payload: &[u8], used: usize, column: &str) -> Result<(), Error> {
+    if used == payload.len() {
+        return Ok(());
+    }
+    if used > payload.len() {
+        return Err(refused(format!(
+            "the {column} column's payload ends after {used} bytes and it holds {} — the column is \
+             cut, and a reader that answered with the part it could read would hand back a shorter \
+             segment as if it were this one",
+            payload.len()
+        )));
+    }
+    Err(refused(format!(
+        "the {column} column's payload is {} bytes and its records use {used} — the rest is no \
+         column, so the block is not the layout this build writes",
+        payload.len()
+    )))
+}
+
+/// The refusal for a tag this build does not speak, phrased so the column and the number are both in
+/// the sentence.
+fn other_tag(column: &str, tag: u8) -> Error {
+    refused(format!(
+        "the {column} column's tag is {tag} and this build writes {PLAIN} (plain), {RLE} \
+         (run-length), {DELTA} (delta) and {DIC} (dictionary) — a tag nobody wrote is a block from \
+         another build, not one to decode as whatever it looks like"
+    ))
+}
+
+/// The signed difference an unsigned varint carried.
+fn zigzag_decode(value: u64) -> i64 {
+    ((value >> 1) as i64) ^ -((value & 1) as i64)
+}
+
+/// The `u16` these two bytes are, little endian, or `None` when there are not two of them.
+fn u16_at(bytes: &[u8], offset: usize) -> Option<u16> {
+    let slice = bytes.get(offset..offset.checked_add(NAME)?)?;
+    let mut array = [0u8; NAME];
+    array.copy_from_slice(slice);
+    Some(u16::from_le_bytes(array))
+}
+
+/// The `u32` these four bytes are, little endian, or `None` when there are not four of them.
+fn u32_at(bytes: &[u8], offset: usize) -> Option<u32> {
+    let slice = bytes.get(offset..offset.checked_add(encode::LENGTH)?)?;
+    let mut array = [0u8; encode::LENGTH];
+    array.copy_from_slice(slice);
+    Some(u32::from_le_bytes(array))
+}
+
+/// The `u64` these eight bytes are, little endian, or `None` when there are not eight of them.
+fn u64_at(bytes: &[u8], offset: usize) -> Option<u64> {
+    let slice = bytes.get(offset..offset.checked_add(size_of::<u64>())?)?;
+    let mut array = [0u8; size_of::<u64>()];
+    array.copy_from_slice(slice);
+    Some(u64::from_le_bytes(array))
+}
+
+/// The `i64` these eight bytes are, little endian, or `None` when there are not eight of them.
+fn i64_at(bytes: &[u8], offset: usize) -> Option<i64> {
+    let slice = bytes.get(offset..offset.checked_add(size_of::<i64>())?)?;
+    let mut array = [0u8; size_of::<i64>()];
+    array.copy_from_slice(slice);
+    Some(i64::from_le_bytes(array))
+}
+
+/// One `Error::Protocol` about these bytes.
+fn refused(detail: impl Into<String>) -> Error {
+    Error::Protocol {
+        detail: detail.into(),
+    }
 }
