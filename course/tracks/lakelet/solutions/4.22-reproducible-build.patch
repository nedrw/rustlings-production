-ENTRYPOINT ["/src/target/release/lakeletd"]
+
+# The daemon as the entry point, with no `CMD` after it, so the arguments a deployment passes are the
+# daemon's own: `docker run <tag> --check-config` prints the configuration report and exits without
+# opening a store or binding a port, which is exactly what the gate asks the image and the host to
+# agree on.
+ENTRYPOINT ["/usr/local/bin/lakeletd"]
