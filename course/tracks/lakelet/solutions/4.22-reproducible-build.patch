-# The supply-chain policy (step `lakelet/4.22-reproducible-build`): four questions, named here and not
-# answered yet.
+# The supply-chain policy of this project, as a file a tool can run and a reviewer can read.
 #
-# This is a file a tool runs (`cargo-deny`; `docs/supply-chain.md` says whether it is installed here)
-# and a file a reviewer reads. Each section below is one of the four questions a dependency review
-# asks, and each has to end up carrying the policy *and* the sentence it is there for:
+# `supply/deny-policy@apply — relay/2.21` wrote the first version of this policy; this is the same
+# four questions in a fourth project, at the depth a maintainer is answerable for: what the tree
+# admits, what it refuses, and what each refusal costs. `docs/supply-chain.md` is the prose half and
+# states the same four things in this order — the step's spec reads both files and objects when they
+# disagree, which is the one drift a policy file cannot see by itself.
+#
+# **The tool is not installed here.** `cargo-deny` is not on this machine and is not a component of
+# the pinned toolchain (`kiln doctor` says so; `.github/workflows/ci.yml` says so where it would
+# belong), so on this machine this file is judged as a *file*: its shape, and the policy it states.
+# What keeps it from being decoration anyway is that its lists are not invented. The licence
+# allow-list, the exception, the four duplicated crates and the registry are read off this tree's own
+# `Cargo.lock` (`cargo metadata` over the pinned toolchain), and the step's spec re-reads them the
+# same way — so a lockfile that grew a licence or a duplicate nobody wrote down is a red case rather
+# than a paragraph nobody updates.
+
+# 1. Vulnerabilities. The sentence: a crate with a known advisory does not ship.
 [advisories]
-# What is vulnerable: a crate with a known advisory, and what a yanked release means for a lockfile
-# that still names it.
+version = 2
+db-urls = ["https://github.com/rustsec/advisory-db"]
+# A yanked release is an advisory with the reason attached: somebody pulled the version back, and a
+# lockfile that still names it is a lockfile nobody has looked at.
+yanked = "deny"
+# Empty on purpose, and it is a decision rather than a blank: an entry here ships a known problem,
+# and this policy's position is that such a decision belongs in the pull request that needed it,
+# with the reason and the date, not in a list nobody rereads.
+ignore = []
+
+# 2. Licences. The sentence: the tree is built from what this list allows, and something new is a
+# decision somebody makes rather than a rebuild nobody notices.
 [licenses]
-# What this tree may be built from: the licence families this lockfile actually declares, and anything
-# that needs an exception of its own.
+version = 2
+confidence-threshold = 0.93
+# This crate is not published and declares no licence: the policy covers what the tree *depends on*,
+# and demanding a licence file from the workspace's own package would be a rule about publishing.
+private = { ignore = true }
+# Every family this lockfile declares, and nothing else — derived, not guessed. A crate whose
+# licence is not on this list (or covered by an exception below) fails the check, which is the whole
+# point: adding a dependency under a new licence is a decision, and this is where it gets written
+# down.
+allow = [
+    "Apache-2.0",
+    "Apache-2.0 WITH LLVM-exception",
+    "BSD-2-Clause",
+    "BSD-3-Clause",
+    "MIT",
+    # The one entry that is not an SPDX expression: `scoped-tls` and `version_check` (both build
+    # dependencies of the toolchain's own crates) still declare their dual licence the way crates
+    # did before SPDX expressions were common. It is here under the string they use, with this
+    # comment, rather than rewritten as `MIT OR Apache-2.0` — because the file has to state what
+    # the crates say, not what they meant.
+    "MIT/Apache-2.0",
+    "Unicode-3.0",
+    "Unlicense",
+]
+# Exactly one exception, and it is a copyleft one, so it is written as an exception rather than as
+# an entry in the allow-list: `r-efi` (LGPL-2.1-or-later) arrives through `getrandom`, which needs it
+# for UEFI targets — a target this project does not build for, so nothing of it is distributed here.
+# `allow = ["LGPL-2.1-or-later"]` would admit the next copyleft crate without anybody reading this
+# comment; naming the crate is the difference between a policy and a shrug.
+exceptions = [{ name = "r-efi", allow = ["LGPL-2.1-or-later"] }]
+
+# 3. Bans. The sentence: two versions of one crate are two things to audit and one of them is
+# usually forgotten, so a *new* duplicate fails the check.
 [bans]
-# What may be here twice: two versions of one crate are two things to audit.
+multiple-versions = "deny"
+# A wildcard requirement (`serde = "*"`) makes the lockfile the only pin, which is the thing a
+# lockfile-controlled tree is not supposed to need.
+wildcards = "deny"
+# The four crates this lockfile holds twice, each because two crates that cannot see each other
+# depend on different lines. Measured, not assumed:
+#   `syn` 2.0.119 (`tracing-attributes`, `zerocopy-derive`) and 3.0.6 (`serde_derive`,
+#     `thiserror-impl`, `tokio-macros`) — proc-macro crates move majors independently;
+#   `winnow` 0.7.15 (`toml`) and 1.0.4 (`toml_parser`) — one parser crate's internals split;
+#   `getrandom` 0.3.4 (`rand_core`) and 0.4.3 (`jobserver`) — a dev-dependency's tree and a build
+#     dependency's tree need different majors;
+#   `r-efi` 5.3.0 and 6.0.0, both from `getrandom`, for the same UEFI target as the licence
+#     exception above.
