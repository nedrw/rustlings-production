+# The sources, named one by one. Deliberately not `COPY . .`: this project has no `.dockerignore`, and
+# a build context is the whole directory a deployment happens to be standing in — including the host's
+# own `target/`, hundreds of megabytes of *this machine's* artifacts that no build in the image can
+# use. Naming what the build reads is one line more than copying everything and it is the difference
+# between a context that is the sources and a context that is a directory.
+COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
+COPY src ./src
+
+# One release build, locked to the versions the tree was tested with. No `apk add` above it: the
+# official `rust:alpine` image already carries `gcc`, `musl-dev` and `ca-certificates`, which is what
+# this tree needs — `zstd-sys` compiles C, and the C compiler is part of the base image.
+RUN cargo build --release --locked --bin lakeletd \
+    && cp "$CARGO_TARGET_DIR/release/lakeletd" /lakeletd
+
+FROM ${RUNTIME} AS runtime
+
+# One user, no privileges, no home directory. The process is pid 1 inside the container either way,
+# and a daemon that needs no privileges should have none. `/data` is created and owned here because it
+# is where the configuration's default store directory lands (the default is the relative path `data`,
+# and this image's working directory is `/`) — a deployment mounts a volume there, or points
+# `LAKELET_STORE_DIR` somewhere else.
