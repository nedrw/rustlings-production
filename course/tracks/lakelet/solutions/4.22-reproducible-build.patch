-# Where a crate may come from: one registry, or the build stops.
+unknown-registry = "deny"
+# A git dependency is a promise that a repository will still have that commit... and the lockfile
+# records the commit rather than a release, so this tree ships code nobody has published.
+unknown-git = "deny"
+# The 92 registry entries this lockfile names are all this one.
+allow-registry = ["https://github.com/rust-lang/crates.io-index"]
+allow-git = []
