+/// Ask the store, or say why it could not be asked.
+///
+/// This is the whole of the query: open, snapshot, read, downsample. There is no second way to
+/// open a store and no place that remembers what the second one would have been.
+fn ask(query: &Query<'_>) -> Result<Vec<Bucket>, Outcome> {
+    // A read does not create a store. `Segments::open` would, which is right for a daemon and
+    // wrong here: a typo in `--store` would leave an empty store behind and answer `0` with no
+    // lines, so the two ways a path can be wrong are told apart first — nothing there is the
+    // caller's, something that is not a directory is the deployment's.
+    match std::fs::metadata(query.store) {
+        Err(_) => {
+            return Err(Outcome::refused(
+                ABSENT,
+                format!(
+                    "there is no store directory at `{}`: `--store` names the directory a store \
+                     was written to, and this tool does not create one",
+                    query.store.display()
+                ),
+            ));
+        }
+        Ok(metadata) if !metadata.is_dir() => {
+            return Err(Outcome::refused(
+                BROKEN,
+                format!(
+                    "`{}` is not a directory, so this deployment cannot be a store: nothing about \
+                     the call is wrong, and nothing can be read either",
+                    query.store.display()
+                ),
+            ));
+        }
+        Ok(_) => {}
+    }
+
+    let store = match Segments::open(query.store) {
+        Ok(store) => store,
+        Err(error) => return Err(class(&error, "the store could not be opened")),
+    };
+    // The store's floor is not an error here (`lakelet/4.10-downsampling`'s page): a store that has
+    // forgotten something answers with what it still keeps, and the answer simply begins later
+    // than `--from` asked.
+    let records = match store.snapshot().records() {
+        Ok(records) => records,
+        Err(error) => return Err(class(&error, "the store's segments could not be read")),
+    };
+    let answered = downsample::downsample(
+        &records,
+        query.series,
+        query.range,
+        Window::new(query.width_millis),
+        query.aggregate,
+    );
+    Ok(answered.buckets().to_vec())
+}
+
+/// The class a failure belongs to, and the sentence a reader acts on.
+///
+/// The variant is what says which class it is — a call the engine refused, a deployment that cannot
+/// work, a store that would not answer — and this is the only place in the tool that turns one into
+/// a number.
+fn class(error: &Error, what: &str) -> Outcome {
+    let code = match error {
+        Error::Invalid { .. } => WRONG,
+        Error::Config { .. } => BROKEN,
+        Error::Protocol { .. } | Error::Store { .. } => REFUSED,
+    };
+    Outcome::refused(code, format!("{what}: {error}"))
+}
+
+/// The answer in the shape that was asked for: one line per bucket, or one JSON document.
+fn render(buckets: &[Bucket], json: bool) -> Result<String, Outcome> {
+    if json {
+        let shown: Vec<Shown> = buckets.iter().map(Shown::of).collect();
+        return match serde_json::to_string(&shown) {
+            Ok(document) => Ok(format!("{document}\n")),
+            Err(error) => Err(Outcome::refused(
+                BROKEN,
+                format!("the answer could not be written as JSON: {error}"),
+            )),
+        };
+    }
+    let mut stdout = String::new();
+    for bucket in buckets {
+        let start = bucket.start();
+        let count = bucket.count();
+        let value = bucket.value();
+        stdout.push_str(&format!("{start} {count} {value}\n"));
+    }
+    Ok(stdout)
+}
