+        let at = millis_of(record.ts_millis);
+        if !range.contains(at) {
+            continue;
+        }
+        in_range += 1;
+        let start = window.partition(record.ts_millis).start();
+        match windows.entry(start) {
+            Entry::Occupied(mut window) => window.get_mut().add(record.value),
+            Entry::Vacant(window) => {
+                window.insert(Tally::of(record.value));
+            }
+        }
+    }
+
+    // A map keyed by the window's start is the answer's order for free, and the windows it never
+    // saw are the ones it does not have: a window with no records in the range is *absent* rather
+    // than present with a zero in it.
+    let buckets = windows
+        .into_iter()
+        .map(|(start, tally)| tally.bucket(start, aggregate))
+        .collect();
+    Answer {
+        buckets,
+        scanned,
+        in_range,
+        series_matched,
+    }
+}
+
+/// One window's records while the pass is inside it: what a summary needs, and nothing else.
+///
+/// The four numbers are kept rather than the records, because a window of a day's samples is not
+/// something to hold in memory in order to answer a mean — and because the four are exactly what
+/// the five aggregates need, which is why `min` and `max` are accumulated as the pass goes rather
+/// than computed at the end.
+#[derive(Debug, Clone, Copy)]
+struct Tally {
+    /// How many records have gone in.
+    count: u64,
+    /// What they add up to.
+    sum: f64,
+    /// The smallest value seen.
+    min: f64,
+    /// The largest value seen.
+    max: f64,
+}
+
+impl Tally {
+    /// The tally of one record.
+    fn of(value: f64) -> Self {
+        Self {
+            count: 1,
+            sum: value,
+            min: value,
+            max: value,
+        }
+    }
+
+    /// Add one more record's value.
+    fn add(&mut self, value: f64) {
+        self.count += 1;
+        self.sum += value;
+        // `f64::min`/`f64::max` rather than a comparison: a value that is not a number is not an
+        // extreme, and a comparison would let one of them poison the whole window's answer.
+        self.min = self.min.min(value);
+        self.max = self.max.max(value);
+    }
+
+    /// This window as the answer reports it.
+    fn bucket(&self, start: u64, aggregate: Aggregate) -> Bucket {
+        let value = match aggregate {
+            Aggregate::Count => self.count as f64,
+            Aggregate::Sum => self.sum,
+            Aggregate::Mean => self.sum / self.count as f64,
+            Aggregate::Min => self.min,
+            Aggregate::Max => self.max,
+        };
+        Bucket {
+            start_millis: start,
+            count: self.count,
+            value,
+        }
+    }
+}
+
+/// One record's timestamp in the units a window counts in: milliseconds since the Unix epoch, with
+/// anything before it counted as the epoch.
+///
+/// The same conversion the store's index makes when it writes a segment's time range
+/// (`crate::engine::compaction`), and for the same reason: the manifest states an unsigned
+/// millisecond, and there is no bucket below the epoch for a clock that was wrong to land in. A
+/// record before 1970 therefore falls in the first window rather than in no window at all.
+fn millis_of(ts_millis: i64) -> u64 {
+    u64::try_from(ts_millis).unwrap_or(0)
 }
