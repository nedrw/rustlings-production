+
+/// A digest over records in order: the series, the timestamp and the value's bits, folded together.
+///
+/// A *digest* and not a count, because those are two different questions: a copy that lost one record
+/// and invented another keeps the count, and the pair of digests before and after a restore is what
+/// says the two stores answer the same thing. The value is hashed as its bits
+/// (`f64::to_bits`), so nothing here formats a float — a number whose text depends on a formatter is
+/// a number two machines can disagree about.
+fn digest(records: &[Record]) -> String {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for record in records {
+        for byte in record.series.as_bytes() {
+            hash = fold(hash, *byte);
+        }
+        // A separator, so that a series name and the bytes after it cannot be shifted against each
+        // other to produce the same digest from two different stores.
+        hash = fold(hash, 0xff);
+        for byte in record.ts_millis.to_le_bytes() {
+            hash = fold(hash, byte);
+        }
+        for byte in record.value.to_bits().to_le_bytes() {
+            hash = fold(hash, byte);
+        }
+    }
+    format!("{hash:016x}")
+}
+
+/// FNV-1a's step: exclusive-or one byte in and multiply by the prime.
+fn fold(hash: u64, byte: u8) -> u64 {
+    (hash ^ u64::from(byte)).wrapping_mul(0x0000_0100_0000_01b3)
+}
+
+/// Anchor a digest with an owned string.
+///
+/// The measurements borrow their *names* from this file's own literals; a digest is computed, so it
+/// is leaked into the same shape. A drill's answer holds a handful of short strings and lives for one
+/// command, which is why this is a `Box::leak` rather than a `String` every measurement has to own —
+/// and why `Measurement` stays `Copy`.
+fn leak(text: String) -> &'static str {
+    Box::leak(text.into_boxed_str())
+}
+
+/// A claim the drill makes, and the sentence when the store did not keep it.
+fn expect(held: bool, detail: String) -> Result<(), Outcome> {
+    if held {
+        return Ok(());
+    }
+    Err(Outcome::refused(super::REFUSED, detail))
 }
