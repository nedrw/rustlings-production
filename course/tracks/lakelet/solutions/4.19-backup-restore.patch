+/// One measurement of a command's answer: a count, a flag, or a name.
+///
+/// Three shapes because that is what these commands answer with — `interrupted=false` is not a count
+/// of anything, and `write_policy=never` is a name the write path gave itself
+/// (`lakelet/4.3-write-path-adr`) rather than a number — and one type rather than a
+/// `serde_json::Value`, because a value built by hand is a shape nobody checks at compile time.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Measurement {
+    /// How many of something.
+    Count(u64),
+    /// Whether something was the case.
+    Flag(bool),
+    /// What something is called.
+    Name(&'static str),
+}
+
+impl Measurement {
+    /// The measurement as the text after a `=` in a line of the answer.
+    #[must_use]
+    pub fn text(self) -> String {
+        match self {
+            Self::Count(count) => count.to_string(),
+            Self::Flag(flag) => flag.to_string(),
+            Self::Name(name) => name.to_owned(),
+        }
+    }
+}
+
+impl serde::Serialize for Measurement {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Self::Count(count) => serializer.serialize_u64(*count),
+            Self::Flag(flag) => serializer.serialize_bool(*flag),
+            Self::Name(name) => serializer.serialize_str(name),
+        }
+    }
+}
+
+/// The measurements of one command as one JSON object, in the order they were observed.
+///
+/// An object built from the list rather than a struct with one field per count, for the reason
+/// `lakelet/4.15-budget-regression` built its phase profile that way: the names are one list, and a
+/// struct would spell them a second time — with the second spelling free to drift from the lines.
+struct Answer<'a>(&'a [(&'a str, Measurement)]);
+
+impl serde::Serialize for Answer<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        use serde::ser::SerializeMap;
+
+        let mut map = serializer.serialize_map(Some(self.0.len()))?;
+        for (name, measurement) in self.0 {
+            map.serialize_entry(name, measurement)?;
+        }
+        map.end()
+    }
+}
