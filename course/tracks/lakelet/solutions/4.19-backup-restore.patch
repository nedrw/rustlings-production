+/// The directories one drill uses, and which of them this process has to remove.
+///
+/// A drill writes three places — the store it builds, the copies it takes and the directories it
+/// restores into — and only the store is a path a caller can name. The rest are this process's own,
+/// because the drill's *point* is that a reader can run it anywhere and compare the answer with the
+/// block on the page: a command that needed four directories to be set up first would be a command
+/// nobody runs.
+struct Workspace {
+    /// Where the source store is built.
+    store: PathBuf,
+    /// Where the copy, the interrupted copy and the restored stores go.
+    scratch: PathBuf,
+    /// Whether this process made the store and so owes the filesystem a `remove_dir_all`.
+    ///
+    /// The scratch directory is always this process's own and always removed: what a drill leaves
+    /// behind on purpose is the store it built, because that is the one thing a caller can name and
+    /// look at afterwards. The copies are what the drill *measured*, and the answer already says what
+    /// was in them.
+    temporary: bool,
+}
+
+impl Workspace {
+    /// The store at `named`, or one of this process's own, and a scratch directory of its own.
+    fn of(named: Option<&Path>) -> Self {
+        let base = std::env::temp_dir().join(format!("lakelet-drill-{}", std::process::id()));
+        let (store, temporary) = match named {
+            Some(store) => (store.to_path_buf(), false),
+            None => (base.join("store"), true),
+        };
+        Self {
+            store,
+            scratch: base.join("scratch"),
+            temporary,
+        }
+    }
+
+    /// Where the source store is built.
+    fn store(&self) -> &Path {
+        &self.store
+    }
+
+    /// Where the copies and the restores go.
+    fn scratch(&self) -> &Path {
+        &self.scratch
+    }
+}
+
+impl Drop for Workspace {
+    fn drop(&mut self) {
+        if self.temporary {
+            let _ = std::fs::remove_dir_all(&self.store);
+        }
+        let _ = std::fs::remove_dir_all(&self.scratch);
+        // The directory the scratch lives in holds nothing else once it is gone, and a run that
+        // named its own store holds only that scratch there — so a drill leaves no directory behind
+        // either way, and `remove_dir` (not `remove_dir_all`) refuses to take anything that is not
+        // this run's own.
+        if let Some(base) = self.scratch.parent() {
+            let _ = std::fs::remove_dir(base);
+        }
+    }
+}
+
+/// Claim the directories of one drill, refusing a store that is already there.
+fn workspace(named: Option<&Path>) -> Result<Workspace, Outcome> {
+    let workspace = Workspace::of(named);
+    // A drill *builds* the store it copies, so a directory that already holds one is a directory this
+    // command would write over. Emptying it instead is not on offer: a drill is not a delete.
+    let occupied = workspace.store().join(crate::engine::compaction::MANIFEST);
+    if occupied.exists() {
+        return Err(Outcome::refused(
+            super::REFUSED,
+            format!(
+                "`{}` already holds a store: `drill` builds the store it copies, so give it a \
+                 directory that is not one — `drill` never writes over a store",
+                workspace.store().display()
+            ),
+        ));
+    }
+    Ok(workspace)
+}
