+/// The one class a refusal belongs to, and the sentence a reader acts on.
+///
+/// The class is the refusal's own (`crate::engine::backup::Error::class`), so this file does not keep
+/// a second table of what a failed copy exits with: the module that can tell the failures apart is
+/// the place that knows which exit code each one is — `lakelet/4.10-downsampling`'s rule for a query,
+/// and the same rule here.
+fn complained(error: &Refusal, what: &str) -> Outcome {
+    Outcome::refused(error.class(), format!("{what}: {error}"))
