+/// The answer in the shape that was asked for: one `name=value` per line, or one JSON object.
+///
+/// The order of the measurements is the order the lines are printed in, and it is the same order the
+/// object's keys are written in — a script reads the names, and a person reads the order.
+fn answered(observed: &[(&str, Measurement)], json: bool) -> Outcome {
+    if json {
+        return match serde_json::to_string(&Answer(observed)) {
+            Ok(document) => Outcome::answered(format!("{document}\n")),
+            Err(error) => Outcome::refused(
+                super::BROKEN,
+                format!("the answer could not be written as JSON: {error}"),
+            ),
+        };
+    }
+    let mut stdout = String::new();
+    for (name, measurement) in observed {
+        stdout.push_str(&format!("{name}={}\n", measurement.text()));
+    }
+    Outcome::answered(stdout)
