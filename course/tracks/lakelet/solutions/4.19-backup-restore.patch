+/// The check a destination gets before anything is written.
+///
+/// A path that exists and is not a directory is nothing about the call and nothing the store can do
+/// either, which is the class `lakelet/4.10-downsampling` gave the read side of this project (`1`).
+/// A path that is *not* there is fine: both commands create it.
+fn target(path: &Path, command: &str) -> Result<(), Outcome> {
+    match std::fs::metadata(path) {
+        Ok(metadata) if !metadata.is_dir() => Err(Outcome::refused(
+            super::BROKEN,
+            format!(
+                "`{}` is not a directory, so `{command}` cannot write a store there: nothing about \
+                 the call is wrong, and nothing can be written either",
+                path.display()
+            ),
+        )),
+        _ => Ok(()),
+    }
