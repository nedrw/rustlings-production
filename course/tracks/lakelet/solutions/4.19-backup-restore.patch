+/// The two paths a `backup` or a `restore` line names, or the refusal for a line that is not one.
+///
+/// `first` is the flag this command's *source* is: `--store` for a copy, `--from` for a restore. The
+/// other is `--to` in both, because both write somewhere. A flag given twice is refused rather than
+/// resolved, which is `lakelet/4.10-downsampling`'s rule for its own flags: a script that appends
+/// defaults to a caller's line would otherwise have one of them silently ignored.
+fn paths(flags: &[&str], first: &str, command: &str) -> Result<(PathBuf, PathBuf), Outcome> {
+    let mut source: Option<&str> = None;
+    let mut destination: Option<&str> = None;
+    let mut index = 0;
+    while let Some(flag) = flags.get(index).copied() {
+        let Some(value) = flags.get(index + 1) else {
+            return Err(Outcome::refused(
+                WRONG,
+                format!("`{flag}` takes a value and did not get one"),
+            ));
+        };
+        let slot = if flag == first {
+            &mut source
+        } else if flag == "--to" {
+            &mut destination
+        } else {
+            return Err(super::unknown(
+                flag,
+                &format!("`{command}` reads `{first} <DIR>` and `--to <DIR>`"),
+            ));
+        };
+        if slot.is_some() {
+            return Err(Outcome::refused(WRONG, format!("`{flag}` was given twice")));
+        }
+        *slot = Some(value);
+        index += 2;
+    }
+    match (source, destination) {
+        (Some(source), Some(destination)) => {
+            Ok((PathBuf::from(source), PathBuf::from(destination)))
+        }
+        (None, _) => Err(Outcome::refused(
+            WRONG,
+            format!("`{command}` did not say `{first}`: `lakeletq --help` lists what it takes"),
+        )),
+        (_, None) => Err(Outcome::refused(
+            WRONG,
+            format!("`{command}` did not say `--to`: `lakeletq --help` lists what it takes"),
+        )),
+    }
