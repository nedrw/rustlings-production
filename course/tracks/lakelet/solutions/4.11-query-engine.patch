+    let shown = Planned {
+        metric: plan.metric().to_owned(),
+        series: plan.series().to_owned(),
+        aggregate: plan.aggregate().name(),
+        from: plan.range().from(),
+        to: plan.range().to(),
+        window: plan.window().width_millis(),
+        windows: plan.windows(),
+        columns: COLUMNS,
+        segments_opened: plan.opened().len() as u64,
+        segments_pruned: plan.pruned().len() as u64,
+        records: plan.records(),
+        limit: plan.limit(),
+    };
