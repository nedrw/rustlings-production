+    metric: String,
+    /// The series name the grammar can spell.
+    series: String,
+    /// How a window's records become one number.
+    aggregate: &'static str,
+    /// The first millisecond of the range.
+    from: u64,
+    /// The millisecond it stops before.
+    to: u64,
+    /// How wide one bucket is, in milliseconds.
+    window: u64,
+    /// How many windows the range touches.
+    windows: u64,
+    /// The columns a reader decodes.
+    columns: &'static str,
+    /// How many segments the query would open.
+    segments_opened: u64,
+    /// How many the manifest's spans rule out.
+    segments_pruned: u64,
+    /// How many records those segments hold, from the index.
+    records: u64,
+    /// How many series the answer may cover, or `null`.
+    limit: Option<u64>,
+}
