+/// Answer one `--sql` question.
+///
+/// The order is the whole of this function, and it is not arbitrary: read the text, refuse a
+/// question that is too big for this tool *before* a store is opened, then the two path checks,
+/// then the store, then the plan or the execution. Every caller mistake is answered before
+/// anything is opened, so a `2` is the script's problem wherever the deployment happens to be —
+/// `jobq/3.15-cli-contract`'s rule, applied to a second input form rather than restated.
+fn sql_query(store: &str, text: &str, json: bool) -> Outcome {
+    let statement = match parse::parse(text) {
+        Ok(statement) => statement,
+        Err(refusal) => return refused_by(&refusal),
+    };
+    let asked = match &statement {
+        Statement::Query(query) => query,
+        Statement::Explain(query) => query,
+    };
+    let windows = plan::windows_of(asked.range(), asked.window());
+    if windows > MAX_WINDOWS {
+        return too_many(
+            windows,
+            asked.range(),
+            &format!(
+                "`time({})` is the window",
+                duration_text(asked.window().width_millis())
+            ),
+        );
+    }
+
+    let path = Path::new(store);
+    if let Err(outcome) = directory(path) {
+        return outcome;
+    }
+    let store = match Segments::open(path) {
+        Ok(store) => store,
+        Err(error) => return class(&error, "the store could not be opened"),
+    };
+    // One snapshot for the whole call, which is what makes `EXPLAIN` and the answer it explains
+    // two statements about one store: taking a snapshot reads the manifest and opens no segment,
+    // so a plan answers about a store whose segment files are unreadable.
+    let snapshot = store.snapshot();
+    match statement {
+        Statement::Explain(query) => match Plan::of(&snapshot, &query) {
+            Ok(plan) => render_plan(&plan, json),
+            Err(refusal) => refused_by(&refusal),
