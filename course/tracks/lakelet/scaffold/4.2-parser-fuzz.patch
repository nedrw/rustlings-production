@@ -0,0 +1,21 @@
+# The parser's corpus
+
+Every `.txt` file here holds corpus entries, one per line:
+
+```text
+# a header that declares one byte of payload, and nothing else
+0100000001
+```
+
+- two hex digits per byte, no separators, nothing else on the line;
+- a blank line, or a line starting with `#`, is a comment;
+- one line is one input: bytes that once made the ingest decoder or the frame scanner misbehave,
+  kept so the same input cannot take anybody by surprise twice.
+
+`cargo test -p lakelet --test fuzz_protocol` replays everything here, and so does the step's spec —
+which refuses a corpus that holds nothing, because an empty corpus is a fuzzer that found nothing
+rather than a parser that survives everything.
+
+Add the input your fuzzer found, not a description of it: the harness prints it, already in this
+format, when a walk falls over one. A corpus entry is a case — the bytes, and a `#` line saying
+which failure they stand for.
diff --git a/tests/fuzz_protocol.rs b/tests/fuzz_protocol.rs
new file mode 100644
index 0000000..0a0a761
--- /dev/null
+++ b/tests/fuzz_protocol.rs
@@ -0,0 +1,110 @@
+//! The fuzzing harness for `lakelet/4.2-parser-fuzz`.
+//!
+//! This file is the course's, not the learner's. `cargo test -p lakelet --test fuzz_protocol --
+//! --nocapture` is the command the step's `slow:fuzz` gate runs, and the two lines it prints at
+//! the end are what the gate compares with `course/tracks/lakelet/fuzz/4.2-parser-fuzz.toml`.
+//!
+//! Three things happen here, and each one is a decision:
+//!
+//! * **the search** — `mutate::walk` hands this file inputs, one at a time, and every one of them
+//!   goes to both of the functions a hostile peer points at: `frame::decode` and `sniff::ranges`.
+//!   What is judged below is that the run *finishes*: a panic is the finding, and this file prints
+//!   the input that caused it before it lets the panic through, because a fuzzer that does not say
+//!   which input broke the parser leaves its user to bisect by hand;
+//! * **the corpus** — every input under `tests/corpus/**` is replayed through the same two
+//!   functions. That is what makes a corpus a regression test rather than a folder of souvenirs:
+//!   the input that broke something is run again on every build, and the count of them is part of
+//!   what the gate is shown;
+//! * **the counters** — one `<track>-fuzz <name>=<value>` line per metric, printed at the end.
+//!   `iterations` is what the walk *did*, not what it was asked for: a walk that visits fewer
+//!   inputs than it was given is a walk with a bug in it, and the number says so.
+//!
+//! Nothing here compares a measurement with a bound — the bounds are the course's, in the file
+//! above, and this file only has to be honest about what happened.
+
+use std::panic::{catch_unwind, resume_unwind};
+use std::path::Path;
+
+use lakelet::protocol::{corpus, frame, mutate, sniff};
+
+/// How many inputs one seed's walk is asked for.
+///
+/// The gate's floor is per seed and lives in the course's file (`iterations_min`); this is what
+/// this machine actually walks, and the two are deliberately not the same number: the floor is a
+/// judgement about the search, and this is the search.
+const ITERATIONS: usize = 60_000;
+
+/// The seed a walk uses when the environment names none (`KILN_FUZZ_SEED`).
+const DEFAULT_SEED: u64 = 1;
+
+#[test]
+fn the_walk_and_the_corpus() {
+    let seed = seed();
+    let origin = format!("the walk under seed {seed}");
+    let mut visited = 0usize;
+    let mut accepted = 0usize;
+    let mut ranges = 0usize;
+    mutate::walk(seed, ITERATIONS, |input| {
+        visited += 1;
+        let (decoded, found) = exercise(input, &origin);
+        accepted += usize::from(decoded);
+        ranges += found;
+    });
+
+    let cases = corpus::load(Path::new(corpus::DIR)).unwrap_or_else(|error| {
+        panic!(
+            "the corpus below {} could not be read: {error}",
+            corpus::DIR
+        )
+    });
+    let mut replayed = 0usize;
+    for case in &cases {
+        replayed += 1;
+        // The answers are not this loop's business: a corpus entry is replayed to see that it
+        // does not panic today.
+        let _ = exercise(
+            &case.bytes,
+            &format!("{}/{file}", corpus::DIR, file = case.file),
+        );
+    }
+
+    println!(
+        "fuzz seed={seed} walked {visited} input(s) — {accepted} of them a whole frame for the \
+         decoder, {ranges} range(s) for the scanner — and replayed {replayed} input(s) from {}",
+        corpus::DIR
+    );
+    println!("lakelet-fuzz iterations={visited}");
+    println!("lakelet-fuzz corpus_cases={replayed}");
+}
+
+/// Hand one input to both parsers, and answer what they said about it.
+///
+/// A panic is reported here, with the input, and then let through: this file's job is to find out
+/// that a parser cannot take an input, not to hide it from the gate.
+fn exercise(input: &[u8], origin: &str) -> (bool, usize) {
+    let outcome = catch_unwind(|| {
+        let decoded = frame::decode(input);
+        let scanned = sniff::ranges(input);
+        (matches!(decoded, frame::Decoded::Frame(..)), scanned.len())
+    });
+    match outcome {
+        Ok(answers) => answers,
+        Err(panic) => {
+            println!("fuzz found a panic from {origin} on this input:");
+            println!("{}", corpus::hex(input));
+            resume_unwind(panic);
+        }
+    }
+}
+
+/// The seed this run walks under: `KILN_FUZZ_SEED`, or [`DEFAULT_SEED`] when it says nothing.
+fn seed() -> u64 {
+    match std::env::var("KILN_FUZZ_SEED") {
+        Ok(text) => text.trim().parse().unwrap_or_else(|_| {
+            panic!(
+                "KILN_FUZZ_SEED is `{text}`, which is not a seed: a walk is seeded with a number"
+            )
+        }),
+        Err(_) => DEFAULT_SEED,
+    }
+}
