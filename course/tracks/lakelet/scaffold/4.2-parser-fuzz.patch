@@ -0,0 +1,155 @@
+//! The regression corpus: the inputs that once broke a parser, kept as text.
+//!
+//! A fuzzer produces two things, and only one of them is a number. The number is how much it
+//! looked; the other is the *input* it fell over — and an input kept in a terminal scrollback, a
+//! fragment of a chat message or a memory of "something about a length field" is not evidence.
+//! This module is the file format those inputs are kept in: one input per line, hex, under
+//! `tests/corpus/`, so a reviewer reads a corpus entry in a diff and an incident review can quote
+//! it.
+//!
+//! Three decisions are in the format:
+//!
+//! * **text, not bytes** — a corpus entry is reviewed by a person, and a `.txt` line survives `git
+//!   diff`, a code review and a copy-paste into an issue where a binary blob does not;
+//! * **one line, one input, and no order of its own** — files are read in path order and lines in
+//!   file order, so two machines replay the same list. A directory listing has no order, and a
+//!   corpus whose replay order changed between machines is a corpus whose failures are not
+//!   reproducible;
+//! * **a missing directory is an empty corpus** — a fuzzer that has found nothing yet is a normal
+//!   state, and "the corpus is empty" is a judgement for whoever is measuring the work, not an
+//!   error from the reader.
+
+use std::path::{Path, PathBuf};
+
+use crate::error::Error;
+
+/// Where the corpus lives, relative to the project root.
+///
+/// One directory per thing that parses: `tests/corpus/parser` is the ingest decoder's and the
+/// sniffer's, and a later step adds its own next to it rather than into it.
+pub const DIR: &str = "tests/corpus";
+
+/// One input out of the corpus, and where it came from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Case {
+    /// The file it was read from, relative to the directory it was read below.
+    pub file: String,
+    /// The line within that file, 1-based, as an editor counts them.
+    pub line: usize,
+    /// The bytes the line stands for.
+    pub bytes: Vec<u8>,
+}
+
+/// Every `.txt` input below `directory`, in file order and then in line order.
+///
+/// Only `.txt` files are read: a corpus directory also holds the note that explains what it is,
+/// and an explanation is not an input.
+///
+/// # Errors
+///
+/// [`Error::Invalid`] when a line is not an even number of hex digits, naming the file and the
+/// line — a corpus entry nobody can read back is worse than a missing one, because it looks like
+/// coverage. [`Error::Config`] when a file or a directory it walks through cannot be read.
+pub fn load(directory: &Path) -> Result<Vec<Case>, Error> {
+    let mut files: Vec<PathBuf> = Vec::new();
+    collect(directory, &mut files)?;
+    files.sort();
+
+    let mut cases = Vec::new();
+    for path in files {
+        let text = std::fs::read_to_string(&path).map_err(|source| Error::Config {
+            path: path.clone(),
+            source: Box::new(source),
+        })?;
+        let file = path
+            .strip_prefix(directory)
+            .unwrap_or(&path)
+            .display()
+            .to_string();
+        for (index, line) in text.lines().enumerate() {
+            let entry = line.trim();
+            if entry.is_empty() || entry.starts_with('#') {
+                continue;
+            }
+            let Some(bytes) = unhex(entry) else {
+                return Err(Error::Invalid {
+                    detail: format!(
+                        "{}/{file}:{} is not a corpus entry: a line is an even number of hex digits \
+                         (`0100000001`), a blank line, or a comment starting with `#`",
+                        directory.display(),
+                        index + 1
+                    ),
+                });
+            };
+            cases.push(Case {
+                file: file.clone(),
+                line: index + 1,
+                bytes,
+            });
+        }
+    }
+    Ok(cases)
+}
+
+/// The line of hex that stands for `bytes` — what an input looks like written down, and what the
+/// fuzzing harness prints when the walk falls over one.
+#[must_use]
+pub fn hex(bytes: &[u8]) -> String {
+    let mut text = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        text.push_str(&format!("{byte:02x}"));
+    }
+    text
+}
+
+/// The bytes a line of hex stands for, or `None` when the line is not one.
+fn unhex(text: &str) -> Option<Vec<u8>> {
+    let digits = text.as_bytes();
+    if !digits.len().is_multiple_of(2) {
+        return None;
+    }
+    let mut bytes = Vec::with_capacity(digits.len() / 2);
+    for &[high, low] in digits.as_chunks::<2>().0 {
+        bytes.push(digit(high)? << 4 | digit(low)?);
+    }
+    Some(bytes)
+}
+
+/// One hex digit, or `None` when the byte is not one.
+///
+/// Written out rather than taken from `u8::from_str_radix`, which also accepts a leading sign: a
+/// corpus line `+f` is not an entry this format has.
+fn digit(byte: u8) -> Option<u8> {
+    let value = (byte as char).to_digit(16)?;
+    u8::try_from(value).ok()
+}
+
+/// Every `.txt` file below `directory`, recursively.
+///
+/// A directory that is not there holds no input and is not an error: the corpus grows as the step
+/// finds things.
+fn collect(directory: &Path, found: &mut Vec<PathBuf>) -> Result<(), Error> {
+    let entries = match std::fs::read_dir(directory) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(source) => {
+            return Err(Error::Config {
+                path: directory.to_path_buf(),
+                source: Box::new(source),
+            });
+        }
+    };
+    for entry in entries {
+        let entry = entry.map_err(|source| Error::Config {
+            path: directory.to_path_buf(),
+            source: Box::new(source),
+        })?;
+        let path = entry.path();
+        if path.is_dir() {
+            collect(&path, found)?;
+        } else if path.extension().is_some_and(|extension| extension == "txt") {
+            found.push(path);
+        }
+    }
+    Ok(())
+}
