index 0000000..7d74520
--- /dev/null
+++ b/src/protocol/sniff.rs
@@ -0,0 +1,97 @@
+//! Finding the frames inside a raw capture.
+//!
+//! A capture is what a socket, a `tcpdump` file or a store's log leaves behind: bytes, with frames
+//! *somewhere* in them. It is not a stream: a capture may start in the middle of a frame, hold a
+//! connection that died halfway through one, and carry a header the tool that wrote it added. What
+//! step `lakelet/4.1-ingest-protocol` built is the decoder for *one* frame; this module is the
+//! other half of an incident review, the one that answers "which frames are in this file?".
+//!
+//! The scanner is deliberately forgiving and the frame is not: bytes that cannot start a frame are
+//! skipped one at a time, and a candidate becomes a range only when it is a whole frame *this*
+//! protocol's decoder would read — length, version and checksum included. A "sniffer" that
+//! demanded the capture start on a boundary would be a decoder with extra steps, and a sniffer
+//! that trusted a length and a version alone would hand its caller ranges of junk that happen to
+//! look like a header.
+
+use std::ops::Range;
+
+use crate::protocol::frame::{MAX_PAYLOAD, OVERHEAD, VERSION};
+
+/// Bytes a candidate needs before it can be judged: four of length and one of version.
+const HEADER: usize = 5;
+
+/// The four bytes of checksum that close a frame.
+const CHECKSUM: usize = 4;
+
+// The two constants above and the frame module's overhead are two ways of writing one layout:
+// `OVERHEAD` is the header, the payload and the checksum, so the split has to add up to it.
+const _: () = assert!(HEADER + CHECKSUM == OVERHEAD);
+
+/// Every frame in `buffer`, in the order they appear and without overlapping.
+///
+/// One range per frame, from its length field to the byte after its checksum, so
+/// `&buffer[range]` is a whole frame and
+/// [`frame::decode`](crate::protocol::frame::decode) answers
+/// [`Decoded::Frame`](crate::protocol::frame::Decoded::Frame) for it instead of asking for more
+/// bytes.
+///
+/// Two decisions are in the code: **one byte at a time**, because that is what finds a frame that
+/// junk precedes — a scanner that gave up on the rest of the capture after the first byte that was
+/// not a frame would miss everything behind it — and **the checksum decides**, because junk can
+/// look like a header by accident (four bytes that happen to be a small length, a byte that
+/// happens to be [`VERSION`]), and a candidate whose checksum does not match its payload is not a
+/// frame.
+///
+/// # Panics
+///
+/// Never, for any input: a capture is whatever a broken peer or a half-written file left behind,
+/// and the point of scanning one is to learn something rather than to fall over.
+#[must_use]
+pub fn ranges(buffer: &[u8]) -> Vec<Range<usize>> {
+    let mut found = Vec::new();
+    let mut base = 0;
+    let mut window = buffer;
+    while !window.is_empty() {
+        match next_frame(window) {
+            Some((frame, rest)) => {
+                found.push(base..base + frame.len());
+                base += frame.len();
+                window = rest;
+            }
+            None => {
+                // Not a frame: the capture goes on one byte later. That is what makes this a scan
+                // rather than a decoder — junk in front of a frame does not hide it — and it is
+                // also why the scan costs what the capture is long and not what its frames are.
+                let (_, rest) = window.split_at(1);
+                base += 1;
+                window = rest;
+            }
+        }
+    }
+    found
+}
+
+/// The frame at the front of `window`, with what follows it, or `None` when the bytes there are
+/// not a frame.
+fn next_frame(window: &[u8]) -> Option<(&[u8], &[u8])> {
+    let header = window.get(..HEADER)?;
+    let length = u32::from_le_bytes(header.get(..4)?.try_into().ok()?) as usize;
+    if length > MAX_PAYLOAD || header.get(4) != Some(&VERSION) {
+        return None;
+    }
+    // The payload the header declares has to be in the window: a capture can end in the middle of
+    // a frame, and the bytes at the front are then not one.
+    if HEADER + length > window.len() {
+        return None;
+    }
+    let size = OVERHEAD + length;
+    // The frame is the front of the window, and the caller carries on with what is left of it.
+    let (frame, rest) = window.split_at(size);
+    let payload = frame.get(HEADER..size - CHECKSUM)?;
+    let mut stored = [0u8; CHECKSUM];
+    stored.copy_from_slice(frame.get(size - CHECKSUM..)?);
+    if u32::from_le_bytes(stored) != crc32fast::hash(payload) {
+        return None;
+    }
+    Some((frame, rest))
+}
