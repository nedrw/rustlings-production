+++ b/tests/budget.rs
@@ -0,0 +1,168 @@
+//! The write-amplification budget's harness for `lakelet/4.5-batch-writes`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.5-batch-writes
+//! --slow` runs, and the numbers it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.5-batch-writes.toml` — the same records written as one batch and
+//! one append at a time, at two batch sizes.
+//!
+//! What it measures is **calls, never the clock**: how many calls the write path made and how many
+//! bytes it wrote, counted by the write path itself. A count is the same number on a loaded machine
+//! as on an idle one, which is why `kiln`'s budget gate compares counts and why no run of this file
+//! can flake because something else was compiling.
+//! `cargo test -p lakelet --test budget -- --nocapture` prints the lines by hand; the
+//! `lakelet-budget` prefix is what the gate reads.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness that a learner can break by editing their own fixture would judge
+//! the fixture instead of the write path.
+
+use std::path::PathBuf;
+
+use lakelet::engine::Spool;
+use lakelet::engine::flush::Batcher;
+use lakelet::engine::wal::Policy;
+
+/// The payload every record carries, in bytes.
+const PAYLOAD: usize = 64;
+
+/// The batch the counts are taken on; twice this is the second size.
+///
+/// Two sizes rather than one, because the cost this step is about is the one that follows the
+/// workload: a total at one size cannot tell a batch from a loop over records, and the pair can.
+const BATCH: usize = 64;
+
+/// The second size, and the one the growth guard is taken at.
+const WIDER: usize = 2 * BATCH;
+
+/// The workload: `count` payloads, each one its own bytes.
+///
+/// Derived from the payload's index rather than zero-filled, so a batcher that reordered two
+/// payloads, dropped one or wrote one of them twice cannot pass by agreeing with a pattern.
+fn workload(count: usize) -> Vec<Vec<u8>> {
+    (0..count)
+        .map(|index| {
+            (0..PAYLOAD)
+                .map(|offset| (index as u8).wrapping_mul(31).wrapping_add(offset as u8))
+                .collect()
+        })
+        .collect()
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+/// One ratio line, to four decimals — a ratio of two counts, so it is as steady as they are.
+fn ratio(name: &str, value: f64) {
+    println!("lakelet-budget {name}={value:.4}");
+}
+
+/// Push `payloads` into a batch and write them through `spool` as one call.
+fn batch(spool: &mut Spool, payloads: &[Vec<u8>]) {
+    let mut batcher = Batcher::new();
+    for payload in payloads {
+        batcher.push(payload.as_slice());
+    }
+    batcher
+        .flush(spool)
+        .unwrap_or_else(|error| panic!("a batch of {} records: {error}", payloads.len()));
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path =
+            std::env::temp_dir().join(format!("lakelet-budget-{label}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Open a store in it, obeying `policy`.
+    fn store(&self, policy: Policy) -> Spool {
+        Spool::with_policy(self.path.as_path(), policy).unwrap_or_else(|error| {
+            panic!(
+                "{} is a store the write path can open: {error}",
+                self.path.display()
+            )
+        })
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+#[test]
+fn the_write_path_budget() {
+    let records = workload(WIDER);
+
+    // One batch of BATCH records, with no device call in the way: this is what batching changes.
+    let batched = Dir::new("batched");
+    let mut spool = batched.store(Policy::Never);
+    batch(&mut spool, &records[..BATCH]);
+    let small = spool.stats();
+
+    // The same records at twice the batch size, in a store of their own, so both pairs of counts
+    // come from the same work and a cost that follows the size has somewhere to show up.
+    let wider = Dir::new("wider");
+    let mut spool = wider.store(Policy::Never);
+    batch(&mut spool, &records);
+    let large = spool.stats();
+
+    // The same BATCH records, one append at a time: the shape `lakelet/4.1-ingest-protocol` left
+    // behind, and the contrast the counts above are about.
+    let separate = Dir::new("separate");
+    let mut spool = separate.store(Policy::Never);
+    for payload in &records[..BATCH] {
+        spool
+            .append(payload)
+            .unwrap_or_else(|error| panic!("one record of {BATCH}: {error}"));
+    }
+    let one_at_a_time = spool.stats();
+
+    // And one batch under a policy that waits for the device, which is where the third call a batch
+    // can make — the flush — is counted.
+    let durable = Dir::new("durable");
+    let mut spool = durable.store(Policy::PerRecord);
+    batch(&mut spool, &records[..BATCH]);
+    let waited = spool.stats();
+
+    metric(&format!("records_{BATCH}"), small.records());
+    metric(&format!("calls_{BATCH}"), small.calls());
+    metric(&format!("bytes_{BATCH}"), small.bytes());
+    metric(&format!("records_{WIDER}"), large.records());
+    metric(&format!("calls_{WIDER}"), large.calls());
+    metric(&format!("bytes_{WIDER}"), large.bytes());
+    // Write amplification, in the shape this step is about: bytes the write path wrote per payload
+    // byte. The framing of a record and the log's header are the whole of the difference from one.
+    ratio(
+        "bytes_per_payload",
+        small.bytes() as f64 / (BATCH * PAYLOAD) as f64,
+    );
+    // The calls one record costs, and the guard: it may only go down, so a write path that adds a
+    // call per batch is red while a cheaper one — `writev`, a held-open handle — is not.
+    ratio(
+        "calls_per_record_max",
+        small.calls() as f64 / small.records() as f64,
+    );
+    // The same guard across the two sizes: a cost that follows the batch size instead of the work.
+    ratio(
+        "calls_ratio_max",
+        large.calls() as f64 / small.calls() as f64,
+    );
+    // Device calls one batch costs under a policy that waits for every record.
+    metric("fsyncs_per_batch", waited.syncs());
+    // And the shape being replaced: BATCH records written one append at a time. The same bytes.
+    metric("appends_calls_max", one_at_a_time.calls());
+}
