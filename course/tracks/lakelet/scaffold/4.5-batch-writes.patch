@@ -0,0 +1,150 @@
+//! The payloads that arrive together, and what writing them cost.
+//!
+//! Step `lakelet/4.5-batch-writes`. `lakelet/4.1-ingest-protocol` made an append a promise: the
+//! record is written before the caller who sent it is answered. This file is where a *group* of
+//! those promises is made at once — the frames one turn of an event loop delivered, written as one
+//! batch — without moving the write behind the answer it replaces.
+//!
+//! The two shapes below are the whole contract:
+//!
+//! * [`Batcher`] holds payloads and remembers the order they arrived in. Holding is not writing:
+//!   nothing is on the file until [`Batcher::flush`] is called, which is what lets a caller write a
+//!   turn's worth of frames in one call instead of one call each;
+//! * [`Stats`] is what those calls have cost so far. It is charged where the calls happen, never by
+//!   the caller: a counter the caller increments reports what the caller believes it did.
+//!
+//! Back-pressure is deliberately absent. What a process does when payloads arrive faster than a
+//! batch can be written is `lakelet/4.6-ingest-backpressure`, and this file is only about what one
+//! call costs.
+
+use crate::engine::Spool;
+use crate::error::Error;
+
+/// What the write path has cost so far, counted.
+///
+/// Counters and never durations: a count is the same number on a loaded machine as on an idle one,
+/// and this value is what the step's page and the course's budget are written in.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Stats {
+    /// Records written.
+    records: u64,
+    /// Bytes written, the framing of every record included.
+    bytes: u64,
+    /// Calls made to write them: every open and every write.
+    calls: u64,
+    /// Device flushes the policy asked for.
+    syncs: u64,
+    /// Batches written. A batch that carried nothing is not one.
+    batches: u64,
+}
+
+impl Stats {
+    /// Records the write path has written.
+    #[must_use]
+    pub fn records(&self) -> u64 {
+        self.records
+    }
+
+    /// Bytes the write path has written, the framing of every record included.
+    #[must_use]
+    pub fn bytes(&self) -> u64 {
+        self.bytes
+    }
+
+    /// Calls the write path made to put those bytes on the file: every open and every write.
+    ///
+    /// This is the number batching moves. The bytes are the ones N separate appends would have
+    /// written and the order is the same; how they were handed to the kernel is what changed.
+    #[must_use]
+    pub fn calls(&self) -> u64 {
+        self.calls
+    }
+
+    /// Device flushes this write path's policy asked for.
+    #[must_use]
+    pub fn syncs(&self) -> u64 {
+        self.syncs
+    }
+
+    /// Batches the write path has written.
+    #[must_use]
+    pub fn batches(&self) -> u64 {
+        self.batches
+    }
+
+    /// Charge one batch to the write path.
+    ///
+    /// Called by the write path itself, at the moment the calls are made, which is the only place
+    /// that can count them: `records` is how many payloads the batch carried, `bytes` how many bytes
+    /// reached the file, and `calls` the opens and writes it took to put them there.
+    pub(crate) fn charge(&mut self, records: u64, bytes: u64, calls: u64) {
+        self.records += records;
+        self.bytes += bytes;
+        self.calls += calls;
+        self.batches += 1;
+    }
+
+    /// Charge one device flush: the call `Spool::sync` made, counted when it *succeeded*.
+    pub(crate) fn charge_sync(&mut self) {
+        self.syncs += 1;
+    }
+}
+
+/// The payloads that arrived together, waiting for the one call that writes them.
+#[derive(Debug, Clone, Default)]
+pub struct Batcher {
+    /// The payloads, in the order they arrived; empty between a flush and the next turn.
+    pending: Vec<Vec<u8>>,
+}
+
+impl Batcher {
+    /// An empty batch.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Add one payload to the batch being assembled, in the order it arrived.
+    ///
+    /// Nothing is written here: this is the half of the promise that lets a caller hold a turn's
+    /// frames, and [`Batcher::flush`] is the half that keeps it.
+    pub fn push(&mut self, payload: impl Into<Vec<u8>>) {
+        self.pending.push(payload.into());
+    }
+
+    /// How many payloads are waiting.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.pending.len()
+    }
+
+    /// `true` when nothing is waiting, which is the one case where flushing writes nothing.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.pending.is_empty()
+    }
+
+    /// Write every payload that is waiting as **one batch**, and answer once they are readable.
+    ///
+    /// One call into the write path, whatever the batch is worth: the payloads leave in the order
+    /// they arrived, as the records [`crate::engine::wal::segment`] defines, and this call answers
+    /// after the bytes are on the file — the promise [`Spool::append`] makes, made once for the
+    /// group instead of once per payload.
+    ///
+    /// An empty batch is not a write: nothing is opened, nothing is counted, and a caller that
+    /// flushes a turn in which nothing arrived pays nothing for it. A batch that could not be
+    /// written keeps its payloads: this type does not decide for its caller whether a failed write
+    /// is retried.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Store`] when the batch cannot be written, or when the policy waited for the device
+    /// and the device refused it — the same failures [`Spool::append`] reports, for the same reason:
+    /// the bytes of a refused flush are readable and no client should be told they are safe.
+    ///
+    /// [`Spool::append`]: crate::engine::Spool::append
+    pub fn flush(&mut self, spool: &mut Spool) -> Result<(), Error> {
+        let _ = spool;
+        todo!("step lakelet/4.5-batch-writes")
+    }
+}
