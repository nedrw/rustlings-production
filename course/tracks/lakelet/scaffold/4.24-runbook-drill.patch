+
+/// The page this step delivers, relative to the project.
+pub const PAGE: &str = "docs/runbook.md";
+
+/// The five parts a stage owes, in the order a page writes them.
+///
+/// `command` is not written as a line: it is the stage's fenced `sh` block. The other four are
+/// `- name: …` lines, because a responder under pressure reads a column rather than a paragraph.
+pub const PARTS: [&str; 5] = ["command", "signal", "state", "rollback", "audience"];
+
+/// The programs this deployment ships: what a stage's command has to start with.
+pub const PROGRAMS: [&str; 3] = ["lakeletd", "lakeletq", "lakelet-load"];
+
+/// Where each program's own grammar is written down: the usage text it prints for itself.
+///
+/// A command is a member of this deployment's grammar when its program is one of [`PROGRAMS`],
+/// its verb is a word that program declares, and every flag it carries is one too. The words are
+/// read out of the program's own source rather than listed here, so a step that teaches a new verb
+/// teaches the page about it in the same edit — and a plausible-looking command
+/// (`lakeletq tier sweep …`, a flag with a typo) is a finding rather than a process that does
+/// something else.
+pub const GRAMMAR: [(&str, &str); 3] = [
+    ("lakeletd", "src/bin/lakeletd.rs"),
+    ("lakeletq", "src/cli/mod.rs"),
+    ("lakelet-load", "src/bin/lakelet-load.rs"),
+];
+
+/// The variables a page may use, and the world this instrument points them at.
+pub const VARS: [&str; 4] = [
+    "LAKELET_STORE",
+    "LAKELET_COPY",
+    "LAKELET_RESTORED",
+    "LAKELET_ADDR",
+];
+
+/// The word a rollback uses for a stage that changes nothing.
+pub const NOTHING_TAKEN: &str = "nothing was taken";
+
+/// The word a rollback uses for an act that cannot be undone.
+pub const NOT_UNDONE: &str = "none";
+
+/// The prefix every line of the report carries: the track and the page it is about.
+pub const PREFIX: &str = "lakelet-runbook";
+
+/// One thing a stage has to say before this instrument can run it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Check {
+    /// The name a page's `state` line carries.
+    pub name: &'static str,
+    /// The words the stage's command has to carry for this check to be about that act.
+    pub act: &'static [&'static str],
+    /// Whether the act writes something the deployment serves.
+    ///
+    /// `true` means the stage's rollback may not say that nothing was taken: an operator who put
+    /// records on the store has something to put back.
+    pub takes: bool,
+}
+
+/// The checks this instrument makes, in the order a procedure meets them.
+pub const CHECKS: [Check; 8] = [
+    Check {
+        name: "settings-print",
+        act: &["lakeletd", "--check-config"],
+        takes: false,
+    },
+    Check {
+        name: "copy-holds-the-store",
+        act: &["lakeletq", "backup"],
+        takes: false,
+    },
+    Check {
+        name: "restore-holds-the-records",
+        act: &["lakeletq", "restore"],
+        takes: false,
+    },
+    Check {
+        name: "drill-agrees",
+        act: &["lakeletq", "drill"],
+        takes: false,
+    },
+    Check {
+        name: "counters-flat",
+        act: &["lakelet-load"],
+        takes: true,
+    },
+    Check {
+        name: "bill-adds-up",
+        act: &["lakeletq", "inspect", "series"],
+        takes: false,
+    },
+    Check {
+        name: "cold-span-answered",
+        act: &["lakeletq", "query"],
