+# The pipeline, as code (step `lakelet/4.22-reproducible-build`).
+#
+# The commands this file has to run, in the order the course's own CI runs them — cheapest failure
+# first, and the reproducer last because it is two whole release builds:
+#
+#   cargo fmt --all --check
+#   cargo clippy --workspace --all-targets --locked -- -D warnings
+#   cargo test --workspace --locked
+#   scripts/repro.sh
+#
+# The toolchain is not named here: `rust-toolchain.toml` in the repository is the one place the
+# channel is written down, and the runner's `rustup` reads it because the file is in the checkout. A
+# version in this file would be a second pin.
+#
+# The step's spec reads this file **as text** — no YAML parser is a dependency of this project and one
+# must not become one — so what it judges is the commands and their order, which is the part a
+# reviewer argues about.
+name: ci
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  check:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
