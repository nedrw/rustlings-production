+++ b/scripts/repro.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+# The reproducer (step `lakelet/4.22-reproducible-build`) — the job, and the job not done.
+#
+# A build is reproducible when two builds of the same source are the same artifact. What this file has
+# to become:
+#
+#   * copy this tree's sources into **two different directories** — different depths, so a difference
+#     that is only the path shows up in the bytes;
+#   * build each with the pinned toolchain (`rust-toolchain.toml`) and the locked dependencies
+#     (`--locked`);
+#   * neutralise the one difference two builds of one tree structurally have — *where* they happened —
+#     with `--remap-path-prefix`, passed to both builds, over everything that names the location (the
+#     copy of the tree *and* the target directory beside it);
+#   * compare the library and the binaries byte for byte, and print the comparison as one
+#     `name=value` line per fact: which artifacts, how many compared, how many identical, how many
+#     differing, what happened to each named difference, and a verdict. Never a hash, a path or a
+#     timestamp: a page quotes this output and compares it line for line.
+#   * exit non-zero when something differs that the block does not name.
+set -eu
+
+echo "repro: not written yet." >&2
+echo "repro: the two builds, the comparison and the block are what this step is about." >&2
+exit 1
