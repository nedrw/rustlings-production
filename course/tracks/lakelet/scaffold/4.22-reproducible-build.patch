index 0000000..80e1e38
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,24 @@
+# The image this daemon ships as (step `lakelet/4.22-reproducible-build`).
+#
+# One stage, for now, and it is the shape `mailer/1.21-container` started from: the toolchain and the
+# sources that built the binary stay in the image that *runs*, so what ships is a build environment
+# with a binary inside it. This step's spec says what that costs, one failed case at a time, and
+# `container-repro` is the gate that prices it: the runtime stage is held to 25 MB, and a stage that
+# is really the builder weighs hundreds of megabytes.
+#
+# The base image is a build argument rather than a literal, because behind a registry mirror the same
+# image lives under another name and the gate passes the name this engine actually stores
+# (`--build-arg BUILDER=…`). This step declares **two** images — a builder and a runtime — and only one
+# of them is in this file so far.
+ARG BUILDER=rust:1.98-alpine
+FROM ${BUILDER}
+
+WORKDIR /src
+COPY . .
+RUN cargo build --release --locked --bin lakeletd
+
+# The daemon answers `--check-config` with the configuration it would run with, without opening a
+# store or binding a port. That is the question `container-repro` asks the finished image and this
+# host's binary, and the answer has to be `lakeletd`'s.
+EXPOSE 7000
+ENTRYPOINT ["/src/target/release/lakeletd"]
