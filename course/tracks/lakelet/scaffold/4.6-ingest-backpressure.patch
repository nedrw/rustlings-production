index 0000000..a31928a
--- /dev/null
+++ b/src/service/backpressure.rs
@@ -0,0 +1,379 @@
+//! The bound between accepting a frame and writing it, and the decision overload makes.
+//!
+//! Step `lakelet/4.6-ingest-backpressure`. `lakelet/4.1-ingest-protocol` made the frame the unit the
+//! client is answered about, and `lakelet/4.5-batch-writes` made it the unit the write path writes;
+//! what neither decided is how *much* may sit between the two. That is this file, and it is three
+//! things:
+//!
+//! * [`Queue`] is a bounded queue of frames between the accept loop and the write path. Its bound is
+//!   a number the deployment chooses ([`DEFAULT_CAPACITY`] is what it gets when nobody says), and
+//!   nothing a producer does may make the queue hold more than that;
+//! * [`Policy`] is what the queue does when a frame arrives and the bound is reached: wait for room,
+//!   refuse the arrival, or take the frame that has been waiting longest back. `Sample` is the one
+//!   policy that is a *rate* rather than a bound — it drops frames without the queue being full,
+//!   because what it protects is the write path's throughput and not the memory;
+//! * [`Tally`] is what one caller is told: the frames it offered that were written, and the ones the
+//!   queue dropped — including frames a later decision took back while they were still queued. A
+//!   caller that reads its own tally therefore cannot acknowledge a frame the queue dropped, whoever
+//!   offered it.
+//!
+//! The conservation law the whole file is built around, and the one the spec checks per policy:
+//!
+//! ```text
+//! offered == accepted + dropped     every frame offered is either the queue's or dropped
+//! accepted == written + queued      at rest: the queue owes a write for what the writer has not
+//!                                   written yet
+//! ```
+//!
+//! `accepted` counts the frames the queue took in and has not dropped again, so a frame that was
+//! queued and later evicted leaves `accepted` with it. The two equations are one statement, and the
+//! second is what makes "a dropped frame is never acknowledged" checkable rather than promised.
+//!
+//! Both of them are statements about the queue *at rest*, and the two moments where that is not the
+//! case are worth naming: a frame a `Block` producer is still waiting to hand over is offered and not
+//! yet decided, and a frame the writer has taken is written when it says so and not when it was
+//! handed over. Neither window can move an acknowledgement ahead of a write, which is the promise
+//! these counters exist to make checkable.
+//!
+//! What this file deliberately does not own: the bytes of a record
+//! ([`crate::engine::wal::segment`]), when an append waits for the device
+//! ([`crate::engine::wal::Policy`]) and what a write costs ([`crate::engine::flush`]). A frame
+//! reaches the write path through one call, and this file only decides when that call happens and
+//! what the daemon does when it cannot keep up.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use crate::error::Error;
+
+/// One unit of the queue: the payload of one frame.
+///
+/// The frame is the unit because it is the unit everywhere else in this project: the bytes the client
+/// sent and the daemon answers for (`lakelet/4.1-ingest-protocol`), and the bytes the write path
+/// writes as one record (`lakelet/4.5-batch-writes`). A frame carries one or more samples, and they
+/// share the frame's decision — a frame the queue drops is a frame whose samples were never written,
+/// because half a frame is not a batch this daemon writes.
+pub type Payload = Vec<u8>;
+
+/// What the fraction `Sample` keeps is worth: one arriving frame in four is taken in, and the rest
+/// are dropped.
+///
+/// A constant rather than a configuration key: the *decision* is what a deployment chooses — four
+/// policies with four different costs — and the rate at which one of them thins a stream is stated
+/// here, in one place, next to the policy that uses it. Turning it into a key is a one-line change
+/// the day a deployment needs two of them.
+pub const SAMPLE_KEEP: u64 = 4;
+
+/// The capacity a queue gets when no configuration layer names one, in frames.
+///
+/// A frame's payload is bounded by [`crate::protocol::frame::MAX_PAYLOAD`], so this number is the
+/// difference between a few hundred kibibytes of ordinary telemetry and a gigabyte of the largest
+/// frames the protocol allows — which is why `lakelet/4.6-ingest-backpressure` makes it a setting a
+/// deployment owns instead of a constant the code believes is right for everyone.
+pub const DEFAULT_CAPACITY: usize = 1024;
+
+/// The policy a queue gets when no configuration layer names one.
+///
+/// `Block`, because a default must not lose data: a deployment that would rather drop frames than
+/// make its producers wait is saying something about its workload, and it says it in
+/// `queue.policy`.
+pub const DEFAULT_POLICY: Policy = Policy::Block;
+
+/// What a queue does when a frame arrives and the bound is reached.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Policy {
+    /// Wait for room, then take the frame in. Nothing is ever dropped and the producer is what feels
+    /// the overload — the only policy under which `dropped` stays at zero.
+    Block,
+    /// Refuse the arriving frame. The producer is answered, and counted, instead of made to wait.
+    DropNewest,
+    /// Take the arriving frame in and drop the frame that has been waiting longest. Nothing is
+    /// refused, and the loss lands on data that arrived earlier.
+    DropOldest,
+    /// Take one arriving frame in [`SAMPLE_KEEP`] and refuse the rest, whether or not there is room.
+    /// What survives is a thinned stream rather than a complete one, and which frames survive depends
+    /// on the order they arrived in — which is the schedule's business.
+    Sample,
+}
+
+impl Policy {
+    /// The text form, as the configuration file writes it.
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Policy::Block => "block",
+            Policy::DropNewest => "drop-newest",
+            Policy::DropOldest => "drop-oldest",
+            Policy::Sample => "sample",
+        }
+    }
+
+    /// Read the text form.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] for anything but those four names, so a typo in a configuration file is
+    /// answered with a sentence listing what this build speaks, instead of a queue that silently
+    /// decides something nobody chose.
+    pub fn parse(text: &str) -> Result<Self, Error> {
+        match text {
+            "block" => Ok(Policy::Block),
+            "drop-newest" => Ok(Policy::DropNewest),
+            "drop-oldest" => Ok(Policy::DropOldest),
+            "sample" => Ok(Policy::Sample),
+            other => Err(Error::Invalid {
+                detail: format!(
+                    "`{other}` is not a queue policy: use `block`, `drop-newest`, `drop-oldest` or \
+                     `sample`"
+                ),
+            }),
+        }
+    }
+}
+
+/// What the queue has seen and done, counted.
+///
+/// Counters and never durations: the same numbers on a loaded machine as on an idle one, which is
+/// what makes them something a gate can compare (`handoff M2 §1.1`) and a page can state.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Stats {
+    /// Frames offered to the queue.
+    offered: u64,
+    /// Frames the queue took in and has not dropped again: what it owes a write for.
+    accepted: u64,
+    /// Frames the queue dropped: refusals, and frames a policy took back while they were queued.
+    dropped: u64,
+    /// Frames the write path wrote out of this queue.
+    written: u64,
+}
+
+impl Stats {
+    /// Frames offered to the queue, counted once each before any policy decided anything.
+    #[must_use]
+    pub fn offered(&self) -> u64 {
+        self.offered
+    }
+
+    /// Frames the queue took in and has not dropped again.
+    ///
+    /// The counter the conservation law is written with: `offered == accepted + dropped`, and at rest
+    /// `accepted == written + queued`. A frame an eviction took back leaves this counter again,
+    /// because the queue no longer owes a write for it.
+    #[must_use]
+    pub fn accepted(&self) -> u64 {
+        self.accepted
+    }
+
+    /// Frames the queue dropped.
+    #[must_use]
+    pub fn dropped(&self) -> u64 {
+        self.dropped
+    }
+
+    /// Frames the write path wrote.
+    #[must_use]
+    pub fn written(&self) -> u64 {
+        self.written
+    }
+}
+
+/// What a caller is told about the frames it offered.
+///
+/// A caller keeps one of these, hands a clone to every [`Queue::offer`], and reads it when it has to
+/// say what happened: at the end of a connection, at the end of a run. Only the queue moves the
+/// counters, because only the queue knows the two moments — a frame is `written` when the write path
+/// wrote it, and `dropped` when a policy refused it *or* took it back while it was still queued.
+///
+/// That is the promise `lakelet/4.1-ingest-protocol` made about an accepted frame, made checkable: a
+/// caller that offered `n` frames and reads its tally after [`Queue::settled`] finds
+/// `written + dropped == n`, so it cannot report a frame the queue dropped as one that was stored,
+/// whatever the policy did and whoever offered the frame.
+#[derive(Debug, Default)]
+pub struct Tally {
+    /// Frames offered through this tally that are on the file.
+    written: AtomicU64,
+    /// Frames offered through this tally that the queue dropped.
+    dropped: AtomicU64,
+    /// Payload bytes of the written frames.
+    bytes: AtomicU64,
+}
+
+impl Tally {
+    /// A tally with nothing on it.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Frames offered through this tally that the write path has written.
+    #[must_use]
+    pub fn written(&self) -> u64 {
+        self.written.load(Ordering::Relaxed)
+    }
+
+    /// Frames offered through this tally that the queue dropped.
+    ///
+    /// A refusal is visible at the [`Queue::offer`] that caused it; a frame the queue took in and an
+    /// eviction later took back is not, which is the whole reason this counter exists.
+    #[must_use]
+    pub fn dropped(&self) -> u64 {
+        self.dropped.load(Ordering::Relaxed)
+    }
+
+    /// Payload bytes of the frames offered through this tally that were written.
+    #[must_use]
+    pub fn bytes(&self) -> u64 {
+        self.bytes.load(Ordering::Relaxed)
+    }
+}
+
+/// What the queue did with one offered frame.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Decision {
+    /// The frame is the queue's now. The writer will write it unless a later decision takes it back
+    /// while it is still queued; the caller's [`Tally`] is charged when either happens.
+    Accepted,
+    /// The policy refused the frame, which comes back here: nothing was queued, nothing will be
+    /// written, and the caller's tally counts it as dropped.
+    Refused(Payload),
+    /// The frame was taken in, and `evicted` — a frame that was still queued, and that comes back
+    /// here — was dropped to make room for it. Which of the two was lost is the difference between
+    /// this and [`Decision::Refused`], and it is why this is not a boolean.
+    Evicted(Payload),
+}
+
+/// The bounded queue between accepting a frame and writing it.
+///
+/// One of these is the daemon's whole memory budget between the socket and the log: at most
+/// [`Queue::capacity`] frames are waiting at once, plus the one batch the writer has taken and not yet
+/// written, which is bounded by the same number.
+///
+/// **The state is yours.** This file declares no fields, because where the bound lives is the first
+/// decision of the step: the bound *is* the number of frames the queue is holding, and a second
+/// number that tracks the same thing — a counter beside the deque, a permit pool that is not the
+/// slots — is a second number that can disagree with it. A lock this queue takes is a lock it must
+/// not hold across an `await`: a producer parked on the bound must not be holding what the writer
+/// needs to free a slot.
+pub struct Queue {
+    // The state this step designs: the bound, the frames waiting, and whatever `Block` parks on.
+}
+
+impl Queue {
+    /// A queue that holds at most `capacity` frames and decides with `policy`.
+    ///
+    /// The two numbers are a deployment's (`service::config` reads them from the four layers, and the
+    /// step's page says which key each one comes from); this call is where they become a bound and a
+    /// decision.
+    ///
+    /// A capacity of zero is not a queue that refuses everything: the configuration layer turns it
+    /// into a refusal with a sentence naming the key, and this call is only reached with a capacity
+    /// of at least one.
+    #[must_use]
+    pub fn new(capacity: usize, policy: Policy) -> Arc<Self> {
+        let _ = (capacity, policy);
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// How many frames may be waiting at once.
+    #[must_use]
+    pub fn capacity(&self) -> usize {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// What this queue does when a frame arrives and nothing has room.
+    #[must_use]
+    pub fn policy(&self) -> Policy {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// How many frames are waiting for the writer right now.
+    #[must_use]
+    pub fn depth(&self) -> usize {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// The tally: what this queue has seen and what it did with it.
+    #[must_use]
+    pub fn stats(&self) -> Stats {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// Offer the frames one turn delivered, in order: the decision this step is about.
+    ///
+    /// The turn is the unit the accept loop hands over — what one read delivered, which is what
+    /// `lakelet/4.5-batch-writes` made the unit of a *write* — and every frame in it is decided, in
+    /// order, before the writer is told anything. A writer that woke in the middle of a turn would
+    /// write that turn as two batches, and the batch size would stop being a number anybody chose.
+    ///
+    /// What the [`Policy`] does with each frame:
+    ///
+    /// * [`Policy::Block`] waits for room and takes the frame in, so nothing is dropped and the
+    ///   producer is what feels the overload;
+    /// * [`Policy::DropNewest`] refuses the arrival when nothing has room;
+    /// * [`Policy::DropOldest`] always takes the arrival in, dropping the frame that has been waiting
+    ///   longest to make room for it — never one the write path already wrote, because the queue only
+    ///   holds frames nobody has written;
+    /// * [`Policy::Sample`] takes one arrival in [`SAMPLE_KEEP`] and refuses the rest, and makes room
+    ///   for a kept arrival the way `DropOldest` does.
+    ///
+    /// Answers one [`Decision`] per frame, in the order the frames were given. Every frame is counted
+    /// as offered here, whether the queue takes it, drops it, or makes this producer wait for room —
+    /// which is why a checkpoint taken while a producer is waiting sees `offered` ahead of
+    /// `accepted + dropped`: the frame is in neither column yet.
+    ///
+    /// The caller's [`Tally`] is charged exactly once for every frame, whatever happened to it — a
+    /// write later, or a drop now — so `offered == written + dropped` holds for the caller and not
+    /// only for the queue.
+    pub async fn offer(&self, frames: Vec<Payload>, tally: Arc<Tally>) -> Vec<Decision> {
+        let _ = (frames, tally);
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// The writer's side: the frames to write next, oldest first.
+    ///
+    /// Waits until there is something to write, and answers everything the queue holds *at that
+    /// moment* — so the size of one write is the queue's decision and not this loop's
+    /// (`lakelet/4.5-batch-writes`), and the queue's bound is what makes that number a deployment's
+    /// instead of whatever arrived in one turn.
+    ///
+    /// Answers `None` once the queue is closed *and* empty, which is what ends a writer's loop.
+    pub async fn take(&self) -> Option<Vec<Payload>> {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// The writer's side, after the write: `count` frames taken by [`Queue::take`] are on the file.
+    ///
+    /// Deliberately a separate call from [`Queue::take`]: a frame is written when the write path says
+    /// so, and a queue that moved this counter when it *handed the frames over* would be reporting an
+    /// intention as an outcome. It is also where the callers' [`Tally`] counters move, which is what
+    /// lets a caller say what it stored without reading the file.
+    pub fn wrote(&self, count: usize) {
+        let _ = count;
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// Wait until every frame offered so far has been written or dropped.
+    ///
+    /// Two things wait for this. A connection waits before it reports what it accepted, because a
+    /// frame it counted as accepted is one the client is allowed to believe is safe
+    /// (`lakelet/4.1-ingest-protocol`) and the write now happens somewhere else; and a stop path waits
+    /// after closing the queue, because a daemon that abandons what it accepted is the same lie one
+    /// level up.
+    ///
+    /// This says nothing about frames offered *after* the call started: a queue under a producer that
+    /// never stops is never settled, which is the truth about it. The condition is the counters
+    /// themselves — every frame offered has been resolved, so nothing is waiting and nothing is being
+    /// written.
+    pub async fn settled(&self) {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+
+    /// Stop taking frames in. What is already queued is still written.
+    ///
+    /// This is how a daemon stops accepting without losing what it accepted: every later
+    /// [`Queue::offer`] is refused (and counted as an arrival the queue did not take), and
+    /// [`Queue::take`] answers `None` once nothing is left.
+    pub fn close(&self) {
+        todo!("step lakelet/4.6-ingest-backpressure")
+    }
+}
