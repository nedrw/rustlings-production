+++ b/tests/soak.rs
@@ -0,0 +1,525 @@
+//! The long run `lakelet/4.17-soak` is judged by: the same cycle many thousand times, and the five
+//! counters that say what is still alive at the end of it.
+//!
+//! This file is **course content**, like `tests/budget.rs` and `tests/sim_compaction.rs`: the step
+//! ships it, `kiln run` keeps it, and the `soak` gate runs the command in
+//! `course/tracks/lakelet/soak/4.17-soak.toml` and reads the lines below. Nothing here is a
+//! judgement the project makes about itself.
+//!
+//! # One cycle
+//!
+//! A cycle is what a deployment does over and over, and it is four steps in the order the store
+//! does them:
+//!
+//! 1. **ingest** one batch of records through the protocol path — the frames a client would send,
+//!    built from this run's own workload and sent over a loopback connection to a real
+//!    [`ingest::serve`] in this process, so what the store holds is what the wire carried and the
+//!    service's own tasks are part of the run;
+//! 2. **flush** the batch into a segment, on a tick the run spawns through the service's ledger;
+//! 3. **expire** what the retention policy says is older than the window — without which the store
+//!    grows for ever and the counters would say so, which is a different claim than a leak;
+//! 4. **ask** one question about the span the cycle just wrote.
+//!
+//! # What the counters are, and why they are not minutes
+//!
+//! Every cycle ends with a [`Live`] report: `open_tasks` (tasks the service has spawned and not
+//! reaped), `open_handles` (files the store holds open), `store_files` and `store_bytes` (the files
+//! the store itself put under its directory, and what they cost), and `records` (what the store
+//! holds). They are counts of *state*, and the run's own totals — `cycles` and the cycles the store
+//! refused — are printed beside them by this file rather than by the store.
+//!
+//! A soak that judged minutes would be judged by the machine it ran on, and this course does not
+//! let a wall clock decide a `must` gate (handoff M2 §1.1): the same command on a loaded machine
+//! takes twice as long and reports the same numbers. So the wall clock is printed *beside* the
+//! counters, on a line the gate does not read, and the judgement is the **steady state rule**:
+//! one cycle is forgotten as the next is written, so a store that is working has the same counters
+//! at the halfway mark and at the end — and a counter that grew between them is a leak, named.
+//!
+//! # The long form
+//!
+//! `LAKELET_SOAK_CYCLES` decides how many cycles the counted run takes (the step's floor is the
+//! default), and `LAKELET_SOAK_MINUTES` is what a real soak is: the same cycle, stopped by the
+//! clock instead, printing the same shape. The gate never sets it — a wall clock is not a verdict —
+//! but a person reading `docs/soak.md` can run one.
+
+use std::net::SocketAddr;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use lakelet::engine::Spool;
+use lakelet::engine::compaction::Segments;
+use lakelet::engine::query::{exec, parse};
+use lakelet::engine::retention;
+use lakelet::engine::soak::Live;
+use lakelet::engine::wal::Policy as Durability;
+use lakelet::protocol::batch::{self, Record};
+use lakelet::protocol::frame::{self, Decoded, Frame};
+use lakelet::service::backpressure::{Policy as Overflow, Queue};
+use lakelet::service::ingest;
+use lakelet::service::soak::Task;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::Notify;
+
+/// The prefix every counted line carries: the track's id and the gate's name for this run.
+const PREFIX: &str = "lakelet-soak";
+
+/// How many cycles a run does when nothing says otherwise: the floor this step's soak file asks for.
+const DEFAULT_CYCLES: u64 = 4000;
+
+/// How many cycles pass between two transcript lines: a tenth of the counted run, so a reader sees
+/// the counters walk rather than only their last word.
+const REPORT_EVERY: u64 = 10;
+
+/// How many records one cycle ingests.
+const BATCH: usize = 64;
+
+/// How wide one cycle's window of time is, in milliseconds.
+const WINDOW_MILLIS: u64 = 60_000;
+
+/// The spacing between two records of one batch, so a cycle's span fits inside its window.
+const STEP_MILLIS: u64 = 937;
+
+/// How many windows of history the store keeps: the depth of the steady state, and the reason the
+/// counters below stop moving at all.
+const KEEP_WINDOWS: u64 = 6;
+
+/// The first timestamp a run writes: a bucket boundary of the retention policy, so a pass removes
+/// whole segments and never has to rewrite a straddler.
+const EPOCH: u64 = 1_700_000_040_000;
+
+/// The series every cycle writes: one metric, on one of eight hosts, with a value pattern that does
+/// not change from cycle to cycle.
+///
+/// Identical work per cycle is a decision, not a convenience: the segments a run writes are the
+/// same bytes at every offset, so `store_bytes` is a *stock* the run can compare with itself. A
+/// workload that varied would move that counter for reasons a leak does not have, and the bound the
+/// steady-state rule uses would have to be a guess.
+const METRIC: &str = "cpu";
+
+/// How many series the workload spreads over.
+const SERIES: usize = 8;
+
+/// How far a counter may move between the halfway mark and the end, by name.
+///
+/// Zero for four of the five: the store forgets one segment as it writes the next, so the files it
+/// keeps, their count, the records in them and the handles it holds are the same numbers at both
+/// ends of a working run. `store_bytes` is the exception, and it is a measured one rather than a
+/// guessed one: two segments hold the same records at two different times of day, and the
+/// varints that carry those timestamps are not always the same width, so a segment may come out a
+/// few bytes longer than its predecessor. The slack below is what a run of this length was measured
+/// to move, with room over it; a leak moves this counter by a segment, not by a byte.
+const BYTE_SLACK: u64 = 1024;
+
+/// How long a cycle waits for the daemon to finish with the connection it opened.
+///
+/// A bound, not a verdict: what ends the wait is the daemon's own end-of-file, and this is only
+/// there to turn a daemon that died into a sentence rather than a run that hangs until the gate's
+/// own timeout.
+const GRACE: Duration = Duration::from_secs(10);
+
+/// What one run of the loop is: the store it keeps, and the daemon in front of it.
+struct Soak {
+    /// The store directory, removed when the run ends.
+    directory: PathBuf,
+    /// The write path: where the daemon puts what it accepts.
+    spool: Arc<tokio::sync::Mutex<Spool>>,
+    /// The segments: what a flush closes, and what a question is asked of. A `std` lock because
+    /// every reader of it is synchronous — the tick holds it for the length of a call and never
+    /// across an `await`.
+    segments: Arc<Mutex<Segments>>,
+    /// The queue the daemon writes through, which is also where the run's task ledger lives.
+    queue: Arc<Queue>,
+    /// The retention rule: how much history this store keeps.
+    policy: retention::Policy,
+    /// The daemon's own task, joined when the run stops.
+    daemon: Option<Task<Result<(), lakelet::Error>>>,
+    /// What stops the daemon.
+    stop: Arc<Notify>,
+    /// Where it listens.
+    address: SocketAddr,
+    /// Cycles the store refused, which this run counts and the soak file bounds.
+    refused: u64,
+}
+
+impl Soak {
+    /// Open a store of this run's own and start a daemon in front of it.
+    async fn open(label: &str) -> Result<Self, String> {
+        let directory =
+            std::env::temp_dir().join(format!("lakelet-{label}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&directory);
+        std::fs::create_dir_all(&directory).map_err(describe)?;
+        // `Never` on purpose: this file is about what stays alive, not about what survives a power
+        // cut, and one device wait per batch would make the run's cost its durability policy's
+        // (`lakelet/4.3-write-path-adr` measured that cost, and it is four milliseconds).
+        let spool = Spool::with_policy(&directory, Durability::Never).map_err(describe)?;
+        let segments = Segments::open(&directory).map_err(describe)?;
+        // The bound is generous: this run must never make the daemon wait, and `Block` is what
+        // makes a frame the queue refused a different step's scenario.
+        let queue = Queue::new(256, Overflow::Block);
+        let listener = TcpListener::bind("127.0.0.1:0").await.map_err(describe)?;
+        let address = listener.local_addr().map_err(describe)?;
+        let stop = Arc::new(Notify::new());
+        let waiting = Arc::clone(&stop);
+        let store = Arc::new(tokio::sync::Mutex::new(spool));
+        // The daemon is a task of this run like every other one: spawned through the ledger the
+        // queue answers, so a run that forgot to stop it would see `open_tasks` stay where it was.
+        let daemon = queue.tasks().spawn({
+            let store = Arc::clone(&store);
+            let queue = Arc::clone(&queue);
+            async move {
+                ingest::serve(listener, store, queue, async move {
+                    waiting.notified().await;
+                })
+                .await
+            }
+        });
+        Ok(Self {
+            directory,
+            spool: store,
+            segments: Arc::new(Mutex::new(segments)),
+            queue,
+            // Six one-minute windows: a store that expires what is older than six cycles reaches a
+            // depth of six segments and stays there.
+            policy: retention::Policy::new(KEEP_WINDOWS * WINDOW_MILLIS, WINDOW_MILLIS),
+            daemon: Some(daemon),
+            stop,
+            address,
+            refused: 0,
+        })
+    }
+
+    /// One cycle: ingest, flush, expire, ask — and the report that follows it.
+    async fn cycle(&mut self, cycle: u64) -> Result<Live, String> {
+        let records = workload(cycle);
+        let wire = frames(&records)?;
+        self.send(&wire).await?;
+
+        // The flush and the expiry are one tick, and the tick is a task: this is what a deployment
+        // does on a timer, and the ledger counts it like everything else the service spawned.
+        let now = EPOCH.saturating_add(cycle.saturating_add(1).saturating_mul(WINDOW_MILLIS));
+        let tick = self.queue.tasks().spawn({
+            let segments = Arc::clone(&self.segments);
+            let policy = self.policy;
+            let carried = carried(&wire)?;
+            async move { close(&segments, policy, &carried, now) }
+        });
+        let closed = match tick.join().await {
+            Ok(closed) => closed?,
+            Err(error) => return Err(format!("the tick task did not finish: {error}")),
+        };
+        if closed != BATCH {
+            self.refused = self.refused.saturating_add(1);
+        }
+
+        // One question about the span this cycle wrote. A refusal here is not fatal to the run: it
+        // is counted, because a soak's job is to keep going and say what it saw.
+        if ask(&self.segments, &records).is_err() {
+            self.refused = self.refused.saturating_add(1);
+        }
+        self.live()
+    }
+
+    /// Send one cycle's frames, and wait until the daemon has written them.
+    ///
+    /// The wait is a **condition**, not a duration, and the protocol itself offers it: a connection
+    /// ends when its client is gone, and the daemon's connection ends only after the queue has
+    /// settled — so this client's own end-of-file is the write path's acknowledgment. A cycle that
+    /// closed its segment without waiting for it would race the connection task and close a batch
+    /// the daemon had not written yet, and the counters would move for the harness's reason.
+    async fn send(&self, wire: &[u8]) -> Result<(), String> {
+        let mut socket = TcpStream::connect(self.address).await.map_err(describe)?;
+        socket.write_all(wire).await.map_err(describe)?;
+        socket.flush().await.map_err(describe)?;
+        socket.shutdown().await.map_err(describe)?;
+        let mut end = [0u8; 1];
+        match tokio::time::timeout(GRACE, socket.read(&mut end)).await {
+            Ok(Ok(0)) => Ok(()),
+            Ok(Ok(read)) => Err(format!(
+                "the daemon answered the ingest connection with {read} byte(s): this protocol is \
+                 one-way, so a reply is a service somebody else changed"
+            )),
+            Ok(Err(error)) => Err(format!("the ingest connection failed: {error}")),
+            Err(_) => Err(format!(
+                "the daemon did not finish with this connection within {GRACE:?}"
+            )),
+        }
+    }
+
+    /// What is still alive right now.
+    fn live(&self) -> Result<Live, String> {
+        let manifest = self
+            .segments
+            .lock()
+            .map_err(|_| "the segment lock was poisoned".to_owned())?
+            .manifest()
+            .clone();
+        Ok(Live::of(
+            &self.directory,
+            &manifest,
+            self.queue.tasks().open(),
+        ))
+    }
+
+    /// What the log holds, which is every batch this run sent, once.
+    ///
+    /// The daemon's half of the cycle, checked at the end: a run whose store closed every batch and
+    /// whose log lost one would be a store with a hole in it that no counter on the segment side
+    /// could see.
+    async fn logged(&self) -> Result<u64, String> {
+        let spool = self.spool.lock().await;
+        Ok(spool.records().map_err(describe)?.len() as u64)
+    }
+
+    /// Stop the daemon, join it, and take the store directory away.
+    ///
+    /// The join is the point of the stop being a call at all: a run that signalled its daemon and
+    /// walked away would leave a task alive, and this file's own counters would be the ones saying
+    /// so — which is exactly the shape `docs/soak.md` describes.
+    async fn close(mut self) -> Result<(), String> {
+        self.stop.notify_one();
+        if let Some(daemon) = self.daemon.take() {
+            match daemon.join().await {
+                Ok(Ok(())) => {}
+                Ok(Err(error)) => return Err(format!("the daemon stopped badly: {error}")),
+                Err(error) => return Err(format!("the daemon's task did not finish: {error}")),
+            }
+        }
+        let _ = std::fs::remove_dir_all(&self.directory);
+        Ok(())
+    }
+}
+
+/// The run the gate judges: `LAKELET_SOAK_CYCLES` cycles, the five counters, and the steady state.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn the_counters_hold_their_place_over_a_long_run() {
+    let cycles = setting("LAKELET_SOAK_CYCLES").unwrap_or(DEFAULT_CYCLES);
+    let minutes = setting("LAKELET_SOAK_MINUTES");
+    let started = Instant::now();
+    let mut soak = Soak::open("soak")
+        .await
+        .unwrap_or_else(|error| panic!("{error}"));
+
+    let mut half: Option<Live> = None;
+    let mut end: Option<Live> = None;
+    let mut done = 0u64;
+    // Two ways to decide when the run is over, and only one of them is a clock. The counted run
+    // stops after `cycles`; the long form stops when the wall clock says so, and its halfway mark
+    // is half of that clock — a run stopped by time cannot have a cycle halfway mark, because how
+    // many cycles it gets is the machine's business.
+    let deadline = minutes.map(|minutes| Duration::from_secs(minutes.saturating_mul(60)));
+    let counted_run = deadline.is_none();
+    let counted_halfway = cycles / 2;
+    let timed_halfway = deadline.map(|long| long / 2);
+
+    loop {
+        if counted_run && done >= cycles {
+            break;
+        }
+        let marked =
+            timed_halfway.map_or(done >= counted_halfway, |half| started.elapsed() >= half);
+        let live = soak
+            .cycle(done)
+            .await
+            .unwrap_or_else(|error| panic!("cycle {done} of the soak did not finish: {error}"));
+        if done.is_multiple_of(REPORT_EVERY) {
+            println!("{}", counted(&live, None, None));
+        }
+        if marked && half.is_none() {
+            half = Some(live);
+        }
+        end = Some(live);
+        done = done.saturating_add(1);
+        if deadline.is_some_and(|long| started.elapsed() >= long) {
+            break;
+        }
+    }
+
+    let refused = soak.refused;
+    let logged = soak
+        .logged()
+        .await
+        .unwrap_or_else(|error| panic!("the log could not be read: {error}"));
+    soak.close().await.unwrap_or_else(|error| panic!("{error}"));
+
+    let end = end.unwrap_or_else(|| panic!("the soak ran no cycle at all"));
+    println!("{}", counted(&end, Some(done), Some(refused)));
+    assert_eq!(
+        logged, done,
+        "the log holds one frame per cycle and this run sent {done}: {logged} were readable, which \
+         is a write path that lost a batch the store's own counters cannot see"
+    );
+
+    let half = half.unwrap_or(end);
+    if let Some(moved) = moved(&half, &end) {
+        panic!(
+            "the soak does not reach a steady state: {moved}. A counter that moves between the \
+             halfway mark and the end is something the run opened and did not close — read \
+             docs/soak.md for what each one's growth means, and check what the cycle above leaves \
+             behind when it is done"
+        );
+    }
+    // Printed on a line the gate does not read: the wall clock is evidence, never a verdict.
+    println!(
+        "soak: {} cycle(s) in {:.1}s, {} refused, {} frame(s) in the log",
+        done,
+        started.elapsed().as_secs_f64(),
+        refused,
+        logged
+    );
+}
+
+/// One report as the gate reads it: **one metric per line**, in [`Live::NAMES`] order, and then
+/// the run's own totals when the run is over.
+///
+/// One metric per line is the shape every counter harness in this course prints (`tests/budget.rs`,
+/// `tests/attribution.rs`), and the gate parses it strictly: a line that starts with the prefix and
+/// is not `name=value` is a broken harness rather than a line to skip, so five counters on one line
+/// would read as one counter whose value is four more.
+fn counted(live: &Live, cycles: Option<u64>, refused: Option<u64>) -> String {
+    let mut text = String::new();
+    for name in Live::NAMES {
+        text.push_str(&format!(
+            "{PREFIX} {name}={}\n",
+            live.get(name).unwrap_or(0)
+        ));
+    }
+    if let Some(cycles) = cycles {
+        text.push_str(&format!("{PREFIX} cycles={cycles}\n"));
+    }
+    if let Some(refused) = refused {
+        text.push_str(&format!("{PREFIX} refused={refused}\n"));
+    }
+    text.trim_end().to_owned()
+}
+
+/// The sentence that names the counter which moved, or `None` when the two reports agree.
+///
+/// The rule, in one sentence: **a steady state is a store that has the same counters at the halfway
+/// mark and at the end**, because every cycle it writes is one the retention rule forgets. It is
+/// the whole judgement of this step, and it is why a leak is a red run with a name in it rather than
+/// a number somebody has to interpret.
+fn moved(half: &Live, end: &Live) -> Option<String> {
+    for name in Live::NAMES {
+        let (before, after) = (half.get(name), end.get(name));
+        let (Some(before), Some(after)) = (before, after) else {
+            return Some(format!("this report does not carry `{name}`"));
+        };
+        let slack = if name == "store_bytes" { BYTE_SLACK } else { 0 };
+        if after.abs_diff(before) > slack {
+            return Some(format!(
+                "`{name}` was {before} at the halfway mark and is {after} at the end, which is {} \
+                 more than the {slack} this step allows it",
+                after.abs_diff(before)
+            ));
+        }
+    }
+    None
+}
+
+/// One cycle's workload: the same records every cycle, moved on to the window this cycle writes.
+fn workload(cycle: u64) -> Vec<Record> {
+    let start = EPOCH.saturating_add(cycle.saturating_mul(WINDOW_MILLIS));
+    (0..BATCH)
+        .map(|index| {
+            let step = u64::try_from(index)
+                .unwrap_or(0)
+                .saturating_mul(STEP_MILLIS);
+            Record {
+                series: format!("{METRIC},host=h{}", index % SERIES),
+                ts_millis: i64::try_from(start.saturating_add(step)).unwrap_or(i64::MAX),
+                value: f64::from(u32::try_from(index % 17).unwrap_or(0)) / 4.0,
+            }
+        })
+        .collect()
+}
+
+/// The frames one cycle's records travel in: the wire's own bytes, which is what the store holds.
+fn frames(records: &[Record]) -> Result<Vec<u8>, String> {
+    Ok(Frame::new(batch::encode(records)).encode())
+}
+
+/// The records a cycle's frames carry, read back out of their own bytes.
+///
+/// Not the records the workload made: the store closes what the *protocol* carried, so a batch the
+/// codec would not read back is this run's refusal rather than a segment nobody can decode.
+fn carried(wire: &[u8]) -> Result<Vec<Record>, String> {
+    match frame::decode(wire) {
+        Decoded::Frame(frame, _) => batch::decode(&frame.payload).map_err(describe),
+        Decoded::Incomplete { needed } => Err(format!(
+            "the frame this cycle wrote needs {needed} more byte(s) to be read back, which is not a \
+             frame it wrote"
+        )),
+        Decoded::Invalid { reason } => Err(format!(
+            "the frame this cycle wrote cannot be read back: {reason}"
+        )),
+    }
+}
+
+/// The flush and the expiry, as one tick: close the batch into a segment, then forget what is old.
+///
+/// Synchronous on purpose: it is called from a task, but everything it does is a file operation and
+/// a manifest write, and a run that held the store's lock across an `await` would be a run whose
+/// counters moved because of the scheduler.
+fn close(
+    segments: &Mutex<Segments>,
+    policy: retention::Policy,
+    records: &[Record],
+    now: u64,
+) -> Result<usize, String> {
+    let mut segments = segments
+        .lock()
+        .map_err(|_| "the segment lock was poisoned".to_owned())?;
+    segments.seal(records).map_err(describe)?;
+    segments.expire(&policy, now).map_err(describe)?;
+    Ok(records.len())
+}
+
+/// One question about the span a cycle wrote, counted by the phases `lakelet/4.15` established.
+fn ask(segments: &Mutex<Segments>, records: &[Record]) -> Result<u64, String> {
+    let (from, to) = span(records);
+    let text = format!(
+        "SELECT count(value) FROM {METRIC} WHERE ts BETWEEN {from} AND {to} \
+         GROUP BY time({WINDOW_MILLIS}ms)"
+    );
+    let query = match parse::parse(&text) {
+        Ok(parse::Statement::Query(query) | parse::Statement::Explain(query)) => query,
+        Err(refusal) => return Err(format!("this run's own question was refused: {refusal}")),
+    };
+    let segments = segments
+        .lock()
+        .map_err(|_| "the segment lock was poisoned".to_owned())?;
+    let outcome = exec::execute(&segments.snapshot(), &query)
+        .map_err(|refusal| format!("the store refused the question: {refusal}"))?;
+    Ok(outcome.rows_answered())
+}
+
+/// The span one cycle's question covers: from the first timestamp it wrote to one step past the
+/// last, which is all of what the cycle sealed and none of what came before.
+fn span(records: &[Record]) -> (i64, i64) {
+    let mut first = i64::MAX;
+    let mut last = i64::MIN;
+    for record in records {
+        first = first.min(record.ts_millis);
+        last = last.max(record.ts_millis);
+    }
+    let step = i64::try_from(STEP_MILLIS).unwrap_or(i64::MAX);
+    (first, last.saturating_add(step))
+}
+
+/// One of the two environment variables this file reads, when it holds a number.
+fn setting(name: &str) -> Option<u64> {
+    match std::env::var(name) {
+        Ok(text) => match text.trim().parse() {
+            Ok(value) => Some(value),
+            Err(error) => panic!("`{name}` is set to `{text}`, which is not a number: {error}"),
+        },
+        Err(_) => None,
+    }
+}
+
+/// An I/O failure as a sentence a reader of the run can act on.
+fn describe(error: impl std::fmt::Display) -> String {
+    format!("the soak's store refused a call: {error}")
+}
