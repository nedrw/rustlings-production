index 0000000..3373b5f
--- /dev/null
+++ b/src/service/soak.rs
@@ -0,0 +1,146 @@
+//! The service's ledger of tasks: what it has spawned and not reaped.
+//!
+//! `lakelet/4.17-soak`. A soak asks what is still alive at the end of a long run, and the tasks a
+//! service owns are the half of that answer the store cannot give: a connection whose task nobody
+//! reaped, a writer that was spawned and forgotten, a tick per cycle whose handle went into a list
+//! that only grows. None of those shows up in a byte count, and all of them are what a process that
+//! has been up for nine days dies of, so the count is kept where the spawning happens.
+//!
+//! The ledger lives beside the **[`Queue`]** — [`Queue::tasks`] answers it — because the queue is
+//! the one object the whole ingest path shares: the connections that fill it and the writer that
+//! drains it are the tasks this deployment's service spawns, and a ledger of its own would be a
+//! second thing every caller has to thread through the daemon to reach them.
+//!
+//! What a task is counted as is decided here, and it is the decision this step is about: **a task
+//! is open from the moment this ledger spawns it until the handle that owns it is awaited or
+//! dropped.** Not "until it finishes" — that would make the count a race between a task's last
+//! instruction and the reader asking, and a soak whose counters depended on that would report two
+//! numbers for one run. The handle is the service's hold on the task, and a service that keeps a
+//! handle per cycle is a service that grows by one per cycle, which is exactly the leak a long run
+//! is for.
+//!
+//! # What is yours
+//!
+//! [`Tasks::spawn`] is the one place a service task becomes one, and the three pieces that make the
+//! count hold (`Tasks::release`, `Counted`'s drop, and a `Queue::new` that gives a queue a ledger
+//! of its own) are this step's work. The second half is in `src/service/ingest.rs`: the daemon's
+//! loop spawns through this ledger instead of calling `tokio::spawn` itself, so that the tasks the
+//! service owns are the tasks the service reports.
+
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use tokio::task::{JoinError, JoinHandle};
+
+use crate::service::backpressure::Queue;
+
+/// The tasks one service has spawned and not reaped.
+///
+/// Cheap to clone (it is an [`Arc`]) and shared with everything that spawns on the service's behalf,
+/// which is what makes one number out of the daemon's accept loop, its writer and the maintenance
+/// ticks the step's harness runs: they all spawn through the same ledger.
+#[derive(Debug, Default)]
+pub struct Tasks {
+    /// How many of them are not reaped yet.
+    open: AtomicU64,
+}
+
+impl Tasks {
+    /// An empty ledger.
+    #[must_use]
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self::default())
+    }
+
+    /// How many tasks this ledger has spawned and not reaped.
+    #[must_use]
+    pub fn open(&self) -> u64 {
+        self.open.load(Ordering::Relaxed)
+    }
+
+    /// Spawn `work`, and count it until the handle this answers is awaited or dropped.
+    ///
+    /// The one place a service task is spawned, so that "what is still alive" is answered by the
+    /// code that made it alive rather than by a reader walking a list of handles afterwards.
+    #[must_use]
+    pub fn spawn<F>(self: &Arc<Self>, work: F) -> Task<F::Output>
+    where
+        F: Future + Send + 'static,
+        F::Output: Send + 'static,
+    {
+        let _ = (work, Arc::clone(self));
+        todo!("a spawned task and the count it occupies")
+    }
+
+    /// Let one go: called by the count that owns a spawned task, once.
+    fn release(&self) {
+        todo!("one task fewer to answer for")
+    }
+}
+
+/// One task a ledger is counting, and the handle that owns it.
+///
+/// A `Task` is not an `Arc<Mutex<…>>` and does not need to be: what a caller does with it is either
+/// await it (`join`) or let it go, and both answer the same thing, which is that this service is no
+/// longer holding on to it. The count is released by [`Counted`] rather than by a `Drop` on `Task`
+/// itself, so that `join` can hand the handle to the executor while the count lives to the end of
+/// the call.
+#[derive(Debug)]
+pub struct Task<T> {
+    /// The task's handle: awaiting it is what a reap is.
+    handle: JoinHandle<T>,
+    /// The count this task occupies until this value goes.
+    counted: Counted,
+}
+
+impl<T> Task<T> {
+    /// Wait for the task, and answer what it did.
+    ///
+    /// # Errors
+    ///
+    /// [`JoinError`] when the task panicked or was cancelled: the two are the same answer to a
+    /// service that has to say whether its work finished, and the caller that needs to tell them
+    /// apart has [`JoinError::is_panic`].
+    pub async fn join(self) -> Result<T, JoinError> {
+        // The count is held until the await returns, and that is the whole meaning of the two
+        // values: the service owns the task for as long as it is waiting for it.
+        let counted = self.counted;
+        let joined = self.handle.await;
+        drop(counted);
+        joined
+    }
+
+    /// Whether the task has finished, without waiting for it.
+    ///
+    /// The other half of the ledger's question: `false` is a task this service is still holding on
+    /// to, which is a fact a caller can act on without parking.
+    #[must_use]
+    pub fn finished(&self) -> bool {
+        self.handle.is_finished()
+    }
+}
+
+/// The count one spawned task occupies, released when it goes.
+#[derive(Debug)]
+struct Counted(Arc<Tasks>);
+
+impl Drop for Counted {
+    fn drop(&mut self) {
+        // Dropping the owning handle is a reap, so this is where the count goes (`Tasks::release`
+        // is the half of it you write).
+        self.0.release();
+    }
+}
+
+impl Queue {
+    /// The ledger the tasks of this ingest path are counted in.
+    ///
+    /// One ledger per queue, created with it: two deployments in one process — a test that runs two
+    /// daemons, the soak harness beside the daemon it starts — do not share a count, exactly as two
+    /// stores do not (`crate::engine::soak`).
+    #[must_use]
+    pub fn tasks(&self) -> Arc<Tasks> {
+        todo!("the ledger this queue's tasks are counted in")
+    }
+}
