@@ -0,0 +1,302 @@
+//! What is still alive after a long run: the counters a soak is judged by.
+//!
+//! `lakelet/4.17-soak`. Every step of this phase before this one measures *work*: how many bytes a
+//! batch wrote, how many blocks a plan pruned, how much of a run each phase paid for. A count of
+//! work cannot answer the other question a long run asks — *what is still there?* — because work is
+//! a flow and the thing that goes wrong over ten thousand cycles is a stock: a file handle nobody
+//! dropped, a task nobody reaped, a store that grew a file per cycle and never gave one back.
+//!
+//! So this module is where the store's stocks are counted, and the shape is deliberately small:
+//!
+//! * [`Open`] counts the files **one store** holds open right now. A store is its directory — the
+//!   log at its root and the segments beside it are the same store — so the count is asked of the
+//!   directory and not of each half, and two stores never share one;
+//! * [`Live`] is the report a soak prints: `open_tasks`, `open_handles`, `store_files`,
+//!   `store_bytes` and `records`. The first belongs to the service — the tasks it has spawned and
+//!   not reaped — and the other four are this store's, answered from the directory and the
+//!   manifest. Which is why that one is *handed in* rather than asked for: the engine runs in a
+//!   test, in a repair tool and in a load generator, and none of those has a task scheduler.
+//!
+//! Nothing in this file may read a clock, and that is the step's whole argument: a soak is judged
+//! by what is alive at the end, so a machine that is twice as slow takes twice as long to say the
+//! same thing. A spec case reads this file for exactly that. `docs/soak.md` is the page that says
+//! what each counter's growth would mean.
+//!
+//! # What is yours
+//!
+//! The two types and their signatures are the contract this step's harness and spec are written
+//! against; the bodies are this step's work. The interesting one is [`Open::at`]: a count has to be
+//! a *store's* count and not the process's, or two deployments in one process would read each
+//! other's numbers — and it has to be reachable from the five places a file is opened in this
+//! store, which is why the store asks its **directory** for its counter rather than passing one
+//! down through every call site. The second half of the work is not in this file at all: every
+//! open in `src/engine` goes through [`Open`], so that a handle that is held past the call that
+//! opened it is a number this store reports.
+
+use std::fs::File;
+use std::io;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use crate::engine::compaction::{Manifest, Segments};
+use crate::engine::spool::Spool;
+
+/// The files one store currently holds open, shared by everything that opens one of them.
+#[derive(Debug, Default)]
+pub struct Open {
+    /// How many of its files the store has open right now.
+    open: AtomicU64,
+}
+
+impl Open {
+    /// The counter of the store rooted at `directory`.
+    ///
+    /// One counter per store directory, for as long as anybody holds it: the log and the segments
+    /// of one store are one store, and two stores are two. What that costs a process that opens
+    /// and closes a hundred stores is the implementer's decision, and the obvious one is that a
+    /// store that has been dropped leaves nothing behind — a counter that leaked entries itself
+    /// would be a poor instrument for finding a leak.
+    ///
+    /// # Panics
+    ///
+    /// Your implementation must not panic for any `directory` a caller can name.
+    #[must_use]
+    pub fn at(_directory: &Path) -> Arc<Self> {
+        todo!("the counter of one store directory")
+    }
+
+    /// The counter of the store that owns `file`.
+    ///
+    /// The store's own files live either at its root — the log and the manifest — or one directory
+    /// below it (`segments/`, `index/`), so a call that has a *file* and not a store still charges
+    /// the store it belongs to. That is the rule the counter is built on, one sentence long:
+    /// **every file this store opens is charged to the store that opened it.**
+    #[must_use]
+    pub fn of_file(_file: &Path) -> Arc<Self> {
+        todo!("the counter of the store a file belongs to")
+    }
+
+    /// How many of the store's files are open right now.
+    #[must_use]
+    pub fn get(&self) -> u64 {
+        self.open.load(Ordering::Relaxed)
+    }
+
+    /// Take a charged handle for `file`, for a caller that opened it its own way.
+    #[must_use]
+    pub fn hold(self: &Arc<Self>, file: File) -> Held {
+        Held::new(file, Arc::clone(self))
+    }
+
+    /// Open `path` for reading, counting it until the handle is dropped.
+    ///
+    /// # Errors
+    ///
+    /// [`io::Error`] when the file cannot be opened — the caller decides what a missing file means,
+    /// and this is the one place that decision is not made for it.
+    pub fn read_handle(self: &Arc<Self>, _path: &Path) -> io::Result<Held> {
+        todo!("a counted handle on a file opened for reading")
+    }
+
+    /// Open `path` for appending, creating it, counting the handle until it is dropped.
+    ///
+    /// # Errors
+    ///
+    /// [`io::Error`] when the file cannot be opened.
+    pub fn append(self: &Arc<Self>, _path: &Path) -> io::Result<Held> {
+        todo!("a counted handle on a file opened for appending")
+    }
+
+    /// Read a whole file, counting the handle while it is open.
+    ///
+    /// # Errors
+    ///
+    /// [`io::Error`] when the file cannot be opened or read.
+    pub fn read(self: &Arc<Self>, _path: &Path) -> io::Result<Vec<u8>> {
+        todo!("a whole-file read that is counted while it is open")
+    }
+
+    /// Write a whole file, counting the handle while it is open.
+    ///
+    /// # Errors
+    ///
+    /// [`io::Error`] when the file cannot be created or written.
+    pub fn write(self: &Arc<Self>, _path: &Path, _bytes: &[u8]) -> io::Result<()> {
+        todo!("a whole-file write that is counted while it is open")
+    }
+
+    /// Charge one more open handle to this store.
+    fn charge(&self) {
+        self.open.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// Let one go.
+    fn release(&self) {
+        self.open.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+/// One file a store has open: the handle, and the count it is charged to until it is dropped.
+///
+/// This is the type a leak is made of. A store that opens a file, keeps the value and never lets it
+/// go holds a descriptor for the life of the process, and the store says so from the moment it is
+/// opened rather than on the day the machine runs out of them.
+#[derive(Debug)]
+pub struct Held {
+    /// The file itself.
+    file: File,
+    /// The counter charged for it.
+    open: Arc<Open>,
+}
+
+impl Held {
+    /// Take a charged handle for `file`.
+    fn new(file: File, open: Arc<Open>) -> Self {
+        open.charge();
+        Self { file, open }
+    }
+
+    /// The file, for a caller that has to name it.
+    #[must_use]
+    pub fn file(&self) -> &File {
+        &self.file
+    }
+}
+
+impl std::ops::Deref for Held {
+    type Target = File;
+
+    fn deref(&self) -> &File {
+        &self.file
+    }
+}
+
+impl std::ops::DerefMut for Held {
+    fn deref_mut(&mut self) -> &mut File {
+        &mut self.file
+    }
+}
+
+impl Drop for Held {
+    fn drop(&mut self) {
+        self.open.release();
+    }
+}
+
+/// The five counters a soak prints, and the one value it judges.
+///
+/// Counts of *state*: every one of them is something that exists at the moment it is asked, and
+/// none of them is a duration, a rate or a total (the run's own totals — `cycles` and the refusals —
+/// belong to the harness that did the cycles, not to the store).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Live {
+    /// Tasks the service has spawned and not reaped.
+    open_tasks: u64,
+    /// Files the store holds open right now.
+    open_handles: u64,
+    /// Files under the store's directory that the store itself put there.
+    store_files: u64,
+    /// What those files cost together, in bytes.
+    store_bytes: u64,
+    /// Records the store holds, from the manifest alone.
+    records: u64,
+}
+
+impl Live {
+    /// The five counter names, in the order a soak prints them.
+    ///
+    /// The order is the harness's and this is where it comes from, so a transcript can be read
+    /// beside this list instead of against a second copy of it.
+    pub const NAMES: [&'static str; 5] = [
+        "open_tasks",
+        "open_handles",
+        "store_files",
+        "store_bytes",
+        "records",
+    ];
+
+    /// What is still alive in the store rooted at `directory`, and in the process that owns `tasks`.
+    ///
+    /// This is the one place a caller asks. The store half is answered from the directory and the
+    /// manifest — how many files the store names, how long they are together, and how many records
+    /// the manifest names — and the task half is handed in, because the tasks belong to the layer
+    /// above this one and this module may not reach into it.
+    ///
+    /// Who counts as *the store's* files is the decision worth making carefully: `store_files` is
+    /// the counter the steady state is read from, and it is the number a long run has to see stop
+    /// moving. The manifest is what a store *names* — read `lakelet/4.14-index-pruning` for what
+    /// stays on the disk after a segment expires — and the log at the directory's root is the write
+    /// path's, not this report's.
+    ///
+    /// # Panics
+    ///
+    /// Your implementation must not panic for a directory it can read.
+    #[must_use]
+    pub fn of(_directory: &Path, _manifest: &Manifest, _open_tasks: u64) -> Self {
+        todo!("the five counters of one store")
+    }
+
+    /// Tasks the service has spawned and not reaped.
+    #[must_use]
+    pub const fn open_tasks(&self) -> u64 {
+        self.open_tasks
+    }
+
+    /// Files the store holds open right now.
+    #[must_use]
+    pub const fn open_handles(&self) -> u64 {
+        self.open_handles
+    }
+
+    /// Files under the store's directory that the store itself put there.
+    #[must_use]
+    pub const fn store_files(&self) -> u64 {
+        self.store_files
+    }
+
+    /// What those files cost together, in bytes.
+    #[must_use]
+    pub const fn store_bytes(&self) -> u64 {
+        self.store_bytes
+    }
+
+    /// Records the store holds, from the manifest alone.
+    #[must_use]
+    pub const fn records(&self) -> u64 {
+        self.records
+    }
+
+    /// One counter by name, for a caller that walks [`Live::NAMES`].
+    ///
+    /// `None` for a name this report does not carry rather than a zero: a counter nobody charged
+    /// and a counter that was asked about by the wrong name are different facts, and a soak that
+    /// read the second as the first would pass while measuring nothing.
+    #[must_use]
+    pub fn get(&self, name: &str) -> Option<u64> {
+        match name {
+            "open_tasks" => Some(self.open_tasks),
+            "open_handles" => Some(self.open_handles),
+            "store_files" => Some(self.store_files),
+            "store_bytes" => Some(self.store_bytes),
+            "records" => Some(self.records),
+            _ => None,
+        }
+    }
+}
+
+impl Spool {
+    /// How many of this store's files the write path holds open right now.
+    #[must_use]
+    pub fn open_handles(&self) -> u64 {
+        Open::at(self.directory()).get()
+    }
+}
+
+impl Segments {
+    /// How many of this store's files the segment set holds open right now.
+    #[must_use]
+    pub fn open_handles(&self) -> u64 {
+        Open::at(self.directory()).get()
+    }
+}
