+    #[must_use]
+    pub const fn for_usage(model: &Model, usage: &Usage) -> Self {
+        let _ = (model, usage);
+        panic!("lakelet/4.20-capacity-model: the answer for a usage somebody states")
+    }
+
+    /// The answer as `name=value` lines, in a fixed order.
+    ///
+    /// Integers only, and the two groups are the two halves of the answer: what the store holds (bytes,
+    /// then the shares of those bytes) and what it costs (micro-units, then the shares of the bill). The
+    /// period every money line is for is [`DAYS_PER_MONTH`] days.
+    #[must_use]
+    pub fn lines(&self) -> Vec<String> {
+        todo!(
+            "lakelet/4.20-capacity-model: the answer as `name=value` lines, in a fixed order, \
+            integers only"
+        )
+    }
+
+    /// The same lines as one string, which is what a page carries and what a spec compares.
+    #[must_use]
+    pub fn text(&self) -> String {
+        todo!(
+            "lakelet/4.20-capacity-model: the same lines as one string, which is what a page carries"
+        )
