+/// The question a model is asked: a rate, a cardinality, a query rate, and a retention.
+///
+/// Four integers, and the three that are not the retention are the shape of the load rather than a
+/// measurement of it — which is the difference between this and an [`Estimate`]: an `Estimate` is an
+/// answer *about* a `Usage`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Usage {
+    /// Events ingested per day.
+    pub events_per_day: u64,
+    /// Distinct series those events are spread over.
+    pub series: u64,
+    /// Queries asked per day.
+    pub queries_per_day: u64,
+    /// Days of data kept, which [`Model::stored_bytes`] is the multiplier of.
+    pub retention_days: u64,
+}
