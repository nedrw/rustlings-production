+}
+
+impl fmt::Display for Estimate {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.text())
+    }
+}
+
+/// Three parts as whole per-mille of their total, with the largest carrying the rounding.
+///
+/// The three add up to exactly `1000` or the page's percentages would add up to 99, which is the shape
+/// `lakelet/4.15-budget-regression`'s phase shares have. The largest part answers for the rounding
+/// because it is the one whose figure is least sensitive to being one per-mille off. A total of zero —
+/// a usage with no events, no series and no queries — is three zero shares rather than a division.
+fn shares(parts: (u64, u64, u64)) -> (u64, u64, u64) {
+    let (first, second, third) = parts;
+    let whole = first.saturating_add(second).saturating_add(third);
+    if whole == 0 {
+        return (0, 0, 0);
+    }
+    let floored = (
+        first.saturating_mul(1000) / whole,
+        second.saturating_mul(1000) / whole,
+        third.saturating_mul(1000) / whole,
+    );
+    let rounding = 1000u64.saturating_sub(
+        floored
+            .0
+            .saturating_add(floored.1)
+            .saturating_add(floored.2),
+    );
+    if first >= second && first >= third {
+        (floored.0.saturating_add(rounding), floored.1, floored.2)
+    } else if second >= third {
+        (floored.0, floored.1.saturating_add(rounding), floored.2)
+    } else {
+        (floored.0, floored.1, floored.2.saturating_add(rounding))
+    }
+}
