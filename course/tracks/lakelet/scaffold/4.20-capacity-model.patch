+//! The capacity lane's harness for `lakelet/4.20-capacity-model`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.20-capacity-model
+//! --slow` runs, and the numbers it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.20-capacity-model.toml`.
+//!
+//! What it measures is **bytes and counts, never the clock**: a store is built through the real write
+//! path, the model in `src/engine/cost.rs` is asked what it thinks that store weighs, and the two are
+//! put side by side. A count is the same number on a loaded machine as on an idle one, which is why
+//! `kiln`'s budget gate compares counts (handoff M2 §1.1) and why no run of this file can flake because
+//! something else was compiling. `cargo test -p lakelet --test budget_cost -- --nocapture` prints the
+//! lines by hand; the `lakelet-budget` prefix is what the gate reads.
+//!
+//! # This lane is the step's judgement, and the only lane where a *model* is at stake
+//!
+//! Every other budget lane in this track pins the store: what the write path cost
+//! (`tests/budget.rs`), what a segment weighs (`tests/budget_segments.rs`), how much pruning saved
+//! (`tests/budget_pruning.rs`). This one pins the gap between **what the code says the store costs and
+//! what the store actually wrote**. That gap is the failure the step exists for: a constant in
+//! `Model::DEFAULT` that was measured once and never again keeps being quoted by
+//! `docs/capacity.md` long after the encoder under it changed, and a capacity plan built on it is wrong
+//! in a confident voice. So the model's constants and the store's own numbers are in one lane, and the
+//! `drift_*` lines are the comparison in per-mille — an integer ratio of two counts, which is the only
+//! kind of number this gate can judge.
+//!
+//! # The workload
+//!
+//! Deliberately the same store `lakelet/4.14-index-pruning` and `lakelet/4.15-budget-regression` build:
+//! **twenty-four sealed segments, one hour each, sixty records each** — thirty samples of
+//! `cpu,host=h{i}`, the segment's own host, and thirty of `cpu,host=fleet`, a series every segment
+//! carries. Nothing here reads a clock or a seeded generator: the epoch, the timestamps, the series and
+//! the values are arithmetic on constants, so two runs on two machines write the same bytes.
+//!
+//! Where this file differs from its siblings is that it also writes the **log**: every batch goes
+//! through `Spool::append` before `Segments::seal` closes it, because the log is part of what a store
+//! weighs (`lakelet/4.17-soak` counts the same bytes as `store_bytes`) and the write path never
+//! truncates it. A capacity model that counted only segments would miss the majority of the bytes this
+//! store holds, and the `log_bytes` line is where that is visible.
+//!
+//! # What each count is, and why the drift lines are ratios
+//!
+//! The first block is the store, measured on the disk rather than asked of the manifest: `segment_bytes`,
+//! `index_bytes`, `log_bytes` and their sum `on_disk_bytes`, with `records`, `series` and `series_slots`
+//! behind them. `series_slots` is the number of (segment, series) pairs — twenty-four segments holding
+//! two series each is forty-eight — and it is a different number from `series` whenever a series appears
+//! in more than one segment: it is what the sidecar's per-series share is divided by, so it is the number
+//! the model's `series_overhead_bytes` is measured against.
+//!
+//! The two `*_query_bytes` lines are the other half of the model: what a query read, from the plan's own
+//! decision. The **selective** query asks for `h20`, which the manifest and then the index prune to a
+//! single segment; the **wide** one asks for `fleet`, which every segment carries, so the index can rule
+//! none of the twelve segments the range meets out. That pair is `lakelet/4.14-index-pruning` as a
+//! *cost*: twelve segments read instead of one, and the model predicts each from the records the plan
+//! opened rather than from anything about the query.
+//!
+//! Then the model's own numbers (`model_*`, from `Model::predicts`) and the comparison
+//! (`drift_*_permille_max`, one per quantity, and `agreement_permille_max`, the tolerance the model
+//! itself states). Each drift is a ratio of two counts — what the model said over what the store wrote —
+//! so it is as steady as the counts are, and it is an **upper bound** in the baseline because the model's
+//! job is to be close, not to be equal: `zstd` is allowed to answer different bytes for the same block
+//! across releases (`budget/4.15-budget-regression.toml` bounds byte counts the same way).
+//!
+//! `within_max` is the verdict, as a count: zero when the model agreed with the store at the tolerance
+//! it states, one when it did not. It is here so that a run in which the model drifted is a red gate
+//! naming a number rather than a reader's arithmetic, and `refused_max` is here for the usual reason: a
+//! store that refused something is a store this lane cannot judge by counts alone.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file is
+//! the course's, and a harness a learner can break by editing their own fixture would judge the fixture
+//! instead of the store.
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+
+use lakelet::engine::compaction::{Segments, file_of};
+use lakelet::engine::cost::{Measured, Model, Reading};
+use lakelet::engine::index;
+use lakelet::engine::query::exec;
+use lakelet::engine::query::parse::{Statement, parse};
+use lakelet::engine::query::plan::Plan;
+use lakelet::engine::spool::Spool;
+use lakelet::protocol::batch::{self, Record};
+
+/// Segments the store is built from.
+const SEGMENTS: u64 = 24;
+
+/// Records one sealed segment holds: thirty of its own host and thirty of the fleet's.
+const PER_SERIES: usize = 30;
+
+/// Milliseconds between two samples of one series: two minutes, so one hour is thirty samples.
+const STEP: u64 = 120_000;
+
+/// One hour — the width of a segment, of a window, and of the arithmetic below.
+const HOUR: u64 = 3_600_000;
+
+/// The first timestamp of every segment, on an hour boundary.
+///
+/// `1_699_999_200_000` is `472_222 * HOUR` exactly, so a segment's span, the query's range and the
+/// grid its windows count on all start on numbers a reader can check by hand.
+const EPOCH: u64 = 472_222 * HOUR;
+
+/// The first hour the query asks about: half the store, so that the *manifest* prunes the other
+/// half.
+const FROM_HOUR: u64 = SEGMENTS / 2;
+
+/// The series every segment carries, so that a segment's vocabulary is never one term.
+const FLEET: &str = "fleet";
+
+/// The host the selective query asks for: the one series that appears in exactly one segment, and in
+/// the second half of the store.
+const SELECTIVE: u64 = 20;
+
+/// The records one sealed segment holds: its own host, then the fleet's, one series after the other.
+fn segment_records(segment: u64) -> Vec<Record> {
+    let start = EPOCH + segment * HOUR;
+    let mut records: Vec<Record> = (0..PER_SERIES)
+        .map(|offset| Record {
+            series: format!("cpu,host=h{segment}"),
+            ts_millis: (start + offset as u64 * STEP) as i64,
+            value: value_of(segment * PER_SERIES as u64 + offset as u64),
+        })
+        .collect();
+    records.extend((0..PER_SERIES).map(|offset| Record {
+        series: format!("cpu,host={FLEET}"),
+        ts_millis: (start + offset as u64 * STEP) as i64,
+        value: value_of(segment * PER_SERIES as u64 + offset as u64),
+    }));
+    records
+}
+
+/// The value of sample `position`: distinct bit patterns, and no structure a column can exploit.
+///
+/// The bytes a segment costs are half of what this lane compares, and a store of values a compressor
+/// likes would make the comparison an argument about `zstd` rather than about the model.
+fn value_of(position: u64) -> f64 {
+    let mixed = position.wrapping_mul(2_654_435_761) % 100_003;
+    mixed as f64 / 8.0
+}
+
+/// One query of this run, spelled over the last half of the store.
+fn text(series: &str) -> String {
+    format!(
+        "SELECT count(value) FROM cpu WHERE host = '{series}' AND ts BETWEEN {} AND {} \
+         GROUP BY time(1h), series",
+        EPOCH + FROM_HOUR * HOUR,
+        EPOCH + SEGMENTS * HOUR
+    )
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "lakelet-budget-cost-{label}-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the store lives.
+    fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// How many bytes a file costs on the disk, or zero when it is not there.
+    ///
+    /// The disk's own answer and not the manifest's: what a segment *weighs* is what a backup copies
+    /// and an operator pays for (`lakelet/4.19-backup-restore` reads the same numbers), and a file
+    /// shorter than the manifest says it is would be caught here first.
+    fn bytes_of(&self, path: &Path) -> u64 {
+        std::fs::metadata(path)
+            .map(|metadata| metadata.len())
+            .unwrap_or(0)
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+/// What the run measured, before the model is asked anything.
+struct Counted {
+    /// Segments the store was built from.
+    segments: u64,
+    /// Records those segments hold.
+    records: u64,
+    /// Distinct series the store holds.
+    series: u64,
+    /// (segment, series) pairs the sidecars were written for.
+    series_slots: u64,
+    /// Bytes the segment files cost together.
+    segment_bytes: u64,
+    /// Bytes the sidecar index files cost together.
+    index_bytes: u64,
+    /// Bytes the log costs.
+    log_bytes: u64,
+    /// What the two queries read, selective first.
+    queries: Vec<Reading>,
+    /// Something the store refused, counted rather than raised.
+    refused: u64,
+}
+
+/// Build the store, ask both queries, and count what came out of the disk.
+///
+/// Failures are counted rather than raised for the reason `tests/budget_pruning.rs` counts its own:
+/// this file's numbers are what a gate compares, and a harness that panicked would report nothing at
+/// all instead of the count that moved. A build that failed leaves zeros behind, and a model compared
+/// with zeros drifts past every bound — so a store that could not be built is a red lane that says so
+/// rather than a blocked gate that says the course is unfinished.
+fn measure(directory: &Dir) -> Counted {
+    let mut counted = Counted {
+        segments: 0,
+        records: 0,
+        series: 0,
+        series_slots: 0,
+        segment_bytes: 0,
+        index_bytes: 0,
+        log_bytes: 0,
+        queries: Vec::new(),
+        refused: 0,
+    };
+    let mut vocabulary: BTreeSet<String> = BTreeSet::new();
+    let mut store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    let mut spool = match Spool::open(directory.path()) {
+        Ok(spool) => spool,
+        Err(error) => {
+            eprintln!("the log could not be opened: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    for segment in 0..SEGMENTS {
+        let records = segment_records(segment);
+        // The write path, in the order a deployment uses it: the payload goes to the log first, and
+        // the flush closes the same records into a segment.
+        if let Err(error) = spool.append(&batch::encode(&records)) {
+            eprintln!("segment {segment} could not be appended: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+        if let Err(error) = store.seal(&records) {
+            eprintln!("segment {segment} could not be sealed: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+        counted.segments += 1;
+        counted.records += records.len() as u64;
+        // The vocabulary of this segment, which is what its sidecar was written for: from the records
+        // this file made rather than from the store, because what a *series* costs the index is a
+        // division by how many series share a segment and only the writer knows that.
+        let local: BTreeSet<String> = records.iter().map(|record| record.series.clone()).collect();
+        counted.series_slots += local.len() as u64;
+        vocabulary.extend(local);
+        counted.segment_bytes += directory.bytes_of(&file_of(directory.path(), segment));
+        counted.index_bytes += directory.bytes_of(&index::file_of(directory.path(), segment));
+    }
+    counted.series = vocabulary.len() as u64;
+    counted.log_bytes = directory.bytes_of(&spool.path());
+
+    let snapshot = store.snapshot();
+    for (quantity, series) in [
+        ("selective_query_bytes", format!("h{SELECTIVE}")),
+        ("wide_query_bytes", FLEET.to_owned()),
+    ] {
+        let query = match parse(&text(&series)) {
+            Ok(Statement::Query(query)) | Ok(Statement::Explain(query)) => query,
+            Err(refusal) => {
+                eprintln!("the {quantity} query was refused by the grammar: {refusal}");
+                counted.refused += 1;
+                return counted;
+            }
+        };
+        let plan = match Plan::of(&snapshot, &query) {
+            Ok(plan) => plan,
+            Err(refusal) => {
+                eprintln!("the {quantity} query was refused by the store: {refusal}");
+                counted.refused += 1;
+                return counted;
+            }
+        };
+        // What the plan decided to read, which is the number a capacity model prices: the segments it
+        // opens and the bytes they state. The executor is asked as well, and the two have to agree —
+        // a plan whose stated sizes were not what the reader paid would make this lane's query numbers
+        // a fiction.
+        let opened_records: u64 = plan
+            .opened()
+            .iter()
+            .fold(0u64, |total, info| total.saturating_add(info.records));
+        let opened_bytes: u64 = plan
+            .opened()
+            .iter()
+            .fold(0u64, |total, info| total.saturating_add(info.bytes));
+        let outcome = match exec::execute(&snapshot, &query) {
+            Ok(outcome) => outcome,
+            Err(refusal) => {
+                eprintln!("the {quantity} query could not run: {refusal}");
+                counted.refused += 1;
+                return counted;
+            }
+        };
+        if outcome.bytes_read() != opened_bytes || outcome.rows_scanned() != opened_records {
+            eprintln!(
+                "{quantity}: the plan stated {opened_bytes} bytes over {opened_records} records and \
+                 the run read {} over {}",
+                outcome.bytes_read(),
+                outcome.rows_scanned()
+            );
+            counted.refused += 1;
+        }
+        counted.queries.push(Reading {
+            quantity,
+            records: opened_records,
+            bytes: opened_bytes,
+        });
+    }
+    counted
+}
+
+#[test]
+fn the_capacity_lane() {
+    let directory = Dir::new("budget");
+    let counted = measure(&directory);
+
+    // The store, measured on the disk: what the three file sets weigh together, and the three counts
+    // behind them. Nothing below can mean anything about a store that has nothing in it.
+    metric("segments", counted.segments);
+    metric("records", counted.records);
+    metric("series", counted.series);
+    metric("series_slots", counted.series_slots);
+    metric("segment_bytes", counted.segment_bytes);
+    metric("index_bytes", counted.index_bytes);
+    metric("log_bytes", counted.log_bytes);
+    metric(
+        "on_disk_bytes",
+        counted
+            .segment_bytes
+            .saturating_add(counted.index_bytes)
+            .saturating_add(counted.log_bytes),
+    );
+
+    // The three rates the model carries, measured the way the model's own documentation says each one
+    // was: bytes per thousand records in the segments, per thousand (segment, series) pairs in the
+    // sidecars, and per thousand records in the log. Per-mille integers, never floats.
+    metric(
+        "bytes_per_sample_milli",
+        counted.segment_bytes.saturating_mul(1000) / counted.records.max(1),
+    );
+    metric(
+        "series_overhead_bytes_milli",
+        counted.index_bytes.saturating_mul(1000) / counted.series_slots.max(1),
+    );
+    metric(
+        "log_bytes_per_sample_milli",
+        counted.log_bytes.saturating_mul(1000) / counted.records.max(1),
+    );
+
+    // What each query read: the records the plan opened and the bytes those segments state. The pair of
+    // them is `lakelet/4.14-index-pruning` as a cost — a query the index cannot help reads twelve times
+    // the records — and it is what the model's query term is compared against.
+    for reading in &counted.queries {
+        metric(reading.quantity, reading.bytes);
+        metric(
+            &format!("{}_records", reading.quantity.trim_end_matches("_bytes")),
+            reading.records,
+        );
+    }
+
+    // The model, and the comparison. One `Measured` built from the counts above, one `agrees` call, and
+    // every line below is a number the model or the comparison produced — no line of this file is
+    // written by hand.
+    let measured = Measured {
+        segments: counted.segments,
+        records: counted.records,
+        series: counted.series,
+        series_slots: counted.series_slots,
+        segment_bytes: counted.segment_bytes,
+        index_bytes: counted.index_bytes,
+        log_bytes: counted.log_bytes,
+        queries: counted.queries.clone(),
+    };
+    let model = Model::DEFAULT;
+    let predicted = model.predicts(&measured);
+    metric("model_segment_bytes", predicted.segment_bytes);
+    metric("model_index_bytes", predicted.index_bytes);
+    metric("model_log_bytes", predicted.log_bytes);
+    metric("model_on_disk_bytes", predicted.on_disk_bytes);
+    metric(
+        "model_bytes_per_sample_milli",
+        predicted.bytes_per_sample_milli,
+    );
+    // The model's own constants, as counts: what the page quotes, in the lane that judges it.
+    metric("model_bytes_per_sample", model.bytes_per_sample);
+    metric("model_series_overhead_bytes", model.series_overhead_bytes);
+    metric("model_log_bytes_per_sample", model.log_bytes_per_sample);
+    metric("model_bytes_per_query", model.bytes_per_query);
+    for reading in &measured.queries {
+        metric(
+            &format!("model_{}", reading.quantity),
+            model.query_bytes(reading),
+        );
+    }
+
+    let agreement = model.agrees(&measured);
+    for drift in &agreement.drifts {
+        // An upper bound, and named after the *quantity* that was compared rather than the constant
+        // behind it: a constant has more than one use, and which use moved is what a reader needs.
+        metric(
+            &format!("drift_{}_permille_max", drift.quantity),
+            drift.permille,
+        );
+    }
+    metric("agreement_permille_max", agreement.tolerance_permille);
+    metric("within_max", u64::from(!agreement.within));
+
+    // A store that refused something is a store this lane cannot judge by counts alone.
+    metric("refused_max", counted.refused);
+}
