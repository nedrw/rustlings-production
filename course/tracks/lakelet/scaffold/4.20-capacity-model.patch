+    pub series: u64,
+    /// (segment, series) pairs the sidecars were written for: what the per-series overhead is divided
+    /// by, and a different number from [`Measured::series`] whenever a series appears in more than one
+    /// segment.
+    pub series_slots: u64,
+    /// Bytes the segment files cost together, measured on the disk.
+    pub segment_bytes: u64,
+    /// Bytes the sidecar index files cost together, measured on the disk.
+    pub index_bytes: u64,
+    /// Bytes the log costs, measured on the disk.
+    pub log_bytes: u64,
