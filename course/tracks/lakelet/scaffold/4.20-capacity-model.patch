+    /// the size at which every term is visible.
+    pub const EVENTS_PER_DAY: u64 = 1_000_000;
+
+    /// Series [`Usage::DEFAULT`] spreads those events over: a thousand, which is a fleet of machines
+    /// reporting a handful of metrics each rather than a per-request label.
+    pub const SERIES: u64 = 1_000;
+
+    /// Queries a day in [`Usage::DEFAULT`]: ten thousand, which is a dashboard refreshing every few
+    /// seconds plus the questions a person asks by hand.
+    pub const QUERIES_PER_DAY: u64 = 10_000;
+
+    /// The usage this step's page answers: a million events a day, a thousand series, ten thousand
+    /// queries, and the model's own retention policy.
+    pub const DEFAULT: Usage = Model::DEFAULT.default_usage();
+}
