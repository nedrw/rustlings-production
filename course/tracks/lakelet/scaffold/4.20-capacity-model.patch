+//! What a store this shape costs to run, and whether the model still matches the store.
+//!
+//! Step `lakelet/4.20-capacity-model`. Everything before this step *measures*: `lakelet/4.5-batch-writes`
+//! counts what the write path spent, `lakelet/4.7-columnar-segments` pins the bytes a segment holds,
+//! `lakelet/4.14-index-pruning` turns pruning into a rate, `lakelet/4.15-budget-regression` attributes
+//! work to the phase that paid for it. A capacity question — *what does a million events a day cost* —
+//! is answered before the load arrives, from numbers somebody wrote down, and that is a different kind
+//! of artifact: a **model**. A model is not a measurement, and the whole difficulty is that the two
+//! drift apart quietly: a constant that was true when it was written keeps being used after the encoder
+//! under it changed, and the page that quotes it goes on being wrong in a confident voice.
+//!
+//! So this module is arithmetic over values and nothing else, and it is built so that the drift is a
+//! *failing case* rather than a stale sentence:
+//!
+//! * [`Model`] is the model: named, unit-carrying integers, every one of which came from a measurement
+//!   of this store or from a named list price ([`Model::DEFAULT`] says which, field by field);
+//! * [`Usage`] is the question as a value (a million events a day, a thousand series, ten thousand
+//!   queries, thirty days of retention), and the model's methods answer it in bytes first and money
+//!   second: per sample, per series, per day, per retention period, and finally the three shares of the
+//!   bill and the identity `total == ingest + storage + query` — written as arithmetic a case can
+//!   falsify, not as a sentence on a page;
+//! * [`Measured`] is what a store actually wrote (segments, sidecars, log, records, series, and what
+//!   each query read), and [`Model::agrees`] compares the model with it. That comparison is the reason
+//!   this is a *design* capability rather than a page: `tests/budget_cost.rs` prints both sides, the
+//!   course baseline in `budget/4.20-capacity-model.toml` bounds the difference, and a constant that
+//!   stopped matching the store turns that lane red with the quantity that moved.
+//!
+//! # The money path has no floating point in it
+//!
+//! Every amount is an integer number of **micro-units** of the currency the list prices are quoted in
+//! (a millionth of a dollar for [`Model::DEFAULT`]'s prices, which [`docs/capacity.md`] names with the
+//! date and the source). A cost that depends on how a machine rounds a `f64` is a cost two machines
+//! disagree about, and the lane that judges this step compares counts: `0.1 + 0.2` is not `0.3`, and a
+//! bill that is off by a micro-unit because of it is a bill nobody can reconcile. Shares are per-mille
+//! integers for the same reason.
+//!
+//! The month is a named constant ([`DAYS_PER_MONTH`]) and not a number written into three formulas,
+//! and a year is [`MONTHS_PER_YEAR`] of those months rather than 365 days: the two are not the same
+//! number after the first division, and a report that answered differently depending on which one it
+//! had been asked for would be a report nobody could add up.
+//!
+//! # What this module does not do
+//!
+//! **It reads nothing.** No file, no directory, no clock, no environment variable: it is arithmetic
+//! over values a caller hands it. That is what makes it a model, and it is the line
+//! `lakelet/4.20-capacity-model` exists to draw — measuring the store is the harness's job
+//! (`tests/budget_cost.rs`, which builds a store through the real write path and hands the numbers
+//! in). The step's spec reads this file for the rule, because "a model is not a measurement" stops
+//! being a slogan the moment it is a property of the code.
+//!
+//! It also does not model three things, and the page says so: a query's *latency* (the model prices
+//! bytes read, and a plan's cost in time is what `lakelet/4.15-budget-regression` and
+//! `lakelet/4.16-profiling` are for), the *merge* traffic of `lakelet/4.8-compaction` (a merge rewrites
+//! bytes this model never counts, and `budget/4.8-compaction.toml` is where that cost is measured),
+//! and the store's own manifest (one entry per segment, which a version of this model with a segment
+//! count in it would price).
+
+use std::fmt;
+
+/// Micro-units in one unit of the currency the prices are quoted in.
+///
+/// `Model::DEFAULT`'s prices are dollars, so this is a millionth of a dollar. The prices are stored in
+/// micro-units because a per-event price is a fraction of a cent and an integer cent would round the
+/// whole month to zero.
+pub const MICROS: u64 = 1_000_000;
+
+/// Bytes in one gibibyte, the unit the storage price is quoted per.
+///
+/// 2^30 and not 10^9, because that is the number the vendor's own worked example divides by
+/// (`docs/capacity.md` quotes it), and because the two differ by 7.4% — which is more than the
+/// tolerance this model allows itself, so guessing which one a price means is guessing in the one place
+/// the model has no measurement to check against.
+pub const GIB: u64 = 1 << 30;
+
+/// Days in the month every price here is quoted per.
+///
+/// Named rather than written into three formulas, and thirty rather than a calendar month: a price list
+/// says "per month" and every bill a reader of this page has seen treats that as thirty days. A model
+/// that asked the calendar would answer differently in February, which is not a property a capacity
+/// plan wants.
+pub const DAYS_PER_MONTH: u64 = 30;
+
+/// Months in the year [`Model::yearly_micros`] reports.
+///
+/// A year is exactly this many months, each of them rounded once, rather than 365 days rounded once: the
+/// two arithmetic paths disagree by up to eleven micro-units on the same store, and a model that
+/// reported two different prices for the same year depending on how it was asked would be a model an
+/// invoice could not be reconciled against. See [`Model::yearly_micros`].
+pub const MONTHS_PER_YEAR: u64 = 12;
+
+/// The model of what this store costs, as named integers.
+///
+/// Nine numbers, and each of them is one of three kinds, which the field's own documentation states:
+///
+/// * **measured** on this store — the three byte rates ([`Model::bytes_per_sample`],
+///   [`Model::series_overhead_bytes`], [`Model::log_bytes_per_sample`]) and the bytes one query reads
+///   ([`Model::bytes_per_query`]). `tests/budget_cost.rs` builds a store through the real write path and
+///   prints its own version of each, so a measured number here that stopped matching the store fails
+///   the step's budget lane rather than ageing quietly;
+/// * **policy** — [`Model::retention_days`], which is a decision rather than a measurement, and the one
+///   multiplier a person chooses;
+/// * **a list price** with a date and a source, written down on `docs/capacity.md` — the three `price_*`
+///   fields. This is the one input the model does not measure, and it is why the price fields are
+///   documented as prices rather than as facts about this store.
+///
+/// The fields are public because a model is a value two readers compare: a spec that wants to know what
+/// a 20% error in one constant costs writes `Model { bytes_per_sample: …, ..Model::DEFAULT }` and asks.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Model {
+    /// Bytes one record costs in a **sealed segment** on this store.
+    ///
+    /// Measured, not derived: `lakelet/4.7-columnar-segments` encodes a segment by column and hands the
+    /// block to `zstd`, so the number depends on the encoding *and* on the compressor's release. It is
+    /// the store's own answer on `tests/budget_cost.rs`'s workload (twenty-four sealed segments of sixty
+    /// records, 4094 bytes per thousand records), rounded down to a whole byte because a fractional byte
+    /// per record is not a number a store writes.
+    pub bytes_per_sample: u64,
+    /// Bytes one series costs the sidecar index, per segment it appears in.
+    ///
+    /// Measured the way `lakelet/4.14-index-pruning` writes it: one index file per closed segment, and
+    /// the file is a fixed size — a header, a 33-byte zone map and a 1024-bit filter — whatever its
+    /// segment holds, so what a *series* costs is that file divided by the series sharing the segment
+    /// (176 bytes over the reference store's two, which is 88). The division is where this model is
+    /// least exact, and the page says so: a store that seals a thousand series into one segment pays 176
+    /// bytes for all of them where this constant would charge 88 000.
+    pub series_overhead_bytes: u64,
+    /// Bytes one record costs in the **log**, before any flush closes it.
+    ///
+    /// Measured on the same workload. The log holds what the client sent — `protocol::batch::encode`'s
+    /// payload, framed by `lakelet/4.4-wal-recovery`'s record — so this is not the same shape of number
+    /// as `bytes_per_sample`: it is the raw bytes of a series *name* and two numbers per record, which
+    /// is why it is larger than the compressed segment's share. It is one measurement rather than a
+    /// function of the name's length, which the page names as a limit.
+    pub log_bytes_per_sample: u64,
+    /// Bytes one query reads, for the query this model prices.
+    ///
+    /// The reference query is `lakelet/4.14-index-pruning`'s: one host over one hour, which the index
+    /// prunes down to a single segment and sixty records — `bytes_per_sample` times the sixty. A query
+    /// that cannot prune reads twelve times this, and `tests/budget_cost.rs` prints both readings, so
+    /// the number here is a *floor* rather than an average: the page's query term is the cheapest a
+    /// question can be on this store.
+    pub bytes_per_query: u64,
+    /// Days of data the deployment's policy keeps, which is the default [`Usage`] runs at.
+    ///
+    /// A decision and not a measurement: `lakelet/4.9-retention` deletes whole segments older than this,
+    /// and this model multiplies bytes-per-day by it. Zero is *not* an empty store — see
+    /// [`Model::stored_bytes`] — because a store that is running has a day's data on the disk before
+    /// anything expires, and a model that priced a running store at nothing would answer "keep nothing"
+    /// for every deployment that had not got round to setting the policy.
+    pub retention_days: u64,
+    /// Micro-units one gibibyte-month of storage costs, on the price list the page names.
+    ///
+    /// The one kind of input this model does not measure. `docs/capacity.md` writes down the vendor, the
+    /// region, the unit the vendor's own arithmetic divides by, and the date the list was read.
+    pub price_per_gib_month_micros: u64,
+    /// Micro-units one **million events** ingested costs, on the same list.
+    ///
+    /// A metered ingest price, which is what makes a capacity question answerable before the load
+    /// arrives: it is charged per event rather than per byte or per hour, so it scales with the same
+    /// number [`Usage::events_per_day`] states.
+    pub price_per_million_events_micros: u64,
+    /// Micro-units one gibibyte **read back** costs, on the same list.
+    ///
+    /// What makes `lakelet/4.14-index-pruning` a cost rather than a rate: a query that opens one segment
+    /// instead of twelve reads a twelfth of the bytes, and this is the price those bytes carry. Latency
+    /// is not in here — this is bytes, not seconds.
+    pub price_per_gib_read_micros: u64,
+    /// How far the model may be from a measurement and still be called agreed, in per-mille.
+    ///
+    /// The model states its own tolerance, because "the model is close enough" is a decision somebody has
+    /// to make and defend. A hundred per-mille is ten percent: wide enough to hold the compressor's slack
+    /// (`lakelet/4.15-budget-regression` bounds byte counts the same way) and narrow enough that a
+    /// constant that stopped matching the store — the failure this step is about — is outside it.
+    pub agreement_permille: u64,
+}
+
+impl Model {
+    /// The model this project ships.
+    ///
+    /// Every measured number came out of `tests/budget_cost.rs`'s workload, every price out of the list
+    /// `docs/capacity.md` names with its date, and the retention out of the policy
+    /// `lakelet/4.9-retention` ships. The constants are what the page argues term by term; the harness
+    /// re-measures them on the same store, and the budget lane is red when they stop matching.
+    pub const DEFAULT: Model = Model {
+        bytes_per_sample: 4,
+        series_overhead_bytes: 88,
+        log_bytes_per_sample: 31,
+        bytes_per_query: 240,
+        retention_days: 30,
+        price_per_gib_month_micros: 23_000,
+        price_per_million_events_micros: 14_000,
+        price_per_gib_read_micros: 21_000,
+        agreement_permille: 100,
+    };
+
+    /// The question this model's own page asks: a million events a day, at the retention the deployment
+    /// ships and a cardinality and a query rate that go with it.
+    ///
+    /// The model answers a `Usage` and not a bare event rate, so "what does a million events a day cost"
+    /// is only a question once three other numbers are stated — how many series those events are spread
+    /// over, how many questions are asked of them, and how long they are kept. [`Usage::DEFAULT`] is the
+    /// set this page uses, and this method is where the retention comes from, so the policy in
+    /// [`Model::retention_days`] is a number the model actually answers with rather than one a reader has
+    /// to remember to pass.
+    #[must_use]
+    pub const fn default_usage(&self) -> Usage {
+        Usage {
+            events_per_day: Usage::EVENTS_PER_DAY,
+            series: Usage::SERIES,
+            queries_per_day: Usage::QUERIES_PER_DAY,
+            retention_days: self.retention_days,
+        }
+    }
+
+    /// Bytes a day's records cost once they are sealed into segments.
+    ///
+    /// Linear in the event rate by construction: `events × bytes_per_sample`, two integers multiplied,
+    /// which is the property a capacity model is *for* — doubling the load doubles the answer, exactly,
+    /// with no curve to fit.
+    #[must_use]
+    pub const fn sample_bytes_per_day(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: what a day's records cost once they are sealed: the event \
+            rate times `bytes_per_sample`"
+        )
+    }
+
+    /// Bytes a day's series cost the index sidecar.
+    ///
+    /// One segment's share per series per day, which is the model's least exact term and the direction it
+    /// errs in: the sidecar is one file per segment, so a store that seals many series into a segment
+    /// pays this once for all of them. See [`Model::series_overhead_bytes`] and `docs/capacity.md`.
+    #[must_use]
+    pub const fn series_bytes_per_day(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: what a day's series cost the sidecar: the series count \
+            times `series_overhead_bytes`"
+        )
+    }
+
+    /// Bytes a day's records cost in the log, which nothing truncates.
+    ///
+    /// The log is the half of the store that `lakelet/4.8-compaction` does not change and
+    /// `lakelet/4.9-retention` does not expire: every payload this store accepted is still in it, which
+    /// is why a capacity model that counted only segments would under-price a store by everything its
+    /// write path has taken (`lakelet/4.17-soak` counts the same bytes as `store_bytes`).
+    #[must_use]
+    pub const fn log_bytes_per_day(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: what a day's records cost in the log: the event rate times \
+            `log_bytes_per_sample`"
+        )
+    }
+
+    /// Bytes one day of this usage costs on the disk: samples, series overhead, and the log.
+    ///
+    /// The three terms are separate methods as well as one sum, because a page has to argue each of them
+    /// and a case can check that this is exactly their sum rather than approximately it.
+    #[must_use]
+    pub const fn bytes_per_day(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: a day is its three terms added, and this is the method a \
+            case checks that against"
+        )
+    }
+
+    /// Bytes the disk holds at steady state: one day times the retention.
+    ///
+    /// Retention is **the** multiplier in this model, the only one a person chooses, and it is applied to
+    /// everything a day writes rather than to the segments alone: a store that keeps thirty days keeps
+    /// thirty days of log too.
+    ///
+    /// A retention of zero days answers *what one day holds* and not nothing. The alternatives are both
+    /// wrong on a running store: an empty store is a store that is not ingesting, and a division by the
+    /// number of days is not arithmetic this model needs at all. The floor is applied here rather than
+    /// stored into the usage, so a caller reading [`Usage::retention_days`] back gets the number they
+    /// wrote.
+    #[must_use]
+    pub const fn stored_bytes(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: the retention is the multiplier — and zero days is what one \
+            day holds, not nothing"
+        )
+    }
+
+    /// Bytes a day's queries read, at the reference query's size.
+    ///
+    /// The one term that *falls* when the store does more work: `lakelet/4.14-index-pruning` is what keeps
+    /// this small, and the number is the pruned reading — see [`Model::bytes_per_query`].
+    #[must_use]
+    pub const fn query_bytes_per_day(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!("lakelet/4.20-capacity-model: a day's questions at `bytes_per_query` each")
+    }
+
+    /// The samples' share of a day's bytes, in whole per-mille.
+    #[must_use]
+    pub fn sample_share_permille(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        todo!(
+            "lakelet/4.20-capacity-model: the samples' share of a day's bytes, in whole per-mille of \
+            the three terms"
+        )
+    }
+
+    /// The series overhead's share of a day's bytes, in whole per-mille.
+    ///
+    /// The number a page names when it says what cardinality costs: it is the only term of the three that
+    /// a person changes by *modelling their metrics better* rather than by writing less data or changing
+    /// a policy.
+    #[must_use]
+    pub fn series_share_permille(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        todo!(
+            "lakelet/4.20-capacity-model: the series overhead's share of a day's bytes, in whole \
+            per-mille of the three terms"
+        )
+    }
+
+    /// The log's share of a day's bytes, in whole per-mille.
+    #[must_use]
+    pub fn log_share_permille(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        todo!(
+            "lakelet/4.20-capacity-model: the log's share of a day's bytes, in whole per-mille of the \
+            three terms"
+        )
+    }
+
+    /// What a month of ingesting this usage costs, in micro-units.
+    #[must_use]
+    pub const fn ingest_micros(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: a month of events at the ingest price, in micro-units and \
+            in integers"
+        )
+    }
+
+    /// What a month of holding this usage's bytes costs, in micro-units.
+    ///
+    /// Steady state, which is the only state a capacity question is about: the store holds
+    /// [`Model::stored_bytes`] all month, and one gibibyte-month is that many bytes held for a month.
+    #[must_use]
+    pub const fn storage_micros(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: a month of holding `stored_bytes` at the storage price"
+        )
+    }
+
+    /// What a month of asking questions costs, in micro-units.
+    #[must_use]
+    pub const fn query_micros(&self, usage: &Usage) -> u64 {
+        let _ = usage;
+        panic!(
+            "lakelet/4.20-capacity-model: a month of reading what the queries read, at the read price"
+        )
+    }
+
+    /// The month's bill: the three terms added, which is the identity the page's block is built on.
+    ///
+    /// Written as one expression over the three methods rather than as a fourth formula, so that
+    /// `total == ingest + storage + query` is arithmetic rather than a claim — a case checks it across a
+    /// matrix of usages, and a version of this method that priced something the three terms do not would
+    /// be red immediately.
+    #[must_use]
+    pub const fn monthly_micros(&self, usage: &Usage) -> u64 {
+        let _ = usage;
