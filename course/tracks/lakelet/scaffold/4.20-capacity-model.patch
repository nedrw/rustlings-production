+/// One quantity the model answered, and how far its answer is from the store's.
+///
+/// The two names are both needed and they are not the same name: `constant` is what the model's answer
+/// came out of — the thing that has to stop matching the store for this to be red — and `quantity` is
+/// what was compared, which is how a reader knows *which* of a constant's uses moved. A constant that
+/// drifts moves every quantity it answers for, and the step's drill is exactly that: change one number in
+/// [`Model::DEFAULT`] by twenty percent and watch which lines go red.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Drift {
+    /// The model constant the answer came out of.
+    pub constant: &'static str,
+    /// The quantity that was compared.
+    pub quantity: &'static str,
+    /// What the model says.
+    pub model: u64,
+    /// What the store wrote.
+    pub measured: u64,
+    /// How far apart the two are, in whole per-mille of what the store wrote.
+    pub permille: u64,
+    /// Which way.
+    pub direction: Direction,
+}
+
+impl fmt::Display for Drift {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            formatter,
+            "{}: {} is {} against the store's {} — {}‰ {}",
+            self.constant, self.quantity, self.model, self.measured, self.permille, self.direction
+        )
+    }
+}
+
+/// The verdict of comparing a model with a store, and the tolerance it was judged at.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Agreement {
+    /// Every quantity compared, in a fixed order: the store's three file sets, their sum, then one per
+    /// query the run asked.
+    pub drifts: Vec<Drift>,
+    /// How far apart the model and the store may be, in per-mille — the model's own
+    /// [`Model::agreement_permille`], carried here so a report can state the rule it applied.
+    pub tolerance_permille: u64,
+    /// `true` when every drift is inside the tolerance.
+    pub within: bool,
+}
+
+impl fmt::Display for Agreement {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        // A report lists what failed when something failed, and everything when nothing did: a reader of a
+        // green line wants the numbers, and a reader of a red one wants the two or three that moved rather
+        // than the whole list.
+        let listed: Vec<&Drift> = if self.within {
+            self.drifts.iter().collect()
+        } else {
+            self.drifts
+                .iter()
+                .filter(|drift| drift.permille > self.tolerance_permille)
+                .collect()
+        };
+        let said: Vec<String> = listed.iter().map(|drift| drift.to_string()).collect();
+        if self.within {
+            write!(
+                formatter,
+                "the model agrees with the store within {}‰: {}",
+                self.tolerance_permille,
+                said.join("; ")
+            )
+        } else {
+            write!(
+                formatter,
+                "the model has drifted from the store (more than {}‰): {}",
+                self.tolerance_permille,
+                said.join("; ")
+            )
+        }
+    }
+}
