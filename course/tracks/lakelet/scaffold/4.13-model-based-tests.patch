--- /dev/null
+++ b/src/engine/rng.rs
@@ -0,0 +1,153 @@
+//! The store's own seeded generator: one number in, one reproducible sequence out.
+//!
+//! Step `lakelet/4.13-model-based-tests`. A walk is only evidence if somebody else can run it
+//! again, and the only thing that makes that true is that everything the walk decides comes out of
+//! one number. So the generator lives in the engine rather than in a test: a walk, a soak, a fuzz
+//! corpus and `lakelet-load` all want "the same seed is the same run", and a test-side copy would
+//! be a fourth sequence nobody can reproduce.
+//!
+//! # Why not `rand`
+//!
+//! `rand` is a good crate and a bad fit for this lesson. It is a *tree* of crates with a version
+//! history of its own, its default generator is explicitly allowed to change between releases, and
+//! the one thing a walk needs from it — the same numbers on every machine, for ever — is the one
+//! thing its own documentation declines to promise (`StdRng` is documented as *not* reproducible
+//! across releases). This course has been here before (`jobq/3.19-property-invariants`): a walk
+//! needs arithmetic somebody can read in one screen, and forty lines of integer arithmetic that
+//! cannot change under a dependency bump is worth more than a dependency that can.
+//!
+//! # What it is
+//!
+//! A xorshift64\*: the state is one `u64`, [`Rng::next_u64`] mixes it with itself in three shifts
+//! and multiplies it, and that product is the number. It is not a cryptographic generator and does
+//! not pretend to be: the whole of what this build asks of it is an index into a list of six
+//! operations and a number a clock moves by, and it is chosen because its stream is a *published*
+//! one — a walk's finding is worth exactly as much as the fact that the same seed reproduces it.
+//!
+//! Two contracts, and every walk in this course depends on both:
+//!
+//! * **the same seed is the same sequence.** Not "similar": identical, on every machine, in every
+//!   process, in every build, because nothing here reads a clock, a thread id, an address or a hash
+//!   seed. `lakelet/4.13-model-based-tests`' spec pins a golden vector of the first outputs for one
+//!   seed, so that a refactor which quietly changed the stream fails a case rather than moving every
+//!   walk in the project;
+//! * **a different seed is a different sequence.** `slow:sim@N` runs a step's own scenarios once per
+//!   seed and refuses transcripts that are all identical — a harness that ignored the seed would
+//!   otherwise pass three times on one schedule. That judgement is only about the *generator* if
+//!   the generator is what the seed reaches, which is why the seed goes nowhere else.
+
+/// The multiplier of xorshift64\*: Vigna's constant.
+///
+/// It is what makes this a generator rather than a linear map over GF(2). The three shifts alone
+/// are linear, so the low bits of the state move in step with each other and a generator whose
+/// answer *is* the state is one whose low bits repeat long before its high ones do. Multiplying the
+/// mixed state by an odd constant is what fixes that: odd, so the map is invertible and no bit of
+/// the state falls out of the answer, and wide, so every bit of the answer depends on all 64 bits
+/// of it.
+const MULTIPLIER: u64 = 0x2545_f491_4f6c_dd1d;
+
+/// What a zero seed becomes.
+///
+/// Zero is a **legal** seed — a harness that refused it would be a harness that cannot walk the
+/// first thing somebody types — and it is the one state xorshift cannot leave: all three shifts of
+/// zero are zero, and the stream would be a constant. So the state is nudged off zero here, once,
+/// at construction, where the correction is visible; nothing else in this file special-cases it.
+/// The number is the fractional part of the golden ratio in hex, which is the usual choice for
+/// "spread one value over a 64-bit state".
+const AWAY_FROM_ZERO: u64 = 0x9e37_79b9_7f4a_7c15;
+
+/// A generator: one seed in, one reproducible sequence of numbers out.
+///
+/// The whole of its state is one `u64`, which is what makes two generators built from one seed the
+/// same generator: there is no buffer, no index into a table and no entropy the constructor could
+/// have taken from the machine.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Rng {
+    /// The state, always non-zero ([`AWAY_FROM_ZERO`] is what a zero seed becomes).
+    state: u64,
+}
+
+impl Rng {
+    /// A generator that starts from `seed`.
+    ///
+    /// A zero seed is a seed like any other and does not produce a constant stream; see
+    /// [`AWAY_FROM_ZERO`].
+    #[must_use]
+    pub const fn new(seed: u64) -> Self {
+        todo!()
+    }
+
+    /// The next 64 bits: the state moves on, and the answer is the state mixed with itself.
+    ///
+    /// The three shifts are the whole generator. They are written as `^=` in place because that is
+    /// what they are — each one folds a differently-scaled copy of the state into it — and the
+    /// multiply at the end is the star.
+    pub fn next_u64(&mut self) -> u64 {
+        todo!(
+            "lakelet/4.13-model-based-tests: `MULTIPLIER` is the star, and the three shifts are \
+               the whole of the state update"
+        )
+    }
+
+    /// A number in `0..bound`, and `0` when there is nothing to draw from.
+    ///
+    /// `0` rather than a panic, because "draw from an empty alphabet" has one sane answer and a
+    /// generator that panicked on it would fail inside somebody else's process: a walk that asks
+    /// for `below(0)` has asked for an index into a list of nothing, and the answer a caller can
+    /// act on is the first one. Nothing is drawn for it: an alphabet with no letters in it has no
+    /// letter to hand out, and the stream does not move.
+    ///
+    /// A remainder is not perfectly uniform when `bound` does not divide 2^64 — for an alphabet of
+    /// six operations the bias is about one part in 3e18 — and that is the trade this generator
+    /// makes on purpose: a walk is a search for a counter-example, not a sample for a statistic.
+    /// `jobq/3.19-property-invariants` made the same trade for the same reason.
+    pub fn below(&mut self, bound: u64) -> u64 {
+        todo!("lakelet/4.13-model-based-tests: in range, total, and the same answer for one seed")
+    }
+
+    /// A number in `low..=high`: **both ends are included**.
+    ///
+    /// A clock, a duration and a record's timestamp are all "somewhere in this span, and either end
+    /// of it is a legal instant", so a half-open range would make the last millisecond of every
+    /// span unreachable — and "the boundary is never drawn" is exactly the kind of blind spot a
+    /// walk is written to find in *other* code. `between(a, a)` is `a`.
+    ///
+    /// A `high` at or below `low` answers `low`: a span that names nothing has one number a caller
+    /// can use, and answering with an instant outside the interval the caller named would be a
+    /// worse answer than the boundary they typed. **Nothing is drawn for it** — a span with no
+    /// range in it has no element to hand out, and the stream does not move — which is
+    /// [`Rng::below`]'s rule about an empty alphabet one level up.
+    pub fn between(&mut self, low: i64, high: i64) -> i64 {
+        todo!(
+            "lakelet/4.13-model-based-tests: both ends included, and a span that names nothing \
+               answers `low`"
+        )
+    }
+
+    /// One of `items`, drawn uniformly.
+    ///
+    /// # Panics
+    ///
+    /// Panics when `items` is empty. Unlike [`Rng::below`], there is no value to answer with: the
+    /// caller asked for *an element*, and the only alternatives to a panic are an invented element
+    /// or `Option` at every call site. Every walk in this project draws from an alphabet it wrote
+    /// down, so a panic here is a bug in the harness rather than a state a run can reach.
+    #[must_use]
+    pub fn pick<'a, T>(&mut self, items: &'a [T]) -> &'a T {
+        todo!("lakelet/4.13-model-based-tests: one of the alphabet the caller handed you")
+    }
+
+    /// `true` about `percent` times in a hundred.
+    ///
+    /// `0` is never and `100` is always, and **above `100` is always** rather than a refusal: this
+    /// is a probability written as a whole number, not a validated setting, and a walk that asked
+    /// for `chance(150)` has said "very much yes" — the answer a caller can act on is the one that
+    /// does not need them to read a manual.
+    #[must_use]
+    pub fn chance(&mut self, percent: u64) -> bool {
+        todo!(
+            "lakelet/4.13-model-based-tests: `percent` times in a hundred, and 0 and 100 mean \
+               what they say"
+        )
+    }
+}
