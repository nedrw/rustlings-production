--- /dev/null
+++ b/tests/sim_model.rs
@@ -0,0 +1,123 @@
+//! The walk `lakelet/4.13-model-based-tests` is judged by: a seeded sequence of operations against
+//! a real store, compared with the learner's model after every one of them.
+//!
+//! Course content — the step's scaffold ships it, `slow:sim@N` runs it once per seed with
+//! `KILN_SIM_SEED` set, and the gate compares the `lakelet-sim` lines below in the order they were
+//! printed. Three things are therefore strict:
+//!
+//! * **the seed decides the walk.** Which operation comes next, which series it is of, how many
+//!   records it carries, which way the clock steps and which question is asked all come out of
+//!   [`KILN_SIM_SEED`](SEED) through the store's own generator (`src/engine/rng.rs`), so the same
+//!   seed walks the same path on every machine and a `replay` of it is byte-identical. What the
+//!   seed does *not* decide is whether the walk agrees with the model — that is the store's
+//!   answer, and a run where it is "no" is the finding this harness exists to produce;
+//! * **the model is compared after every operation, not at the end.** A walk that compared the
+//!   final state would report "64 operations and the answers differ"; comparing after each one
+//!   names the operation that changed the answer, which is the difference between a failing run
+//!   and something somebody can act on;
+//! * **a failure is shrunk before it is reported.** The sequence in the log is the shortest one
+//!   that still disagrees — see `tests/support/walk.rs` — because "op 57 disagreed" without it is
+//!   a finding nobody can debug, and the seed that produced it is printed beside it.
+//!
+//! # Why the seed is not in a transcript that agreed
+//!
+//! `slow:sim@N` demands that at least two seeds produce *different* transcripts — three identical
+//! ones would mean the harness never read the seed, so one run would have been reported three
+//! times. A transcript that printed its own seed would satisfy that demand without walking
+//! anything, which is why no line of an agreeing walk carries it. The failing path is the
+//! exception: [`shrink`](walk::shrink)'s report names the seed, because a reader of a red log
+//! needs the run it came from.
+//!
+//! # What the transcript holds
+//!
+//! One line per operation — `op=<n> kind=… appended n=… log=…`, and the store's own account of a
+//! flush, a merge, an expiry or a reopen — and, after every one of them, the pair the whole step
+//! is about: `op=<n> model=<digest> store=<digest>`. A digest covers the floor and every record,
+//! compared by bits, so a lost record, a reordered series and a floor that moved the wrong way are
+//! all visible. Nothing here prints a path, an address, a wall clock or an unmasked float.
+
+mod support;
+
+use support::walk::{self, Dir, Op};
+
+/// The seed this run uses when the judge does not name one.
+///
+/// Seed `1` is also what `sim/4.13-model-based-tests.toml` marks as `replay`, so a learner running
+/// this file by hand sees the walk the gate replays.
+const DEFAULT_SEED: u64 = 1;
+
+/// The variable `slow:sim@N` sets: which walk this run takes.
+const SEED: &str = "KILN_SIM_SEED";
+
+/// The variable an author uses to walk a longer or shorter sequence than [`walk::OPS`].
+///
+/// Not read by any gate: it is here so that a person looking for a failing walk can widen it
+/// without editing a course file, and the walk it produces is the same kind of walk.
+const OPS: &str = "KILN_SIM_OPS";
+
+/// The seed this process was asked for.
+fn seed() -> u64 {
+    match std::env::var(SEED) {
+        Ok(text) => text
+            .parse()
+            .unwrap_or_else(|error| panic!("{SEED}=`{text}` is not a number: {error}")),
+        Err(_) => DEFAULT_SEED,
+    }
+}
+
+/// How many operations this run walks.
+fn length() -> usize {
+    match std::env::var(OPS) {
+        Ok(text) => text
+            .parse()
+            .unwrap_or_else(|error| panic!("{OPS}=`{text}` is not a number: {error}")),
+        Err(_) => walk::OPS,
+    }
+}
+
+/// Walk once, print the transcript, and fail with the shrunk sequence when the answers differ.
+///
+/// A panic rather than an exit code, because this is the step's `run.cmd`: `cargo test` is what the
+/// judge runs, and the panicking sentence is what it quotes. The transcript is printed line by line
+/// as it is built, so a run that dies halfway still leaves what it observed.
+#[test]
+fn a_walk_agrees_with_the_model_after_every_operation() {
+    let seed = seed();
+    let ops = walk::plan(seed, length());
+    let dir = Dir::new("model-walk");
+    let report = walk::run(&ops, dir.path());
+    for line in &report.lines {
+        println!("{line}");
+    }
+    let Some(mismatch) = report.mismatch else {
+        println!("{} result=agreed ops={}", walk::PREFIX, report.played);
+        return;
+    };
+
+    // The finding: the sequence without the operations the failure does not need. The same seed,
+    // the same starting state, and every candidate replayed on the disk the walk itself uses.
+    let minimal: Vec<Op> =
+        walk::shrink(&ops, |candidate| !walk::run(candidate, dir.path()).agreed());
+    println!(
+        "{} result=disagreed ops={} seed={seed} shrunk_to={}",
+        walk::PREFIX,
+        report.played,
+        minimal.len()
+    );
+    for (index, op) in minimal.iter().enumerate() {
+        println!(
+            "{} shrink op={} {}",
+            walk::PREFIX,
+            index + 1,
+            walk::describe(op)
+        );
+    }
+    panic!(
+        "the store and the model disagreed after {} of {} operation(s), and the smallest sequence \
+         that still disagrees has {} of them — a store must answer what it was told, minus what \
+         its floor forgot, however it kept it: {mismatch}",
+        report.played,
+        ops.len(),
+        minimal.len()
+    );
+}
