index 0000000..093d941
--- /dev/null
+++ b/tests/sim_wal.rs
@@ -0,0 +1,700 @@
+//! The crash schedule `lakelet/4.4-wal-recovery` is judged by: writers, a flusher, and four ways
+//! for a store to die.
+//!
+//! Course content — the step's scaffold ships it, `slow:sim@N` runs it once per seed with
+//! `KILN_SIM_SEED` set, and the gate compares the `lakelet-sim` lines below in the order they were
+//! printed. Two things are therefore strict:
+//!
+//! * **the transcript is the schedule.** Every line is an event the *scenario* observed, and the seed
+//!   decides the order they happen in (`turmoil::Builder::rng_seed`, plus `enable_random_order` so
+//!   that the nodes are stepped in a random order too). Nothing here prints a wall clock, a path, an
+//!   address or the iteration order of a map: the one time that appears is
+//!   `tokio::time::Instant::now() - started`, a **simulated** duration. Formatting an `Instant`
+//!   itself would put the machine's real monotonic base into the transcript, which is how one seed
+//!   starts producing two different runs;
+//! * **the invariant is asserted here, not by the gate.** The gate can only see whether a run passed.
+//!   The claim this step makes — recovery proves exactly the bytes the store promised, and a store
+//!   continues after them — is checked inside the scenario, and a schedule that breaks it fails the
+//!   run with the sentence that says which one.
+//!
+//! # The four deaths, and what each one models
+//!
+//! A store is a `Spool` — the real write path, writing real files — plus this harness's memory of
+//! what it acknowledged. Only the `Spool` is dropped by a death, so the notebook that judges it
+//! outlives the store, the way a test's notes outlive the process they are about.
+//!
+//! * **process death** (`crash process`): the `Spool` is dropped and the file is left exactly as the
+//!   process left it. The kernel outlived the process, so the page cache is intact and *nothing
+//!   written is lost*, whatever the policy is. That claim is what this model exists to test, and it
+//!   is the one an fsync decision cannot take away (`docs/crash-points.md`, point 1);
+//! * **machine death** (`crash machine`): the machine stops after a write and before a flush, so the
+//!   page cache is gone with it and the file is cut to the `durable_offset` the store had promised.
+//!   *Exactly* the unsynced bytes are lost — the model that makes `durable_offset` an observable
+//!   rather than a comment (`docs/crash-points.md`, point 2);
+//! * **machine death during a write** (`crash torn`): the same machine stops while a record is being
+//!   written, so the write arrives only in part and the file is cut *inside* the unsynced tail —
+//!   which is what a device's write cache leaves when it commits some of a write and not the rest
+//!   (`docs/crash-points.md`, point 3). What survives ends in a partial record, and a recovery that
+//!   guesses instead of stopping hands it back;
+//! * **a device that wrote something else** (`crash rewrite`): the write arrived whole and one of
+//!   its bytes is not the byte that was sent — a device whose cache lied, a bus that flipped a bit,
+//!   a sector written from somebody else's buffer. Nothing is lost *physically*: the file is exactly
+//!   as long as the store left it. The seal is the only thing that can tell, and this is the model
+//!   that makes the step's central rule observable under a schedule: a recovery that stops at the
+//!   record it cannot prove answers the records before it, and one that skips ahead to the next
+//!   record it can prove answers a log with a hole in it.
+//!
+//! The last two are the same failure seen twice — a write the machine did not finish, and a write it
+//! finished wrongly — and the checks below keep them apart: a partial record is `torn`, changed
+//! bytes are `corrupt`, and both are answered with the prefix that was proved.
+//!
+//! The store's own durable boundary is the only thing that decides where a death cuts, so a death at
+//! a moment when nothing is unsynced loses nothing. The checks in [`Store::restart`] are written to
+//! hold in that case as well, instead of assuming a loss.
+//!
+//! # Why the flush is a task and not the policy
+//!
+//! The store's own interval policy decides by reading a **real** clock (`Spool::append`,
+//! `lakelet/4.3-write-path-adr`), and a simulated run cannot see that clock: a flush that happened
+//! because the author's machine was loaded is exactly the nondeterminism `slow:sim@N` fails on. So
+//! the store here runs `Policy::Never` and a task of its own syncs every [`FLUSH_MILLIS`]
+//! milliseconds of *simulated* time — the same duty cycle, driven by a clock this scenario owns.
+//! That is `jobq/3.8-clock-injection`'s lesson applied where it bites: a decision that depends on
+//! time has to be handed the clock it may read.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::sync::Mutex;
+use turmoil::Builder;
+use turmoil::net::{TcpListener, TcpStream};
+
+use lakelet::engine::Spool;
+use lakelet::engine::spool::FILE;
+use lakelet::engine::wal::Policy;
+use lakelet::engine::wal::replay;
+use lakelet::engine::wal::segment::{self, Stop};
+
+/// The seed this run uses when the judge does not name one.
+const DEFAULT_SEED: u64 = 1;
+/// The variable `slow:sim@N` sets: which schedule this run takes.
+const SEED: &str = "KILN_SIM_SEED";
+/// The store's name and port in the simulated network.
+const HOST: &str = "store";
+const PORT: u16 = 7000;
+/// Writers racing the flusher.
+const WRITERS: usize = 3;
+/// Appends each writer makes.
+const APPENDS: usize = 4;
+/// Bytes one payload has. Not a round number, so a length/payload mix-up cannot pass by accident.
+const PAYLOAD: usize = 41;
+/// How often the store's flusher syncs, in simulated milliseconds.
+const FLUSH_MILLIS: u64 = 40;
+/// How many times it syncs before it stops.
+const FLUSHES: usize = 6;
+/// The writer number the operator appends under, once the writers are gone.
+const OPERATOR: usize = 9;
+
+/// A failure inside the scenario: the one sentence the run reports.
+type Failure = Box<dyn std::error::Error>;
+
+/// The seed this process was asked for.
+fn seed() -> u64 {
+    match std::env::var(SEED) {
+        Ok(text) => text
+            .parse()
+            .unwrap_or_else(|error| panic!("{SEED}=`{text}` is not a number: {error}")),
+        Err(_) => DEFAULT_SEED,
+    }
+}
+
+/// The bytes one append carries, decided by the two numbers that name it: the judge can reconstruct
+/// every payload without reading the log it is judging.
+fn payload(writer: usize, index: usize) -> Vec<u8> {
+    (0..PAYLOAD)
+        .map(|offset| {
+            (writer as u8)
+                .wrapping_mul(11)
+                .wrapping_add((index as u8).wrapping_mul(97))
+                .wrapping_add(offset as u8)
+        })
+        .collect()
+}
+
+/// The value of `key=` in a reply, as a number.
+fn field(reply: &str, key: &str) -> u64 {
+    let (_, rest) = reply
+        .split_once(&format!("{key}="))
+        .unwrap_or_else(|| panic!("the reply `{reply}` carries no `{key}=`"));
+    let digits: String = rest.chars().take_while(char::is_ascii_digit).collect();
+    digits
+        .parse()
+        .unwrap_or_else(|error| panic!("`{key}=` in `{reply}` is not a number: {error}"))
+}
+
+/// One append the store acknowledged, and whether it survived the last death.
+struct Append {
+    /// How long the log was after it.
+    len: u64,
+    /// What it carried.
+    payload: Vec<u8>,
+    /// `false` once a death took its bytes.
+    alive: bool,
+}
+
+/// The store: the real write path, and what this harness remembers about it.
+struct Store {
+    /// The directory both the dead and the live store write to.
+    directory: PathBuf,
+    /// The write path, or `None` while the store is down.
+    spool: Option<Spool>,
+    /// Every append, in order.
+    appended: Vec<Append>,
+    /// How many writers have reported that they are finished.
+    writers_done: usize,
+    /// How many times the flusher synced.
+    flushes: usize,
+    /// The death the store is waiting to be restarted after: what it was, what the store had
+    /// promised, and how much of the log it left.
+    death: Option<(String, u64, u64)>,
+    /// A failure the flusher hit, which every later command reports.
+    failed: Option<String>,
+}
+
+impl Store {
+    /// Open a store in `directory`.
+    ///
+    /// `Policy::Never`, because this store's flushes are the harness's, on the simulation's clock (the
+    /// module docs say why). `Spool::with_policy` is the write path's own entry point, so the policy
+    /// here is a policy this build can be asked for, not one invented for a test.
+    fn open(directory: PathBuf) -> Result<Self, Failure> {
+        let spool = Spool::with_policy(&directory, Policy::Never)?;
+        Ok(Self {
+            directory,
+            spool: Some(spool),
+            appended: Vec::new(),
+            writers_done: 0,
+            flushes: 0,
+            death: None,
+            failed: None,
+        })
+    }
+
+    /// What the store still holds, in order: the appends no death took.
+    fn alive(&self) -> Vec<Vec<u8>> {
+        self.appended
+            .iter()
+            .filter(|append| append.alive)
+            .map(|append| append.payload.clone())
+            .collect()
+    }
+
+    /// Append one record through the real write path, and answer `(len, durable)`.
+    fn append(&mut self, writer: usize, index: usize) -> Result<(u64, u64), Failure> {
+        let payload = payload(writer, index);
+        let Some(spool) = self.spool.as_mut() else {
+            return Err(format!(
+                "append writer={writer} index={index} arrived at a store that is dead"
+            )
+            .into());
+        };
+        spool.append(&payload)?;
+        let (len, durable) = (spool.len(), spool.durable_offset());
+        self.appended.push(Append {
+            len,
+            payload,
+            alive: true,
+        });
+        println!(
+            "lakelet-sim append writer={writer} index={index} len={len} durable={durable} \
+             records={}",
+            self.appended.len()
+        );
+        Ok((len, durable))
+    }
+
+    /// Flush, the way the store's own interval policy would.
+    fn sync(&mut self, interval: usize) -> Result<(u64, u64), Failure> {
+        let Some(spool) = self.spool.as_mut() else {
+            return Ok((0, 0));
+        };
+        spool.sync()?;
+        let (len, durable) = (spool.len(), spool.durable_offset());
+        self.flushes += 1;
+        println!("lakelet-sim sync interval={interval} len={len} durable={durable}");
+        Ok((len, durable))
+    }
+
+    /// Kill the store the way `kind` models, and answer `(written, durable, kept)`: how long the log
+    /// was, what the store had promised, and how much of it the death left behind.
+    fn crash(&mut self, kind: &str) -> Result<(u64, u64, u64), Failure> {
+        let Some(spool) = self.spool.take() else {
+            return Err("the store was asked to die twice".into());
+        };
+        let (written, durable) = (spool.len(), spool.durable_offset());
+        drop(spool);
+        let kept = match kind {
+            // The process dies; the machine and its page cache are fine, so the file is untouched.
+            "process" => written,
+            // The machine dies: everything the last flush did not cover goes with the page cache.
+            "machine" => durable,
+            // The machine dies inside the write that was in flight: the device had committed some of
+            // the unsynced tail and not the rest of it, so the file is cut inside a record.
+            "torn" => durable + (written - durable) / 2,
+            // The write arrived whole and one of its bytes is not the byte that was sent, so the
+            // file is as long as the store left it and the last record in it is not that record.
+            "rewrite" => {
+                let mut file = std::fs::OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .open(self.directory.join(FILE))?;
+                use std::io::{Read, Seek, SeekFrom, Write};
+                // The last record's first payload byte: a record is `[length][payload][seal]`, and
+                // the harness knows both because every append here carries `PAYLOAD` bytes.
+                let at = written - (segment::OVERHEAD + PAYLOAD) as u64 + segment::LENGTH as u64;
+                file.seek(SeekFrom::Start(at))?;
+                let mut byte = [0u8; 1];
+                file.read_exact(&mut byte)?;
+                file.seek(SeekFrom::Start(at))?;
+                file.write_all(&[byte[0] ^ 0xFF])?;
+                file.sync_all()?;
+                written
+            }
+            other => return Err(format!("`{other}` is not a death this harness models").into()),
+        };
+        if kept < written {
+            std::fs::OpenOptions::new()
+                .write(true)
+                .open(self.directory.join(FILE))?
+                .set_len(kept)?;
+        }
+        // What the *device* holds, which is what the next restart judges the replay against: a
+        // record the death cut away is not one the store still has.
+        for append in &mut self.appended {
+            if append.len > kept {
+                append.alive = false;
+            }
+        }
+        self.death = Some((kind.to_owned(), durable, kept));
+        println!(
+            "lakelet-sim crash kind={kind} written={written} durable={durable} kept={kept} lost={}",
+            written - kept
+        );
+        Ok((written, durable, kept))
+    }
+
+    /// Open the store again on the same directory — the call the daemon makes at its third startup
+    /// step — and judge what the log proves against what the store promised before it died.
+    ///
+    /// The replay is read *before* the store is opened, because opening is what takes the refused tail
+    /// out of the file: the numbers reported here are what the bytes proved, and the store is then
+    /// asked for the same records through its own reader. Two readers of one file is the point — the
+    /// write path and the replay disagreeing about the same bytes is a bug, not a difference of
+    /// opinion.
+    fn restart(&mut self) -> Result<(), Failure> {
+        let Some((kind, durable, kept)) = self.death.clone() else {
+            return Err("the store was restarted without having died".into());
+        };
+        let recovered = replay::recover(&self.directory)?;
+        println!(
+            "lakelet-sim recovered kind={kind} records={} bytes={} discarded={} stop={}",
+            recovered.records().len(),
+            recovered.bytes(),
+            recovered.discarded(),
+            recovered.stop().name()
+        );
+        let held = self.alive();
+        let proved: Vec<Vec<u8>> = recovered.records().to_vec();
+        if recovered.bytes() + recovered.discarded() != kept {
+            return Err(format!(
+                "kind={kind}: recovery accounts for {} proved byte(s) and {} discarded, and the death \
+                 left {kept} — every byte of the file is either a record the replay can prove or a \
+                 number it reports",
+                recovered.bytes(),
+                recovered.discarded()
+            )
+            .into());
+        }
+        if recovered.bytes() < durable {
+            return Err(format!(
+                "kind={kind}: the store promised {durable} durable byte(s) and recovery proved only \
+                 {} — a machine may take what was never flushed, and never what was",
+                recovered.bytes()
+            )
+            .into());
+        }
+        if !held.starts_with(&proved) {
+            return Err(format!(
+                "kind={kind}: recovery proved {} record(s) of {:?} byte(s) and the device holds {} of \
+                 {:?} — a prefix of the log is what a death may cost and nothing else. A replay that \
+                 skipped the record it could not prove and answered the ones after it hands back a \
+                 log with a hole in it, and the two lists above are where that shows",
+                proved.len(),
+                proved.iter().map(Vec::len).collect::<Vec<usize>>(),
+                held.len(),
+                held.iter().map(Vec::len).collect::<Vec<usize>>()
+            )
+            .into());
+        }
+        match kind.as_str() {
+            "process" => {
+                if proved != held || recovered.discarded() != 0 || recovered.bytes() != kept {
+                    return Err(format!(
+                        "kind=process: a process died and the page cache did not, so nothing written \
+                         may be lost: {} proved of {kept} written, {} discarded",
+                        recovered.bytes(),
+                        recovered.discarded()
+                    )
+                    .into());
+                }
+            }
+            "machine" => {
+                if proved != held || recovered.discarded() != 0 || recovered.bytes() != durable {
+                    return Err(format!(
+                        "kind=machine: the file was cut to what the store had promised, so the replay \
+                         ends exactly there: {} proved of {durable} promised, {} discarded",
+                        recovered.bytes(),
+                        recovered.discarded()
+                    )
+                    .into());
+                }
+            }
+            "torn" => {
+                if recovered.discarded() > 0 && recovered.stop() != Stop::Torn {
+                    return Err(format!(
+                        "kind=torn: {} byte(s) of a record nobody finished are in the file and the \
+                         walk called that `{}` — a partial record is a torn one, and it is not the \
+                         same answer as a record whose bytes changed",
+                        recovered.discarded(),
+                        recovered.stop().name()
+                    )
+                    .into());
+                }
+            }
+            "rewrite" => {
+                if recovered.discarded() == 0 || recovered.stop() != Stop::Corrupt {
+                    return Err(format!(
+                        "kind=rewrite: a byte of the write that was in flight is not the byte that was \
+                         sent, and the replay says it proved every record ({} discarded, `{}`) — the \
+                         seal is what makes a changed record unprovable, and a recovery that hands it \
+                         back, or that walks past it to the records behind it, is a store answering a \
+                         log nobody wrote",
+                        recovered.discarded(),
+                        recovered.stop().name()
+                    )
+                    .into());
+                }
+            }
+            other => return Err(format!("`{other}` is not a death this harness models").into()),
+        }
+
+        // The notebook follows the bytes from here on: what the replay proved is what this store
+        // holds, and every later phase is judged against that rather than against the file's length.
+        for append in &mut self.appended {
+            if append.len > recovered.bytes() {
+                append.alive = false;
+            }
+        }
+
+        let spool = Spool::open(&self.directory)?;
+        let served = spool.records()?;
+        if served != proved {
+            return Err(format!(
+                "kind={kind}: the reopened store answers {} record(s) where recovery proved {} — the \
+                 write path and the replay disagree about the same bytes",
+                served.len(),
+                proved.len()
+            )
+            .into());
+        }
+        if spool.len() != recovered.bytes() {
+            return Err(format!(
+                "kind={kind}: the reopened store counts {} byte(s) of log where recovery proved {} — a \
+                 store that continued anywhere but the recovered end would write over a record it \
+                 did not lose",
+                spool.len(),
+                recovered.bytes()
+            )
+            .into());
+        }
+        println!(
+            "lakelet-sim verdict kind={kind} records={} bytes={} discarded={} ok=true",
+            recovered.records().len(),
+            recovered.bytes(),
+            recovered.discarded()
+        );
+        self.death = None;
+        self.spool = Some(spool);
+        Ok(())
+    }
+
+    /// What the store holds now, as the scenario's last word.
+    fn verify(&mut self) -> Result<(), Failure> {
+        let alive = self.alive();
+        let Some(spool) = self.spool.as_mut() else {
+            return Err("the scenario asked a dead store for its records".into());
+        };
+        let served = spool.records()?;
+        if served != alive {
+            return Err(format!(
+                "the store serves {} record(s) and was given {}: appending after a recovery has to \
+                 continue after the records it proved, never over them",
+                served.len(),
+                alive.len()
+            )
+            .into());
+        }
+        println!(
+            "lakelet-sim done records={} flushes={} deaths=4",
+            served.len(),
+            self.flushes
+        );
+        Ok(())
+    }
+}
+
+/// One connection to the store, one command per line.
+struct Client {
+    stream: BufReader<TcpStream>,
+}
+
+impl Client {
+    /// Connect, waiting for the store to be listening.
+    async fn connect() -> Result<Self, Failure> {
+        for _ in 0..200 {
+            match TcpStream::connect((HOST, PORT)).await {
+                Ok(socket) => {
+                    return Ok(Self {
+                        stream: BufReader::new(socket),
+                    });
+                }
+                Err(_) => tokio::time::sleep(Duration::from_millis(10)).await,
+            }
+        }
+        Err(format!("{HOST}:{PORT} never accepted a connection").into())
+    }
+
+    /// Send one command and answer the reply. A command the store refused fails the run.
+    async fn ask(&mut self, command: &str) -> Result<String, Failure> {
+        self.stream.write_all(command.as_bytes()).await?;
+        self.stream.write_all(b"\n").await?;
+        self.stream.flush().await?;
+        let mut text = String::new();
+        if self.stream.read_line(&mut text).await? == 0 {
+            return Err(format!("the store closed the connection at `{command}`").into());
+        }
+        let reply = text.trim_end().to_owned();
+        match reply.strip_prefix("failed ") {
+            Some(reason) => Err(format!("`{command}` was refused: {reason}").into()),
+            None => Ok(reply),
+        }
+    }
+}
+
+/// Read one command and answer the store's reply.
+async fn serve(socket: TcpStream, store: Arc<Mutex<Store>>) -> Result<(), Failure> {
+    let mut stream = BufReader::new(socket);
+    loop {
+        let mut text = String::new();
+        if stream.read_line(&mut text).await? == 0 {
+            return Ok(());
+        }
+        let reply = match command(text.trim(), &store).await {
+            Ok(reply) => reply,
+            Err(error) => format!("failed {error}"),
+        };
+        stream.write_all(reply.as_bytes()).await?;
+        stream.write_all(b"\n").await?;
+        stream.flush().await?;
+    }
+}
+
+/// One command, the one line it answers, and the store work behind it.
+async fn command(text: &str, store: &Arc<Mutex<Store>>) -> Result<String, Failure> {
+    let mut words = text.split_whitespace();
+    let verb = words.next().unwrap_or_default();
+    let mut store = store.lock().await;
+    if let Some(reason) = store.failed.clone() {
+        return Err(reason.into());
+    }
+    match verb {
+        "append" => {
+            let writer = number(words.next(), "writer")?;
+            let index = number(words.next(), "index")?;
+            let (len, durable) = store.append(writer, index)?;
+            Ok(format!("appended len={len} durable={durable}"))
+        }
+        "done" => {
+            store.writers_done += 1;
+            Ok(format!("done writers={}", store.writers_done))
+        }
+        "sync" => {
+            let interval = store.flushes;
+            let (len, durable) = store.sync(interval)?;
+            Ok(format!("synced len={len} durable={durable}"))
+        }
+        "status" => Ok(format!(
+            "status writers={} records={} flushes={}",
+            store.writers_done,
+            store.appended.len(),
+            store.flushes
+        )),
+        "crash" => {
+            let kind = words.next().unwrap_or_default().to_owned();
+            let (written, durable, kept) = store.crash(&kind)?;
+            Ok(format!(
+                "crashed written={written} durable={durable} kept={kept}"
+            ))
+        }
+        "restart" => {
+            store.restart()?;
+            Ok("restarted".to_owned())
+        }
+        "verify" => {
+            store.verify()?;
+            Ok("verified".to_owned())
+        }
+        other => Err(format!("`{other}` is not a command this store speaks").into()),
+    }
+}
+
+/// One whitespace-separated command word, as a number.
+fn number(word: Option<&str>, what: &str) -> Result<usize, Failure> {
+    let Some(word) = word else {
+        return Err(format!("this command needs a {what}").into());
+    };
+    word.parse()
+        .map_err(|error| format!("`{word}` is not a {what}: {error}").into())
+}
+
+/// One append, appended by `writer`, and print when its acknowledgement came back.
+async fn writer(writer: usize, client: &mut Client) -> Result<(), Failure> {
+    let started = tokio::time::Instant::now();
+    for index in 0..APPENDS {
+        client.ask(&format!("append {writer} {index}")).await?;
+        // A simulated duration, never an `Instant`: see the module docs.
+        println!(
+            "lakelet-sim ack writer={writer} index={index} at={:?}",
+            tokio::time::Instant::now() - started
+        );
+    }
+    client.ask(&format!("done {writer}")).await?;
+    Ok(())
+}
+
+#[test]
+fn a_crash_is_a_schedule_and_recovery_proves_what_the_store_promised() {
+    let seed = seed();
+    let directory =
+        std::env::temp_dir().join(format!("lakelet-sim-wal-{}-{seed}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&directory);
+
+    let store = Arc::new(Mutex::new(
+        Store::open(directory.clone()).expect("a directory this process owns is a store"),
+    ));
+
+    let mut builder = Builder::new();
+    builder.rng_seed(seed).enable_random_order();
+    let mut sim = builder.build();
+
+    let hosted = Arc::clone(&store);
+    sim.host(HOST, move || {
+        let store = Arc::clone(&hosted);
+        async move {
+            let listener = TcpListener::bind(("0.0.0.0", PORT)).await?;
+            // The store's flush, on the simulation's clock instead of the machine's.
+            let flusher = Arc::clone(&store);
+            tokio::spawn(async move {
+                for interval in 0..FLUSHES {
+                    tokio::time::sleep(Duration::from_millis(FLUSH_MILLIS)).await;
+                    let mut store = flusher.lock().await;
+                    if let Err(error) = store.sync(interval) {
+                        store.failed = Some(format!("the store could not flush: {error}"));
+                    }
+                }
+            });
+            loop {
+                let (socket, _) = listener.accept().await?;
+                let store = Arc::clone(&store);
+                tokio::spawn(async move {
+                    if let Err(error) = serve(socket, store).await {
+                        eprintln!("lakelet-sim a connection ended: {error}");
+                    }
+                });
+            }
+            #[allow(unreachable_code)]
+            Ok(())
+        }
+    });
+
+    for writer_index in 0..WRITERS {
+        sim.client(format!("writer{writer_index}"), async move {
+            let mut client = Client::connect().await?;
+            writer(writer_index, &mut client).await
+        });
+    }
+
+    sim.client("operator", async move {
+        let mut client = Client::connect().await?;
+        // The writers and the flusher first, so the phases after them are the same on every machine:
+        // the seed decides the interleaving, and the scenario decides what happens next.
+        let mut waited = 0;
+        loop {
+            let reply = client.ask("status").await?;
+            if field(&reply, "writers") == WRITERS as u64
+                && field(&reply, "flushes") == FLUSHES as u64
+            {
+                break;
+            }
+            waited += 1;
+            if waited > 200 {
+                return Err(format!("the writers and the flusher never finished: {reply}").into());
+            }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+
+        // 1. The process dies. Nothing written may be lost: the kernel outlived it.
+        client.ask("crash process").await?;
+        client.ask("restart").await?;
+
+        // 2. The machine dies *during* a write. An odd number of unsynced records is on purpose: the
+        //    cut then lands inside one of them, which is the partial record this model is for.
+        for index in 0..3 {
+            client.ask(&format!("append {OPERATOR} {index}")).await?;
+        }
+        client.ask("crash torn").await?;
+        client.ask("restart").await?;
+
+        // 3. The write arrives whole and one of its bytes is not the byte that was sent. This is the
+        //    death the seal exists for, and the one that tells a replay which stops from a replay
+        //    that walks past what it could not prove.
+        for index in 3..5 {
+            client.ask(&format!("append {OPERATOR} {index}")).await?;
+        }
+        client.ask("crash rewrite").await?;
+        client.ask("restart").await?;
+
+        // 4. The machine dies with nothing flushed since the last sync: the store continuing after a
+        //    recovery has to be durable again before the next death means anything.
+        for index in 5..7 {
+            client.ask(&format!("append {OPERATOR} {index}")).await?;
+        }
+        client.ask("sync").await?;
+        for index in 7..9 {
+            client.ask(&format!("append {OPERATOR} {index}")).await?;
+        }
+        client.ask("crash machine").await?;
+        client.ask("restart").await?;
+
+        // 5. And the store still takes writes, after everything it proved.
+        client.ask(&format!("append {OPERATOR} 9")).await?;
+        client.ask("verify").await?;
+        Ok(())
+    });
+
+    sim.run()
+        .unwrap_or_else(|error| panic!("the simulation did not finish: {error}"));
+    let _ = std::fs::remove_dir_all(&directory);
+}
