+++ b/src/engine/wal/segment.rs
@@ -0,0 +1,165 @@
+//! The bytes a log is made of: a header that says which log this is, and sealed records after it.
+//!
+//! Step `lakelet/4.4-wal-recovery`. This module owns the format — what the bytes are and the walk
+//! that reads them — and [`super::replay`] owns the store-level answer built on it.
+//!
+//! ```text
+//!  0..4        `MAGIC`: the four bytes that say this file is a lakelet log
+//!  4           `VERSION`: the format's version, one byte
+//!  5..         records, one after another, to the end of the file
+//! ```
+//!
+//! ```text
+//!  0..4        u32, little endian: the payload's length in bytes
+//!  4..4+n      the payload
+//!  4+n..8+n    u32, little endian: the record's seal (`checksum::seal(length, payload)`)
+//! ```
+//!
+//! The layout is the course's, because more than this step reads it: the spec reads it through
+//! [`HEADER`], [`LENGTH`] and [`OVERHEAD`], and the step's harness writes logs through
+//! [`super::super::Spool`] and cuts them. What is *yours* is every body below, and the reasoning for
+//! the three choices the layout makes. Write that reasoning down here, next to the bytes it is
+//! about:
+//!
+//! * **the file declares itself first.** Four bytes of magic and a version byte are what make "this
+//!   is not this store's log" a decision instead of a guess. Say what the alternative costs: without
+//!   them, `hi!` and a log whose first write was cut after two bytes are the same bytes, and
+//!   recovery has to choose between calling one of them corrupt and calling the other empty;
+//! * **each record declares itself.** Say why the length and the seal travel *with* the payload,
+//!   rather than in an index, a footer or a side file — and what a store loses when the answer to
+//!   "where does this record end?" is anything but the bytes in front of the reader;
+//! * **the seal covers the length.** `checksum` is where the seal is computed; say here what a
+//!   reader would do with a length that was not covered.
+//!
+//! The header is five bytes and is written with the log's first record, so a store that has accepted
+//! nothing is an empty file — which is also the one file that is not a log *yet* and not a foreign
+//! file either. [`scan`] is where those two are told apart, and it is total: the bytes of any file
+//! are whole records, or a record the write was cut short inside, or something whose seal does not
+//! match. Three answers, and no fourth for "the reader panicked" or "the reader guessed" — a capture
+//! of the bytes a crash left behind is exactly the input this module exists for.
+
+use crate::error::Error;
+
+use super::checksum;
+
+/// The four bytes at the start of every log this build writes.
+pub const MAGIC: [u8; 4] = *b"LKLT";
+
+/// Version of the format above. A file that says anything else is not this build's log.
+pub const VERSION: u8 = 1;
+
+/// The bytes a log starts with: [`MAGIC`], then [`VERSION`].
+pub const HEADER_BYTES: [u8; 5] = [MAGIC[0], MAGIC[1], MAGIC[2], MAGIC[3], VERSION];
+
+/// How many bytes of a log come before its first record.
+pub const HEADER: usize = HEADER_BYTES.len();
+
+/// The length one record states in front of its payload: four bytes, little endian.
+pub const LENGTH: usize = 4;
+
+/// Bytes of framing around one record's payload: its [`LENGTH`] and its seal.
+pub const OVERHEAD: usize = LENGTH + checksum::LEN;
+
+/// Where a walk over a log's bytes stopped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Stop {
+    /// Every byte of the file is whole records: nothing was left over.
+    End,
+    /// The bytes stop inside a record — the file holds fewer than the length states, or the record's
+    /// own framing is cut before the length. A write that was interrupted leaves this, and so does a
+    /// file whose header was cut short.
+    Torn,
+    /// A whole record's worth of bytes is there and is not the record it claims: the seal does not
+    /// match, so these bytes changed after they were written (a bit that flipped, a device that wrote
+    /// something else, a reader looking at the wrong offset).
+    Corrupt,
+}
+
+impl Stop {
+    /// The word a log line, a report and the step's harness call this stop by.
+    ///
+    /// Stable on purpose, like `Policy::name`: `end`, `torn` and `corrupt` are the three things a
+    /// recovery can find, and a report that spelled them differently in two places would make an
+    /// operator compare two words for one fact.
+    #[must_use]
+    pub fn name(&self) -> &'static str {
+        let _ = self;
+        todo!("step lakelet/4.4-wal-recovery")
+    }
+}
+/// What a walk over a log's bytes proved.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Scanned {
+    /// The records whose seal verified, in the order they were written.
+    records: Vec<Vec<u8>>,
+    /// Bytes of the log that are proved: the header plus every whole record.
+    verified: usize,
+    /// Why the walk stopped there.
+    stop: Stop,
+}
+
+impl Scanned {
+    /// The records whose seal verified, in the order they were written.
+    #[must_use]
+    pub fn records(&self) -> &[Vec<u8>] {
+        &self.records
+    }
+
+    /// How many bytes of the log are proved: its header plus every whole record.
+    ///
+    /// The offset the store continues at, and the number `Spool::len` starts from: everything below
+    /// it is a record whose seal verified, and everything above it is bytes no walk could prove.
+    #[must_use]
+    pub fn verified(&self) -> usize {
+        self.verified
+    }
+
+    /// Why the walk stopped where it did.
+    #[must_use]
+    pub fn stop(&self) -> Stop {
+        self.stop
+    }
+}
+
+/// The bytes one record occupies: its length, its payload and its seal.
+///
+/// The length field is 32 bits, so a payload wider than that cannot be described by this format. A
+/// record is written from a frame (`crate::protocol::frame::MAX_PAYLOAD` is a mebibyte), so the two
+/// never meet in this crate.
+#[must_use]
+pub fn encode(payload: &[u8]) -> Vec<u8> {
+    let _ = payload;
+    todo!("step lakelet/4.4-wal-recovery")
+}
+
+/// The bytes a log writes for its **first** record: the header that declares the log, then the
+/// record itself.
+///
+/// The two leave together because a file with a record in it and no header is not a log this module
+/// can read. A store that has accepted nothing holds an empty file, and its first append is what
+/// turns that file into a log.
+#[must_use]
+pub fn introduce(payload: &[u8]) -> Vec<u8> {
+    let _ = payload;
+    todo!("step lakelet/4.4-wal-recovery")
+}
+
+/// Read `bytes` as a log: the records whose seal verifies, and where the walk stopped.
+///
+/// Never panics and never reserves the length a record states — ask the *file* what it holds, before
+/// doing arithmetic on a number that a damaged byte can make arbitrary. A length the bytes cannot
+/// satisfy ends the walk as [`Stop::Torn`], like any other short tail.
+///
+/// An empty file is `Ok` with no records: a store that has accepted nothing is not a foreign file.
+/// Anything else that is not this log is refused — the module docs say why that is a decision.
+///
+/// # Errors
+///
+/// [`Error::Protocol`] when `bytes` is not this store's log at all: it does not start with
+/// [`HEADER_BYTES`], or it announces a format version this build cannot replay. Name what was found
+/// in the sentence: an operator holding a directory they did not expect needs to know which file is
+/// in it.
+pub fn scan(bytes: &[u8]) -> Result<Scanned, Error> {
+    let _ = bytes;
+    todo!("step lakelet/4.4-wal-recovery")
+}
diff --git a/tests/sim_wal.rs b/tests/sim_wal.rs
