@@ -0,0 +1,209 @@
+//! One segment's span, as two intervals: the timestamps its records carry, and the values they hold.
+//!
+//! Step `lakelet/4.14-index-pruning`. `lakelet/4.9-retention` gave the manifest a range of timestamps
+//! per segment and `lakelet/4.11-query-engine` prunes from it, which is one interval per segment. This
+//! module is that idea as a *value*: for every column of a record that has an order, the smallest and
+//! the largest thing in it — the timestamps, and the values.
+//!
+//! # The safe direction, and it is the whole design
+//!
+//! A zone answers **may**, never "does". Every rule below is written so that a wrong answer costs in
+//! the direction a store can recover from:
+//!
+//! * a **false positive** — "a record here may meet your range" about a segment that holds none —
+//!   costs one file read;
+//! * a **false negative** costs a *record*. A query that did not open a segment holding a record it
+//!   asked about answers with a hole in it, and no count would say so: the count it saved is
+//!   invisible and the record it lost is not.
+//!
+//! So a bound nobody stated answers `true` for everything, and a zone built from no records answers
+//! `true` as well: nothing is known, and "nothing is known" is not a reason to skip a file. That is
+//! `lakelet/4.9-retention`'s rule for a segment whose age nobody wrote down — a decision made from a
+//! number nobody wrote down is a decision nobody can defend — applied to an index instead of to a
+//! deletion.
+//!
+//! A **NaN** is the same kind of absence in the value column, and it is the one thing a value has
+//! that a timestamp does not: it is not above or below anything, so it has no place on an interval.
+//! A set that holds one therefore states **no** value bounds rather than bounds that quietly leave it
+//! out.
+//!
+//! # The units, and why they are the manifest's
+//!
+//! Timestamps are milliseconds since the Unix epoch, unsigned, and a record whose `ts_millis` is
+//! negative counts as `0` — the rule the manifest's own entry states, because the zone and the
+//! manifest are two statements about the same records, and a store where they disagreed would prune
+//! on one number and delete on another.
+//!
+//! # The encoding, byte for byte
+//!
+//! ```text
+//!  0      flags: bit 0 is "the timestamps are stated", bit 1 is "the values are"
+//!  1..9   u64, little endian: the earliest timestamp, or 0 when none is stated
+//!  9..17  u64, little endian: the latest timestamp, or 0
+//!  17..25 f64, little endian: the smallest value, or 0.0
+//!  25..33 f64, little endian: the largest value, or 0.0
+//! ```
+//!
+//! Thirty-three bytes, fixed: a zone is a value a reader compares and an index file places at an
+//! offset, and a layout that shifted would make `SegmentIndex::decode` a parser rather than an offset
+//! table. A flag bit this build does not write is a **refusal** and not a reading, the same reason
+//! `lakelet/4.7-columnar-segments` refuses a layout version it does not know: a damaged hint read as
+//! a different hint is a decision taken from bytes nobody wrote.
+
+use std::fmt;
+
+use crate::error::Error;
+use crate::protocol::batch::Record;
+
+/// How many bytes one encoded zone takes.
+pub const BYTES: usize = 33;
+
+/// The flag bit that says the timestamp bounds are stated.
+const TIMESTAMPS: u8 = 0b01;
+
+/// The flag bit that says the value bounds are stated.
+const VALUES: u8 = 0b10;
+
+/// The flags this build writes, and the whole of what a decoder accepts.
+const STATED: u8 = TIMESTAMPS | VALUES;
+
+/// What one segment's records span, per column: two intervals, either of which may be unstated.
+///
+/// One value, built from records and never changed afterwards, which is what makes a plan's decision
+/// reproducible: the same segment answers the same question at any time, and comparing two zones is
+/// comparing what their records were.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Zone {
+    /// The earliest and the latest timestamp, both inclusive — or nothing, when no record stated one.
+    ts: Option<(u64, u64)>,
+    /// The smallest and the largest value, both inclusive — or nothing, when a record holds a NaN.
+    value: Option<(f64, f64)>,
+}
+
+impl Zone {
+    /// The zone of `records`: the bounds of the two columns that have an order.
+    ///
+    /// No records at all is a legal input and answers an *unstated* zone, which may contain anything:
+    /// the caller that hands over an empty segment is not a caller this store's writer can produce
+    /// (`Segments::seal` refuses one, because a file holding nothing would be carried for ever), and a
+    /// reader that met one anyway would open it — which is the answer that costs a read instead of a
+    /// record.
+    #[must_use]
+    pub fn of(records: &[Record]) -> Self {
+        todo!("lakelet/4.14-index-pruning: the bounds of the two columns that have an order")
+    }
+
+    /// The earliest timestamp this zone states, or nothing when none was stated.
+    #[must_use]
+    pub const fn first_millis(&self) -> Option<u64> {
+        todo!()
+    }
+
+    /// The latest timestamp it states, or nothing.
+    #[must_use]
+    pub const fn last_millis(&self) -> Option<u64> {
+        todo!()
+    }
+
+    /// The smallest value it states, or nothing.
+    #[must_use]
+    pub const fn min_value(&self) -> Option<f64> {
+        todo!()
+    }
+
+    /// The largest value it states, or nothing.
+    #[must_use]
+    pub const fn max_value(&self) -> Option<f64> {
+        todo!()
+    }
+
+    /// `true` when a record here **may** have the timestamp `at`.
+    ///
+    /// Both bounds are inclusive because a millisecond is an instant and not a half-open interval: the
+    /// record that stands exactly on the end of a span is in it. An unstated zone answers `true` to
+    /// every instant, which is the module's rule for everything nobody wrote down.
+    #[must_use]
+    pub fn may_contain_ts(&self, at: u64) -> bool {
+        todo!(
+            "lakelet/4.14-index-pruning: may, and never does: an unstated bound answers yes to everything"
+        )
+    }
+
+    /// `true` when a record here **may** hold the value `value`.
+    ///
+    /// Inclusive, and unstated answers `true`, exactly as [`Zone::may_contain_ts`] does: the two
+    /// columns are asked the same shape of question. Nothing in this build's read path asks this one
+    /// yet — a query's grammar has no predicate on a value (`lakelet/4.11-query-engine`) — and it is
+    /// here because it is the same value's other column: the questions a column can be asked belong
+    /// to the value that holds it, and a predicate that does not exist yet is a reason to leave a
+    /// method unused rather than to leave a column unmapped.
+    #[must_use]
+    pub fn may_contain_value(&self, value: f64) -> bool {
+        todo!("lakelet/4.14-index-pruning: the same question for the other column")
+    }
+
+    /// `true` when a record here **may** have a timestamp inside the half-open `[from, to)`.
+    ///
+    /// This is the question a plan asks, and it is the rule `lakelet/4.11-query-engine` already prunes
+    /// the manifest by, written over a zone's own bounds: a segment is met when its earliest record is
+    /// before `to` and its latest is at or after `from`. Both comparisons are load-bearing in opposite
+    /// directions — the upper one strict because a record standing exactly at `to` belongs to the next
+    /// question, the lower one not because a record standing exactly at `from` is in this one — and a
+    /// **question** that meets nothing answers `true`: an unstated zone may contain anything, and a
+    /// direction that answers `false` there would be the one failure a plan may not have.
+    #[must_use]
+    pub fn may_meet(&self, from: u64, to: u64) -> bool {
+        todo!(
+            "lakelet/4.14-index-pruning: the half-open rule the manifest is pruned by, over this zone"
+        )
+    }
+
+    /// The zone that covers the records of both: the smallest first, the largest last, per column.
+    ///
+    /// A **union with an unstated zone is unstated**, and that is the rule rather than an accident of
+    /// the arithmetic: one side has records whose bounds nobody wrote down, so the pair has no bounds
+    /// anybody can defend. It is what a merge needs (`lakelet/4.14-index-pruning` writes the union of
+    /// its inputs' indexes), and it is the same rule the manifest states for a merged segment's range
+    /// (`lakelet/4.9-retention`).
+    #[must_use]
+    pub fn union(&self, other: &Self) -> Self {
+        todo!(
+            "lakelet/4.14-index-pruning: the interval that covers both, and nothing at all when either states nothing"
+        )
+    }
+
+    /// This zone as the [`BYTES`] bytes the layout above states.
+    #[must_use]
+    pub fn encode(&self) -> Vec<u8> {
+        todo!("lakelet/4.14-index-pruning: thirty-three bytes: a flags byte and four numbers")
+    }
+
+    /// Read the zone these bytes are, or refuse them.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Protocol`] when the bytes are not one zone's encoding: not [`BYTES`] of them, or a
+    /// flags byte carrying a bit this build does not write. A zone that cannot be read is an index a
+    /// reader does without (`Index::load` answers `Lookup::Damaged`), and refusing here is what keeps
+    /// a damaged hint from being read as a different one.
+    pub fn decode(bytes: &[u8]) -> Result<Self, Error> {
+        todo!(
+            "lakelet/4.14-index-pruning: the zone these bytes are, or a refusal naming what is wrong"
+        )
+    }
+}
+
