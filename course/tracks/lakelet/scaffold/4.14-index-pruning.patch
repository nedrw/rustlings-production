diff --git a/tests/budget_pruning.rs b/tests/budget_pruning.rs
new file mode 100644
index 0000000..c592d6c
--- /dev/null
+++ b/tests/budget_pruning.rs
@@ -0,0 +1,391 @@
+//! The pruning budget's harness for `lakelet/4.14-index-pruning`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.14-index-pruning
+//! --slow` runs, and the counts it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.14-index-pruning.toml`.
+//!
+//! What it measures is **segments, records, bytes and one rate, never the clock**: a store of
+//! twenty-four sealed segments is built from fixed series and fixed timestamps, one selective query
+//! is asked of it, and what that cost is a set of counts. A count is the same number on a loaded
+//! machine as on an idle one, which is why `kiln`'s budget gate compares counts (`handoff M2 §1.1`)
+//! and why no run of this file can flake because something else was compiling.
+//! `cargo test -p lakelet --test budget_pruning -- --nocapture` prints the lines by hand; the
+//! `lakelet-budget` prefix is what the gate reads.
+//!
+//! # The workload is shaped so that a selective query has something to prune
+//!
+//! Twenty-four segments, one hour each, **sixty records each**: thirty samples of `cpu,host=h{i}`
+//! — the segment's own host, a series that appears in exactly one segment — and thirty of
+//! `cpu,host=fleet`, a series every segment carries. Two series in every segment, one of them unique
+//! to it, is the shape that tells the two prunings apart:
+//!
+//! * the query asks for `host = 'h20'` over the **last twelve hours**. The twelve segments before the
+//!   range are ruled out by the *manifest*, whose stated spans meet nothing the query asked for
+//!   (`segments_pruned_by_time`, `lakelet/4.11-query-engine`'s pruning);
+//! * of the twelve the range meets, eleven do not hold `h20` at all — that is what the *index* is
+//!   asked about, and the count is `blocks_pruned` (this step's);
+//! * and the one that stays holds sixty records of which thirty are answers: pruning is by segment
+//!   and not by series, which is why `rows_scanned` and `rows_answered` are both here.
+//!
+//! A store whose segments each held everything would prune nothing and pass every *functional* case
+//! in the spec, which is the failure this lane exists for: **pruning that prunes nothing is
+//! correct and slow**, and only a count says so. `pruning_rate` is that count as one number — the
+//! share of the store's segments the query did not open, in whole percent — and it is the metric the
+//! plan's fifth drill moves to zero by taking the index out of the plan. That red is loud on purpose:
+//! `blocks_pruned` falls with it, `bytes_avoided` falls with it, `bytes_read` and `segments_opened`
+//! rise, and the gate names all of them against the baseline below.
+//!
+//! Three numbers are here to catch the *other* failure — a wrong answer that is fast:
+//!
+//! * `answer_mismatch_max` is zero, and it is measured against the records this file sealed rather
+//!   than against the store: the answer has to be the one series the predicate named, in one window,
+//!   with thirty records in it. A pruned segment holding a record the query asked about shows up here
+//!   and not in any count of what was pruned;
+//! * `index_missing_max` and `index_unusable_max` are zero, measured from the query's own counters:
+//!   a store that had lost its index answers the same thing having opened more segments, so the
+//!   answer counts cannot tell a working index from a missing one and these two can;
+//! * `bytes_unaccounted_max` and `segments_unaccounted_max` are zero: every segment is opened, pruned
+//!   by the range or pruned by the index, and every byte of the store is in the segments the query
+//!   opened or in the ones a pruning decision left unopened. A count that was reported and not
+//!   performed fails one of them.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness a learner can break by editing their own fixture would judge the
+//! fixture instead of the store.
+
+use std::path::{Path, PathBuf};
+
+use lakelet::engine::compaction::{Segments, file_of};
+use lakelet::engine::index;
+use lakelet::engine::query::exec::{self, Outcome};
+use lakelet::engine::query::parse::{Statement, parse};
+use lakelet::protocol::batch::Record;
+
+/// Segments the store is built from.
+const SEGMENTS: u64 = 24;
+
+/// Records one sealed segment holds: thirty of its own host and thirty of the fleet's.
+const PER_SERIES: usize = 30;
+
+/// Milliseconds between two samples of one series: two minutes, so one hour is thirty samples.
+const STEP: u64 = 120_000;
+
+/// One hour — the width of a segment, of a window, and of the arithmetic below.
+const HOUR: u64 = 3_600_000;
+
+/// The first timestamp of every segment, on an hour boundary.
+///
+/// `1_699_999_200_000` is `472_222 * HOUR` exactly, so a segment's span, the query's range and the
+/// grid its windows count on all start on numbers a reader can check by hand.
+const EPOCH: u64 = 472_222 * HOUR;
+
+/// The first hour the query asks about: half the store, so that the *manifest* prunes the other half.
+const FROM_HOUR: u64 = SEGMENTS / 2;
+
+/// The series every segment carries, so that a segment's vocabulary is never one term.
+const FLEET: &str = "fleet";
+
+/// The host the query asks for: the one series that appears in exactly one segment, and in the
+/// second half of the store.
+const SELECTIVE: u64 = 20;
+
+/// The records one sealed segment holds: its own host, then the fleet's, one series after the other.
+fn segment_records(segment: u64) -> Vec<Record> {
+    let start = EPOCH + segment * HOUR;
+    let mut records: Vec<Record> = (0..PER_SERIES)
+        .map(|offset| Record {
+            series: format!("cpu,host=h{segment}"),
+            ts_millis: (start + offset as u64 * STEP) as i64,
+            value: value_of(segment * PER_SERIES as u64 + offset as u64),
+        })
+        .collect();
+    records.extend((0..PER_SERIES).map(|offset| Record {
+        series: format!("cpu,host={FLEET}"),
+        ts_millis: (start + offset as u64 * STEP) as i64,
+        value: value_of(segment * PER_SERIES as u64 + offset as u64),
+    }));
+    records
+}
+
+/// The value of sample `position`: distinct bit patterns, and no structure a column can exploit.
+///
+/// The bytes a segment costs are part of what this lane compares, and a store of values a compressor
+/// likes would make those counts an argument about `zstd` rather than about pruning.
+fn value_of(position: u64) -> f64 {
+    let mixed = position.wrapping_mul(2_654_435_761) % 100_003;
+    mixed as f64 / 8.0
+}
+
+/// The query this lane asks: one selective host, over the second half of the store, one window an
+/// hour.
+fn text() -> String {
+    format!(
+        "SELECT count(value) FROM cpu WHERE host = 'h{SELECTIVE}' AND ts BETWEEN {} AND {} \
+         GROUP BY time(1h), series",
+        EPOCH + FROM_HOUR * HOUR,
+        EPOCH + SEGMENTS * HOUR
+    )
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "lakelet-budget-pruning-{label}-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the store lives.
+    fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// How many bytes one segment's file costs on the disk, or zero when it is not there.
+    ///
+    /// The disk's own answer and not the manifest's: what a segment *costs* is what a reader pays to
+    /// open it, and a store that wrote a file shorter than it says it did would be caught here
+    /// before any count of pruning was.
+    fn bytes_of(&self, segment: u64) -> u64 {
+        std::fs::metadata(file_of(&self.path, segment))
+            .map(|metadata| metadata.len())
+            .unwrap_or(0)
+    }
+
+    /// How many files the store's index directory holds.
+    fn index_files(&self) -> u64 {
+        std::fs::read_dir(self.path.join(index::DIRECTORY))
+            .map(|entries| entries.filter_map(std::result::Result::ok).count() as u64)
+            .unwrap_or(0)
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// What one selective query over the built store cost, counted.
+struct Counted {
+    /// Segments the store was built from.
+    total: u64,
+    /// Bytes their files cost together, from the disk.
+    bytes_total: u64,
+    /// Bytes the segments *before* the query's range cost, which is what the manifest rules out —
+    /// known here by construction and not by re-implementing the rule the plan applies.
+    bytes_by_time: u64,
+    /// Segments the query opened, from the outcome.
+    opened: u64,
+    /// Segments the manifest's stated spans ruled out.
+    pruned_by_time: u64,
+    /// Segments the index ruled out.
+    blocks_pruned: u64,
+    /// Bytes the segments that were opened cost, from the manifest.
+    bytes_read: u64,
+    /// Bytes the segments the index ruled out cost.
+    bytes_avoided: u64,
+    /// Records read from the segments that were opened.
+    rows_scanned: u64,
+    /// Records that landed in a bucket.
+    rows_answered: u64,
+    /// Answers that are not what this file sealed: series, window or count.
+    mismatch: u64,
+    /// Segments the range met that had no index at all.
+    index_missing: u64,
+    /// Segments whose index could not be read.
+    index_unusable: u64,
+    /// Files in the store's index directory.
+    index_files: u64,
+    /// Something the store refused, counted rather than raised.
+    refused: u64,
+}
+
+/// Build the store, ask the query, and count what it did.
+///
+/// Failures are counted rather than raised for the reason `tests/budget_retention.rs` counts its own:
+/// this file's numbers are what a gate compares, and a harness that panicked would report nothing at
+/// all instead of the count that moved.
+fn ask() -> Counted {
+    let directory = Dir::new("budget");
+    let mut counted = Counted {
+        total: 0,
+        bytes_total: 0,
+        bytes_by_time: 0,
+        opened: 0,
+        pruned_by_time: 0,
+        blocks_pruned: 0,
+        bytes_read: 0,
+        bytes_avoided: 0,
+        rows_scanned: 0,
+        rows_answered: 0,
+        mismatch: 0,
+        index_missing: 0,
+        index_unusable: 0,
+        index_files: 0,
+        refused: 0,
+    };
+    let mut store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    for segment in 0..SEGMENTS {
+        let records = segment_records(segment);
+        if let Err(error) = store.seal(&records) {
+            eprintln!("segment {segment} could not be sealed: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+        counted.total += 1;
+        counted.bytes_total += directory.bytes_of(segment);
+        // The segments the query's range does not reach: the workload is built an hour to a segment
+        // from a known epoch, so which of them are outside the range is arithmetic on constants and
+        // not a second implementation of the plan's rule.
+        if segment < FROM_HOUR {
+            counted.bytes_by_time += directory.bytes_of(segment);
+        }
+    }
+    counted.index_files = directory.index_files();
+
+    let query = match parse(&text()) {
+        Ok(Statement::Query(query)) | Ok(Statement::Explain(query)) => query,
+        Err(refusal) => {
+            eprintln!("the query was refused by the grammar: {refusal}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    let snapshot = store.snapshot();
+    let outcome: Outcome = match exec::execute(&snapshot, &query) {
+        Ok(outcome) => outcome,
+        Err(refusal) => {
+            eprintln!("the query was refused by the store: {refusal}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+
+    counted.opened = outcome.segments_opened();
+    counted.pruned_by_time = outcome.segments_pruned();
+    counted.blocks_pruned = outcome.blocks_pruned();
+    counted.bytes_read = outcome.bytes_read();
+    counted.bytes_avoided = outcome.bytes_avoided();
+    counted.rows_scanned = outcome.rows_scanned();
+    counted.rows_answered = outcome.rows_answered();
+    counted.index_missing = outcome.index_missing();
+    counted.index_unusable = outcome.index_unusable();
+
+    // What the answer *is*, against what this file sealed: one answer, for the series the predicate
+    // named, in one window, holding thirty records. Every disagreement is one count, so a wrong
+    // answer that was fast is a number the gate names.
+    let expected = format!("cpu,host=h{SELECTIVE}");
+    if outcome.answers().len() != 1 {
+        counted.mismatch += 1;
+    }
+    for answer in outcome.answers() {
+        if answer.series() != Some(expected.as_str()) {
+            counted.mismatch += 1;
+        }
+        if answer.buckets().len() != 1 {
+            counted.mismatch += 1;
+        }
+        let held: u64 = answer
+            .buckets()
+            .iter()
+            .fold(0u64, |total, bucket| total.saturating_add(bucket.count()));
+        if held != PER_SERIES as u64 {
+            counted.mismatch += 1;
+        }
+        if answer
+            .buckets()
+            .first()
+            .is_some_and(|bucket| bucket.start() != EPOCH + SELECTIVE * HOUR)
+        {
+            counted.mismatch += 1;
+        }
+    }
+    counted
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+#[test]
+fn the_pruning_budget() {
+    let counted = ask();
+
+    // The shape of the store the query was asked of: segments, the bytes they cost, and the bytes of
+    // the ones the range does not reach. A store with nothing in it cannot pass any count below, and
+    // a `seal` that wrote the wrong records is caught before anything is pruned.
+    metric("segments_total", counted.total);
+    metric("bytes_total", counted.bytes_total);
+    metric("bytes_outside_range", counted.bytes_by_time);
+
+    // What the query did: the segments it opened, the two prunings counted apart, and the bytes each
+    // of them was worth. `segments_pruned_by_time` is the pruning a store had before this step;
+    // `blocks_pruned` is the index's share, and it is the number the drill moves to zero.
+    metric("segments_opened", counted.opened);
+    metric("segments_pruned_by_time", counted.pruned_by_time);
+    metric("blocks_pruned", counted.blocks_pruned);
+    metric("bytes_read", counted.bytes_read);
+    metric("bytes_avoided", counted.bytes_avoided);
+
+    // The rate, in whole percent: the share of the store's segments the query did not have to open.
+    // One number is easier to move than five, which is why the gate has one to name when the index
+    // is taken out of the plan — and it is the metric the fifth drill is written about.
+    let unopened = counted.pruned_by_time + counted.blocks_pruned;
+    metric(
+        "pruning_rate",
+        unopened.saturating_mul(100) / counted.total.max(1),
+    );
+
+    // Every segment is opened, pruned by the range or pruned by the index, and every byte of the
+    // store is in the segments that were opened or in the ones a decision left unopened. A count
+    // that was reported and not performed fails one of these whatever its other numbers say.
+    metric(
+        "segments_unaccounted_max",
+        counted
+            .total
+            .abs_diff(counted.opened + counted.pruned_by_time + counted.blocks_pruned),
+    );
+    metric(
+        "bytes_unaccounted_max",
+        counted
+            .bytes_total
+            .abs_diff(counted.bytes_read + counted.bytes_avoided + counted.bytes_by_time),
+    );
+
+    // What was read and what was answered: a segment is opened whole, so the sixty records of the
+    // one segment that stayed were read and the thirty of them that are answers landed in a bucket.
+    metric("rows_scanned", counted.rows_scanned);
+    metric("rows_answered", counted.rows_answered);
+    // And the answer itself, against the records this file sealed. Zero, or the pruning was wrong —
+    // which is the one failure a count of pruned segments cannot see.
+    metric("answer_mismatch_max", counted.mismatch);
+
+    // The index the store wrote, and the two ways a store can be unable to use one. The files are
+    // counted on the disk; the two upper bounds come from the query's own counters, and a store that
+    // had lost its index would print the same answer with these two moved.
+    metric("index_files", counted.index_files);
+    metric("index_missing_max", counted.index_missing);
+    metric("index_unusable_max", counted.index_unusable);
+
+    // A store that refused something is a store this lane cannot judge by counts alone.
+    metric("refused_max", counted.refused);
+}
