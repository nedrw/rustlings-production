index 0000000..bce33a7
--- /dev/null
+++ b/src/engine/segment/encode.rs
@@ -0,0 +1,116 @@
+//! The column block: what a segment's records are before anything compresses them.
+//!
+//! Step `lakelet/4.7-columnar-segments`. This file owns the bytes that the golden vector in
+//! `spec/4.7/columnar_segments.rs` spells out, and `docs/format.md` is the same layout in prose. A
+//! segment's *file* adds a header and a `zstd` frame around what is written here ([`super`]); this
+//! is the part that has to stay readable by hand, because it is the part a mistake is visible in.
+//!
+//! ```text
+//!  0..8        u64, little endian: how many records every column holds
+//!  then one framed column per entry of [`ORDER`], in that order:
+//!    +0        u8: the column's tag — which of the four encodings below it uses
+//!    +1..5     u32, little endian: the length of the payload that follows
+//!    +5..      the payload
+//! ```
+//!
+//! # The four encodings
+//!
+//! | tag | name | payload | speaks for |
+//! | --- | --- | --- | --- |
+//! | 0 | [`PLAIN`] | one value after another, at its own width | every column |
+//! | 1 | [`RLE`] | `u32` runs, then per run `u32` length + one value | the value column |
+//! | 2 | [`DELTA`] | `i64` first timestamp, then one zigzag varint per step | the timestamp column |
+//! | 3 | [`DIC`] | `u32` names, then `u32` runs of entry ids | the series column |
+//!
+//! A column's *width* is its own: a value is the eight bytes of an `f64`'s bits, a timestamp eight
+//! bytes of `i64`, and a series entry a `u16` length in front of UTF-8 bytes.
+//!
+//! # How an encoding is chosen
+//!
+//! Each column speaks two of the four — the series column [`DIC`] and [`PLAIN`], the timestamp
+//! column [`DELTA`] and [`PLAIN`], the value column [`RLE`] and [`PLAIN`] — and the encoder writes
+//! the **shorter** of the two payloads. When both come out the same length, the encoding with the
+//! **lower tag** wins, which is [`PLAIN`]. That rule is the whole of the format's freedom: given the
+//! same records, the bytes are the same on every machine, and the golden vector is the proof.
+//!
+//! The rule is about the encoded payload, never about what a compressor would do with it: choosing
+//! an encoding by compressing all of them would make the bytes depend on the `zstd` release, and a
+//! format whose bytes move under a dependency upgrade is a format nobody can pin.
+//!
+//! # The values that break a careless encoder
+//!
+//! * **A delta that does not fit.** Timestamps are milliseconds, so an `i64` reaches 292 million
+//!   years either side of the epoch — and two of them at opposite ends have a difference that is not
+//!   an `i64`. `4.7`'s own edge case is `i64::MIN` next to `i64::MAX`. The subtraction has to be
+//!   `wrapping_sub` and the addition `wrapping_add` (the zigzag varint carries the wrapped value
+//!   exactly), because plain `-` panics in a debug build and wraps silently in a release one — the
+//!   two builds writing different files is the worst answer of the three;
+//! * **A run that is not a run.** [`RLE`] groups equal values, and `f64`'s `==` is not equality of
+//!   bits: it calls `-0.0` and `0.0` equal (so the sign of a zero is lost) and never calls `NaN`
+//!   equal to itself (so a constant `NaN` series never collapses). The comparison here is on
+//!   `to_bits()`, which is also the only route that carries `±inf` and a `NaN` payload through
+//!   unchanged.
+//!
+//! # Errors
+//!
+//! None of this file's calls can fail: a `Vec` of bytes is not a place failures come from. Reading
+//! the block back is [`super::decode`]'s, and that one can fail in every way a file can.
+
+use crate::engine::segment::COLUMNS;
+use crate::protocol::batch::Record;
+
+/// The columns of a segment, in the order the column block writes them.
+///
+/// The order is part of the format: a reader that wants the values still walks the series column and
+/// the timestamp column's framing to find them, and a file whose columns are in another order is not
+/// this build's segment (`lakelet/4.11-query-engine` is where that walk becomes a query plan's
+/// business).
+pub const ORDER: [&str; COLUMNS as usize] = ["series", "timestamp", "value"];
+
+/// Bytes of the tag in front of every column: which encoding it uses.
+pub const TAG: usize = 1;
+
+/// The length in front of every column's payload, and every count inside one: `u32`, little endian.
+pub const LENGTH: usize = 4;
+
+/// The length in front of a series name: a `u16`, little endian.
+pub const NAME: usize = 2;
+
+/// Bytes of framing a column occupies before its payload.
+pub const FRAME: usize = TAG + LENGTH;
+
+/// The record count in front of the columns: eight bytes, little endian.
+///
+/// Every column has to add up to this number ([`crate::engine::segment::decode`]), which is what
+/// makes the three streams one block instead of three files that happen to be next to each other.
+pub const COUNT: usize = 8;
+
+/// Tag 0: the values one after another, at their own width. The encoding every column speaks, and
+/// the winner of a tie.
+pub const PLAIN: u8 = 0;
+
+/// Tag 1: `u32` runs, then per run a `u32` length and one value. The value column's encoding, and
+/// the reason a constant series costs twelve bytes instead of eight kilobytes.
+pub const RLE: u8 = 1;
+
+/// Tag 2: an `i64` first timestamp, then one zigzag varint per step (the difference from the
+/// timestamp before it, `wrapping_sub`, `(d << 1) ^ (d >> 63)`, seven bits per byte, high bit set on
+/// every byte but the last). The timestamp column's encoding, and the reason an hour of one-second
+/// samples is not eight bytes each.
+pub const DELTA: u8 = 2;
+
+/// Tag 3: `u32` names, then for each `u16` length and UTF-8 bytes, then `u32` runs of `u32` length
+/// and `u32` entry index. The series column's encoding, and the reason the same series repeated
+/// costs one byte a sample instead of the name again.
+pub const DIC: u8 = 3;
+
+/// The column block of `records`: every record, laid out by column, uncompressed.
+///
+/// This is the function the format is: given the same records it answers the same bytes, which is
+/// what the golden vector pins and what `docs/format.md` describes. The decoder's inverse is
+/// [`crate::engine::segment::decode::records`].
+#[must_use]
+pub fn column_block(records: &[Record]) -> Vec<u8> {
+    let _ = records;
+    todo!("step lakelet/4.7-columnar-segments")
+}
