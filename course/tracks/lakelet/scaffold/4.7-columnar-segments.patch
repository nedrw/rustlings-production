@@ -0,0 +1,235 @@
+//! The size budget's harness for `lakelet/4.7-columnar-segments`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.7-columnar-segments
+//! --slow` runs, and the counts it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.7-columnar-segments.toml`.
+//!
+//! What it measures is **bytes, never the clock**: how much a segment costs for a workload whose
+//! shape is counted as well, so that a small file cannot come from a workload that had nothing in
+//! it. A byte count is the same number on a loaded machine as on an idle one, which is why `kiln`'s
+//! budget gate compares counts (`handoff M2 §1.1`) and why no run of this file can flake because
+//! something else was compiling. `cargo test -p lakelet --test budget_segments -- --nocapture`
+//! prints the lines by hand; the `lakelet-budget` prefix is what the gate reads.
+//!
+//! Two workloads, because one shape cannot say what the encoding is for:
+//!
+//! * **a block of telemetry** — many series, each with its own run of consecutive timestamps and
+//!   values that hold still for a while. This is what a flush of an ingest batch looks like, and it
+//!   is the shape the counts are taken on;
+//! * **a flat line** — one series, one timestamp, one value, repeated. Nothing about it is
+//!   redundant in the *rows*, and everything about it is redundant in the *columns*, which is the
+//!   encoding's whole claim stated as a number. Its metric is the column block and not the file on
+//!   purpose: a compressor would have made the rows small too, so the file would not say whether the
+//!   encodings did anything.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness a learner can break by editing their own fixture would judge the
+//! fixture instead of the segment.
+
+use std::path::PathBuf;
+
+use lakelet::engine::segment;
+use lakelet::engine::segment::encode;
+use lakelet::protocol::batch::Record;
+
+/// Records in each workload.
+const SAMPLES: usize = 1024;
+
+/// Series the block workload spreads them over.
+const SERIES: usize = 8;
+
+/// Distinct values the block workload's value column holds, cycled through.
+const VALUES: usize = 16;
+
+/// How many samples in a row share one value, which is what a run-length column is for.
+const RUN: usize = 16;
+
+/// Milliseconds between two samples of one series: a clock that advances by a nearly constant step.
+const STEP: i64 = 1000;
+
+/// The first timestamp of every series, so the workload is the same on every machine.
+const EPOCH: i64 = 1_700_000_000_000;
+
+/// The name of one series: a metric and its labels, as a client writes them.
+fn name(series: usize) -> String {
+    format!("cpu,host=h{series}")
+}
+
+/// A block of telemetry: `SAMPLES` records over `SERIES` series, in the order a flush writes them.
+///
+/// Series-major — one series' whole run of samples, then the next — which is what makes the series
+/// column long runs of one id instead of an id alternating with every record. The value within a
+/// series steps every [`RUN`] samples, so the value column has runs a run-length encoding can
+/// collapse, and the timestamps advance by [`STEP`] with one backward jump at each series boundary:
+/// the two shapes a delta encoding has to get right.
+fn block() -> Vec<Record> {
+    let per_series = SAMPLES / SERIES;
+    let mut records = Vec::with_capacity(SAMPLES);
+    for series in 0..SERIES {
+        for index in 0..per_series {
+            records.push(Record {
+                series: name(series),
+                ts_millis: EPOCH + index as i64 * STEP,
+                value: ((index / RUN) % VALUES) as f64,
+            });
+        }
+    }
+    records
+}
+
+/// The same number of records with nothing redundant in them: one series, one timestamp, one value.
+fn flat() -> Vec<Record> {
+    (0..SAMPLES)
+        .map(|_| Record {
+            series: name(0),
+            ts_millis: EPOCH,
+            value: 1.5,
+        })
+        .collect()
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the segment is written.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path =
+            std::env::temp_dir().join(format!("lakelet-segment-{label}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the segment of this workload goes.
+    fn file(&self) -> PathBuf {
+        self.path.join("segment")
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// What one workload cost, counted.
+struct Measured {
+    /// Bytes of the column block: what the encodings produced, before anything compresses it.
+    block: u64,
+    /// Bytes of the segment file: the header, the compressed block and the seal.
+    file: u64,
+    /// Records that came back out of the file.
+    read: u64,
+    /// Records that did not come back, or that came back as something else.
+    mismatches: u64,
+}
+
+/// Write `records` as a segment in a directory of its own, read it back, and count what it cost.
+///
+/// The two failures that are the learner's are counted rather than raised: a segment that cannot be
+/// written or read leaves `read` at zero and every record a mismatch, which the budget gate reports
+/// as the count that moved — a harness that panicked instead would have its numbers read as missing.
+fn measure(label: &str, records: &[Record]) -> Measured {
+    let directory = Dir::new(label);
+    let file = directory.file();
+    let block = encode::column_block(records).len() as u64;
+    if let Err(error) = segment::write(&file, records) {
+        eprintln!("the segment of {label} could not be written: {error}");
+        return Measured {
+            block,
+            file: 0,
+            read: 0,
+            mismatches: records.len() as u64,
+        };
+    }
+    let file_bytes = std::fs::metadata(&file).map_or(0, |metadata| metadata.len());
+    let read = match segment::read(&file) {
+        Ok(read) => read,
+        Err(error) => {
+            eprintln!("the segment of {label} could not be read: {error}");
+            return Measured {
+                block,
+                file: file_bytes,
+                read: 0,
+                mismatches: records.len() as u64,
+            };
+        }
+    };
+    let mismatches = read
+        .iter()
+        .zip(records)
+        .filter(|(read, written)| !same(read, written))
+        .count() as u64;
+    let missing = records.len().saturating_sub(read.len()) as u64;
+    Measured {
+        block,
+        file: file_bytes,
+        read: read.len() as u64,
+        mismatches: mismatches + missing,
+    }
+}
+
+/// `true` when a record came back exactly as it went in — every bit of the value included, because
+/// `-0.0` and `NaN` are values this step's own edge cases are about.
+fn same(read: &Record, written: &Record) -> bool {
+    read.series == written.series
+        && read.ts_millis == written.ts_millis
+        && read.value.to_bits() == written.value.to_bits()
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+/// One ratio line, to four decimals — a ratio of two counts, so it is as steady as they are.
+fn ratio(name: &str, value: f64) {
+    println!("lakelet-budget {name}={value:.4}");
+}
+
+#[test]
+fn the_segment_size_budget() {
+    let telemetry = block();
+    let measured = measure("block", &telemetry);
+
+    // The flat line: one series, one timestamp, one value, repeated. Its rows have no redundancy at
+    // all and its columns have nothing else, which is the claim the encodings make — taken before
+    // the compressor so that the number is about the encodings.
+    let flat = flat();
+    let flat_measured = measure("flat", &flat);
+
+    // What the workload was, so a small file cannot come from an empty one: the shape is counted,
+    // and so is the answer that every record of both workloads came back out of its file.
+    metric("samples", telemetry.len() as u64);
+    metric("series", SERIES as u64);
+    metric("distinct_values", VALUES as u64);
+    metric("samples_read", measured.read + flat_measured.read);
+    metric(
+        "mismatches_max",
+        measured.mismatches + flat_measured.mismatches,
+    );
+
+    // The size itself, at both layers: what the encodings produced and what the file weighs. An
+    // upper bound either way, so a cheaper encoding — a run-length of the deltas, a dictionary for
+    // the values — passes and only a bigger one fails.
+    metric("column_block_bytes_max", measured.block);
+    metric("segment_bytes_max", measured.file);
+    // The number this step exists for, in the unit that survives a change of workload: bytes on the
+    // device per sample stored.
+    ratio(
+        "bytes_per_sample_max",
+        measured.file as f64 / telemetry.len() as f64,
+    );
+    // And what the compressor bought: the file over the column block it came from.
+    ratio(
+        "compression_ratio_max",
+        measured.file as f64 / measured.block.max(1) as f64,
+    );
+    // The flat line's columns, which is where the encodings have to answer for themselves.
+    metric("flat_column_block_bytes_max", flat_measured.block);
+}
