+    ///
+    /// A directory that holds no manifest is a store that has closed no segment yet, and this
+    /// answers the empty manifest for it, exactly as an open does. What it does *not* do is look
+    /// at the segments: [`Manifest::load`] is this door plus that check.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Protocol`] when the file is not a manifest this build wrote, and [`Error::Store`]
+    /// when the directory cannot be read.
+    pub fn read(directory: &Path) -> Result<Self, Error> {
