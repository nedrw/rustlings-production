index 0000000..7d1ffcd
--- /dev/null
+++ b/src/engine/backup/manifest.rs
@@ -0,0 +1,433 @@
+//! The copy's own manifest: what a copy holds, written as a **log**.
+//!
+//! Step `lakelet/4.19-backup-restore`. A copy is a directory an operator moves, and the file that
+//! makes it a *copy* rather than a pile of bytes is `<copy>/backup.manifest` ([`FILE`]): one entry
+//! per file the copy took, appended in the order the files were written. What that file is made of
+//! is deliberately not a format of this step's own: it is **`lakelet/4.4-wal-recovery`'s log**, byte
+//! for byte — [`segment::introduce`] for its first entry, [`segment::encode`] for every later one,
+//! [`segment::scan`] to read it back — and the reason is the same property a store's log has:
+//!
+//! * **a copy that was interrupted mid-entry recovers exactly like a store does.** The manifest is
+//!   not rewritten when a file is added to it, it is *appended to*, so a machine that stops while an
+//!   entry is half written leaves a torn tail. [`segment::scan`] proves the prefix of whole records,
+//!   reports the bytes it could not prove, and says where it stopped (`Stop`); [`Manifest::load`]
+//!   therefore answers the entries that were completed plus `discarded` bytes and the `Stop`, which
+//!   is the same answer `lakelet/4.4-wal-recovery` gives about a store's log — one reader, one set of
+//!   answers, and no second format for somebody to get wrong;
+//! * **"the manifest says what is complete" is an ordering, not a claim.** A copy writes a file's
+//!   bytes, waits for the device (`sync_all`), and only then appends the entry that names it — so an
+//!   entry that is *there* names a file whose bytes were on the device when it was written, and a
+//!   file whose entry never arrived is a file the copy does not claim. That is what lets a restore
+//!   read the manifest and know, without looking at the copy again, what it may write;
+//! * **the length is covered by the seal.** Why that matters, and what a manifest that dropped the
+//!   length field would be worth, is [`lakelet/4.4-wal-recovery`'s argument](crate::engine::wal::checksum)
+//!   about a store's own records: a reader of a log has to decide where a record *ends* from the
+//!   bytes in front of it, on a file a crash may have cut in the middle of one.
+//!
+//! # What one entry says, byte for byte
+//!
+//! One entry is one copied file, encoded as explicit bytes — no serialization crate, no version
+//! negotiation, one layout a reader can check by hand:
+//!
+//! ```text
+//!  0        `kind`: one byte — 1 the store's own manifest, 2 a segment, 3 the log
+//!  1..5     u32, little endian: how many bytes the name takes
+//!  5..5+n   the name: UTF-8, relative to the store's root — `segments.manifest`,
+//!             `segments/0000000007.lks`, `ingest.log`
+//!  then     u64, little endian: how many bytes the file holds
+//!  then     u64: how many records the file states, or `NONE` where it states none
+//!  then     u64: the earliest millisecond it states, or `NONE`
+//!  then     u64: the latest millisecond it states, or `NONE`
+//!  then     u64: the store's epoch, or `NONE`
+//!  then     u64: the store's floor, or `NONE`
+//!  then     u32, little endian: the crc32 of the file's bytes
+//! ```
+//!
+//! Three choices in that layout are worth their reasons:
+//!
+//! * **the checksum is over the file's bytes**, computed with `crc32fast` — the same checksum family
+//!   a store's log and a segment already use — so a file that was shortened, or that has one byte
+//!   the writer did not send, is caught *before* a restore writes anything. A copy nobody verified
+//!   is not a backup, and [`super::restore`] is where that judgement is made;
+//! * **the record count and the time range are optional, because most files do not state them.** A
+//!   segment's entry states what the store's own index states about it — how many records it holds,
+//!   and the span they cover (`lakelet/4.9-retention`) — and the log's entry states the records a
+//!   replay proved. The store's own manifest states neither (`lakelet/4.8-compaction`'s index is the
+//!   file list, not a record count), which is why the two fields are `NONE` there — and where the
+//!   two numbers the *store* states go instead: its **epoch** and its **floor**. That one file is
+//!   the store, so the entry that carries it carries the two numbers that say *which* store a copy
+//!   was taken of, and a restore can state them without parsing the store's index and without
+//!   opening a directory that a half-written copy has not made into a store yet;
+//! * **`NONE` is one value for every field that may be absent**: `u64::MAX`, the millisecond no
+//!   record can have (`lakelet/4.9-retention`'s `NO_RANGE`), which is also a count no file can hold.
+//!   The entry therefore stays one width, decoding it needs no second shape, and nothing in a copy
+//!   claims a number nobody wrote.
+//!
+//! Nothing here counts, prints or repairs: [`Manifest::load`] hands back what the file proves, and
+//! the copy, the restore and the operator's tool are what decide what to do about it.
+
+use std::path::{Path, PathBuf};
+
+use crate::engine::wal::checksum;
+use crate::engine::wal::segment::Stop;
+
+use super::{Damage, Error};
+
+/// The copy's own manifest, at the top of the copy's directory.
+pub const FILE: &str = "backup.manifest";
+
+/// The four bytes in front of every entry this build writes.
+///
+/// The magic and the version are the log's, not this file's: an entry's payload is opaque to
+/// [`segment::scan`], so what makes a copy's manifest *this build's* copy manifest is the codec
+/// below — and the codec's first field is the kind of file the entry is about, which is a byte no
+/// other version of it can silently claim.
+const KIND_MANIFEST: u8 = 1;
+/// A segment: `<store>/segments/<ordinal>.lks`.
+const KIND_SEGMENT: u8 = 2;
+/// The write path's log: `<store>/ingest.log`.
+const KIND_LOG: u8 = 3;
+
+/// The bytes a name's length takes in front of it.
+const NAME_LENGTH: usize = 4;
+
+/// The number no entry can state: a millisecond no record can have, and a count no file can hold.
+///
+/// One sentinel for every optional field, for the reason `lakelet/4.9-retention` gave its own pair
+/// one value: the entry keeps one width, decoding it needs no second shape, and nothing in a copy
+/// claims a number nobody wrote.
+pub(crate) const NONE: u64 = u64::MAX;
+
+/// The bytes an entry has besides its name: the kind, the length, six numbers and the checksum.
+const FIXED: usize = 1 + NAME_LENGTH + 6 * 8 + checksum::LEN;
+
+/// What one entry is about: the three kinds of file a copy takes, and no fourth.
+///
+/// The kind is not decoration. `lakelet/4.8-compaction`'s rule is that the manifest *is* the store,
+/// so an entry for the store's own manifest is the commit point of a restore and is written last
+/// ([`super::restore`]); an entry for a segment is a file whose records a restored store will answer
+/// with; and an entry for the log is the history the store's ledger is rebuilt from
+/// (`lakelet/4.18-cardinality-cost`). A reader that could not tell them apart could not restore.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// `<store>/segments.manifest` — the file that makes the directory a store.
+    Manifest,
+    /// `<store>/segments/<ordinal>.lks` — one closed segment.
+    Segment,
+    /// `<store>/ingest.log` — the write path's log.
+    Log,
+}
+
+impl Kind {
+    /// The kind, as a report or a page spells it: `manifest`, `segment`, `log`.
+    #[must_use]
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Manifest => "manifest",
+            Self::Segment => "segment",
+            Self::Log => "log",
+        }
+    }
+
+    /// The byte this kind is in an entry.
+    const fn code(self) -> u8 {
+        match self {
+            Self::Manifest => KIND_MANIFEST,
+            Self::Segment => KIND_SEGMENT,
+            Self::Log => KIND_LOG,
+        }
+    }
+
+    /// The kind a byte is, or `None` when it is no kind this build writes.
+    const fn of(code: u8) -> Option<Self> {
+        match code {
+            KIND_MANIFEST => Some(Self::Manifest),
+            KIND_SEGMENT => Some(Self::Segment),
+            KIND_LOG => Some(Self::Log),
+            _ => None,
+        }
+    }
+}
+
+/// One copied file, as the copy's manifest states it.
+///
+/// The numbers are the *file's* own where the file states them (`lakelet/4.9-retention` gave a
+/// segment's entry its record count and its span) and the store's where the file is the store's own
+/// manifest: see the layout in the module docs for why those two numbers are there and which entry
+/// carries them.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Entry {
+    /// The file's path relative to the store's root, `/`-separated: `segments/0000000007.lks`.
+    name: String,
+    /// What the entry is about.
+    kind: Kind,
+    /// How many bytes the file holds.
+    bytes: u64,
+    /// How many records the file states, or `None` where it states none.
+    records: Option<u64>,
+    /// The earliest and latest millisecond the file states, or `None`.
+    range: Option<(u64, u64)>,
+    /// The store's epoch and floor, stated by the entry for the store's own manifest.
+    store: Option<(u64, u64)>,
+    /// The crc32 of the file's bytes, over the whole file.
+    crc32: u32,
+}
+
+impl Entry {
+    /// One entry: a file the copy wrote whole, and what the file states about itself.
+    ///
+    /// A copy is the only caller — an entry is what a copy *names*, and nothing else in this project
+    /// writes one — so this is crate-visible rather than public, and the codec below is what makes
+    /// its bytes readable.
+    pub(crate) fn new(
+        name: impl Into<String>,
+        kind: Kind,
+        bytes: u64,
+        records: Option<u64>,
+        range: Option<(u64, u64)>,
+        store: Option<(u64, u64)>,
+        crc32: u32,
+    ) -> Self {
+        Self {
+            name: name.into(),
+            kind,
+            bytes,
+            records,
+            range,
+            store,
+            crc32,
+        }
+    }
+
+    /// The file's path relative to the store's root.
+    #[must_use]
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// What the entry is about.
+    #[must_use]
+    pub const fn kind(&self) -> Kind {
+        self.kind
+    }
+
+    /// How many bytes the file holds.
+    #[must_use]
+    pub const fn bytes(&self) -> u64 {
+        self.bytes
+    }
+
+    /// How many records the file states, or `None` where it states none.
+    #[must_use]
+    pub const fn records(&self) -> Option<u64> {
+        self.records
+    }
+
+    /// The earliest millisecond the file states, or `None`.
+    #[must_use]
+    pub const fn first_millis(&self) -> Option<u64> {
+        match self.range {
+            Some((first, _)) => Some(first),
+            None => None,
+        }
+    }
+
+    /// The latest millisecond the file states, or `None`.
+    #[must_use]
+    pub const fn last_millis(&self) -> Option<u64> {
+        match self.range {
+            Some((_, last)) => Some(last),
+            None => None,
+        }
+    }
+
+    /// The store's epoch, stated by the entry for the store's own manifest.
+    #[must_use]
+    pub const fn epoch(&self) -> Option<u64> {
+        match self.store {
+            Some((epoch, _)) => Some(epoch),
+            None => None,
+        }
+    }
+
+    /// The store's floor, stated by the same entry.
+    #[must_use]
+    pub const fn floor(&self) -> Option<u64> {
+        match self.store {
+            Some((_, floor)) => Some(floor),
+            None => None,
+        }
+    }
+
+    /// The crc32 of the file's bytes.
+    #[must_use]
+    pub const fn crc32(&self) -> u32 {
+        self.crc32
+    }
+}
+
+/// What the copy's manifest proves: the entries of its proven prefix, and what could not be read.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Loaded {
+    /// The entries whose record the log proved, in the order they were appended.
+    entries: Vec<Entry>,
+    /// Bytes of the manifest that are not part of a proved entry.
+    discarded: u64,
+    /// Why the walk stopped there.
+    stop: Stop,
+}
+
+impl Loaded {
+    /// The entries the manifest proves, in the order the copy wrote them.
+    #[must_use]
+    pub fn entries(&self) -> &[Entry] {
+        &self.entries
+    }
+
+    /// How many entries the manifest proves.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    /// `true` when the manifest proves no entry at all.
+    ///
+    /// A copy interrupted before its first file leaves exactly this, and so does a copy that was
+    /// interrupted inside its first entry: the file is there and it names nothing. It is a different
+    /// answer from [`Error::NoManifest`], which is the *absence* of a manifest — no copy here at all.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+
+    /// How many bytes of the manifest are **not** part of a proved entry.
+    #[must_use]
+    pub const fn discarded(&self) -> u64 {
+        self.discarded
+    }
+
+    /// Why the walk over the manifest stopped where it did.
+    #[must_use]
+    pub const fn stop(&self) -> Stop {
+        self.stop
+    }
+
+    /// The epoch of the store the copy was taken of, or `0` when the manifest states none.
+    ///
+    /// It is the store's own number, carried by the entry for the store's own manifest — the first
+    /// entry a copy writes — so a copy that proves no entry states no epoch, and `0` is what a
+    /// reader gets for "nothing was copied".
+    #[must_use]
+    pub fn epoch(&self) -> u64 {
+        self.entries
+            .first()
+            .and_then(Entry::epoch)
+            .unwrap_or_default()
+    }
+
+    /// The millisecond the store had forgotten up to when it was copied, or `0` when none is stated.
+    #[must_use]
+    pub fn floor(&self) -> u64 {
+        self.entries
+            .first()
+            .and_then(Entry::floor)
+            .unwrap_or_default()
+    }
+}
+
+/// The copy's manifest: the file at the top of a copy's directory, and the calls that use it.
+///
+/// A value rather than a pair of free functions because the file is the copy's own state and one
+/// type holding its directory is what keeps "where the manifest is" and "where a copied file goes"
+/// one answer: [`Manifest::file_of`] is the only place a copy derives a destination path.
+#[derive(Debug, Clone)]
+pub struct Manifest {
+    /// The copy's directory: the manifest's own parent, and the root its entries are relative to.
+    directory: PathBuf,
+}
+
+impl Manifest {
+    /// The manifest of the copy rooted at `directory`, whether or not there is one yet.
+    #[must_use]
+    pub fn of(directory: impl Into<PathBuf>) -> Self {
+        Self {
+            directory: directory.into(),
+        }
+    }
+
+    /// Where the copy is.
+    #[must_use]
+    pub fn directory(&self) -> &Path {
+        &self.directory
+    }
+
+    /// Where the manifest's own file is.
+    #[must_use]
+    pub fn path(&self) -> PathBuf {
+        self.directory.join(FILE)
+    }
+
+    /// Where the copied file called `name` goes, this copy's root below it.
+    #[must_use]
+    pub(crate) fn file_of(&self, name: &str) -> PathBuf {
+        self.directory.join(name)
+    }
+
+    /// Start a copy here: create the directory and truncate the manifest.
+    ///
+    /// *Truncate* rather than append, and that is the difference between a copy and a second copy
+    /// stacked on the first: the entries of a run are the files that run wrote, and a manifest that
+    /// kept an earlier run's entries would name files this copy never took.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Store`] when the directory cannot be created or the manifest cannot be written.
+    pub(crate) fn begin(&self) -> Result<(), Error> {
+        todo!(
+            "lakelet/4.19-backup-restore: create the copy's directory and truncate its manifest, so \
+             that the entries of a run are the files that run wrote"
+        )
+    }
+
+    /// Append one complete file's entry, and wait for the device before believing it.
+    ///
+    /// The flush is the ordering the whole design rests on: an entry that is there names a file whose
+    /// bytes were on the device when the entry was written. A manifest entry that went missing is
+    /// therefore a file the copy does not claim — and a copy that claims less than it wrote is a copy
+    /// a restore can still use.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Store`] when the manifest cannot be read, opened, written or flushed.
+    pub(crate) fn append(&self, entry: &Entry) -> Result<(), Error> {
+        let _ = entry;
+        todo!(
+            "lakelet/4.19-backup-restore: encode the entry, frame it as a record of the log — \
+             `segment::introduce` for the first one, `segment::encode` for every later one — append \
+             it, and wait for the device before believing it"
+        )
+    }
+
+    /// What the copy at `directory` says, read back.
+    ///
+    /// The walk is [`segment::scan`]'s: the entries of the proven prefix are decoded, and the bytes
+    /// after the last whole record are reported as [`Loaded::discarded`] with the `Stop` that says
+    /// what they are. An entry that decoded but says nothing this build can read — a record somebody
+    /// sealed around bytes that are not an entry — is a *damaged* copy rather than a refused walk,
+    /// and it is reported by the field it went wrong in.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::NoManifest`] when there is no manifest at all — which is a different answer from a
+    /// manifest that names nothing — [`Error::Damaged`] when the file is not a log this build wrote
+    /// or an entry is not an entry, and [`Error::Store`] when the file cannot be read.
+    pub fn load(directory: &Path) -> Result<Loaded, Error> {
+        let _ = directory;
+        todo!(
+            "lakelet/4.19-backup-restore: read the manifest, `scan` it as the log it is, decode the \
+             entries of the proven prefix, and answer them with the bytes nobody could prove and the \
+             `Stop` that says why the walk ended. A directory with no manifest at all is \
+             `Error::NoManifest`, never an empty list."
