+//! `lakeletq backup`, `lakeletq restore` and `lakeletq drill`: the operator's side of a store.
+//!
+//! Step `lakelet/4.19-backup-restore`. `lakelet/4.10-downsampling` made this tool's contract — stdout
+//! is the answer, stderr is one sentence, the code is the failure's class, `--json` is a format and
+//! not a second command — and this module is that contract on the commands somebody runs *about* a
+//! store rather than *in* it:
+//!
+//! * **`backup --store <DIR> --to <DIR>`** copies a store into a directory of its own
+//!   ([`copy`](crate::engine::backup::copy)) and answers what it took;
+//! * **`restore --from <DIR> --to <DIR>`** puts a copy back
+//!   ([`restore`](crate::engine::backup::restore)) and answers what it wrote. It refuses a
+//!   destination that already holds a store, and it verifies the whole copy before it writes a byte,
+//!   so an operator who gets a non-zero code still has an empty directory and not a half store;
+//! * **`drill`** is the rehearsal, and it is the reason the other two are checkable: it builds a
+//!   store with the real write path, models a machine death, copies it, restores it, does the same
+//!   with a copy interrupted inside a segment, and prints what it observed — [`DRILL_LINES`] is that
+//!   output's format, written out here for the reason `lakelet/4.16-profiling` wrote its mode's into
+//!   its `USAGE`: a command's output is an interface a script *and a page* read, and an interface
+//!   that exists only in the code that produces it is one nobody can be handed.
+//!
+//! The drill asserts what it observes rather than only printing it — a restored store that does not
+//! answer what its source answered fails the command — and the counts it prints are the ones those
+//! assertions were made of, so a reader can check the claim instead of trusting the exit code.
+//!
+//! # What is yours here
+//!
+//! The three bodies below. Everything they need from the command line already exists: the flags
+//! arrive as `flags` and `--json` as `json` (`lakelet/4.10-downsampling`'s dispatch takes the format
+//! flag out of the line before a command sees it), and `Outcome` is the answer — one value holding
+//! the code, stdout and stderr, so a command cannot print half an answer and then fail.
+//!
+//! Two rules come with it, and both are the tool's and not this file's (`jobq/3.15-cli-contract`):
+//! a **caller mistake is answered before a store is opened** (`2`), and a refusal writes *nothing* on
+//! standard output — a script that pipes this tool into a parser is never handed half an answer.
+//!
+//! The dispatch arm, the `USAGE` lines and the failure class each command leaves are not yours:
+//! they are in `src/cli/mod.rs`, where every command in this tool is named.
+
+use super::Outcome;
+
+/// The variable that adds the one timing line the drill can print.
+///
+/// An environment variable rather than a flag, because it is not a *choice about the drill*: it is
+/// the difference between the run a page quotes (no clock at all, so the same bytes on any machine)
+/// and the run a person measures on their own.
+pub const TIMED: &str = "LAKELET_DRILL_TIMED";
+
+/// The lines one drill prints, in the order it prints them: the format `docs/dr-drill.md` quotes.
+///
+/// `<…>` stands for a number the run produces. The last line is the one `LAKELET_DRILL_TIMED` adds;
+/// nothing else in a drill's output may depend on a clock, because the block a page carries is
+/// compared line for line with a fresh run.
+pub const DRILL_LINES: &str = "\
+write_policy=<name>          the durability policy the drill's own store ran
+source_files=<n>             files a complete copy of that store takes
+source_records=<n>           records its segments answer with
+source_digest=<digest>       over those records, in the order the store answers them
+rpo_bytes=<n>                bytes the modelled machine death took off the log
+rpo_records=<n>              the records those bytes carried
+copy_files=<n>               files anything was written for, the partial one included
+copy_entries=<n>             files the copy's own manifest names
+copy_bytes=<n>               bytes of file contents the copy wrote
+copy_records=<n>             records the segments it named hold, from the store's index
+copy_log_bytes=<n>           bytes of the log's proven prefix it took
+copy_log_records=<n>         the payloads that prefix holds
+copy_interrupted=<bool>      whether the copy stopped before the store was done
+restored_files=<n>           files the restore wrote
+restored_bytes=<n>           what they cost together
+restored_records=<n>         records the segments it wrote hold
+restored_log_records=<n>     payloads its log proves
+restored_digest=<digest>     over the records the restored store answers with
+records_missing=<n>          records the copy did not name
+half_files=<n>               the same for a copy interrupted inside a segment
+half_entries=<n>
+half_interrupted=<bool>
+half_records=<n>
+half_restored_files=<n>
+half_records_missing=<n>
+half_store_opens=<bool>      whether a store opens the directory that restore wrote
+agreed=<bool>                whether every claim above held
+restore_millis=<n>           only under LAKELET_DRILL_TIMED: the drill's own restore, in milliseconds
+";
+
+/// `lakeletq backup --store <DIR> --to <DIR>`: copy a store, and answer what was taken.
+#[must_use]
+pub fn backup(flags: &[&str], json: bool) -> Outcome {
+    let _ = (flags, json);
+    todo!(
+        "lakelet/4.19-backup-restore: read `--store` and `--to`, refuse a store that is not there \
+         before opening anything, copy it with `Interruption::None`, and print the report as the \
+         `name=value` lines `lakeletq --help` states — or as the same object under `--json`"
+    )
+}
+
+/// `lakeletq restore --from <DIR> --to <DIR>`: put a copy back, and answer what was written.
+#[must_use]
+pub fn restore(flags: &[&str], json: bool) -> Outcome {
+    let _ = (flags, json);
+    todo!(
+        "lakelet/4.19-backup-restore: read `--from` and `--to`, restore, and print the outcome as \
+         its `name=value` lines — or as the same object under `--json`. A damaged copy and a \
+         destination that already holds a store are refusals, and a refusal answers nothing on \
+         stdout"
+    )
+}
+
+/// `lakeletq drill [--store <DIR>]`: rehearse a backup and a restore, and answer what was observed.
+///
+/// The store is built by the drill itself, so that the command is a *rehearsal* rather than a report
+/// about somebody's store: a reader can run it on any machine and compare the answer with the block
+/// `docs/dr-drill.md` carries. `--store` names where that store is built; everything else the drill
+/// writes goes into a directory of this process's own and is removed when it ends.
+#[must_use]
+pub fn drill(flags: &[&str], json: bool) -> Outcome {
+    let _ = (flags, json);
+    todo!(
+        "lakelet/4.19-backup-restore: build a store with the real write path, model a machine death \
+         by cutting the log back to what the device was told about, copy it, restore it, do the same \
+         for a copy interrupted inside a segment, and print `DRILL_LINES` with the numbers that run \
+         produced — `restore_millis` only when the environment asks for it"
+    )
+}
