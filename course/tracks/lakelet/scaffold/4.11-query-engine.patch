+    /// half. It is the bound a caller sizes memory with, and the executed count beside it —
+    /// `rows_scanned` — is the number of records that were really read.
+    #[must_use]
+    pub const fn records(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many windows the range touches on the grid the query asked for.
+    #[must_use]
+    pub const fn windows(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many series the answer may cover, or `None` when the grammar asked for no bound.
+    #[must_use]
+    pub const fn limit(&self) -> Option<u64> {
+        todo!()
+    }
+
+    /// The metric `FROM` named.
+    #[must_use]
+    pub fn metric(&self) -> &str {
+        todo!("lakelet/4.11-query-engine: the metric `FROM` named")
+    }
+
+    /// The series name the grammar can spell: the metric, then the predicates it named.
+    #[must_use]
+    pub fn series(&self) -> &str {
+        todo!("lakelet/4.11-query-engine: the series name the grammar can spell")
+    }
+
+    /// How a window's records become one number.
+    #[must_use]
+    pub const fn aggregate(&self) -> Aggregate {
+        todo!()
+    }
+
+    /// The half-open range the query is about.
+    #[must_use]
+    pub const fn range(&self) -> Range {
+        todo!()
+    }
+
+    /// How wide one bucket is.
+    #[must_use]
+    pub const fn window(&self) -> Window {
+        todo!()
+    }
+
+    /// The plan as `key = value` lines, one per fact, in the order a reader wants them.
+    ///
+    /// Deterministic on purpose: it is a value a script diffs, a ticket quotes and a reviewer
+    /// compares across two runs, so the keys are always all present — `limit = none` rather than a
+    /// missing line — and the numbers are the ones the manifest states.
+    #[must_use]
+    pub fn explain(&self) -> String {
+        todo!(
+            "lakelet/4.11-query-engine: the plan as `key = value` lines, one per fact, with every key always present"
+        )
+    }
+}
