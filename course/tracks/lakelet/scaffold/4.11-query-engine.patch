+//! The query text as tokens, and the shape of a refusal.
+//!
+//! Step `lakelet/4.11-query-engine`. A query arrives as a *string* — a flag, an argument, a line
+//! an operator typed — and everything after this module works on a list of tokens instead, because
+//! "what the reader wrote" and "what the grammar has" are two different questions and mixing them
+//! is how a parser ends up with a hundred lines of `chars().peekable()` in each clause.
+//!
+//! # What a token is, and what it deliberately is not
+//!
+//! There are four of them ([`Kind`]): a **word**, a **number**, a `'…'` **value**, and the four
+//! symbols `(` `)` `,` `=`. Whitespace separates and is otherwise nothing — a query may be written
+//! on one line or broken across five, and the difference never reaches the grammar.
+//!
+//! The one decision worth arguing is that **a keyword is not a token**. Nothing here knows the
+//! word `SELECT`; the parser asks a word whether it *spells* something ([`Token::spells`]) at the
+//! one place in the grammar where that word is expected, and ignores it everywhere else. That is
+//! what keeps a name from ever being unreachable: a client may ingest a metric called `ts`, and
+//! `FROM ts` has to be able to name it, which a lexer with reserved words could not do without a
+//! quoting rule nobody would remember. The price is that case folding happens where the grammar
+//! compares and nowhere else — `SELECT` and `select` are the same word to the parser, and a
+//! *name* is compared exactly as it was written (`lakelet/4.10-downsampling` made the same choice
+//! for the series filter).
+//!
+//! # Why the refusal type lives here
+//!
+//! [`Refusal`] is one type for every way a query can be turned down — a byte nobody can read, a
+//! clause that is missing, an aggregate that does not exist, a range the store cannot answer, a
+//! metric it has never held — and the command line asks it one question ([`Refusal::class`]),
+//! because a script branches on the exit code rather than on the sentence. It is *here* rather
+//! than in a file of its own for one reason: the scanner is the first thing that can refuse a
+//! query, so a reader following `lex`'s error path arrives at the type's definition instead of at
+//! a jump. Every later stage answers with the same type, which is what makes the class a property
+//! of the refusal rather than of the stage that produced it (`err/typed-errors@design`).
+
+use std::iter::Peekable;
+use std::str::CharIndices;
+
+/// One token of a query, and the byte it started at.
+///
+/// The offset is what makes a refusal actionable: "an unterminated value" sends a reader back to
+/// the whole query, and "an unterminated value at byte 41" sends them to the character. It is a
+/// byte offset rather than a character column because a byte offset is what slices a `&str` and
+/// what a `grep -b` counts, and because a query text is rarely non-ASCII while a *series* can be.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Token {
+    /// The byte this token starts at, counted from the start of the query.
+    at: usize,
+    /// What was read.
+    kind: Kind,
+}
+
+/// What one token is.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Kind {
+    /// A word: a keyword, a metric, a tag key, a unit, or a name an aggregate is looked up by.
+    /// Whitespace, a symbol and a quote end it, and nothing else does.
+    Word(String),
+    /// A run of digits, as the number it names. A run too large for a `u64` is refused rather than
+    /// truncated: a millisecond count wraps, and a wrapped range is an answer about another time.
+    Number(u64),
+    /// A `'…'` value: the bytes between the quotes, with nothing changed and no escape rule. A
+    /// value therefore cannot contain a quote, which is the price of a lexer that reads a value by
+    /// looking for the next one — the alternative (`''` for a literal quote) is a rule nobody
+    /// guesses right.
+    Text(String),
+    /// One of the four symbols the grammar has: `(` `)` `,` `=`.
+    Symbol(char),
+}
+
+impl Token {
+    /// The byte this token starts at, counted from the start of the query.
+    #[must_use]
+    pub const fn at(&self) -> usize {
+        todo!()
+    }
+
+    /// What was read.
+    #[must_use]
+    pub const fn kind(&self) -> &Kind {
+        todo!()
+    }
+
+    /// `true` when this token is the word `keyword`, whatever case it was written in.
+    ///
+    /// This is the whole of "keywords are case-insensitive": there is no reserved word, only a
+    /// place in the grammar that accepts one word and asks this question to find out.
+    #[must_use]
+    pub fn spells(&self, keyword: &str) -> bool {
+        todo!(
+            "lakelet/4.11-query-engine: a keyword is compared without case, and only where the grammar expects one"
+        )
+    }
+}
+
+/// Why a query was refused, and which exit code that refusal is.
+///
+/// One variant per thing a reader can be told, because the variant is what a caller branches on
+/// and a `String` is not a branch: `Syntax` is the query text itself, `Aggregate`/`Disjunction`/
+/// `Limit` are the three clause shapes this grammar does not have, `Forgot` is a range the store
+/// cannot answer, `Unknown` is a name it has never held, and `Store` is the store's own refusal.
+///
+/// Every refusal that is about *where* in the text carries the byte offset it is about; the three
+/// that are about the store rather than about the text do not, because there is nothing in the
+/// query to point at — the sentence names what is actually wrong.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum Refusal {
+    /// The text is not a query: a `'…'` that never closes, a run of digits this store cannot
+    /// state, a clause that is missing, repeated or out of order, or a word where another was
+    /// expected.
+    #[error("at byte {at}, {detail}")]
+    Syntax {
+        /// Where the reader should look.
+        at: usize,
+        /// What is wrong with it, phrased for the person who typed the query.
+        detail: String,
+    },
+
+    /// The name after `SELECT` is not one of the five aggregates.
+    ///
+    /// A near miss that quietly answered something else would be a query that returns a plausible
+    /// number for a question nobody asked (`lakelet/4.10-downsampling` refuses `--agg average` for
+    /// the same reason), so the name is refused and the five are named.
+    #[error(
+        "at byte {at}, `{name}` is not an aggregate: they are `count`, `sum`, `mean`, `min` and `max`"
+    )]
+    Aggregate {
+        /// The name that was written.
+        name: String,
+        /// Where it was written.
+        at: usize,
+    },
+
+    /// `OR`, which this grammar does not have.
+    ///
+    /// Not a taste: `OR` is the one clause whose presence changes what a plan may prune, because a
+    /// record that satisfies either half of a disjunction cannot be ruled out by a predicate that
+    /// only one half of it matches. `lakelet/4.14-index-pruning` is where that argument is made in
+    /// full; this step is where the grammar declines to have the problem.
+    #[error(
+        "at byte {at}, `OR` is not part of this grammar: predicates are joined with `AND`, and every one of them has to hold"
+    )]
+    Disjunction {
+        /// Where the `OR` was written.
+        at: usize,
+    },
+
+    /// `LIMIT` where there is nothing it could bound.
+    #[error("at byte {at}, {detail}")]
+    Limit {
+        /// Where the `LIMIT` was written.
+        at: usize,
+        /// Which of the two shapes it is.
+        detail: String,
+    },
+
+    /// The range reaches below the store's floor: the store cannot answer it, and says so.
+    ///
+    /// `lakelet/4.9-retention` deletes whole segments and writes down how far it has forgotten.
+    /// `lakelet/4.10-downsampling` answers such a query with what is left — the answer simply
+    /// begins later than the caller asked — and this step is where the *grammar* refuses instead,
+    /// because a range is a question and a question the store has forgotten the beginning of is
+    /// worth one sentence rather than a shorter answer nobody notices.
+    #[error(
+        "the store has forgotten everything before {floor}, and this query asks from {from}: what it still answers begins at the floor"
+    )]
+    Forgot {
+        /// The first millisecond the query asked to read from.
+        from: u64,
+        /// The millisecond the store has forgotten up to.
+        floor: u64,
+    },
+
+    /// The metric is one this store has never held.
+    ///
+    /// This is the refusal that keeps a typo from looking like a quiet fleet: `FROM cpul` over a
+    /// fleet that reports nothing is indistinguishable from a fleet that is idle, and only the
+    /// store knows which of the two it is. It is class `3` — the thing asked about is not there —
+    /// rather than the caller's class, because what is wrong is not the shape of the query.
+    #[error(
+        "`{metric}` is not a metric this store has ever held: a name the store has never seen cannot be answered for"
+    )]
+    Unknown {
+        /// The metric the query named.
+        metric: String,
+    },
+
+    /// The store could not be read: a segment that is not this build's bytes, a manifest that
+    /// disagrees with its files.
+    #[error("{detail}")]
+    Store {
+        /// What the store said, kept as the sentence it wrote.
+        detail: String,
+    },
+}
+
+impl Refusal {
+    /// The exit code the command line leaves behind for this refusal.
+    ///
+    /// The numbers are `jobq/3.15-cli-contract`'s table, and this is the query engine's side of it:
+    /// `2` for a call that is wrong (everything about the text, and a range below the floor, which
+    /// the caller could have looked up), `3` for a thing that is not there (a metric the store has
+    /// never held), `4` for a store that could not answer. `0` and `1` are not here: a refusal is
+    /// never an answer, and whether this *deployment* is broken is a question about the process,
+    /// which the command line answers before a query is read at all.
+    #[must_use]
+    pub const fn class(&self) -> u8 {
+        todo!()
+    }
+}
+
+/// Read `text` as the tokens of a query.
+///
+/// The whole of the scanner is four cases, in this order: whitespace separates and disappears; a
+/// `'` opens a value that runs to the next `'`; a digit opens a number that runs to the first
+/// character that is not one; one of `(` `)` `,` `=` is a symbol; and **anything else opens a
+/// word** that runs until a separator. Every token remembers the byte it began at, so a reader
+/// told "at byte 41" can count to it.
+///
+/// # Errors
+///
+/// [`Refusal::Syntax`] — and it is the *only* refusal this stage produces — in exactly two cases:
+/// a `'` that is never closed, and a run of digits too large for the `u64` this store states
+/// milliseconds in. Everything else is a token, including bytes nobody would write on purpose: a
+/// word is a run of characters and a byte that means nothing to this grammar is a word the
+/// *parser* refuses, with the position and the word in the sentence. That division is deliberate —
+/// the scanner knows what a token is, the parser knows what a query is, and neither guesses at the
+/// other's question.
+pub fn lex(text: &str) -> Result<Vec<Token>, Refusal> {
+    todo!(
+        "lakelet/4.11-query-engine: whitespace separates; a `'` opens a value that runs to the next `'`; a digit opens a number; one of `(` `)` `,` `=` is a symbol; anything else opens a word"
+    )
+}
+
+/// The four symbols the grammar has, or `None` for a character that is part of a word.
+fn symbol(character: char) -> Option<char> {
+    todo!("lakelet/4.11-query-engine: the four symbols the grammar has, and nothing else")
+}
+
+/// A `'…'` value that opened at `at`, with the quotes taken off.
+fn value(at: usize, characters: &mut Peekable<CharIndices<'_>>) -> Result<Token, Refusal> {
+    todo!(
+        "lakelet/4.11-query-engine: from the quote that opened it to the next one, and a value that never closes is refused at the byte it opened"
+    )
+}
+
+/// The run of digits that starts with `first` at `at`.
+fn digits(
+    at: usize,
+    first: char,
+    characters: &mut Peekable<CharIndices<'_>>,
+) -> Result<Token, Refusal> {
+    todo!(
+        "lakelet/4.11-query-engine: the run of digits as the number it names, refused when it is larger than this store's milliseconds can be"
+    )
+}
+
+/// The word that starts with `first` at `at`: everything up to the next separator.
+fn word(at: usize, first: char, characters: &mut Peekable<CharIndices<'_>>) -> Token {
+    todo!("lakelet/4.11-query-engine: a run of characters up to the next separator")
+}
