+//! The pass that answers a query, and what it cost.
+//!
+//! Step `lakelet/4.11-query-engine`. Everything before this module turned a string into a value
+//! and a value into a plan; this is the module that reads the store, and the whole of it is four
+//! steps in a fixed order:
+//!
+//! * **prune** — [`Plan::of`] decides from the manifest alone which segments the range can meet,
+//!   and the ones it prunes are not opened at all. This is the only place in this track where a
+//!   query reads *less* than the store, and the numbers ([`Outcome::segments_opened`],
+//!   [`Outcome::rows_scanned`]) are what say so;
+//! * **open and read the segments it kept**, in the manifest's order, which is the order their
+//!   records were accepted in;
+//! * **collect the series that match**: a record belongs to an answer when its metric is the one
+//!   `FROM` named *and* every predicate holds ([`Query::selects`]). That is the whole of what
+//!   `FROM` and `WHERE` mean, and it is asked once per record;
+//! * **answer each with [`downsample`]**, unchanged: one call per series for a query that groups
+//!   by series, and one call over the selected records for the answer that mixes them.
+//!
+//! # Why the aggregation is not reimplemented here
+//!
+//! A `downsample` call is cheap and the alternative is not: an executor that accumulated its own
+//! windows would be a second implementation of the grid, the partial bucket and the five
+//! aggregates, and the two would drift — `lakelet/4.10-downsampling`'s spec would still pass and a
+//! dashboard would be wrong. So the executor does no arithmetic at all beyond counting what it
+//! read, and the answer's *values* come from the pass this track already tests. The price is that
+//! a `GROUP BY series` answer walks the opened records once per series, which is a scan per series
+//! rather than one grouped scan; the benefit is that a reader has one place to look for what a
+//! `mean` is.
+//!
+//! # What the outcome is for
+//!
+//! [`Outcome`] carries the answers *and* six counts, because the three questions a caller asks
+//! after a query are all counts: what did it cost (`rows_scanned`), what did it answer with
+//! (`rows_answered`), and how much of the store did it have to touch (`segments_opened` against
+//! `segments_pruned`). They are the counters `lakelet/4.14-index-pruning` and
+//! `lakelet/4.15-budget-regression` act on, and the identities between them — what was read is at
+//! most what the plan said, and what was answered is at most what was read — are what make them
+//! worth printing.
+
+use std::collections::BTreeSet;
+
+use crate::engine::compaction::Snapshot;
+use crate::engine::query::downsample::{self, Bucket};
+use crate::engine::query::lex::Refusal;
+use crate::engine::query::parse::Query;
+use crate::engine::query::plan::Plan;
+use crate::engine::query::series::Series;
+use crate::protocol::batch::Record;
+
+/// One answer in an outcome: the series it is about, and the buckets it holds.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SeriesAnswer {
+    /// The series this answer covers, or `None` for the single answer a query without
+    /// `GROUP BY …, series` gets — the one that mixes every series the predicates select, exactly
+    /// as [`downsample`]'s `None` filter answers it.
+    series: Option<String>,
+    /// The windows that held records, oldest first.
+    buckets: Vec<Bucket>,
+}
+
+impl SeriesAnswer {
+    /// The series this answer covers, or `None` when it mixes every selected series.
+    #[must_use]
+    pub fn series(&self) -> Option<&str> {
+        todo!(
+            "lakelet/4.11-query-engine: the series this answer covers, or nothing when it mixes every selected series"
+        )
+    }
+
+    /// The windows that held records, oldest first.
+    #[must_use]
+    pub fn buckets(&self) -> &[Bucket] {
+        todo!("lakelet/4.11-query-engine: the windows that held records, oldest first")
+    }
+}
+
+/// What a query answered, and what answering it cost.
+///
+/// The six counts are the pass's own account of itself, and they are deliberately about three
+/// different things: the *plan* (`segments_opened`, `segments_pruned`), the *work* (`rows_scanned`,
+/// `rows_answered`) and the *shape* (`series_matched`, `series_answered`). A caller reads the
+/// answer and then reads these to find out what it was worth asking.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Outcome {
+    /// The answers, in the order they cover the store: by series name for a grouped query, and one
+    /// mixed answer otherwise.
+    answers: Vec<SeriesAnswer>,
+    /// How many segments this query opened: the ones the plan kept.
+    segments_opened: u64,
+    /// How many segments the plan's time range ruled out, so nothing was read from them.
+    segments_pruned: u64,
+    /// How many records were read from the segments that were opened.
+    rows_scanned: u64,
+    /// How many of them landed in a bucket of one of the answers.
+    rows_answered: u64,
+    /// How many distinct series the records that were read carried and the query selected.
+    series_matched: u64,
+    /// How many of those the answer is about: all of them for one mixed answer, and at most
+    /// `LIMIT` of them for a grouped one.
+    series_answered: u64,
+}
+
+impl Outcome {
+    /// The answers, in the order they cover the store.
+    #[must_use]
+    pub fn answers(&self) -> &[SeriesAnswer] {
+        todo!("lakelet/4.11-query-engine: the answers, in the order they cover the store")
+    }
+
+    /// How many segments this query opened.
+    #[must_use]
+    pub const fn segments_opened(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many segments the plan's time range ruled out.
+    #[must_use]
+    pub const fn segments_pruned(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many records were read from the segments that were opened.
+    #[must_use]
+    pub const fn rows_scanned(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many records landed in a bucket of one of the answers.
+    #[must_use]
+    pub const fn rows_answered(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many distinct series the records carried and the query selected.
+    #[must_use]
+    pub const fn series_matched(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many of those the answer is about.
+    #[must_use]
+    pub const fn series_answered(&self) -> u64 {
+        todo!()
+    }
+}
+
+/// Answer `query` against `snapshot`.
+///
+/// # Errors
+///
+/// [`Refusal::Forgot`] when the range reaches below the store's floor (the plan's refusal, raised
+/// before a segment is opened), [`Refusal::Unknown`] when no record read carries the metric the
+/// query named, and [`Refusal::Store`] when a segment that had to be read is not this build's
+/// bytes — a store that cannot be read is class `4` and not a wrong answer.
+///
+/// # A range the store has no segment in
+///
+/// `Unknown` is decided from the records that were *read*, so a query whose range meets no segment
+/// at all answers empty whatever was named in `FROM` — including a name this store has never held.
+/// That is the boundary of pruning made visible rather than a hole in the rule: whether a store has
+/// *ever* held a series is a question about its whole history, answering it would be the full scan
+/// that pruning exists to avoid, and the query that hits this boundary asked about a span of time
+/// the store has nothing in — where "no data" is the answer for every name at once.
+/// `lakelet/4.18-cardinality-cost` is where a store starts knowing its own names cheaply enough to
+/// answer that question instead.
+pub fn execute(snapshot: &Snapshot, query: &Query) -> Result<Outcome, Refusal> {
+    todo!(
+        "lakelet/4.11-query-engine: prune, read the segments the plan kept, collect the series that match, and answer each with `lakelet/4.10-downsampling`'s `downsample`"
+    )
+}
