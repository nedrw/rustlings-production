@@ -0,0 +1,385 @@
+//! The retention budget's harness for `lakelet/4.9-retention`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.9-retention
+//! --slow` runs, and the counts it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.9-retention.toml`.
+//!
+//! What it measures is **segments, records and bytes, never the clock**: a store of twenty-four
+//! segments is built from a fixed series and a fixed set of timestamps, one retention pass is
+//! carried out at a `now` the harness passes in, and what that cost is a set of counts — how many
+//! segments left, what they held, what the disk gave back, and what a reader answers afterwards. A
+//! count is the same number on a loaded machine as on an idle one, which is why `kiln`'s budget
+//! gate compares counts (`handoff M2 §1.1`) and why no run of this file can flake because
+//! something else was compiling. `cargo test -p lakelet --test budget_retention -- --nocapture`
+//! prints the lines by hand; the `lakelet-budget` prefix is what the gate reads.
+//!
+//! Three numbers are the ones this lane exists for, and each names a way a retention pass is
+//! wrong:
+//!
+//! * `bytes_freed_on_disk` is measured by **comparing file lengths** — the sum over the store's
+//!   segment directory before the pass, less the sum after it — rather than by trusting
+//!   `ExpireReport::bytes_reclaimed`. The two have to agree (`bytes_unaccounted_max`), and a pass
+//!   that reported bytes it did not free, or freed bytes it did not report, fails here;
+//! * `bytes_rewritten_max` is **zero**, and it is measured the same way: every file in the segment
+//!   directory that was created or changed by the pass, by content. A retention pass deletes whole
+//!   files and writes an index; the moment it rewrites a straddling segment to make its own
+//!   numbers look better, it pays exactly the write amplification `lakelet/4.8-compaction` spent a
+//!   step measuring, and this count says so;
+//! * `records_answered` against `records_counted` is the straddler's price, as two numbers: the
+//!   store's index still *counts* every record in the segments it kept — including the ones in a
+//!   segment that reaches back below the cutoff — while the read path answers only the records at
+//!   or after the floor. The difference is not a bug in either; it is the difference between what
+//!   the store holds and what it still answers, and `records_below_cutoff_max` is the half that
+//!   must be zero.
+//!
+//! The workload is deliberately **shaped so that a segment straddles the cutoff**: every segment
+//! holds ninety minutes of one series, one hour of buckets, and the policy keeps twelve and a half
+//! hours, so the cutoff is snapped down to an hour boundary that falls *inside* a segment. A
+//! workload whose segments all sat inside their own bucket would measure the easy half of the rule
+//! and never touch the segment that may neither be deleted nor rewritten.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness a learner can break by editing their own fixture would judge the
+//! fixture instead of the store.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+
+use lakelet::engine::compaction::{DIRECTORY, Segments};
+use lakelet::engine::retention::Policy;
+use lakelet::protocol::batch::Record;
+
+/// Segments the store is built from before the pass.
+const SEGMENTS: usize = 24;
+
+/// Records one sealed segment holds: ninety minutes of one series, a sample a minute.
+const PER_SEGMENT: usize = 90;
+
+/// Milliseconds between two samples of one series.
+const STEP: i64 = 60_000;
+
+/// One hour — the bucket width the policy counts in, and the width of the minutes below.
+const HOUR: i64 = 3_600_000;
+
+/// The first timestamp of every segment, on an hour boundary so the arithmetic is readable.
+///
+/// `1_699_999_200_000` is `472_222 * HOUR` exactly: every segment therefore starts on a bucket
+/// boundary and runs ninety minutes into the next one, which is what puts a straddler at the
+/// cutoff this workload is built to have.
+const EPOCH: i64 = 472_222 * HOUR;
+
+/// The `now` the pass is given: exactly [`SEGMENTS`] hours after [`EPOCH`], and passed in — this
+/// harness never reads a clock, so its counts are the same on every machine and every day.
+const NOW: u64 = (472_222 + SEGMENTS as i64) as u64 * HOUR as u64;
+
+/// What the policy keeps: twelve and a half hours, in one-hour buckets.
+///
+/// Deliberately *not* a whole number of buckets: the cutoff is `now - keep` snapped down to a
+/// boundary, so a pass at twelve and a half hours removes ten segments and leaves the eleventh
+/// straddling the boundary in the middle of it. A window of exactly twelve hours would put the
+/// cutoff on a segment's start and the straddler would not exist.
+const KEEP: u64 = 12 * HOUR as u64 + 30 * 60_000;
+
+/// The series every segment's records belong to — one name, so the bytes a segment costs are its
+/// framing and its encoding rather than a dictionary that never repeats.
+const SERIES: &str = "cpu,host=h0";
+
+/// The records one sealed segment holds: one series' window, starting at [`EPOCH`] plus one hour
+/// per segment.
+fn segment_records(index: usize) -> Vec<Record> {
+    let start = EPOCH + index as i64 * HOUR;
+    (0..PER_SEGMENT)
+        .map(|offset| Record {
+            series: SERIES.to_owned(),
+            ts_millis: start + offset as i64 * STEP,
+            value: value_of(index * PER_SEGMENT + offset),
+        })
+        .collect()
+}
+
+/// The value of sample `position`: distinct bit patterns, and no structure a column can exploit.
+///
+/// A store of temperature readings compresses; a store of latency quantiles does not, and the
+/// second one is what this lane measures. On data with structure, deleting a segment saves less
+/// than the encoding already did, and the bytes this file is about would be an argument about
+/// `zstd` instead of about what a pass removed.
+fn value_of(position: usize) -> f64 {
+    let mixed = (position as u64).wrapping_mul(2_654_435_761) % 100_003;
+    mixed as f64 / 8.0
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path =
+            std::env::temp_dir().join(format!("lakelet-retention-{label}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the store lives.
+    fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Every file in the store's segment directory, by name, as the bytes it holds.
+    ///
+    /// The disk's own answer rather than the index's: what a pass freed and what it rewrote are
+    /// questions about files, and the store's own report is one of the things being judged.
+    fn segment_files(&self) -> BTreeMap<String, Vec<u8>> {
+        let mut files: BTreeMap<String, Vec<u8>> = BTreeMap::new();
+        let entries = std::fs::read_dir(self.path.join(DIRECTORY))
+            .unwrap_or_else(|error| panic!("{} cannot be listed: {error}", self.path.display()));
+        for entry in entries.flatten() {
+            let name = entry.file_name().to_string_lossy().into_owned();
+            let bytes = std::fs::read(entry.path()).unwrap_or_else(|error| {
+                panic!("every file in the segment directory is readable: {error}")
+            });
+            files.insert(name, bytes);
+        }
+        files
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// How many bytes a set of files costs together.
+fn bytes_of(files: &BTreeMap<String, Vec<u8>>) -> u64 {
+    files.values().fold(0u64, |total, bytes| {
+        total.saturating_add(bytes.len() as u64)
+    })
+}
+
+/// How many bytes a pass wrote into the segment directory: every file that was created or changed,
+/// by content, measured against what was there before it ran.
+fn rewritten(before: &BTreeMap<String, Vec<u8>>, after: &BTreeMap<String, Vec<u8>>) -> u64 {
+    after
+        .iter()
+        .filter(|(name, bytes)| before.get(*name) != Some(*bytes))
+        .fold(0u64, |total, (_, bytes)| {
+            total.saturating_add(bytes.len() as u64)
+        })
+}
+
+/// What one pass over the store cost, counted.
+struct Counted {
+    /// Segments the store was built from.
+    sealed: u64,
+    /// Records they held.
+    records: u64,
+    /// Bytes the store's segment files cost, from their lengths, before the pass.
+    bytes_before: u64,
+    /// Segments the plan expired.
+    expired: u64,
+    /// Records that left with them, as the report counts them.
+    records_expired: u64,
+    /// Bytes the report says the store stopped holding.
+    reclaimed: u64,
+    /// Retained segments that reach below the cutoff.
+    straddling: u64,
+    /// Segments the store is made of after the pass.
+    after: u64,
+    /// Bytes its segment files cost after it, from their lengths.
+    bytes_after: u64,
+    /// Bytes of files the pass created or changed, by content.
+    rewritten: u64,
+    /// Records the index still counts in the segments the store kept.
+    counted: u64,
+    /// Records a read of the store answers after the pass.
+    answered: u64,
+    /// Records that came back older than the cutoff, which is the half that may not happen.
+    below_cutoff: u64,
+    /// The store's floor after the pass, as whole hours past [`EPOCH`].
+    floor_hours: u64,
+    /// Segments a second pass at the same `now` expired: none, or the pass wrote for nothing.
+    idle_expired: u64,
+    /// Something the store refused, counted rather than raised: a store that cannot do this is what
+    /// the gate's counts are for.
+    refused: u64,
+}
+
+/// Build the store, carry one pass out at [`NOW`], and count what it did.
+///
+/// The failures are counted rather than raised for the reason `tests/budget_compaction.rs` counts
+/// its own: this file's numbers are what a gate compares, and a harness that panicked would report
+/// nothing at all instead of the count that moved.
+fn pass() -> Counted {
+    let directory = Dir::new("budget");
+    let mut counted = Counted {
+        sealed: 0,
+        records: 0,
+        bytes_before: 0,
+        expired: 0,
+        records_expired: 0,
+        reclaimed: 0,
+        straddling: 0,
+        after: 0,
+        bytes_after: 0,
+        rewritten: 0,
+        counted: 0,
+        answered: 0,
+        below_cutoff: 0,
+        floor_hours: 0,
+        idle_expired: 0,
+        refused: 0,
+    };
+    let mut store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    for index in 0..SEGMENTS {
+        let records = segment_records(index);
+        if let Err(error) = store.seal(&records) {
+            eprintln!("segment {index} could not be sealed: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+        counted.sealed += 1;
+        counted.records += records.len() as u64;
+    }
+    let before = directory.segment_files();
+    counted.bytes_before = bytes_of(&before);
+
+    let policy = Policy::new(KEEP, HOUR as u64);
+    let cutoff = policy.cutoff(NOW);
+    let report = match store.expire(&policy, NOW) {
+        Ok(report) => report,
+        Err(error) => {
+            eprintln!("the retention pass was refused: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    counted.records_expired = report.records_expired();
+    counted.expired = report.expired().len() as u64;
+    counted.reclaimed = report.bytes_reclaimed();
+    counted.straddling = report.straddling().len() as u64;
+    counted.after = store.manifest().segments().len() as u64;
+    counted.floor_hours = store.floor().saturating_sub(EPOCH as u64) / HOUR as u64;
+
+    // The disk's own answer, and the answer to "did this pass rewrite anything": the files that
+    // are there now, against the files that were there before it ran.
+    let after = directory.segment_files();
+    counted.bytes_after = bytes_of(&after);
+    counted.rewritten = rewritten(&before, &after);
+
+    // What a read that begins after the pass answers — and what the index says it could answer.
+    let snapshot = store.snapshot();
+    counted.counted = snapshot.len();
+    match snapshot.records() {
+        Ok(read) => {
+            counted.answered = read.len() as u64;
+            counted.below_cutoff = read
+                .iter()
+                .filter(|record| record.ts_millis < cutoff as i64)
+                .count() as u64;
+        }
+        Err(error) => {
+            eprintln!("the store could not be read back: {error}");
+            counted.refused += 1;
+        }
+    }
+
+    // A second pass at the same `now`: the cutoff is the floor's, so nothing is left to expire and
+    // the store does not move. A pass that expired something here would be one whose first pass
+    // forgot what it had done.
+    match store.expire(&policy, NOW) {
+        Ok(report) => counted.idle_expired = report.expired().len() as u64,
+        Err(error) => {
+            eprintln!("a second pass at the same `now` was refused: {error}");
+            counted.refused += 1;
+        }
+    }
+    counted
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+#[test]
+fn the_retention_budget() {
+    let counted = pass();
+
+    // The shape of the store the pass was given: a store with nothing in it cannot pass a byte
+    // bound, and a `seal` that wrote the wrong number of records is caught before anything expires.
+    metric("segments_before", counted.sealed);
+    metric("records_before", counted.records);
+    metric("bytes_before", counted.bytes_before);
+
+    // What the policy expired: whole segments, the records that left with them, and the bytes the
+    // store says it stopped holding — with the straddler named, because a workload whose cutoff
+    // fell on a segment boundary would measure the easy half of this rule and nothing else.
+    metric("segments_expired", counted.expired);
+    metric("records_expired", counted.records_expired);
+    metric("bytes_reclaimed", counted.reclaimed);
+    metric("straddling", counted.straddling);
+
+    // What the disk gave back, measured by comparing file lengths rather than by trusting the
+    // report: the two agree, or one of them is wrong.
+    metric("segments_after", counted.after);
+    metric("bytes_after", counted.bytes_after);
+    metric(
+        "bytes_freed_on_disk",
+        counted.bytes_before.saturating_sub(counted.bytes_after),
+    );
+    // An upper bound of zero: a pass that rewrote a segment — a straddler folded into a new file,
+    // an old one re-encoded "to make the numbers better" — writes bytes it was supposed to stop
+    // paying for, and every one of them is counted here.
+    metric("bytes_rewritten_max", counted.rewritten);
+
+    // What the store answers, against what it still holds. `records_counted` is the index's own
+    // count of the segments that stayed, which includes the straddler's old records; the read path
+    // is what keeps them out of an answer, and this is the number that says it did.
+    metric("records_counted", counted.counted);
+    metric("records_answered", counted.answered);
+    metric("records_below_cutoff_max", counted.below_cutoff);
+
+    // Where the floor landed, counted in whole hours past the epoch: the cutoff this pass acted at,
+    // which the plan snapped down to a bucket boundary. A pass that never moved the floor, or
+    // moved it to `now`, answers a number that is not this one.
+    metric("floor_hours", counted.floor_hours);
+    // And a second pass at the same `now` expires nothing, because the floor is where the first one
+    // left it. An upper bound of zero.
+    metric("idle_expired_max", counted.idle_expired);
+
+    // The two conservation identities, as counts that must be zero: what the report says left is
+    // what the index stopped naming, and the bytes it says it freed are the bytes the disk gave
+    // back. A pass that loses or invents a segment fails one of them whatever its other numbers
+    // say.
+    metric(
+        "segments_unaccounted_max",
+        counted
+            .sealed
+            .saturating_sub(counted.expired)
+            .abs_diff(counted.after),
+    );
+    metric(
+        "bytes_unaccounted_max",
+        counted
+            .bytes_before
+            .saturating_sub(counted.reclaimed)
+            .abs_diff(counted.bytes_after),
+    );
+
+    // A store that refused something is a store this lane cannot judge by counts alone: a refusal
+    // shows up as the numbers moving, and this says why in one line.
+    metric("refused_max", counted.refused);
+}
