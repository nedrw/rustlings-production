+//! Which bucket of time a timestamp falls in: the arithmetic retention decides with, and nothing
+//! else.
+//!
+//! Step `lakelet/4.9-retention`. `lakelet/4.8-compaction` gave the store closed segments and a
+//! manifest naming them, and said what it deliberately does not decide: *which* of them may leave.
+//! A record's age is the one thing that answers it, and every record carries a timestamp — so the
+//! decision is a comparison between two numbers, but only after both have been put in the same
+//! bucket of time. This module is that arithmetic: no store, no clock, no side effect, which is
+//! what lets a cutoff be *snapped* to a boundary at one place and a test say what the boundary is
+//! instead of hoping for it.
+//!
+//! A partition is **half-open**: `[start, end)`. A timestamp that sits exactly on a boundary
+//! belongs to the bucket that starts there and not to the one before it — the same `>=`/`<` split
+//! that decides whether a segment is older than a cutoff (`super::Policy::plan`). One rule, written
+//! once: an off-by-one here deletes a millisecond of data a policy promised to keep, or keeps a
+//! bucket it promised to delete, and neither would show up as anything but a number in a report.
+//!
+//! The two numbers a partition is made of are both `u64` milliseconds, and both are supposed to be
+//! *configurations* rather than measurements: this module therefore has no clock of its own and
+//! nothing in it is a duration anybody waited for.
+
+use std::fmt;
+
+/// One bucket of `width_millis` milliseconds, and the millisecond it starts at.
+///
+/// A partition is a value: it is made from a timestamp and a width, it answers questions about
+/// them, and it holds nothing that changes. The reason it is a type rather than two numbers passed
+/// around is that a cutoff, a bucket and a width have to agree about their boundaries, and the
+/// place they agree is here.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Partition {
+    /// The first millisecond of the bucket: every timestamp in it is at or after this one.
+    start_millis: u64,
+    /// How many milliseconds the bucket covers — never zero, whatever a caller asked for.
+    width_millis: u64,
+}
+
+impl Partition {
+    /// The bucket `ts_millis` falls in, when a bucket is `width_millis` milliseconds wide.
+    ///
+    /// A width of zero is treated as one, because the alternative is a partition nothing can be in:
+    /// `Partition::contains` would answer `false` for every timestamp, including the one the
+    /// partition was made from. A misconfiguration is not a reason for a store to answer a hole,
+    /// so the narrowest bucket that exists is the one a zero asks for.
+    #[must_use]
+    pub fn of(ts_millis: u64, width_millis: u64) -> Self {
+        let _ = (ts_millis, width_millis);
+        todo!("step lakelet/4.9-retention")
+    }
+
+    /// The millisecond this bucket starts at.
+    #[must_use]
+    pub fn start(&self) -> u64 {
+        let _ = self;
+        todo!("step lakelet/4.9-retention")
+    }
+
+    /// The millisecond after this bucket's last one: buckets are half-open, `[start, end)`.
+    ///
+    /// Saturated rather than wrapped: a bucket whose width reaches past the top of what a `u64`
+    /// counts ends at the top of it, and a store configured with a width that large has bigger
+    /// problems than an arithmetic overflow.
+    #[must_use]
+    pub fn end(&self) -> u64 {
+        let _ = self;
+        todo!("step lakelet/4.9-retention")
+    }
+
+    /// How many milliseconds this bucket covers.
+    #[must_use]
+    pub fn width(&self) -> u64 {
+        let _ = self;
+        todo!("step lakelet/4.9-retention")
+    }
+
+    /// Which bucket of this width this is, counted from the epoch: `start / width`.
+    ///
+    /// The number two partitions are compared by, and the one a plan reports when it wants to say
+    /// *which* bucket a cutoff landed on rather than the millisecond it starts at.
+    #[must_use]
+    pub fn index(&self) -> u64 {
+        let _ = self;
+        todo!("step lakelet/4.9-retention")
+    }
+
+    /// `true` when `ts_millis` is this bucket's: at or after its start and before its end.
+    ///
+    /// Half-open, which is the whole of the `[start, end)` claim: the boundary timestamp is in the
+    /// bucket that begins on it, and a bucket and its neighbour never both hold one.
+    #[must_use]
+    pub fn contains(&self, ts_millis: u64) -> bool {
+        let _ = (self, ts_millis);
+        todo!("step lakelet/4.9-retention")
+    }
+}
+
+impl fmt::Display for Partition {
+    /// The bucket the way a cutoff is written in a report and a log line: `[start, end)`.
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let _ = (self, formatter);
+        todo!("step lakelet/4.9-retention")
+    }
+}
