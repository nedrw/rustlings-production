new file mode 100644
index 0000000..1644832
--- /dev/null
+++ b/tests/sim_rotation.rs
@@ -0,0 +1,574 @@
+//! The rotation schedules `lakelet/4.23-secret-rotation` is judged by: clients on both sides of a
+//! rotation, and one key that signs them.
+//!
+//! Course content — the step's scaffold ships it complete, `slow:sim@N` runs it once per seed with
+//! `KILN_SIM_SEED` set, and the gate compares the `lakelet-sim` lines below in the order they were
+//! printed. Two things are therefore strict:
+//!
+//! * **the seed decides the whole schedule.** How many clients there are, how long each one's token
+//!   lives, how many batches each one sends, *where* the rotation happens in that sequence and
+//!   which client is the late one all come out of the store's own generator
+//!   (`src/engine/rng.rs`), so the same seed runs the same schedule on every machine;
+//! * **the transcript is the schedule.** Every line is a count, a name or a digest — never a wall
+//!   clock, a path, an address, an instant since the epoch or the seed. The one instant the
+//!   arithmetic needs is printed as an offset from the scenario's own start, which is how the page
+//!   can quote a line of it and a reader can check it.
+//!
+//! # The claim, and the clock the scenario owns
+//!
+//! The central claim is one sentence: **no client that was inside its token's lifetime is refused
+//! across the rotation.** So the scenario runs the real accept loop in this process
+//! (`service::ingest::serve`, the same code a daemon runs), over real sockets, against a real store,
+//! with a ring of real files: the token check, the queue and the write path are the deployment's and
+//! not a model of it. The one clock it cannot own is the daemon's — `service::ingest` reads the
+//! machine's instant once per connection, which is the design (`lakelet/4.23-secret-rotation`'s page
+//! says why the daemon owns it) — so the scenario *places* its instants relative to one reading of
+//! that clock and never asserts anything about them: every key opens before the run starts and every
+//! token that is meant to be good is minted to have been issued in the past, so a slow machine moves
+//! no verdict. The ring's own arithmetic, which is where the interesting numbers are, is checked
+//! against instants the scenario chooses and hands in — `verify(token, now)` and
+//! `earliest_safe_retirement` take theirs as arguments, exactly so that a scenario can own them.
+//!
+//! What the transcript is *about* is therefore the thing that only a schedule can find: which key
+//! signed each client's token, how many batches came out of the other side, and that the number of
+//! clients refused for being inside their token's lifetime is zero.
+//!
+//! # The lines the gate reads
+//!
+//! * `plan` — how many clients there are, which one is late and after which client the rotation
+//!   happens;
+//! * `client` — one line per client, in the order they were served: how many batches it sent, which
+//!   key signed its token, the lifetime that token was issued with, whether it was the late one, and
+//!   how many of its batches the store took;
+//! * `rotate` — the new key arriving, and the instant the old key may leave, as an offset from the
+//!   scenario's start;
+//! * `signed` — one line per key: how many of the clients' tokens it signed;
+//! * `refused` — the number of clients refused while inside their token's lifetime (the claim), and
+//!   the number refused because their token had already expired (the contrast);
+//! * `ring` — the keys the ring holds at the end and which one is preferred;
+//! * `accepted` and `digest` — how many batches the store took, and a digest over their ids, sorted,
+//!   so two runs that accepted the same thing agree byte for byte;
+//! * `verdict` — the last line, and it is only printed once every assertion above held.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::Mutex;
+
+use lakelet::engine::Spool;
+use lakelet::engine::rng::Rng;
+use lakelet::engine::spool::FILE;
+use lakelet::engine::wal::Policy as WalPolicy;
+use lakelet::engine::wal::segment;
+use lakelet::protocol::batch::{self, Record};
+use lakelet::protocol::frame::Frame;
+use lakelet::service::backpressure::{Policy as Overflow, Queue};
+use lakelet::service::ingest;
+use lakelet::service::keys::{self, KeyId, KeyRing, Refusal, Window};
+
+/// The seed this run uses when the judge does not name one.
+const DEFAULT_SEED: u64 = 1;
+/// The variable `slow:sim@N` sets: which schedule this run takes.
+const SEED: &str = "KILN_SIM_SEED";
+/// How many frames the queue between accepting and writing may hold: enough for one client's turn,
+/// so nothing this scenario offers is ever dropped and the counts are the schedule's.
+const CAPACITY: usize = 64;
+/// The lifetimes a client's token may be issued with.
+const LIFETIMES: [u64; 3] = [30_000, 60_000, 120_000];
+/// How long the late client's token lived: expired before the run started, which is the contrast to
+/// the clients this scenario is about.
+const LATE_LIFETIME: u64 = 30_000;
+/// Where the old key's window opened, in milliseconds before the scenario's start.
+const OPENED_AGO: u64 = 300_000;
+/// When the new key's window opens, before the scenario's start: as soon as its file is on the ring
+/// it is the key with the latest `not_before`, so it is the one that signs from then on.
+const SUCCESSOR_AGO: u64 = 1_000;
+/// When the late client's token was issued and how old it is: expired 90 s before the run.
+const LATE_ISSUED_AGO: u64 = 120_000;
+/// How often a wait looks again.
+const POLL: Duration = Duration::from_millis(2);
+/// How long a wait is given before the scenario calls it a failure.
+const DEADLINE: Duration = Duration::from_secs(10);
+
+/// One client's place in the schedule, as the seed drew it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Planned {
+    /// How many batch frames this client sends.
+    batches: usize,
+    /// How long its token is issued for.
+    lifetime: u64,
+    /// Whether this is the client whose token has already expired.
+    late: bool,
+}
+
+/// The whole schedule the seed decides.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Plan {
+    /// Every client, in the order they are served.
+    clients: Vec<Planned>,
+    /// How many clients are served before the new key arrives.
+    rotation_after: usize,
+}
+
+/// The seed this process was asked for.
+fn seed() -> u64 {
+    match std::env::var(SEED) {
+        Ok(text) => text
+            .parse()
+            .unwrap_or_else(|error| panic!("{SEED}=`{text}` is not a number: {error}")),
+        Err(_) => DEFAULT_SEED,
+    }
+}
+
+/// The schedule this seed asks for.
+///
+/// Three to six clients, a rotation somewhere in the middle of them, one late client, and each
+/// client's lifetime and workload drawn from a small alphabet so that two seeds differ in *shape*
+/// and not only in a number.
+fn plan(seed: u64) -> Plan {
+    let mut rng = Rng::new(seed);
+    let clients = 3 + rng.below(4) as usize;
+    // The rotation is never before the first client and never after the last one: a scenario whose
+    // rotation happened before anybody connected would not be a rotation *across* a boundary.
+    let late = rng.below(clients as u64) as usize;
+    // At least one client *before* the new key arrives and at least one it serves *after*: a
+    // scenario whose rotation happened after the last client it serves would never say which key
+    // signs next, and one that rotated before anybody connected would not be a rotation across a
+    // boundary at all.
+    let served_after = |rotation: usize| (rotation..clients).filter(|index| *index != late).count();
+    let mut rotation_after = 1 + rng.below((clients - 1) as u64) as usize;
+    while served_after(rotation_after) == 0 {
+        rotation_after -= 1;
+    }
+    let planned = (0..clients)
+        .map(|index| Planned {
+            batches: 1 + rng.below(3) as usize,
+            lifetime: LIFETIMES[rng.below(LIFETIMES.len() as u64) as usize],
+            late: index == late,
+        })
+        .collect();
+    Plan {
+        clients: planned,
+        rotation_after,
+    }
+}
+
+/// The machine's instant, read once: every instant in the schedule is placed relative to it.
+fn wall_now() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |since| since.as_millis() as u64)
+}
+
+/// One instant of the schedule, as a millisecond older than `base` (or later, for the key that
+/// arrives during the run).
+fn at(base: u64, offset_millis: i64) -> u64 {
+    base.saturating_add_signed(offset_millis)
+}
+
+/// A xorshift-derived secret of `label`'s own, written into a key file.
+fn secret(label: &str) -> String {
+    let mut text = String::new();
+    for index in 0..32u8 {
+        let byte = label.as_bytes().iter().fold(index, |value, byte| {
+            value.wrapping_mul(31).wrapping_add(*byte)
+        });
+        text.push_str(&format!("{byte:02x}"));
+    }
+    text
+}
+
+/// Write one key file, the way `lakeletq rotate --add` writes it.
+fn plant(
+    directory: &std::path::Path,
+    id: &str,
+    secret: &str,
+    not_before: u64,
+    not_after: Option<u64>,
+) {
+    std::fs::create_dir_all(directory)
+        .unwrap_or_else(|error| panic!("{} cannot be created: {error}", directory.display()));
+    let id = KeyId::new(id);
+    let path = keys::key_file(directory, &id);
+    std::fs::write(&path, keys::render(&id, secret, not_before, not_after))
+        .unwrap_or_else(|error| panic!("{} cannot be written: {error}", path.display()));
+}
+
+/// The ring a daemon would read right now.
+fn ring(directory: &std::path::Path) -> KeyRing {
+    KeyRing::load(directory)
+        .unwrap_or_else(|error| panic!("the scenario's own ring loads: {error}"))
+}
+
+/// The batch one record of one client makes: its id is the series, so a digest over the accepted
+/// ids says *which* batches arrived and not only how many.
+fn payload(client: usize, batch: usize) -> Vec<u8> {
+    batch::encode(&[Record {
+        series: format!("rot,c={client},b={batch}"),
+        ts_millis: 1_700_000_000_000 + (client * 10 + batch) as i64,
+        value: batch as f64,
+    }])
+}
+
+/// The id a payload carries, for the digest.
+fn id_of(payload: &[u8]) -> String {
+    match batch::decode(payload) {
+        Ok(records) => records
+            .first()
+            .map(|record| record.series.clone())
+            .unwrap_or_default(),
+        Err(error) => panic!("this scenario only writes batches: {error}"),
+    }
+}
+
+/// The records a third party reads out of the store's log.
+fn records(directory: &std::path::Path) -> Vec<Vec<u8>> {
+    let bytes = std::fs::read(directory.join(FILE))
+        .unwrap_or_else(|error| panic!("the store's log cannot be read: {error}"));
+    segment::scan(&bytes)
+        .unwrap_or_else(|error| panic!("the log the writer wrote is a log: {error}"))
+        .records()
+        .to_vec()
+}
+
+/// FNV-1a over the ids, in order: a digest no arrangement of the same set can produce twice.
+fn digest(ids: &[String]) -> String {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for id in ids {
+        for byte in id.as_bytes() {
+            hash ^= u64::from(*byte);
+            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+        hash ^= b'\n' as u64;
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    format!("{hash:016x}")
+}
+
+/// Wait until the queue has been offered `expected` frames in total.
+///
+/// The count is the scenario's own ruler and not a sleep: a frame is offered by the connection task
+/// after the token in front of it was accepted, so waiting for the count to reach the number of
+/// batches this run has sent so far is exactly "this client was served".
+async fn offered(queue: &Queue, expected: u64) -> bool {
+    // Bounded rather than polling for ever: a run that never got there reports a verdict instead of
+    // hanging the gate.
+    let deadline = std::time::Instant::now() + DEADLINE;
+    while queue.stats().offered() < expected {
+        if std::time::Instant::now() >= deadline {
+            return false;
+        }
+        tokio::time::sleep(POLL).await;
+    }
+    true
+}
+
+/// One client: present its token, send its batches, and answer how many frames the store took.
+///
+/// A client whose token the daemon refuses is answered with the daemon closing the connection —
+/// that is the only reply this protocol has — so this reads, and a client the daemon *accepted*
+/// would leave the read waiting, which is how the two are told apart without a clock.
+async fn client(
+    address: std::net::SocketAddr,
+    token: &[u8],
+    batches: &[Vec<u8>],
+    refused: bool,
+) -> usize {
+    let mut socket = TcpStream::connect(address)
+        .await
+        .unwrap_or_else(|error| panic!("the scenario's daemon is listening: {error}"));
+    let mut wire: Vec<u8> = Frame::new(token.to_vec()).encode();
+    for batch in batches {
+        wire.extend_from_slice(&Frame::new(batch.clone()).encode());
+    }
+    socket
+        .write_all(&wire)
+        .await
+        .unwrap_or_else(|error| panic!("the scenario's own bytes are writable: {error}"));
+    socket
+        .flush()
+        .await
+        .unwrap_or_else(|error| panic!("the scenario's own bytes are flushable: {error}"));
+    if !refused {
+        // Closed by this side: the daemon is being told that this client has nothing more to say,
+        // and what it does with the frames already sent is what the count above waits for.
+        drop(socket);
+        return batches.len();
+    }
+    let mut answer = [0u8; 1];
+    let read = tokio::time::timeout(DEADLINE, socket.read(&mut answer))
+        .await
+        .unwrap_or_else(|_| {
+            panic!(
+                "a client whose token had expired was not refused: the daemon kept the connection \
+                 open, so a token that is out of its lifetime is being accepted"
+            )
+        })
+        .unwrap_or_else(|error| panic!("the refused client's socket could not be read: {error}"));
+    assert_eq!(
+        read, 0,
+        "a refused client is answered by the daemon closing the connection, which is the only \
+         answer this protocol has"
+    );
+    0
+}
+
+/// The whole scenario, one seed.
+async fn scenario(seed: u64) {
+    let plan = plan(seed);
+    let base = wall_now();
+    let directory = std::env::temp_dir().join(format!(
+        "lakelet-sim-rotation-{}-{seed}",
+        std::process::id()
+    ));
+    let _ = std::fs::remove_dir_all(&directory);
+    std::fs::create_dir_all(&directory)
+        .unwrap_or_else(|error| panic!("{} cannot be created: {error}", directory.display()));
+    let ring_dir = directory.join(keys::DIRECTORY);
+
+    // The key the store starts with, and the store itself: real files, the real write path and the
+    // policy that never waits for the device, because when a device answers is `4.3`'s decision and
+    // not this schedule's.
+    let opened = at(base, -(OPENED_AGO as i64));
+    plant(&ring_dir, "k1", &secret("k1"), opened, None);
+    let successor = at(base, -(SUCCESSOR_AGO as i64));
+    let safe = successor + Window::MAX_TOKEN_LIFETIME_MILLIS;
+    let late_issued = at(base, -(LATE_ISSUED_AGO as i64));
+    let store = Arc::new(Mutex::new(
+        Spool::with_policy(&directory, WalPolicy::Never)
+            .unwrap_or_else(|error| panic!("a directory this process owns is a store: {error}")),
+    ));
+    let queue = Queue::new(CAPACITY, Overflow::Block);
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .unwrap_or_else(|error| panic!("this process can bind a port: {error}"));
+    let address = listener
+        .local_addr()
+        .unwrap_or_else(|error| panic!("a bound listener has an address: {error}"));
+    let (closing, closed) = tokio::sync::oneshot::channel::<()>();
+    let serving = tokio::spawn(ingest::serve(
+        listener,
+        Arc::clone(&store),
+        Arc::clone(&queue),
+        async move {
+            let _ = closed.await;
+        },
+    ));
+
+    println!(
+        "lakelet-sim plan clients={} late={} rotation_after={} opened_ago={OPENED_AGO} \
+         successor_ago={SUCCESSOR_AGO}",
+        plan.clients.len(),
+        plan.clients
+            .iter()
+            .position(|drawn| drawn.late)
+            .unwrap_or(0),
+        plan.rotation_after
+    );
+
+    // The late client's token, minted before anything happens: the key that signs it is the one the
+    // ring starts with, and by the time this client connects the token is out of its lifetime. It is
+    // minted here rather than at its turn because a token signed *after* the rotation would have to
+    // name the new key, and the point of this client is that its token is old.
+    let late = plan.clients.iter().position(|drawn| drawn.late);
+    let stale = late.map(|_| {
+        ring(&ring_dir)
+            .issue("client-late", LATE_LIFETIME, late_issued)
+            .unwrap_or_else(|error| panic!("the key the store starts with signs: {error}"))
+    });
+
+    let mut sent = 0u64;
+    let mut accepted = 0u64;
+    let mut signed: Vec<(String, usize)> = Vec::new();
+    let mut refused_inside = 0usize;
+    let mut refused_late = 0usize;
+
+    for (index, planned) in plan.clients.iter().enumerate() {
+        if index == plan.rotation_after {
+            // The rotation: a new key file appears while the daemon is running, and the old key's
+            // end is written at the instant it is allowed to leave at — the instant the last token
+            // it could have signed has expired. Both are files; nothing is restarted.
+            plant(&ring_dir, "k2", &secret("k2"), successor, None);
+            assert_eq!(
+                ring(&ring_dir).earliest_safe_retirement(&KeyId::new("k1")),
+                Some(safe),
+                "the instant the old key may leave at is the successor's `not_before` plus the \
+                 longest lifetime this deployment may issue"
+            );
+            plant(&ring_dir, "k1", &secret("k1"), opened, Some(safe));
+            println!(
+                "lakelet-sim rotate after={} key=k2 not_before={} old_retires_at={}",
+                plan.rotation_after,
+                successor as i64 - base as i64,
+                safe as i64 - base as i64
+            );
+            assert_eq!(
+                ring(&ring_dir).preferred().map(|key| key.id().as_str()),
+                Some("k2"),
+                "after the rotation the key that signs is the new one"
+            );
+        }
+
+        let batches: Vec<Vec<u8>> = (0..planned.batches)
+            .map(|batch| payload(index, batch))
+            .collect();
+        let token = if planned.late {
+            let stale = stale
+                .clone()
+                .unwrap_or_else(|| panic!("the late client has a token"));
+            assert!(
+                stale.expires_millis() < base,
+                "the late client's token expired before this run started, which is what makes it \
+                 the contrast to the clients this scenario is about"
+            );
+            stale
+        } else {
+            // An instant safely in the past, so the daemon's own clock — which this scenario cannot
+            // own — is inside the token's window whenever it happens to read it.
+            let issued = at(base, -1_000 + index as i64);
+            ring(&ring_dir)
+                .issue(&format!("client-{index}"), planned.lifetime, issued)
+                .unwrap_or_else(|error| panic!("a client's token is issued: {error}"))
+        };
+        let key = token.key_id().to_string();
+        let before = queue.stats().offered();
+        let took = client(address, &token.encode(), &batches, planned.late).await;
+        sent += batches.len() as u64;
+        if planned.late {
+            refused_late += 1;
+            assert_eq!(
+                took, 0,
+                "a client whose token had expired sends nothing the store keeps"
+            );
+            assert_eq!(
+                queue.stats().offered(),
+                before,
+                "and nothing it sent reached the queue: a refused connection has no frames this \
+                 daemon is going to write"
+            );
+            let refused = ring(&ring_dir)
+                .verify(&token, base)
+                .expect_err("a token out of its lifetime is not good");
+            assert_eq!(
+                refused,
+                Refusal::Expired {
+                    expires_millis: token.expires_millis(),
+                    now_millis: base,
+                },
+                "and the ring says why, with both instants"
+            );
+            println!(
+                "lakelet-sim client index={index} batches={} key={key} lifetime={} late=true \
+                 accepted=0 refused=expired",
+                batches.len(),
+                token.expires_millis() - token.issued_millis()
+            );
+            continue;
+        }
+
+        // The count this client's turn is allowed to reach is relative to what the daemon had
+        // *before* it: a client the daemon refuses contributes nothing, so an absolute count would
+        // wait for frames that are never going to be offered.
+        if !offered(&queue, before + planned.batches as u64).await {
+            // Counted rather than panicked: the transcript is printed either way, and the claim is
+            // asserted at the end of the run.
+            refused_inside += 1;
+        }
+        accepted += took as u64;
+        // The token is still good at the instant the scenario itself would re-check it, which is
+        // the ring's half of the claim and the reason the count above is not a coincidence of
+        // timing.
+        assert!(
+            ring(&ring_dir).verify(&token, base).is_ok(),
+            "the token this client presented is inside its lifetime at the scenario's own instant"
+        );
+        if let Some(entry) = signed.iter_mut().find(|(name, _)| name == &key) {
+            entry.1 += 1;
+        } else {
+            signed.push((key.clone(), 1));
+        }
+        println!(
+            "lakelet-sim client index={index} batches={} key={key} lifetime={} late=false \
+             accepted={took}",
+            batches.len(),
+            planned.lifetime
+        );
+    }
+
+    queue.settled().await;
+    let on_the_file = records(&directory);
+    let ids: Vec<String> = on_the_file.iter().map(|payload| id_of(payload)).collect();
+    assert_eq!(
+        on_the_file.len() as u64,
+        accepted,
+        "the frames the queue wrote are the frames it answered for: {accepted} accepted, {} on the \
+         file",
+        on_the_file.len()
+    );
+
+    signed.sort();
+    for (key, clients) in &signed {
+        println!("lakelet-sim signed key={key} clients={clients}");
+    }
+    println!(
+        "lakelet-sim refused inside_lifetime={refused_inside} late={refused_late} clients={}",
+        plan.clients.len()
+    );
+    let ring = ring(&ring_dir);
+    println!(
+        "lakelet-sim ring keys={} preferred={}",
+        ring.keys().len(),
+        ring.preferred()
+            .map(|key| key.id().to_string())
+            .unwrap_or_else(|| "none".to_owned())
+    );
+    assert_eq!(
+        refused_inside,
+        0,
+        "no client that was inside its token's lifetime was refused across the rotation: {} of the \
+         {} client(s) this schedule has were, and each of them is a batch this deployment lost",
+        refused_inside,
+        plan.clients.len()
+    );
+    assert!(
+        ring.keys().len() == 2,
+        "the ring held both keys at the end of the run: the old one may only leave after every \
+         token it signed has expired, and that instant is an hour after the successor arrived"
+    );
+    assert_eq!(
+        ring.preferred().map(|key| key.id().as_str()),
+        Some("k2"),
+        "and the key that signs at the end of the run is the new one"
+    );
+    assert!(
+        ring.earliest_safe_retirement(&KeyId::new("k2")).is_none(),
+        "the new key has nothing above it yet, so the ring cannot prove an instant for it"
+    );
+
+    let mut sorted = ids;
+    sorted.sort();
+    println!("lakelet-sim accepted batches={}", on_the_file.len());
+    println!("lakelet-sim digest ids={}", digest(&sorted));
+
+    let _ = closing.send(());
+    let _ = serving.await;
+    let _ = std::fs::remove_dir_all(&directory);
+    println!(
+        "lakelet-sim verdict held clients={} batches={}",
+        plan.clients.len(),
+        sent
+    );
+}
+
+#[test]
+fn a_rotation_across_the_boundary_does_not_strand_a_client() {
+    let seed = seed();
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .unwrap_or_else(|error| panic!("a runtime this process owns is a runtime: {error}"));
+    runtime.block_on(scenario(seed));
+}
