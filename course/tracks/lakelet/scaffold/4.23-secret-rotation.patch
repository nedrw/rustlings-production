+
+/// A token: who is connecting, which key signed it, the window it is good for, and the tag.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Token {
+    /// Who the client says it is — a name for a log line and for a policy, not a secret.
+    client_id: String,
+    /// The key the client signed with.
+    key_id: KeyId,
+    /// The instant the token was issued at.
+    issued_millis: u64,
+    /// The instant it stops being good.
+    expires_millis: u64,
+    /// The tag, as lower-case hex.
+    tag: String,
+}
+
+impl Token {
+    /// Who the client says it is.
+    #[must_use]
+    pub fn client_id(&self) -> &str {
+        &self.client_id
+    }
+
+    /// The key this token was signed with.
+    #[must_use]
+    pub fn key_id(&self) -> &KeyId {
+        &self.key_id
+    }
+
+    /// The instant this token was issued at.
+    #[must_use]
+    pub fn issued_millis(&self) -> u64 {
+        self.issued_millis
+    }
+
+    /// The instant this token stops being good.
+    #[must_use]
+    pub fn expires_millis(&self) -> u64 {
+        self.expires_millis
+    }
+
+    /// The bytes the tag covers: the fields as they travel, lengths and all, and nothing after it.
+    ///
+    /// Both halves of the signature use this function — [`KeyRing::issue`] tags it and
+    /// [`KeyRing::verify`] tags it — which is what makes "sign the bytes you send" true by
+    /// construction rather than by two implementations agreeing.
+    #[must_use]
+    pub fn signed_bytes(&self) -> Vec<u8> {
+        todo!("lakelet/4.23-secret-rotation: the bytes the tag covers: the fields as they travel, lengths and all");
+    }
+
+    /// The payload of a connection's first frame.
+    #[must_use]
+    pub fn encode(&self) -> Vec<u8> {
+        todo!("lakelet/4.23-secret-rotation: the payload of a connection's first frame");
+    }
+
+    /// Read the payload of a connection's first frame as a token.
+    ///
+    /// Structural only: this answers whether the bytes *are* a token and says nothing about whether
+    /// they are good ones. Whether the key is on the ring, whether the tag verifies, whether the
+    /// window covers this instant — that is [`KeyRing::verify`], because it needs the ring and it
+    /// needs a clock and this function has neither.
+    ///
+    /// # Errors
+    ///
+    /// [`Refusal::Malformed`] with a sentence for every way a payload can fail to be a token: a
+    /// field that runs past the end, a length that is not there, an id that is not UTF-8, a tag
+    /// that is not sixty-four hex digits, a window that ends before it starts.
+    pub fn decode(payload: &[u8]) -> Result<Self, Refusal> {
+        todo!("lakelet/4.23-secret-rotation: a payload read as a token, structurally: whether these bytes are a token at all");
+    }
+}
+
+/// Why a token was refused.
+///
+/// Typed rather than a sentence, because three readers act on it differently: a client is told
+/// (and `lakelet/4.1-ingest-protocol` closes its connection), an operator's log line carries the
+/// fields, and a case asserts which one it was. The variants are the five ways a token can fail
+/// once it is a token, plus malformed bytes — "this is not a token at all" is a different answer
+/// from "this token is no good", and a first payload that is a batch sent to a daemon that
+/// authenticates is exactly that case.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Refusal {
+    /// No key on the ring has this id: the token was signed by a key this deployment does not have.
+    UnknownKey {
+        /// The id the token names.
+        id: KeyId,
+    },
+    /// The token's own window is in the past.
+    Expired {
+        /// The instant the token stopped being good.
+        expires_millis: u64,
+        /// The instant it was presented at.
+        now_millis: u64,
+    },
+    /// The token claims to have been signed before its key's window opened, or at an instant that
+    /// has not arrived yet.
+    NotYetValid {
+        /// The instant the window it is too early for opens at.
+        not_before_millis: u64,
+    },
+    /// The key that signed it has been retired.
+    KeyRetired {
+        /// The key's id.
+        id: KeyId,
+        /// The instant it was retired at.
+        retired_millis: u64,
+    },
+    /// The tag is not the tag this token's key produces over these bytes.
+    Tag,
+    /// The payload is not a token.
+    Malformed {
+        /// What is wrong with it, phrased for a log line.
+        detail: String,
+    },
+}
+
+impl fmt::Display for Refusal {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        todo!("lakelet/4.23-secret-rotation: the sentence each refusal carries into a log line, with the numbers in it");
+    }
+}
+
+impl std::error::Error for Refusal {}
+
+/// The ring: every key this deployment has, in the order a rotation reads them.
+///
+/// Read once per connection and thrown away, rather than held and watched
+/// ([`KeyRing::load`]): the files are tiny, the directory holds a handful of them, and a ring that
+/// is read per connection is a ring a rotation changes on a **running** daemon. What a bigger
+/// deployment would do instead — watch the directory, or hand the ring out over a control channel
+/// — is a change of transport rather than of this type, and the page says so rather than guessing.
+#[derive(Debug, Default)]
+pub struct KeyRing {
+    /// Every key, oldest `not_before` first.
+    keys: Vec<Key>,
+}
+
+impl KeyRing {
+    /// The ring in `directory`, as of now.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when the directory exists but cannot be read, when a `*.key` file cannot
+    /// be read, when a file is not a key this build understands (each refusal names the file and,
+    /// where there is one, the line), and when the directory holds no `*.key` at all — a directory
+    /// that exists is an operator saying "authenticate", and one with nothing in it would be
+    /// authentication that lets everybody in. A directory that is **not there** is an empty ring
+    /// and not an error: see the module's "the directory is the switch".
+    pub fn load(directory: impl AsRef<Path>) -> Result<Self, Error> {
+        todo!("lakelet/4.23-secret-rotation: the ring below a store's `keys` directory, as of now");
+    }
+
+    /// Every key on the ring, oldest `not_before` first, and ties by id.
+    ///
+    /// Oldest first because that is the order a rotation happens in and the order `lakeletq rotate
+    /// --list` prints: the key at the top is the one that has been there longest and is the one a
+    /// retirement is about.
+    #[must_use]
+    pub fn keys(&self) -> &[Key] {
+        &self.keys
+    }
+
+    /// `true` when this ring authenticates: it holds at least one key.
+    ///
+    /// This is the switch the daemon reads. It is *not* the same question as "can anything sign" —
+    /// a ring whose every key was retired holds keys and cannot sign, which is a ring an operator
+    /// has to fix rather than one that quietly stops authenticating.
+    #[must_use]
+    pub fn is_open(&self) -> bool {
+        !self.keys.is_empty()
+    }
+
+    /// The key that signs: the open key with the latest `not_before`, and ties by id.
+    ///
+    /// A property of the files rather than of the clock, which is why this takes no instant: the
+    /// ring's answer to "who signs" changes when a file changes and not when a millisecond passes.
+    /// [`KeyRing::issue`] is where the clock enters, and it refuses to sign with a key whose window
+    /// has not opened instead of minting a token this file's own [`KeyRing::verify`] would refuse.
+    #[must_use]
+    pub fn preferred(&self) -> Option<&Key> {
+        todo!("lakelet/4.23-secret-rotation: the key that signs: the open key with the latest `not_before`, ties by id");
+    }
+
+    /// A token for `client_id`, signed with [`KeyRing::preferred`]'s key, good for
+    /// `lifetime_millis` from `now_millis`.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when no key on the ring is open (every key has an end written for it), or
+    /// when the key that would sign has not opened yet, or when `lifetime_millis` is longer than
+    /// [`Window::MAX_TOKEN_LIFETIME_MILLIS`] — each naming the number that refused it.
+    pub fn issue(
+        &self,
+        client_id: &str,
+        lifetime_millis: u64,
+        now_millis: u64,
+    ) -> Result<Token, Error> {
+        todo!("lakelet/4.23-secret-rotation: a token for one client, signed with the key this ring prefers");
+    }
+
+    /// Check a token against this ring at `now_millis`, and answer the key that signed it.
+    ///
+    /// The order of the checks is the order a reader would ask them: is this a key I have, is the
+    /// tag *this* key's over *these* bytes, has the key been retired, is the token's own window
+    /// still open. Retirement comes before expiry on purpose — a client whose key is gone has to be
+    /// re-keyed rather than re-issued, and that is the fact an operator reading the log needs
+    /// first.
+    ///
+    /// # Errors
+    ///
+    /// [`Refusal`], one variant per way a token can be no good.
+    pub fn verify(&self, token: &Token, now_millis: u64) -> Result<KeyId, Refusal> {
+        todo!("lakelet/4.23-secret-rotation: this ring's verdict on a token at one instant, typed");
+    }
+
+    /// The instant after which no token this key signed can still be live, or `None` when the ring
+    /// cannot prove one.
+    ///
+    /// Two numbers make it. The ring holds no record of *when* a key arrived, only the `not_before`
+    /// each file states, so the last instant a key could have signed is the latest `not_before`
+    /// among the keys that are newer than it — the instant a successor existed that it could not
+    /// outrank — and a token signed at that instant is live until
+    /// [`Window::MAX_TOKEN_LIFETIME_MILLIS`] later. `None` is the honest answer for the key that is
+    /// currently newest: nothing has taken the signing over from it, so it may still sign, and no
+    /// instant after which its tokens are all gone is knowable from the ring.
+    ///
+    /// The bound is the *latest* takeover rather than the earliest, and the difference is not
+    /// pedantry: the files record no arrival order, so a ring holding `a`, `b` and `c` cannot tell
+    /// whether `b` or `c` took the signing over from `a`, and the bound that cannot be wrong is the
+    /// later one. It is conservative in the safe direction — an operator waits longer than they had
+    /// to — and a retirement that is too late strands nobody.
+    ///
+    /// `None` for a key this ring does not hold, which is a caller that asked about something that
+    /// is not there (`lakeletq rotate` reports that as its own class).
+    #[must_use]
+    pub fn earliest_safe_retirement(&self, id: &KeyId) -> Option<u64> {
+        todo!("lakelet/4.23-secret-rotation: the instant after which no token this key signed can still be live");
+    }
+}
