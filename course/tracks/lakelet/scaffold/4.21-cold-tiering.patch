+//! A directory as an object store: the boring implementation, and the reason it exists.
+//!
+//! Step `lakelet/4.21-cold-tiering`. A tier is a port ([`Objects`](super::Objects)), and a port
+//! with one implementation is a port nobody has tested: every function of the rule above it is
+//! written against whatever that one implementation happens to do. So this file is the *reference*
+//! implementation — the one that shows the port is not shaped around S3 — and it is the
+//! implementation this step's own suite runs against by default
+//! (`conformance.toml` at the project's root names it `local`).
+//!
+//! It is also, on purpose, **not a deployment**. A directory is on the same box as the store, in the
+//! same failure domain, on the same disk: moving bytes into one frees no space if it is a directory
+//! under the store, and a deployment that only ever used this implementation would be a deployment
+//! that never needed this step. What it is good for is what it does here — judging the rule, the
+//! passes and the ordering without a socket, a credential or a bucket — and for the shape of a
+//! second implementation, which is the whole reason the tier was written as a port.
+//!
+//! The three decisions in it that are decisions rather than plumbing:
+//!
+//! * **a key is a path, and a key that is not one is refused.** `../../../etc/passwd` is a string a
+//!   caller can hold, and a port that joined it to its root would write outside the tier. Nothing
+//!   here splits a path on the machine's separator either: a key is `/`-separated, so the bytes of
+//!   the tier's layout are the same on every machine, and a key never contains a `\` that a
+//!   different separator would read differently;
+//! * **`put` waits for the device, and for the directory entry that names the object.** The object
+//!   is what a sweep removes a local file *because of*, so an object that is not durable is a local
+//!   file that is gone with no copy behind it — the one state the ordering exists to prevent. The
+//!   file's contents and its name are two writes (`docs/crash-points.md`, point 4), and this is
+//!   both of them;
+//! * **the listing is one prefix, in order, and a cursor is a key.** The order is the key order —
+//!   the same order an S3-shaped endpoint answers in, which is what lets one suite judge both — and
+//!   a cursor is the last key of the previous page rather than an offset, because the tier changes
+//!   while it is walked (`lakelet/4.21`'s module docs argue it).
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use super::{Cursor, Error, Objects, PAGE_KEYS, Page};
+
+/// A directory, as a tier.
+///
+/// Keys are paths below [`Directory::root`]: the object for `store-a/segments/0000000007.lks` is the
+/// file `<root>/store-a/segments/0000000007.lks`. A deployment chooses the root and the prefix it
+/// serves ([`Directory::with_prefix`]) — the prefix is what keeps two stores handed one directory
+/// apart from each other — and the page size it lists by ([`Directory::with_page`]).
+#[derive(Debug, Clone)]
+pub struct Directory {
+    /// The directory every object of this port lives below.
+    root: PathBuf,
+    /// The prefix this port's store uses, as [`Objects::prefix`] answers it.
+    prefix: String,
+    /// How many keys one page holds.
+    page: usize,
+}
+
+impl Directory {
+    /// A tier rooted at `root`, serving keys under no prefix, in pages of [`PAGE_KEYS`].
+    ///
+    /// The directory is *not* created here: a port is a value, and where its bytes live is what a
+    /// `put` decides about. A root that is not there yet answers an empty listing and a `get` of
+    /// `None`, which is what an operator with a bucket nobody has written to expects.
+    #[must_use]
+    pub fn new(root: impl Into<PathBuf>) -> Self {
+        Self {
+            root: root.into(),
+            prefix: String::new(),
+            page: PAGE_KEYS,
+        }
+    }
+
+    /// The same tier, serving the store whose keys live under `prefix`.
+    ///
+    /// `prefix` is what a pass derives a segment's key with
+    /// ([`object_key`](super::object_key)), so the two are one value here and a spec that varies it
+    /// varies both.
+    #[must_use]
+    pub fn with_prefix(mut self, prefix: &str) -> Self {
+        self.prefix = prefix.trim_end_matches('/').to_owned();
+        self
+    }
+
+    /// The same tier, listing `keys` keys to a page.
+    ///
+    /// Zero is read as one: a page that holds nothing would be a listing that never advances, and a
+    /// caller that asked for one asked for a bug rather than a size.
+    #[must_use]
+    pub fn with_page(mut self, keys: usize) -> Self {
+        self.page = keys.max(1);
+        self
+    }
+
+    /// Where this tier's objects live.
+    #[must_use]
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    /// The file one key names, or a refusal when the key is not a path below the root.
+    ///
+    /// One rule, and it is about the **names** a key is made of: a key is one or more `/`-separated
+    /// names, and a name is neither empty nor `.` nor `..`. Everything a key can get wrong lands on
+    /// that one rule, which is why there is no second check beside it — an absolute key starts with
+    /// a name that is empty, a key ending at a separator ends with one, a key of no bytes is a
+    /// single empty name, and `..` is a name that walks up. A port whose keys could walk out of its
+    /// root is a port that can be told to write anywhere on the box, and the caller here is a key
+    /// derived from a store's manifest — a value this module writes and, one refactor later,
+    /// something else might.
+    fn path_of(&self, key: &str) -> Result<PathBuf, Error> {
+        let _ = key;
+        todo!(
+            "lakelet/4.21-cold-tiering: the file a key names below the root, and a refusal for a key that is not a path below it"
+        )
+    }
+
+    /// Where `key`'s file is, for a caller that has to look.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when the key is not a path below the root ([`Directory::path_of`]).
+    pub fn path_of_key(&self, key: &str) -> Result<PathBuf, Error> {
+        self.path_of(key)
+    }
+
+    /// Every key below the root that starts with `prefix`, in key order.
+    fn keys_under(&self, prefix: &str) -> Result<Vec<String>, Error> {
+        let _ = prefix;
+        todo!(
+            "lakelet/4.21-cold-tiering: every key below the root that starts with a prefix, in key order"
+        )
+    }
+
+    /// Collect the files below `directory`, as keys relative to the root.
+    fn walk(&self, directory: &Path, keys: &mut Vec<String>) -> Result<(), Error> {
+        let _ = (directory, keys);
+        todo!(
+            "lakelet/4.21-cold-tiering: one directory of the tier, and then the directories below it"
+        )
