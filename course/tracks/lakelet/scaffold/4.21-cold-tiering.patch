+}
diff --git a/tests/s3_stub.rs b/tests/s3_stub.rs
new file mode 100644
index 0000000..a6c85d6
--- /dev/null
+++ b/tests/s3_stub.rs
@@ -0,0 +1,700 @@
+//! An S3-shaped endpoint, in this process: the tier's second backend without a network.
+//!
+//! `lakelet/4.21-cold-tiering` ships this file **complete**, and it is the thing that makes
+//! "one suite, two implementations" mean what it says. The step's spec (`tests/spec_tiering.rs`)
+//! declares it as a module (`mod s3_stub;`), so the same cases that run against
+//! `src/engine/tier/filesystem.rs` run against a real socket, a real request line and a real
+//! `authorization` header — with no MinIO, no container and no credentials
+//! (`docs/m3-plan.md` §7 D-3: three image routes were refused, and what a gate can judge here is
+//! the **request shape**, which is exactly what `outbound/http-client@design` is about).
+//!
+//! Four things it does, and each is a decision:
+//!
+//! * **it answers the five operations this build uses** — `PutObject`, `GetObject`,
+//!   `DeleteObject`, `ListObjectsV2` and a `HEAD` — path-style (`/bucket/key`), with the error
+//!   bodies S3 writes (`<Error><Code>…</Code><Message>…</Message></Error>`), because an endpoint
+//!   that answers a bare `500` teaches nothing about what a client has to do with a `403`;
+//! * **it keeps a log**, and the log is what the spec asserts the *shape* of: the method, the path,
+//!   the query, the `authorization` header, `x-amz-content-sha256`, `host` and `x-amz-date`. A
+//!   signature cannot be verified here (this endpoint has no secret, and inventing one would make
+//!   the stub a second implementation of the thing the step is teaching), so what is judged is the
+//!   request: which headers were signed, which were sent, and whether the payload hash names the
+//!   body that arrived;
+//! * **it is hostile where an endpoint may be.** It answers at most [`Stub::page`] keys a page
+//!   whatever `max-keys` asked for (an endpoint is allowed to, and a client that trusted the
+//!   length of a page would report a third of a tier); it refuses a request whose
+//!   `x-amz-content-sha256` does not name the body it sent, and one that carries no signature at
+//!   all; and it can be told to fail the next *n* requests with a status of the caller's choosing
+//!   ([`Stub::fail_next`]), which is how a retry and a refusal are judged without a clock or a
+//!   flaky network;
+//! * **it never panics.** A stub that panicked on a malformed request would turn a client's bug
+//!   into a harness failure — the test would fail with "the connection was reset" rather than with
+//!   the request the client wrote. Every parse here is total, a request it cannot read is answered
+//!   `400` with a reason, and a connection that ends early is closed.
+//!
+//! It is offline (loopback only, a port the kernel picks), clock-free (nothing here reads the time;
+//! the `x-amz-date` a request carries is echoed into the log rather than checked) and
+//! deterministic (one page size, one fault queue, no timing).
+
+#![allow(dead_code)] // the spec uses the part of the endpoint it needs, not all of it
+
+use std::collections::{BTreeMap, VecDeque};
+use std::net::{SocketAddr, TcpListener as StdListener, TcpStream as StdStream};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread::JoinHandle;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+
+/// How much of a request this endpoint will read before it calls it broken.
+const LIMIT: usize = 1024 * 1024;
+
+/// The bucket name this endpoint answers under.
+///
+/// One bucket, and it answers for any name a request carries: a stub with a bucket per test would
+/// be a second configuration surface, and what the spec judges about the bucket is that the path
+/// carries it (`/bucket/key`), not that this file can spell two of them.
+pub const BUCKET: &str = "lakelet-tier";
+
+/// What one request looked like, as this endpoint saw it.
+///
+/// The log is the deliverable of the *client* half of this step: a request's shape is the only
+/// thing about a signature a spec can assert without a secret, and every field here is one the
+/// client wrote.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Call {
+    /// `PUT`, `GET`, `DELETE`, `HEAD`.
+    pub method: String,
+    /// The path, percent-decoded: `/lakelet-tier/segments/0000000000.lks`.
+    pub path: String,
+    /// The raw query string, exactly as it arrived.
+    pub query: String,
+    /// The headers, in the order they arrived.
+    pub headers: Vec<(String, String)>,
+}
+
+impl Call {
+    /// One header's value, matched without regard to case.
+    #[must_use]
+    pub fn header(&self, name: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(found, _)| found.eq_ignore_ascii_case(name))
+            .map(|(_, value)| value.as_str())
+    }
+
+    /// One query parameter's value, percent-decoded.
+    #[must_use]
+    pub fn query_of(&self, name: &str) -> Option<String> {
+        self.query
+            .split('&')
+            .filter(|pair| !pair.is_empty())
+            .find_map(|pair| {
+                let (found, value) = pair.split_once('=').unwrap_or((pair, ""));
+                (found == name).then(|| decoded(value))
+            })
+    }
+
+    /// The key this request named, or `None` when it named no key (a listing names a bucket).
+    #[must_use]
+    pub fn key(&self) -> Option<String> {
+        let rest = self.path.strip_prefix('/')?;
+        let (_, key) = rest.split_once('/')?;
+        (!key.is_empty()).then(|| key.to_owned())
+    }
+
+    /// `GET /bucket/key?list-type=2` — how a report names a call.
+    #[must_use]
+    pub fn line(&self) -> String {
+        if self.query.is_empty() {
+            return format!("{} {}", self.method, self.path);
+        }
+        format!("{} {}?{}", self.method, self.path, self.query)
+    }
+}
+
+/// The endpoint's state, shared with the thread that serves it.
+#[derive(Debug, Default)]
+struct State {
+    /// What the endpoint holds.
+    objects: Mutex<BTreeMap<String, Vec<u8>>>,
+    /// Every request it has answered, in the order they arrived.
+    log: Mutex<Vec<Call>>,
+    /// Statuses to answer instead of doing the work, oldest first.
+    faults: Mutex<VecDeque<u16>>,
+    /// How many keys one page holds, whatever `max-keys` asked for.
+    page: AtomicUsize,
+    /// `true` when answers carry no `content-length` at all, and their bodies end at the close.
+    bare: AtomicBool,
+    /// Set when the endpoint is being dropped.
+    stopped: AtomicBool,
+}
+
+/// An S3-shaped endpoint on a loopback port the kernel picks.
+///
+/// `Stub::start` binds the port and starts the thread that serves it, so a client may connect the
+/// moment it returns — there is no sleep and no wait-for-ready anywhere in this file, which is one
+/// of the two reasons the suite is deterministic (the other is that nothing here reads a clock).
+///
+/// Dropping it stops the thread: the flag is set and one connection to the endpoint wakes the
+/// accept loop, which sees the flag and returns. Nothing outlives a case.
+#[derive(Debug)]
+pub struct Stub {
+    /// The address a client connects to.
+    address: SocketAddr,
+    /// `http://127.0.0.1:<port>` — what a config's `endpoint` takes.
+    endpoint: String,
+    /// What the endpoint holds and what it has been told to do.
+    state: Arc<State>,
+    /// The thread serving it.
+    server: Option<JoinHandle<()>>,
+}
+
+impl Stub {
+    /// Start an endpoint on a port the kernel picks, holding nothing and failing nothing.
+    #[must_use]
+    pub fn start() -> Self {
+        let listener = StdListener::bind(("127.0.0.1", 0))
+            .unwrap_or_else(|error| panic!("a loopback port cannot be claimed: {error}"));
+        let address = listener
+            .local_addr()
+            .unwrap_or_else(|error| panic!("a listener that is bound has an address: {error}"));
+        let _ = listener.set_nonblocking(true);
+        let state = Arc::new(State {
+            page: AtomicUsize::new(2),
+            ..State::default()
+        });
+        let shared = Arc::clone(&state);
+        let server = std::thread::spawn(move || {
+            let Ok(runtime) = tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+            else {
+                return;
+            };
+            runtime.block_on(async move {
+                let Ok(listener) = TcpListener::from_std(listener) else {
+                    return;
+                };
+                loop {
+                    let Ok((stream, _)) = listener.accept().await else {
+                        continue;
+                    };
+                    if shared.stopped.load(Ordering::SeqCst) {
+                        return;
+                    }
+                    serve(stream, &shared).await;
+                }
+            });
+        });
+        Self {
+            address,
+            endpoint: format!("http://{address}"),
+            state,
+            server: Some(server),
+        }
+    }
+
+    /// The endpoint a config takes: `http://127.0.0.1:<port>`.
+    #[must_use]
+    pub fn endpoint(&self) -> &str {
+        &self.endpoint
+    }
+
+    /// The address it is bound to.
+    #[must_use]
+    pub fn address(&self) -> SocketAddr {
+        self.address
+    }
+
+    /// How many keys one page holds, whatever a request's `max-keys` says.
+    ///
+    /// Two by default, and that is the hostile half of this endpoint: the client asks for a
+    /// thousand, this answers two and says it is truncated, and the only correct answer is to
+    /// follow the token. Zero is read as one.
+    pub fn with_page(&self, keys: usize) -> &Self {
+        self.state.page.store(keys.max(1), Ordering::SeqCst);
+        self
+    }
+
+    /// Answer without a `content-length`, so that a body ends at the close of the connection.
+    ///
+    /// Every answer this endpoint makes normally carries a length, because that is what S3 does and
+    /// what a reader should expect. This is the *other* HTTP/1.0 shape — a head that promises
+    /// nothing, a body, and then the close — and it exists because a client that read only the
+    /// header would answer an empty object for a body that was right there, and would do it only
+    /// against endpoints that are not S3. A proxy that strips a header is exactly that endpoint.
+    pub fn without_length(&self) -> &Self {
+        self.state.bare.store(true, Ordering::SeqCst);
+        self
+    }
+
+    /// Answer the next `count` requests with `status` instead of doing the work.
+    ///
+    /// A `403` gets the body S3 writes for a signature that did not match and a `5xx` the one it
+    /// writes for an endpoint that could not answer, so the two cases this drives — a refusal that
+    /// must not be retried and a failure that must be — see what a client sees in a deployment.
+    pub fn fail_next(&self, count: usize, status: u16) -> &Self {
+        if let Ok(mut faults) = self.state.faults.lock() {
+            for _ in 0..count {
+                faults.push_back(status);
+            }
+        }
+        self
+    }
+
+    /// Every request this endpoint has answered, oldest first.
+    #[must_use]
+    pub fn calls(&self) -> Vec<Call> {
+        self.state
+            .log
+            .lock()
+            .map(|log| log.clone())
+            .unwrap_or_default()
+    }
+
+    /// The requests of one method, oldest first.
+    #[must_use]
+    pub fn calls_of(&self, method: &str) -> Vec<Call> {
+        self.calls()
+            .into_iter()
+            .filter(|call| call.method == method)
+            .collect()
+    }
+
+    /// Every key this endpoint holds, in key order.
+    #[must_use]
+    pub fn keys(&self) -> Vec<String> {
+        self.state
+            .objects
+            .lock()
+            .map(|objects| objects.keys().cloned().collect())
+            .unwrap_or_default()
+    }
+
+    /// What this endpoint holds under `key`, if anything.
+    #[must_use]
+    pub fn object(&self, key: &str) -> Option<Vec<u8>> {
+        self.state
+            .objects
+            .lock()
+            .ok()
+            .and_then(|objects| objects.get(key).cloned())
+    }
+
+    /// Put `bytes` under `key` without a request: how a case plants an object that is the wrong
+    /// length, or one nobody's `put` wrote.
+    pub fn seed(&self, key: &str, bytes: &[u8]) {
+        if let Ok(mut objects) = self.state.objects.lock() {
+            objects.insert(key.to_owned(), bytes.to_vec());
+        }
+    }
+}
+
+impl Drop for Stub {
+    fn drop(&mut self) {
+        self.state.stopped.store(true, Ordering::SeqCst);
+        // One connection wakes a listener that is parked in `accept`: without it the loop would
+        // outlive the case, and the runtime it holds would outlive the process's own tests.
+        let _ = StdStream::connect(self.address);
+        if let Some(server) = self.server.take() {
+            let _ = server.join();
+        }
+    }
+}
+
+/// Serve one connection: read a request, answer it, close.
+///
+/// One connection at a time, deliberately: this endpoint's client is a synchronous one that reads
+/// its whole answer before it returns, so a pool of connections is a thing nothing here needs — and
+/// a concurrency bug in a *stub* would be a case that fails on the machine that happened to
+/// interleave. `Connection: close` on every answer is what makes that honest rather than lucky.
+async fn serve(mut stream: TcpStream, state: &Arc<State>) {
+    let Ok((head, mut body)) = read_head(&mut stream).await else {
+        return;
+    };
+    let Some(head) = Head::parse(&head) else {
+        let _ = answer(
+            &mut stream,
+            400,
+            error_body("InvalidRequest", "unreadable request"),
+        )
+        .await;
+        return;
+    };
+    if read_body(&mut stream, &mut body, head.length)
+        .await
+        .is_err()
+    {
+        return;
+    }
+    let call = Call {
+        method: head.method.clone(),
+        path: decoded(&head.path),
+        query: head.query.clone(),
+        headers: head.headers.clone(),
+    };
+    if let Ok(mut log) = state.log.lock() {
+        log.push(call.clone());
+    }
+    let (status, content_type, body) = route(state, &call, &body);
+    let length = !state.bare.load(Ordering::SeqCst);
+    let _ = answer_with(&mut stream, status, content_type, &body, length).await;
+}
+
+/// One request's head, as this endpoint read it.
+#[derive(Debug)]
+struct Head {
+    /// The headers, in the order they arrived.
+    headers: Vec<(String, String)>,
+    /// The method.
+    method: String,
+    /// The path, still percent-encoded.
+    path: String,
+    /// The query string, exactly as it arrived.
+    query: String,
+    /// How many body bytes the head promised.
+    length: usize,
+}
+
+impl Head {
+    /// Parse a request's head, or `None` when it is not one this endpoint can read.
+    fn parse(head: &[u8]) -> Option<Self> {
+        let text = String::from_utf8_lossy(head).into_owned();
+        let mut lines = text.split("\r\n");
+        let mut parts = lines.next()?.split(' ');
+        let method = parts.next()?.to_owned();
+        let target = parts.next()?.to_owned();
+        if method.is_empty() || !target.starts_with('/') {
+            return None;
+        }
+        let (path, query) = match target.split_once('?') {
+            Some((path, query)) => (path.to_owned(), query.to_owned()),
+            None => (target, String::new()),
+        };
+        let mut headers: Vec<(String, String)> = Vec::new();
+        for line in lines {
+            if line.is_empty() {
+                break;
+            }
+            if let Some((name, value)) = line.split_once(':') {
+                headers.push((name.trim().to_owned(), value.trim().to_owned()));
+            }
+        }
+        let length = headers
+            .iter()
+            .find(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+            .and_then(|(_, value)| value.trim().parse::<usize>().ok())
+            .unwrap_or(0);
+        Some(Self {
+            headers,
+            method,
+            path,
+            query,
+            length,
+        })
+    }
+}
+
+/// What one request's answer is, without a socket.
+fn route(state: &Arc<State>, call: &Call, body: &[u8]) -> (u16, &'static str, Vec<u8>) {
+    if let Ok(mut faults) = state.faults.lock()
+        && let Some(status) = faults.pop_front()
+    {
+        let code = if status == 403 {
+            "SignatureDoesNotMatch"
+        } else {
+            "InternalError"
+        };
+        let detail = if status == 403 {
+            "the request signature we calculated does not match the signature you provided"
+        } else {
+            "this endpoint could not answer, and the request may be sent again"
+        };
+        return (status, XML, error_body(code, detail));
+    }
+    // What any endpoint checks before it does the work, and what this one refuses: a request with no
+    // signature at all cannot be attributed to anybody, and a payload hash that does not name the
+    // body that arrived is a request that lied about itself.
+    let Some(authorization) = call.header("authorization") else {
+        return (
+            403,
+            XML,
+            error_body(
+                "AccessDenied",
+                "no authorization header: nothing signed this request",
+            ),
+        );
+    };
+    if !authorization.starts_with("AWS4-HMAC-SHA256 Credential=") {
+        return (
+            403,
+            XML,
+            error_body(
+                "AccessDenied",
+                "the authorization header is not an AWS4-HMAC-SHA256 one",
+            ),
+        );
+    }
+    if let Some(stated) = call.header("x-amz-content-sha256") {
+        let found = hex(&sha256(body));
+        if stated != found {
+            return (
+                400,
+                XML,
+                error_body(
+                    "XAmzContentSHA256Mismatch",
+                    "the x-amz-content-sha256 header does not name the body that arrived",
+                ),
+            );
+        }
+    }
+    let Some(key) = call.key() else {
+        // A request on the bucket itself: the only one this build makes is a listing.
+        if call.method == "GET" && call.query_of("list-type").as_deref() == Some("2") {
+            return listing(state, call);
+        }
+        return (
+            400,
+            XML,
+            error_body(
+                "InvalidRequest",
+                "this endpoint knows one operation on a bucket",
+            ),
+        );
+    };
+    match call.method.as_str() {
+        "PUT" => {
+            if let Ok(mut objects) = state.objects.lock() {
+                objects.insert(key, body.to_vec());
+            }
+            (200, EMPTY, Vec::new())
+        }
+        "HEAD" => match state.objects.lock().ok().and_then(|o| o.get(&key).cloned()) {
+            Some(bytes) => (200, EMPTY, bytes),
+            None => (404, EMPTY, Vec::new()),
+        },
+        "GET" => match state.objects.lock().ok().and_then(|o| o.get(&key).cloned()) {
+            Some(bytes) => (200, BINARY, bytes),
+            None => (404, XML, error_body("NoSuchKey", "the key does not exist")),
+        },
+        "DELETE" => {
+            // S3 answers `204 No Content` for a delete, whether or not the object was there: the
+            // state the call asked for is the state it left behind.
+            if let Ok(mut objects) = state.objects.lock() {
+                objects.remove(&key);
+            }
+            (204, EMPTY, Vec::new())
+        }
+        _ => (
+            400,
+            XML,
+            error_body("InvalidRequest", "this endpoint does not know that method"),
+        ),
+    }
+}
+
+/// The listing shape `ListObjectsV2` answers with, paged by the stub's own page size.
+fn listing(state: &Arc<State>, call: &Call) -> (u16, &'static str, Vec<u8>) {
+    let prefix = call.query_of("prefix").unwrap_or_default();
+    let asked = call
+        .query_of("max-keys")
+        .and_then(|value| value.parse::<usize>().ok())
+        .unwrap_or(1000)
+        .max(1);
+    let size = asked.min(state.page.load(Ordering::SeqCst)).max(1);
+    let after = call.query_of("continuation-token").unwrap_or_default();
+    let held = state
+        .objects
+        .lock()
+        .map(|objects| objects.keys().cloned().collect::<Vec<String>>())
+        .unwrap_or_default();
+    let remaining: Vec<String> = held
+        .into_iter()
+        .filter(|key| {
+            key.starts_with(&prefix) && (after.is_empty() || key.as_str() > after.as_str())
+        })
+        .collect();
+    let page: Vec<&String> = remaining.iter().take(size).collect();
+    let truncated = remaining.len() > page.len();
+    let mut body = String::from("<?xml version=\"1.0\" encoding=\"UTF-8\"?><ListBucketResult>");
+    body.push_str(&format!("<Name>{BUCKET}</Name>"));
+    body.push_str(&format!("<Prefix>{prefix}</Prefix>"));
+    body.push_str(&format!("<MaxKeys>{asked}</MaxKeys>"));
+    body.push_str(&format!(
+        "<IsTruncated>{}</IsTruncated>",
+        if truncated { "true" } else { "false" }
+    ));
+    for key in &page {
+        body.push_str(&format!("<Contents><Key>{key}</Key></Contents>"));
+    }
+    // The token is the last key of this page. S3's is opaque and this one is not — a client may not
+    // read anything out of a token, and the port's contract is only that handing a page's `next`
+    // back asks for the page after it.
+    if truncated && let Some(last) = page.last() {
+        body.push_str(&format!(
+            "<NextContinuationToken>{last}</NextContinuationToken>"
+        ));
+    }
+    body.push_str("</ListBucketResult>");
+    (200, XML, body.into_bytes())
+}
+
+/// Read a request's head, up to and including the empty line that ends it, and whatever body bytes
+/// arrived with it.
+///
+/// The second half is not a detail: a client writes its head and its body in one buffer more often
+/// than not, so a reader that returned only the head would drop the first bytes of the object — a
+/// bug that would show up as a segment one syscall shorter than the manifest says, on some
+/// machines and not others.
+async fn read_head(stream: &mut TcpStream) -> std::io::Result<(Vec<u8>, Vec<u8>)> {
+    let mut buffer: Vec<u8> = Vec::new();
+    let mut chunk = vec![0u8; 8192];
+    loop {
+        if let Some(at) = find(&buffer, b"\r\n\r\n") {
+            let head = buffer.get(..at + 4).unwrap_or_default().to_vec();
+            let rest = buffer.get(at + 4..).unwrap_or_default().to_vec();
+            return Ok((head, rest));
+        }
+        if buffer.len() > LIMIT {
+            return Err(std::io::Error::other(
+                "the request's head is longer than any head",
+            ));
+        }
+        let read = stream.read(&mut chunk).await?;
+        if read == 0 {
+            return Ok((buffer, Vec::new()));
+        }
+        buffer.extend_from_slice(chunk.get(..read).unwrap_or_default());
+    }
+}
+
+/// Read the rest of a body that arrived in pieces.
+async fn read_body(
+    stream: &mut TcpStream,
+    body: &mut Vec<u8>,
+    length: usize,
+) -> std::io::Result<()> {
+    let mut chunk = vec![0u8; 4096];
+    while body.len() < length {
+        let read = stream.read(&mut chunk).await?;
+        if read == 0 {
+            return Ok(());
+        }
+        body.extend_from_slice(chunk.get(..read).unwrap_or_default());
+    }
+    Ok(())
+}
+
+/// Write an answer and close.
+async fn answer(stream: &mut TcpStream, status: u16, body: Vec<u8>) -> std::io::Result<()> {
+    answer_with(stream, status, XML, &body, true).await
+}
+
+/// Write an answer with a content type and close.
+///
+/// `length` is whether the head says how long the body is: without it the body ends where the
+/// connection does ([`Stub::without_length`]).
+async fn answer_with(
+    stream: &mut TcpStream,
+    status: u16,
+    content_type: &str,
+    body: &[u8],
+    length: bool,
+) -> std::io::Result<()> {
+    let reason = match status {
+        200 => "OK",
+        204 => "No Content",
+        400 => "Bad Request",
+        403 => "Forbidden",
+        404 => "Not Found",
+        500 => "Internal Server Error",
+        503 => "Service Unavailable",
+        _ => "Status",
+    };
+    let declared = if length {
+        format!("Content-Length: {}\r\n", body.len())
+    } else {
+        String::new()
+    };
+    let head = format!(
+        "HTTP/1.1 {status} {reason}\r\nContent-Type: {content_type}\r\n{declared}\
+         Connection: close\r\n\r\n"
+    );
+    stream.write_all(head.as_bytes()).await?;
+    stream.write_all(body).await?;
+    stream.flush().await
+}
+
+/// The content types this endpoint answers with.
+const XML: &str = "application/xml";
+/// What an object's bytes are.
+const BINARY: &str = "application/octet-stream";
+/// What an answer with no body carries.
+const EMPTY: &str = "application/xml";
+
+/// The body an S3-shaped refusal carries.
+fn error_body(code: &str, message: &str) -> Vec<u8> {
+    format!(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Error><Code>{code}</Code>\
+         <Message>{message}</Message></Error>"
+    )
+    .into_bytes()
+}
+
+/// Percent-decode `text`, byte for byte.
+fn decoded(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out: Vec<u8> = Vec::with_capacity(bytes.len());
+    let mut at = 0usize;
+    while at < bytes.len() {
+        match bytes.get(at).copied() {
+            Some(b'%') => {
+                let pair = bytes.get(at + 1..at + 3).and_then(|pair| {
+                    std::str::from_utf8(pair)
+                        .ok()
+                        .and_then(|pair| u8::from_str_radix(pair, 16).ok())
+                });
+                match pair {
+                    Some(byte) => {
+                        out.push(byte);
+                        at += 3;
+                    }
+                    None => {
+                        out.push(b'%');
+                        at += 1;
+                    }
+                }
+            }
+            Some(byte) => {
+                out.push(byte);
+                at += 1;
+            }
+            None => break,
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// Where `needle` first stands in `haystack`.
+fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    if needle.is_empty() || haystack.len() < needle.len() {
+        return None;
+    }
+    (0..=haystack.len() - needle.len())
+        .find(|at| haystack.get(*at..at + needle.len()) == Some(needle))
+}
+
+/// The sha256 of `bytes`, lower-case hex.
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+/// The sha256 of `bytes`.
+fn sha256(bytes: &[u8]) -> [u8; 32] {
+    use sha2::Digest as _;
+    let mut hasher = sha2::Sha256::new();
+    hasher.update(bytes);
+    hasher.finalize().into()
+}
