+        formatter.write_str(&self.0)
+    }
+}
+
+/// One page of a listing: the keys, and where the page after this one starts.
+///
+/// `next` is `None` exactly when the endpoint said there is nothing left — not when the page came
+/// back shorter than the size that was asked for. An S3-shaped endpoint answers short pages all the
+/// time (its own page size is not the caller's `max-keys`), so a caller that read `next` out of the
+/// length would call a third of a tier the whole of it.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Page {
+    /// The keys this page holds, in the port's deterministic order.
+    pub keys: Vec<String>,
+    /// Where the page after this one starts, or `None` when this was the last one.
+    pub next: Option<Cursor>,
+}
+
+/// What a tier is: whole blobs under a key, and the listing that says which.
+///
+/// Two implementations ship with this step — a directory ([`filesystem::Directory`]) and an
+/// S3-shaped endpoint ([`s3::Bucket`]) — and the two of them are why the rule and the passes above
+/// can be written once. A third would be a deployment's own (an object store that is not S3, a
+/// different vendor's API); nothing here would have to change for it.
+pub trait Objects {
+    /// The prefix every key of this port's store lives under.
+    ///
+    /// This is the port's one piece of *store* knowledge: a pass derives a segment's key from the
+    /// segment's identity and this prefix ([`object_key`]), so two stores handed the same tier do
+    /// not collide — and a caller that has a port and nothing else can ask what is in the tier
+    /// under this prefix without consulting a local disk.
+    fn prefix(&self) -> &str;
+
+    /// Write `bytes` under `key`, replacing whatever was there.
+    ///
+    /// Idempotent, which is what makes a `put` a request a client may repeat: the same key and the
+    /// same bytes leave the same object, whatever happened to the attempt before this one.
+    ///
+    /// # Errors
+    ///
+    /// The port's own refusals: a tier that could not be reached ([`Error::Transport`]), one that
+    /// refused the request ([`Error::Refused`]), or a local directory that would not take the write
+    /// ([`Error::Local`]).
+    fn put(&self, key: &str, bytes: &[u8]) -> Result<(), Error>;
+
+    /// Read the bytes under `key`, or `None` when the tier holds no such object.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Transport`] when the tier could not be reached, [`Error::Refused`] when it refused,
+    /// and [`Error::Local`] when a local directory could not be read.
+    fn get(&self, key: &str) -> Result<Option<Vec<u8>>, Error>;
+
+    /// Remove `key` from the tier.
+    ///
+    /// Idempotent: a key that is not there is not a failure, because a pass that deletes what is
+    /// already gone has reached the state it asked for.
+    ///
+    /// # Errors
+    ///
+    /// The same three classes as [`Objects::put`].
+    fn delete(&self, key: &str) -> Result<(), Error>;
+
+    /// One page of the keys under `prefix`, continuing after `cursor` when one is given.
+    ///
+    /// # Errors
+    ///
+    /// The same three classes as [`Objects::put`].
+    fn list(&self, prefix: &str, cursor: Option<Cursor>) -> Result<Page, Error>;
+}
+
+/// The tier rule as a value: how long a segment stays on this box before it may leave.
+///
+/// A policy is data on purpose, and it is the sibling of `lakelet/4.9-retention`'s
+/// [`Policy`](crate::engine::retention::Policy) rather than a second idea: that one says what leaves
+/// the store for ever, this one says what leaves the *box* and stays readable. Both are applied at
+/// a `now` a caller hands in, both answer a cutoff, and both keep what they cannot judge.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Policy {
+    /// How many milliseconds a segment may go untouched before it is cold.
+    cold_after_millis: u64,
+}
+
+impl Policy {
+    /// The policy this build ships: a week.
+    ///
+    /// The number is a decision somebody has to defend, and the argument for this one is where it
+    /// sits against `lakelet/4.9-retention`'s window: the tier's is longer, so a deployment keeps
+    /// data on the box for as long as it is answering questions about it and moves it out after
+    /// that — a store that tiered on a shorter interval than it retained would pay to move and
+    /// fetch records that were about to be expired. Zero is the one value this policy does not
+    /// ship: it makes every segment cold the moment it is written, which is a store that moves what
+    /// it just wrote, and that is a decision an operator makes rather than a default.
+    pub const DEFAULT: Policy = Policy {
+        cold_after_millis: 7 * 24 * 3_600_000,
+    };
+
+    /// A policy that lets a segment go cold `cold_after_millis` after its last record.
+    #[must_use]
+    pub const fn new(cold_after_millis: u64) -> Self {
+        Self { cold_after_millis }
+    }
+
+    /// How long a segment may go untouched before this policy calls it cold.
+    #[must_use]
+    pub const fn cold_after_millis(&self) -> u64 {
+        self.cold_after_millis
+    }
+
+    /// The instant before which a segment's records are cold, at `now_millis`.
+    ///
+    /// Saturating, because a clock that has gone backwards is not a reason to panic: a `now` below
+    /// the policy's window answers a cutoff of zero, which is below every timestamp this store can
+    /// hold, so a pass made at it moves nothing.
+    #[must_use]
+    pub const fn cutoff(&self, now_millis: u64) -> u64 {
+        now_millis.saturating_sub(self.cold_after_millis)
+    }
+
+    /// `true` when this segment may leave the box, as of `now_millis`.
