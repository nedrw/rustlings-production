@@ -0,0 +1,318 @@
+//! The one factory the tiering spec builds a port with: `local`, or `s3`, and nothing else.
+//!
+//! `lakelet/4.21-cold-tiering` ships this file **complete**, and it is where the step's
+//! `conformance@2` gate meets the spec. The gate runs the step's `run.cmd` once per backend named in
+//! `conformance.toml`, with `KILN_BACKEND` set to the name (`kiln/src/gates/conformance.rs` owns
+//! that variable and its meaning, not this file), so "one suite, two implementations" is one suite
+//! run twice — the cases decide nothing about which backend they are on, and this module is the only
+//! place that reads the variable.
+//!
+//! Four things it knows, and the spec knows none of them:
+//!
+//! * **which backend to build.** `local` is `src/engine/tier/filesystem.rs` on a directory of this
+//!   process's own; `s3` is `src/engine/tier/s3.rs` against the in-process endpoint in
+//!   `tests/s3_stub.rs` — or against `KILN_S3_ENDPOINT`, when the machine has a real S3-compatible
+//!   endpoint to point at (`docs/m3-plan.md` §7 D-3: the same suite must be pointable at MinIO
+//!   without a line of the spec changing). With a real endpoint there is no request log, and
+//!   [`Tier::stub`] answers `None` so a case that reads one can say so rather than fail;
+//!
+//! and one thing it deliberately does *not* make conditional: **the endpoint exists on every run**,
+//! and [`Tier::bucket`] builds an S3-shaped port whichever backend `KILN_BACKEND` names. What the
+//! variable decides is which implementation [`Tier::objects`] answers with — the port a case is run
+//! through, which is what the conformance gate judges — and a case about the *client* (a signature,
+//! a retry, a request's shape) is about the same thing on both runs; leaving it out of one run
+//! would leave that half of the step out of the mutation walk, which runs this suite exactly once.
+//! * **the store's own directory**, a [`StoreDir`](super::StoreDir) — and a second one for the
+//!   local tier's root, because a tier that shares a directory with the store it tiers is a tier
+//!   that frees nothing;
+//! * **the prefix** this store's keys live under. It is derived from the case's label, so two cases
+//!   in one process cannot collide, and [`Tier::port`] takes one so that a case can build two of
+//!   them and see that two stores handed one bucket do not overwrite each other;
+//! * **the shape of the store both backends are run through**: segments one hour apart, a handful of
+//!   records each, at timestamps derived from arithmetic rather than from a clock
+//!   ([`EPOCH`], [`records`], [`last_of`]). A fixture that read the time would make a policy case
+//!   flake at midnight.
+//!
+//! What it deliberately does **not** know is any assertion: it builds values, it does not judge
+//! them. The rule is `tests/support/mod.rs`'s, and it is the reason a case can be about the rule
+//! rather than about the fixture.
+
+#![allow(dead_code)] // the spec uses the part of the fixture it needs, not all of it
+
+#[path = "../s3_stub.rs"]
+pub mod stub;
+
+use std::path::{Path, PathBuf};
+
+use lakelet::engine::compaction::{self, Segments};
+use lakelet::engine::tier::{Bucket, Config, Directory, Listing, Objects, Report};
+use lakelet::protocol::batch::Record;
+
+use super::StoreDir;
+
+/// The environment variable the conformance gate sets to pick a backend.
+pub const BACKEND: &str = "KILN_BACKEND";
+
+/// The environment variable a deployment points at a real S3-compatible endpoint.
+pub const ENDPOINT: &str = "KILN_S3_ENDPOINT";
+
+/// How many keys one page holds, in this fixture.
+///
+/// Two, because a listing that pages cannot be judged on a store that fits in one page: the store
+/// both backends are run through has more segments than this. For the local backend it is the port's
+/// own page size. For the S3-shaped one the *client* asks for a thousand and the endpoint answers
+/// two — an endpoint is allowed to, and following the token is the half of a listing a first
+/// implementation gets wrong.
+pub const PAGE: usize = 2;
+
+/// The bucket the S3-shaped port names in every path.
+pub const BUCKET: &str = "lakelet-tier";
+
+/// The region, service and instant the S3-shaped port signs with.
+///
+/// A fixed date, because a signature is bytes: [`DATE`] is what `x-amz-date` and the credential
+/// scope carry, and a port whose date came from a clock would sign a different request every second.
+pub const REGION: &str = "eu-central-1";
+/// The instant the fixture's signatures are dated with.
+pub const DATE: &str = "20261008T000000Z";
+/// The access key the fixture signs as. An identifier, not a secret, and not a real one.
+pub const ACCESS_KEY: &str = "AKIDLAKELETTIER4X21";
+/// The secret the fixture derives its signing key from. Not a real one, and not a secret.
+pub const SECRET: &str = "lakelet-tier-fixture-secret";
+
+/// One hour, in the units the manifest states: milliseconds.
+pub const HOUR: u64 = 3_600_000;
+
+/// The instant the fixture's store starts at.
+///
+/// A number rather than a clock reading: every timestamp a case compares against is this value plus
+/// arithmetic, so the same case says the same thing on every machine and at every hour.
+pub const EPOCH: u64 = 4_700_000 * HOUR;
+
+/// How many records one sealed segment holds.
+pub const PER_SEGMENT: usize = 4;
+
+/// Milliseconds between two records of one segment.
+pub const STEP: u64 = 60_000;
+
+/// The records segment `ordinal` holds: its own series, one minute apart from its start.
+#[must_use]
+pub fn records(ordinal: u64) -> Vec<Record> {
+    let start = EPOCH + ordinal * HOUR;
+    (0..PER_SEGMENT)
+        .map(|at| Record {
+            series: format!("cpu,host=h{ordinal}"),
+            ts_millis: (start + at as u64 * STEP) as i64,
+            value: (ordinal * 100 + at as u64) as f64,
+        })
+        .collect()
+}
+
+/// The instant segment `ordinal`'s *last* record falls at: what a tier policy compares.
+#[must_use]
+pub fn last_of(ordinal: u64) -> u64 {
+    EPOCH + ordinal * HOUR + (PER_SEGMENT as u64 - 1) * STEP
+}
+
+/// The instant segment `ordinal`'s *first* record falls at.
+#[must_use]
+pub fn first_of(ordinal: u64) -> u64 {
+    EPOCH + ordinal * HOUR
+}
+
+/// Open a store in `directory` and seal `segments` segments in it.
+#[must_use]
+pub fn sealed(directory: &Path, segments: u64) -> Segments {
+    let mut store = Segments::open(directory)
+        .unwrap_or_else(|error| panic!("a directory this process owns is a store: {error}"));
+    for ordinal in 0..segments {
+        store
+            .seal(&records(ordinal))
+            .unwrap_or_else(|error| panic!("segment {ordinal} is what a flush closes: {error}"));
+    }
+    store
+}
+
+/// Every record a store answers with, in the order its segments hold them.
+#[must_use]
+pub fn answers(store: &Segments) -> Vec<Record> {
+    store
+        .snapshot()
+        .records()
+        .unwrap_or_else(|error| panic!("the store's own segments are readable: {error}"))
+}
+
+/// One case's fixture: a store directory, a tier, and the backend that tier is.
+#[derive(Debug)]
+pub struct Tier {
+    /// The backend's name, exactly as `KILN_BACKEND` spelled it.
+    backend: String,
+    /// The store's directory.
+    store: StoreDir,
+    /// The local tier's root. Unused by the S3-shaped backend, and created anyway so that the two
+    /// backends' fixtures are the same shape.
+    root: StoreDir,
+    /// The prefix this case's store uses.
+    prefix: String,
+    /// The endpoint, when one was started here.
+    stub: Option<stub::Stub>,
+    /// Where the S3-shaped port connects.
+    endpoint: String,
+}
+
+impl Tier {
+    /// Build the fixture for `label`, with the backend `KILN_BACKEND` names (`local` by default).
+    ///
+    /// The label is part of every path and every prefix this fixture makes, so two cases in one
+    /// process — the test harness runs them in parallel — cannot share a store, a tier or a key
+    /// space.
+    #[must_use]
+    pub fn start(label: &str) -> Self {
+        let backend = std::env::var(BACKEND).unwrap_or_else(|_| "local".to_owned());
+        let store = StoreDir::new(&format!("tier-store-{label}"));
+        let root = StoreDir::new(&format!("tier-root-{label}"));
+        // The endpoint is started on **every** run, not only the S3-shaped one: half of this
+        // step's cases are about the *client* rather than about the port — a signature, a payload
+        // hash, a retry, a request shape, a page token — and a case about the client that only ran
+        // on one backend would be a case the other run's suite (and the mutation walk, which runs
+        // the suite exactly once) never reaches. What `KILN_BACKEND` decides is which
+        // implementation *the port cases* are run through, which is what `conformance@2` judges.
+        let named = std::env::var(ENDPOINT).ok();
+        let stub = if named.is_none() {
+            Some(stub::Stub::start())
+        } else {
+            None
+        };
+        let endpoint = named.unwrap_or_else(|| {
+            stub.as_ref()
+                .map(|stub| stub.endpoint().to_owned())
+                .unwrap_or_default()
+        });
+        Self {
+            backend,
+            store,
+            root,
+            prefix: format!("lakelet-store-{label}"),
+            stub,
+            endpoint,
+        }
+    }
+
+    /// The name of the backend this fixture built, as `KILN_BACKEND` spelled it.
+    #[must_use]
+    pub fn backend(&self) -> &str {
+        &self.backend
+    }
+
+    /// The store's directory: where `segments/` and `segments.manifest` live.
+    #[must_use]
+    pub fn store_dir(&self) -> &Path {
+        self.store.path()
+    }
+
+    /// The prefix this case's store uses.
+    #[must_use]
+    pub fn prefix(&self) -> &str {
+        &self.prefix
+    }
+
+    /// A port for the store whose keys live under `prefix`.
+    ///
+    /// Every call builds a new port, which is what lets a case hold two *stores* — two prefixes —
+    /// against one tier. A port is a value, and nothing in it is shared with another one.
+    #[must_use]
+    pub fn port(&self, prefix: &str) -> Box<dyn Objects> {
+        if self.backend == "s3" {
+            return Box::new(self.bucket(prefix));
+        }
+        Box::new(
+            Directory::new(self.root.path())
+                .with_prefix(prefix)
+                .with_page(PAGE),
+        )
+    }
+
+    /// The S3-shaped port for `prefix`: the endpoint's, whichever backend this run is on.
+    ///
+    /// A case about the client builds one of these whatever `KILN_BACKEND` says, because what it is
+    /// about — a signature, a payload hash, a retry, a request shape — is the same question on both
+    /// runs. The *port* cases are the ones that go through [`Tier::objects`].
+    #[must_use]
+    pub fn bucket(&self, prefix: &str) -> Bucket {
+        let config = Config::new(&self.endpoint, BUCKET, REGION, DATE, ACCESS_KEY, SECRET);
+        Bucket::new(config)
+            .unwrap_or_else(|error| panic!("the fixture's config is one a tier can use: {error}"))
+            .with_prefix(prefix)
+    }
+
+    /// The port for this case's own store.
+    #[must_use]
+    pub fn objects(&self) -> Box<dyn Objects> {
+        self.port(&self.prefix)
+    }
+
+    /// A store with `segments` sealed segments, at this fixture's known instants.
+    #[must_use]
+    pub fn store(&self, segments: u64) -> Segments {
+        sealed(self.store_dir(), segments)
+    }
+
+    /// Every record the store answers with, in the order its segments hold them.
+    #[must_use]
+    pub fn answers(&self, store: &Segments) -> Vec<Record> {
+        answers(store)
+    }
+
+    /// What the tier holds under `prefix`, asked of the port rather than of a directory.
+    #[must_use]
+    pub fn held(&self, prefix: &str) -> Vec<String> {
+        let port = self.port(prefix);
+        let listing: Listing = lakelet::engine::tier::listing(&*port, port.prefix())
+            .unwrap_or_else(|error| panic!("the tier's own listing answers: {error}"));
+        listing.keys().to_vec()
+    }
+
+    /// The in-process endpoint, when this fixture started one.
+    ///
+    /// `None` when the machine's `KILN_S3_ENDPOINT` was used instead: a real endpoint has no request
+    /// log, and a case that reads one has to be able to say so.
+    #[must_use]
+    pub fn stub(&self) -> Option<&stub::Stub> {
+        self.stub.as_ref()
+    }
+
+    /// Every request the in-process endpoint answered — empty when there is none.
+    #[must_use]
+    pub fn calls(&self) -> Vec<stub::Call> {
+        self.stub().map(stub::Stub::calls).unwrap_or_default()
+    }
+
+    /// The requests of one method the in-process endpoint answered.
+    #[must_use]
+    pub fn calls_of(&self, method: &str) -> Vec<stub::Call> {
+        self.stub()
+            .map(|stub| stub.calls_of(method))
+            .unwrap_or_default()
+    }
+}
+
+/// The path of one segment's file inside a store directory.
+#[must_use]
+pub fn file_of(directory: &Path, ordinal: u64) -> PathBuf {
+    compaction::file_of(directory, ordinal)
+}
+
+/// What a pass reported, as the `name=value` lines a report prints.
+///
+/// A pass's own numbers, in one place, so that a case can say what it compared without a second
+/// spelling of the fields: `moved=2 kept=1 bytes=… fetched=0 pages=0`.
+#[must_use]
+pub fn report_lines(report: &Report) -> Vec<String> {
+    vec![
+        format!("moved={}", report.moved()),
+        format!("fetched={}", report.fetched()),
+        format!("kept={}", report.kept()),
+        format!("bytes={}", report.bytes()),
+        format!("pages={}", report.pages()),
+    ]
+}
