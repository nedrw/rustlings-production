+
+impl fmt::Display for Config {
+    /// The endpoint, the bucket and the scope — and the access key, which is an identifier rather
+    /// than a secret. The secret key is not here, and a config that reached a log line is a config
+    /// whose secret is in a log the day somebody writes one.
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
