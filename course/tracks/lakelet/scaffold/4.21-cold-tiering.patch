+fn mac(key: &[u8], data: &[u8]) -> [u8; 32] {
+        let _ = (key, data);
+        todo!(
+            "lakelet/4.21-cold-tiering: HMAC-SHA256 of the data under the key, with HMAC's own rule for the key"
+        )
+    }
+
+/// The typed name of the MAC this build signs with.
+type HmacSha256 = hmac::Hmac<sha2::Sha256>;
+
+/// The sha256 of `bytes`.
+fn sha256(bytes: &[u8]) -> [u8; 32] {
+        let _ = bytes;
+        todo!(
+            "lakelet/4.21-cold-tiering: the hash every signed request is made of"
+        )
+    }
+
+/// `bytes` as lower-case hex.
+fn hex(bytes: &[u8]) -> String {
+        let _ = bytes;
+        todo!(
