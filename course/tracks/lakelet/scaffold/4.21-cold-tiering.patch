+//! A minimal HTTP/1.1 client: the request as a value, the answer as a value, and a bounded retry.
+//!
+//! Step `lakelet/4.21-cold-tiering`, and the shape it deepens is `relay/2.7-outbound-client`'s: a
+//! request line, headers, a body, and an answer read by the `content-length` it promised. What is
+//! *here* and not there is what a signed request needs and what a tier's caller needs:
+//!
+//! * **one value is both the bytes that are signed and the bytes that are sent.** [`Request`] keeps
+//!   the method, the path, the query **as pairs**, the headers and the body, and renders the wire
+//!   from them; [`Request::canonical_request`] is built from the same fields. The two cannot
+//!   disagree, because there is nothing to keep in step — a request whose signed string was
+//!   assembled beside the bytes it sends is a request that works until the day somebody tidies one
+//!   of the two, and then fails as a `403` nobody can read;
+//! * **a status class as a value.** [`Class`] is the four things a caller has to do something
+//!   about: `2xx` answered, `404` absent, every other `4xx` refused — no second attempt produces a
+//!   different answer — and `5xx` retryable. Nothing in this file knows what a bucket is;
+//! * **a bounded retry with no clock in it.** [`ATTEMPTS`] is a count, not a deadline, and there is
+//!   no sleep and no jitter between attempts: a retry policy that reads a clock is a policy two
+//!   machines disagree about, and this step's subject is a request whose bytes are the same on both
+//!   (`relay/2.8-retry-budget` is where a *budget* with a clock in it belongs, for a service that
+//!   talks to somebody else's server many times a minute; a tier is read and written by a pass, and
+//!   what it needs is a bound).
+//!
+//! Three things it deliberately does not do, each for a reason that costs a sentence rather than a
+//! silence: **no `https`** (a TLS stack is a deployment's decision, not a tier's; an endpoint that
+//! says `https` is [`Error::Invalid`](super::Error::Invalid) and says so), **no chunked answers**
+//! (a body without a `content-length` is read to the close, which is HTTP/1.0's rule and correct;
+//! a `transfer-encoding: chunked` body is *framing characters* read as an object, and the fix is a
+//! decoder here, not a longer deadline), and **no connection pool** (a tier's requests are what a
+//! pass makes — a sweep per hour, a hydrate per cold read — and a pool is a state machine whose
+//! whole cost is in noticing a socket that died while it was idle; one connection per attempt is
+//! the thing that has no state to get wrong).
+
+use std::io;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+use tokio::runtime::Runtime;
+
+use super::Error;
+
+/// How many times one request is sent before the client gives up.
+///
+/// Three, and it is a *count*: no deadline, no backoff, no jitter. What makes repeating safe is the
+/// caller's business and it is settled before this file is reached — a `put` repeats because its
+/// key is the identity of what it writes, a `get` and a `list` repeat because they change nothing,
+/// and a `delete` repeats because it is idempotent (`lakelet/4.21`'s module docs). A request that
+/// was not safe to repeat would be a request this client may not be handed.
+pub const ATTEMPTS: usize = 3;
+
+/// How much of a head a client will read before it calls the answer broken.
+///
+/// An answer's head is a status line and a handful of headers — this build's stub sends five — and
+/// something far longer than this is not a head anybody's endpoint meant to send. The bound exists
+/// because a client without one is a client that can be told to allocate by a socket.
+const HEAD_LIMIT: usize = 64 * 1024;
+
+/// One request: what is signed, and what goes on the wire.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Request {
+    /// The method, as it is written in the request line.
+    method: String,
+    /// The path, `/`-separated and not encoded: this value is what a signature is computed over.
+    path: String,
+    /// The query, as pairs rather than as one string: the canonical form sorts them, and a string
+    /// that arrived pre-sorted cannot be checked by anything.
+    query: Vec<(String, String)>,
+    /// The headers, in the order they were added.
+    headers: Vec<(String, String)>,
+    /// The body, byte for byte. `put` is the only operation here that has one.
+    body: Vec<u8>,
+}
+
+impl Request {
+    /// A request with no headers, no query and no body.
+    #[must_use]
+    pub fn new(method: &str, path: &str) -> Self {
+        Self {
+            method: method.to_owned(),
+            path: path.to_owned(),
+            query: Vec::new(),
+            headers: Vec::new(),
+            body: Vec::new(),
+        }
+    }
+
+    /// The same request, with one query parameter.
+    #[must_use]
+    pub fn with_query(mut self, name: &str, value: &str) -> Self {
+        self.query.push((name.to_owned(), value.to_owned()));
+        self
+    }
+
+    /// The same request, with one more header.
+    #[must_use]
+    pub fn with_header(mut self, name: &str, value: &str) -> Self {
+        self.headers.push((name.to_owned(), value.to_owned()));
+        self
+    }
+
+    /// The same request, carrying `bytes` as its body.
+    #[must_use]
+    pub fn with_body(mut self, bytes: impl Into<Vec<u8>>) -> Self {
+        self.body = bytes.into();
+        self
+    }
+
+    /// The method this request uses.
+    #[must_use]
+    pub fn method(&self) -> &str {
+        &self.method
+    }
+
+    /// The path this request names, as it was given.
+    #[must_use]
+    pub fn path(&self) -> &str {
+        &self.path
+    }
+
+    /// The query parameters, in the order they were added.
+    #[must_use]
+    pub fn query_pairs(&self) -> &[(String, String)] {
+        &self.query
+    }
+
+    /// The headers, in the order they were added.
+    #[must_use]
+    pub fn headers(&self) -> &[(String, String)] {
+        &self.headers
+    }
+
+    /// The body this request sends.
+    #[must_use]
+    pub fn body(&self) -> &[u8] {
+        &self.body
+    }
+
+    /// One header's value, matched without regard to case.
+    #[must_use]
+    pub fn header_of(&self, name: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(found, _)| found.eq_ignore_ascii_case(name))
+            .map(|(_, value)| value.as_str())
+    }
+
+    /// The hex sha256 of the body: what this request names its own payload by.
+    ///
+    /// An S3-shaped endpoint wants it in `x-amz-content-sha256` and inside the signature, and the
+    /// one thing that matters is that the two see the same number — which is why the header is set
+    /// from this function *and* the canonical request calls it, rather than either of them holding
+    /// a copy.
+    #[must_use]
+    pub fn payload_hash(&self) -> String {
+        todo!(
+            "lakelet/4.21-cold-tiering: the sha256 of this request's own body, in hex"
+        )
+    }
+
+    /// The path as a canonical request spells it: each segment percent-encoded, `/` kept.
+    fn canonical_uri(&self) -> String {
+        todo!(
+            "lakelet/4.21-cold-tiering: the path as a signature spells it — each segment percent-encoded, `/` kept"
+        )
+    }
+
+    /// The query as a canonical request spells it: sorted by name, each name and value encoded.
+    fn canonical_query(&self) -> String {
+        todo!(
+            "lakelet/4.21-cold-tiering: the query as a signature spells it — sorted by name, names and values encoded"
+        )
+    }
+
+    /// The request line's target: the path, and the query the way this request spells it.
+    fn target(&self) -> String {
+        todo!(
+            "lakelet/4.21-cold-tiering: the request line's target: the path, and the query as this request spells it"
+        )
+    }
+
+    /// The string a signature is computed over: one value, from the request that is sent.
+    ///
+    /// `signed` is the header list the caller means to sign, in lower case and sorted; it is what
+    /// the canonical headers block holds, and the two are the same list by construction — a caller
+    /// that signed a header it did not send, or sent one it did not sign, is a `403` from an
+    /// endpoint that checked (`lakelet/4.21`'s spec asserts both directions).
+    ///
+    /// The payload hash is **this request's own** ([`Request::payload_hash`]) rather than a number
+    /// handed in, which is the whole reason this function takes a `&self`: a body that changes
+    /// after it was hashed changes the signature with it.
+    #[must_use]
+    pub fn canonical_request(&self, signed: &[&str]) -> String {
+        let _ = signed;
+        todo!(
+            "lakelet/4.21-cold-tiering: the string a signature is computed over, built from the request that is sent"
+        )
+    }
+
+    /// The bytes this request is on the wire.
+    fn wire(&self, authority: &str) -> Vec<u8> {
+        let _ = authority;
+        todo!(
+            "lakelet/4.21-cold-tiering: the bytes this request is on the wire: the request line, the headers, the length of the body, and the body"
+        )
+    }
+}
+
+/// One answer: its status, its headers and its body.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Response {
+    /// The status code, as the status line wrote it.
+    status: u16,
+    /// The headers, in the order they arrived.
+    headers: Vec<(String, String)>,
+    /// The body, as long as the `content-length` promised (or as long as the connection).
+    body: Vec<u8>,
+}
+
+impl Response {
+    /// The status code.
+    #[must_use]
+    pub fn status(&self) -> u16 {
+        self.status
+    }
+
+    /// One header's value, matched without regard to case.
+    #[must_use]
+    pub fn header(&self, name: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(found, _)| found.eq_ignore_ascii_case(name))
+            .map(|(_, value)| value.as_str())
+    }
+
+    /// The body.
+    #[must_use]
+    pub fn body(&self) -> &[u8] {
+        &self.body
+    }
+
+    /// The body as text, for a caller that has to read a message out of it: an endpoint that
+    /// refuses explains itself in its body, and a refusal with the body thrown away is one an
+    /// operator cannot act on.
+    #[must_use]
+    pub fn text(&self) -> String {
+        String::from_utf8_lossy(&self.body).into_owned()
+    }
+
+    /// What a caller has to *do* about this answer.
+    #[must_use]
+    pub fn class(&self) -> Class {
+        todo!(
+            "lakelet/4.21-cold-tiering: what a caller has to do about this answer: answered, absent, refused or retryable"
+        )
+    }
+}
+
+/// The four things an answer can mean to a caller.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Class {
+    /// The request was carried out; the body is the answer.
+    Answered,
+    /// There is no such object. For a `get`, `None`; for a `delete`, already done.
+    Absent,
+    /// The endpoint refused, and repeating the request gets the same refusal.
+    Refused,
+    /// The endpoint could not answer, and the request may be sent again.
+    Retryable,
+}
+
+impl Class {
+    /// The word this class is spelled with in a report.
+    #[must_use]
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Answered => "answered",
+            Self::Absent => "absent",
+            Self::Refused => "refused",
+            Self::Retryable => "retryable",
+        }
+    }
+}
+
+/// A client for one endpoint: a runtime, an authority, and the retry rule.
+///
+/// It owns the tokio runtime it blocks on, because everything above it is synchronous: the tier's
+/// port is a `put`/`get`/`delete`/`list` a caller may use from a pass that is not async, and a
+/// caller that had to be `async` would have been an engine that cannot run in a test
+/// (`lakelet/4.1-ingest-protocol`'s boundary). One runtime per port, and a current-thread one: a
+/// tier's requests are sequential, and a work-stealing pool would be threads this module never
