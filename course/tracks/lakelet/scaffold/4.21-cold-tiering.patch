+# One suite, more than one implementation.
+#
+# `lakelet/4.21-cold-tiering` ships one spec (`tests/spec_tiering.rs`) and two implementations of
+# the tier's port: the local filesystem (`src/engine/tier/filesystem.rs`) and an S3-shaped endpoint
+# (`src/engine/tier/s3.rs`). The `conformance@2` gate reads this file, runs this step's `run.cmd`
+# once per backend with `KILN_BACKEND=` set to the name, and requires every run to pass — so the
+# suite is one suite, not two, and a backend that is half-written fails the step.
+#
+# It says one backend, because that is what the scaffold ships: the second entry is this step's
+# own work, and a declaration smaller than the gate's number is a failure rather than a block.
+backends = ["local"]
