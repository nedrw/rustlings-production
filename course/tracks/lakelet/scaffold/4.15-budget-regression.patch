index 0000000..4b3f72e
--- /dev/null
+++ b/tests/attribution.rs
@@ -0,0 +1,318 @@
+//! The attribution lane's harness for `lakelet/4.15-budget-regression`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.15-budget-regression
+//! --slow` runs, and the counts it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.15-budget-regression.toml`.
+//!
+//! What it measures is **work per phase, and never the clock**: the same store the pruning lane
+//! builds (`tests/budget_pruning.rs`, `lakelet/4.14-index-pruning`), two fixed queries asked of it,
+//! and the phase profile of each. A count is the same number on a loaded machine as on an idle one,
+//! which is why `kiln`'s budget gate compares counts (handoff M2 §1.1) and why no run of this file
+//! can flake because something else was compiling. `cargo test -p lakelet --test attribution --
+//! --nocapture` prints the lines by hand; the `lakelet-budget` prefix is what the gate reads.
+//!
+//! # The workload is its sibling lane's, on purpose
+//!
+//! Twenty-four segments, one hour each, sixty records each: thirty samples of `cpu,host=h{i}` — the
+//! segment's own host, a series that appears in exactly one segment — and thirty of
+//! `cpu,host=fleet`, a series every segment carries. That is the shape
+//! `lakelet/4.14-index-pruning` measures pruning on, and the two lanes are comparable because they
+//! ask the same store the same questions. Where the pruning lane counts *what was not read*, this
+//! one counts *what the read cost and where*.
+//!
+//! Two queries, both over the last twelve hours, one window an hour:
+//!
+//! * **`selective`** asks for `host = 'h20'`, the series exactly one segment carries. The manifest
+//!   rules twelve segments out by their stated spans and the index rules eleven more out, so one
+//!   segment is opened — 60 records decoded, 30 of them kept by the predicate, 30 folded into one
+//!   bucket;
+//! * **`wide`** asks for `host = 'fleet'`, the series *every* segment carries. Its span meets the
+//!   same twelve segments and the index can rule none of them out — a filter that answered "no"
+//!   about a pair a segment really holds would be a lost record — so twelve segments are opened:
+//!   720 records decoded, 360 kept, 360 folded into twelve buckets.
+//!
+//! **The diff between the two profiles is the point of the lane**: `decode_saved` is the work the
+//! index saved on this store, in the phase it saved it in, and a run whose `decode` moved without
+//! `blocks` moving is a run whose decode got more expensive per record rather than a run that read
+//! more files. A profile is not a budget: it is what a budget going red is read *with*.
+//!
+//! # The metrics, and why each is here
+//!
+//! * `selective_<phase>` and `wide_<phase>` — the seven phases of each run, named for the query they
+//!   belong to: a name printed twice would be one metric whose value depended on which run the
+//!   reader looked at, and the gate reads names, not positions. The phase names come from
+//!   `Phase::ALL` and `Phase::name` rather than from string literals here, because a profile whose
+//!   spelling lives in two places is a profile that drifts;
+//! * `<role>_share_<phase>` — the same profile as whole percent of the run, for the phases that
+//!   ran: the answer to "where did this run's time-equivalent go" that a table of raw counts
+//!   leaves to the reader;
+//! * `decode_saved`, `filter_saved`, `aggregate_saved`, `segments_saved`, `bytes_saved` — the
+//!   selective run against the wide one. This is the lane's story as five numbers, and the one the
+//!   plan's sixth acceptance drill moves;
+//! * `merged_total` and `merged_runs` — the two runs merged into one report (`Trace::merge`). The
+//!   total is checked against the two profiles added up: a merge that lost a phase's work is a
+//!   report nobody can trust, and it is caught here rather than in a reader's arithmetic;
+//! * `refused_max` — zero. A store that refused something is a store this lane cannot judge by
+//!   counts alone, and the refusal is counted rather than raised so that a lane that cannot measure
+//!   says so in its own units.
+//!
+//! Nothing here reads a clock, a seed or the environment: the epoch, the timestamps, the series and
+//! the windows are all constants, so two runs of this file on two machines print the same counts.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness a learner can break by editing their own fixture would judge the
+//! fixture instead of the store.
+
+use std::path::{Path, PathBuf};
+
+use lakelet::engine::compaction::Segments;
+use lakelet::engine::query::exec::{self, Outcome};
+use lakelet::engine::query::parse::{Statement, parse};
+use lakelet::engine::trace::{Phase, Trace};
+use lakelet::protocol::batch::Record;
+
+/// Segments the store is built from.
+const SEGMENTS: u64 = 24;
+
+/// Records one sealed segment holds: thirty of its own host and thirty of the fleet's.
+const PER_SERIES: usize = 30;
+
+/// Milliseconds between two samples of one series: two minutes, so one hour is thirty samples.
+const STEP: u64 = 120_000;
+
+/// One hour — the width of a segment, of a window, and of the arithmetic below.
+const HOUR: u64 = 3_600_000;
+
+/// The first timestamp of every segment, on an hour boundary.
+///
+/// `1_699_999_200_000` is `472_222 * HOUR` exactly, so a segment's span, the query's range and the
+/// grid its windows count on all start on numbers a reader can check by hand.
+const EPOCH: u64 = 472_222 * HOUR;
+
+/// The first hour the queries ask about: half the store, so that the *manifest* prunes the other
+/// half.
+const FROM_HOUR: u64 = SEGMENTS / 2;
+
+/// The series every segment carries, so that a segment's vocabulary is never one term.
+const FLEET: &str = "fleet";
+
+/// The host the selective query asks for: the one series that appears in exactly one segment, and in
+/// the second half of the store.
+const SELECTIVE: u64 = 20;
+
+/// The records one sealed segment holds: its own host, then the fleet's, one series after the other.
+fn segment_records(segment: u64) -> Vec<Record> {
+    let start = EPOCH + segment * HOUR;
+    let mut records: Vec<Record> = (0..PER_SERIES)
+        .map(|offset| Record {
+            series: format!("cpu,host=h{segment}"),
+            ts_millis: (start + offset as u64 * STEP) as i64,
+            value: value_of(segment * PER_SERIES as u64 + offset as u64),
+        })
+        .collect();
+    records.extend((0..PER_SERIES).map(|offset| Record {
+        series: format!("cpu,host={FLEET}"),
+        ts_millis: (start + offset as u64 * STEP) as i64,
+        value: value_of(segment * PER_SERIES as u64 + offset as u64),
+    }));
+    records
+}
+
+/// The value of sample `position`: distinct bit patterns, and no structure a column can exploit.
+///
+/// The bytes a segment costs are part of what this lane compares, and a store of values a compressor
+/// likes would make those counts an argument about `zstd` rather than about where a query's work
+/// went.
+fn value_of(position: u64) -> f64 {
+    let mixed = position.wrapping_mul(2_654_435_761) % 100_003;
+    mixed as f64 / 8.0
+}
+
+/// The query one role asks of the store: `host` over the second half of it, one window an hour.
+fn text(host: &str) -> String {
+    format!(
+        "SELECT count(value) FROM cpu WHERE host = '{host}' AND ts BETWEEN {} AND {} \
+         GROUP BY time(1h), series",
+        EPOCH + FROM_HOUR * HOUR,
+        EPOCH + SEGMENTS * HOUR
+    )
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "lakelet-attribution-{label}-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the store lives.
+    fn path(&self) -> &Path {
+        &self.path
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// What one query of the lane cost and answered.
+///
+/// Failures are counted rather than raised for the reason `tests/budget_pruning.rs` counts its own:
+/// this file's numbers are what a gate compares, and a harness that panicked would report nothing at
+/// all instead of the count that moved.
+#[derive(Debug)]
+struct Run {
+    /// The phase profile of the run: empty when the store refused the question.
+    trace: Trace,
+    /// Segments the run opened.
+    opened: u64,
+    /// Bytes the segments it opened cost, from the manifest.
+    bytes_read: u64,
+    /// Something the store refused, counted rather than raised.
+    refused: u64,
+}
+
+/// Build the store the lane asks about: `SEGMENTS` hours, one hour to a segment.
+///
+/// The count of refusals comes back rather than a store, because a store that could not be sealed is
+/// a lane that cannot measure and has to say so in the units the gate reads.
+fn build(directory: &Dir) -> u64 {
+    let mut store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            return 1;
+        }
+    };
+    for segment in 0..SEGMENTS {
+        if let Err(error) = store.seal(&segment_records(segment)) {
+            eprintln!("segment {segment} could not be sealed: {error}");
+            return 1;
+        }
+    }
+    0
+}
+
+/// Ask one query of the store in `directory`, and count what it cost.
+fn ask(directory: &Dir, text: &str) -> Run {
+    let mut run = Run {
+        trace: Trace::new(),
+        opened: 0,
+        bytes_read: 0,
+        refused: 0,
+    };
+    let store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            run.refused += 1;
+            return run;
+        }
+    };
+    let query = match parse(text) {
+        Ok(Statement::Query(query)) | Ok(Statement::Explain(query)) => query,
+        Err(refusal) => {
+            eprintln!("the query was refused by the grammar: {refusal}");
+            run.refused += 1;
+            return run;
+        }
+    };
+    let snapshot = store.snapshot();
+    let outcome: Outcome = match exec::execute(&snapshot, &query) {
+        Ok(outcome) => outcome,
+        Err(refusal) => {
+            eprintln!("the query was refused by the store: {refusal}");
+            run.refused += 1;
+            return run;
+        }
+    };
+    run.trace = outcome.trace().clone();
+    run.opened = outcome.segments_opened();
+    run.bytes_read = outcome.bytes_read();
+    run
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+/// One run's profile: every phase's count, then the phases that ran as whole percent of the run.
+///
+/// The names come from [`Phase::name`], so a phase that was added or renamed is spelled once, in the
+/// module that owns the phases, and this file follows it.
+fn profile(role: &str, trace: &Trace) {
+    for phase in Phase::ALL {
+        metric(&format!("{role}_{}", phase.name()), trace.count(phase));
+    }
+    for (phase, percent) in trace.shares() {
+        metric(&format!("{role}_share_{}", phase.name()), percent);
+    }
+}
+
+/// What the wide run cost beside the selective one: the lane's story as counts.
+///
+/// Both are subtractions of a run that read more from a run that read less, in the phase the
+/// difference lives in. The segments and bytes are the outcome's own counters rather than the
+/// trace's, because "what was not read" is the plan's account of itself
+/// (`lakelet/4.14-index-pruning`) and this lane's phases are the work the read cost.
+fn saved(selective: &Run, wide: &Run) {
+    for phase in [Phase::Decode, Phase::Filter, Phase::Aggregate] {
+        metric(
+            &format!("{}_saved", phase.name()),
+            wide.trace
+                .count(phase)
+                .saturating_sub(selective.trace.count(phase)),
+        );
+    }
+    metric(
+        "segments_saved",
+        wide.opened.saturating_sub(selective.opened),
+    );
+    metric(
+        "bytes_saved",
+        wide.bytes_read.saturating_sub(selective.bytes_read),
+    );
+}
+
+#[test]
+fn the_attribution_profile() {
+    let directory = Dir::new("attribution");
+    let refused = build(&directory);
+    let selective = ask(&directory, &text(&format!("h{SELECTIVE}")));
+    let wide = ask(&directory, &text(FLEET));
+
+    // Each run's seven phases, and the same profile as whole percent of that run. A number a phase
+    // did not charge is a zero, and a zero is a metric: "decode did not happen" is the answer a
+    // reader of a broken store needs, and leaving the line out would make the gate unable to say
+    // whether the harness measured it.
+    profile("selective", &selective.trace);
+    profile("wide", &wide.trace);
+
+    // The two runs against each other: the work the index saved, in the phase it saved it in.
+    saved(&selective, &wide);
+
+    // And the two runs as one report. A caller that answers two questions keeps one account of the
+    // pair, and this is that account: the counts add, and the runs behind them add with them.
+    let mut merged = selective.trace.clone();
+    merged.merge(&wide.trace);
+    metric("merged_total", merged.total());
+    metric("merged_runs", merged.runs());
+
+    // A store that refused something is a store this lane cannot judge by counts alone.
+    metric("refused_max", refused + selective.refused + wide.refused);
+}
