+/// One step of a zone's table: from `from_millis` on, the zone is `offset_millis` from UTC.
+///
+/// Both numbers are milliseconds rather than hours, because that is the unit a caller's timestamp
+/// is in and the unit a local day is computed in: a conversion per lookup would be a rounding per
+/// lookup.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct Change {
+    /// The first millisecond since the Unix epoch the offset applies at.
+    from_millis: u64,
+    /// The offset from UTC, in milliseconds. `3_600_000` is `+01:00`.
+    offset_millis: i64,
+}
+
+/// What a zone knows: a table of transitions, or one offset that never changes.
+///
+/// The two cases are genuinely different and the type says so. A named zone is a *history* — the
+/// transitions this build was built with, and nothing before the first one — while a fixed offset
+/// is arithmetic a caller wrote down, true for every instant there is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Table {
+    /// One offset from UTC for every instant the zone covers: `+02:00`, or UTC itself.
+    Fixed(i64),
+    /// The transitions this build ships, ascending, each in force from its own instant on.
+    Shipped(&'static [Change]),
+}
+
+/// A time zone: a name and the offset transitions this deployment knows about.
+///
+/// The name is a `Cow` because a zone has exactly two provenances and both of them are names: one
+/// of [`Zone::SHIPPED`], which is a `&'static str` this build was compiled with, and a fixed
+/// offset a caller wrote, which is spelled `+HH:MM` and is stored as the caller wrote it. A
+/// `&'static str` cannot hold both, and leaking one string per distinct offset typed at a command
+/// line is not a trade this store makes.
+///
+/// `from_millis` and `to_millis` are the span this build's table **covers**, which is a different
+/// fact from where its transitions are: `Europe/Berlin` is known for 2024 and 2025 in this build,
+/// and outside that span [`Zone::offset_at`] says so rather than extrapolating a rule it does not
+/// have. They are counted from the Unix epoch like every other millisecond in this crate — the
+/// unit a `Range` is in, so the comparison a query needs is a comparison and not a conversion.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Zone {
+    /// What the zone is called: a shipped name, or the offset a caller wrote.
+    name: Cow<'static, str>,
+    /// The first millisecond since the Unix epoch this build's table covers.
+    from_millis: u64,
+    /// The first one after the last it covers.
+    to_millis: u64,
+    /// What it knows about those instants.
+    table: Table,
+}
+
+/// The milliseconds in an hour, for reading the table below.
+const HOUR_MILLIS: i64 = 3_600_000;
+
+/// The transitions `Europe/Berlin` had in the two years this build knows about.
+///
+/// Five entries, in the order they happened, and each one is a real instant a reader can check the
+/// way an operator checks a zone: the offset in force when the table opens, the two changes of
+/// 2024, and the two of 2025. The European rule is the last Sunday of March and the last Sunday of
+/// October at 01:00 UTC, which is why the instants look arbitrary and are not.
+const BERLIN_CHANGES: [Change; 5] = [
+    // 2024-01-01T00:00:00+01:00: the offset the table opens on, and the first instant it covers.
+    Change {
+        from_millis: 1_704_063_600_000,
+        offset_millis: HOUR_MILLIS,
+    },
+    // 2024-03-31T01:00:00Z: 02:00 local becomes 03:00, and that day is 23 hours long.
+    Change {
+        from_millis: 1_711_846_800_000,
+        offset_millis: 2 * HOUR_MILLIS,
+    },
+    // 2024-10-27T01:00:00Z: 03:00 local becomes 02:00, and that day is 25 hours long.
+    Change {
+        from_millis: 1_729_990_800_000,
+        offset_millis: HOUR_MILLIS,
+    },
+    // 2025-03-30T01:00:00Z: the same rule, the next year.
+    Change {
+        from_millis: 1_743_296_400_000,
+        offset_millis: 2 * HOUR_MILLIS,
+    },
+    // 2025-10-26T01:00:00Z.
+    Change {
+        from_millis: 1_761_440_400_000,
+        offset_millis: HOUR_MILLIS,
+    },
+];
+
+/// `Europe/Berlin` as this build was built with it: two years of transitions, and nothing outside
+/// them.
+const BERLIN: Zone = Zone {
+    name: Cow::Borrowed("Europe/Berlin"),
+    from_millis: 1_704_063_600_000,
+    to_millis: 1_767_222_000_000,
+    table: Table::Shipped(&BERLIN_CHANGES),
+};
+
+/// The widest a fixed offset may be from UTC, in hours.
+///
+/// Fourteen, and it is a real bound rather than a sanity check: no zone has ever been further from
+/// UTC than `+14:00` (Kiribati's Line Islands), so a value beyond it is a typo — and a typo that
+/// quietly answered would put a bucket fourteen hours from the one the caller meant.
+const MAX_OFFSET_HOURS: i64 = 14;
+
+impl Zone {
+    /// UTC: zero offset, for every instant an `i64` can name.
+    pub const UTC: Zone = Zone {
+        name: Cow::Borrowed("UTC"),
+        from_millis: 0,
+        to_millis: u64::MAX,
+        table: Table::Fixed(0),
+    };
+
+    /// The names this build has a table for: what a caller may write in place of an offset, and
+    /// the list a refusal naming an unknown zone reads from.
+    pub const SHIPPED: [&'static str; 2] = ["UTC", "Europe/Berlin"];
+
+    /// The zone a name names.
+    ///
+    /// Two provenances, and the order they are tried in is the point: a name [`Zone::SHIPPED`]
+    /// lists gets **this build's table** for that zone — its transitions, and the span they cover
+    /// — while anything else is read as a fixed offset `+HH:MM`/`-HH:MM`, which is arithmetic the
+    /// caller supplied and which this build therefore knows for every instant. A name that is
+    /// neither is refused rather than defaulted to UTC, because a `--zone Europe/Berlinn` that
+    /// quietly answered UTC is a dashboard a day out that nobody can explain.
+    ///
+    /// # Errors
+    ///
+    /// [`Refusal::Syntax`] — the caller's class, `2` — when the name is not one this build ships
+    /// and is not a `±HH:MM` offset with two digits in each field. The offset the refusal carries
+    /// is a byte offset into the *name* the caller wrote, since a zone is not part of a query
+    /// text: byte `0` is the name itself, which is where a name nobody shipped is wrong.
+    pub fn parse(name: &str) -> Result<Zone, Refusal> {
+        todo!(
+            "lakelet/4.12-aggregation-correctness: the shipped names first, then `±HH:MM`; a \
+               name that is neither is refused with `Refusal::Syntax`"
+        )
+    }
+
+    /// What this zone is called: a shipped name, or the offset a caller wrote.
+    #[must_use]
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// The half-open span of instants this build's table covers, as `[from, to)`.
+    ///
+    /// This is the fact a refusal has to state to be useful: "this build does not know that
+    /// instant" is not actionable, and "this build knows 2024-01-01 through 2025-12-31" tells a
+    /// caller exactly which part of their range cannot be answered. `UTC` and a fixed offset cover
+    /// every instant, and a shipped table covers the span it ships.
+    #[must_use]
+    pub const fn covers(&self) -> (u64, u64) {
+        todo!()
+    }
+
+    /// How far `ts_millis` is from UTC in this zone, or `None` when the table does not cover that
+    /// instant.
+    ///
+    /// `None` is the whole of this build's honesty about time zones. A shipped table is a *file*:
+    /// it names the transitions it was built with and there is no rule in it for 2019 or for 2029,
+    /// and a query answered with a guessed offset would put a bucket an hour from the one the
+    /// caller asked about, twice a year, in a way nobody can see. So the offset is stated where
+    /// the table has it and refused where it does not, while a fixed offset is stated everywhere.
+    ///
+    /// A timestamp before the Unix epoch is read as the epoch, which is the same choice
+    /// [`Window::partition`](super::downsample::Window::partition) makes for the same clock: there
+    /// is no instant below zero for a clock that was wrong to land in, and a table whose span
+    /// starts in 2024 covers neither.
+    #[must_use]
+    pub fn offset_at(&self, ts_millis: i64) -> Option<i64> {
+        todo!(
+            "lakelet/4.12-aggregation-correctness: the covered span first, then the last change \
+               at or before the instant"
+        )
+    }
+
+    /// The half-open span of the *local* day `ts_millis` falls in, as milliseconds since the Unix
+    /// epoch in UTC, or `None` when the table does not cover the day.
+    ///
+    /// The two numbers are the instants the local day begins and ends, which is what a bucket key
+    /// has to be: a dashboard asked for a point a day has to print one *instant* per day, and it
+    /// has to be the instant the day started — not midnight in the caller's own offset, and not
+    /// the start of the absolute-grid window the day happens to overlap.
+    ///
+    /// The span is the point of the whole module. On the day a zone springs forward the local day
+    /// is **23 hours** long and on the day it falls back it is **25**, and that is not an artefact
+    /// to be smoothed away: it is the answer. A dashboard that counted 86 400 000 milliseconds
+    /// from the previous midnight would label the samples of two different days with the same date
+    /// twice a year, and an hour of a 25-hour day's samples would be missing. The boundaries are
+    /// found by resolving local midnight against the offset in force *at that midnight*, which is
+    /// why a day whose offset changes part-way through still comes out as one span.
+    ///
+    /// A local day that would begin before the Unix epoch is the **first** day there is, which is
+    /// the same choice [`Window::partition`](super::downsample::Window::partition) makes for the
+    /// same clock: a day that begins in 1969 is not a pair of `u64`s, and a record that carries one
+    /// belongs to the first day this store can name rather than to no day at all.
+    #[must_use]
+    pub fn local_day(&self, ts_millis: i64) -> Option<(u64, u64)> {
+        todo!(
+            "lakelet/4.12-aggregation-correctness: the offset at the instant, the local \
+               midnight, and the offset in force at that midnight"
+        )
+    }
+}
