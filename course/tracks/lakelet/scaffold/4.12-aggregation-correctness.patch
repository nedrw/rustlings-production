+    /// addition did not round for a reason an `f64` can *round*: an infinity, a `NaN`, or an
+    /// overflow. `inf - inf` is not a number, and a sum that is perfectly well defined (`1 + inf`)
+    /// must not be turned into one by an accumulator that meant well.
+    pub fn add(&mut self, value: f64) {
+        todo!(
+            "lakelet/4.12-aggregation-correctness: the total, the part the addition dropped, \
+               and the count"
+        )
+    }
+
+    /// The sum, as well as this accumulator can state it: the total plus what the additions left
+    /// behind.
+    #[must_use]
+    pub const fn value(&self) -> f64 {
+        todo!()
+    }
+
+    /// How many values have been added, exactly.
+    #[must_use]
+    pub const fn count(&self) -> u64 {
+        todo!()
+    }
+
+    /// What the values average to, or `None` when there are none.
+    ///
+    /// An empty accumulator has no mean, and it is `None` rather than `NaN` because a mean of
+    /// nothing is not a number a caller can use: `NaN` propagates through every comparison that
+    /// follows it and shows up as a missing point on a dashboard an hour later.
+    #[must_use]
+    pub fn mean(&self) -> Option<f64> {
+        todo!(
+            "lakelet/4.12-aggregation-correctness: no values is `None`, and otherwise the sum \
+               over the count"
+        )
+    }
+}
