diff --git a/tests/budget_compaction.rs b/tests/budget_compaction.rs
new file mode 100644
index 0000000..2668f83
--- /dev/null
+++ b/tests/budget_compaction.rs
@@ -0,0 +1,314 @@
+//! The rewrite budget's harness for `lakelet/4.8-compaction`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.8-compaction
+//! --slow` runs, and the counts it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.8-compaction.toml`.
+//!
+//! What it measures is **bytes and files, never the clock**: a store of sixteen comparable segments
+//! is compacted until the policy has nothing left to do, and what that cost is a set of counts — how
+//! many merges it took, how many files are left, how many bytes were written, and how many of them
+//! the store stopped holding. A count is the same number on a loaded machine as on an idle one,
+//! which is why `kiln`'s budget gate compares counts (`handoff M2 §1.1`) and why no run of this file
+//! can flake because something else was compiling. `cargo test -p lakelet --test budget_compaction
+//! -- --nocapture` prints the lines by hand; the `lakelet-budget` prefix is what the gate reads.
+//!
+//! The number this lane exists for is `bytes_rewritten_per_byte_removed_max`: a merge writes bytes
+//! that were already written once, in exchange for the store's files becoming fewer and its
+//! encodings becoming better. **Too eager a policy** — merging every pair of vaguely similar
+//! segments as soon as there are two, or merging the whole store on every call — spends that write
+//! bandwidth over and over and removes almost nothing, which is the failure this bound names; **too
+//! lazy a policy** leaves `segments_after` high (`merges` and the file count are where a policy's
+//! lean shows up as a count). The baselines are the policy `Policy::DEFAULT` ships with answering a
+//! store of this shape, and the step's page argues both directions.
+//!
+//! The workload is deliberately **not** one a merge can compress its way out of: the series names
+//! and the clock are structure, but the values are high-cardinality, so the value column is written
+//! plain and a merge's saving is the framing and the dictionary it shares. A workload that
+//! compresses well across a merge makes write amplification look like a bargain (`4.7`'s own
+//! budget measures that), and this lane is about the price.
+//!
+//! The records are checked as well as counted: `records_kept` has to be every record that was
+//! sealed, in the order it was sealed, and `records_lost_max` counts the ones that were not. A merge
+//! that removed bytes by dropping records would pass every byte bound in this file, which is why the
+//! conservation count is here.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness a learner can break by editing their own fixture would judge the
+//! fixture instead of the store.
+
+use std::path::PathBuf;
+
+use lakelet::engine::compaction::{Segments, file_of};
+use lakelet::protocol::batch::Record;
+
+/// Segments the store is built from before anything is merged.
+const SEGMENTS: usize = 16;
+
+/// Records one sealed segment holds.
+const PER_SEGMENT: usize = 128;
+
+/// Series the workload spreads its segments over: one series per segment, cycling.
+const SERIES: usize = 4;
+
+/// Milliseconds between two samples of one series: a clock that advances by a constant step.
+const STEP: i64 = 1000;
+
+/// The first timestamp of every series, so the workload is the same on every machine.
+const EPOCH: i64 = 1_700_000_000_000;
+
+/// How many merges one pass may take before it stops asking.
+///
+/// Larger than the number a policy needs for this store (sixteen segments, four at a time, is five
+/// merges and then one file) so that a policy which never settles is *measured* rather than allowed
+/// to run for ever: a merge of one file into one file removes nothing, and a pass that kept asking
+/// would rewrite the whole store once per call until this bound stopped it.
+const LIMIT: usize = 16;
+
+/// The name of one series: a metric and its labels, as a client writes them.
+fn name(series: usize) -> String {
+    format!("cpu,host=h{series}")
+}
+
+/// The records one sealed segment holds: one series' window of `PER_SEGMENT` samples.
+///
+/// The clock steps inside the window and starts again in the next one, and the values are
+/// high-cardinality — no two samples share a bit pattern, so the value column is plain and a merge
+/// cannot make it smaller. What a merge saves on this workload is the series name written once
+/// instead of four times, the segment header, and the `zstd` frame: about a third of the store,
+/// which is what `bytes_removed` counts.
+fn segment_records(index: usize) -> Vec<Record> {
+    (0..PER_SEGMENT)
+        .map(|offset| Record {
+            series: name(index % SERIES),
+            ts_millis: EPOCH + offset as i64 * STEP,
+            value: value_of(index * PER_SEGMENT + offset),
+        })
+        .collect()
+}
+
+/// The value of sample `position`: distinct bit patterns, and no structure a column can exploit.
+///
+/// A store of temperature readings compresses across a merge — the same series, a clock that keeps
+/// stepping, values that hold still. A store of latency quantiles does not, and it is the second
+/// store this lane is written for: on the first one, the bytes a merge writes come back with
+/// interest, and a *rewrite* budget would be measuring the compressor instead of the policy.
+fn value_of(position: usize) -> f64 {
+    let mixed = (position as u64).wrapping_mul(2_654_435_761) % 100_003;
+    mixed as f64 / 8.0
+}
+
+/// Every record the store is given, in the order it is given them.
+fn given() -> Vec<Record> {
+    (0..SEGMENTS).flat_map(segment_records).collect()
+}
+
+/// A store directory of this run's own, removed when it is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path =
+            std::env::temp_dir().join(format!("lakelet-compaction-{label}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the store lives.
+    fn path(&self) -> &PathBuf {
+        &self.path
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// What one pass over the store cost, counted.
+struct Pass {
+    /// Segments the store was built from.
+    sealed: u64,
+    /// Records they held.
+    records: u64,
+    /// Merges that happened before the policy had nothing left to do (or [`LIMIT`] stopped it).
+    merges: u64,
+    /// Segments the store is made of at the end.
+    after: u64,
+    /// Files the store stopped keeping.
+    removed: u64,
+    /// Bytes the store's segments cost before any merge.
+    bytes_before: u64,
+    /// Bytes they cost after.
+    bytes_after: u64,
+    /// Bytes the merges wrote.
+    rewritten: u64,
+    /// Records the store hands back at the end.
+    kept: u64,
+    /// Records that did not come back, or came back as something else.
+    lost: u64,
+    /// Whether the policy had nothing left to merge when the pass stopped asking.
+    settled: bool,
+    /// Something the store refused, counted rather than raised: a store that cannot do this is what
+    /// the gate's counts are for.
+    refused: u64,
+}
+
+/// Build a store of [`SEGMENTS`] sealed segments, merge until the policy is done, and count it.
+///
+/// The failures are counted rather than raised for the reason `tests/budget_segments.rs` counts its
+/// own: this file's numbers are what a gate compares, and a harness that panicked would report
+/// nothing at all instead of the count that moved.
+fn pass() -> Pass {
+    let directory = Dir::new("budget");
+    let mut counted = Pass {
+        sealed: 0,
+        records: 0,
+        merges: 0,
+        after: 0,
+        removed: 0,
+        bytes_before: 0,
+        bytes_after: 0,
+        rewritten: 0,
+        kept: 0,
+        lost: 0,
+        settled: false,
+        refused: 0,
+    };
+    let mut store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            return counted;
+        }
+    };
+    for index in 0..SEGMENTS {
+        let records = segment_records(index);
+        if let Err(error) = store.seal(&records) {
+            eprintln!("segment {index} could not be sealed: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+        counted.sealed += 1;
+        counted.records += records.len() as u64;
+        let file = file_of(directory.path(), counted.sealed - 1);
+        counted.bytes_before += std::fs::metadata(file).map_or(0, |metadata| metadata.len());
+    }
+    let before = store.manifest().segments().len() as u64;
+
+    for _ in 0..LIMIT {
+        match store.compact() {
+            Ok(Some(report)) => {
+                counted.merges += 1;
+                counted.rewritten += report.bytes_out();
+            }
+            Ok(None) => {
+                counted.settled = true;
+                break;
+            }
+            Err(error) => {
+                eprintln!("a merge was refused: {error}");
+                counted.refused += 1;
+                break;
+            }
+        }
+    }
+
+    counted.after = store.manifest().segments().len() as u64;
+    counted.removed = before.saturating_sub(counted.after);
+    counted.bytes_after = store.manifest().bytes();
+    match store.snapshot().records() {
+        Ok(read) => {
+            let wanted = given();
+            counted.kept = read.len() as u64;
+            counted.lost = (wanted.len().saturating_sub(read.len())) as u64
+                + read
+                    .iter()
+                    .zip(&wanted)
+                    .filter(|(read, wanted)| {
+                        read.series != wanted.series
+                            || read.ts_millis != wanted.ts_millis
+                            || read.value.to_bits() != wanted.value.to_bits()
+                    })
+                    .count() as u64;
+        }
+        Err(error) => {
+            eprintln!("the store could not be read back: {error}");
+            counted.refused += 1;
+            counted.lost = SEGMENTS as u64 * PER_SEGMENT as u64;
+        }
+    }
+    counted
+}
+
+/// One metric line: the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+/// One ratio line, to four decimals — a ratio of two counts, so it is as steady as they are.
+fn ratio(name: &str, value: f64) {
+    println!("lakelet-budget {name}={value:.4}");
+}
+
+#[test]
+fn the_compaction_rewrite_budget() {
+    let counted = pass();
+
+    // What the workload was, so a store with nothing in it cannot pass a byte bound: the shape is
+    // counted as well as the cost.
+    metric("segments_sealed", counted.sealed);
+    metric("records_sealed", counted.records);
+
+    // What the merge did to the store: how many calls the policy needed, how many files it left,
+    // and how many it removed. Fewer files is what a reader pays for, so a policy that is too lazy
+    // fails here, and a policy that merges pairs answers `merges = 14` where this build's answers
+    // five.
+    metric("merges", counted.merges);
+    metric("segments_after", counted.after);
+    metric("files_removed", counted.removed);
+    // Nothing left to merge when the pass stopped asking. An upper bound of zero: a policy that
+    // still had a plan after [`LIMIT`] calls is a policy that never settles, whatever its byte
+    // counts say.
+    metric("plan_left_max", u64::from(!counted.settled));
+
+    // And what it did to the records: every one that was sealed comes back, once, in order. The
+    // bound of zero is the point — a merge that removed bytes by dropping records would pass every
+    // byte count in this file.
+    metric("records_kept", counted.kept);
+    metric("records_lost_max", counted.lost);
+
+    // The bytes. `bytes_after_max` and `bytes_rewritten_max` are upper bounds: a store that came
+    // out smaller, or a pass that wrote less to get there, passes, and only a bigger one fails.
+    // `bytes_removed` is the difference of two counts rather than a number the store reported, so a
+    // store that lost track of its own files cannot hide in it.
+    metric("bytes_after_max", counted.bytes_after);
+    metric("bytes_rewritten_max", counted.rewritten);
+    metric(
+        "bytes_removed",
+        counted.bytes_before.saturating_sub(counted.bytes_after),
+    );
+
+    // The number this lane exists for: bytes written by merges per byte the store stopped holding.
+    // An upper bound, so a policy that rewrites less for the same work passes and only a more
+    // expensive one fails — merging pairs costs about ten here and merging the whole store on every
+    // call costs about forty.
+    ratio(
+        "bytes_rewritten_per_byte_removed_max",
+        counted.rewritten as f64
+            / counted
+                .bytes_before
+                .saturating_sub(counted.bytes_after)
+                .max(1) as f64,
+    );
+
+    // A store that refused something is a store this lane cannot judge by bytes alone: a merge error
+    // shows up as the counts moving, and this says why in one line.
+    metric("refused_max", counted.refused);
+}
