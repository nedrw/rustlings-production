@@ -0,0 +1,162 @@
+//! What a reader holds while a merge happens: the set of segments that *were* the store.
+//!
+//! Step `lakelet/4.8-compaction`. A merge takes several segments and leaves one, and the moment
+//! that becomes true is the moment a reader may not be in the middle of: a query that walked half
+//! of the old set and then half of the new one would answer a record twice, or answer neither copy
+//! of it, and no count would tell anybody. So a read is not "read the newest segments" — it is
+//! **take a snapshot and read that**: a value naming the segments that were the store when the read
+//! began, in their order, and that goes on naming them however many merges happen beside it.
+//!
+//! ```text
+//!   reader                    store                        disk
+//!   ──────                    ─────                        ────
+//!   snapshot()  ───────────▶  set: epoch 7, [3,4,5,6]
+//!   │                                                     segments 3,4,5,6
+//!   │                         merge + install ────────▶   manifest: epoch 8, [7]
+//!   │                         (3,4,5,6 are retired)       segments 7, 3,4,5,6
+//!   records()   ───────────▶  3,4,5,6 — still there, because this snapshot holds them
+//!   drop()                                                segments 7 (3,4,5,6 are gone)
+//! ```
+//!
+//! The last line is the half nobody writes by accident: the files a merge replaces may only leave
+//! the disk once the last reader that named them has finished, which is why a snapshot holds more
+//! than a list of paths — it holds the *set*, and the set is what deletes the retired files when it
+//! is the last one left. A store that deleted them at the swap would answer a reader that began
+//! before it with whatever the operating system did to a file that no longer has a name.
+//!
+//! The order a snapshot reads in is the manifest's order: oldest segment first, in the order the
+//! records were accepted, which is the order a merge preserves and the order the store answers in.
+//! Nothing here sorts, groups or filters — `lakelet/4.9-retention` is where a record can stop being
+//! an answer, and `lakelet/4.11-query-engine` is where one is asked for.
+
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+
+use crate::engine::segment;
+use crate::error::Error;
+use crate::protocol::batch::Record;
+
+use super::plan::SegmentInfo;
+use super::{Manifest, file_of};
+
+/// The segments one read is allowed to see, and the files that may not leave while it does.
+///
+/// Private to the module: a caller holds a [`Snapshot`], which is this set behind an [`Arc`], and
+/// the store holds the same `Arc`. The moment both let go, the files a merge retired are deleted —
+/// so a reader that outlives a merge neither reads a half-store nor keeps a file alive forever.
+///
+/// The fields below are a suggestion rather than a contract: what this type has to do is in the
+/// module docs and in its own, and a store that keeps its readers whole some other way is a store
+/// whose spec still passes — the spec only ever holds a [`Snapshot`].
+#[derive(Debug)]
+pub(super) struct Set {
+    /// The store directory the segments live under.
+    directory: PathBuf,
+    /// The manifest this set is: the epoch and the segments that were the store.
+    manifest: Manifest,
+    /// Files this set may delete once nobody is reading it (a merge's inputs, retired).
+    retired: Mutex<Vec<PathBuf>>,
+}
+
+impl Set {
+    /// The set the manifest names, with nothing retired yet.
+    pub(super) fn new(directory: PathBuf, manifest: Manifest) -> Self {
+        Self {
+            directory,
+            manifest,
+            retired: Mutex::new(Vec::new()),
+        }
+    }
+
+    /// The manifest this set is.
+    pub(super) fn manifest(&self) -> &Manifest {
+        &self.manifest
+    }
+
+    /// Hand this set the files a merge replaced. They go when the last reader of this set does.
+    pub(super) fn retire(&self, indices: &[u64]) {
+        let _ = (self, indices);
+        todo!("step lakelet/4.8-compaction")
+    }
+}
+
+impl Drop for Set {
+    fn drop(&mut self) {
+        todo!("step lakelet/4.8-compaction")
+    }
+}
+
+/// What a reader holds: the segments that were the store when it took this snapshot.
+///
+/// Cheap to take and cheap to drop, and it answers the same thing whatever happens to the store
+/// beside it — that is the whole contract, and it is why a query takes one at the beginning and
+/// keeps it: a snapshot is the difference between "the answer" and "whatever the store happened to
+/// look like while I was asking".
+#[derive(Debug, Clone)]
+pub struct Snapshot {
+    /// The set this snapshot names.
+    held: Arc<Set>,
+}
+
+impl Snapshot {
+    /// A snapshot of the set `held` names.
+    pub(super) fn of(held: Arc<Set>) -> Self {
+        Self { held }
+    }
+
+    /// The epoch of the manifest this snapshot took: the number that changes when a merge is
+    /// installed, so two snapshots are two views of the same store exactly when they agree on it.
+    #[must_use]
+    pub fn epoch(&self) -> u64 {
+        self.held.manifest().epoch()
+    }
+
+    /// The segments this snapshot reads, oldest first.
+    #[must_use]
+    pub fn segments(&self) -> &[SegmentInfo] {
+        self.held.manifest().segments()
+    }
+
+    /// How many records this snapshot will hand back, from the manifest alone.
+    ///
+    /// The number a caller needs *before* it reads — how much memory an answer will take, whether a
+    /// query can be answered from one file — and the reason the manifest keeps each segment's
+    /// record count: counting them by reading every segment would be the cost this store is trying
+    /// to avoid.
+    #[must_use]
+    pub fn len(&self) -> u64 {
+        self.held.manifest().records()
+    }
+
+    /// `true` when this snapshot holds no records at all.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// How many bytes its segments cost together, from the manifest alone.
+    #[must_use]
+    pub fn bytes(&self) -> u64 {
+        self.held.manifest().bytes()
+    }
+
+    /// Every record this snapshot names, in order: one segment after another, each one's records as
+    /// they were written.
+    ///
+    /// A segment here is read through `lakelet/4.7-columnar-segments`' reader, which refuses bytes
+    /// that are not the format — so a damaged file ends this call with an error naming it, and never
+    /// with the records that happened to be readable before it. An answer with a hole in it is the
+    /// one outcome a store may not produce, and the manifest's own record count is checked against
+    /// what each file actually holds for the same reason: an index that disagrees with its files is
+    /// a store nobody can query.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Store`] when a segment's file cannot be read, and everything
+    /// [`segment::read`](crate::engine::segment::read) refuses — a segment that is not this build's
+    /// format, was cut, or was changed after it was written.
+    pub fn records(&self) -> Result<Vec<Record>, Error> {
+        let _ = self;
+        todo!("step lakelet/4.8-compaction")
+    }
+}
