+        let _ = (directory, cap);
+        todo!("the ledger of a store, rebuilt from the store")
+    }
+
+    /// The policy this ledger is judged by.
+    #[must_use]
+    pub const fn cap(&self) -> Cap {
+        self.cap
+    }
+
+    /// The live set, in name order: each tracked series and what it cost.
+    pub fn tracked(&self) -> impl Iterator<Item = (&str, &Cost)> {
+        // The scaffold answers nothing here: this is the one signature a `todo!()` cannot stand in
+        // for, because an opaque return type has to be a real value. Every case and the tool ask
+        // this for the whole live set, so an empty answer fails loudly rather than quietly.
+        std::iter::empty()
+    }
+
+    /// How many series the ledger holds right now: the number the cap's limit is measured against.
+    #[must_use]
+    pub fn tracked_count(&self) -> u64 {
+        self.tracked.len() as u64
+    }
+
+    /// What this series has cost, or `None` when the store does not track it.
+    ///
+    /// `None` is the informative answer: it says the store has no records naming this series that
+    /// it still holds, which is a different fact from a series that cost nothing.
+    #[must_use]
+    pub fn cost_of(&self, series: &str) -> Option<&Cost> {
+        let _ = series;
+        todo!("what one series has cost, or `None`")
+    }
+
+    /// How many series offers this ledger admitted.
+    #[must_use]
+    pub const fn series_admitted(&self) -> u64 {
+        self.admitted
+    }
+
+    /// How many series offers it refused.
+    #[must_use]
+    pub const fn series_rejected(&self) -> u64 {
+        self.rejected
+    }
+
+    /// How many series offers it was given: [`Registry::series_admitted`] plus
+    /// [`Registry::series_rejected`], added up here so that the identity is one call rather than
+    /// arithmetic a caller can get wrong.
+    #[must_use]
+    pub const fn offered(&self) -> u64 {
+        self.admitted.saturating_add(self.rejected)
+    }
+
+    /// Offer one series, and charge it what it carried when the store takes it.
+    ///
+    /// The rule is [`Cap`]'s: a series already in the ledger is always admitted, and a series the
+    /// store has never seen is admitted while the ledger has room for it. `records` and `bytes` are
+    /// what this offer carried, and `now` is when it happened — a timestamp in the record's own
+    /// units, handed in rather than read from a clock, so that a case can charge any moment it
+    /// likes and two runs of one workload report the same numbers.
+    ///
+    /// A refusal charges nothing: the series is not in the ledger, its cost is not moved, and the
+    /// only trace of it is [`Registry::series_rejected`].
+    pub fn admit(&mut self, series: &Series<'_>, records: u64, bytes: u64, now: u64) -> Admission {
+        let _ = (series, records, bytes, now);
+        todo!("one series offered, and what the cap answered")
+    }
+
+    /// Offer one frame's payload: every series its records name, judged as one batch.
+    ///
+    /// `None` when these bytes are not a batch this build can read. That is not a refusal and not an
+    /// error: the cap judges *records*, and payload bytes that decode to no records — the frames
+    /// `lakelet/4.1-ingest-protocol` accepts whatever a client sends, and a store's own budget
+    /// harnesses hand the write path payloads directly — name no series and are the write path's
+    /// business.
+    ///
+    /// The frame is judged whole, because the write path stores a payload whole or not at all: if
+    /// every series it names either is tracked already or fits beside the ones that are, the frame
+    /// is `Admitted` and each series is charged its share of the payload's bytes — shared out by
+    /// record count, so a store's per-series bytes add up to exactly the bytes it was handed.
+    /// Otherwise the frame is `Rejected`, every series it named is counted as rejected, and nothing
+    /// is charged, because nothing is written.
+    pub fn charge(&mut self, payload: &[u8]) -> Option<Admission> {
+        let _ = payload;
+        todo!("one frame's payload, and what the cap answered about it")
+    }
+
+    /// Rebuild the ledger against the sidecar indexes of the segments a store still holds.
+    ///
+    /// One rule per index, and both directions are the safe one:
+    ///
+    /// * a series **some** index may hold stays, with its window refolded to the extremes those
+    ///   indexes state (`SegmentIndex::zone`) — the store's own answer about when the series
+    ///   happened, rather than the one the log's records gave;
+    /// * a series **no** index may hold is dropped: the store has forgotten it, and a cap that
+    ///   counted forgotten names would refuse new ones for a store with room to spare;
+    /// * an index that is missing or damaged is [`SegmentIndex::unstated`], which may hold
+    ///   everything and therefore drops nothing. The ledger keeps a name it cannot rule out, which
+    ///   costs precision and never an answer.
+    ///
+    /// An empty slice is a store with no segments to check against — a directory whose write path
+    /// has never closed one — and it drops nothing for the same reason: a caller that has no
+    /// evidence has made no claim.
+    pub fn rebuild(&mut self, indexes: &[SegmentIndex]) {
