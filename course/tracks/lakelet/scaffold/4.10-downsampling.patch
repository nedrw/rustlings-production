+/// What a question answered: the buckets that held records, in order, and what the pass cost.
+///
+/// The three counts are the pass's own account of itself, and they are three different questions:
+/// [`Answer::scanned`] is what it looked at, [`Answer::series_matched`] is what survived the
+/// series filter, and [`Answer::in_range`] is what actually landed in a bucket. The last one is
+/// the identity a caller checks the rest of the answer against: it is the sum of the buckets'
+/// counts, so an answer whose buckets do not add up to it has lost or invented records.
+#[derive(Debug, Clone)]
+pub struct Answer {
+    /// The windows that held records, in ascending order of `start`.
+    buckets: Vec<Bucket>,
+    /// How many records of the input the pass looked at.
+    scanned: u64,
+    /// How many of those were inside the range.
+    in_range: u64,
+    /// How many of those were of the series that was asked for.
+    series_matched: u64,
+}
+
+impl Answer {
+    /// The buckets, oldest window first. Windows with no records are not here at all.
+    #[must_use]
+    pub fn buckets(&self) -> &[Bucket] {
+        todo!()
+    }
+
+    /// How many records the pass looked at: every record it was handed.
+    ///
+    /// This is the cost of a query before there is an index to avoid it, and it is why
+    /// `lakelet/4.14-index-pruning` exists: a segment's stated time range is what lets a later
+    /// query answer the same question without opening the file at all.
+    #[must_use]
+    pub fn scanned(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many records were inside the range *and* of the series that was asked for: the records
+    /// the buckets were computed from.
+    #[must_use]
+    pub fn in_range(&self) -> u64 {
+        todo!()
+    }
+
+    /// How many records were of that series, whether or not they were in the range. With no
+    /// series filter this is every record, so the three counts are one number.
+    #[must_use]
+    pub fn series_matched(&self) -> u64 {
+        todo!()
+    }
+
+    /// `true` when the range held no record at all, so there is nothing to draw.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        todo!()
+    }
+}
+
+/// Answer one question about `records`: a range of time, a window to count in, and an aggregate to
+/// put each window's records through.
+///
+/// The pass is one walk over the records and answers four things, in this order:
+///
+/// * it **looks at every record** ([`Answer::scanned`]) — there is no index yet, and pretending
+///   otherwise by stopping early would be a plan this store cannot keep;
+/// * it **keeps the series that was asked for** ([`Answer::series_matched`]), all of them when
+///   `series` is `None`;
+/// * it **keeps the ones in the range** ([`Answer::in_range`]), by the half-open rule
+///   [`Range::contains`] states;
+/// * it **puts each one in its window** ([`Window::partition`]) and accumulates.
+///
+/// Then it summarizes: `count` is how many records landed in the window, `sum` is what they add
+/// up to, `mean` is the sum divided by the count (never the other way round — a mean that
+/// overflowed a window's count would be a mean of nothing), and `min` and `max` are the extremes.
+/// The buckets come out in ascending order of `start`, one per window that held records, and only
+/// those.
+#[must_use]
+pub fn downsample(
+    records: &[Record],
+    series: Option<&str>,
+    range: Range,
+    window: Window,
+    aggregate: Aggregate,
+) -> Answer {
+    todo!(
+        "lakelet/4.10-downsampling: one walk, one bucketing, five ways to summarize a window — \
+         the rules are in this module's header"
+    )
+}
