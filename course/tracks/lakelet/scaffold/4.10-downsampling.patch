+++ b/tests/budget_downsample.rs
@@ -0,0 +1,343 @@
+//! The downsampling budget's harness for `lakelet/4.10-downsampling`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check lakelet/4.10-downsampling
+//! --slow` runs, and the counts it prints are compared with the baselines in
+//! `course/tracks/lakelet/budget/4.10-downsampling.toml`.
+//!
+//! What it measures is **records, windows and buckets, never the clock**: a store is built from a
+//! fixed set of timestamps and a fixed series list, one query is asked at a range the harness
+//! passes in, and what that cost is a set of counts — what the pass looked at, what landed in a
+//! bucket, how many windows it skipped, and how far the two ways of computing a mean are apart. A
+//! count is the same number on a loaded machine as on an idle one, which is why `kiln`'s budget
+//! gate compares counts (`handoff M2 §1.1`) and why no run of this file can flake because
+//! something else was compiling. `cargo test -p lakelet --test budget_downsample -- --nocapture`
+//! prints the lines by hand; the `lakelet-budget` prefix is what the gate reads.
+//!
+//! The workload is **shaped so the range starts and ends mid-window**, and so that five windows in
+//! the middle of it hold nothing at all. Both are load-bearing: a range that began and ended on
+//! window boundaries would never produce a partial bucket, and a workload with no gap would never
+//! exercise the rule that an empty window is *absent* from the answer rather than present with a
+//! zero in it. The shape is visible in the baselines — `windows` against `buckets_emitted` against
+//! `gaps` — and the counts that would move if either rule broke are `invented_windows_max` (a
+//! bucket that is not one of the range's windows — a gap printed as a bucket, windows anchored at
+//! the first record, or a window that reached outside the range to fill a partial one) and
+//! `records_unaccounted_max` (the buckets against the records the pass says it used).
+//!
+//! Three numbers are the ones this lane exists for:
+//!
+//! * `gaps` is the windows the range touches that the answer says nothing about — the "absent, not
+//!   zero" rule as a count, in a workload built to have five of them;
+//! * `records_per_bucket_max` bounds how much one window may hold, so a query that answered the
+//!   range as a single bucket fails here rather than in a graph;
+//! * `mean_gap_max` is the tolerance's own metric: the mean of the buckets against the **raw mean
+//!   of the same records**, computed by this file from the store's own records rather than from
+//!   the answer. The two are the same number only when every window holds records with the same
+//!   mean, and this workload is deliberately not that even: the first and the last window are
+//!   partial, so the two answers differ — slightly. The bound says they differ by no more than
+//!   that, which is the claim `lakelet/4.10-downsampling`'s `TOLERANCE` is written to make.
+//!
+//! A store directory of this run's own, made here rather than taken from `tests/support`: this file
+//! is the course's, and a harness a learner can break by editing their own fixture would judge the
+//! fixture instead of the query.
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+
+use lakelet::engine::compaction::Segments;
+use lakelet::engine::query::downsample::{self, Aggregate, Range, Window};
+use lakelet::protocol::batch::Record;
+
+/// One hour, in milliseconds: the unit the timestamps below are built on.
+const HOUR: u64 = 3_600_000;
+
+/// The window every bucket of the answer counts in: one minute.
+const WINDOW_MILLIS: u64 = 60_000;
+
+/// Milliseconds between two samples of one series: four a minute.
+const STEP_MILLIS: u64 = 15_000;
+
+/// The first timestamp of the workload, on an hour boundary — and therefore on the window grid,
+/// which is what makes every `start` in the answer a number a reader can predict.
+///
+/// `1_699_999_200_000` is `472_222 * HOUR` exactly: the same epoch `lakelet/4.9-retention`'s budget
+/// counts from, so the two lanes describe stores on the same grid.
+const ORIGIN: u64 = 472_222 * HOUR;
+
+/// The series the store holds, four of them at every timestamp.
+const SERIES: [&str; 4] = ["cpu,host=h0", "cpu,host=h1", "cpu,host=h2", "cpu,host=h3"];
+
+/// The one series the query asks for. Not the first, so an answer that quietly used the whole
+/// store's records is a different number rather than the same one.
+const ASKED: &str = "cpu,host=h2";
+
+/// The minutes of the workload that hold samples, as `[start, end)` pairs.
+///
+/// Minutes `8..13` hold nothing, which is five windows of the answer with no records in them: the
+/// gap is what `gaps` counts and what `invented_windows_max` refuses to see printed as a zero.
+const RUNS: [(u64, u64); 2] = [(0, 8), (13, 30)];
+
+/// The first millisecond the query asks about: half a minute into the first window of the
+/// workload, so that window is **partial**.
+const FROM_MILLIS: u64 = ORIGIN + 30_000;
+
+/// The first millisecond after it: twenty seconds into the twenty-eighth window, so that one is
+/// partial too, from the other side.
+const TO_MILLIS: u64 = ORIGIN + 27 * WINDOW_MILLIS + 20_000;
+
+/// How many segments the workload is sealed into.
+const SEGMENTS: usize = 4;
+
+/// The count every line of this harness reports, and where each number came from.
+#[derive(Debug, Default)]
+struct Counted {
+    /// Segments the store was sealed into.
+    sealed: u64,
+    /// Records the store answered before the query ran.
+    records: u64,
+    /// Distinct series among them.
+    series: u64,
+    /// Windows the range touches — the grid, whether or not anything happened in them.
+    windows: u64,
+    /// Records the pass looked at.
+    scanned: u64,
+    /// Records that were of the asked-for series.
+    series_matched: u64,
+    /// Records that were in the range and of that series: what went into the buckets.
+    in_range: u64,
+    /// Buckets the answer holds.
+    buckets: u64,
+    /// Windows of the range the answer says nothing about.
+    gaps: u64,
+    /// Buckets whose `start` is not one of the range's windows, and buckets that count nothing.
+    invented: u64,
+    /// The most records any one bucket holds.
+    per_bucket_max: u64,
+    /// Every bucket's count added up, against `in_range`.
+    bucketed: u64,
+    /// The mean of the buckets against the raw mean of the same records.
+    mean_gap: f64,
+    /// Calls that refused, anywhere in the run.
+    refused: u64,
+}
+
+/// The store directory this run owns, removed when the harness is dropped.
+struct Dir {
+    /// Where the store lives.
+    path: PathBuf,
+}
+
+impl Dir {
+    /// Claim a directory for `label`.
+    fn new(label: &str) -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "lakelet-downsample-budget-{label}-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir_all(&path)
+            .unwrap_or_else(|error| panic!("{} cannot be created: {error}", path.display()));
+        Self { path }
+    }
+
+    /// Where the store lives.
+    fn path(&self) -> &Path {
+        &self.path
+    }
+}
+
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// Every 15-second slot of the workload that holds samples, in order.
+fn slots() -> Vec<u64> {
+    let mut times = Vec::new();
+    for (start, end) in RUNS {
+        for minute in start..end {
+            for slot in 0..(WINDOW_MILLIS / STEP_MILLIS) {
+                times.push(minute * WINDOW_MILLIS + slot * STEP_MILLIS);
+            }
+        }
+    }
+    times
+}
+
+/// The value of the sample at `position`, for series `series`.
+///
+/// A wedge with a jitter on it: a value that grows over the whole workload, so a window's mean is
+/// not the range's mean for any reason a columnar encoding could explain away, plus a bit pattern
+/// with no structure at all — a column codec that found a pattern here would be a codec worth
+/// asking about, and a mean computed from the wrong records would land somewhere else.
+fn value_of(position: usize, series: usize) -> f64 {
+    let mixed = (position as u64)
+        .wrapping_mul(0x9E37_79B9_7F4A_7C15)
+        .wrapping_add(series as u64 * 0x2545_F491_4F6C_DD1D);
+    let jitter = ((mixed >> 12) & 0x3FF) as f64 / 512.0;
+    position as f64 * 0.25 + series as f64 * 10.0 + jitter
+}
+
+/// The records of the slots `from..to` of the workload, every series at every slot.
+fn batch(from: usize, to: usize) -> Vec<Record> {
+    let times = slots();
+    let mut records = Vec::new();
+    for (position, offset) in times.iter().enumerate().take(to).skip(from) {
+        for (index, name) in SERIES.iter().enumerate() {
+            records.push(Record {
+                series: (*name).to_owned(),
+                ts_millis: (ORIGIN + offset) as i64,
+                value: value_of(position, index),
+            });
+        }
+    }
+    records
+}
+
+/// Metric line prefix and one metric, in the shape `kiln`'s `bench-budget` gate parses.
+fn metric(name: &str, value: u64) {
+    println!("lakelet-budget {name}={value}");
+}
+
+/// The whole run: build the store, ask one question, count what happened.
+fn pass() -> Counted {
+    let directory = Dir::new("load");
+    let mut counted = Counted::default();
+    let mut store = match Segments::open(directory.path()) {
+        Ok(store) => store,
+        Err(error) => {
+            eprintln!("the store could not be opened: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+
+    let times = slots();
+    let chunk = times.len().div_ceil(SEGMENTS);
+    for from in (0..times.len()).step_by(chunk.max(1)) {
+        let records = batch(from, (from + chunk).min(times.len()));
+        if let Err(error) = store.seal(&records) {
+            eprintln!("a segment could not be sealed: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+        counted.sealed += 1;
+    }
+
+    let records = match store.snapshot().records() {
+        Ok(records) => records,
+        Err(error) => {
+            eprintln!("the store could not be read back: {error}");
+            counted.refused += 1;
+            return counted;
+        }
+    };
+    counted.records = records.len() as u64;
+    counted.series = SERIES.len() as u64;
+
+    let window = Window::new(WINDOW_MILLIS);
+    let range = Range::new(FROM_MILLIS, TO_MILLIS);
+    let grid: BTreeSet<u64> = window
+        .partitions(FROM_MILLIS, TO_MILLIS)
+        .iter()
+        .map(|partition| partition.start())
+        .collect();
+    counted.windows = grid.len() as u64;
+
+    let answer = downsample::downsample(&records, Some(ASKED), range, window, Aggregate::Mean);
+    counted.scanned = answer.scanned();
+    counted.series_matched = answer.series_matched();
+    counted.in_range = answer.in_range();
+    counted.buckets = answer.buckets().len() as u64;
+
+    let mut emitted: BTreeSet<u64> = BTreeSet::new();
+    for bucket in answer.buckets() {
+        let start = bucket.start();
+        emitted.insert(start);
+        counted.bucketed += bucket.count();
+        counted.per_bucket_max = counted.per_bucket_max.max(bucket.count());
+        if !grid.contains(&start) || bucket.count() == 0 {
+            counted.invented += 1;
+        }
+    }
+    counted.gaps = grid.iter().filter(|start| !emitted.contains(start)).count() as u64;
+
+    // The raw mean of exactly the records the buckets were computed from, out of the store's own
+    // list rather than out of the answer: this is the other way of answering the same question,
+    // and the difference between the two is what `TOLERANCE` declares.
+    let raw: Vec<f64> = records
+        .iter()
+        .filter(|record| record.series == ASKED)
+        .filter(|record| range.contains(u64::try_from(record.ts_millis).unwrap_or(0)))
+        .map(|record| record.value)
+        .collect();
+    if !raw.is_empty() && counted.buckets > 0 {
+        let raw_mean = raw.iter().sum::<f64>() / raw.len() as f64;
+        let bucket_mean = answer
+            .buckets()
+            .iter()
+            .map(|bucket| bucket.value())
+            .sum::<f64>()
+            / counted.buckets as f64;
+        counted.mean_gap = (bucket_mean - raw_mean).abs();
+    }
+    counted
+}
+
+#[test]
+fn the_downsampling_budget() {
+    let counted = pass();
+
+    // The shape of the store the query was handed: how many segments it is made of, how many
+    // records it holds, and how many series they belong to. A store with nothing in it cannot pass
+    // any of the counts below, and a `seal` that wrote the wrong records is caught before anything
+    // is asked.
+    metric("segments_sealed", counted.sealed);
+    metric("records", counted.records);
+    metric("series", counted.series);
+
+    // The grid the range sits on, against what the answer says about it. `windows` is every window
+    // the half-open range touches; `buckets_emitted` is the ones that held records; `gaps` is the
+    // rest, and this workload was built to have five of them. A query that printed an empty window
+    // as a zero would answer more buckets than it has records for, and one that anchored its
+    // windows at the first record would answer a different number of them entirely — which is why
+    // this count is judged alongside `invented_windows_max` rather than believed on its own.
+    metric("windows", counted.windows);
+    metric("buckets_emitted", counted.buckets);
+    metric("gaps", counted.gaps);
+    // An upper bound of zero: a bucket whose `start` is not one of the range's windows — a grid
+    // anchored at the data, or a window reaching outside the range for a partial bucket — and a
+    // bucket that counted nothing, which is the zero the "absent, not zero" rule exists to refuse.
+    metric("invented_windows_max", counted.invented);
+
+    // What the pass cost and where it went: every record is looked at, the series filter is what
+    // survives next, and the range is what survives after that. The three numbers are different
+    // here on purpose — a query that compared series as a prefix, or that took the range for the
+    // whole store, answers a different `records_in_range`.
+    metric("records_scanned", counted.scanned);
+    metric("series_matched", counted.series_matched);
+    metric("records_in_range", counted.in_range);
+
+    // One bucket holds one window's records and no more. An upper bound, so a query that spent
+    // fewer records per bucket passes it and one that answered the range as a single bucket does
+    // not: `records_in_range` is the ceiling of what any honest bucket can hold, and the bound is
+    // where the workload's density sits.
+    metric("records_per_bucket_max", counted.per_bucket_max);
+
+    // The identity the answer has to satisfy: the buckets' own counts added up are the records the
+    // pass says it used. Zero, or the answer lost or invented records on the way out.
+    metric(
+        "records_unaccounted_max",
+        counted.in_range.abs_diff(counted.bucketed),
+    );
+
+    // The tolerance's own metric: the mean of the buckets against the raw mean of the same
+    // records. The bound is an upper bound — "the two ways of answering agree to at least this
+    // well" — and this workload's partial first and last window are the whole reason the two
+    // numbers are not identical.
+    println!("lakelet-budget mean_gap_max={}", counted.mean_gap);
+
+    // A store or a query that refused is one this lane cannot judge by counts alone: a refusal
+    // shows up as the numbers moving, and this says why in one line. An upper bound of zero.
+    metric("refused_max", counted.refused);
+}
