+/// Run one command line: `args` without the program name.
+///
+/// Synchronous on purpose, and it takes nothing else: this tool reads no settings from the
+/// environment and none from a file — the store directory is a flag, because it is what the
+/// question is *about* — and it has nothing to wait for on standard input.
+///
+/// Nothing here panics and nothing here exits: every path a caller can take — a usage error, a
+/// store that is not there, a store that refused — comes back as an [`Outcome`].
+#[must_use]
+pub fn run(args: impl IntoIterator<Item = String>) -> Outcome {
+    todo!(
+        "lakelet/4.10-downsampling: `USAGE` and `MAX_WINDOWS` are above and the rules are in \
+         this module's header — the grammar, the two renderers and the exit codes are yours"
+    )
+}
