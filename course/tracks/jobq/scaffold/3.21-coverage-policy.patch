+/// A place no case can reach, and the reason the page gives for it.
+///
+/// The reason is part of the record rather than a comment next to it: an exemption is a decision
+/// about the code that somebody has to be able to review, and a page that lists places without
+/// saying why is a page whose first entry is "this one was annoying".
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Exempt {
+    /// The place nothing walks.
+    site: Site,
+    /// Why no case can walk it, in the words of whoever decided that.
+    reason: String,
+}
+
+impl Exempt {
+    /// A place nothing walks, and why.
+    #[must_use]
+    pub fn of(site: Site, reason: impl Into<String>) -> Self {
+        todo!("jobq/3.21-coverage-policy: the place, and the reason nothing walks it")
+    }
+
+    /// The place.
+    #[must_use]
+    pub fn site(&self) -> &Site {
+        todo!("jobq/3.21-coverage-policy: the place nothing walks")
+    }
+
+    /// Why no case can walk it.
+    #[must_use]
+    pub fn reason(&self) -> &str {
+        todo!("jobq/3.21-coverage-policy: why no case can walk it")
+    }
+}
+
+/// The places a run actually reached.
+///
+/// A set rather than a count, and that is the whole difference between coverage and "how many times
+/// a line ran": a line executed a thousand times in a loop is one place, and a share that counted
+/// executions would be a share about the test data rather than about the suite.
+#[non_exhaustive]
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Walked {
+    /// The module the run measured, which is what makes a share comparable with an inventory.
+    scope: String,
+    /// The places the run reached.
+    reached: BTreeSet<Site>,
+}
+
+impl Walked {
+    /// A run of one module.
+    #[must_use]
+    pub fn of(scope: impl Into<String>) -> Self {
+        todo!("jobq/3.21-coverage-policy: a run of one module, which has reached nothing yet")
+    }
+
+    /// The module this run measured.
+    #[must_use]
+    pub fn scope(&self) -> &str {
+        todo!("jobq/3.21-coverage-policy: the module this run measured")
+    }
+
+    /// Record that the run reached `site`.
+    ///
+    /// # Errors
+    ///
+    /// [`Foreign`] when the place is not in the module this run measures: a run of one module is
+    /// not evidence about another, and a `Walked` that accepted it would carry a place no
+    /// inventory could ever account for.
+    pub fn visit(&mut self, site: &Site) -> Result<(), Foreign> {
+        todo!(
+            "jobq/3.21-coverage-policy: one place the run reached, and the refusal of another module's"
+        )
+    }
+
+    /// `true` when the run reached this place.
+    #[must_use]
+    pub fn reached(&self, site: &Site) -> bool {
+        todo!("jobq/3.21-coverage-policy: whether this run reached the place")
+    }
+
+    /// How many places the run reached.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        todo!("jobq/3.21-coverage-policy: how many places the run reached")
+    }
+
+    /// `true` when the run reached nothing.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        todo!("jobq/3.21-coverage-policy: whether it reached anything at all")
