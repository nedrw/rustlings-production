+}
+
+/// A place that is not in the module a claim is about.
+///
+/// The same refusal from both directions, because both of them are the same defect: an inventory
+/// that absorbed a place from another module would report a percentage about a tree rather than
+/// about the module it claims to describe, and a run of one module compared with another's
+/// inventory would report a percentage about nothing at all.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Foreign {
+    /// The module the claim is about.
+    scope: String,
+    /// The place, or the module, that does not belong to it.
+    path: String,
+}
+
+impl Foreign {
+    /// The module the claim is about.
+    #[must_use]
+    pub fn scope(&self) -> &str {
+        todo!("jobq/3.21-coverage-policy: the module the claim is about")
+    }
+
+    /// What was offered to it.
+    #[must_use]
+    pub fn path(&self) -> &str {
+        todo!("jobq/3.21-coverage-policy: what was offered to it instead")
+    }
+}
+
+impl fmt::Display for Foreign {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        todo!("jobq/3.21-coverage-policy: the sentence a refusal prints")
+    }
+}
+
+impl std::error::Error for Foreign {}
+
+/// The places one module has, and the ones no case can reach.
+///
+/// The inventory is the *claim* half of a coverage number: what the module consists of, which of
+/// those places a case has to walk, and which of them nothing can. It is written by a person and it
+/// is checked against the code by hand — a place that no longer exists is a claim that stopped being
+/// true, and nothing in this module can see that; what the module *can* do is refuse to grow into a
+/// second module, which is the way this claim usually goes wrong.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Inventory {
+    /// The module every place in it is in.
+    scope: String,
+    /// The places a case has to walk, in the order they were recorded.
+    sites: Vec<Site>,
+    /// The places nothing walks, with the reason, in the order they were recorded.
+    exemptions: Vec<Exempt>,
+}
+
+impl Inventory {
+    /// An inventory of one module: `scope` is the path every place in it has to live under.
+    #[must_use]
+    pub fn of(scope: impl Into<String>) -> Self {
+        todo!("jobq/3.21-coverage-policy: an inventory of one module, with nothing in it yet")
+    }
+
+    /// The module this inventory is about.
+    #[must_use]
+    pub fn scope(&self) -> &str {
+        todo!("jobq/3.21-coverage-policy: the module this inventory is about")
+    }
+
+    /// Record a place a case has to walk.
+    ///
+    /// Recording a place that was exempt takes the exemption back, because a place is either
+    /// something a case walks or something it cannot — never both, and never neither.
+    ///
+    /// # Errors
+    ///
+    /// [`Foreign`] when the place is not in [`Inventory::scope`]: a percentage over a library is
+    /// not a percentage about the step, and the refusal happens here rather than in a review.
+    pub fn add(&mut self, site: Site) -> Result<(), Foreign> {
+        todo!(
+            "jobq/3.21-coverage-policy: a place a case has to walk, and the refusal of one from another module"
+        )
+    }
+
+    /// Record a place no case can reach, and the reason it cannot.
+    ///
+    /// An exempt place stays part of the inventory — it is a place the module has, and a run that
+    /// does not reach it has not failed — but it stops being a place a case has to walk, it never
+    /// counts towards a share, and it is never in [`Inventory::uncovered`]: an exemption is a
+    /// decision, not a to-do.
+    ///
+    /// # Errors
+    ///
+    /// [`Foreign`] when the place is not in [`Inventory::scope`].
+    pub fn exempt(&mut self, site: Site, reason: impl Into<String>) -> Result<(), Foreign> {
+        todo!("jobq/3.21-coverage-policy: a place no case can take, and the reason it cannot")
+    }
+
+    /// The places a case has to walk, in the order they were recorded.
+    #[must_use]
+    pub fn sites(&self) -> &[Site] {
+        todo!(
+            "jobq/3.21-coverage-policy: the places a case has to walk, in the order they were recorded"
+        )
+    }
+
+    /// The places nothing walks, with their reasons.
+    #[must_use]
+    pub fn exemptions(&self) -> &[Exempt] {
+        todo!("jobq/3.21-coverage-policy: the places nothing walks, with their reasons")
+    }
+
+    /// Every place of this kind the module has: the walkable ones and the exempted ones.
+    #[must_use]
+    pub fn total(&self, kind: Kind) -> usize {
+        todo!(
+            "jobq/3.21-coverage-policy: every place of this kind the module has, walkable and exempt alike"
+        )
+    }
+
+    /// The places of this kind a case can reach: the denominator a share is *about*.
+    #[must_use]
+    pub fn walkable(&self, kind: Kind) -> usize {
+        todo!("jobq/3.21-coverage-policy: the places of this kind a case can reach")
+    }
+
+    /// The highest share any run can reach on this inventory, in whole percent, or `None` when the
+    /// module has no place of this kind at all.
+    ///
+    /// `None` rather than `100`, for the reason `jobq/3.20-mutation-threshold` answers `None` for a
+    /// run that judged nothing: a module with no branch in the inventory is not a fully covered
+    /// module, it is a question the inventory does not ask.
+    #[must_use]
+    pub fn ceiling(&self, kind: Kind) -> Option<u32> {
+        todo!(
+            "jobq/3.21-coverage-policy: the highest share any run can reach, or `None` when there is nothing to reach"
+        )
+    }
+
+    /// The share of this inventory a run walked, in whole percent, or `None` when the module has no
+    /// place of this kind.
+    ///
+    /// The denominator is every place of the kind the module has, exempt ones included, and only
+    /// the walkable ones can be counted as covered — so a perfect run scores exactly
