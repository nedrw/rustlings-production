+//! What a coverage number is allowed to say: which places have to be walked, and out of what.
+//!
+//! Step `jobq/3.21-coverage-policy`. `jobq/3.20-mutation-threshold` asks what a suite *notices*;
+//! this step asks what it *touches*, which is the number every review already quotes. The measuring
+//! half of that question is the course's (`kiln check jobq/3.21-coverage-policy --slow`, with
+//! `llvm-cov` underneath it); what lives here is the half a review argues about.
+//!
+//! Four decisions are written into the shapes below:
+//!
+//! * **a line is not a decision.** [`Kind::Line`] and [`Kind::Branch`] are counted apart, because
+//!   an error arm no case ever takes is a hundred percent of its lines and half of its branches,
+//!   and the second number is the one that describes the suite;
+//! * **an inventory is about one module.** [`Inventory::add`] refuses a place from somewhere else,
+//!   and [`Walked::visit`] refuses it too, so the arithmetic below answers [`Foreign`] instead of a
+//!   percentage the moment the two sides disagree about which module they describe. That is the
+//!   defect this step exists for: a percentage over a whole library is dominated by code nobody
+//!   doubts, and it says nothing about the module the step is about;
+//! * **the places no case can reach are named, and they are not a run's fault.**
+//!   [`Inventory::exempt`] records a branch the compiler knows is there and a case cannot take, and
+//!   [`Inventory::ceiling`] answers the highest share any run can reach — which is what makes a
+//!   threshold above it ([`Policy::is_satisfiable`]) a decision nobody can meet rather than a
+//!   target somebody is failing;
+//! * **the answer is a list.** "78%" is not something a person can act on; [`Inventory::uncovered`]
+//!   is the places still to write a case for, as places a reader's editor can open.
+//!
+//! What this module is **not**: a measurement. It does not build the project, merge profile data
+//! or read a profile back — `kiln`'s `coverage` gate does that, and this step's spec never starts
+//! one instrumented binary. What is here is the rule a measurement is judged by.
+
+use std::collections::BTreeSet;
+use std::fmt;
+
+use crate::engine::mutation::Verdict;
+
+/// The module the project's coverage policy is about.
+///
+/// One constant rather than a string in two places, because the subject of a policy is the half of
+/// it that is easiest to lose: `docs/coverage.md` states this scope, [`Policy::standard`]'s
+/// threshold is a decision about it, and the spec compares the two. The engine's own rules are the
+/// part of this project a case can hold a threshold over; the service around them is wiring, and a
+/// percentage over the whole crate would be a percentage about `main`.
+pub const POLICY_SCOPE: &str = "src/engine";
+
+/// What a coverage number counts: a place that ran, or a decision that went one way.
+///
+/// Two kinds rather than one, and they are not interchangeable: a line is *visited* and a branch is
+/// *taken*. A function whose error arm nothing ever triggers has every one of its lines covered and
+/// half of its decisions unexercised, and a suite that reports one number has reported the first.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Kind {
+    /// A line of the module: it executed, or it did not.
+    Line,
+    /// One way out of a decision: it was taken, or it was not.
+    Branch,
+}
+
+impl Kind {
+    /// The word a report prints.
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        todo!("jobq/3.21-coverage-policy: the word a report prints for each kind")
+    }
+}
+
+impl fmt::Display for Kind {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        todo!("jobq/3.21-coverage-policy: the word, as `Display` prints it")
+    }
+}
+
+/// One place in a module that a run has to walk.
+///
+/// A `Site` is a claim about the code, and it is deliberately the smallest claim the thing that
+/// measures can be held to: the file, the line, and which of the two questions that line answers.
+/// The *case* that walks it stays prose (`docs/coverage.md`), because a place cannot name a test.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct Site {
+    /// The module the place is in, relative to the project.
+    path: String,
+    /// 1-based line, the way a compiler numbers them and a reader counts them.
+    line: usize,
+    /// Whether this place is a statement or a decision.
+    kind: Kind,
+}
+
+impl Site {
+    /// A line: it ran, or it did not.
+    #[must_use]
+    pub fn line(path: impl Into<String>, line: usize) -> Self {
+        todo!("jobq/3.21-coverage-policy: a place that is a line of the module")
+    }
+
+    /// A decision: one way out of it was taken, or it was not.
+    #[must_use]
+    pub fn branch(path: impl Into<String>, line: usize) -> Self {
+        todo!("jobq/3.21-coverage-policy: a place that is one way out of a decision")
+    }
+
+    /// The module this place is in.
+    #[must_use]
+    pub fn path(&self) -> &str {
+        todo!("jobq/3.21-coverage-policy: the module this place is in")
+    }
+
+    /// The line number, 1-based.
+    ///
+    /// `line_number` rather than `line`, because a place is *made* out of a line
+    /// ([`Site::line`]) and *asked* for one, and one name for the two would make the constructor
+    /// an accessor with an argument.
+    #[must_use]
+    pub fn line_number(&self) -> usize {
+        todo!("jobq/3.21-coverage-policy: the line, 1-based")
+    }
+
+    /// Which of the two questions this place answers.
+    #[must_use]
+    pub fn kind(&self) -> Kind {
+        todo!("jobq/3.21-coverage-policy: which of the two questions this place answers")
+    }
+
+    /// `src/engine/store/memory.rs:518` — the place a reader's editor can open.
+    ///
+    /// The same shape `jobq/3.20-mutation-threshold`'s survivors and `kiln`'s own reports are
+    /// written in: a report from a tool and a report from this project agreeing on how a place is
+    /// named is what lets a reviewer read exactly one of them.
+    #[must_use]
+    pub fn place(&self) -> String {
+        todo!("jobq/3.21-coverage-policy: the place, spelled the way a reader's editor opens it")
+    }
+}
+
+impl fmt::Display for Site {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        todo!("jobq/3.21-coverage-policy: the place, as `Display` prints it")
+    }
+}
