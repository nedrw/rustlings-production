+/// The rule this project holds itself to: a share, of one kind of place.
+///
+/// Two fields rather than one, because "90%" is a decision about branches and about lines, and the
+/// two are different decisions: a branch threshold is what a suite has to have thought about, while
+/// a line threshold is what the compiler already told you. The policy carries no scope of its own —
+/// a policy is applied to an inventory, and the inventory is the thing that knows which module it
+/// describes.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Policy {
+    /// The share of the walkable places a run has to reach.
+    threshold: u32,
+    /// Which of the two questions the threshold counts.
+    kind: Kind,
+}
+
+impl Policy {
+    /// A policy: `threshold` percent of the places of `kind`.
+    #[must_use]
+    pub fn of(threshold: u32, kind: Kind) -> Self {
+        todo!("jobq/3.21-coverage-policy: a threshold and the kind of place it counts")
+    }
+
+    /// The policy `docs/coverage.md` states, and the one the spec compares that page with.
+    ///
+    /// A branch rather than a line, and short of a hundred: the branches are what a suite has to
+    /// have decided about, and the ceiling of any real module is below a hundred because some of
+    /// its branches are there for a compiler or a panic path rather than for a case
+    /// ([`Inventory::exempt`]). A policy of a hundred would be a rule that the first honest
+    /// exemption makes impossible, which is why the ceiling is asked first.
+    #[must_use]
+    pub fn standard() -> Self {
+        Self::of(90, Kind::Branch)
+    }
+
+    /// The share this policy asks for.
+    #[must_use]
+    pub fn threshold(&self) -> u32 {
+        todo!("jobq/3.21-coverage-policy: the share this policy asks for")
+    }
+
+    /// Which of the two questions this policy counts.
+    #[must_use]
+    pub fn kind(&self) -> Kind {
+        todo!("jobq/3.21-coverage-policy: which of the two questions the threshold counts")
+    }
+
+    /// Whether this policy can be met on `inventory` at all.
+    ///
+    /// The review's half, and it is separate from [`Policy::judge`] on purpose: the arithmetic is
+    /// what a build does, and this is the question a person asks once — "can anybody satisfy the
+    /// rule we wrote down?" A threshold above the ceiling, or a policy about a kind of place the
+    /// module does not have, is a rule nobody read after writing it.
+    #[must_use]
+    pub fn is_satisfiable(&self, inventory: &Inventory) -> bool {
+        todo!("jobq/3.21-coverage-policy: whether anybody can meet this policy on this inventory")
+    }
+
+    /// What a run of this module means to this policy.
+    ///
+    /// The three answers are `jobq/3.20-mutation-threshold`'s, because they are the same three:
+    /// met, missed, and *not answerable* — here because the inventory has no place of this kind,
+    /// there because the run had too few mutants to be evidence. A two-valued gate has to fold the
+    /// third into one of the others, and both sentences it could print would be wrong: "not good
+    /// enough" sends somebody to write a case for a module that has nothing to walk.
+    ///
+    /// # Errors
+    ///
+    /// [`Foreign`] when `walked` measured another module than the inventory describes.
+    pub fn judge(&self, inventory: &Inventory, walked: &Walked) -> Result<Verdict, Foreign> {
+        todo!("jobq/3.21-coverage-policy: what a run of this module means to this policy")
+    }
+}
