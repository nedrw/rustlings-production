new file mode 100644
index 0000000..e53e8d5
--- /dev/null
+++ b/clippy.toml
@@ -0,0 +1,12 @@
+# Reading the clock is a dependency, and dependencies are injected
+# (step `jobq/3.8-clock-injection`).
+#
+# `clippy@3` turns these into errors on library code, so what keeps the rule is the compiler rather
+# than a reviewer's memory. `SystemClock` is the one place allowed to read the wall clock; it says so
+# with an `#[allow]` and a reason, and every other instant in the crate comes through
+# `jobq::engine::Clock`.
+disallowed-methods = [
+    "chrono::Utc::now",
+    "chrono::Local::now",
+    "std::time::SystemTime::now",
+]
