index 0000000..bf891e0
--- /dev/null
+++ b/src/engine/runbook.rs
@@ -0,0 +1,273 @@
+//! The runbook's own shape: a procedure somebody else can run, and the four things a stage owes.
+//!
+//! Step `jobq/3.27-runbook-drill`. Every step before this one added an *act* to a deployment and
+//! wrote the page that explains it; what none of them wrote is the **procedure** — the order those
+//! acts are taken in, by somebody who did not write any of them, at three in the morning. This
+//! module is the procedure's shape as a value a program can hold, and it exists because a runbook
+//! that is only prose cannot be judged by anything: [`Runbook::of`] reads a page and [`Runbook::gaps`]
+//! answers every stage that is not runnable.
+//!
+//! Four things are owed by every stage, and each one is a way a runbook fails:
+//!
+//! * **the command** — what the responder types. "Check that the workers are healthy" is a
+//!   sentence nobody can execute;
+//! * **the signal** — what the command answering *well* looks like. Without it the responder cannot
+//!   tell a queue that is draining from a queue that is stuck, and the act that follows is a guess;
+//! * **the refusal** — what it looks like when the command does *not* answer well. Every door in
+//!   this project answers a class rather than a sentence (`jobq/3.15-cli-contract`,
+//!   `jobq/3.26-dlq-cli`), and a step that does not name its refusal leaves the responder to
+//!   invent the branch — usually by retrying an act that will not work;
+//! * **the rollback** — how to get back to where the queue was. Some acts have none, and **saying
+//!   so is the point**: an act whose consequences cannot be undone (a discard, `jobq/3.26`) is
+//!   exactly the one a responder must know is irreversible *before* they take it.
+//!
+//! What this module is **not**: it runs nothing and it checks nothing against a deployment. It
+//! reads the page and judges its shape — which stage is which, and which of the four things a stage
+//! forgot. Whether the commands on the page are the commands this deployment has is the drill's
+//! question (it walks the page and takes the acts it names), and whether the acts work is the
+//! engine's.
+
+use std::fmt;
+
+/// The four things a stage of a runbook names, in the order a responder reads them.
+///
+/// An array rather than a list inside each function, because it is the whole contract of a stage:
+/// [`Stage::missing`] reports the first of these that a stage does not answer, and [`Gap::Missing`]
+/// names it, so a page and a report cannot disagree about what a stage is made of.
+pub const PARTS: [&str; 4] = ["command", "signal", "refusal", "rollback"];
+
+/// What a markdown heading at this depth starts, followed by a number.
+const STAGE: &str = "###";
+
+/// One stage of a procedure: a number, a title, and the four things it owes.
+///
+/// Built by [`Runbook::of`] and never by a caller, so a stage that exists is a stage that was read
+/// out of a page.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Stage {
+    /// Where it sits in the order, read from its heading.
+    number: u32,
+    /// What it is called, read from its heading after the number.
+    title: String,
+    /// The four answers, in [`PARTS`] order, empty when the stage did not name one.
+    answers: [String; PARTS.len()],
+}
+
+impl Stage {
+    /// The number its heading carries.
+    #[must_use]
+    pub fn number(&self) -> u32 {
+        self.number
+    }
+
+    /// What the stage is called: its heading without the marker and the number.
+    #[must_use]
+    pub fn title(&self) -> &str {
+        &self.title
+    }
+
+    /// What the responder types.
+    #[must_use]
+    pub fn command(&self) -> &str {
+        self.answer("command").unwrap_or_default()
+    }
+
+    /// What the command answering well looks like.
+    #[must_use]
+    pub fn signal(&self) -> &str {
+        self.answer("signal").unwrap_or_default()
+    }
+
+    /// What it looks like when the command does not answer well.
+    #[must_use]
+    pub fn refusal(&self) -> &str {
+        self.answer("refusal").unwrap_or_default()
+    }
+
+    /// How to get back to where the queue was, or the words that say there is no way back.
+    #[must_use]
+    pub fn rollback(&self) -> &str {
+        self.answer("rollback").unwrap_or_default()
+    }
+
+    /// One of the four answers by name, or `None` when this stage does not name that part.
+    ///
+    /// The name is one of [`PARTS`]; anything else is `None` rather than a panic, because the names
+    /// come from a page and a page is input.
+    #[must_use]
+    pub fn answer(&self, part: &str) -> Option<&str> {
+        let index = PARTS.iter().position(|name| *name == part)?;
+        self.answers.get(index).map(String::as_str)
+    }
+
+    /// The first of the four things this stage does not name, if it forgets one.
+    ///
+    /// "Does not name" includes naming it with nothing after the colon: `- rollback:` is the shape
+    /// of a responder who was about to think about it and was interrupted.
+    #[must_use]
+    pub fn missing(&self) -> Option<&'static str> {
+        todo!(
+            "jobq/3.27-runbook-drill: the first of `PARTS` this stage does not name, and `None` when \
+             it names all four"
+        )
+    }
+
+    /// `true` when this stage names all four things a responder is owed.
+    #[must_use]
+    pub fn holds(&self) -> bool {
+        self.missing().is_none()
+    }
+
+    /// Start a stage at `number`, called `title`.
+    fn started(number: u32, title: &str) -> Self {
+        Self {
+            number,
+            title: title.trim().to_owned(),
+            answers: std::array::from_fn(|_| String::new()),
+        }
+    }
+
+    /// Name a part, replacing whatever the stage had said about it.
+    fn name(&mut self, part: &str, value: &str) {
+        if let Some(slot) = self.slot(part) {
+            *slot = value.trim().to_owned();
+        }
+    }
+
+    /// Continue a part on the next line, which is what a page wrapped at a readable width looks
+    /// like: the value of a part is its own line plus every wrapped line after it.
+    fn continue_with(&mut self, part: &str, text: &str) {
+        if let Some(slot) = self.slot(part) {
+            if !slot.is_empty() {
+                slot.push(' ');
+            }
+            slot.push_str(text.trim());
+        }
+    }
+
+    /// The answer this part lives in.
+    fn slot(&mut self, part: &str) -> Option<&mut String> {
+        let index = PARTS.iter().position(|name| *name == part)?;
+        self.answers.get_mut(index)
+    }
+}
+
+impl fmt::Display for Stage {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "stage {} ({})", self.number, self.title)
+    }
+}
+
+/// A stage of a page that is not runnable, and why.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Gap {
+    /// The page names no stage at all: it is prose about the system, not a procedure for it.
+    Empty,
+    /// A stage that does not name one of the four things a responder is owed.
+    Missing {
+        /// Which stage.
+        number: u32,
+        /// Which of [`PARTS`] it forgot.
+        part: &'static str,
+    },
+    /// A stage whose number is not the position it holds in the page.
+    OutOfOrder {
+        /// The number the heading carries.
+        number: u32,
+        /// The number that stage's position means.
+        expected: u32,
+    },
+}
+
+impl fmt::Display for Gap {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Gap::Empty => formatter.write_str(
+                "the page names no stage at all: a procedure nobody numbered is the prose a \
+                 responder reads instead of following",
+            ),
+            Gap::Missing { number, part } => write!(
+                formatter,
+                "stage {number} does not say what its `{part}` is: a stage that does not name one \
+                 of {PARTS:?} is a stage the responder finishes by improvising",
+            ),
+            Gap::OutOfOrder { number, expected } => write!(
+                formatter,
+                "stage {number} sits where stage {expected} belongs: a procedure is followed in \
+                 the page's order, and a number that disagrees with it is a stage taken out of \
+                 order",
+            ),
+        }
+    }
+}
+
+/// A procedure, as the page that carries it.
+///
+/// [`Runbook::of`] is the only way to build one: a runbook assembled by hand would be a claim about
+/// a page nobody read.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Runbook {
+    /// The stages, in the order the page writes them.
+    stages: Vec<Stage>,
+}
+
+impl Runbook {
+    /// The procedure a page describes: every `###` heading that carries a number, in page order.
+    ///
+    /// A heading at any other depth is prose, and a `###` heading with no number is *not a stage* —
+    /// it is a heading somebody wrote where a stage belongs, and the acts it was supposed to name
+    /// are the acts [`Runbook::gaps`] cannot see. The parse is deliberately this literal: a page is
+    /// read by a person under pressure, so what it says is what it says.
+    ///
+    /// A part's value is the rest of its own line and every line after it until a blank line, a
+    /// heading, or the next part — which is what a page wrapped at a readable width looks like.
+    #[must_use]
+    pub fn of(page: &str) -> Self {
+        todo!(
+            "jobq/3.27-runbook-drill: read the page — a `###` heading that carries a number starts a \
+             stage, and each of the four parts is its own line plus the wrapped lines under it"
+        )
+    }
+
+    /// The stages of the procedure, in the order the page writes them.
+    #[must_use]
+    pub fn stages(&self) -> &[Stage] {
+        &self.stages
+    }
+
+    /// Every stage that is not runnable, in page order, and why.
+    ///
+    /// A stage can be both out of order and incomplete; both are reported, because they are two
+    /// different repairs.
+    #[must_use]
+    pub fn gaps(&self) -> Vec<Gap> {
+        todo!(
+            "jobq/3.27-runbook-drill: every stage that is not runnable, in page order — an empty \
+             page, a stage that forgets a part, a stage whose number is not the place it holds"
+        )
+    }
+
+    /// `true` when every stage of the page names all four things and holds its place in the order.
+    ///
+    /// This is the whole judgement the page's shape admits: whether the acts on it *work* is not a
+    /// question about a page.
+    #[must_use]
+    pub fn holds(&self) -> bool {
+        self.gaps().is_empty()
+    }
+}
+
+/// The number and title of a stage heading, or `None` when it carries no number.
+fn numbered(heading: &str) -> Option<(u32, &str)> {
+    todo!(
+        "jobq/3.27-runbook-drill: the number and the title of a stage heading, or `None` when it carries none"
+    )
+}
+
+/// The part a line names, and what it says about it.
+fn named(line: &str) -> Option<(&'static str, &str)> {
+    todo!("jobq/3.27-runbook-drill: the part a line names, and what it says about it")
+}
