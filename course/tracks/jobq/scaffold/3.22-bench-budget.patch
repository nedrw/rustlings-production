+//! The performance budget's harness for `jobq/3.22-bench-budget`.
+//!
+//! This file is the course's, not the learner's. It is what `kiln check jobq/3.22-bench-budget
+//! --slow` runs, and the numbers it prints are compared with the baselines in
+//! `course/tracks/jobq/budget/3.22-bench-budget.toml` — one drain of a queue and the same drain at
+//! twice the size.
+//!
+//! What it measures is **work, never the clock**: `kiln` compares counts, so the gate answers the
+//! same thing on a loaded machine as on an idle one, and no run of this file can flake because
+//! something else was compiling. `cargo test -p jobq --test budget -- --nocapture` prints the lines
+//! by hand; the `jobq-budget` prefix is what the gate reads.
+
+use chrono::{DateTime, Duration, Utc};
+use jobq::engine::{JobId, Pull, Row, Work, report};
+
+/// The size of the queue the counts are taken on.
+///
+/// Twice this is the size the guard compares with, and this is the number the budget is written
+/// against — changing it changes what the baselines mean, so it is a decision and not a knob.
+const ROWS: usize = 256;
+/// Every fourth row of the workload is not due yet.
+///
+/// A queue that is entirely due is the easy half of the measurement: the drain has nothing to look
+/// at and skip, and `scan_cells` would say nothing that `claim_statements` does not. One row in four
+/// is the shape of a queue with timers in it.
+const NOT_DUE_EVERY: usize = 4;
+/// The instant the drain is asked about, and a fixed one: a number measured against the wall clock
+/// is a number a machine with a different clock would answer differently.
+const NOW_SECONDS: i64 = 1_700_000_000;
+
+/// The instant every row of the workload is compared with.
+fn now() -> DateTime<Utc> {
+    DateTime::from_timestamp(NOW_SECONDS, 0).expect("a fixed instant this file states itself")
+}
+
+/// One batch: rows in claim order, and every fourth of them due later rather than now.
+fn batch(rows: usize) -> Vec<Row> {
+    (0..rows)
+        .map(|index| {
+            let waiting = index % NOT_DUE_EVERY == NOT_DUE_EVERY - 1;
+            let run_at = if waiting {
+                now() + Duration::minutes(5)
+            } else {
+                now()
+            };
+            Row::new(JobId::new(), run_at)
+        })
+        .collect()
+}
+
+/// Drain one batch and answer what the drain cost.
+fn drain(rows: usize) -> Work {
+    let mut work = Work::new();
+    let mut pull = Pull::of(batch(rows));
+    while pull.next(now(), &mut work).is_some() {}
+    work
+}
+
+#[test]
+fn the_budget() {
+    let small = drain(ROWS);
+    let large = drain(2 * ROWS);
+    for line in report(&small, &large) {
+        println!("{line}");
+    }
+}
