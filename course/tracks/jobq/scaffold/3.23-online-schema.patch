+//! Changing the queue's own schema while the queue keeps running.
+//!
+//! Step `jobq/3.23-online-schema`. `relay/2.23-online-schema` established what a schema change
+//! costs when the process applying it is not the only one running: **expand** adds a column
+//! without rewriting a row, **backfill** fills the rows that predate it in batches, and
+//! **contract** is a later release that makes the column `not null` and takes the read path's
+//! fallback away. What this module holds is that change as an engine sees it, and the three
+//! decisions it adds are what makes the middle phase a deployment's problem rather than a
+//! command's:
+//!
+//! * **the backfill is a job in the queue it is migrating.** [`Change::backfill`] answers
+//!   [`Action::Jobs`] — a [`Plan`] of batches, submitted to a queue in the table being changed — so
+//!   the middle phase goes through the same port, the same claims, the same workers and the same
+//!   trail as the work it is walking past. It is batched because one statement per batch is what
+//!   makes a batch atomic, and paced because a plan whose batches are all due at once consumes the
+//!   queue it is supposed to be leaving alone (`jobq/3.11-delayed-timers` is the column the pace
+//!   is written with).
+//! * **every phase asks the catalog before it runs.** `alter table … add column` is not
+//!   idempotent: the second run of an expand is an error rather than a no-op. So a phase takes
+//!   [`Applied`] — what the database already answers — and says [`Action::Nothing`] rather than
+//!   re-running its statements, or [`Action::Blocked`] when the phase before it has not finished.
+//!   That is what "safe to run twice" means here, and it is why the contract refuses while rows
+//!   are still empty instead of letting the database refuse a `set not null` halfway through a
+//!   deploy.
+//! * **the constraint is the contract's, not the expand's.** `check (<column> is not null)` —
+//!   even `not valid` — holds for every *new* row the moment it exists, and the release the expand
+//!   phase exists to keep working writes rows that do not name the column. So the expand adds the
+//!   column and the index a batch reads and nothing else, and the constraint, its validation and
+//!   `set not null` are the later deploy (`jobq/3.6-transaction-isolation` promised this step an
+//!   answer for a table that is too large to validate under a deploy's lock).
+//! * **the read path and the backfill are one expression.** [`Change::fallback`] is built from
+//!   [`Change::computed`], and [`Plan::statement`] writes the same text: the stored number and
+//!   the computed one cannot disagree, because there is one expression and two places that read
+//!   it (`relay/2.23` argued this for a service; the shape is worth keeping).
+//!
+//! The port does not change: not one method is added to `Store`, because what a deployment needs
+//! from the engine here is the *plan* — which phase is next, and what the middle one costs — and
+//! the port's `enqueue` already takes the jobs it produces.
+
+use chrono::{DateTime, Duration, Utc};
+
+use crate::engine::domain::{Queue, SubmitRequest};
+
+/// The metric name of the jobs a backfill plan submits.
+pub const BACKFILL_JOBS: &str = "backfill_jobs";
+
+/// The metric name of the rate guard: the most batches one interval holds.
+pub const BURST_MAX: &str = "burst_max";
+
+/// The metric name of the resumability guard: a plan for what is left against a plan for all of
+/// it.
+pub const RESUME_RATIO_MAX: &str = "resume_ratio_max";
+
+/// Every metric a harness prints, in the order a report writes them.
+///
+/// One list, because a page, a harness and the course's baseline are three readers of the same
+/// names (`docs/migration.md` states them, `tests/backfill_budget.rs` prints them, and
+/// `course/tracks/jobq/budget/3.23-online-schema.toml` is written in them).
+pub const PLAN_METRICS: [&str; 3] = [BACKFILL_JOBS, BURST_MAX, RESUME_RATIO_MAX];
+
+/// The most batches the plan may have due in one interval.
+///
+/// The rate the middle phase keeps, as a number a gate can read: a migration is allowed to be
+/// slow, and it is not allowed to become the queue's bottleneck while it runs.
+pub const BURST_LIMIT: u32 = 1;
+
+/// The bound on the resumability guard.
+///
+/// A plan that resumes from what is left costs about half of what the plan for the whole table
+/// costs, and `0.6` is a bound rather than a target — a plan that measured less than its share is
+/// a plan that passed.
+pub const RESUME_LIMIT: f64 = 0.6;
+
+/// How many rows one batch fills when the caller does not say.
+///
+/// Small enough that one batch holds a row lock for milliseconds, large enough that a table of a
+/// few million rows is thousands of jobs rather than millions.
+pub const DEFAULT_BATCH: u32 = 256;
+
+/// How far apart two batches are scheduled when the caller does not say, in seconds.
+pub const DEFAULT_INTERVAL_SECONDS: i64 = 1;
+
+/// One column of the queue's own table, gaining a value while the queue runs.
+///
+/// The whole description is four things — the table, the column, the expression that computes the
+/// value, and the queue the batches run on — plus the two numbers that are the *rate*. The names
+/// the database will show an operator (`<table>_<column>_known`, `<table>_unfilled_<column>`) are
+/// derived from the column rather than spelled again, so the constraint that says the column is
+/// never empty and the index that finds the rows that are can always be found from the column
+/// they are about.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Change {
+    /// The table the queue's rows live in.
+    table: String,
+    /// The column being added.
+    column: String,
+    /// The SQL expression that produces the value, written once.
+    computed: String,
+    /// The queue whose jobs fill the column.
+    queue: Queue,
+    /// Rows one batch fills.
+    batch: u32,
+    /// How far apart two batches are scheduled.
+    interval: Duration,
+}
+
+impl Change {
+    /// The change a column of `table` is gaining: the value `computed` produces, filled by jobs on
+    /// `queue`.
+    #[must_use]
+    pub fn new(table: &str, column: &str, computed: &str, queue: Queue) -> Self {
+        todo!(
+            "jobq/3.23-online-schema: the change a column of a table is gaining, filled by jobs on a queue"
+        );
+    }
+
+    /// How many rows one batch fills.
+    #[must_use]
+    pub fn with_batch(mut self, rows: u32) -> Self {
+        todo!("jobq/3.23-online-schema: how many rows one batch fills");
+    }
+
+    /// How far apart two batches are scheduled: the rate this change keeps.
+    #[must_use]
+    pub fn with_interval(mut self, interval: Duration) -> Self {
+        todo!("jobq/3.23-online-schema: how far apart two batches are scheduled");
+    }
+
+    /// The table the queue's rows live in.
+    #[must_use]
+    pub fn table(&self) -> &str {
+        todo!("jobq/3.23-online-schema: the table the queue's rows live in");
+    }
+
+    /// The column being added.
+    #[must_use]
+    pub fn column(&self) -> &str {
+        todo!("jobq/3.23-online-schema: the column being added");
+    }
+
+    /// The expression that produces the value.
+    #[must_use]
+    pub fn computed(&self) -> &str {
+        todo!("jobq/3.23-online-schema: the expression that produces the value");
+    }
+
+    /// The queue whose jobs fill the column.
+    #[must_use]
+    pub fn queue(&self) -> &Queue {
+        todo!("jobq/3.23-online-schema: the queue whose jobs fill the column");
+    }
+
+    /// How many rows one batch fills.
+    #[must_use]
+    pub fn rows_per_batch(&self) -> u32 {
+        todo!("jobq/3.23-online-schema: how many rows one batch fills");
+    }
+
+    /// How far apart two batches are scheduled.
+    #[must_use]
+    pub fn interval(&self) -> Duration {
+        todo!("jobq/3.23-online-schema: how far apart two batches are scheduled");
+    }
+
+    /// The constraint that says the column is never empty, as the database will name it.
+    #[must_use]
+    pub fn constraint(&self) -> String {
+        todo!(
+            "jobq/3.23-online-schema: the constraint that says the column is never empty, named after the column"
+        );
+    }
+
+    /// The partial index the backfill reads, as the database will name it.
+    #[must_use]
+    pub fn index(&self) -> String {
+        todo!(
+            "jobq/3.23-online-schema: the partial index the backfill reads, named after the column"
+        );
+    }
+
+    /// The read path's answer while the column is empty.
+    ///
+    /// The same expression the backfill writes, wrapped in a `coalesce` with the column it fills:
+    /// a read path that answered the column and nothing else would answer `null` for every row
+    /// that predates the change, which is what turns an expand phase into a breaking change.
+    #[must_use]
+    pub fn fallback(&self) -> String {
+        todo!(
+            "jobq/3.23-online-schema: the read path's answer while the column is empty, built from `computed`"
+        );
+    }
+
+    /// Phase one: add the column, the constraint and the index, without touching a row.
+    ///
+    /// `Nothing` when the column is already there, because the statements are not idempotent by
+    /// nature: an expand that ran twice has to change nothing, and `add column` would refuse the
+    /// second run rather than repeat itself.
+    #[must_use]
+    pub fn expand(&self, applied: &Applied) -> Action {
+        todo!(
+            "jobq/3.23-online-schema: phase one: the statements that add the column, or nothing when it is already there"
+        );
+    }
+
+    /// Phase two: the rows that predate the column, filled in batches by jobs on the queue.
+    ///
+    /// `Nothing` when every row has a value, and `Blocked` before the expand: there is nothing to
+    /// fill until the column is there, and a batch statement would be an error rather than an
+    /// empty answer.
+    #[must_use]
+    pub fn backfill(&self, applied: &Applied, now: DateTime<Utc>) -> Action {
+        todo!(
+            "jobq/3.23-online-schema: phase two: the plan of jobs for the rows that have no value, or why there is none"
+        );
+    }
+
+    /// The middle phase's arithmetic: what filling `remaining` rows with jobs costs.
+    ///
+    /// [`Change::backfill`] is the phase, and it answers [`Action::Nothing`] for a table whose rows
+    /// all have a value; this is the plan those rows would be filled by, for a caller that is
+    /// budgeting the work rather than starting it (a change of no rows is a plan of no batches).
+    #[must_use]
+    pub fn plan(&self, remaining: u32, now: DateTime<Utc>) -> Plan {
+        todo!(
+            "jobq/3.23-online-schema: the middle phase's arithmetic: what filling `remaining` rows costs"
+        );
+    }
+
+    /// Phase three: make the database check the rows it was told to skip, and take the index the
+    /// backfill read away.
+    ///
+    /// `Nothing` when the constraint has already been validated, and `Blocked` while rows are
+    /// still empty — that is the database's own `set not null` refusal, moved to the place where
+    /// it costs a deployment nothing.
+    #[must_use]
+    pub fn contract(&self, applied: &Applied) -> Action {
+        todo!(
+            "jobq/3.23-online-schema: phase three: the statements that make the database check the rows, or why it may not yet"
+        );
+    }
+}
+
+/// What the database already answers about a change, so a phase knows whether it is a repeat.
+///
+/// Counted rather than assumed: a phase that runs its statements without asking is a phase whose
+/// second run is an error, and the three fields are exactly the questions a deployment asks — is
+/// the column there, how many rows have no value, has the constraint been validated.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Applied {
+    /// Whether the column is there.
+    column: bool,
+    /// How many rows have no value. Only meaningful once the column is there.
+    remaining: u32,
+    /// Whether the database has checked the rows that predate the constraint.
+    validated: bool,
+}
+
+impl Applied {
+    /// What a database that has never seen this change answers.
+    #[must_use]
+    pub fn before() -> Self {
+        todo!("jobq/3.23-online-schema: what a database that has never seen this change answers");
+    }
+
+    /// What it answers between the expand and the contract: the column is there, and `remaining`
+    /// rows have no value.
+    #[must_use]
+    pub fn expanded(remaining: u32) -> Self {
+        todo!("jobq/3.23-online-schema: what it answers between the expand and the contract");
+    }
+
+    /// What it answers after the contract.
+    #[must_use]
+    pub fn contracted() -> Self {
+        todo!("jobq/3.23-online-schema: what it answers after the contract");
+    }
+
+    /// Whether the column is there.
+    #[must_use]
+    pub fn column(&self) -> bool {
+        todo!("jobq/3.23-online-schema: whether the column is there");
+    }
+
+    /// How many rows have no value.
+    #[must_use]
+    pub fn remaining(&self) -> u32 {
+        todo!("jobq/3.23-online-schema: how many rows have no value");
+    }
+
+    /// Whether the database has checked the rows that predate the constraint.
+    #[must_use]
+    pub fn validated(&self) -> bool {
+        todo!(
+            "jobq/3.23-online-schema: whether the database has checked the rows that predate the constraint"
+        );
+    }
+}
+
+/// What one phase of a change has to do, given what the database already answers.
+///
+/// The four answers are the whole of "safe to run twice": a phase with work is statements or jobs,
+/// a phase that already happened is [`Action::Nothing`] with its reason, and a phase whose
+/// predecessor has not finished is [`Action::Blocked`] — the difference between a no-op and a
+/// refusal, which a caller that only saw an error message could not tell apart.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Action {
+    /// The statements a deployment runs, in order.
+    Statements(Vec<String>),
+    /// The jobs to submit: the middle phase, as work the queue runs.
+    Jobs(Plan),
+    /// The phase is already applied, and the reason is written down.
+    Nothing(&'static str),
+    /// The phase before this one has not finished, and the reason is written down.
+    Blocked(&'static str),
+}
+
+/// The middle phase, as work the queue runs: one job per batch, paced.
+///
+/// A plan is the change plus the batches that are left, and it is a function of what the catalog
+/// says is missing rather than of the size of the table — that is the whole of resuming a backfill
+/// that was interrupted, and it is why the second plan is cheaper than the first
+/// ([`RESUME_LIMIT`]).
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Plan {
+    /// The change this plan runs.
+    change: Change,
+    /// The batches, in the order they run.
+    batches: Vec<Batch>,
+}
+
+impl Plan {
+    /// The change this plan runs.
+    #[must_use]
+    pub fn change(&self) -> &Change {
+        todo!("jobq/3.23-online-schema: the change this plan runs");
+    }
+
+    /// The batches, in the order they run.
+    #[must_use]
+    pub fn batches(&self) -> &[Batch] {
+        todo!("jobq/3.23-online-schema: the batches, in the order they run");
+    }
+
+    /// How many jobs the plan submits.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        todo!("jobq/3.23-online-schema: how many jobs the plan submits");
+    }
+
+    /// Whether the plan has nothing to submit.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        todo!("jobq/3.23-online-schema: whether the plan has nothing to submit");
+    }
+
+    /// How many rows the plan fills: exactly what was missing, no more.
+    #[must_use]
+    pub fn rows(&self) -> u32 {
+        todo!("jobq/3.23-online-schema: how many rows the plan fills");
+    }
+
+    /// The most batches due in one interval: the rate this plan keeps.
+    ///
+    /// Batches are bucketed by the interval that separates two of them, so a paced plan answers one
+    /// and a plan whose interval is zero answers its own length — which is the defect
+    /// [`BURST_LIMIT`] exists to catch, because a migration that hands the whole table to the
+    /// queue's workers at once is a migration that stops the queue.
+    #[must_use]
+    pub fn burst(&self) -> u32 {
+        todo!(
+            "jobq/3.23-online-schema: the most batches due in one interval: the rate this plan keeps"
+        );
+    }
+
+    /// The one statement one batch runs, or `None` when the plan has no such batch.
+    ///
+    /// A single `update` over the rows that have no value: the predicate is *the value is absent*
+    /// rather than a bookmark, which is what makes a re-run fill nothing and a run that was
+    /// interrupted finishable by anybody, and `limit` is what makes the batch atomic and small.
+    #[must_use]
+    pub fn statement(&self, index: usize) -> Option<String> {
+        todo!("jobq/3.23-online-schema: the one statement one batch runs");
+    }
+
+    /// The jobs to submit, in the order they run.
+    ///
+    /// Each one carries the batch it is (`migration.table`, `migration.column`, `migration.batch`,
+    /// `migration.rows`), because the worker that claims it has to know what to run, and each one
+    /// is due when the plan says: the pace is `run_at`, so a batch that is not due yet is work a
+    /// claim will not hand out.
+    #[must_use]
