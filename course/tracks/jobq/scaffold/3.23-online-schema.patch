+//! The budget's harness for `jobq/3.23-online-schema`.
+//!
+//! This file is the course's, not the learner's. It is what the `bench-budget` gate runs, and the
+//! numbers it prints are compared with the baselines in
+//! `course/tracks/jobq/budget/3.23-online-schema.toml` — one online change of one table, and what
+//! a plan that resumes the half of it that is left costs.
+//!
+//! What it measures is **work, never the clock**: the jobs a plan submits, the most batches it
+//! makes due at once, and the plan for what is left against the plan for all of it. `kiln`
+//! compares counts, so the gate answers the same thing on a loaded machine as on an idle one, and
+//! no run of this file can flake because something else was compiling.
+//! `cargo test -p jobq --test backfill_budget -- --nocapture` prints the lines by hand; the
+//! `jobq-budget` prefix is what the gate reads.
+
+use chrono::{DateTime, Duration, Utc};
+use jobq::engine::{Change, Queue, cost};
+
+/// The size of the table the counts are taken on.
+///
+/// This and the batch size are what every baseline below is a statement about: changing either of
+/// them changes what the numbers mean, so they move in the same commit as the numbers.
+const ROWS: u32 = 4_096;
+/// The rows that are still empty when the run resumes: half the table, which is the state a run
+/// that was interrupted at the halfway mark leaves behind.
+const DONE: u32 = 2_048;
+/// Rows one batch of the backfill fills: the size of one job, and the size of one write.
+const BATCH: u32 = 256;
+/// The rate: one batch per this many seconds.
+const INTERVAL_SECONDS: i64 = 1;
+/// The table the queue's own rows live in.
+const TABLE: &str = "jobs";
+/// The column this step's change adds.
+const COLUMN: &str = "payload_bytes";
+/// The expression that produces the column's value: the database's, in bytes.
+const COMPUTED: &str = "octet_length(payload::text)";
+/// The queue the backfill's jobs run on.
+const QUEUE: &str = "migrations";
+/// The instant the plan is made, and a fixed one: a plan measured against the wall clock is a plan
+/// a machine with a different clock answers differently.
+const NOW_SECONDS: i64 = 1_700_000_000;
+
+/// The instant every plan in this file is made at.
+fn now() -> DateTime<Utc> {
+    DateTime::from_timestamp(NOW_SECONDS, 0).expect("a fixed instant this file states itself")
+}
+
+/// The change the budget is written against, at the rate the baseline states.
