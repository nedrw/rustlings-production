index 0000000..3fa0feb
--- /dev/null
+++ b/migrations/0005_queues_and_usage.sql
@@ -0,0 +1,34 @@
+-- Queues as things somebody owns: the access model, the audit trail of it, and the counters.
+--
+-- Step `jobq/3.13-queue-authz-attribution`. This is the project's fifth migration, so it is `0005`
+-- (`0001` wrote `jobs`, `0002` the trail, `0003` the lease, `0004` the deduplication keys; `mailer`
+-- and `relay` number their own files).
+--
+-- The file is yours to write, and it needs to hold four things and one idea:
+--
+-- 1. **which tenant owns which queue.** Exactly one owner per queue, because the counters below
+--    are attributed to it: a queue with two owners is a queue whose numbers nobody can add up.
+-- 2. **what everybody else may do with it**: one row per (queue, tenant, action), with the action's
+--    alphabet closed by a `check`, so that a typo lands in the migration rather than in a query that
+--    silently matches nothing. `relay/2.16-authz-audit` made the same move for a service's routes,
+--    and the argument is the same: a permission that is data can be reviewed as data.
+-- 3. **the rule, as something with a name.** Every query in the store needs the same two questions —
+--    "can this tenant see this queue" and "may this tenant do this with it" — and a `view` is the
+--    schema's own way of saying what those mean: an owner may do everything, a grant may do what it
+--    names, and a wider grant covers a narrower one. Write it once and every statement reads it,
+--    rather than five statements each spelling out a joining rule that has to stay identical.
+-- 4. **the counters.** Five totals per queue, and the columns are the five things that can happen to
+--    work (a `submitted` job, a `claimed` attempt, and the three ways an attempt ends). A queue
+--    nobody declared still accumulates traffic, so a counter row is created and updated by the
+--    write that causes it (`insert … on conflict (queue) do update`) and is *not* a foreign key to
+--    the ownership table: the numbers are a fact about traffic, and ownership is a fact about who is
+--    answerable for it.
+-- 5. **the trail of the access model**: one row per accepted change, naming the queue, the tenant
+--    that made it, the owner it left behind, and when. The grants are not copied into it — the
+--    current model is the row in (2), and this is how it got there. **Name this table
+--    `queue_audit`**: the step's specification takes its insert privilege away to check that a
+--    privileged change which cannot be recorded does not happen, so its name is part of the step
+--    rather than a free choice.
+--
+-- One index belongs in here for the question the trail is read with (one queue's decisions, newest
+-- first). Nothing else is forced by the spec.
diff --git a/src/engine/authz.rs b/src/engine/authz.rs
new file mode 100644
index 0000000..9b7b100
--- /dev/null
+++ b/src/engine/authz.rs
@@ -0,0 +1,239 @@
+//! The access model of a queue: whose it is, who may do what with it, and who moved it.
+//!
+//! Step `jobq/3.13-queue-authz-attribution` is the operator's half of
+//! `sec/authz-tenant-isolation@design` (`relay/2.16-authz-audit` built the matrix for a service's
+//! routes); what changes here is what the model is *about*. A queue is not a route: it is a thing
+//! with work in it, and the three questions an operator has to be able to answer about it are who
+//! may put work in, who may take work out, and who may change the answer.
+//!
+//! Three decisions are written into the shapes below rather than into a handler:
+//!
+//! * **the model is data, and it is one value.** A [`QueueDeclaration`] is the whole of a queue's
+//!   access: an owner and a list of [`QueueGrant`]s. Two things follow. The first is that a grant
+//!   for something the model cannot express — one tenant reading another tenant's queue — has
+//!   nowhere to be written, which is the property `relay/2.16` built its matrix for. The second is
+//!   that the *rule* is one function ([`QueueDeclaration::allows`]) that a store asks, rather than
+//!   a comparison repeated in every query a store runs;
+//! * **a wider grant covers a narrower one.** `Administer` covers `Submit` and `Claim`, so a
+//!   delegated administrator does not need three rows, and the matrix has one direction rather than
+//!   a table of exceptions;
+//! * **a name that is in the model at all is a name that can see the queue.** Visibility is not a
+//!   fourth action: the queue exists *for* a tenant the moment the tenant or its owner appears in
+//!   the model, and everything the engine says about a queue to a tenant the model does not name is
+//!   the same thing it says about a queue nobody ever declared.
+//!
+//! What is *not* here: the refusal. Which of "there is no such queue" and "not with your name" a
+//! caller gets is [`crate::engine::Error`]'s business — `NoQueue` and `Forbidden` — and the store's
+//! documentation says which one each method answers with.
+
+use chrono::{DateTime, Utc};
+
+use crate::engine::domain::Queue;
+use crate::engine::tenant::Tenant;
+
+/// What somebody may do with a queue.
+///
+/// Three, and they are the three a queue has: put work in, take work out, and decide who may do
+/// either. `#[non_exhaustive]`, like every list in this crate's public vocabulary
+/// (`jobq/3.2-public-api-baseline`): a fourth (a purge, a metrics read) is a decision somebody will
+/// make later, and a caller that wrote a wildcard arm should not have to be rebuilt for it.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum QueueAction {
+    /// Write a job into the queue.
+    Submit,
+    /// Take a job out of the queue, and settle it.
+    Claim,
+    /// Change who may do the other two.
+    Administer,
+}
+
+impl QueueAction {
+    /// The name this action is stored and printed under.
+    ///
+    /// `kebab-case` is not needed for three one-word names, but the *rule* is the one
+    /// [`crate::engine::EventKind`] follows: the string is what a migration, a query and a person's
+    /// `grep` all agree on, so it is written once, here.
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        todo!("jobq/3.13-queue-authz-attribution: the token this action is stored under")
+    }
+}
+
+impl std::fmt::Display for QueueAction {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str(self.as_str())
+    }
+}
+
+/// One grant: who, and what they may do.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct QueueGrant {
+    /// Who holds it.
+    tenant: Tenant,
+    /// What it lets them do.
+    action: QueueAction,
+}
+
+impl QueueGrant {
+    /// A grant of `action` to `tenant`.
+    #[must_use]
+    pub fn new(tenant: Tenant, action: QueueAction) -> Self {
+        Self { tenant, action }
+    }
+
+    /// Who holds it.
+    #[must_use]
+    pub fn tenant(&self) -> &Tenant {
+        &self.tenant
+    }
+
+    /// What it lets them do.
+    #[must_use]
+    pub fn action(&self) -> QueueAction {
+        self.action
+    }
+}
+
+/// A queue's access model: whose it is, and who else may do what with it.
+///
+/// Built rather than written as a struct literal, so that the defaults stay in one place (a queue
+/// with no grants at all is a queue only its owner can use) and so that a field added later is a
+/// change inside the crate rather than a rebuild of every caller
+/// (`jobq/3.2-public-api-baseline`).
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct QueueDeclaration {
+    /// The queue this is about.
+    queue: Queue,
+    /// Who owns it: the tenant that may do everything, including handing it over.
+    owner: Tenant,
+    /// What everybody else may do.
+    grants: Vec<QueueGrant>,
+}
+
+impl QueueDeclaration {
+    /// A queue owned by `owner`, with nobody else named.
+    #[must_use]
+    pub fn new(queue: Queue, owner: Tenant) -> Self {
+        Self {
+            queue,
+            owner,
+            grants: Vec::new(),
+        }
+    }
+
+    /// The same declaration, with `action` granted to `tenant`.
+    ///
+    /// Granting the owner something is allowed and changes nothing: the owner already may do
+    /// everything, and a store that wrote the row would be recording a fact twice.
+    #[must_use]
+    pub fn with_grant(mut self, tenant: Tenant, action: QueueAction) -> Self {
+        self.grants.push(QueueGrant::new(tenant, action));
+        self
+    }
+
+    /// The queue this is about.
+    #[must_use]
+    pub fn queue(&self) -> &Queue {
+        &self.queue
+    }
+
+    /// Who owns it.
+    #[must_use]
+    pub fn owner(&self) -> &Tenant {
+        &self.owner
+    }
+
+    /// What everybody else may do.
+    #[must_use]
+    pub fn grants(&self) -> &[QueueGrant] {
+        &self.grants
+    }
+
+    /// Whether `tenant` may see this queue at all.
+    ///
+    /// A tenant sees the queue the moment the model names it, as the owner or in any grant: the
+    /// question this answers is not "what may they do" but "does this queue exist for them", and
+    /// everything the engine says to a tenant the model does not name is what it says about a queue
+    /// nobody declared.
+    #[must_use]
+    pub fn visible_to(&self, tenant: &Tenant) -> bool {
+        todo!(
+            "jobq/3.13-queue-authz-attribution: whether `{tenant}` appears in this queue's access \
+             model at all"
+        )
+    }
+
+    /// Whether `tenant` may do `action` with this queue.
+    ///
+    /// Two rules, and both matter: the owner may do everything, and `Administer` covers the narrower
+    /// two. What this does *not* answer is whether the queue is visible — see
+    /// [`QueueDeclaration::visible_to`], which is the question a refusal is built from.
+    #[must_use]
+    pub fn allows(&self, tenant: &Tenant, action: QueueAction) -> bool {
+        todo!(
+            "jobq/3.13-queue-authz-attribution: whether `{tenant}` may `{action}` — the owner holds \
+             every action, and a wider grant covers a narrower one"
+        )
+    }
+}
+
+/// One privileged decision about a queue, as the trail records it.
+///
+/// A row per *accepted* change of the access model: who made it, whose the queue is now, and when.
+/// The grants themselves are not columns here — the queue's current model is the declaration a store
+/// holds, and this trail is the history of how it got there, which is what an operator reading
+/// "who moved this, and when" needs.
+///
+/// `#[non_exhaustive]`: the same promise as [`crate::engine::Job`], for the same reason.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct QueueAudit {
+    /// The queue whose model changed.
+    queue: Queue,
+    /// Who changed it.
+    actor: Tenant,
+    /// Whose it is now.
+    owner: Tenant,
+    /// When the change was made, by the caller's clock.
+    at: DateTime<Utc>,
+}
+
+impl QueueAudit {
+    /// One line of the trail.
+    #[must_use]
+    pub fn new(queue: Queue, actor: Tenant, owner: Tenant, at: DateTime<Utc>) -> Self {
+        Self {
+            queue,
+            actor,
+            owner,
+            at,
+        }
+    }
+
+    /// The queue whose model changed.
+    #[must_use]
+    pub fn queue(&self) -> &Queue {
+        &self.queue
+    }
+
+    /// Who changed it.
+    #[must_use]
+    pub fn actor(&self) -> &Tenant {
+        &self.actor
+    }
+
+    /// Whose it is now.
+    #[must_use]
+    pub fn owner(&self) -> &Tenant {
+        &self.owner
+    }
+
+    /// When the change was made.
+    #[must_use]
+    pub fn at(&self) -> DateTime<Utc> {
+        self.at
+    }
+}
