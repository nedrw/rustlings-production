@@ -0,0 +1,71 @@
+//! Who a queue belongs to.
+//!
+//! An engine that several people share has one question underneath everything else an operator
+//! asks: *whose* work is this? Step `jobq/3.13-queue-authz-attribution` is where that question
+//! gets a name, and the name is a [`Tenant`] — the unit of ownership, of the access model and of
+//! the numbers.
+//!
+//! Two decisions belong to this module:
+//!
+//! * **a tenant is a name the engine can write down**, with the alphabet and the bound a
+//!   [`crate::engine::Queue`] has and for the same reasons: it is a column, a metric label and
+//!   something a person types. A name that is not one of those is refused where it is given rather
+//!   than stored as a row nobody can read back;
+//! * **a tenant is not a credential.** Nothing in this module authenticates anybody: it says who
+//!   work belongs to, and the *caller* is whoever built the store handle it uses
+//!   ([`crate::engine::Store::scoped`]). Keeping the two apart is the point — a name that arrived
+//!   inside a request is text somebody typed (`relay/2.16-authz-audit` is where that argument is
+//!   written out for a service), and an engine that trusted one would have an access model anybody
+//!   on the network could edit.
+
+use std::fmt;
+use std::str::FromStr;
+
+use crate::engine::domain::QUEUE_NAME_MAX;
+use crate::engine::error::Error;
+
+/// Longest tenant name the engine accepts, in bytes.
+///
+/// The same bound a queue name has, because the two are the same kind of thing: a key in a table
+/// and a label somebody has to be able to read in a dashboard.
+pub const TENANT_NAME_MAX: usize = QUEUE_NAME_MAX;
+
+/// Who a queue belongs to: the unit an operator holds accountable for the work in it.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct Tenant(String);
+
+impl Tenant {
+    /// Parse a tenant name.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when the name is empty, longer than [`TENANT_NAME_MAX`] bytes, or
+    /// contains anything but lower-case ASCII letters, digits, `.`, `_` and `-`.
+    pub fn parse(name: &str) -> Result<Self, Error> {
+        todo!(
+            "jobq/3.13-queue-authz-attribution: a tenant name the engine can write down — the \
+             alphabet and the bound are the ones a queue name uses, and the reason is in this \
+             module's documentation"
+        )
+    }
+
+    /// The name, as it is written in a table and printed in a report.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        todo!("jobq/3.13-queue-authz-attribution: the name this tenant was built with")
+    }
+}
+
+impl fmt::Display for Tenant {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(self.as_str())
+    }
+}
+
+impl FromStr for Tenant {
+    type Err = Error;
+
+    fn from_str(text: &str) -> Result<Self, Self::Err> {
+        Self::parse(text)
+    }
+}
