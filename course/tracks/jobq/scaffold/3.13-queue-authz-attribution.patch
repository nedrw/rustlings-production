new file mode 100644
index 0000000..0ebadca
--- /dev/null
+++ b/src/engine/usage.rs
@@ -0,0 +1,123 @@
+//! What one queue has done, counted as it happened.
+//!
+//! The access model of [`crate::engine::authz`] answers *whether*: may this tenant submit, may it
+//! claim, may it administer. It cannot answer *how much*, and that is the question an operator acts
+//! on — "who consumed the worker pool last night", "is a tenant's failure rate rising" — so
+//! `jobq/3.13-queue-authz-attribution` keeps five numbers per queue and hands them back as a value.
+//!
+//! Three decisions are in this file:
+//!
+//! * **the five numbers are the five things that can happen to work**, and they are counted where
+//!   they happen rather than reconstructed afterwards: a job is *submitted*, an attempt is
+//!   *claimed*, and an attempt *ends* — successfully (`succeeded`), reporting a failure (`failed`),
+//!   or without either (`reclaimed`: the worker stopped, or its lease ran out). Nothing else moves
+//!   them, which is what makes the arithmetic below a fact rather than a convention;
+//! * **the number an operator reaches for is derivable** ([`Usage::running`]): the attempts that
+//!   have started and not ended are exactly the jobs holding a worker right now, which is the
+//!   "who consumed the pool" answer. Deriving it rather than storing it is the difference between
+//!   one number with one writer and a sixth counter that can disagree with the other five;
+//! * **a counter is not a job.** These are totals: they survive the row they counted (a purged job
+//!   is still work that ran), they are read by an operator rather than by the engine, and no
+//!   decision in the engine reads them. A number a decision depended on would have to be exact
+//!   under every race; a number a *report* depends on has to be honest under them.
+//!
+//! Where they are written is the other half of the step and it is not this file's business: the
+//! store's own documentation says it, and the answer is the same transaction as the state change
+//! (`jobq/3.6-transaction-isolation` is the pattern), so that a write which did not happen cannot be
+//! counted.
+
+use crate::engine::domain::Queue;
+
+/// What one queue has done, counted per event.
+///
+/// `#[non_exhaustive]` with private fields and accessors, like [`crate::engine::Job`]: a sixth count
+/// (a cancellation, a dead letter) is a change inside the crate, and the readers below are the
+/// interface.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Usage {
+    /// Jobs written into the queue.
+    pub(crate) submitted: u64,
+    /// Attempts a worker started.
+    pub(crate) claimed: u64,
+    /// Attempts that finished their job.
+    pub(crate) succeeded: u64,
+    /// Attempts that reported a failure.
+    pub(crate) failed: u64,
+    /// Attempts that ended without either: handed back by a worker on its way out, or declared
+    /// abandoned when their lease ran out.
+    pub(crate) reclaimed: u64,
+}
+
+impl Usage {
+    /// Jobs written into the queue.
+    #[must_use]
+    pub fn submitted(&self) -> u64 {
+        todo!("jobq/3.13-queue-authz-attribution: how many jobs were written into this queue")
+    }
+
+    /// Attempts a worker started.
+    #[must_use]
+    pub fn claimed(&self) -> u64 {
+        todo!("jobq/3.13-queue-authz-attribution: how many attempts started")
+    }
+
+    /// Attempts that finished their job.
+    #[must_use]
+    pub fn succeeded(&self) -> u64 {
+        todo!("jobq/3.13-queue-authz-attribution: how many attempts completed their job")
+    }
+
+    /// Attempts that reported a failure, whether or not the job was retried.
+    #[must_use]
+    pub fn failed(&self) -> u64 {
+        todo!("jobq/3.13-queue-authz-attribution: how many attempts failed")
+    }
+
+    /// Attempts that ended without being finished or failed.
+    #[must_use]
+    pub fn reclaimed(&self) -> u64 {
+        todo!("jobq/3.13-queue-authz-attribution: how many attempts were handed back")
+    }
+
+    /// Attempts that have started and not ended: the jobs holding a worker right now.
+    ///
+    /// The answer to "who consumed the worker pool", and the one number here that is *derived*
+    /// rather than counted: `claimed` minus the three ways an attempt can end. It cannot go
+    /// negative (every one of the three ends an attempt that `claimed` counted), and a store that
+    /// wrote it as its own column would have a sixth number that could disagree with these five.
+    #[must_use]
+    pub fn running(&self) -> u64 {
+        todo!("jobq/3.13-queue-authz-attribution: attempts that started and have not ended")
+    }
+}
+
+/// One queue's numbers, as an operator reads them.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct QueueUsage {
+    /// Which queue.
+    queue: Queue,
+    /// What it has done.
+    usage: Usage,
+}
+
+impl QueueUsage {
+    /// One line of a report.
+    #[must_use]
+    pub fn new(queue: Queue, usage: Usage) -> Self {
+        Self { queue, usage }
+    }
+
+    /// Which queue.
+    #[must_use]
+    pub fn queue(&self) -> &Queue {
+        &self.queue
+    }
+
+    /// What it has done.
+    #[must_use]
+    pub fn usage(&self) -> Usage {
+        self.usage
+    }
+}
