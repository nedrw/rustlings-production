+/// A property a walk broke: the seed it came from, and the operations that break it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Counterexample {
+    /// The seed of the run this was found in.
+    seed: u64,
+    /// The operations, up to and including the one that broke the invariant.
+    ops: Vec<Event>,
+}
+
+impl Counterexample {
+    /// What somebody has in hand: a run's seed, and the operations that break the invariant.
+    ///
+    /// Both, because they are two different things to reproduce. The seed replays the *run*; the
+    /// operations are the *case*, and after [`shrink`] they are no longer what that seed generates
+    /// — which is exactly why they are written down next to it.
+    #[must_use]
+    pub fn new(seed: u64, ops: Vec<Event>) -> Self {
+        todo!("jobq/3.19-property-invariants: a finding is a seed and a case")
+    }
+
+    /// The seed of the run this came from.
+    #[must_use]
+    pub fn seed(&self) -> u64 {
+        todo!("jobq/3.19-property-invariants: the run this case came from")
+    }
+
+    /// The operations, up to and including the one that broke the invariant.
+    #[must_use]
+    pub fn ops(&self) -> &[Event] {
+        todo!("jobq/3.19-property-invariants: the case, as operations")
+    }
+}
+
+/// Walk `length` generated operations from `seed` through `model`, asking the invariant after
+/// every step.
+///
+/// `None` means the invariant held everywhere — which is the answer a property gets most of the
+/// time, and the only answer that is worth nothing on its own: a walk is evidence when it *can*
+/// come back with something, so the step's spec hands it an invariant that cannot hold and a model
+/// with a planted defect and checks that it does.
+///
