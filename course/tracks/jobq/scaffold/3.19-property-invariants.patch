+/// model's own alphabet lists, and treats a refusal as a step that left the job where it was.
+#[must_use]
+pub fn walk(
+    model: &dyn Model,
+    seed: u64,
+    length: usize,
+    invariant: &dyn Invariant,
+) -> Option<Counterexample> {
+    todo!("jobq/3.19-property-invariants: generate from the seed, ask after every step")
+}
+
+/// Play a written-down sequence of operations through `model`, asking the invariant after every
+/// step.
+///
+/// This is the walk without the generator in front of it, and it is what makes a finding a *case*:
+/// the operations of a counter-example can be replayed on their own, on a machine that generates
+/// nothing, and a shrunk one ([`shrink`]) is nothing but a shorter sequence somebody replays.
+///
+/// A sequence that never breaks the invariant answers `None`, and the operations it was given are
+/// not all played: the answer is the *prefix* up to the first step that said no, which is the same
+/// thing [`walk`] reports.
+#[must_use]
+pub fn replay(
+    model: &dyn Model,
+    seed: u64,
+    ops: &[Event],
+    invariant: &dyn Invariant,
+) -> Option<Counterexample> {
+    todo!("jobq/3.19-property-invariants: the walk without the generator in front of it")
+}
+
+/// The same failure with the operations it does not need taken out.
+///
+/// The contract is three sentences, and each of them is what the step's spec checks:
+///
+/// * the answer still breaks the invariant;
+/// * its operations are the ones it was given, in the same order, with some of them left out;
+/// * **no single operation can be taken out of the answer and still break it** — a locally minimal
+///   case. Deliberately not "the smallest": the smallest is a search over every subset, and the
+///   case a person reads is the one where nothing obvious is left to remove.
+///
+/// The seed is carried over, so the report says which run this came from even though the operations
+/// are no longer what that seed generates.
+#[must_use]
+pub fn shrink(
+    model: &dyn Model,
+    invariant: &dyn Invariant,
+    found: &Counterexample,
+) -> Counterexample {
