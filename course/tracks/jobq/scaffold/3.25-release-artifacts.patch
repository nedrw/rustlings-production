+//! The release's own contract: a tag, a name, a checksum file and a changelog that accounts for it.
+//!
+//! Step `jobq/3.25-release-artifacts`. Everything else in this crate is about a process that is
+//! already running; this module is about the file that leaves. Four decisions are written into the
+//! shapes below, and each one is a failure somebody has met:
+//!
+//! * **the version is read, not written.** [`VERSION`] is `CARGO_PKG_VERSION`, read out of
+//!   `Cargo.toml` when this crate is compiled, and [`Release::of`] refuses a tag that names
+//!   anything else. A second copy of the string — in the tool, in the pipeline file, in a script —
+//!   is the copy that goes stale, and a release whose tag and artifacts disagree is one nobody can
+//!   quote in a bug report;
+//! * **the name carries the version and the target.** `jobq-0.1.0-aarch64-apple-darwin` is two
+//!   facts in a file name, and a name that carries one of them is a name a mirror, a proxy or a CI
+//!   cache is free to confuse with another build. That is why the directory is [`Release::directory`]
+//!   rather than a string every caller formats;
+//! * **a checksum file is a format, not a hash.** [`checksums`] writes `<digest>  <name>` with two
+//!   spaces, sorted, one line per file, because that is what `sha256sum -c` reads — and [`verify`]
+//!   reads it back in both directions: every file has a line, and every line has a file;
+//! * **the changelog is part of the artifact.** [`changelog_ok`] refuses a version whose section is
+//!   missing, empty, or still sitting under an `Unreleased` heading. A version number with no
+//!   account of itself is a rollback nobody can reason about.
+//!
+//! What this module is **not**: it builds nothing and it uploads nothing. The release build is
+//! `cargo build --release` or a pipeline step, the upload belongs to whoever runs the release, and
+//! what is here is the part that can be *wrong* in a way nobody notices — the name, the bytes, and
+//! the account of what changed.
+//!
+//! The hash is SHA-256 from the `sha2` crate (the scaffold added the dependency), not a function of
+//! our own: a checksum file is an agreement with tools that already exist, and a hash written by
+//! hand is the kind of code that is wrong in a way nobody notices until it matters.
+
+use std::fmt;
+
+/// The version this crate is, read from the manifest when it is compiled.
+pub const VERSION: &str = env!("CARGO_PKG_VERSION");
+
+/// What a tag of this project starts with.
+pub const TAG_PREFIX: &str = "v";
+
+/// The name of the file a release is checked with.
+pub const CHECKSUMS: &str = "SHA256SUMS";
+
+/// The changelog a release's account of itself comes from.
+pub const CHANGELOG: &str = "CHANGELOG.md";
+
+/// The executables a release carries, in the order it lists them.
+pub const BINARIES: [&str; 2] = ["jobqd", "jobqc"];
+
+/// How many hex characters a digest is written in: SHA-256 is 32 bytes.
+pub const DIGEST_HEX: usize = 64;
+
+/// One file of a release, with the bytes it is a promise about.
+///
+/// The bytes are here rather than a path to them on purpose: verification is about what somebody
+/// downloaded, and a type that carried a path would make every check a second filesystem read with
+/// a second failure mode. [`Artifact::of`] is the only way to build one, so nothing in a report is
+/// a number nobody measured.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Artifact {
+    /// The file name, exactly as it is downloaded.
+    name: String,
+    /// The bytes.
+    bytes: Vec<u8>,
+}
+
+impl Artifact {
+    /// The artifact `name`, over `bytes`.
+    #[must_use]
+    pub fn of(name: &str, bytes: Vec<u8>) -> Self {
+        Self {
+            name: name.to_owned(),
+            bytes,
+        }
+    }
+
+    /// The file name, exactly as it is downloaded.
+    #[must_use]
+    pub fn name(&self) -> &str {
+        todo!("jobq/3.25-release-artifacts: the name this artifact is downloaded under")
+    }
+
+    /// The bytes.
+    #[must_use]
+    pub fn bytes(&self) -> &[u8] {
+        todo!("jobq/3.25-release-artifacts: the bytes the release ships")
+    }
+
+    /// How many bytes the artifact is.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        todo!("jobq/3.25-release-artifacts: what the artifact weighs")
+    }
+
+    /// `true` for an artifact with no bytes in it.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        todo!("jobq/3.25-release-artifacts: whether there is anything in it")
+    }
+
+    /// The artifact's digest, as the checksum file writes it.
+    #[must_use]
+    pub fn digest(&self) -> String {
+        todo!("jobq/3.25-release-artifacts: the digest of this artifact's bytes")
+    }
+}
+
+/// What one release publishes.
+///
+/// Built by [`Release::of`], which is where the tag is checked against [`VERSION`]: a release is
+/// the version this crate is, for one target, or it is nothing.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Release {
+    /// The tag it was cut from.
+    tag: String,
+    /// The version the tag names, which is this crate's.
+    version: String,
+    /// The target it was built for.
+    target: String,
+}
+
+impl Release {
+    /// The release `tag` names, for `target`.
+    ///
+    /// `target` is a build target triple (`aarch64-apple-darwin`), and it is required rather than
+    /// guessed: the release's name says which machine it is for, and a tool that inferred it would
+    /// be the tool that named the wrong one quietly.
+    ///
+    /// # Errors
+    ///
+    /// [`Refusal::NotATag`] when `tag` is not `v` and a version (`0.1.0` is not a tag,
+    /// `refs/tags/v0.1.0` is a ref), and [`Refusal::VersionMismatch`] when it names a version that
+    /// is not this crate's.
+    pub fn of(tag: &str, target: &str) -> Result<Self, Refusal> {
+        let _ = (tag, target);
+        todo!(
+            "jobq/3.25-release-artifacts: the release a tag names, or the refusal that says why it is not one"
+        )
+    }
+
+    /// The tag this release was cut from.
+    #[must_use]
+    pub fn tag(&self) -> &str {
+        todo!("jobq/3.25-release-artifacts: the tag the release was cut from")
+    }
+
+    /// The version inside it, which is this crate's.
+    #[must_use]
+    pub fn version(&self) -> &str {
+        todo!("jobq/3.25-release-artifacts: the version the tag names")
+    }
+
+    /// The target it was built for.
+    #[must_use]
+    pub fn target(&self) -> &str {
+        todo!("jobq/3.25-release-artifacts: the target the release is for")
+    }
+
+    /// The directory the release is written into: `jobq-<version>-<target>`.
+    #[must_use]
+    pub fn directory(&self) -> String {
+        todo!("jobq/3.25-release-artifacts: the two facts a release's name carries")
+    }
+
+    /// The executables the release carries.
+    #[must_use]
+    pub fn binaries(&self) -> &'static [&'static str] {
+        todo!("jobq/3.25-release-artifacts: the files a release is made of")
+    }
+
+    /// The name of the file the release is checked with.
+    #[must_use]
+    pub fn checksums(&self) -> &'static str {
+        todo!("jobq/3.25-release-artifacts: the checksum file's name")
+    }
+
+    /// Whether `output` — what a binary printed for `--version` — is this release's version.
+    ///
+    /// The version is the **last word of the first line** of that output (`jobqd 0.1.0`), so a
+    /// second line — a warning, a build stamp — is not part of it. This is the check that catches a
+    /// release assembled out of a stale build, and the reason the tool *runs* what it is about to
+    /// ship instead of trusting the directory it was handed.
+    ///
+    /// # Errors
+    ///
+    /// [`Refusal::WrongBinary`] naming the file, what it said, and what this release is.
+    pub fn accepts(&self, name: &str, output: &str) -> Result<(), Refusal> {
+        let _ = (name, output);
+        todo!("jobq/3.25-release-artifacts: whether a binary says it is this release")
+    }
+}
+
+/// Why a release was refused.
+///
+/// Every variant is a sentence an operator reads, which is why the fields carry the file, the line
+/// or the version rather than a code: [`Refusal::exit_code`] is the half a script branches on, and
+/// `Display` is the half a person reads at three in the morning.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Refusal {
+    /// The tag is not this project's tag: `v` and the version, nothing else.
+    NotATag {
+        /// What was passed as a tag.
+        tag: String,
+    },
+    /// The tag names a version that is not the one this crate is.
+    VersionMismatch {
+        /// What was passed as a tag.
+        tag: String,
+        /// The version this crate is.
+        version: String,
+    },
+    /// A file the release is made of is not where it was said to be.
+    MissingInput {
+        /// The file that was looked for.
+        name: String,
+    },
+    /// A file is there and could not be read, or is not a file that can be run.
+    Unreadable {
+        /// The file that was looked for.
+        name: String,
+        /// What the operating system said.
+        detail: String,
+    },
+    /// A binary reports a version that is not the release's.
+    WrongBinary {
+        /// The file.
+        name: String,
+        /// The version it reported.
+        said: String,
+        /// The version this release is.
+        version: String,
+    },
+    /// The bytes do not hash to what the checksum file says.
+    ChecksumMismatch {
+        /// The file.
+        name: String,
+        /// What the checksum file says.
+        expected: String,
+        /// What the bytes hash to.
+        found: String,
+    },
+    /// The checksum file names a file that was not shipped: the release is incomplete.
+    MissingFile {
+        /// The file the checksum file promises.
+        name: String,
+    },
+    /// A file that was shipped is not in the checksum file at all.
+    NotInManifest {
+        /// The file nobody checked.
+        name: String,
+    },
+    /// The changelog has no section for this version.
+    NoChangelogSection {
+        /// The version being released.
+        version: String,
+    },
+    /// The section for this version is there and empty.
+    EmptySection {
+        /// The version being released.
+        version: String,
+    },
+    /// There is still an `Unreleased` section above this version's, holding notes.
+    UnreleasedNotPromoted {
+        /// The version being released.
+        version: String,
+    },
+}
+
+impl Refusal {
+    /// The class of failure this refusal is, as the exit code of a process that made it.
+    ///
+    /// The table is `jobq/3.3-library-errors`'s: `2` the call was wrong, `3` the thing asked about
+    /// is not there, `1` this deployment is broken. A script that retries on `1` and gives up on
+    /// `2` is the reason the classes exist.
+    #[must_use]
+    pub fn exit_code(&self) -> u8 {
+        todo!("jobq/3.25-release-artifacts: the class of failure each refusal is")
+    }
+}
+
+impl fmt::Display for Refusal {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let _ = formatter;
+        todo!(
+            "jobq/3.25-release-artifacts: one sentence per refusal, naming the file or the version"
+        )
+    }
+}
+
+/// The digest of `bytes`, as the checksum file writes it: SHA-256, 64 lower-case hex characters.
+#[must_use]
+pub fn digest(bytes: &[u8]) -> String {
+    let _ = bytes;
+    todo!("jobq/3.25-release-artifacts: the SHA-256 of the bytes, in lower-case hex")
+}
+
+/// The checksum file for `artifacts`: one `<digest>  <name>` line each, sorted by name.
+///
+/// Two spaces rather than a tab, because that is the separator `sha256sum -c` reads. Sorted, so
+/// that two runs over the same set produce the same bytes; and an empty set is an empty file
+/// rather than a broken one.
+#[must_use]
+pub fn checksums(artifacts: &[Artifact]) -> String {
+    let _ = artifacts;
+    todo!("jobq/3.25-release-artifacts: the checksum file, in the format a tool reads")
+}
+
+/// Check a downloaded set of files against the checksum file it came with.
+///
+/// Both directions: every artifact must have a line carrying its digest, and every line must name
+/// an artifact that is here. The second half is the one an incomplete release slips past — a
+/// manifest promising a file nobody built looks exactly like a manifest, and the machine that
+/// consumes the release fails much later, somewhere else.
+///
+/// # Errors
+///
+/// [`Refusal::ChecksumMismatch`] naming the file and both digests, [`Refusal::MissingFile`] for a
+/// line whose file is not here, or [`Refusal::NotInManifest`] for a file no line mentions.
+pub fn verify(manifest: &str, artifacts: &[Artifact]) -> Result<(), Refusal> {
+    let _ = (manifest, artifacts);
+    todo!("jobq/3.25-release-artifacts: a checked set of files, or the first thing that is wrong")
+}
+
+/// Is this changelog ready to be the release's account of `version`?
+///
+/// Three rules, in the order a reader would notice them:
+///
+/// 1. the version has a section of its own (`## [0.1.0]`, or `## 0.1.0` with anything after it, and
+///    a `###` heading is a section *of* a release rather than a release);
+/// 2. the section says something — at least one line that is not blank and not an HTML comment;
+/// 3. there are no notes left above it. An empty `## [Unreleased]` heading is the placeholder every
+///    changelog keeps, but one that still *holds* entries means this release did not promote them,
