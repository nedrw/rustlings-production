+//! `jobq-release` — the tool that turns a build into a release.
+//!
+//! Step `jobq/3.25-release-artifacts`. This binary is the job at the end of a pipeline: it is
+//! handed the tag the build was started for and the directory the build put the two binaries in,
+//! and it either writes a release or refuses with a class a script can branch on.
+//!
+//! ```text
+//! usage: jobq-release --tag <TAG> --target <TRIPLE> --from <DIR> --out <DIR> [--changelog <FILE>]
+//!
+//! Every flag but `--changelog` is required, and none of them is guessed:
+//!
+//!     --tag        v0.1.0 — the tag the release is published under
+//!     --target     aarch64-apple-darwin — the build it was made for
+//!     --from       the directory the two binaries were built into
+//!     --out        where the release directory is written
+//!     --changelog  CHANGELOG.md — the file the release's account of itself comes from
+//! ```
+//!
+//! What it does, in the order it does it: refuse a tag that is not this crate's version; refuse a
+//! binary that is not where it was said to be, or cannot be read; refuse a binary that does not
+//! report this release's version when it is asked `--version`; refuse a changelog that does not
+//! account for the version; then write `<out>/jobq-<version>-<target>/` with the two binaries and
+//! [`CHECKSUMS`], and print the checksum file's lines so that a pipeline log shows what was
+//! published.
+//!
+//! It builds nothing. The release build is `cargo build --release` or a pipeline step of its own,
+//! and a tool that compiled would be a second build with a second set of flags — which is how a
+//! release ends up made of something other than what was tested. The tool's job is to decide
+//! whether what it was handed *is* the release the tag names, which is the check nobody has time
+//! for by hand and the one a stale build fails.
+//!
+//! The refusals are [`Refusal`], and the exit codes are the table `jobq/3.3-library-errors` wrote
+//! (`jobq/3.15-cli-contract` is where the classes became a contract): a usage error is `2`, a file
+//! that is not there is `3`, and a release that does not check out is `1`. What goes on stdout is
+//! the answer (the checksum lines), what goes on stderr is the diagnosis (one sentence), and an
+//! argument this tool does not know is a usage error that names the argument — a program that
+//! accepts what it does not understand starts with the wrong settings and never says so.
+
+use std::fmt;
+use std::path::PathBuf;
+use std::process::ExitCode;
+
+use jobq::engine::{CHANGELOG, CHECKSUMS, Refusal, Release};
+
+/// What the tool is, which flag means what, and what it refuses.
+const USAGE: &str = "\
+usage: jobq-release --tag <TAG> --target <TRIPLE> --from <DIR> --out <DIR> [--changelog <FILE>]
+
+Publishes the release the tag names: `<out>/jobq-<version>-<target>/` with the binaries and a
+checksum file. Every flag but `--changelog` is required.";
+
+/// What the tool was asked to do.
+struct Args {
+    /// The tag the release is published under.
+    tag: String,
+    /// The build target the release is for.
+    target: String,
+    /// The directory the binaries were built into.
+    from: PathBuf,
+    /// Where the release directory is written.
+    out: PathBuf,
+    /// The changelog the release's account of itself comes from.
+    changelog: PathBuf,
+}
+
+/// What went wrong: the call, or the release.
+///
+/// Two kinds, because they leave different codes behind: a call the tool could not understand is
+/// the caller's mistake, and everything [`Refusal`] describes is the release's.
+enum Fault {
+    /// The call was wrong: an unknown flag, a flag with no value, a flag left out.
+    Usage(String),
+    /// The release was refused.
+    Release(Refusal),
+}
+
+impl Fault {
+    /// The exit code this fault leaves behind.
+    fn exit_code(&self) -> u8 {
+        let _ = self;
+        todo!(
+            "jobq/3.25-release-artifacts: the code a usage error leaves, and the code a refusal leaves"
+        )
+    }
+}
+
+impl fmt::Display for Fault {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let _ = formatter;
+        todo!("jobq/3.25-release-artifacts: one sentence per fault")
+    }
+}
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    match run(&args) {
+        Ok(lines) => {
+            for line in lines {
+                println!("{line}");
+            }
+            ExitCode::SUCCESS
+        }
+        Err(fault) => {
+            eprintln!("jobq-release: {fault}");
+            ExitCode::from(fault.exit_code())
+        }
+    }
+}
+
+/// Publish the release the arguments name, answering with the checksum file's lines.
