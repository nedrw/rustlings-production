+//! The release rehearsal for `jobq/3.25-release-artifacts`.
+//!
+//! This file is the course's, not the learner's. It is what the `bench-budget` gate runs, and the
+//! numbers it prints are compared with the baseline in
+//! `course/tracks/jobq/budget/3.25-release-artifacts.toml`.
+//!
+//! What it does is the thing the step is about, once, on the artifacts this tree just built: it
+//! asks `src/bin/jobq-release.rs` for the release `v<version>` for the machine's own target, and
+//! then counts what came out. The counts are counts — files, lines — and not seconds, so the gate
+//! answers the same thing on a loaded machine as on an idle one, and no run of this file can flake
+//! because something else was compiling. `cargo test -p jobq --test release_harness --
+//! --nocapture` prints the lines by hand.
+//!
+//! Four numbers, because each one is a different half of the same promise: the release carries two
+//! files, the checksum file has a line for each of them, no binary is left uncovered, and nothing
+//! else got into the release. The rehearsal is also where the two cross-checks live: the checksum
+//! file has to verify against the bytes that were written, and this tree's own changelog has to
+//! account for the version — the release tool refuses a version whose notes are missing, so a
+//! rehearsal that ignored the changelog would pass a release nobody can publish.
+//!
+//! The numbers are printed *before* anything is asserted. A harness that panicked first would hand
+//! the gate no measurement, and a gate with no measurement can only say "blocked" — this way a
+//! release that came out wrong is reported with the counts that moved.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use jobq::engine::{
+    Artifact, BINARIES, CHANGELOG, CHECKSUMS, Release, VERSION, changelog_ok, digest, verify,
+};
+
+/// A directory of one run's own, so two runs never share a file.
+fn scratch(label: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("jobq-{label}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).expect("a scratch directory is writable");
+    dir
+}
+
+/// The directory this tree's two binaries were built into.
+fn binaries() -> PathBuf {
+    Path::new(env!("CARGO_BIN_EXE_jobqd"))
+        .parent()
+        .expect("the daemon is a file in a directory")
+        .to_path_buf()
+}
+
+/// The target this machine builds for, as the compiler reports it.
+///
+/// The release's name carries the target, exactly as it carries the version, and a rehearsal for
+/// *this* machine has to say which machine that is. A triple is a fact `rustc` already knows, so
+/// it is asked rather than composed out of `std::env::consts` (`aarch64` and `macos` are not a
+/// triple).
+fn host_target() -> String {
+    let output = Command::new("rustc")
+        .arg("-vV")
+        .output()
+        .expect("`rustc` is the compiler that built this test, so it is here to be asked");
+    let reported = String::from_utf8_lossy(&output.stdout).into_owned();
+    reported
+        .lines()
+        .find_map(|line| line.strip_prefix("host: "))
+        .unwrap_or_else(|| panic!("`rustc -vV` did not say which host it is: {reported}"))
+        .to_owned()
+}
+
+/// The files in a directory, by name, sorted. An empty answer for a directory that is not there.
+fn files_in(directory: &Path) -> Vec<String> {
+    let Ok(entries) = std::fs::read_dir(directory) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = entries
+        .map(|entry| {
+            entry
+                .expect("the directory is readable")
+                .file_name()
+                .to_string_lossy()
+                .into_owned()
+        })
+        .collect();
+    names.sort();
+    names
+}
+
+/// One file's bytes, or nothing at all: the counts below are taken before anything is asserted, and
+/// a file that is missing is one of the things they have to be able to say.
+fn read(path: &Path) -> Vec<u8> {
+    std::fs::read(path).unwrap_or_default()
+}
+
+/// The digest a checksum file's line carries for `name`, if it has one.
+fn line_for(manifest: &str, name: &str) -> Option<String> {
+    manifest.lines().find_map(|line| {
+        let mut words = line.split_whitespace();
+        let (Some(hashed), Some(named)) = (words.next(), words.next()) else {
+            return None;
+        };
+        (named == name).then(|| hashed.to_owned())
+    })
+}
+
+#[test]
+fn the_release_of_this_tree() {
+    let out = scratch("release-harness");
+    let from = binaries();
+    let tag = format!("v{VERSION}");
+    let target = host_target();
+    let release = Release::of(&tag, &target)
+        .unwrap_or_else(|refused| panic!("this crate's own tag is a release: {refused}"));
+    let directory = out.join(release.directory());
+
+    let assembled = Command::new(env!("CARGO_BIN_EXE_jobq-release"))
+        .args([
+            "--tag",
+            &tag,
+            "--target",
+            &target,
+            "--from",
+            &from.to_string_lossy(),
+            "--out",
+            &out.to_string_lossy(),
+            "--changelog",
+            CHANGELOG,
+        ])
+        .output()
+        .expect("the release tool of this crate runs");
+
+    // The measurement, taken before any assertion: the files the release carries, the lines the
+    // checksum file holds, and the two ways the two can miss each other.
+    let carried = files_in(&directory);
+    let declared: Vec<&str> = BINARIES
+        .iter()
+        .copied()
+        .filter(|name| carried.iter().any(|file| file == name))
+        .collect();
+    let manifest = std::fs::read_to_string(directory.join(CHECKSUMS)).unwrap_or_default();
+    let checksum_lines = manifest.lines().count();
+    let unverified = declared
+        .iter()
+        .filter(|name| line_for(&manifest, name).is_none())
+        .count();
+    let extras = carried
+        .iter()
+        .filter(|file| file.as_str() != CHECKSUMS && !BINARIES.contains(&file.as_str()))
+        .count();
+
+    println!("jobq-budget artifacts={}", declared.len());
+    println!("jobq-budget checksum_lines={checksum_lines}");
+    println!("jobq-budget unverified_max={unverified}");
+    println!("jobq-budget extras_max={extras}");
+
+    assert!(
+        assembled.status.success(),
+        "`jobq-release --tag {tag}` has to publish this tree's build, and it exited with {:?}:\n    {}",
+        assembled.status.code(),
+        String::from_utf8_lossy(&assembled.stderr).trim()
+    );
+    assert_eq!(
+        declared, BINARIES,
+        "the release is the two binaries this tree built: {carried:?}"
+    );
+    assert_eq!(
+        checksum_lines,
+        BINARIES.len(),
+        "and one line per binary, in the format `sha256sum -c` reads: {manifest:?}"
+    );
+
+    // The checksum file, checked against the bytes that were actually written — and against the
+    // files the build produced, because a release that re-encoded its artifacts would be a
+    // different artifact.
+    let written: Vec<Artifact> = BINARIES
+        .iter()
+        .map(|name| Artifact::of(name, read(&directory.join(name))))
+        .collect();
+    assert_eq!(
+        verify(&manifest, &written),
+        Ok(()),
+        "the checksum file the tool wrote has to check the files the tool wrote"
+    );
+    for (name, artifact) in BINARIES.iter().zip(&written) {
+        assert_eq!(
+            digest(&read(&from.join(name))),
+            digest(artifact.bytes()),
+            "{name} is the file that was built, byte for byte"
+        );
+    }
+
+    // And the version this release is has an account of itself: the tool refuses a changelog that
+    // does not, so a rehearsal that skipped this would report a release nobody can publish.
+    let changelog = std::fs::read_to_string(CHANGELOG).unwrap_or_default();
+    assert_eq!(
+        changelog_ok(&changelog, VERSION),
+        Ok(()),
+        "this tree's own `{CHANGELOG}` has to account for `{VERSION}`"
+    );
+
+    let _ = std::fs::remove_dir_all(&out);
+}
