+    let _ = args;
+    todo!(
+        "jobq/3.25-release-artifacts: `--tag`, `--target`, `--from`, `--out` and `--changelog`, and a refusal that names what it did not understand"
+    )
+}
+
+/// What one binary says when it is asked for its version.
+fn reported_version(binary: &std::path::Path, name: &str) -> Result<String, Fault> {
+    let _ = (binary, name);
+    todo!("jobq/3.25-release-artifacts: run the binary with `--version` and answer what it printed")
