+//! The `jobqc` binary: a shell around the library.
+//!
+//! Everything this file decides is about *this process*: the arguments it was given, the
+//! environment it was started in, its standard input, the two streams its answer goes to, and the
+//! code it leaves behind. What the answer *is* — which command ran, which bytes went to which
+//! stream, which class of failure is which number — belongs to `jobq::cli`
+//! (step `jobq/3.15-cli-contract`), and the point of keeping it there is that this file has nowhere
+//! to disagree with it.
+
+use std::process::ExitCode;
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let env: Vec<(String, String)> = std::env::vars().collect();
+    let outcome = jobq::cli::run(args, &env, &mut std::io::stdin().lock());
+
+    // The two streams, in the order a reader of a terminal sees them, and the code. `print!` rather
+    // than `println!`: the newlines are part of the answer, and a second one per line is a second
+    // thing a script would have to strip.
+    if !outcome.stdout().is_empty() {
+        print!("{}", outcome.stdout());
+    }
+    if !outcome.stderr().is_empty() {
+        eprint!("{}", outcome.stderr());
+    }
+    ExitCode::from(outcome.code())
+}
