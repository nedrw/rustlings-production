+//! The budget's harness for `jobq/3.24-unsafe-budget`.
+//!
+//! This file is the course's, not the learner's. It is what the `bench-budget` gate runs, and the
+//! numbers it prints are compared with the baselines in
+//! `course/tracks/jobq/budget/3.24-unsafe-budget.toml` — the crate's production code, counted by the
+//! crate's own audit.
+//!
+//! What it measures is a **count, never the clock**: the uses of a keyword in `src/**/*.rs`, how many
+//! of them have no reason above them, and how many files the policy does not cover. `kiln` compares
+//! counts, so the gate answers the same thing on a loaded machine as on an idle one, and no run of
+//! this file can flake because something else was compiling. `cargo test -p jobq --test
+//! unsafe_budget -- --nocapture` prints the lines by hand; the `jobq-budget` prefix is what the gate
+//! reads.
+//!
+//! Three numbers that are all zero are still a measurement, and this file says which crate it read:
+//! the walk below is over the project's own `src/`, and the policy comes from the project's own
+//! `Cargo.toml`. A harness that read nothing would print zeros that mean nothing, which is what the
+//! assertion before the first print is for.
+
+use std::path::{Path, PathBuf};
+
+use jobq::engine::{BUDGET, audit, check, counts, denies_unsafe_code};
+
+/// Every `.rs` file below `root`, in path order.
+fn sources(root: &Path) -> Vec<PathBuf> {
+    let mut found = Vec::new();
+    let mut pending = vec![root.to_path_buf()];
+    while let Some(directory) = pending.pop() {
+        let entries = std::fs::read_dir(&directory)
+            .unwrap_or_else(|error| panic!("{} could not be listed: {error}", directory.display()));
+        for entry in entries {
+            let path = entry.expect("the directory is readable").path();
+            if path.is_dir() {
+                pending.push(path);
+            } else if path.extension().is_some_and(|extension| extension == "rs") {
+                found.push(path);
+            }
+        }
+    }
+    found.sort();
+    found
+}
+
+/// One file, read from the project it is part of.
+fn read(path: &Path) -> String {
+    std::fs::read_to_string(path)
+        .unwrap_or_else(|error| panic!("{} could not be read: {error}", path.display()))
+}
+
+/// The project's own sources, audited against the project's own policy.
+fn audits(root: &Path) -> Vec<jobq::engine::Audit> {
+    let policy = read(&root.join("Cargo.toml"));
+    let denies = denies_unsafe_code(&policy);
+    let files = sources(&root.join("src"));
+    assert!(
+        !files.is_empty(),
+        "{} has no `src/**/*.rs` to audit, so every number below would be a zero that means \
+         nothing: this harness reads the project, and a project with no production code is not \
+         what it is for",
+        root.display()
+    );
+    files
+        .iter()
+        .map(|path| {
+            let file = path
+                .strip_prefix(root)
+                .unwrap_or(path)
+                .to_string_lossy()
+                .replace('\\', "/");
+            audit(&file, &read(path), denies)
+        })
+        .collect()
+}
+
+#[test]
+fn the_budget() {
+    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let audits = audits(&root);
+    for line in counts(&audits) {
+        println!("{line}");
+    }
+    if let Err(refused) = check(&audits, BUDGET) {
+        // Not a `jobq-budget` line: the numbers above are the measurement, and this is what a
+        // reviewer is handed when the crate is outside its budget.
+        println!("the crate's own policy refuses this tree: {refused}");
+    }
+}
