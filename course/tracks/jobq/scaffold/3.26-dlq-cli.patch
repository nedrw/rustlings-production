index 0000000..29ed19f
--- /dev/null
+++ b/tests/dlq_harness.rs
@@ -0,0 +1,218 @@
+//! The budget's harness for `jobq/3.26-dlq-cli`.
+//!
+//! This file is the course's, not the learner's. It is what the `bench-budget` gate runs, and the
+//! numbers it prints are compared with the baselines in
+//! `course/tracks/jobq/budget/3.26-dlq-cli.toml` — one workload of calls through the operator's
+//! door, and the record those calls leave behind.
+//!
+//! What it measures is a **count, never the clock**: the calls the workload makes, the lines the
+//! record holds afterwards, how many of those lines no call of the workload accounts for, and how
+//! many have no name on them. `kiln` compares counts, so the gate answers the same thing on a
+//! loaded machine as on an idle one, and no run of this file can flake because something else was
+//! compiling. `cargo test -p jobq --test dlq_harness -- --nocapture` prints the lines by hand; the
+//! `jobq-budget` prefix is what the gate reads.
+//!
+//! The four numbers are two promises, each read from both sides. **A call is one line, or nothing
+//! at all**: `acts` counts the calls this workload makes — five of them have to be refused, and
+//! that is the point of counting them — while `record_lines` counts what the record actually
+//! holds, so the distance between the two is what a refusal left behind, which is nothing. And
+//! **a line is about something a person did**: `orphans_max` counts lines no call of this workload
+//! accounts for, and `unattributed_max` counts those with no name on them. Both are upper bounds
+//! and both are zero, because a record that can be written for an act that did not happen is worse
+//! than no record at all — it is the one an auditor trusts.
+//!
+//! The numbers are printed *before* anything is asserted. A harness that panicked first would hand
+//! the gate no measurement, and a gate with no measurement can only say "blocked"; this way a
+//! record that came out wrong is reported with the counts that moved.
+
+use jobq::engine::{
+    Act, Error, JobAudit, JobId, MemoryStore, Order, Queue, Store, SubmitRequest, WorkerId,
+    dead_letters,
+};
+
+/// The queue every dead letter of this workload dies in.
+const QUEUE: &str = "billing";
+/// The dead letters the workload builds before it acts on any of them.
+const ROWS: usize = 12;
+/// How many of them are replayed; the rest are thrown away.
+const REPLAYED: usize = 6;
+/// The calls the workload makes that have to be refused: three the *order* refuses before anything
+/// is read (no reason at all, a reason of nothing but spaces, no name), and two the *row* refuses
+/// after it (an identity nobody wrote, and a job that is owed an attempt again rather than dead).
+const REFUSALS: usize = 5;
+/// The page the record is read with: one workload's acts, and no more.
+const PAGE: usize = 64;
+/// Who replays, and who throws work away. Two names, so that a line which lost its actor is a line
+/// the counts below can see.
+const REPLAYER: &str = "ada";
+/// Who throws work away.
+const DISCARDER: &str = "grace";
+/// The sentence every dead letter's last attempt died with.
+const REASON: &str = "the payment provider answered 502 and kept answering it";
+
+/// A queue, by name.
+fn queue() -> Queue {
+    Queue::parse(QUEUE).unwrap_or_else(|error| panic!("`{QUEUE}` is a queue name: {error}"))
+}
+
+/// The worker this workload claims with.
+fn worker() -> WorkerId {
+    WorkerId::new("dlq-harness")
+}
+
+/// One dead letter, built through the port: submitted, claimed, and failed.
+///
+/// The tool cannot fail a job — `jobqd` does that — so the rows this workload acts on are built the
+/// way the daemon leaves them, and every count below is about the acts rather than about the
+/// setup.
+async fn dead_letter(store: &dyn Store, invoice: usize) -> JobId {
+    let queue = queue();
+    let id = store
+        .enqueue(
+            SubmitRequest::new(queue.clone(), serde_json::json!({ "invoice": invoice }))
+                .with_max_attempts(1),
+        )
+        .await
+        .unwrap_or_else(|error| panic!("the port accepts this request: {error}"))
+        .id();
+    store
+        .claim(&worker(), &queue, 1)
+        .await
+        .unwrap_or_else(|error| panic!("a queue with a job due hands one out: {error}"));
+    store
+        .fail(&worker(), &id, REASON)
+        .await
+        .unwrap_or_else(|error| panic!("recording a failure cannot fail here: {error}"));
+    id
+}
+
+/// The record, as the three fields a caller compares lines by.
+async fn record(store: &dyn Store) -> Vec<(Act, JobId, String)> {
+    store
+        .acts(PAGE)
+        .await
+        .unwrap_or_else(|error| panic!("reading the record cannot fail here: {error}"))
+        .into_iter()
+        .map(|line| (line.action(), line.job(), line.actor().to_owned()))
+        .collect()
+}
+
+/// One call's answer, as the workload's ledger of lines sees it.
+///
+/// A refusal is not a failure here: it is counted, because what it leaves behind is the whole of
+/// what this file is measuring.
+fn ledger(
+    answer: Result<JobAudit, Error>,
+    taken: &mut Vec<(Act, JobId, String)>,
+    refused: &mut usize,
+) {
+    match answer {
+        Ok(line) => taken.push((line.action(), line.job(), line.actor().to_owned())),
+        Err(_) => *refused += 1,
+    }
+}
+
+#[tokio::test]
+async fn the_budget() {
+    let store = MemoryStore::new();
+
+    // The rows this workload acts on, built through the port: every one of them a job the engine
+    // gave up on, which is what an act is about.
+    let mut dead: Vec<JobId> = Vec::with_capacity(ROWS);
+    for invoice in 0..ROWS {
+        dead.push(dead_letter(&store, invoice).await);
+    }
+
+    // A look is not an act (`jobq/3.16-dlq-tooling`: reading is not an action), and it is the
+    // operator's first move — so it is here, and it counts for nothing below.
+    let stuck = store
+        .list(&dead_letters())
+        .await
+        .unwrap_or_else(|error| panic!("listing the dead letters cannot fail here: {error}"));
+    let before = record(&store).await;
+
+    let mut calls = 0usize;
+    let mut refused = 0usize;
+    let mut taken: Vec<(Act, JobId, String)> = Vec::new();
+
+    // Three calls the order refuses before the store reads anything. Two of them point at rows the
+    // twelve acts below still have to move, which is why they come first.
+    for order in [
+        Order::discard(dead[ROWS - 1], DISCARDER, ""),
+        Order::discard(dead[ROWS - 2], DISCARDER, "   "),
+        Order::replay(dead[ROWS - 3], "   "),
+    ] {
+        calls += 1;
+        ledger(store.operate(&order).await, &mut taken, &mut refused);
+    }
+
+    // The twelve acts: the first half of the dead letters get another life, the second half are
+    // thrown away with a reason. Every one of them is a line.
+    for id in dead.iter().take(REPLAYED) {
+        calls += 1;
+        let answer = store.operate(&Order::replay(*id, REPLAYER)).await;
+        ledger(answer, &mut taken, &mut refused);
+    }
+    for id in dead.iter().skip(REPLAYED) {
+        calls += 1;
+        let answer = store
+            .operate(&Order::discard(*id, DISCARDER, "customer asked us to stop"))
+            .await;
+        ledger(answer, &mut taken, &mut refused);
+    }
+
+    // Two calls the row refuses after the read: an identity nobody wrote, and a job that is owed an
+    // attempt again rather than dead — the first one the workload replayed.
+    for order in [
+        Order::replay(JobId::new(), REPLAYER),
+        Order::discard(dead[0], DISCARDER, "again"),
+    ] {
+        calls += 1;
+        ledger(store.operate(&order).await, &mut taken, &mut refused);
+    }
+
+    let record = record(&store).await;
+    let record_lines = record.len();
+    let orphans = record.iter().filter(|line| !taken.contains(line)).count();
+    let unattributed = record
+        .iter()
+        .filter(|(_, _, actor)| actor.trim().is_empty())
+        .count();
+
+    // The measurement, taken before any assertion: the calls the workload made, the lines the
+    // record holds because of them, and the two ways a line can be about nothing.
+    println!("jobq-budget acts={calls}");
+    println!("jobq-budget record_lines={record_lines}");
+    println!("jobq-budget orphans_max={orphans}");
+    println!("jobq-budget unattributed_max={unattributed}");
+
+    // What makes those four numbers a measurement rather than four numbers: the queue this file
+    // built, an empty record before the acts began, and the two promises the pairs stand for.
+    assert_eq!(
+        stuck.len(),
+        ROWS,
+        "the look has to show the rows this workload built, or the counts below are about a queue \
+         this file did not make"
+    );
+    assert!(
+        before.is_empty(),
+        "a submit, a claim and a failure are work and not acts, and a look is not an act either, so \
+         the record is empty before the twelve: {before:?}"
+    );
+    assert_eq!(
+        refused, REFUSALS,
+        "every act this workload expects to be refused was refused — an act that went through \
+         where one of these five belongs writes a line that nothing accounts for"
+    );
+    assert_eq!(
+        record_lines,
+        taken.len(),
+        "one act is one line: the port answered with {} of them and the record holds \
+         {record_lines}",
+        taken.len()
+    );
+    assert_eq!(
+        orphans, 0,
+        "not one line of the record is about an act this workload did not take"
+    );
+}
