+//! What a mutation run proves, and what it does not.
+//!
+//! Step `jobq/3.20-mutation-threshold`. `jobq/3.19-property-invariants` built the machine that can
+//! answer *no*; this module is what happens to that answer. A mutation run takes a rule of the
+//! code, changes it in one place, and asks the suite whether it noticed: the mutants the suite
+//! failed on are **killed** and the ones it shrugged at **survived**, and the share that died is the
+//! only number in a build report that is about the tests rather than about the code.
+//!
+//! Four decisions are written into the shapes below:
+//!
+//! * **the score is a share of the judged, not of the attempted.** A mutant whose site does not
+//!   compile is not evidence about the suite, and counting it would let a project raise its score by
+//!   making its own code unbuildable.
+//! * **an empty run has no percentage, and is not a pass.** [`Score::percent`] answers `None` rather
+//!   than `0`, and [`MutationPolicy::judge`] has a floor of one mutant whatever the configured floor says:
+//!   a denominator of zero makes a percentage undefined, and `0%` compared with a threshold is a
+//!   number that means something it does not.
+//! * **there are three answers, not two.** "The suite is not good enough" and "there is not enough
+//!   evidence to say" send a maintainer to different places — one to write a test, the other to fix
+//!   whatever stopped the mutants from being judged — and a boolean has to fold one of them into
+//!   the other.
+//! * **the survivors are named.** A score nobody can act on is a score that gets ignored, so a
+//!   survivor carries the place a reader's editor can open ([`Survivor::place`]) and the rewrite
+//!   that lived.
+//!
+//! What this module is **not**: a tool. It does not parse Rust, rewrite it or build it — the
+//! course's `mutants` gate does that (`kiln check jobq/3.20-mutation-threshold --slow`), and so does
+//! `cargo mutants` in a project that has it installed. What lives here is the arithmetic a build is
+//! held to and the report it prints, which is the half a reviewer argues about.
+
+use std::fmt;
+
+use crate::engine::walk::{Invariant, Model, walk};
+
+/// What a run over a set of mutants found: the ones the suite noticed, and the ones it did not.
+///
+/// Two counts and no percentage of its own: "how many" is what a run produces, and "what share"
+/// is what a policy does with it ([`Score::percent`]).
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Score {
+    /// Mutants the suite noticed: a case failed, so the change is covered.
+    killed: usize,
+    /// Mutants it did not: the change is in the tree and every case is green.
+    survived: usize,
+}
+
+impl Score {
+    /// A tally: `killed` mutants the suite noticed, `survived` mutants it did not.
+    #[must_use]
+    pub fn new(killed: usize, survived: usize) -> Self {
+        todo!("jobq/3.20-mutation-threshold: a run is two counts")
+    }
+
+    /// The mutants the suite noticed.
+    #[must_use]
+    pub fn killed(&self) -> usize {
+        todo!("jobq/3.20-mutation-threshold: the mutants a case failed on")
+    }
+
+    /// The mutants it did not.
+    #[must_use]
+    pub fn survived(&self) -> usize {
+        todo!("jobq/3.20-mutation-threshold: the mutants every case was green on")
+    }
+
+    /// The mutants that were judged at all: the denominator of the score.
+    ///
+    /// Judged rather than attempted, and the difference is a mutant whose site does not compile or
+    /// whose run never finished: it says nothing about the suite either way, so it is outside the
+    /// fraction rather than inside it as a survivor.
+    #[must_use]
+    pub fn judged(&self) -> usize {
+        todo!("jobq/3.20-mutation-threshold: the denominator of the score")
+    }
+
+    /// The share of the judged mutants that died, in whole percent, or `None` when nothing was
+    /// judged.
+    ///
+    /// `None` rather than zero, and that is the decision this type exists to make: an empty run is
+    /// not the worst possible score, it is the *absence* of one. A `0%` would compare with a
+    /// threshold like any other number, and a build that judged nothing would be reported as a
+    /// build that failed rather than as a build that did not look.
+    ///
+    /// The division truncates — `Score::new(5, 6)` is 45%, not 46 — because a threshold of 80 is a
+    /// decision about whole percent and rounding up would let a run one mutant short of it read as
+    /// a pass.
+    #[must_use]
+    pub fn percent(&self) -> Option<u32> {
+        todo!("jobq/3.20-mutation-threshold: a share of what was judged, and `None` for nothing")
+    }
+}
