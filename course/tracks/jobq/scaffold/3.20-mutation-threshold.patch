+/// One mutant the suite did not notice, at a place a person can look at.
+///
+/// The place rather than the mutant itself: a survivor is something to *write a case for*, and what
+/// that case needs is the file, the line, the column and the rewrite that lived — the same four
+/// things `kiln`'s own gate reports, because a report from a tool and a report from this project
+/// being the same shape is what lets a reviewer read exactly one of them.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Survivor {
+    /// The file, relative to the project.
+    path: String,
+    /// 1-based line.
+    line: usize,
+    /// 1-based column within the line: one line can hold two of the same operator, and a report
+    /// that named only the line would name the same place twice.
+    column: usize,
+    /// The rewrite that lived, written the way the tool describes it.
+    edit: String,
+}
+
