+/// The rule a build is held to: a share of the judged mutants, and enough of them to mean anything.
+///
+/// `MutationPolicy` rather than `Policy`: the engine already has one of those (`jobq/3.9-priority-fairness`,
+/// the scheduler's rule about which job goes first), and the two have nothing to do with each other —
+/// one decides which work runs, and this one decides whether a build ships.
+///
+/// Two numbers rather than one, because a threshold on its own is met by a run that judged three
+/// mutants well: a hundred percent of three is not the same evidence as a hundred percent of forty,
+/// and a policy that cannot say so is a policy that a project tunes its sampling until it passes.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MutationPolicy {
+    /// The percentage of the judged mutants a run has to kill.
+    threshold: u32,
+    /// How many mutants have to be judged before the percentage counts as evidence.
+    min_judged: usize,
+}
+
+impl MutationPolicy {
+    /// A policy: `threshold` percent of at least `min_judged` judged mutants.
+    #[must_use]
+    pub fn new(threshold: u32, min_judged: usize) -> Self {
+        todo!("jobq/3.20-mutation-threshold: a threshold and a floor")
+    }
+
+    /// The share of the judged mutants a build has to kill.
+    #[must_use]
+    pub fn threshold(&self) -> u32 {
+        todo!("jobq/3.20-mutation-threshold: the share this policy asks for")
+    }
+
+    /// How many mutants have to be judged before the share is evidence.
+    #[must_use]
+    pub fn min_judged(&self) -> usize {
+        todo!("jobq/3.20-mutation-threshold: the evidence this policy asks for")
+    }
+
+    /// Whether this policy can be met at all.
+    ///
+    /// "Nobody can satisfy this" has exactly two shapes, and both of them are mistakes a review
+    /// catches rather than a build: a threshold above 100%, which nothing can reach, and a floor of
+    /// zero, which is a rule that reads as if it is about evidence and then asks for none. The
+    /// arithmetic below refuses the second one on its own ([`MutationPolicy::judge`] keeps a floor of one
+    /// mutant whatever the configuration says); what this method is for is the *review*, because a
+    /// policy is a decision somebody wrote down and a decision that cannot be met is a decision
+    /// nobody read.
+    #[must_use]
+    pub fn is_satisfiable(&self) -> bool {
+        todo!("jobq/3.20-mutation-threshold: the two ways to write a rule nobody can meet")
+    }
+
+    /// What `score` means to this policy.
+    ///
+    /// Three answers rather than two, because "the suite is not good enough" and "there is not
+    /// enough evidence to say" are different sentences to whoever reads them. The floor is the
+    /// configured one, raised to one mutant: a run that judged nothing has proven nothing, and that
+    /// is a property of the arithmetic rather than a setting somebody can turn off.
+    ///
+    /// The comparison is `>=` rather than `>` on purpose: a threshold of 80 is *met* by 80%.
+    #[must_use]
+    pub fn judge(&self, score: Score) -> Verdict {
+        todo!("jobq/3.20-mutation-threshold: three answers, and a floor of one mutant")
+    }
+}
+
+/// What a score means to a policy.
+///
+/// `#[non_exhaustive]`, like the rest of this crate's vocabulary: a fourth answer (a run that was
+/// cut short by its budget, say) is a decision somebody will make, and a caller that wrote a
+/// wildcard arm should not have to be rebuilt for it.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Verdict {
+    /// Enough evidence, and at or above the threshold.
+    Passed,
+    /// Enough evidence, and below the threshold.
+    Failed,
+    /// Not enough evidence to say either way: neither a pass nor a failure.
+    Unproven,
+}
+
+impl Verdict {
+    /// The word a report prints and a CI job greps for.
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        todo!("jobq/3.20-mutation-threshold: the three words a report prints")
+    }
+}
+
+impl fmt::Display for Verdict {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(self.as_str())
+    }
+}
