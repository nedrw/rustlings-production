+
+/// The next operation: an event of the model's alphabet, and never anything else.
+///
+/// The alphabet is `EVENTS` rather than a list written here, because the list the model answers
+/// about and the list a walk draws from have to be one list (`jobq/3.14-job-state-machine`).
+fn draw(rng: &mut Rng) -> Event {
+    let index = rng.below(EVENTS.len() as u64) as usize;
+    EVENTS
+        .into_iter()
+        .cycle()
+        .nth(index)
+        .unwrap_or(Event::Claim)
+}
+
+/// The operations up to and including `at`.
+fn prefix(ops: &[Event], at: usize) -> Vec<Event> {
+    ops.iter().copied().take(at + 1).collect()
+}
+
+/// The index of the first step of `ops` that broke the invariant, if one did.
+fn first_break(model: &dyn Model, invariant: &dyn Invariant, ops: &[Event]) -> Option<usize> {
+    let mut history: Vec<Event> = Vec::with_capacity(ops.len());
+    let mut state = JobState::Queued;
+    for (index, event) in ops.iter().copied().enumerate() {
+        history.push(event);
+        let (after, applied) = destination(model, state, event);
+        let step = Step {
+            event,
+            before: state,
+            after,
+            applied,
+        };
+        if !invariant.holds(&history, &step) {
+            return Some(index);
+        }
+        state = after;
+    }
+    None
+}
+
+/// What the model answered, as a state and a flag: a refusal leaves the job where it was.
+fn destination(model: &dyn Model, state: JobState, event: Event) -> (JobState, bool) {
+    match model.step(state, event) {
+        Ok(after) => (after, true),
+        Err(_) => (state, false),
+    }
+}
+
+/// The first operation whose removal keeps the failure, from the end of the sequence towards the
+/// front, or `None` when there is none.
+///
+/// The direction is the one a person reads a case in: the last operation is usually the noise a
+/// long walk added after the interesting one, so it is the first candidate.
+fn remove_one(model: &dyn Model, invariant: &dyn Invariant, ops: &[Event]) -> Option<Vec<Event>> {
+    for index in (0..ops.len()).rev() {
+        let mut candidate = ops.to_vec();
+        candidate.remove(index);
+        if first_break(model, invariant, &candidate).is_some() {
+            return Some(candidate);
+        }
+    }
+    None
 }
