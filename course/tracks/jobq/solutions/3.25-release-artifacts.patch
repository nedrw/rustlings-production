+/// The refusal a file deserves: "not there" and "not usable" are different answers, and they
+/// leave different exit codes behind, so the operating system's own reason is what decides.
+fn fault_for(path: &Path, error: &std::io::Error) -> Fault {
+    let name = path.display().to_string();
+    if error.kind() == std::io::ErrorKind::NotFound {
+        Refusal::MissingInput { name }.into()
+    } else {
+        Refusal::Unreadable {
+            name,
+            detail: error.to_string(),
+        }
+        .into()
+    }
+}
+
+/// Write `<out>/<directory>/` with the binaries and the checksum file, and answer with the text of
+/// the checksum file — which is what a pipeline log should show.
+fn write_release(release: &Release, artifacts: &[Artifact], out: &Path) -> std::io::Result<String> {
+    let directory = out.join(release.directory());
+    std::fs::create_dir_all(&directory)?;
+    for artifact in artifacts {
+        std::fs::write(directory.join(artifact.name()), artifact.bytes())?;
+    }
+    let manifest = checksums(artifacts);
+    std::fs::write(directory.join(CHECKSUMS), &manifest)?;
+    Ok(manifest)
 }
