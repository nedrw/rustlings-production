+    /// that names nothing ever ([`HORIZON_DAYS`] is where the search gives up).
     #[must_use]
     pub fn next_after(&self, after: DateTime<Utc>) -> Option<DateTime<Utc>> {
-        todo!(
-            "jobq/3.10-cron-schedules: the next reading after `{after}` — including the two DST days"
-        )
+        // The local date `after` falls on is where the search starts rather than "an hour later":
+        // which candidates are still ahead is decided by comparing instants below, and on the day
