+    /// Whether `date` is one the two day fields name (cron's union rule, see the module docs).
+    fn matches_date(&self, date: NaiveDate) -> bool {
+        if self.months & (1 << (date.month() - 1)) == 0 {
+            return false;
+        }
+        let day_of_month = self.days & (1 << (date.day() - 1)) != 0;
+        let day_of_week = self.weekdays & (1 << date.weekday().num_days_from_sunday()) != 0;
+        match (self.day_of_month_any, self.day_of_week_any) {
+            // Both restricted: the run happens on either. This is the half of the rule that an
+            // engine gets wrong silently — `0 0 1 * 1` means thirty-odd runs a year, not one a
+            // month, and everybody who wrote such a line already believes that.
+            (false, false) => day_of_month || day_of_week,
+            (false, true) => day_of_month,
+            (true, false) => day_of_week,
+            (true, true) => true,
+        }
     }
