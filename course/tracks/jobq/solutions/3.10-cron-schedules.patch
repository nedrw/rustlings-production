+    /// The first instant strictly after `after` that the expression names on `date`, if there is
+    /// one.
+    fn first_reading_after(&self, date: NaiveDate, after: DateTime<Utc>) -> Option<DateTime<Utc>> {
+        let mut runs = Vec::new();
+        for hour in 0..=23 {
+            if self.hours & (1 << hour) == 0 {
+                continue;
+            }
+            for minute in 0..=59 {
+                if self.minutes & (1 << minute) == 0 {
+                    continue;
+                }
+                if let Some(local) = date.and_hms_opt(hour, minute, 0) {
+                    runs.extend(self.readings(local));
+                }
+            }
+        }
+        // Sorted, because the two instants of a reading the clock repeats are not in the order the
+        // local times are: on the day New York goes back, 01:45's *first* instant comes after
+        // 01:30's second one. Sorting one day's worth of instants is what keeps "the first one after
+        // `after`" the same answer whatever the offset did in between.
+        runs.sort_unstable();
+        runs.into_iter().find(|at| *at > after)
+    }
+
+    /// Every instant at which a local clock reads `local`: none when the clock skips that reading,
+    /// one when it reads it once, two when it reads it twice.
+    fn readings(&self, local: NaiveDateTime) -> Vec<DateTime<Utc>> {
+        match self.zone.from_local_datetime(&local) {
+            // The spring-forward day: this reading does not exist, so this run does not happen. The
+            // caller that cannot afford to lose it is the caller with a policy (see the module
+            // docs), not a schedule to reinterpret.
+            LocalResult::None => Vec::new(),
+            LocalResult::Single(at) => vec![at.with_timezone(&Utc)],
+            // The fall-back day: the same wall clock reads this twice, and both readings are runs.
+            LocalResult::Ambiguous(first, second) => {
+                vec![first.with_timezone(&Utc), second.with_timezone(&Utc)]
+            }
+        }
+    }
+}
+
+/// Read one field: a comma-separated list of `*`, `N`, `N-M`, `*/S` and `N-M/S`.
+fn read_field(text: &str, field: Field) -> Result<Parsed, Error> {
+    if text == "*" {
+        return Ok(Parsed {
+            bits: mask(field),
+            star: true,
+        });
+    }
+    let mut bits = 0u64;
+    for item in text.split(',') {
+        bits |= read_item(item, field)?;
+    }
+    Ok(Parsed { bits, star: false })
+}
+
+/// One item of a field.
+fn read_item(item: &str, field: Field) -> Result<u64, Error> {
+    let (range, step) = match item.split_once('/') {
+        Some((range, step)) => (range, Some(step)),
+        None => (item, None),
+    };
+    let step = match step {
+        Some(text) => number(text, item, field)?,
+        None => 1,
+    };
+    if step == 0 {
+        return Err(refused(format!(
+            "`{}`: `{item}` steps by zero, so it names nothing — a step of one is what `*` already \
+             means",
+            field.name
+        )));
+    }
+    let (first, last) = if range == "*" {
+        (field.low, field.high)
+    } else if let Some((from, to)) = range.split_once('-') {
+        let from = number(from, item, field)?;
+        let to = number(to, item, field)?;
+        if from > to {
+            return Err(refused(format!(
+                "`{}`: `{item}` is written backwards ({from} to {to}) — a range runs from low to \
+                 high, and a typo here is a schedule that never runs",
+                field.name
+            )));
+        }
+        (from, to)
+    } else {
+        let from = number(range, item, field)?;
+        // `5/2` is "every other value from 5 to the end of the field"; a bare `5` is just 5, which
+        // is why the end of the range depends on whether a step was written.
+        (from, if step > 1 { field.high } else { from })
+    };
+    for value in [first, last] {
+        if value < field.low || value > field.high {
+            return Err(refused(format!(
+                "`{}`: `{value}` is outside the values this field allows ({} to {}) — the item is \
+                 `{item}`",
+                field.name, field.low, field.high
+            )));
+        }
+    }
+    let mut bits = 0u64;
+    let mut value = first;
+    while value <= last {
+        bits |= 1u64 << (value - field.low);
+        value += step;
+    }
+    Ok(bits)
+}
+
+/// A number out of an item, with a message that names the field and the item it came from.
+fn number(text: &str, item: &str, field: Field) -> Result<u32, Error> {
+    text.parse::<u32>().map_err(|_| {
+        refused(format!(
+            "`{}`: `{item}` is not a number — a field is a list of `*`, `N`, `N-M`, `*/S` and \
+             `N-M/S`, and names like `JAN` or `MON` are not this grammar",
+            field.name
+        ))
+    })
+}
+
+/// Every value a field allows, as bits.
+fn mask(field: Field) -> u64 {
+    let width = field.high - field.low + 1;
+    (1u64 << width) - 1
+}
+
+/// One refusal, in the variant a caller can branch on: a schedule that does not read is a call site
+/// somebody has to fix, not a store that has to be retried.
+fn refused(detail: String) -> Error {
+    Error::Invalid { detail }
 }
