+        let start = self.zone.from_utc_datetime(&after.naive_utc()).date_naive();
+        for ahead in 0..=HORIZON_DAYS {
+            let Some(date) = start.checked_add_signed(TimeDelta::days(ahead)) else {
+                // The calendar ran out before the horizon did: nothing this expression names is
+                // reachable either.
+                return None;
+            };
