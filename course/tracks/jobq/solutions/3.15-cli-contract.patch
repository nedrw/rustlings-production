+
+/// The whole behaviour, as the `Result` the two streams are decided from.
+fn answer(
+    args: impl IntoIterator<Item = String>,
+    env: &[(String, String)],
+    input: &mut dyn Read,
+) -> Result<String, Error> {
+    let Parsed {
+        options,
+        invocation,
+    } = Parsed::parse(args)?;
+    let command = match invocation {
+        // Answered from the grammar alone: no settings are read, no store is opened and no runtime
+        // is started, which is what makes the two commands something a machine with nothing
+        // installed can still run.
+        Invocation::Help => return Ok(USAGE.to_owned()),
+        Invocation::Version => return Ok(format!("jobqc {}\n", env!("CARGO_PKG_VERSION"))),
+        Invocation::Command(command) => command,
+    };
+    // The runtime is built here rather than in the binary, because "this command needs one" is a
+    // fact about the command: it is the only thing in this file that is not a value, and it is
+    // reached by exactly the commands that talk to a store.
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .map_err(|error| Error::Io {
+            source: std::io::Error::other(format!("`jobqc` could not start a runtime: {error}")),
+        })?;
+    runtime.block_on(execute(command, &options, env, input))
+}
+
+/// One command line, parsed: the global options and what was asked for.
+struct Parsed {
+    /// Options every command shares.
+    options: Options,
+    /// The command, or the two answers that are not commands.
+    invocation: Invocation,
+}
+
+/// The options that belong to the command line rather than to one command.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+struct Options {
+    /// `--json`: print the answer as one JSON value.
+    json: bool,
+    /// `--config <FILE>`: the settings file to read.
+    config: Option<PathBuf>,
+}
+
+/// What the command line was asked to do.
+enum Invocation {
+    /// `--help`, `-h`, `help`, or nothing at all: print the usage text.
+    Help,
+    /// `--version`.
+    Version,
+    /// A command that talks to the engine.
+    Command(Command),
+}
+
+/// The four commands.
+enum Command {
+    /// Queue one job.
+    Submit(Submit),
+    /// Print one job.
+    Inspect(Inspect),
+    /// Print the jobs this engine can see.
+    List(List),
+    /// Print what the queues have done.
+    Usage,
+}
+
+/// `submit`: the job to queue.
+struct Submit {
+    /// Which queue it goes to.
+    queue: Queue,
+    /// Where its payload comes from.
+    payload: Payload,
+    /// Higher runs first.
+    priority: i32,
+    /// Attempts allowed in total.
+    max_attempts: u32,
+}
+
+/// `inspect`: which job.
+struct Inspect {
+    /// The job's identity.
+    id: JobId,
+}
+
+/// `list`: which jobs.
+struct List {
+    /// Only this queue, when the caller named one.
+    queue: Option<Queue>,
+    /// Only jobs in this state, when the caller named one.
+    state: Option<JobState>,
+    /// At most this many jobs.
+    limit: usize,
+}
+
+/// Where a submitted job's payload comes from.
+enum Payload {
+    /// `--payload <JSON>`.
+    Text(String),
+    /// `--stdin`: read it from standard input.
+    Stdin,
+}
+
+/// What a global option did with one argument.
+enum Global {
+    /// Not a global option: the command's own parser has the argument.
+    NotAnOption,
+    /// Taken, and the line continues.
+    Taken,
+    /// `--help` or `--version`: the rest of the line is not read, and this is the answer.
+    Asked(Invocation),
+}
+
+/// One global option, if this argument is one.
+///
+/// Globals are accepted on either side of the subcommand, because a script author writes
+/// `jobqc --json list` and a person types `jobqc list --json`; a tool that took one of the two
+/// would be a tool whose `--help` has to explain which.
+fn global(
+    argument: &str,
+    args: &mut impl Iterator<Item = String>,
+    options: &mut Options,
+) -> Result<Global, Error> {
+    match argument {
+        "--json" => {
+            options.json = true;
+            Ok(Global::Taken)
+        }
+        "--config" => {
+            options.config = Some(PathBuf::from(value(args, "--config")?));
+            Ok(Global::Taken)
+        }
+        "--help" | "-h" => Ok(Global::Asked(Invocation::Help)),
+        "--version" => Ok(Global::Asked(Invocation::Version)),
+        _ => Ok(Global::NotAnOption),
+    }
+}
+
+impl Parsed {
+    /// The whole grammar, and the whole of "no command asks a question a script cannot answer".
+    ///
+    /// Everything a caller can get wrong is refused here, before any settings are read: a mistake
+    /// in the call exits `2` whether or not a database turns out to be reachable, which is what
+    /// makes `2` a code a script can act on.
+    fn parse(args: impl IntoIterator<Item = String>) -> Result<Self, Error> {
+        let mut args = args.into_iter();
+        let mut options = Options::default();
+        // The global options first; the first argument that is not one of them names the command.
+        let name = loop {
+            let Some(argument) = args.next() else {
+                // `jobqc` on its own is a question about what this tool does, and the answer is the
+                // usage text — on stdout with code `0`, because nothing went wrong.
+                return Ok(Self {
+                    options,
+                    invocation: Invocation::Help,
+                });
+            };
+            match global(&argument, &mut args, &mut options)? {
+                Global::Taken => continue,
+                Global::Asked(invocation) => {
+                    return Ok(Self {
+                        options,
+                        invocation,
+                    });
+                }
+                Global::NotAnOption => break argument,
+            }
+        };
+
+        let invocation = match name.as_str() {
+            "submit" => Submit::parse(args, &mut options)?,
+            "inspect" => Inspect::parse(args, &mut options)?,
+            "list" => List::parse(args, &mut options)?,
+            "usage" => no_arguments(args, &mut options, "usage")?
+                .unwrap_or(Invocation::Command(Command::Usage)),
+            "help" => Invocation::Help,
+            other if other.starts_with('-') => {
+                return Err(Error::Invalid {
+                    detail: format!(
+                        "unknown argument `{other}`: `jobqc --help` lists every option"
+                    ),
+                });
+            }
+            other => {
+                return Err(Error::Invalid {
+                    detail: format!("unknown command `{other}`: `jobqc --help` lists every one"),
+                });
+            }
+        };
+        Ok(Self {
+            options,
+            invocation,
+        })
+    }
+}
+
+impl Submit {
+    /// `submit`'s own flags. Nothing here touches a store: the queue is a name this engine can
+    /// write down, and the payload is text until it is read.
+    fn parse(
+        mut args: impl Iterator<Item = String>,
+        options: &mut Options,
+    ) -> Result<Invocation, Error> {
+        let mut queue = None;
+        let mut payload = None;
+        let mut priority = 0;
+        let mut max_attempts = DEFAULT_MAX_ATTEMPTS;
+        while let Some(argument) = args.next() {
+            match global(&argument, &mut args, options)? {
+                Global::Taken => continue,
+                Global::Asked(invocation) => return Ok(invocation),
+                Global::NotAnOption => {}
+            }
+            match argument.as_str() {
+                "--queue" => queue = Some(Queue::parse(&value(&mut args, "--queue")?)?),
+                // The last of the two payload sources wins, which is what a repeated flag does
+                // everywhere else on this command line (`jobqd`'s parser made that call first): a
+                // line that names both is a line somebody edited.
+                "--payload" => payload = Some(Payload::Text(value(&mut args, "--payload")?)),
+                "--stdin" => payload = Some(Payload::Stdin),
+                "--priority" => priority = number(&value(&mut args, "--priority")?, "--priority")?,
+                "--max-attempts" => {
+                    max_attempts = number(&value(&mut args, "--max-attempts")?, "--max-attempts")?;
+                }
+                other => return Err(unknown(other, "submit")),
+            }
+        }
+        let Some(queue) = queue else {
+            return Err(Error::Invalid {
+                detail: "`submit` needs `--queue <NAME>`: the queue this job goes to".to_owned(),
+            });
+        };
+        let Some(payload) = payload else {
+            return Err(Error::Invalid {
+                detail:
+                    "`submit` needs the job's payload: `--payload <JSON>`, or `--stdin` to read \
+                         it from standard input"
+                        .to_owned(),
+            });
+        };
+        Ok(Invocation::Command(Command::Submit(Self {
+            queue,
+            payload,
+            priority,
+            max_attempts,
+        })))
+    }
+
+    /// The payload, read from standard input when the caller asked for that.
+    ///
+    /// Reading happens here rather than in the parser because a command that was not asked to read
+    /// standard input must never touch it: a tool that read stdin on every call would hang on a
+    /// terminal, and a hang is the one failure a script cannot answer.
+    fn value(&self, input: &mut dyn Read) -> Result<serde_json::Value, Error> {
+        let text = match &self.payload {
+            Payload::Text(text) => text.clone(),
+            Payload::Stdin => {
+                let mut text = String::new();
+                input.read_to_string(&mut text)?;
+                text
+            }
+        };
+        serde_json::from_str(&text).map_err(|error| Error::Invalid {
+            detail: format!("the payload is not JSON: {error}"),
+        })
+    }
+}
+
+impl Inspect {
+    /// `inspect`'s one argument. The identity is parsed here, so a typo is a usage error rather
+    /// than a question about a store.
+    fn parse(
+        mut args: impl Iterator<Item = String>,
+        options: &mut Options,
+    ) -> Result<Invocation, Error> {
+        let mut id = None;
+        while let Some(argument) = args.next() {
+            match global(&argument, &mut args, options)? {
+                Global::Taken => continue,
+                Global::Asked(invocation) => return Ok(invocation),
+                Global::NotAnOption => {}
+            }
+            if id.is_some() {
+                return Err(Error::Invalid {
+                    detail: format!("`inspect` takes one job id, and `{argument}` is a second one"),
+                });
+            }
+            id = Some(argument.parse::<JobId>().map_err(|error| Error::Invalid {
+                detail: format!("`{argument}` is not a job id: {error}"),
+            })?);
+        }
+        let Some(id) = id else {
+            return Err(Error::Invalid {
+                detail: "`inspect` needs the identity of one job: `jobqc inspect <ID>`".to_owned(),
+            });
+        };
+        Ok(Invocation::Command(Command::Inspect(Self { id })))
+    }
+}
+
+impl List {
+    /// `list`'s filters, each of which the store answers rather than this module.
+    fn parse(
+        mut args: impl Iterator<Item = String>,
+        options: &mut Options,
+    ) -> Result<Invocation, Error> {
+        let mut list = Self {
+            queue: None,
+            state: None,
+            limit: DEFAULT_LIST_LIMIT,
+        };
+        while let Some(argument) = args.next() {
+            match global(&argument, &mut args, options)? {
+                Global::Taken => continue,
+                Global::Asked(invocation) => return Ok(invocation),
+                Global::NotAnOption => {}
+            }
+            match argument.as_str() {
+                "--queue" => list.queue = Some(Queue::parse(&value(&mut args, "--queue")?)?),
+                "--state" => list.state = Some(state(&value(&mut args, "--state")?)?),
+                "--limit" => list.limit = number(&value(&mut args, "--limit")?, "--limit")?,
+                other => return Err(unknown(other, "list")),
+            }
+        }
+        Ok(Invocation::Command(Command::List(list)))
+    }
+
+    /// The filter the engine is asked with.
+    fn filter(&self) -> JobFilter {
+        let mut filter = JobFilter::new().with_limit(self.limit);
+        if let Some(queue) = &self.queue {
+            filter = filter.with_queue(queue.clone());
+        }
+        if let Some(state) = self.state {
+            filter = filter.with_state(state);
+        }
+        filter
+    }
+}
+
+/// `jobq/3.14-job-state-machine`'s encoding, with the refusal phrased for somebody who typed it.
+fn state(text: &str) -> Result<JobState, Error> {
+    JobState::parse(text).map_err(|refused| Error::Invalid {
+        detail: format!(
+            "`{}` is not a state a job can be in: the states are {}",
+            refused.text(),
+            STATES
+                .iter()
+                .map(|state| format!("`{}`", state.as_str()))
+                .collect::<Vec<String>>()
+                .join(", ")
+        ),
+    })
+}
+
+/// A command that takes no arguments, and the refusal naming the one it was handed.
+///
+/// `Some` is an answer rather than a refusal: a `usage --help` is a request for the usage text.
+fn no_arguments(
+    mut args: impl Iterator<Item = String>,
+    options: &mut Options,
+    command: &str,
+) -> Result<Option<Invocation>, Error> {
+    while let Some(argument) = args.next() {
+        match global(&argument, &mut args, options)? {
+            Global::Taken => continue,
+            Global::Asked(invocation) => return Ok(Some(invocation)),
+            Global::NotAnOption => {}
+        }
+        return Err(Error::Invalid {
+            detail: format!("`{command}` takes no arguments, and `{argument}` is one"),
+        });
+    }
+    Ok(None)
+}
+
+/// Run one command through the engine, and answer the bytes it produced.
+async fn execute(
+    command: Command,
+    options: &Options,
+    env: &[(String, String)],
+    input: &mut dyn Read,
+) -> Result<String, Error> {
+    match command {
+        Command::Submit(submit) => {
+            // What the caller typed is answered before anything is opened: a payload that is not
+            // JSON is a mistake in the call, and it must not depend on a store being reachable.
+            let payload = submit.value(input)?;
+            let engine = engine(options, env).await?;
+            let request = SubmitRequest::new(submit.queue, payload)
+                .with_priority(submit.priority)
+                .with_max_attempts(submit.max_attempts);
+            let id = engine.submit(request).await?;
+            if options.json {
+                return document(&IdView { id });
+            }
+            Ok(format!("queued {id}\n"))
+        }
+        Command::Inspect(inspect) => {
+            let engine = engine(options, env).await?;
+            let job = engine.inspect(&inspect.id).await?;
+            if options.json {
+                return document(&JobView::new(&job));
+            }
+            Ok(job_line(&job))
+        }
+        Command::List(list) => {
+            let engine = engine(options, env).await?;
+            let jobs = engine.list(&list.filter()).await?;
+            if options.json {
+                let views: Vec<JobView<'_>> = jobs.iter().map(JobView::new).collect();
+                return document(&views);
+            }
+            Ok(jobs.iter().map(job_line).collect())
+        }
+        Command::Usage => {
+            let engine = engine(options, env).await?;
+            let lines = engine.usage().await?;
+            if options.json {
+                let views: Vec<UsageView<'_>> = lines.iter().map(UsageView::new).collect();
+                return document(&views);
+            }
+            Ok(lines.iter().map(usage_line).collect())
+        }
+    }
+}
+
+/// The engine the command talks through: the settings the daemon reads, turned into a store by the
+/// one place in this crate that turns settings into a store.
+///
+/// The command line does **not** open a database itself, and that is the boundary of
+/// `jobq/3.1-engine-boundary` still holding: a second place that built a pool would be a second
+/// place that could pick a different backend, a different lease or a different policy from the
+/// worker it is talking to. It does not *migrate* either: a tool that wrote on every read would be
+/// a tool a read-only replica cannot serve, and `jobqd` already owns that step.
+async fn engine(
+    options: &Options,
+    env: &[(String, String)],
+) -> Result<Engine<Arc<dyn Store>>, Error> {
+    let flags = Flags {
+        config: options.config.clone(),
+        ..Flags::default()
+    };
+    let config = Config::load(&flags, env)?;
+    Ok(Engine::new(open_store(&config).await?))
+}
+
+/// One job, as `--json` prints it.
+///
+/// The field order is written down and asserted, although JSON does not define one: a golden test
+/// that reorders its fields at every refactor is a test nobody reads, and a diff of two lines beats
+/// a set comparison that hides a rename.
+#[derive(Serialize)]
+struct JobView<'a> {
+    /// Identity, in the form every other command takes it.
+    id: JobId,
+    /// Which queue it belongs to.
+    queue: &'a str,
+    /// Where it is in its life.
+    state: &'a str,
+    /// The payload the handler is given, as the JSON value it is — not as a string of JSON, which
+    /// is the difference between `jq '.payload.to'` working and needing `fromjson` first.
+    payload: &'a serde_json::Value,
+}
+
+impl<'a> JobView<'a> {
+    /// One job, borrowed rather than copied: a listing renders what the engine already holds.
+    fn new(job: &'a Job) -> Self {
+        Self {
+            id: job.id(),
+            queue: job.queue().as_str(),
+            state: job.state().as_str(),
+            payload: job.payload(),
+        }
+    }
+}
+
+/// The identity a successful `submit` answers with.
+#[derive(Serialize)]
+struct IdView {
+    /// The job's identity.
+    id: JobId,
+}
+
+/// One queue's numbers, as `--json` prints them.
+#[derive(Serialize)]
+struct UsageView<'a> {
+    /// Which queue.
+    queue: &'a str,
+    /// Jobs written into it.
+    submitted: u64,
+    /// Attempts a worker started.
+    claimed: u64,
+    /// Attempts that finished their job.
+    succeeded: u64,
+    /// Attempts that reported a failure.
+    failed: u64,
+    /// Attempts that ended without either.
+    reclaimed: u64,
+    /// Attempts holding a worker right now: the derived number, and the one an operator wants.
+    running: u64,
+}
+
+impl<'a> UsageView<'a> {
+    /// One line of the report, as a value.
+    fn new(line: &'a QueueUsage) -> Self {
+        let usage = line.usage();
+        Self {
+            queue: line.queue().as_str(),
+            submitted: usage.submitted(),
+            claimed: usage.claimed(),
+            succeeded: usage.succeeded(),
+            failed: usage.failed(),
+            reclaimed: usage.reclaimed(),
+            running: usage.running(),
+        }
+    }
+}
+
+/// One job in the text shape: one line, four fields, and the payload as compact JSON — which cannot
+/// contain a naked newline, so a line is always one job.
+fn job_line(job: &Job) -> String {
+    let (id, queue, state, payload) = (job.id(), job.queue(), job.state(), job.payload());
+    format!("{id} {queue} {state} {payload}\n")
+}
+
+/// One queue's numbers in the text shape.
+fn usage_line(line: &QueueUsage) -> String {
+    let usage = line.usage();
+    let (queue, submitted) = (line.queue(), usage.submitted());
+    let (claimed, succeeded) = (usage.claimed(), usage.succeeded());
+    let (failed, reclaimed) = (usage.failed(), usage.reclaimed());
+    let running = usage.running();
+    format!(
+        "{queue} submitted={submitted} claimed={claimed} succeeded={succeeded} failed={failed} \
+         reclaimed={reclaimed} running={running}\n"
     )
 }
+
+/// One JSON document, with the newline a shell prompt expects after it.
+///
+/// Serialising a view of an engine value cannot fail in practice — every field is a number, a
+/// string, a uuid, or a payload the engine already holds as JSON — and it is still answered rather
+/// than unwrapped: this crate's library code is not allowed to panic, and "something could not be
+/// written" is the io class rather than a fourth kind of usage error.
+fn document<T: Serialize>(value: &T) -> Result<String, Error> {
+    let mut document = serde_json::to_string(value).map_err(|error| Error::Io {
+        source: std::io::Error::other(format!("the answer could not be written: {error}")),
+    })?;
+    document.push('\n');
+    Ok(document)
+}
+
+/// The value of a flag that needs one, or the sentence naming the flag that was left hanging.
+fn value(args: &mut impl Iterator<Item = String>, flag: &str) -> Result<String, Error> {
+    args.next().ok_or_else(|| Error::Invalid {
+        detail: format!("`{flag}` needs a value"),
+    })
+}
+
+/// A number a flag was given, or the refusal that shows the caller what it typed.
+fn number<T: FromStr>(text: &str, flag: &str) -> Result<T, Error> {
+    text.parse::<T>().map_err(|_| Error::Invalid {
+        detail: format!("`{flag} {text}` is not a number"),
+    })
+}
+
+/// An argument this command does not have, with the place that lists the ones it does.
+fn unknown(argument: &str, command: &str) -> Error {
+    Error::Invalid {
+        detail: format!(
+            "`{argument}` is not an option of `{command}`: `jobqc --help` lists every one"
+        ),
+    }
+}
