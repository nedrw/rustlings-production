+/// The scheduling policy the settings ask for (`jobq/3.9-priority-fairness`).
+///
+/// Both knobs are settings rather than constants because both are the deployment's: how long a job
+/// may wait before it outranks fresh work, and how much of the pool one queue may hold. `0` means
+/// "off" in both cases, and off is the engine's old behaviour — the daemon's own defaults turn aging
+/// on (five minutes) and leave the cap unlimited, because a cap that nobody chose is a cap that
+/// looks like a stuck queue.
+fn policy(config: &Config) -> Policy {
+    let mut policy = Policy::strict();
+    if config.worker.aging_seconds > 0 {
+        policy = policy.with_aging(Duration::from_secs(config.worker.aging_seconds));
+    }
+    if config.worker.max_in_flight_per_queue > 0 {
+        policy = policy.with_cap(config.worker.max_in_flight_per_queue);
+    }
+    policy
+}
