+                              attempts, max_attempts, last_error, lease_owner, lease_expires_at \
+                       from jobs where id = $1 \
+                         and ($2::text is null or jobs.queue in ( \
+                             select queue from queue_permissions where tenant = $2)) \
+                       for update";
