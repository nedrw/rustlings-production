diff --git a/migrations/0004_dedup_keys.sql b/migrations/0004_dedup_keys.sql
index b5db2eb..ca95d5e 100644
--- a/migrations/0004_dedup_keys.sql
+++ b/migrations/0004_dedup_keys.sql
@@ -4,24 +4,38 @@
 -- (`0001` wrote `jobs`, `0002` the trail, `0003` the lease; `mailer` and `relay` number their own
 -- files).
 --
--- The file is yours to write. A row is one key, and it has to answer two questions about it: which
--- job did this key produce, and *until when* does it still answer. Three things about the file are
--- decisions rather than transcription:
+-- One row per key, and three of the four decisions in this file are about what the row has to say
+-- rather than about the columns:
 --
--- 1. **a key belongs to a queue.** The same string asked in two queues is two keys, so the queue is
---    part of what identifies the row (`relay/2.2-idempotent-ingest` made the same call for a tenant
---    and an `Idempotency-Key`);
--- 2. **the row carries the instant the key stops answering**, which is the whole reason the window
---    is a store-side mechanism rather than a field on the job: an enqueue has to be able to tell a
---    live key from a dead one *in the statement that writes*, without reading first
---    (`jobq/3.6-transaction-isolation` is the step that argued why a read-then-write is a window
---    two writers both pass through);
--- 3. **the enqueue resets an expired row rather than refusing for ever.** That is one statement
---    (`insert … on conflict … do update … where <the row has expired> returning …`), and
---    PostgreSQL only accepts the `on conflict` half when a **unique constraint or index matches
---    the columns named in it** — the same arbiter the append of `jobq/3.6-transaction-isolation`
---    depends on.
+--   * **the key is a key of a queue.** `(queue, key)` is the primary key, and that is the arbiter
+--     the enqueue's `on conflict` names: the same string asked in two queues is two keys, which is
+--     the call `relay/2.2-idempotent-ingest` made for a tenant and an `Idempotency-Key`. A primary
+--     key rather than a unique index, because there is nothing about a key that is worth storing
+--     without it identifying the row.
+--   * **the row carries the instant the key stops answering.** `expires_at` is what a store compares
+--     the clock against, and comparing it *in the statement* is what makes a live key a request
+--     that writes nothing: `insert … on conflict (queue, key) do update … where expires_at <= $now`
+--     is a reset for an expired row and a no-op for a live one, in one statement, with no window a
+--     second writer could slip through (`jobq/3.6-transaction-isolation`).
+--   * **the boundary is half-open, in the row's own terms.** A key is live while
+--     `now < expires_at`; at exactly `expires_at` it is new again, which is the same line
+--     `Dedup::live` draws and the reason the statement above says `<=`.
+--   * **`job_id` cascades.** The key is a pointer at the work it named, and a pointer at a job
+--     nobody kept is not a fact about a request — it is a leak. `on delete cascade` is also what
+--     makes the enqueue's "the key is live, answer with its job" branch total: while the key row is
+--     there, the row it names is there.
 --
--- Two smaller ones, both worth one thought before the file is written: a key that is *gone* (the
--- job it named was purged) must not make a request fail, and something has to sweep the rows whose
--- window has passed — housekeeping, not correctness, which is what the step's body argues.
+-- The second index is the housekeeping one, and it is the only reason it exists: sweeping the rows
+-- whose window has passed (and only those — a live row that is swept is a duplicate that escapes)
+-- is a scan of this index rather than of the table. Nothing in the engine reads it, because expiry
+-- is not deletion: a dead row costs a row and changes no answer.
+
+create table dedup_keys (
+    queue text not null,
+    key text not null,
+    job_id uuid not null references jobs (id) on delete cascade,
+    expires_at timestamptz not null,
+    primary key (queue, key)
+);
+
+create index dedup_keys_expiring on dedup_keys (expires_at);
