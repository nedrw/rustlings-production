+/// Whether `name` is a name this engine will write down, phrased for the kind of thing it names.
+///
+/// A queue and a tenant are held to the same rule (`jobq/3.13-queue-authz-attribution` added the
+/// second caller) because they are the same kind of name: a key in a table, a label in a metric and
+/// something a person types, so the character set is the one all three can spell. The rule is a
+/// function rather than a copy so that the alphabet cannot drift between them.
+pub(crate) fn check_name(kind: &str, name: &str, max: usize) -> Result<(), Error> {
+    let invalid = |detail: String| Error::Invalid { detail };
+    if name.is_empty() {
+        return Err(invalid(format!("a {kind} name cannot be empty")));
+    }
+    if name.len() > max {
+        return Err(invalid(format!(
+            "`{name}` is {} bytes; the limit is {max}",
+            name.len()
+        )));
+    }
+    if !name
+        .bytes()
+        .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || b"._-".contains(&byte))
+    {
+        return Err(invalid(format!(
+            "`{name}` may only contain lower-case letters, digits, `.`, `_` and `-`: a {kind} name \
+             is a table column, a metric label and something a person types, so it stays in the \
+             character set all three can spell"
+        )));
+    }
+    Ok(())
+}
