+# The crate assembles two ways, and this table is the whole of it (step `jobq/3.4-feature-assembly`):
+# the in-memory engine is the floor every combination has, and `postgres` adds the durable backend on
+# top of it. Features are additive — enabling one never disables another — which is why nothing here
+# is spelled "without", and why the matrix of combinations is checked rather than the flags.
+#
+# `postgres` is a list rather than a bare name because `jobq/3.5-store-port-conformance` adds the
+# durable backend's dependency wiring to it, and a scaffold may only insert lines into a marked block
+# (docs/authoring.md §5): the block belongs here from the step that writes the table.
+[features]
+# kiln:scaffold:begin
+default = ["postgres"]
+postgres = [
+]
+# kiln:scaffold:end
+
