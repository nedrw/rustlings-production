+/// Open the durable backend the settings name.
+///
+/// The durable backend arrives with `jobq/3.5-store-port-conformance` and lands **behind the
+/// `postgres` feature**, which is what step `jobq/3.4-feature-assembly` builds: until it does, this
+/// function is the seam, and what it can honestly do is refuse in the terms of *this* build — a
+/// message that says whether the operator is looking at a build that has the feature and not the
+/// backend yet, or at a build without the feature at all.
+///
+/// The gate is deliberately in one function with one call site: a feature whose `cfg` is sprinkled
+/// across the crate is a feature that is off in one code path and on in another, and the
+/// combination nobody tried is the one that breaks.
+fn open_durable(url: &str) -> Result<MemoryStore, Error> {
+    Err(Error::Config {
+        detail: format!(
+            "`{}` names a durable store: {}",
+            redact_url(url),
+            durable_backend()
+        ),
+    })
+}
+
+/// What this build knows about a durable store, which is a compile-time fact.
+///
+/// Two answers, because there are two different problems and only one of them is permanent: a build
+/// that has the feature is waiting for a step, and a build without it is waiting for a flag. Both
+/// name what to do next, because "use `memory`" tells an operator with a database nothing.
+#[cfg(feature = "postgres")]
+fn durable_backend() -> &'static str {
+    "this build has the `postgres` feature, and the backend itself arrives with \
+     `jobq/3.5-store-port-conformance`"
+}
+
+/// What this build knows about a durable store when the feature is off.
+#[cfg(not(feature = "postgres"))]
+fn durable_backend() -> &'static str {
+    "this build was compiled without the `postgres` feature, so the in-memory engine is all it \
+     has: rebuild with `--features postgres`"
+}
