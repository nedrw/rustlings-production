+/// One row of `job_audit`, in the shape the driver decodes it.
+///
+/// The same boundary as [`JobRow`] and [`EventRow`], one table over: the action is a text column
+/// and the queue arrives as the string the column holds, and [`AuditRow::into_line`] is the one
+/// place those are reconciled with the engine's values, so a row this backend wrote and cannot
+/// read back is reported where it can be seen.
+#[derive(sqlx::FromRow)]
+struct AuditRow {
+    /// The job the act was about. It may be gone from `jobs` — that is what this record is for.
+    job: Uuid,
+    /// The queue it was in.
+    queue: String,
+    /// What was done, as text.
+    action: String,
+    /// Who did it.
+    actor: String,
+    /// Why, when they said.
+    reason: Option<String>,
+    /// When the store took the act.
+    at: DateTime<Utc>,
+}
+
+impl AuditRow {
+    /// The engine's line, or the reason this table holds something the engine cannot read.
+    fn into_line(self) -> Result<JobAudit, Error> {
+        let queue =
+            Queue::parse(&self.queue).map_err(|error| unreadable("queue", error.to_string()))?;
+        Ok(JobAudit::stored(
+            JobId::from_uuid(self.job),
+            queue,
+            decode_act(&self.action)?,
+            self.actor,
+            self.reason,
+            self.at,
+        ))
+    }
+}
+
+/// The `action` column, as the enum the engine uses.
+///
+/// Written as a search over [`Act::as_str`] rather than a `match` on strings, the rule
+/// [`decode_kind`] follows: adding an act to the enum without teaching this function about it is
+/// impossible, because there is nothing here to teach.
+fn decode_act(text: &str) -> Result<Act, Error> {
+    [Act::Replay, Act::Discard]
+        .into_iter()
+        .find(|act| act.as_str() == text)
+        .ok_or_else(|| {
+            unreadable(
+                "action",
+                format!("`{text}` is not an act this engine knows"),
+            )
+        })
+}
