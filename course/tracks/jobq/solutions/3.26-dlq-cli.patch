index 0000000..c4f5525
--- /dev/null
+++ b/migrations/0008_job_audit.sql
@@ -0,0 +1,48 @@
+-- The operator's record: who acted on a dead letter, when, and why.
+--
+-- Step `jobq/3.26-dlq-cli`. This is the project's eighth migration, so it is `0008` (`0001` wrote
+-- `jobs`, `0002` the trail, `0003` the lease, `0004` the deduplication keys, `0005` queues and
+-- their access model, `0006` the state machine's columns, `0007` the trace; `mailer` and `relay`
+-- number their own files).
+--
+-- Four decisions are in this file rather than in a sentence somewhere, and each one is a failure
+-- somebody meets:
+--
+--   * **there is no foreign key to `jobs`.** `0002_job_events.sql` ends the trail with the job it
+--     belongs to (`on delete cascade`), and its comment says in so many words that whether a purge
+--     keeps the trail of what it removed is the next step's decision, to be made "with a migration,
+--     which is the point of writing the schema down". This is that decision, and the answer is no:
+--     the row this table is about may be gone, and it is *because* it may be gone that the line has
+--     to survive. A constraint here would delete the only account of a discard at the moment the
+--     discard happened.
+--   * **the unit is an act, not a job.** `queue_audit` (`0005`) records accepted changes of the
+--     access model, and this records accepted acts on dead letters: the same job replayed once and
+--     thrown away later is two lines, and a *refused* act is no line at all. That is the difference
+--     from a trail of settles (`0002`), where the identity of a line is `(job, kind, attempt)` and
+--     a repeated append is the same line — here two lines are always two things a person did, so
+--     there is no unique index to defer to and every insert is a new row.
+--   * **the queue is denormalised on purpose.** A line an auditor reads has to say which queue the
+--     work was in, and after a discard there is no row left to ask; the queue is also what the read
+--     is *scoped* by, in the same shape every other scoped read has (`jobq/3.13-queue-authz-attribution`:
+--     a handle sees what the access model names, and `queue_permissions` is the view that answers
+--     it). A job's queue never changes, so there is nothing here that can go stale.
+--   * **`seq` is what orders it.** The trail is read newest first by `at`, which is enough there
+--     because a settle is identified by its job, kind and attempt; here two acts can share an
+--     instant (two operators, one dashboard, one second) and the record still has an order, because
+--     the order is when the lines were *appended* rather than what the clock read. `at` stays and
+--     is what a person reads.
+--
+-- The index is the one query this project runs: everything the record is read for is "what has been
+-- done lately, in the queues I can see", newest first, a page at a time.
+
+create table job_audit (
+    seq bigserial primary key,
+    job uuid not null,
+    queue text not null,
+    action text not null check (action in ('replay', 'discard')),
+    actor text not null,
+    reason text,
+    at timestamptz not null
+);
+
+create index job_audit_newest_first on job_audit (seq desc);
