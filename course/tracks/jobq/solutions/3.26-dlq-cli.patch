@@ -0,0 +1,411 @@
+//! The dead-letter queue from the command line: what is stuck, one more life, one last word.
+//!
+//! Step `jobq/3.26-dlq-cli`, and the group the grammar of `jobqc` grows. `jobq/3.15-cli-contract`
+//! wrote the four rules this file keeps — stdout is the answer, stderr is the diagnosis, one exit
+//! code per failure class, and `--json` never moves a code — and `jobq/3.16-dlq-tooling` built the
+//! interface underneath: the view (`dead_letters()`) and the replay. What is new here is the
+//! *door*, and the three commands behind it differ in what an operator is allowed to do to
+//! somebody else's work:
+//!
+//! * **`list` is the operator's view, and it is not a listing.** `jobqc list --state failed` asks
+//!   the same question and answers with the whole job, payload included. The row an operator
+//!   decides on is the *dead letter*: how many attempts it has spent and the sentence its last one
+//!   died with. Those two are what they came for, and the payload is the thing they must not have
+//!   — a tool that prints a customer's data into a terminal scrollback, a ticket and a pastebin
+//!   has moved a data-protection incident into the middle of the incident. `dlq list` is therefore
+//!   its own shape rather than a filter on `list`.
+//! * **the acts are signed, and one of them states why.** `--by <NAME>` is required for both, and
+//!   `--reason <TEXT>` for the one that cannot be undone. The record an auditor reads is about
+//!   people, and the two questions it answers are who did this and why; neither can be answered
+//!   afterwards from the row — a discarded job is gone, and a replayed one is a job whose trail of
+//!   `jobq/3.6-transaction-isolation` says *what* happened and never *who* did it.
+//! * **a refusal is a class.** Every acting command is one act on one identity, and the code it
+//!   leaves behind is the table of `jobq/3.3-library-errors` rather than a number invented here:
+//!   `2` when the call was wrong (an unknown subcommand, a missing flag, a blank reason, a job that
+//!   is not a dead letter), `3` when the identity is not there, `4` when the store refused, `1`
+//!   when the deployment is broken. A script branches on `$?`; the sentence on stderr is for the
+//!   human reading the log.
+//!
+//! There is deliberately no batch. `dlq replay <ID> <ID> <ID>` is a loop in the shell, and the
+//! reason is the third rule above: a command that acted on two identities and refused a third has
+//! no single class to leave behind, and printing the two that worked next to a failure would hand
+//! a script the half-document `jobq/3.15-cli-contract` forbids. One identity, one act, one answer,
+//! one code — and `dlq audit` is where an operator reads what a scripted loop did.
+//!
+//! ```text
+//! jobqc dlq list
+//! 4f1c… signup attempts=3 "the smtp server said 550 and meant it"
+//! jobqc dlq replay 4f1c… --by ada
+//! 2030-01-01T00:00:03+00:00 replay 4f1c… signup ada
+//! jobqc dlq discard 9a02… --by grace --reason "duplicate of 4f1c…"
+//! 2030-01-01T00:00:04+00:00 discard 9a02… signup grace duplicate of 4f1c…
+//! ```
+//!
+//! The answer of an act is the line the record was given, in the same shape `dlq audit` prints —
+//! because that is what just happened. A command that answered with something it had not written
+//! down would be a command whose answer and record can disagree.
+
+use serde::Serialize;
+
+use crate::engine::{
+    Act, DEFAULT_LIST_LIMIT, Error, Job, JobAudit, JobFilter, JobId, Order, Queue, dead_letters,
+};
+
+/// `dlq`: what was asked of the dead-letter queue.
+pub(super) enum Dlq {
+    /// `dlq list`: what is stuck.
+    List(Stuck),
+    /// `dlq replay` / `dlq discard`: the act, and everything the engine needs to take it.
+    ///
+    /// One variant for both commands, because the difference between them is the order they build
+    /// and nothing else — and a second variant would be a second place where "a discard has a
+    /// reason and a replay does not" could be got wrong.
+    Act(Order),
+    /// `dlq audit`: the acts operators have taken.
+    Audit(Page),
+}
+
+/// `dlq list`: the page of dead letters to print.
+pub(super) struct Stuck {
+    /// Only this queue, when the caller named one.
+    queue: Option<Queue>,
+    /// At most this many rows.
+    limit: usize,
+}
+
+/// `dlq audit`: how many lines of the record to print.
+pub(super) struct Page {
+    /// At most this many lines.
+    limit: usize,
+}
+
+impl Stuck {
+    /// The filter the engine is asked with: the view's rule, narrowed and bounded.
+    ///
+    /// `dead_letters()` is asked rather than the state spelled out again, so that "what a dead
+    /// letter is" has one spelling (`jobq/3.16-dlq-tooling`), and the limit is the listing's own:
+    /// a queue and a record both have no natural end.
+    fn filter(&self) -> JobFilter {
+        let mut filter = dead_letters().with_limit(self.limit);
+        if let Some(queue) = &self.queue {
+            filter = filter.with_queue(queue.clone());
+        }
+        filter
+    }
+}
+
+/// `jobqc dlq …`, from the arguments after `dlq`.
+///
+/// The globals are accepted on either side of the subcommand, the rule `jobqc` follows everywhere
+/// (`jobqc --json dlq list` and `jobqc dlq list --json` are one call, and so are `dlq list --help`
+/// and `--help`), and every mistake a caller can make is refused here — before any settings are
+/// read and before any store is opened, so that `2` means the call was wrong whether or not a
+/// database turns out to be reachable.
+///
+/// # Errors
+///
+/// [`Error::Invalid`] for a subcommand this group does not have, a flag without a value, an
+/// identity that is not one, and an act with no name or no reason to write down.
+pub(super) fn parse(
+    mut args: impl Iterator<Item = String>,
+    options: &mut super::Options,
+) -> Result<super::Invocation, Error> {
+    let name = loop {
+        let Some(argument) = args.next() else {
+            return Err(Error::Invalid {
+                detail: "`dlq` needs one of `list`, `replay`, `discard` or `audit`: `jobqc dlq \
+                         list` is what is stuck, and `jobqc --help` lists the rest"
+                    .to_owned(),
+            });
+        };
+        match super::global(&argument, &mut args, options)? {
+            super::Global::Taken => continue,
+            super::Global::Asked(invocation) => return Ok(invocation),
+            super::Global::NotAnOption => break argument,
+        }
+    };
+    match name.as_str() {
+        "list" => list(args, options),
+        "replay" => act(args, options, Act::Replay),
+        "discard" => act(args, options, Act::Discard),
+        "audit" => page(args, options),
+        other => Err(Error::Invalid {
+            detail: format!(
+                "`{other}` is not a command of `dlq`: the ones it has are `list`, `replay`, \
+                 `discard` and `audit`"
+            ),
+        }),
+    }
+}
+
+/// `dlq list`: the queue to narrow by, and the page to print.
+fn list(
+    mut args: impl Iterator<Item = String>,
+    options: &mut super::Options,
+) -> Result<super::Invocation, Error> {
+    let mut stuck = Stuck {
+        queue: None,
+        limit: DEFAULT_LIST_LIMIT,
+    };
+    while let Some(argument) = args.next() {
+        match super::global(&argument, &mut args, options)? {
+            super::Global::Taken => continue,
+            super::Global::Asked(invocation) => return Ok(invocation),
+            super::Global::NotAnOption => {}
+        }
+        match argument.as_str() {
+            "--queue" => stuck.queue = Some(Queue::parse(&super::value(&mut args, "--queue")?)?),
+            "--limit" => {
+                stuck.limit = super::number(&super::value(&mut args, "--limit")?, "--limit")?;
+            }
+            other => return Err(unknown(other, "list")),
+        }
+    }
+    Ok(command(Dlq::List(stuck)))
+}
+
+/// `dlq audit`: how many lines of the record to print.
+fn page(
+    mut args: impl Iterator<Item = String>,
+    options: &mut super::Options,
+) -> Result<super::Invocation, Error> {
+    let mut page = Page {
+        limit: DEFAULT_LIST_LIMIT,
+    };
+    while let Some(argument) = args.next() {
+        match super::global(&argument, &mut args, options)? {
+            super::Global::Taken => continue,
+            super::Global::Asked(invocation) => return Ok(invocation),
+            super::Global::NotAnOption => {}
+        }
+        match argument.as_str() {
+            "--limit" => {
+                page.limit = super::number(&super::value(&mut args, "--limit")?, "--limit")?;
+            }
+            other => return Err(unknown(other, "audit")),
+        }
+    }
+    Ok(command(Dlq::Audit(page)))
+}
+
+/// `dlq replay` / `dlq discard`: the identity, the name, and the reason when the act needs one.
+///
+/// The two flags differ by act, and that difference is the step: `--reason` is what makes a discard
+/// reviewable, so it is required for exactly one of the two commands, and the order built at the
+/// end of this function is where that becomes a value the engine can check rather than a rule this
+/// file remembers.
+fn act(
+    mut args: impl Iterator<Item = String>,
+    options: &mut super::Options,
+    action: Act,
+) -> Result<super::Invocation, Error> {
+    let mut id = None;
+    let mut actor = None;
+    let mut reason = None;
+    while let Some(argument) = args.next() {
+        match super::global(&argument, &mut args, options)? {
+            super::Global::Taken => continue,
+            super::Global::Asked(invocation) => return Ok(invocation),
+            super::Global::NotAnOption => {}
+        }
+        match argument.as_str() {
+            "--by" => actor = Some(super::value(&mut args, "--by")?),
+            "--reason" => reason = Some(super::value(&mut args, "--reason")?),
+            other if other.starts_with('-') => return Err(unknown(other, action.as_str())),
+            other => {
+                if id.is_some() {
+                    return Err(Error::Invalid {
+                        detail: format!(
+                            "`{action}` takes one job id, and `{other}` is a second one: one act \
+                             on one identity is what leaves one class behind (`jobqc --help`)"
+                        ),
+                    });
+                }
+                id = Some(other.parse::<JobId>().map_err(|error| Error::Invalid {
+                    detail: format!("`{other}` is not a job id: {error}"),
+                })?);
+            }
+        }
+    }
+    let Some(id) = id else {
+        return Err(Error::Invalid {
+            detail: format!(
+                "`{action}` needs the identity of one dead letter: `jobqc dlq {action} <ID> --by \
+                 <NAME>`"
+            ),
+        });
+    };
+    let Some(actor) = actor else {
+        return Err(Error::Invalid {
+            detail: format!(
+                "`{action}` has to be signed: `--by <NAME>` is what the record keeps, and an act \
+                 nobody is named for is an act nobody can be asked about"
+            ),
+        });
+    };
+    let order = match (action, reason) {
+        (Act::Discard, Some(reason)) => Order::discard(id, &actor, &reason),
+        (Act::Discard, None) => {
+            return Err(Error::Invalid {
+                detail: "`discard` needs `--reason <TEXT>`: the work cannot be reconstructed from \
+                         what is left of it, and the line this writes is the only account there \
+                         will be"
+                    .to_owned(),
+            });
+        }
+        (Act::Replay, Some(reason)) => Order::replay(id, &actor).with_reason(&reason),
+        (Act::Replay, None) => Order::replay(id, &actor),
+    };
+    Ok(command(Dlq::Act(order)))
+}
+
+/// One `dlq` command, wrapped the way the grammar's other subcommands are.
+fn command(dlq: Dlq) -> super::Invocation {
+    super::Invocation::Command(super::Command::Dlq(dlq))
+}
+
+/// An argument a subcommand does not have, with the place that lists the ones it does.
+fn unknown(argument: &str, command: &str) -> Error {
+    Error::Invalid {
+        detail: format!(
+            "`{argument}` is not an option of `dlq {command}`: `jobqc --help` lists every one"
+        ),
+    }
+}
+
+/// Run one `dlq` command through the engine, and answer the bytes it produced.
+pub(super) async fn execute(
+    command: Dlq,
+    options: &super::Options,
+    env: &[(String, String)],
+) -> Result<String, Error> {
+    match command {
+        Dlq::List(stuck) => {
+            let engine = super::engine(options, env).await?;
+            let jobs = engine.list(&stuck.filter()).await?;
+            if options.json {
+                let views: Vec<DeadView<'_>> = jobs.iter().map(DeadView::new).collect();
+                return super::document(&views);
+            }
+            Ok(jobs.iter().map(dead_line).collect())
+        }
+        // The record line the store wrote is the answer, and the answer is what is printed: this
+        // command asks the engine for the act, and the engine is the only thing that has it.
+        Dlq::Act(order) => {
+            let engine = super::engine(options, env).await?;
+            let line = engine.store().operate(&order).await?;
+            answer(&[line], options.json)
+        }
+        Dlq::Audit(page) => {
+            let engine = super::engine(options, env).await?;
+            let lines = engine.store().acts(page.limit).await?;
+            answer(&lines, options.json)
+        }
+    }
+}
+
+/// One record line, or a page of them, in the shape the caller asked for.
+///
+/// An act answers exactly one line and the record answers a page, and the two are one function
+/// because they are one shape: the text is one line per record and the JSON is one document
+/// holding them — `[]` for an empty record rather than nothing at all, the rule
+/// `jobq/3.15-cli-contract` pinned for a listing.
