     /// A keyed record goes to its key's partition; an unkeyed one walks the partitions in order,
     /// so a producer that never keys its records still spreads them.
     pub fn append(&mut self, key: Option<&str>, payload: &str) -> (usize, u64) {
-        todo!("route by key, or round-robin when there is none")
+        let partition = match key {
+            Some(key) => partition_for(self.partitions.len(), key),
+            // An unkeyed record walks the partitions: a producer that never keys its records still
+            // spreads them, instead of putting every one into partition zero.
+            None => {
+                let partition = self.next_unkeyed % self.partitions.len();
+                self.next_unkeyed = partition + 1;
+                partition
+            }
+        };
+        let records = &mut self.partitions[partition];
+        let offset = records.len() as u64;
+        records.push(Record {
+            key: key.map(str::to_owned),
+            payload: payload.to_owned(),
+        });
+        (partition, offset)
     }
