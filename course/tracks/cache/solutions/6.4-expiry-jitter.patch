--- a/src/expiry.rs
+++ b/src/expiry.rs
@@ -9,6 +9,19 @@
 /// A deterministic time-to-live for `key`, within `base ± spread`.
 #[must_use]
 pub fn ttl_for(base: u64, spread: u64, key: &str) -> u64 {
-    let _ = (base, spread, key);
-    todo!("hash the key into the band; spread 0 is the base")
+    if spread == 0 {
+        return base;
+    }
+    // FNV-1a: stable across runs and platforms, which is what makes the spread testable. A
+    // random source would give the same distribution and no test.
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for byte in key.as_bytes() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    let span = u128::from(spread) * 2 + 1;
+    let offset = u128::from(hash) % span;
+    let signed = i128::try_from(offset).unwrap_or(i128::MAX) - i128::from(spread);
+    let ttl = i128::from(base) + signed;
+    u64::try_from(ttl.max(0)).unwrap_or(u64::MAX)
 }
