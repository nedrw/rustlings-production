     /// Where a request at `now` should go.
     pub fn route(&mut self, now: u64) -> Route {
-        let _ = (
-            &self.threshold,
-            &self.cooldown,
-            &self.opened_at,
-            &self.probe_handed_out,
-            now,
-        );
-        todo!("closed and the one half-open probe use the cache; an expired open becomes half-open")
+        if self.state == State::Open && now >= self.opened_at + self.cooldown {
+            self.state = State::HalfOpen;
+            self.probe_handed_out = false;
+        }
+        match self.state {
+            State::Closed => Route::Cache,
+            // Exactly one probe: the first caller after the cool-down takes it, and everybody
