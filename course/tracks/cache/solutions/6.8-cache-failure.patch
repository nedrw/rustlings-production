     }
 
     /// Record how a call went.
     pub fn record(&mut self, ok: bool, now: u64) {
-        todo!("success closes and forgets; a failure may open, and reopens from half-open")
+        if ok {
+            self.state = State::Closed;
+            self.failures = 0;
+            return;
+        }
+        self.failures += 1;
+        // Half-open has only one probe: a failure there is the answer, and it reopens immediately.
+        if self.state == State::HalfOpen || self.failures >= self.threshold {
+            self.state = State::Open;
+            self.opened_at = now;
+        }
     }
