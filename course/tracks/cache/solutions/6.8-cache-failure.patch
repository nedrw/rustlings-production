     /// Where a request at `now` should go.
     pub fn route(&mut self, now: u64) -> Route {
-        todo!("closed and half-open try the cache; an expired open becomes half-open")
+        if self.state == State::Open && now >= self.opened_at + self.cooldown {
+            // Exactly one probe: the first caller after the cool-down finds the breaker half-open,
