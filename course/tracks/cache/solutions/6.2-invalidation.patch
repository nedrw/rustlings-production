 /// Write `value` for `key`: the store first, then the cache.
 pub fn write(store: &mut Store, cache: &mut Cache, key: &str, value: &str) {
-    todo!("write the store first, then drop the cached entry")
+    // Store first: if the process dies between the two, the cache still holds a value the store
