+//! The cache is gone: stop asking it, and come back carefully.
+//!
+//! When the cache is down, every request still pays the cache's failure — a timeout, a refused
+//! connection — before going to the store. A breaker turns that into one failed attempt per
+//! cool-down: it opens after a threshold of failures, sends traffic straight to the origin while it
+//! is open, and after the cool-down lets exactly one probe through (half-open) to find out whether
+//! the cache is back.
+//!
+//! ## What you write
+//!
+//! * [`Breaker::route`] — [`Route::Cache`] while closed, and **once** while half-open: the first
+//!   caller after the cool-down is the probe, and everybody behind it goes direct until the probe
+//!   reports. An open breaker becomes half-open once `now` has reached `opened_at + cooldown`.
+//! * [`Breaker::record`] — `ok` closes the breaker, forgets the failures and resets the probe. A
+//!   failure counts *while the breaker is not open*; a failure while half-open opens it again at
+//!   `now`. A failure recorded while open is ignored: the cache is not being called, and refreshing
+//!   `opened_at` would extend the cool-down forever.
+
+/// What the breaker is doing.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum State {
+    /// The cache is being used.
+    Closed,
+    /// The cache is being skipped.
+    Open,
+    /// One probe is allowed.
+    HalfOpen,
+}
+
+/// Where a request should go.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Route {
+    /// Try the cache.
+    Cache,
+    /// Go straight to the store.
+    Direct,
+}
+
+/// A circuit breaker in front of the cache.
+#[derive(Debug)]
+pub struct Breaker {
+    state: State,
+    failures: u32,
+    threshold: u32,
+    cooldown: u64,
+    opened_at: u64,
+    probe_handed_out: bool,
+}
+
+impl Breaker {
+    /// A breaker that opens after `threshold` consecutive failures and stays open for `cooldown`.
+    #[must_use]
+    pub fn new(threshold: u32, cooldown: u64) -> Self {
+        Self {
+            state: State::Closed,
+            failures: 0,
+            threshold,
+            cooldown,
+            opened_at: 0,
+            probe_handed_out: false,
+        }
+    }
+
+    /// What the breaker is doing.
+    #[must_use]
+    pub fn state(&self) -> State {
+        self.state
+    }
+
+    /// Failure count in the current window.
+    #[must_use]
+    pub fn failures(&self) -> u32 {
+        self.failures
+    }
+
+    /// Where a request at `now` should go.
+    pub fn route(&mut self, now: u64) -> Route {
+        let _ = (
+            &self.threshold,
+            &self.cooldown,
+            &self.opened_at,
+            &self.probe_handed_out,
+            now,
+        );
+        todo!("closed and the one half-open probe use the cache; an expired open becomes half-open")
+    }
+
+    /// Record how a call went.
+    pub fn record(&mut self, ok: bool, now: u64) {
+        let _ = (ok, now);
+        todo!("success closes and forgets; a failure may open, and reopens from half-open")
+    }
+}
