+//! OIDC tokens: five checks, and the one that makes the rest meaningful.
+//!
+//! A token is a bearer credential; validating it is not "parse the claims", it is comparing them
+//! against what this service accepts. The first check is not a claim at all: **the algorithm**. A
+//! verifier that trusts the token's own `alg` accepts `none` — no signature at all — which is the
+//! JWT hole that made "trust the header" famous. This service verifies with one algorithm it chose,
+//! and refuses every token that names another.
+//!
+//! Then the claims: issuer, audience, not-before, expiry. The audience is the one everybody forgets
+//! — a token minted for any client of the same provider is valid *somewhere*, and one shared
+//! provider is all it takes.
+//!
+//! ## What you write
+//!
+//! [`validate`] — the subject when every check passes, else the first failing one, in this order:
+//! algorithm, issuer, audience, not-before, expiry. The order is the contract.
+
+/// The claims this service reads.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Claims {
+    /// Who minted the token.
+    pub issuer: String,
+    /// Who the token is for.
+    pub audience: String,
+    /// Who it identifies.
+    pub subject: String,
+    /// The first second at which it is invalid.
+    pub expires_at: u64,
+    /// The first second at which it is valid.
+    pub not_before: u64,
+    /// The algorithm the token claims.
+    pub algorithm: String,
+}
+
+/// Why a token was refused.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ClaimError {
+    /// The algorithm is not one this service verifies with.
+    UnsupportedAlgorithm,
+    /// Another provider minted it.
+    WrongIssuer,
+    /// It is for another audience.
+    WrongAudience,
+    /// It is not valid yet.
+    NotYetValid,
+    /// It has expired.
+    Expired,
+}
+
+/// The subject of a valid token, or the first check it failed.
+///
+/// # Errors
+///
+/// See [`ClaimError`]; the checks run algorithm, issuer, audience, not-before, expiry.
+pub fn validate<'a>(
+    claims: &'a Claims,
+    issuer: &str,
+    audience: &str,
+    now: u64,
+) -> Result<&'a str, ClaimError> {
+    let _ = (claims, issuer, audience, now);
+    todo!("algorithm, issuer, audience, not-before, expiry — in that order")
+}
