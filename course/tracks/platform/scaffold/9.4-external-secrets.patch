+//! Secrets from a manager, at run time, and never in the artifact.
+//!
+//! A secret baked into an image is a secret in every registry copy, every layer cache and every
+//! laptop that pulled it. The platform-native answer is a **reference**: the manifest names a path
+//! and a key in a secret manager, the workload resolves it at start-up, and the image contains the
+//! reference and nothing else.
+//!
+//! Two judgements, and the second is the one reviews miss:
+//!
+//! * **resolution is strict** — a missing path or key is an error naming it, never an empty string
+//!   that starts the service with a blank password;
+//! * **the artifact is clean** — a secret value anywhere in the manifest (even a comment) is a
+//!   leaked secret, because the manifest is committed and shipped.
+//!
+//! ## What you write
+//!
+//! [`resolve`] — every reference to its value, or [`SecretError::Missing`] naming the first one
+//! that is not there; and [`leaks`] — the lines of a manifest that contain a secret value.
+
+use std::collections::BTreeMap;
+
+/// A reference from an environment variable to a secret.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Reference {
+    /// The environment variable to fill.
+    pub env: String,
+    /// The secret's path in the manager.
+    pub path: String,
+    /// The key inside that secret.
+    pub key: String,
+}
+
+/// Why a reference could not be resolved.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SecretError {
+    /// The path or the key is not there.
+    Missing {
+        /// The path that was asked for.
+        path: String,
+        /// The key that was asked for.
+        key: String,
+    },
+}
+
+/// The values, or the first reference that is not there.
+///
+/// # Errors
+///
+/// [`SecretError::Missing`] when a path or a key does not exist — never a silent empty value.
+pub fn resolve(
+    references: &[Reference],
+    store: &BTreeMap<String, BTreeMap<String, String>>,
+) -> Result<BTreeMap<String, String>, SecretError> {
