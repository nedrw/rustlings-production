+}
+
+/// Scales up at once and down after a run of low windows.
+#[derive(Debug)]
+pub struct Stabilizer {
+    current: u32,
+    down_after: u32,
+    low_windows: u32,
+}
+
+impl Stabilizer {
+    /// A stabilizer starting at `current` and requiring `down_after` low windows.
+    #[must_use]
+    pub fn new(current: u32, down_after: u32) -> Self {
+        Self {
+            current,
+            down_after,
+            low_windows: 0,
+        }
+    }
+
+    /// The count to apply for one window's `decision`.
+    pub fn observe(&mut self, decision: u32) -> u32 {
