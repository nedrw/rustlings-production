+//! The rollout drill: check an observed rollout against its budgets, step by step.
+//!
+//! Between a plan and a production rollout there is a rehearsal: watch the counts move and assert
+//! that the budgets held at **every** step, not just at the end. A rollout that ends at the right
+//! size can still have taken the service down in the middle, and the middle is what users saw.
+//!
+//! ## What you write
+//!
+//! [`drill`] — every violation, in step order:
+//!
+//! * [`Violation::TooManyPods`] when `total` is above `replicas + max_surge`;
+//! * [`Violation::TooFewReady`] when `ready` is below `replicas - max_unavailable`.
+//!
+//! Both may hold at one step, and the answer reports both — the reviewer is fixing whatever the
+//! step got wrong, which is not necessarily one thing.
+
+/// One step of an observed rollout.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Observed {
+    /// The desired replica count.
+    pub replicas: u32,
+    /// The creation budget.
+    pub max_surge: u32,
+    /// The availability budget.
+    pub max_unavailable: u32,
+    /// Pods that were ready at this step.
+    pub ready: u32,
+    /// Pods that existed at this step.
+    pub total: u32,
+}
+
+/// A budget the rollout broke at one step.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Violation {
+    /// More pods existed than the surge allowed.
+    TooManyPods {
+        /// The step's index.
+        step: usize,
+        /// How many pods existed.
+        total: u32,
+    },
+    /// Fewer pods were ready than the availability budget allowed.
+    TooFewReady {
+        /// The step's index.
+        step: usize,
+        /// How many pods were ready.
+        ready: u32,
+    },
+}
+
+/// Every violation of the budgets, in step order.
+#[must_use]
+pub fn drill(steps: &[Observed]) -> Vec<Violation> {
+    todo!("both budgets at every step, in step order")
+}
