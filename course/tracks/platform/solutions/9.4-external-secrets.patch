--- a/src/secrets.rs
+++ b/src/secrets.rs
@@ -51,13 +51,31 @@
     references: &[Reference],
     store: &BTreeMap<String, BTreeMap<String, String>>,
 ) -> Result<BTreeMap<String, String>, SecretError> {
-    let _ = (references, store);
-    todo!("every reference to its value, or the first one that is not there")
+    let mut values = BTreeMap::new();
+    for reference in references {
+        let value = store
+            .get(&reference.path)
+            .and_then(|secret| secret.get(&reference.key))
+            .ok_or_else(|| SecretError::Missing {
+                path: reference.path.clone(),
+                key: reference.key.clone(),
+            })?;
+        values.insert(reference.env.clone(), value.clone());
+    }
+    Ok(values)
 }
 
 /// The manifest lines that contain one of `secrets`.
 #[must_use]
 pub fn leaks(manifest: &[String], secrets: &[String]) -> Vec<String> {
-    let _ = (manifest, secrets);
-    todo!("the manifest lines that contain a secret value")
+    manifest
+        .iter()
+        .filter(|line| !line.trim().is_empty())
+        .filter(|line| {
+            secrets
+                .iter()
+                .any(|secret| !secret.is_empty() && line.contains(secret))
+        })
+        .cloned()
+        .collect()
 }
