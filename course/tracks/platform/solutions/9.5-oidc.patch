--- a/src/oidc.rs
+++ b/src/oidc.rs
@@ -58,6 +58,24 @@
     audience: &str,
     now: u64,
 ) -> Result<&'a str, ClaimError> {
-    let _ = (claims, issuer, audience, now);
-    todo!("algorithm, issuer, audience, not-before, expiry — in that order")
+    // Checked first and against the list this service chose: reading `alg` to decide how to verify
+    // is how a token gets to pick its own rules.
+    if claims.algorithm != "RS256" {
+        return Err(ClaimError::UnsupportedAlgorithm);
+    }
+    if claims.issuer != issuer {
+        return Err(ClaimError::WrongIssuer);
+    }
+    // Without this check the service accepts every token its neighbours were issued.
+    if claims.audience != audience {
+        return Err(ClaimError::WrongAudience);
+    }
+    if now < claims.not_before {
+        return Err(ClaimError::NotYetValid);
+    }
+    // The expiry is exclusive, like every deadline in this course.
+    if now >= claims.expires_at {
+        return Err(ClaimError::Expired);
+    }
+    Ok(&claims.subject)
 }
