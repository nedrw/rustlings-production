     /// The count to apply for one window's `decision`.
     pub fn observe(&mut self, decision: u32) -> u32 {
-        let _ = (&self.current, &self.down_after, &self.low_windows, decision);
-        todo!("up immediately; down only after a run of low windows")
+        if decision > self.current {
+            // The queue is growing now; a run of low windows is over.
+            self.current = decision;
+            self.low_windows = 0;
+            return self.current;
+        }
+        if decision == self.current {
+            self.low_windows = 0;
+            return self.current;
+        }
+        // Below: a dip is a pause, and a pause is not capacity.
+        self.low_windows += 1;
+        if self.low_windows >= self.down_after.max(1) {
+            self.current = decision;
+            self.low_windows = 0;
+        }
+        self.current
     }
