     /// [`Error::Invalid`] when the plan would take the cluster below its majority: the refusal names
     /// the node and how many were up. This is the check that turns a spreadsheet into a rule.
     pub fn run(&self, up: &[NodeId]) -> Result<Vec<Step>> {
-        let _ = up;
-        todo!("meshkv/5.15-cluster-drills: Plan::run")
+        let mut up: BTreeSet<NodeId> = up.iter().cloned().collect();
+        if up.len() < self.majority() {
+            return Err(Error::invalid(format!(
+                "the cluster starts below its majority: {} of {} nodes are up and {} are needed",
+                up.len(),
+                self.members.len(),
+                self.majority()
+            )));
+        }
+        let mut timeline = Vec::new();
+        for node in &self.order {
+            if !self.members.contains(node) {
+                return Err(Error::invalid(format!("`{node}` is not a member")));
+            }
+            if !up.contains(node) {
+                // A node that is already down is restarted where its turn comes; the timeline says
+                // so, and the majority check below still applies.
+                timeline.push(Step {
+                    node: node.clone(),
+                    was_up: false,
+                    majority_kept: up.len() >= self.majority(),
+                });
+                up.insert(node.clone());
+                continue;
+            }
+            up.remove(node);
+            let majority_kept = up.len() >= self.majority();
+            if !majority_kept {
+                return Err(Error::invalid(format!(
+                    "restarting `{node}` would leave {} of {} nodes up and the cluster needs {} — \
+                     restart one node at a time",
+                    up.len(),
+                    self.members.len(),
+                    self.majority()
+                )));
+            }
+            up.insert(node.clone());
+            timeline.push(Step {
+                node: node.clone(),
+                was_up: true,
+                majority_kept,
+            });
+        }
+        Ok(timeline)
     }
