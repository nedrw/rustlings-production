 /// [`Error::Invalid`] when the cluster has no nodes: there is no quorum to compute, and a budget for
 /// a cluster that does not exist is a number nobody can use.
 pub fn cost(nodes: usize) -> Result<Cost> {
-    let _ = nodes;
