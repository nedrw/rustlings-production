 /// [`Error::Invalid`] when nobody answered — an audit of no node is not an audit — or when the same
 /// node answered twice, which is a collector bug rather than a cluster one.
 pub fn audit(states: &[State]) -> Result<Report> {
-    let _ = states;
-    todo!("meshkv/5.22-consistency-audit: Report::audit")
+    if states.is_empty() {
+        return Err(Error::invalid("an audit needs at least one node to answer"));
+    }
+    let mut seen: Vec<&NodeId> = Vec::new();
+    for state in states {
+        if seen.contains(&&state.node) {
+            return Err(Error::invalid(format!(
+                "`{}` answered twice: two answers from one node is a collector bug",
+                state.node
+            )));
+        }
+        seen.push(&state.node);
+    }
+
+    let common_prefix = states.iter().map(|state| state.applied).min().unwrap_or(0);
+    // Every position at which at least two nodes can be compared: a node ahead of another cannot be
+    // compared at the other's index, but two nodes that reached the same index can — and that is
+    // where a divergence lives.
+    let furthest = states.iter().map(|state| state.applied).max().unwrap_or(0);
+    let mut diverged: Vec<NodeId> = Vec::new();
+    for index in common_prefix..=furthest {
+        let at: Vec<&State> = states
+            .iter()
+            .filter(|state| state.applied == index)
+            .collect();
+        if at.len() < 2 {
+            continue;
+        }
+        let mut counts: BTreeMap<u64, usize> = BTreeMap::new();
+        for state in &at {
+            *counts.entry(state.digest).or_default() += 1;
+        }
+        let Some((majority, _)) = counts
+            .iter()
+            .max_by_key(|(digest, count)| (**count, std::cmp::Reverse(**digest)))
+        else {
+            continue;
+        };
+        for state in at {
+            if state.digest != *majority && !diverged.contains(&state.node) {
+                diverged.push(state.node.clone());
+            }
+        }
+    }
+    let behind = states
+        .iter()
+        .filter(|state| state.applied < furthest)
+        .map(|state| state.node.clone())
+        .collect();
+    Ok(Report {
+        common_prefix,
+        behind,
+        diverged,
+        audited: states.len(),
+    })
 }
