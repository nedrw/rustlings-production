 /// [`Error::Invalid`] when nobody answered — an audit of no node is not an audit — or when the same
 /// node answered twice, which is a collector bug rather than a cluster one.
 pub fn audit(states: &[State]) -> Result<Report> {
-    let _ = states;
-    todo!("meshkv/5.22-consistency-audit: Report::audit")
+    if states.is_empty() {
+        return Err(Error::invalid("an audit needs at least one node to answer"));
+    }
+    let mut seen: Vec<&NodeId> = Vec::new();
+    for state in states {
+        if seen.contains(&&state.node) {
+            return Err(Error::invalid(format!(
+                "`{}` answered twice: two answers from one node is a collector bug",
+                state.node
+            )));
+        }
+        seen.push(&state.node);
+    }
+
+    let common_prefix = states.iter().map(|state| state.applied).min().unwrap_or(0);
+    // The nodes that reached the prefix, and the digest each reports there.
+    let mut at_prefix: Vec<&State> = states
+        .iter()
+        .filter(|state| state.applied == common_prefix)
+        .collect();
+    // A node ahead of the prefix cannot be compared yet: it is not a finding, but it is also not
+    // evidence, so the audit's majority is taken from the nodes that *are* at the prefix.
+    let mut counts: BTreeMap<u64, usize> = BTreeMap::new();
+    for state in &at_prefix {
+        *counts.entry(state.digest).or_default() += 1;
+    }
+    let majority_digest = counts
+        .iter()
+        .max_by_key(|(digest, count)| (**count, std::cmp::Reverse(**digest)))
+        .map(|(digest, _)| *digest);
+
+    let diverged = match majority_digest {
+        None => Vec::new(),
+        Some(majority) => at_prefix
+            .iter()
+            .filter(|state| state.digest != majority)
+            .map(|state| state.node.clone())
+            .collect(),
+    };
+    let behind = states
+        .iter()
+        .filter(|state| state.applied < common_prefix)
+        .map(|state| state.node.clone())
+        .collect();
+
+    // Keep the borrow checker honest: `at_prefix` is only needed above.
+    at_prefix.clear();
+    Ok(Report {
+        common_prefix,
+        behind,
+        diverged,
+        audited: states.len(),
+    })
 }
