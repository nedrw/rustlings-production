+/// Complete the handshake on an accepted connection.
+///
+/// The greeting is read, its name is checked against the topology, and only then is our own greeting
+/// written: a peer that is not a member is refused before it has been told anything about us.
+async fn handshake(stream: TcpStream, me: &NodeId, topology: &Topology) -> Result<Session> {
+    let mut session = Session {
+        peer: me.clone(),
+        stream,
+    };
+    let line = read_line(&mut session.stream).await?;
+    let claimed = parse_hello(&line)?;
+    topology
+        .lookup(&claimed)
+        .map_err(|error| Error::protocol(format!("the peer greeted with `{line}`: {error}")))?;
+    if &claimed == me {
+        return Err(Error::protocol(format!(
+            "`{me}` connected to itself — a node is not its own peer"
+        )));
+    }
+    write_line(&mut session.stream, &hello_line(me)).await?;
+    session.peer = claimed;
+    Ok(session)
+}
+
+/// Read one line, bounded by [`MAX_LINE`].
+///
+/// The bound is checked as the bytes arrive rather than after: a peer that never sends a line ending
+/// must not be able to choose how much memory this process holds.
+async fn read_line(stream: &mut TcpStream) -> Result<String> {
+    let mut line = Vec::new();
+    let mut byte = [0u8; 1];
+    loop {
+        let read = stream
+            .read(&mut byte)
+            .await
+            .map_err(|source| Error::Network { source })?;
+        if read == 0 {
+            return Err(Error::Network {
+                source: io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "the peer went away before it finished a line",
+                ),
+            });
+        }
+        for value in byte {
+            if line.len() >= MAX_LINE {
+                return Err(Error::protocol(format!(
+                    "the peer sent more than {MAX_LINE} bytes without a line ending"
+                )));
+            }
+            line.push(value);
+            if value == b'\n' {
+                return String::from_utf8(line)
+                    .map_err(|_| Error::protocol("the line is not UTF-8"));
+            }
+        }
+    }
+}
+
+/// Write one line, adding the ending when the caller did not.
+async fn write_line(stream: &mut TcpStream, line: &str) -> Result<()> {
+    let mut bytes = line.as_bytes().to_vec();
+    if !bytes.ends_with(b"\n") {
+        bytes.push(b'\n');
+    }
+    stream
+        .write_all(&bytes)
+        .await
+        .map_err(|source| Error::Network { source })
+}
