     /// [`Error::Invalid`] with the first check that failed, phrased as the sentence the runbook
     /// would say — a drill whose failure is "assertion failed" teaches nobody anything.
     pub fn judge(&self, transcript: &Transcript) -> Result<()> {
-        let _ = transcript;
-        todo!("meshkv/5.14-partition-drills: Drill::judge")
+        let events = transcript.events();
+        let size = members_of(events)?;
+        let members: Vec<NodeId> = (1..=size)
+            .filter_map(|index| NodeId::parse(&format!("n{index}")).ok())
+            .collect();
+        let mut cut: BTreeSet<(NodeId, NodeId)> = BTreeSet::new();
+        let mut crashed: BTreeSet<NodeId> = BTreeSet::new();
+        let mut writes: Vec<(NodeId, bool, bool)> = Vec::new();
+        for event in events {
+            if let Some(rest) = event.strip_prefix("partition ") {
+                let (a, b) = pair(rest)?;
+                cut.insert(ordered(&a, &b));
+            } else if let Some(rest) = event.strip_prefix("heal ") {
+                let (a, b) = pair(rest)?;
+                cut.remove(&ordered(&a, &b));
+            } else if let Some(node) = event.strip_prefix("crash node=") {
+                crashed.insert(NodeId::parse(node)?);
+            } else if let Some(node) = event.strip_prefix("restart node=") {
+                crashed.remove(&NodeId::parse(node)?);
+            } else if let Some(rest) = event.strip_prefix("write ") {
+                let Some(node) = field(rest, "node=") else {
+                    continue;
+                };
+                let node = NodeId::parse(&node)?;
+                let committed = field(rest, "committed=").is_some_and(|value| value != "0");
+                let isolated = isolated(&node, &members, &cut, &crashed);
+                writes.push((node, isolated, committed));
+            }
+        }
+
+        for check in &self.checks {
+            match check {
+                Check::Attempted { count } => {
+                    if writes.len() < *count {
+                        return Err(Error::invalid(format!(
+                            "the scenario attempted {} write(s) and the drill requires {count}",
+                            writes.len()
+                        )));
+                    }
+                }
+                Check::RefusedWhileIsolated { node } => {
+                    let offending = writes
+                        .iter()
+                        .filter(|(at, isolated, committed)| at == node && *isolated && *committed)
+                        .count();
+                    if offending > 0 {
+                        return Err(Error::invalid(format!(
+                            "{offending} write(s) sent to `{node}` committed while it was isolated \
+                             from every peer — a minority must not commit"
+                        )));
+                    }
+                }
+                Check::CommittedWhileConnected { node, count } => {
+                    let committed = writes
+                        .iter()
+                        .filter(|(at, isolated, committed)| at == node && !*isolated && *committed)
+                        .count();
+                    if committed < *count {
+                        return Err(Error::invalid(format!(
+                            "{committed} write(s) committed at `{node}` while it could reach a \
+                             majority, and the drill requires {count} — the cluster has to keep \
+                             working"
+                        )));
+                    }
+                }
+            }
+        }
+        Ok(())
     }
