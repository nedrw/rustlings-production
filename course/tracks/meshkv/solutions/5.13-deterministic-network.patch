+                    || nodes.iter().any(|other| {
+                        other != &target && partitioned.contains(&ordered(&target, other))
+                    });
+                if drop_budget > 0 && !blocked {
+                    drop_budget -= 1;
+                    transcript.push(format!("write key={key} at={at} lost"));
+                    continue;
+                }
+                let command = Command::Set {
+                    key: key.clone(),
+                    value: value.clone(),
+                }
+                .encode();
+                if blocked {
+                    transcript.push(format!("write key={key} at={at} refused"));
+                } else {
+                    let _ = command;
+                    committed += 1;
+                    transcript.push(format!("write key={key} at={at} committed={committed}"));
+                }
