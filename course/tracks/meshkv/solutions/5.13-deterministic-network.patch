+    let mut partitioned: BTreeSet<(NodeId, NodeId)> = BTreeSet::new();
+    let mut crashed: BTreeSet<NodeId> = BTreeSet::new();
+    let mut drop_budget = 0usize;
+    let mut committed = 0u64;
+    let mut rng = seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1;
+
+    let mut nodes: Vec<NodeId> = Vec::with_capacity(size);
+    for index in 1..=size {
+        nodes.push(NodeId::parse(&format!("n{index}"))?);
+    }
+    transcript.push(format!("members={size}"));
+
+    for (at, step) in playbook.steps().iter().enumerate() {
+        match step {
+            Step::Fault(Fault::Partition { a, b }) => {
+                partitioned.insert(ordered(a, b));
+                transcript.push(format!("partition a={a} b={b}"));
+            }
+            Step::Fault(Fault::Heal { a, b }) => {
+                partitioned.remove(&ordered(a, b));
+                transcript.push(format!("heal a={a} b={b}"));
+            }
+            Step::Fault(Fault::Drop { count }) => {
+                drop_budget += count;
+                transcript.push(format!("drop count={count}"));
+            }
+            Step::Fault(Fault::Crash { node }) => {
+                crashed.insert(node.clone());
+                transcript.push(format!("crash node={node}"));
+            }
+            Step::Fault(Fault::Restart { node }) => {
+                crashed.remove(node);
+                transcript.push(format!("restart node={node}"));
+            }
+            Step::Write { key, value } => {
+                // The write is attempted by the client at the node the seed picks; it commits only
+                // if every node it has to reach is up and connected. The playbook's faults are what
+                // decides that, and the transcript says which.
+                let target = nodes.get((rng % size as u64) as usize).cloned();
+                let Some(target) = target else {
