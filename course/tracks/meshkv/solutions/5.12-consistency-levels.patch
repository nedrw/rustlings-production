+            Some(commit) => {
+                if commit <= applied {
+                    // This node is at or ahead of the commit it knows about: nothing to bound.
+                    return Answer::Served { index: applied };
+                }
+                let lag = commit - applied;
+                if lag <= max_lag {
+                    Answer::Served { index: applied }
+                } else {
+                    Answer::Refused {
+                        reason: format!(
+                            "this node is {lag} entries behind and the level allows {max_lag}"
+                        ),
