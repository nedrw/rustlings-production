     /// Ask `node` to serve `request`, following redirects.
     ///
     /// The client asks the leader it remembers first, and only then the node it was given — a
     /// client that has just learned where the leader is should not pay for the redirect again.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when the redirects do not lead anywhere: a cycle, or more hops than
+    /// [`MAX_HOPS`]. A client that cannot reach a leader is told so rather than told to try again.
     pub fn serve(
         &mut self,
         node: &NodeId,
         request: &[u8],
         transport: &mut impl Transport,
     ) -> Result<Vec<u8>> {
-        let _ = (node, request, transport);
-        todo!("meshkv/5.7-client-routing: Client::serve")
+        let mut visited: BTreeSet<NodeId> = BTreeSet::new();
+        let mut current = self.leader.clone().unwrap_or_else(|| node.clone());
+        self.hops = 0;
+        loop {
+            if !visited.insert(current.clone()) {
+                return Err(Error::invalid(format!(
+                    "the redirects came back to `{current}`: the cluster is pointing at itself"
+                )));
+            }
+            let answer = transport.call(&current, request)?;
+            match answer {
+                Answer::Served { value } => return Ok(value),
+                Answer::Redirect { leader } => {
+                    self.hops += 1;
+                    if self.hops > MAX_HOPS {
+                        return Err(Error::invalid(format!(
+                            "more than {MAX_HOPS} redirects before the request was served"
+                        )));
+                    }
+                    self.leader = Some(leader.clone());
+                    current = leader;
+                }
+                Answer::NoLeader => {
+                    return Err(Error::invalid(
+                        "the node does not know who the leader is — an election is probably running",
+                    ));
+                }
+            }
+        }
     }
