     /// [`SdkError::Refused`] when the store refuses the write (no retry), and
     /// [`SdkError::RetriesExhausted`] when the attempts run out first.
     pub fn write(&mut self, command: &[u8]) -> std::result::Result<Index, SdkError> {
-        let _ = command;
-        todo!("meshkv/5.11-client-sdk: Backend::write")
+        // The key is computed once: every attempt is the *same* write, which is what makes a retry
+        // safe. A key per attempt would turn the retry into a second write.
+        let key = self.session.key_for(command);
+        self.attempts = 0;
+        loop {
+            self.attempts += 1;
+            let node = self.node.clone();
+            match self.backend.write(&node, &key, command) {
+                Ok(Reply::Applied { index, .. }) => return Ok(index),
+                Ok(Reply::Redirect { leader }) => {
+                    self.node = leader;
+                    if self.attempts >= MAX_ATTEMPTS {
+                        return Err(self.exhausted("the redirects did not reach a leader"));
+                    }
+                }
+                Ok(Reply::NoLeader) => {
+                    if self.attempts >= MAX_ATTEMPTS {
+                        return Err(self.exhausted("no node knew who the leader was"));
+                    }
+                }
+                Ok(Reply::Refused { reason }) => return Err(SdkError::Refused { reason }),
+                Err(SdkError::Unavailable { detail }) => {
+                    if self.attempts >= MAX_ATTEMPTS {
+                        return Err(self.exhausted(&detail));
+                    }
+                }
+                Err(error) => return Err(error),
+            }
+        }
     }
 
