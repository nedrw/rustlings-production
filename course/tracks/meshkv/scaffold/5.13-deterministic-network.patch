+//! The instrument for `meshkv/5.13-deterministic-network`: a scenario from a file, run by a seed.
+//!
+//! Course content, shipped by the step's scaffold. The scenario is the one the step's page shows:
+//! a node is isolated, two writes are attempted, the link is healed, and two more are attempted. The
+//! seed decides where the client's writes go, so the transcript changes with it — but the *rules* do
+//! not: a write that cannot reach the node it was sent to is refused, and a healed link commits.
+//!
+//! The point of the harness is that the scenario is a string. A test function can only run the
+//! scenarios somebody wrote as code; a playbook is a file the course can ship, and `5.14` reads
+//! partitions out of one.
+
+use meshkv::sim::{Playbook, run};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+/// The scenario: an isolation, two writes, a heal, two more writes.
+const SCENARIO: &str = "\
+partition n2 n3
+write a 1
+write b 2
+heal n2 n3
+write c 3
+write d 4
+";
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+#[test]
+fn a_playbook_runs_the_same_way_twice_and_differently_on_another_seed() {
+    let seed = seed();
+    let playbook = Playbook::parse(SCENARIO).expect("the step's own scenario is a playbook");
+    let first = run(seed, 3, &playbook).expect("the run");
+    let again = run(seed, 3, &playbook).expect("the run");
+
+    println!("meshkv-sim seed={seed}");
+    println!(
+        "meshkv-sim faults={} writes={}",
+        playbook.faults(),
+        playbook.writes()
+    );
+    for event in first.events() {
+        println!("meshkv-sim {event}");
+    }
+    println!("meshkv-sim digest={}", first.digest());
+
+    assert!(
+        first.same_as(&again),
+        "the same seed is the same run, byte for byte"
+    );
+
+    // A different seed is a different schedule: the client's writes go elsewhere, so the transcript
+    // differs. Two of the four writes may still commit — the invariants hold either way.
+    let other = run(seed.wrapping_add(1), 3, &playbook).expect("the run");
+    println!("meshkv-sim digest_other={}", other.digest());
+    assert_eq!(
+        other.events().len(),
+        first.events().len(),
+        "a different schedule is the same scenario, so the same number of events"
+    );
+}
