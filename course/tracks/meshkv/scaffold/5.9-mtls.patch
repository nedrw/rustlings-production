+//! The instrument for `meshkv/5.9-mtls`: handshakes across a rotation.
+//!
+//! Course content, shipped by the step's scaffold. The scenario is the one operation that makes
+//! certificates hard: **rotating them while the cluster is running**. A node may not present a
+//! certificate its peers do not accept yet, and may not refuse one its peers are still presenting —
+//! so for as long as the distribution takes, both are valid, and the moment the overlap ends the old
+//! one must stop working.
+//!
+//! The seed decides the order the handshakes happen in, which is the only thing that varies here:
+//! the verdicts do not, and that is the point — a rotation that only works in one order is a
+//! rotation that will fail in production.
+//!
+//! The transcript is the `meshkv-sim <name>=<value>` lines below. Nothing in it is a wall clock or a
+//! path: the times are the ones the scenario passes in, so the same seed prints the same bytes.
+
+use meshkv::cluster::NodeId;
+use meshkv::security::{Certificate, Rotation, TrustStore, authenticate};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+/// The cluster's issuer.
+const ISSUER: &str = "cluster-ca";
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+fn id(text: &str) -> NodeId {
+    NodeId::parse(text).expect("a valid name")
+}
+
+fn cert(subject: &str, not_before: u64, not_after: u64) -> Certificate {
+    Certificate::new(id(subject), ISSUER, not_before, not_after).expect("a certificate")
+}
+
+/// A tiny seeded generator: the harness needs an order, not a good random number.
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+
+    fn below(&mut self, bound: usize) -> usize {
+        (self.next() % bound as u64) as usize
+    }
+}
+
+#[test]
+fn a_rotation_has_no_gap_and_a_retired_certificate_stops_working() {
+    let seed = seed();
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+    let store = TrustStore::of([ISSUER]);
+
+    // n1 rotates: its old certificate is valid until 500, the new one from 200 until 900. The
+    // overlap is 200..500, and the distribution has to finish inside it.
+    let rotation = Rotation::new(cert("n1", 0, 500), cert("n1", 200, 900)).expect("a rotation");
+    println!(
+        "meshkv-sim rotation overlap_start={} overlap_end={}",
+        rotation.next().not_before(),
+        rotation.current().not_after()
+    );
+
+    // The peers to hand-shake with, in the order the seed picks.
+    let mut peers: Vec<&str> = vec!["n2", "n3", "n4"];
+    for at in 0..peers.len() {
+        let pick = rng.below(peers.len() - at);
+        peers.swap(at, at + pick);
+    }
+
+    // Inside the overlap every peer is accepted, whichever certificate it presents.
+    let mut accepted = 0usize;
+    for (age, peer) in peers.iter().enumerate() {
+        // Half the peers are still on the old certificate, half have the new one.
+        let certificate = if age % 2 == 0 {
+            cert(peer, 0, 500)
+        } else {
+            cert(peer, 200, 900)
+        };
+        let verdict = authenticate(&id(peer), &certificate, &store, 300);
+        let ok = verdict.is_ok();
+        accepted += usize::from(ok);
+        println!(
+            "meshkv-sim handshake peer={peer} phase=overlap verdict={}",
+            if ok { "accepted" } else { "refused" }
+        );
+    }
+    println!("meshkv-sim overlap_accepted={accepted}");
+    assert_eq!(
+        accepted,
+        peers.len(),
+        "every peer is accepted during the overlap"
+    );
+
+    // After the old certificate expires, only the new one is.
+    let mut accepted = 0usize;
+    for peer in &peers {
+        let old = authenticate(&id(peer), &cert(peer, 0, 500), &store, 600);
+        let new = authenticate(&id(peer), &cert(peer, 200, 900), &store, 600);
+        accepted += usize::from(old.is_ok()) + usize::from(new.is_ok());
+        println!(
+            "meshkv-sim handshake peer={peer} phase=retired old={} new={}",
+            if old.is_ok() { "accepted" } else { "refused" },
+            if new.is_ok() { "accepted" } else { "refused" }
+        );
+    }
+    println!("meshkv-sim after_retirement_accepted={accepted}");
+    assert_eq!(
+        accepted,
+        peers.len(),
+        "only the new certificate works after the retirement"
+    );
+
+    // The node presents exactly one certificate at each moment, and it is the valid one.
+    println!(
+        "meshkv-sim presented overlap={} retired={}",
+        rotation.presented(300).not_before(),
+        rotation.presented(600).not_before()
+    );
+    assert_eq!(
+        rotation.presented(300).not_before(),
+        200,
+        "inside the overlap the new one"
+    );
+    assert_eq!(rotation.presented(600).not_before(), 200, "and after it");
+
+    // The retirement has to wait for the distribution, and the arithmetic says so.
+    let safe = rotation.earliest_safe_retirement(100);
+    println!("meshkv-sim safe_retirement={safe}");
+    assert!(
+        safe > 200,
+        "retiring the old certificate before the new one is distributed is an outage"
+    );
+}
