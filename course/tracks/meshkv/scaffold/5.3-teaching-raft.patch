+        term: Term,
+        leader: NodeId,
+        prev: LogPosition,
+        entries: Vec<Entry>,
+        commit: Index,
+    ) -> Vec<Outbound> {
+        // Two leaders in one term: the one that hears about the other steps down.
+        if self.role != Role::Follower {
+            self.role = Role::Follower;
+            self.voted_for = None;
+            self.votes.clear();
+        }
