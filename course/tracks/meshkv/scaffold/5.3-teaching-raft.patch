+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Role {
+    /// It waits for a leader and answers vote requests.
+    Follower,
+    /// It is standing for election and collecting votes.
+    Candidate,
+    /// It leads: it appends writes and replicates them.
+    Leader,
+}
+
+impl Role {
+    /// The name as the page and the logs spell it.
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        todo!("meshkv/5.3-teaching-raft: Role::as_str")
+    }
+}
+
+/// A message this node wants to send, and who it is for.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Outbound {
+    /// The peer to send it to.
+    pub to: NodeId,
+    /// What to send.
+    pub message: Message,
+}
+
+/// One node's state: what it believes about the cluster, term by term.
+#[derive(Debug, Clone)]
+pub struct Raft {
