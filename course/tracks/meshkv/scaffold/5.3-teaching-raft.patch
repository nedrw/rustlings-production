+//! The instrument for `meshkv/5.3-teaching-raft`: three nodes in a simulated network.
+//!
+//! This file is **course content**, shipped by the step's scaffold: it is the thing that drives
+//! the learner's state machine, not the thing the learner writes. What it does is deliberately
+//! dull — it opens sockets, it moves timers, it prints a transcript — so that everything the
+//! learner has to get right is left in `src/raft/`.
+//!
+//! Three things about it are worth knowing, because they are the three things the step is about:
+//!
+//! * **the network is simulated, so the schedule is a seed.** `turmoil` runs every host on one
+//!   thread with a virtual clock; the seed decides the order the messages are delivered in. The
+//!   harness reads `KILN_SIM_SEED` and hands it to both the simulator and its own timeout picker,
+//!   so a seed *is* the schedule, and the same seed is the same schedule.
+//! * **the plumbing is here, the rules are not.** The election timeout, the heartbeat and the
+//!   sockets are this file's; the term, the vote, the log and the commit rule are the learner's.
+//!   That split is what makes a protocol testable at all: the part that can be wrong in an
+//!   interesting way is a value, and the part that cannot is plumbing.
+//! * **the client speaks its own protocol.** `client propose …` is not a Raft message; the client
+//!   is not a member of the cluster and never appears in the log. A client protocol that a
+//!   consensus protocol knows nothing about is the shape production systems have, and the step
+//!   that teaches client routing (`5.7`) is the step that moves it.
+//!
+//! What the harness prints is the transcript the `sim` gate judges: one `meshkv-sim <name>=<value>`
+//! line per fact, never a wall clock, never an address, never a path — a transcript that changed
+//! between two runs of the same seed would be a flaky test wearing a simulation's name.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use meshkv::cluster::NodeId;
+use meshkv::raft::message::Message;
+use meshkv::raft::state::{Outbound, Raft, Role};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::sync::mpsc;
+use turmoil::net::tcp::{OwnedReadHalf, OwnedWriteHalf};
+use turmoil::net::{TcpListener, TcpStream};
+
+/// The port every node listens on, in the simulation and in production.
+const PORT: u16 = 7000;
+
+/// The cluster: three nodes.
+const NAMES: [&str; 3] = ["n1", "n2", "n3"];
+
+/// How often the loop wakes up, in simulated milliseconds.
+const TICK: Duration = Duration::from_millis(10);
+
+/// How often a leader says "I am still here".
+const HEARTBEAT: Duration = Duration::from_millis(100);
+
+/// The window an election timeout is drawn from, in simulated milliseconds.
+const ELECTION_WINDOW: (u64, u64) = (300, 700);
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+/// What the seed is, or 1 when nothing set it.
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+/// Something a node has to deal with.
+enum Incoming {
+    /// A message from another member of the cluster.
+    Raft { from: NodeId, message: Message },
+    /// A request from a client, and the connection to answer it on.
+    Client {
+        request: String,
+        writer: Option<OwnedWriteHalf>,
+    },
+}
+
+/// The node's own view of its peers, and the sockets to them.
+struct Node {
+    name: String,
+    raft: Raft,
+    out: BTreeMap<NodeId, TcpStream>,
+    election_deadline: tokio::time::Instant,
+    next_heartbeat: tokio::time::Instant,
+    rng: u64,
+}
+
+impl Node {
+    /// A node with an election timeout drawn from the seed.
+    fn new(id: NodeId, members: Vec<NodeId>, seed: u64) -> Self {
+        let rng = mix(seed);
+        let timeout = ELECTION_WINDOW.0 + (rng % span());
+        let now = tokio::time::Instant::now();
+        Self {
+            name: id.as_str().to_owned(),
+            raft: Raft::new(id, members),
+            out: BTreeMap::new(),
+            election_deadline: now + Duration::from_millis(timeout),
+            next_heartbeat: now,
+            rng,
+        }
+    }
+
+    /// Draw the next election timeout from this node's own generator.
+    fn next_timeout(&mut self) -> Duration {
+        self.rng = mix(self.rng);
+        Duration::from_millis(ELECTION_WINDOW.0 + (self.rng % span()))
+    }
+
+    /// Send one message to a peer, connecting first if it has to.
+    async fn send(&mut self, to: &NodeId, message: &Message) {
+        if !self.out.contains_key(to) {
+            let Ok(stream) = TcpStream::connect((to.as_str(), PORT)).await else {
+                return;
+            };
+            self.out.insert(to.clone(), stream);
+        }
+        let Some(stream) = self.out.get_mut(to) else {
+            return;
+        };
+        // The envelope is the harness's, not the protocol's: every line names its sender, so the
+        // receiver knows who a message came from without the protocol having to say so. (The
+        // production transport learns the same thing from the handshake `5.1` wrote down.)
+        let line = format!("{} {}\n", self.name, message.encode());
+        if stream.write_all(line.as_bytes()).await.is_err() {
+            self.out.remove(to);
+        }
+    }
+
+    /// Send everything the state machine asked for.
+    async fn flush(&mut self, outbounds: Vec<Outbound>) {
+        for outbound in outbounds {
+            self.send(&outbound.to, &outbound.message).await;
+        }
+    }
+}
+
+/// The width of the election-timeout window.
+fn span() -> u64 {
+    (ELECTION_WINDOW.1 - ELECTION_WINDOW.0).max(1)
+}
+
+/// A tiny mixing function: the harness needs a spread of timeouts, not a good random number.
+fn mix(seed: u64) -> u64 {
+    let mut value = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    value ^= value << 13;
+    value ^= value >> 7;
+    value ^= value << 17;
+    value
+}
+
+/// Read the lines of one connection and hand them to the node.
+async fn read_connection(
+    mut reader: BufReader<OwnedReadHalf>,
+    inbox: mpsc::UnboundedSender<Incoming>,
+    writer: Option<OwnedWriteHalf>,
+) {
+    let mut writer = writer;
+    let mut line = String::new();
+    loop {
+        line.clear();
+        match reader.read_line(&mut line).await {
+            Ok(0) | Err(_) => return,
+            Ok(_) => {}
+        }
+        let text = line.trim().to_owned();
+        if text.is_empty() {
+            continue;
+        }
+        let Some((sender, rest)) = text.split_once(' ') else {
+            continue;
+        };
+        if sender == "client" {
+            if inbox
+                .send(Incoming::Client {
+                    request: rest.to_owned(),
+                    writer: writer.take(),
+                })
+                .is_err()
+            {
+                return;
+            }
+            // One client request per connection: the answer goes back on this one, and the
+            // client opens a new connection for the next request.
+            return;
+        }
+        let Ok(from) = NodeId::parse(sender) else {
+            continue;
+        };
+        let Ok(message) = Message::decode(rest) else {
+            continue;
+        };
+        if inbox.send(Incoming::Raft { from, message }).is_err() {
+            return;
+        }
+    }
+}
+
+/// Answer a client request with one line.
+async fn answer(writer: &mut OwnedWriteHalf, line: &str) {
+    let _ = writer.write_all(format!("{line}\n").as_bytes()).await;
+}
+
+/// How long the client waits for a cluster to have a leader, in simulated milliseconds.
+const CLIENT_PATIENCE: Duration = Duration::from_secs(8);
+
+/// The client: find a leader, propose a write, and wait until it is committed.
+///
+/// The client starts with the cluster, not after it: a node that has not bound its listener yet
+/// refuses the connection, and a client that gave up at the first refusal would report "no leader"
+/// for a cluster that is about to have one. So the client waits — on the *simulated* clock, which
+/// is why this loop costs nothing in real time.
+async fn client(done: Arc<AtomicBool>, committed: Arc<AtomicBool>) {
+    let deadline = tokio::time::Instant::now() + CLIENT_PATIENCE;
+    let mut found = None;
+    while tokio::time::Instant::now() < deadline && found.is_none() {
+        for name in NAMES {
+            if let Some((leader, index)) = propose_to(name, b"write-1").await {
+                found = Some((leader, index));
+                break;
+            }
+        }
+        if found.is_none() {
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+    }
+    let Some((leader, index)) = found else {
+        println!("meshkv-sim leader=none");
+        println!("meshkv-sim committed=0");
+        done.store(true, Ordering::SeqCst);
+        return;
+    };
+    let was_committed = wait_committed(&leader, index).await;
+    committed.store(was_committed, Ordering::SeqCst);
+    println!("meshkv-sim leader={leader}");
+    println!("meshkv-sim committed={}", u8::from(was_committed));
+    println!("meshkv-sim entries={index}");
+    done.store(true, Ordering::SeqCst);
+}
+
+/// Propose one write to a node, following a redirect to the leader.
+async fn propose_to(name: &str, payload: &[u8]) -> Option<(String, u64)> {
+    let mut current = name.to_owned();
+    for _ in 0..4 {
+        let Ok(mut stream) = TcpStream::connect((current.as_str(), PORT)).await else {
+            return None;
+        };
+        let request = format!("client propose {}\n", hex(payload));
+        if stream.write_all(request.as_bytes()).await.is_err() {
+            return None;
+        }
+        let mut answer = String::new();
+        let mut reader = BufReader::new(stream);
+        if reader.read_line(&mut answer).await.is_err() {
+            return None;
+        }
+        let answer = answer.trim().to_owned();
+        if let Some(rest) = answer.strip_prefix("client redirect ") {
+            let leader = rest.trim();
+            if leader == "unknown" {
+                // No leader yet: the client tries again rather than dialing a host that does not
+                // exist.
+                return None;
+            }
+            current = leader.to_owned();
+            continue;
+        }
+        if let Some(rest) = answer.strip_prefix("client ok ") {
+            return rest
+                .trim()
+                .parse::<u64>()
+                .ok()
+                .map(|index| (current, index));
+        }
+        return None;
+    }
+    None
+}
+
+/// Ask a node whether an entry is committed, until it says yes or the sim gives up.
+async fn wait_committed(leader: &str, index: u64) -> bool {
+    for _ in 0..200 {
+        let Ok(mut stream) = TcpStream::connect((leader, PORT)).await else {
+            return false;
+        };
+        let request = format!("client committed {index}\n");
+        if stream.write_all(request.as_bytes()).await.is_err() {
+            return false;
+        }
+        let mut answer = String::new();
+        let mut reader = BufReader::new(stream);
+        if reader.read_line(&mut answer).await.is_err() {
+            return false;
+        }
+        if answer.trim() == "client committed yes" {
+            return true;
+        }
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    false
+}
+
+/// The payload of a write, as hex.
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+/// The payload of a write, as bytes.
+fn unhex(text: &str) -> Option<Vec<u8>> {
+    if !text.len().is_multiple_of(2) {
+        return None;
+    }
+    let raw = text.as_bytes();
+    let mut bytes = Vec::with_capacity(raw.len() / 2);
+    for pair in raw.chunks(2) {
+        let high = (pair[0] as char).to_digit(16)?;
+        let low = (pair[1] as char).to_digit(16)?;
+        bytes.push((high * 16 + low) as u8);
+    }
+    Some(bytes)
+}
+
+/// What a client request asks of the node, and what the node does about it.
+enum Request {
+    /// Propose a write.
+    Propose(Vec<u8>),
+    /// Ask whether an entry is committed.
+    Committed(u64),
+}
+
+/// Read a client request.
+fn parse_request(request: &str) -> Option<Request> {
+    let mut words = request.split(' ');
+    match words.next() {
+        Some("propose") => Some(Request::Propose(unhex(words.next().unwrap_or_default())?)),
+        Some("committed") => Some(Request::Committed(words.next()?.parse::<u64>().ok()?)),
+        _ => None,
+    }
+}
+
+/// Run one node of the cluster.
+async fn run_node(id: NodeId, members: Vec<NodeId>, seed: u64, done: Arc<AtomicBool>) {
+    let (inbox_tx, mut inbox_rx) = mpsc::unbounded_channel::<Incoming>();
+    let Ok(listener) = TcpListener::bind(("0.0.0.0", PORT)).await else {
+        return;
+    };
+    let acceptor = tokio::spawn(async move {
+        loop {
+            let Ok((stream, _)) = listener.accept().await else {
+                return;
+            };
+            let (read, write) = stream.into_split();
+            let sender = inbox_tx.clone();
+            tokio::spawn(async move {
+                read_connection(BufReader::new(read), sender, Some(write)).await;
+            });
+        }
+    });
+
+    let mut node = Node::new(id, members, seed);
+    loop {
+        if done.load(Ordering::SeqCst) {
+            break;
+        }
+        tokio::select! {
+            Some(incoming) = inbox_rx.recv() => match incoming {
+                Incoming::Raft { from, message } => {
+                    let term = message.term();
+                    let outbounds = node.raft.on_message(&from, message);
+                    if term >= node.raft.term() {
+                        node.election_deadline = tokio::time::Instant::now() + node.next_timeout();
+                    }
+                    node.flush(outbounds).await;
+                }
+                Incoming::Client { request, writer } => {
+                    let (line, outbounds) = serve(&mut node, &request);
+                    node.flush(outbounds).await;
+                    if let Some(mut writer) = writer {
+                        answer(&mut writer, &line).await;
+                    }
+                }
+            },
+            _ = tokio::time::sleep(TICK) => {
+                let now = tokio::time::Instant::now();
+                if node.raft.role() == Role::Leader {
+                    if now >= node.next_heartbeat {
+                        let outbounds = node.raft.append_entries();
+                        node.flush(outbounds).await;
+                        node.next_heartbeat = now + HEARTBEAT;
+                    }
+                } else if now >= node.election_deadline {
+                    let outbounds = node.raft.campaign();
+                    node.flush(outbounds).await;
+                    node.election_deadline = now + node.next_timeout();
+                    node.next_heartbeat = now + HEARTBEAT;
+                }
+            }
+        }
+    }
+    acceptor.abort();
+}
+
+/// Answer a client request: the line to send back, and the messages the answer caused.
+fn serve(node: &mut Node, request: &str) -> (String, Vec<Outbound>) {
+    match parse_request(request) {
+        Some(Request::Propose(payload)) => match node.raft.propose(payload) {
+            Ok(index) => {
+                let outbounds = node.raft.append_entries();
+                (format!("client ok {index}"), outbounds)
+            }
+            Err(_) => {
+                let leader = node
+                    .raft
+                    .leader()
+                    .map(|leader| leader.as_str().to_owned())
+                    .unwrap_or_else(|| "unknown".to_owned());
+                (format!("client redirect {leader}"), Vec::new())
+            }
+        },
+        Some(Request::Committed(index)) => {
+            let committed = node.raft.commit_index() >= index;
+            (
+                format!("client committed {}", if committed { "yes" } else { "no" }),
+                Vec::new(),
+            )
+        }
+        None => ("client unknown".to_owned(), Vec::new()),
+    }
+}
+
+#[test]
+fn three_nodes_elect_a_leader_and_commit_a_write() {
+    let seed = seed();
+    let mut sim = turmoil::Builder::new().rng_seed(seed).build();
+    let done = Arc::new(AtomicBool::new(false));
+    let committed = Arc::new(AtomicBool::new(false));
+    let members: Arc<Vec<NodeId>> = Arc::new(
+        NAMES
+            .iter()
+            .map(|name| NodeId::parse(name).expect("a valid name"))
+            .collect(),
+    );
+    for name in NAMES {
+        let members = Arc::clone(&members);
+        let done = Arc::clone(&done);
+        // The host closure is called again whenever a host is restarted, so it may only borrow
+        // what it captures — everything it needs is cloned inside.
+        sim.host(name, move || {
+            let members = Arc::clone(&members);
+            let done = Arc::clone(&done);
+            async move {
+                let id = NodeId::parse(name).expect("a valid name");
+                run_node(id, members.as_ref().clone(), seed, done).await;
+                Ok(())
+            }
+        });
+    }
+    let client_done = Arc::clone(&done);
+    let client_committed = Arc::clone(&committed);
+    sim.client("client", async move {
+        client(client_done, client_committed).await;
+        Ok(())
+    });
+    sim.run().expect("the simulation runs");
+    assert!(
+        done.load(Ordering::SeqCst),
+        "the client finished: a scenario that never finishes is a scenario with no answer"
+    );
+    assert!(
+        committed.load(Ordering::SeqCst),
+        "the cluster elected a leader and committed the write: a run that elects nobody, or a write \
+         nobody commits, is a run with no answer — and the gate reads the answer off the \
+         transcript"
+    );
+}
