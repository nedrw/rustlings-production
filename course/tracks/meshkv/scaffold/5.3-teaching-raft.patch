+//! What two nodes say to each other, and how a line of text carries it.
+//!
+//! `meshkv/5.3-teaching-raft` is the step where the log of `5.2` starts moving. The messages are
+//! the only things that move it, and there are four of them:
+//!
+//! | message | who sends it | what it asks |
+//! | --- | --- | --- |
+//! | [`Message::RequestVote`] | a candidate | "may I have your vote for this term?" |
+//! | [`Message::Vote`] | a peer | "yes" or "no", for that term |
+//! | [`Message::Append`] | a leader | "these entries, and this is how far I have committed" |
+//! | [`Message::AppendAck`] | a follower | "I have them" (and how far), or "no" |
+//!
+//! Two things are deliberate here. First, **the encoding is text and the parsing is strict**: a
+//! line that is not one of these four is a refusal, not a shrug — the same rule 5.1 wrote down for
+//! the handshake, and the same reason (`4.1`'s framing: after bytes that are not a message,
+//! nothing that follows can be trusted to start at a boundary). Second, **the payload of an entry
+//! is carried as hex**, so an entry never breaks the line it rides in: the log's rules are about
+//! positions and terms, and a write that contained a newline would make the encoding lie about
+//! where the entries are.
+
+use crate::cluster::NodeId;
+use crate::error::Result;
+use crate::raft::{Entry, Index, Term};
+
+/// Where a node's log ends: the term of its last entry and that entry's position.
+///
+/// The empty log ends at term 0, position 0 — the same numbers a log's first entry would have to
+/// follow, which is what makes "my log is at least as long as yours" a comparison of two pairs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct LogPosition {
+    /// The term of the last entry.
+    pub term: Term,
+    /// Its position, one-based; zero for an empty log.
+    pub index: Index,
+}
+
+impl LogPosition {
+    /// The end of an empty log.
+    #[must_use]
+    pub fn empty() -> Self {
+        todo!("meshkv/5.3-teaching-raft: LogPosition::empty")
+    }
+
+    /// `true` when this position is at least as far along as `other` — the comparison a candidate
+    /// has to win to get a vote from a node whose log is longer.
+    ///
+    /// The term comes first: a log with more entries from an older term is *behind* one with
+    /// fewer entries from a newer term, and that is the rule that keeps a committed entry safe.
+    #[must_use]
+    pub fn is_at_least(&self, other: &LogPosition) -> bool {
+        let _ = other;
+        todo!("meshkv/5.3-teaching-raft: LogPosition::is_at_least")
+    }
+}
+
+/// One message between two nodes.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Message {
+    /// A candidate asks a peer for its vote.
+    RequestVote {
+        /// The term the candidate is standing in.
+        term: Term,
+        /// Who is standing.
+        candidate: NodeId,
+        /// Where the candidate's log ends, so the peer can judge whether it is caught up.
+        last: LogPosition,
+    },
+    /// A peer answers a vote request.
+    Vote {
+        /// The term the answer is about; a peer that has moved on answers with its newer term.
+        term: Term,
+        /// Whether the vote was given.
+        granted: bool,
+    },
+    /// A leader sends entries, or a heartbeat when it carries none.
+    Append {
+        /// The leader's term.
+        term: Term,
+        /// Who the leader is.
+        leader: NodeId,
+        /// The entry that must already be on the follower for these to follow it.
+        prev: LogPosition,
+        /// The entries themselves, in order.
+        entries: Vec<Entry>,
+        /// How far the leader has committed.
+        commit: Index,
+    },
+    /// A follower answers an append.
+    AppendAck {
+        /// The follower's term.
+        term: Term,
+        /// Whether the entries were accepted.
+        success: bool,
+        /// How far the follower's log reaches, whatever the answer was.
+        match_index: Index,
+    },
+}
