+        todo!("meshkv/5.3-teaching-raft: Raft::step_down")
+    }
+
+    /// A vote request: grant it when the candidate is caught up and nobody else has the vote.
+    fn on_request_vote(
+        &mut self,
+        from: &NodeId,
+        term: Term,
+        candidate: NodeId,
+        last: LogPosition,
+    ) -> Vec<Outbound> {
+        let mine = self.last_position();
+        let free = self.voted_for.is_none() || self.voted_for.as_ref() == Some(&candidate);
+        let caught_up = last.is_at_least(&mine);
+        let granted = free && caught_up && self.role != Role::Leader;
+        if granted {
+            self.voted_for = Some(candidate);
+        }
+        vec![Outbound {
+            to: from.clone(),
+            message: Message::Vote { term, granted },
+        }]
+    }
+
