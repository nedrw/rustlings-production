+//! The instrument for `meshkv/5.21-protocol-evolution`: two builds, one cluster.
+//!
+//! Course content, shipped by the step's scaffold. The scenario is a rolling upgrade: the plan is
+//! walked in the seed's order, and every step prints whether the upgraded node can still talk to the
+//! ones that are not upgraded yet — and whether the last step is where the cluster starts speaking
+//! the new minor.
+//!
+//! The seed decides the order; the verdicts do not, and that is the point: a plan that only worked in
+//! one order would be a plan that fails in production.
+
+use meshkv::cluster::NodeId;
+use meshkv::protocol::{Phase, Protocol, Upgrade};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+fn node(text: &str) -> NodeId {
+    NodeId::parse(text).expect("a valid name")
+}
+
+fn version(text: &str) -> Protocol {
+    Protocol::parse(text).expect("a version")
+}
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+
+    fn below(&mut self, bound: usize) -> usize {
+        (self.next() % bound as u64) as usize
+    }
+}
+
+#[test]
+fn a_rolling_upgrade_holds_the_new_minor_back_until_the_last_node() {
+    let seed = seed();
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+    let mut order = vec![node("n1"), node("n2"), node("n3")];
+    for at in 0..order.len() {
+        let pick = rng.below(order.len() - at);
+        order.swap(at, at + pick);
+    }
+
+    let plan = Upgrade::new(&order, version("1.1"), version("1.2")).expect("a plan");
+    let phases = plan.phases();
+    println!("meshkv-sim seed={seed} nodes={}", order.len());
+    let mut compat = 0;
+    let mut native = 0;
+    for (index, phase) in phases.iter().enumerate() {
+        match phase {
+            Phase::Compat { speaking, built } => {
+                compat += 1;
+                println!(
+                    "meshkv-sim step={index} node={} phase=compat speaking={} built={}",
+                    order[index],
+                    speaking.render(),
+                    built.render()
+                );
+                assert_eq!(
+                    *speaking,
+                    version("1.1"),
+                    "a compat node speaks the old minor"
+                );
+            }
+            Phase::Native { version: spoken } => {
+                native += 1;
+                println!(
+                    "meshkv-sim step={index} node={} phase=native version={}",
+                    order[index],
+                    spoken.render()
+                );
+                assert_eq!(*spoken, version("1.2"));
+            }
+        }
+    }
+    println!("meshkv-sim compat={compat} native={native}");
+    assert_eq!(
+        compat,
+        order.len() - 1,
+        "every node but the last holds back"
+    );
+    assert_eq!(native, 1, "and the last step is where the cluster moves");
+
+    // A major bump is refused whatever the order.
+    assert!(Upgrade::new(&order, version("1.9"), version("2.0")).is_err());
+}
