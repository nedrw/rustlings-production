+//! The two implementations of the SDK's backend, and the one the spec is told to use.
+//!
+//! Course content, shipped by `meshkv/5.11-client-sdk`. `conformance@2` runs the step's own spec
+//! once per name in `conformance.toml`, with `KILN_BACKEND` set; this file is where that name
+//! becomes a value. The two implementations are deliberately different in kind:
+//!
+//! * **scripted** answers from a table: a fixed leader, a follower that redirects to it, and a
+//!   ledger that remembers the keys it has applied. It is the smallest thing that can satisfy the
+//!   port, which is what makes it a good check on the SDK's policy — there is nothing else for the
+//!   policy to lean on.
+//! * **in-process** runs the real cluster: an elected `Raft`, `5.10`'s state machine, and `5.8`'s
+//!   ledger. It is the implementation a user of the SDK would actually get.
+//!
+//! A suite that passes against one and fails against the other has found a policy that depends on
+//! an accident of the implementation, which is the bug `conformance@2` exists to find.
+
+use std::collections::BTreeMap;
+
+use meshkv::cluster::NodeId;
+use meshkv::idempotency::{IdempotencyKey, Ledger, Outcome};
+use meshkv::kv::Kv;
+use meshkv::raft::Term;
+use meshkv::raft::message::Message;
+use meshkv::raft::state::Raft;
+use meshkv::sdk::{Backend, Reply, SdkError};
+
+/// The variable the conformance gate sets to pick an implementation.
+const BACKEND: &str = "KILN_BACKEND";
+
+/// The backend the spec asked for, by name.
+pub fn backend() -> Box<dyn Backend> {
+    match std::env::var(BACKEND).as_deref() {
+        Ok("scripted") => Box::new(Scripted::new()),
+        // The default is the in-process cluster: a suite run by hand should exercise the real one.
+        _ => Box::new(InProcess::new()),
+    }
+}
+
+/// A backend that answers from a table, with a ledger for the keys it has seen.
+struct Scripted {
+    leader: String,
+    applied: BTreeMap<IdempotencyKey, meshkv::raft::Index>,
+    values: BTreeMap<String, Vec<u8>>,
+}
+
+impl Scripted {
+    fn new() -> Self {
+        Self {
+            leader: "n1".to_owned(),
+            applied: BTreeMap::new(),
+            values: BTreeMap::new(),
+        }
+    }
+}
+
+impl Backend for Scripted {
+    fn write(
+        &mut self,
+        node: &str,
+        key: &IdempotencyKey,
+        command: &[u8],
+    ) -> Result<Reply, SdkError> {
+        if node != self.leader {
+            return Ok(Reply::Redirect {
+                leader: self.leader.clone(),
+            });
+        }
+        if let Some(index) = self.applied.get(key) {
+            // The same write, again: the same answer, and no second application.
+            return Ok(Reply::Applied {
+                index: *index,
+                value: None,
+            });
+        }
+        let parsed = meshkv::kv::Command::parse(command).map_err(|error| SdkError::Refused {
+            reason: error.to_string(),
+        })?;
+        match parsed {
+            meshkv::kv::Command::Set { key, value } => {
+                self.values.insert(key, value);
+            }
+            meshkv::kv::Command::Cas { key, expect, value } => {
+                if self.values.get(&key) != Some(&expect) {
+                    return Err(SdkError::Refused {
+                        reason: format!("`{key}` does not hold what the compare-and-set expects"),
+                    });
+                }
+                self.values.insert(key, value);
+            }
+            meshkv::kv::Command::Delete { key } => {
+                self.values.remove(&key);
+            }
+        }
+        let index = self.applied.len() as meshkv::raft::Index + 1;
+        self.applied.insert(key.clone(), index);
+        Ok(Reply::Applied { index, value: None })
+    }
+
+    fn read(&mut self, node: &str, key: &str) -> Result<Reply, SdkError> {
+        if node != self.leader {
+            return Ok(Reply::Redirect {
+                leader: self.leader.clone(),
+            });
+        }
+        Ok(Reply::Applied {
+            index: 0,
+            value: self.values.get(key).cloned(),
+        })
+    }
+}
+
+/// A backend that runs the real cluster: an elected `Raft`, the state machine, and the ledger.
+struct InProcess {
+    raft: Raft,
+    kv: Kv,
+    ledger: Ledger,
+}
+
+impl InProcess {
+    fn new() -> Self {
+        let members = vec![id("n1"), id("n2"), id("n3")];
+        let mut raft = Raft::new(id("n1"), members);
+        let _ = raft.campaign();
+        let _ = raft.on_message(
+            &id("n2"),
+            Message::Vote {
+                term: Term::new(1),
+                granted: true,
+            },
+        );
+        Self {
+            raft,
+            kv: Kv::new(),
+            ledger: Ledger::new(meshkv::idempotency::default_window()),
+        }
+    }
+}
+
+fn id(text: &str) -> NodeId {
+    NodeId::parse(text).expect("a valid name")
+}
+
+impl Backend for InProcess {
+    fn write(
+        &mut self,
+        node: &str,
+        key: &IdempotencyKey,
+        command: &[u8],
+    ) -> Result<Reply, SdkError> {
+        // `n1` is the leader in this fixture: any other node answers with a redirect, which is the
+        // part of the SDK's policy the suite exercises from the first case.
+        if node != "n1" {
+            return Ok(Reply::Redirect {
+                leader: "n1".to_owned(),
+            });
+        }
+        // A compare-and-set the leader can already see will not match is refused before it costs a
+        // log entry: the state machine would answer `Mismatch` for ever, so there is nothing to
+        // gain from writing it down.
+        if let Ok(meshkv::kv::Command::Cas { key, expect, .. }) =
+            meshkv::kv::Command::parse(command)
+            && self.kv.get(&key) != Some(expect.as_slice())
+        {
+            return Ok(Reply::Refused {
+                reason: format!("`{key}` does not hold what the compare-and-set expects"),
+            });
+        }
+        let mut applied = None;
+        let outcome = self
+            .ledger
+            .apply(key.clone(), 0, || {
+                let index = self
+                    .raft
+                    .propose(command.to_vec())
+                    .map_err(|error| meshkv::error::Error::invalid(error.to_string()))?;
+                // A write commits once a majority holds it; the fixture's follower is the second
+                // node of three, which is a majority with the leader.
+                let _ = self.raft.on_message(
+                    &id("n2"),
+                    Message::AppendAck {
+                        term: Term::new(1),
+                        success: true,
+                        match_index: index,
+                    },
+                );
+                if self.raft.commit_index() >= index {
+                    // Apply the whole committed prefix, not just this entry: the leader's own entry
+                    // from `5.3` sits at index 1 and has to be applied first — a state machine
+                    // applies the log in order, which is the rule `5.10` enforces.
+                    let from = self.kv.applied_index() + 1;
+                    for position in from..=index {
+                        let payload = self
+                            .raft
+                            .log()
+                            .at(position)
+                            .map(|entry| entry.payload().to_vec())
+                            .unwrap_or_default();
+                        self.kv
+                            .apply(position, &payload)
+                            .map_err(|error| meshkv::error::Error::invalid(error.to_string()))?;
+                    }
+                    applied = Some(index);
+                }
+                Ok((Some(index), index.to_be_bytes().to_vec()))
+            })
+            .map_err(|error| SdkError::Refused {
+                reason: error.to_string(),
+            })?;
+        match outcome {
+            Outcome::Applied { index } => Ok(Reply::Applied {
+                index: index.unwrap_or_default(),
+                value: None,
+            }),
+            Outcome::Duplicate { answer } => {
+                let mut bytes = [0u8; 8];
+                bytes.copy_from_slice(&answer[..8]);
+                Ok(Reply::Applied {
+                    index: u64::from_be_bytes(bytes),
+                    value: None,
+                })
+            }
+        }
+    }
+
+    fn read(&mut self, node: &str, key: &str) -> Result<Reply, SdkError> {
+        if node != "n1" {
+            return Ok(Reply::Redirect {
+                leader: "n1".to_owned(),
+            });
+        }
+        Ok(Reply::Applied {
+            index: self.kv.applied_index(),
+            value: self.kv.get(key).map(<[u8]>::to_vec),
+        })
+    }
+}
