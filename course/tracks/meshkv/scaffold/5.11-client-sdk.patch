+#![allow(dead_code)]
+// the stub keeps the values the implementation will read; the reference
+// solution drops the allowance, because by then every one is used.
+
+//! The SDK: what a caller sees, once the cluster's rules are somebody else's problem.
+//!
+//! `meshkv/5.11-client-sdk` is the step where the client stops being an example and becomes a
+//! product. The rules are all established by now — the leader (`5.7`), the idempotency key
+//! (`5.8`), the session (`5.8`), the state machine's digest (`5.10`) — and the SDK is where they
+//! are assembled into an API that a caller can use without knowing any of them.
+//!
+//! Three things make an SDK more than a thin wrapper, and each is a decision:
+//!
+//! * **the error type is the contract.** A caller has to be able to tell "not the leader, ask
+//!   `n2`" from "the cluster is unreachable" from "the write was refused", because the three have
+//!   different remedies: retry elsewhere, retry later, or do not retry at all. An `Error::Io` with
+//!   a string is a contract that says nothing.
+//! * **the retries are the SDK's, not the caller's.** Following a redirect, retrying a timeout with
+//!   the same idempotency key, and stopping after a bound are one policy — and a policy in the SDK
+//!   is a policy every caller gets. The alternative is every caller inventing its own, and one of
+//!   them forgetting the key.
+//! * **a write that was applied is a success, however many times it was asked.** The SDK is where
+//!   `5.8`'s duplicate answer becomes an ordinary "ok": the caller asked for a write, the write
+//!   exists, and whether it took one attempt or three is not part of the answer.
+//!
+//! The backend is a trait, because the SDK's subject is the *policy* — retries, keys, errors — not
+//! the transport. `conformance@2` holds the SDK to two implementations of it: a scripted one that
+//! answers from a table, and an in-process one that runs the real state machine. A policy that
+//! works against one and breaks against the other is a policy that has not been tested.
+
+use crate::error::Error;
+use crate::idempotency::{IdempotencyKey, Outcome, Session};
+use crate::raft::Index;
+
+/// How many attempts a call may take before the SDK gives up.
+pub const MAX_ATTEMPTS: usize = 4;
+
+/// What a caller has to be able to tell apart.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum SdkError {
+    /// The node that answered is not the leader; the caller may retry, and the SDK will.
+    #[error("not the leader: {}", leader.as_deref().unwrap_or("nobody named"))]
+    NotLeader {
+        /// The leader the node named, when it named one.
+        leader: Option<String>,
+    },
+    /// The cluster is unreachable, or answered something the SDK cannot classify.
+    #[error("the cluster is unavailable: {detail}")]
+    Unavailable {
+        /// What went wrong, phrased for a caller who cannot fix it.
+        detail: String,
+    },
+    /// The write was refused: retrying will not help.
+    #[error("the write was refused: {reason}")]
+    Refused {
+        /// Why the store refused it.
+        reason: String,
+    },
+    /// The SDK gave up after [`MAX_ATTEMPTS`] attempts.
+    #[error("gave up after {attempts} attempt(s): {last}")]
+    RetriesExhausted {
+        /// How many attempts were made.
+        attempts: usize,
+        /// The last refusal.
+        last: String,
+    },
+}
+
+impl SdkError {
+    /// `true` when retrying the same call might succeed.
+    #[must_use]
+    pub fn is_retryable(&self) -> bool {
+        todo!("meshkv/5.11-client-sdk: SdkError::is_retryable")
+    }
+}
+
+/// What one call to a backend answers.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Reply {
+    /// The write was applied at this index (or was already, with this answer).
+    Applied {
+        /// Where it sits in the log.
+        index: Index,
+        /// The value the write produced, if it produced one.
+        value: Option<Vec<u8>>,
+    },
+    /// The node is not the leader; the SDK will try the one it names.
+    Redirect {
+        /// The leader the node knows of.
+        leader: String,
+    },
+    /// The node knows no leader: an election is probably running.
+    NoLeader,
+    /// The write was refused, and retrying will not change that.
+    Refused {
+        /// Why.
+        reason: String,
+    },
+}
+
+/// One implementation of "talk to the cluster".
+///
+/// The trait is the seam `conformance@2` uses: the same SDK suite runs against every implementation
+/// of it, and an SDK that passes against one and breaks against another has a policy the second
+/// implementation can see through.
+pub trait Backend {
+    /// Send one write to `node`, with its idempotency key.
+    ///
+    /// # Errors
+    ///
+    /// [`SdkError::Unavailable`] when the node cannot be reached at all — a node that is down is a
+    /// different thing from a node that is not the leader, and the SDK retries them differently.
+    fn write(
+        &mut self,
+        node: &str,
+        key: &IdempotencyKey,
+        command: &[u8],
+    ) -> std::result::Result<Reply, SdkError>;
+
+    /// Send one read to `node`.
+    ///
+    /// # Errors
+    ///
+    /// [`SdkError::Unavailable`] when the node cannot be reached.
+    fn read(&mut self, node: &str, key: &str) -> std::result::Result<Reply, SdkError>;
+}
+
+/// A boxed backend is a backend: the SDK is generic over the trait, and a caller that picks the
+/// implementation at run time (a suite that runs once per backend, say) should not have to write
+/// this by hand.
+impl Backend for Box<dyn Backend> {
+    fn write(
+        &mut self,
+        node: &str,
+        key: &IdempotencyKey,
+        command: &[u8],
+    ) -> std::result::Result<Reply, SdkError> {
+        let _ = (node, key, command);
+        todo!("meshkv/5.11-client-sdk: Backend::write")
+    }
+
+    fn read(&mut self, node: &str, key: &str) -> std::result::Result<Reply, SdkError> {
+        let _ = (node, key);
+        todo!("meshkv/5.11-client-sdk: Backend::read")
+    }
+}
+
+/// A client of the cluster, with the retry policy that makes it usable.
+#[derive(Debug, Clone)]
+pub struct Sdk<B> {
+    backend: B,
+    session: Session,
+    node: String,
+    attempts: usize,
+}
+
+impl<B: Backend> Sdk<B> {
