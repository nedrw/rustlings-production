+# The implementations of the SDK's backend port, in the order the gate runs them.
+#
+# `conformance@2` runs the step's own suite once per name below, with `KILN_BACKEND` set to it, and
+# `tests/support/mod.rs` turns the name into an implementation. The two are deliberately different
+# in kind: a scripted table (the smallest thing that satisfies the port) and the in-process cluster
+# (the real Raft, state machine and ledger). A suite that passes on one and fails on the other is
+# the bug the gate exists to find.
+backends = ["scripted", "in-process"]
