+//! The instrument for `meshkv/5.16-chaos-injection`: the matrix, one row at a time.
+//!
+//! Course content, shipped by the step's scaffold. Each row of the matrix (`src/chaos.rs`) names a
+//! fault; this harness builds a one-fault scenario for it, runs it under the seed, and prints what a
+//! client saw — which is the matrix's "client sees" column, made observable.
+//!
+//! The seed decides where the un-named writes go, so the transcript changes with it; what does not
+//! change is the verdict per row: a write sent to the isolated or crashed node is refused, and the
+//! writes that can reach a majority commit.
+
+use meshkv::chaos::{MATRIX, check};
+use meshkv::sim::{Playbook, run};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+/// The scenario for one fault, as text.
+fn scenario(fault: &str) -> &'static str {
+    match fault {
+        "partition" => {
+            "\
+partition n2 n1
+partition n2 n3
+write@n2 a 1
+heal n2 n1
+heal n2 n3
+write b 2
+write c 3
+write d 4
+"
+        }
+        "crash" => {
+            "\
+crash n2
+write@n2 a 1
+restart n2
+write b 2
+write c 3
+write d 4
+"
+        }
+        "drop" => {
+            "\
+drop 1
+write a 1
+write b 2
+write c 3
+write d 4
+"
+        }
+        "restart" => {
+            "\
+write@n1 a 1
+write b 2
+write c 3
+write d 4
+"
+        }
+        _ => "",
+    }
+}
+
+#[test]
+fn every_row_of_the_matrix_is_exercised_under_every_schedule() {
+    let seed = seed();
+    check().expect("the course's matrix is a matrix");
+    println!("meshkv-sim seed={seed}");
+    println!("meshkv-sim rows={}", MATRIX.len());
+
+    for case in MATRIX {
+        let text = scenario(case.fault);
+        assert!(
+            !text.is_empty(),
+            "the matrix names `{}` and this harness has no scenario for it",
+            case.fault
+        );
+        let playbook = Playbook::parse(text).expect("the scenario parses");
+        let transcript = run(seed, 3, &playbook).expect("the run");
+        let refused = transcript
+            .events()
+            .iter()
+            .filter(|event| event.contains("refused"))
+            .count();
+        let committed = transcript
+            .events()
+            .iter()
+            .filter(|event| event.contains("committed=") && !event.contains("committed=0"))
+            .count();
+        println!(
+            "meshkv-sim fault={} refused={refused} committed={committed} digest={}",
+            case.fault,
+            transcript.digest()
+        );
+        // Every row has an observable client verdict: something was refused or something committed.
+        assert!(
+            refused + committed > 0,
+            "`{}` produced no observable verdict: {:?}",
+            case.fault,
+            transcript.events()
+        );
+    }
+}
