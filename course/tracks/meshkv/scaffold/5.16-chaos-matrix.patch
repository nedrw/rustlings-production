+#![allow(dead_code)]
+// the stub keeps the values the implementation will read; the reference
+// solution drops the allowance, because by then every one is used.
+
+//! The chaos matrix: every fault, and the behaviour it must produce.
+//!
+//! `meshkv/5.16-chaos-injection` is the step that stops treating faults one at a time. `5.13` gave
+//! them a vocabulary, `5.14` and `5.15` asserted two of them in depth; this step asks the question a
+//! runbook asks — **for every fault, what is the expected behaviour?** — and writes the answer down
+//! as a **matrix**.
+//!
+//! The matrix is data, and it is checked from both sides. The code holds the cases; the project's
+//! page holds the same table; the spec compares them. That is `lakelet/4.3`'s trick (the decision is
+//! a value and a sentence, and the spec checks the two agree) applied to a fault catalogue — and it
+//! matters for the same reason: a page that drifts from the code is a page an operator trusts about
+//! behaviour nobody implements.
+//!
+//! Every row has three parts, because a fault is only understood when all three are answered:
+//!
+//! * **what is injected** — the fault, in `5.13`'s vocabulary;
+//! * **what a client sees** — the sentence the operator would say: writes are refused, reads are
+//!   served, and so on;
+//! * **what must still hold** — the invariant the cluster keeps whatever the fault does.
+
+use crate::error::Result;
+
+/// One row of the matrix.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Case {
+    /// The fault, as `5.13` names it.
+    pub fault: &'static str,
+    /// What a client sees while it is injected.
+    pub client_sees: &'static str,
+    /// What the cluster must still hold.
+    pub invariant: &'static str,
+}
+
+/// The matrix: one row per fault this project injects.
+///
+/// The order is the order of the page's table, and the spec compares the two row by row. A fault
+/// that is added here has to be added there, and a sentence that changes on one side has to change on
+/// the other — which is the whole point of keeping the matrix as data.
+pub const MATRIX: [Case; 4] = [
+    Case {
+        fault: "partition",
+        client_sees: "writes sent to the isolated side are refused; the majority side keeps committing",
+        invariant: "a committed write stays committed on every node once the link heals",
+    },
+    Case {
+        fault: "crash",
+        client_sees: "writes sent to the crashed node are refused until it restarts",
+        invariant: "the crashed node catches up from the log when it comes back",
+    },
+    Case {
+        fault: "drop",
+        client_sees: "the dropped messages are lost; the client retries with the same idempotency key",
+        invariant: "the retry is not a second write",
+    },
+    Case {
+        fault: "restart",
+        client_sees: "the node is unavailable for the length of the restart, then serves again",
+        invariant: "a rolling restart never leaves fewer than a majority up",
+    },
+];
+
+/// `true` when `fault` is one the matrix covers.
+#[must_use]
+pub fn covers(fault: &str) -> bool {
+    let _ = fault;
+    todo!("meshkv/5.16-chaos-matrix: covers")
+}
+
+/// The case for `fault`, if the matrix has one.
+#[must_use]
+pub fn case_for(fault: &str) -> Option<&'static Case> {
+    let _ = fault;
+    todo!("meshkv/5.16-chaos-matrix: case_for")
+}
+
+/// Check the matrix against itself, and answer why it is not a matrix if it is not.
+///
+/// A matrix with a duplicate row is a fault somebody forgot; a row with an empty sentence is a cell
+/// nobody filled in; a row whose invariant is a restatement of what the client sees is two columns
+/// for one fact.
+///
+/// # Errors
+///
+/// [`Error::Invalid`] naming the row that failed.
+pub fn check() -> Result<()> {
