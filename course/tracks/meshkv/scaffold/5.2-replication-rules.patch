+/// The four rules the project's page has to name, in order.
+///
+/// The spec compares these strings against `docs/consensus.md`: a page that drifts from the rules
+/// the code relies on is the exact failure this step is about, in documentation form.
+pub const RULES: [&str; 4] = [
+    "a write is an entry: a term and a position",
+    "a log is a prefix: no gaps, and no term going backwards",
+    "a majority decides: more than half of the nodes hold it",
+    "only an entry of the current term commits",
+];
+
+/// One failure the protocol has to be designed against, and what it must do instead.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Failure {
+    /// The failure, in the words the page's table uses.
+    pub scenario: &'static str,
+    /// What the system must do when it happens.
+    pub expected: &'static str,
+}
+
+/// The catalogue the page's table has to match, row for row.
+pub const FAILURES: [Failure; 5] = [
+    Failure {
+        scenario: "the leader dies mid-append",
+        expected: "the next leader wins with a higher term, and the entry is either on a majority and commits, or is not and is dropped",
+    },
+    Failure {
+        scenario: "two nodes claim one term",
+        expected: "each needs a majority, majorities intersect, so one sees the other's higher term and steps down",
+    },
+    Failure {
+        scenario: "a follower's log diverges",
+        expected: "the leader overwrites the suffix from the first mismatching index; a committed entry never mismatches",
+    },
+    Failure {
+        scenario: "a message arrives late, from an old term",
+        expected: "it is refused by its term before its content is read",
+    },
+    Failure {
+        scenario: "a majority is unreachable",
+        expected: "nothing commits: the cluster stops rather than half-writing",
+    },
+];
