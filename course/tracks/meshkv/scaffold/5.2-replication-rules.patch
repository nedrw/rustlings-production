+/// One write, as the log keeps it: the term that proposed it, where it sits, and what it carries.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Entry {
+    /// The term of the leader that proposed it.
+    pub term: Term,
+    /// Its position, one-based.
+    pub index: Index,
+    /// What the write itself is. Empty in this step: the rules of the log say nothing about what
+    /// an entry carries, and `5.3` is where a replicated write finally has a payload.
+    payload: Vec<u8>,
+}
+
+impl Entry {
+    /// An entry proposed in `term` at `index`, carrying nothing.
