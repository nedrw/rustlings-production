+/// Raft's commit rule, as one predicate at the end of this step.
+///
+/// Committed means: **an entry of the leader's current term** that a **majority** holds. Both
+/// clauses are load-bearing:
+///
+/// * the majority clause is what makes a decision survive the loss of any minority;
+/// * the term clause is what stops a leader from counting a replication of an entry it *inherited* —
+///   an old entry can be present on a majority and still be overwritten, because a majority is only
+///   a promise about entries from the term that asked for it.
+#[must_use]
+pub fn committable(
+    entry: &Entry,
+    current_term: Term,
+    acknowledgements: usize,
+    quorum: Quorum,
+) -> bool {
+    entry.term == current_term && quorum.is_met(acknowledgements)
+}
