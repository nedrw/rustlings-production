+        todo!("meshkv/5.2-replication-rules: Term::new")
+    }
+
+    /// The number, for logging and for a message.
+    #[must_use]
+    pub fn get(self) -> u64 {
+        todo!("meshkv/5.2-replication-rules: Term::get")
+    }
+
+    /// The next term: what a node moves to when it stands for election.
+    #[must_use]
+    pub fn next(self) -> Self {
+        todo!("meshkv/5.2-replication-rules: Term::next")
+    }
+}
