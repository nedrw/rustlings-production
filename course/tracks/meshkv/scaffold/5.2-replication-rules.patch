+/// The append-only log every node keeps, as a value.
+///
+/// Two rules are enforced here rather than documented for later: an entry goes at the next index
+/// (no gaps — a gap is an entry this node never received and cannot pretend about), and terms never
+/// go backwards (the log on the disk is the memory of what this node has already seen).
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Log {
+    /// The index of the last entry this log no longer holds, or zero when it holds everything.
+    ///
+    /// Zero means "nothing has been compacted", and it is also the index before the first entry, so
+    /// the log's first entry is always at `base + 1`.
+    base: Index,
+    entries: Vec<Entry>,
+}
