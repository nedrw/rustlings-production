+//! The instrument for `meshkv/5.10-deterministic-state-machine`: the same log, twice.
+//!
+//! Course content, shipped by the step's scaffold. The scenario is the sentence the step is about,
+//! made executable: **two state machines fed the same entries produce the same digest.** The seed
+//! decides the entries — which keys, which values, which compares — and the transcript is the
+//! digest after each one.
+//!
+//! A digest that depends on anything but the entries fails here in the way it fails in production:
+//! the two machines diverge while both insist they are right, and the difference is the one the
+//! step exists to rule out (a hash map's iteration order, a clock, a random number). The two
+//! machines in this harness are deliberately built differently — one applies as it goes, the other
+//! replays the same log from the beginning — so an implementation that cached anything per-machine
+//! would show up as a mismatch.
+//!
+//! Every line is a count, a name or a digest, never a clock or a path: the same seed prints the
+//! same bytes.
+
+use meshkv::kv::{Command, Kv};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+/// How many entries the log has.
+const ENTRIES: usize = 24;
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+/// A tiny seeded generator: the harness needs a spread of logs, not a good random number.
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+
+    fn below(&mut self, bound: usize) -> usize {
+        (self.next() % bound as u64) as usize
+    }
+}
+
+/// The command the seed picks at this step.
+fn command(rng: &mut Rng, key: char) -> Vec<u8> {
+    let value = format!("v{}", rng.below(1000));
+    match rng.below(3) {
+        0 => Command::Set {
+            key: key.to_string(),
+            value: value.into_bytes(),
+        }
+        .encode(),
+        1 => Command::Cas {
+            key: key.to_string(),
+            expect: format!("v{}", rng.below(1000)).into_bytes(),
+            value: value.into_bytes(),
+        }
+        .encode(),
+        _ => Command::Delete {
+            key: key.to_string(),
+        }
+        .encode(),
+    }
+}
+
+#[test]
+fn the_same_entries_give_the_same_digest_on_a_fresh_machine() {
+    let seed = seed();
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+
+    // The log the seed decides.
+    let keys = ['a', 'b', 'c', 'd'];
+    let mut log: Vec<Vec<u8>> = Vec::new();
+    for _ in 0..ENTRIES {
+        let key = keys[rng.below(keys.len())];
+        log.push(command(&mut rng, key));
+    }
+
+    // One machine applies the log as it goes and prints a digest per entry.
+    let mut live = Kv::new();
+    let mut transcripts: Vec<u64> = Vec::new();
+    for (offset, entry) in log.iter().enumerate() {
+        live.apply(offset as u64 + 1, entry)
+            .expect("the log applies");
+        transcripts.push(live.digest());
+    }
+
+    // The other replays it from nothing: same function, same answer.
+    let mut replayed = Kv::new();
+    for (offset, entry) in log.iter().enumerate() {
+        replayed
+            .apply(offset as u64 + 1, entry)
+            .expect("the log replays");
+    }
+
+    println!("meshkv-sim entries={}", log.len());
+    println!("meshkv-sim digest={}", live.digest());
+    println!("meshkv-sim replay={}", replayed.digest());
+    println!("meshkv-sim keys={}", live.len());
+    println!("meshkv-sim applied={}", live.applied_index());
+
+    assert_eq!(
+        live.digest(),
+        replayed.digest(),
+        "the state is a function of the entries and of nothing else"
+    );
+    assert_eq!(live, replayed, "and the maps agree, not only their digests");
+
+    // The transcript is a function of the seed too: a different seed is a different log.
+    let first = transcripts.first().copied().unwrap_or_default();
+    let last = transcripts.last().copied().unwrap_or_default();
+    println!("meshkv-sim transcript={first:016x}..{last:016x}");
+    assert_eq!(
+        live.applied_index() as usize,
+        ENTRIES,
+        "every entry was applied once"
+    );
+}
