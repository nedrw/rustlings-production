+}
+
+/// What applying one command did.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Applied {
+    /// The key now holds a new value.
+    Written {
+        /// The value it holds.
+        value: Vec<u8>,
+    },
+    /// The key was removed.
+    Removed,
+    /// The key was not there to remove.
+    Absent,
+    /// A compare-and-set did not match: the state is unchanged, and this is what it holds.
+    Mismatch {
+        /// The value the key holds now.
+        holding: Option<Vec<u8>>,
+    },
+}
+
+/// The state: an ordered map from keys to values, plus the last index applied.
+///
+/// Ordered, not hashed: the digest below walks the keys in order, so two nodes holding the same
+/// data produce the same digest. A `HashMap` here would be a correctness bug that only shows up
+/// under a seed.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Kv {
+    map: BTreeMap<String, Vec<u8>>,
+    applied_index: Index,
+}
