+//! The instrument for `meshkv/5.14-partition-drills`: the drill, across schedules.
+//!
+//! Course content, shipped by the step's scaffold. The scenario is the course's drill — `n2` is
+//! isolated from both peers, written to, healed, written to again — and the harness prints the
+//! verdicts the drill draws from each seed's transcript.
+//!
+//! What the seed changes is when the two writes that name no node land; what it does not change is
+//! the sentence: a write sent to an isolated node is refused under every schedule, and the same
+//! write after the heals commits. A drill that only held under one schedule would be a drill that
+//! held by luck.
+
+use meshkv::cluster::NodeId;
+use meshkv::drill::{Drill, built_in};
+use meshkv::sim::{Playbook, run};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+/// The scenario: `n2` isolated, written to, healed, written to again, then two free writes.
+const SCENARIO: &str = "\
+partition n2 n1
+partition n2 n3
+write@n2 a 1
+heal n2 n1
+heal n2 n3
+write@n2 b 2
+write c 3
+write d 4
+";
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+#[test]
+fn the_drill_holds_under_every_schedule() {
+    let seed = seed();
+    let playbook = Playbook::parse(SCENARIO).expect("the course's scenario is a playbook");
+    let drill: Drill = built_in().expect("the course's drill");
+    let transcript = run(seed, 3, &playbook).expect("the run");
+
+    println!("meshkv-sim seed={seed}");
+    println!("meshkv-sim checks={}", drill.checks().len());
+    let mut refused = 0;
+    let mut committed = 0;
+    for event in transcript.events() {
+        if event.starts_with("write ") {
+            println!("meshkv-sim {event}");
+            if event.contains("refused") {
+                refused += 1;
+            }
+            if event.contains("committed=") && !event.contains("committed=0") {
+                committed += 1;
+            }
+        }
+    }
+    println!("meshkv-sim refused={refused} committed={committed}");
+    println!("meshkv-sim digest={}", transcript.digest());
+
+    drill.judge(&transcript).expect("the drill holds");
+    assert_eq!(refused, 1, "the write sent to the isolated node is refused");
+    assert!(committed >= 1, "and the writes after the heals commit");
+
+    // The node the drill isolates is the one the scenario isolates.
+    assert_eq!(NodeId::parse("n2").expect("a name").as_str(), "n2");
+}
