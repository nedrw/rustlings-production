+/// One thing a drill checks about a transcript.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Check {
+    /// The run attempted at least `count` writes, committed or not.
+    Attempted {
+        /// How many.
+        count: usize,
+    },
+    /// Every write sent to `node` while it was cut from all of its peers was refused.
+    RefusedWhileIsolated {
+        /// The node the drill isolates.
+        node: NodeId,
+    },
+    /// At least `count` writes sent to `node` committed while it could reach a majority.
+    CommittedWhileConnected {
+        /// The node the drill writes to.
+        node: NodeId,
+        /// How many commits it requires.
+        count: usize,
+    },
+}
