+//! The instrument for `meshkv/5.4-snapshots`: what a snapshot saves.
+//!
+//! Course content, shipped by the step's scaffold. The gate that reads it is `bench-budget`, and
+//! what it judges is not a time but a **count**: how many entries the log held before the snapshot
+//! and how many it holds after it. A count is the same number on a loaded machine as on an idle
+//! one, which is why this lane judges counts at all (handoff M2 §1.1).
+//!
+//! The scenario is the boring one on purpose: a log of a thousand entries, a snapshot at the
+//! halfway point, and the log compacted to it. The two numbers that matter are the entries the
+//! snapshot replaced and the entries the log still holds — and the *ratio* between them, which is
+//! what tells a reader whether compaction is doing anything at all.
+
+use meshkv::cluster::NodeId;
+use meshkv::raft::message::LogPosition;
+use meshkv::raft::snapshot::Snapshot;
+use meshkv::raft::state::Raft;
+use meshkv::raft::{Entry, Index, Term};
+
+/// How many entries the log holds before the snapshot.
+const ENTRIES: usize = 1_000;
+
+/// Where the snapshot is taken, in entries.
+const AT: usize = 600;
+
+/// A node whose log holds `ENTRIES` entries of term 1.
+fn node() -> Raft {
+    let mut node = Raft::new(
+        NodeId::parse("n1").expect("a valid name"),
+        vec![
+            NodeId::parse("n1").expect("a valid name"),
+            NodeId::parse("n2").expect("a valid name"),
+            NodeId::parse("n3").expect("a valid name"),
+        ],
+    );
+    for index in 1..=ENTRIES as Index {
+        let _ = node.on_message(
+            &NodeId::parse("n2").expect("a valid name"),
+            meshkv::raft::message::Message::Append {
+                term: Term::new(1),
+                leader: NodeId::parse("n2").expect("a valid name"),
+                prev: if index == 1 {
+                    LogPosition::empty()
+                } else {
+                    LogPosition {
+                        term: Term::new(1),
+                        index: index - 1,
+                    }
+                },
+                entries: vec![Entry::new(Term::new(1), index)],
+                commit: index,
+            },
+        );
+    }
+    node
+}
+
+#[test]
+fn a_snapshot_removes_the_entries_it_replaced() {
+    let mut node = node();
+    assert_eq!(node.log().len(), ENTRIES);
+
+    let snapshot = Snapshot::new(AT as Index, Term::new(1), vec![b's'; 64]).expect("a snapshot");
+    let dropped = node.compact(&snapshot).expect("the log holds that entry");
+
+    // The counts the gate reads.
+    println!("meshkv-budget entries_before={ENTRIES}");
+    println!("meshkv-budget entries_dropped={dropped}");
+    println!("meshkv-budget entries_after={}", node.log().len());
+    println!(
+        "meshkv-budget kept_ratio={:.4}",
+        node.log().len() as f64 / ENTRIES as f64
+    );
+    println!("meshkv-budget snapshot_bytes={}", snapshot.bytes());
+
+    assert_eq!(dropped, AT, "the snapshot replaced the entries before it");
+    assert_eq!(node.log().len(), ENTRIES - AT, "and the log holds the rest");
+    assert_eq!(node.log().base(), AT as Index, "at the snapshot's index");
+}
