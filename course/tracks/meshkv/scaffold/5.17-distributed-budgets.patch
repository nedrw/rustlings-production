+//! The instrument for `meshkv/5.17-distributed-budgets`: the counts of a workload.
+//!
+//! Course content, shipped by the step's scaffold. The `bench-budget` gate reads the
+//! `meshkv-budget <name>=<value>` lines this prints and compares them with the course's baseline
+//! (`budget/5.17-distributed-budgets.toml`). Every number is a count: messages, acknowledgements,
+//! round trips — never a time.
+
+use meshkv::budget::workload;
+
+/// The cluster and the workload the budget is measured on.
+const NODES: usize = 5;
+const WRITES: usize = 1_000;
+
+#[test]
+fn the_workload_costs_what_the_model_says() {
+    let counts = workload(NODES, WRITES).expect("a workload");
+
+    println!("meshkv-budget nodes={NODES}");
+    println!("meshkv-budget writes={WRITES}");
+    println!("meshkv-budget messages={}", counts.messages);
+    println!("meshkv-budget acks={}", counts.acks);
+    println!("meshkv-budget leader_messages={}", counts.leader_messages);
+    println!(
+        "meshkv-budget follower_messages={}",
+        counts.follower_messages
+    );
+    println!("meshkv-budget hops={}", counts.hops);
+    println!(
+        "meshkv-budget per_node_milli={}",
+        (counts.per_node().expect("a share") * 1000.0).round() as u64
+    );
+    println!(
+        "meshkv-budget leader_share_permille={}",
+        (counts.leader_messages as f64 / counts.messages as f64 * 1000.0).round() as u64
+    );
+
+    // A five-node cluster sends four messages per write and waits for two of them: the quorum is
+    // three, the leader is one of the three, and the other two are the acknowledgements.
+    assert_eq!(counts.messages, 4 * WRITES);
+    assert_eq!(counts.acks, 2 * WRITES);
+    assert_eq!(counts.leader_messages, counts.messages);
+    assert_eq!(counts.follower_messages, WRITES);
+}
