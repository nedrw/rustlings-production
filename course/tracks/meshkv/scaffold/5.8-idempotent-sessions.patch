+/// What a leader does with a request that carries a key.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Outcome {
+    /// The write was applied now, and this is its answer.
+    Applied {
+        /// The position the write took, if the leader knows one.
+        index: Option<u64>,
+    },
+    /// The key was seen before: the write was *not* applied again, and this is the original answer.
+    Duplicate {
+        /// The answer the leader gave the first time.
+        answer: Vec<u8>,
+    },
+}
