+//! The instrument for `meshkv/5.18-cluster-observability`: the counters an SLO is computed from.
+//!
+//! Course content, shipped by the step's scaffold. The `bench-budget` gate reads the
+//! `meshkv-budget <name>=<value>` lines this prints: the lag counters, the flapping counters, and the
+//! error budget for a fixed window. Every number is a count.
+
+use meshkv::cluster::NodeId;
+use meshkv::metrics::{NodeMetrics, Slo};
+
+fn node(text: &str) -> NodeId {
+    NodeId::parse(text).expect("a valid name")
+}
+
+#[test]
+fn the_counters_and_the_budget_are_the_numbers_the_page_states() {
+    let mut metrics = NodeMetrics::new();
+    metrics.record_peer(node("n2"), 990);
+    metrics.record_peer(node("n3"), 950);
+    metrics.elections_stood = 4;
+    metrics.elections_won = 4;
+    metrics.commits = 9_998;
+    metrics.refusals = 2;
+    metrics.applied = 1_000;
+
+    let lag_two = metrics.lag(&node("n2"), 1_000).expect("a lag");
+    let lag_three = metrics.lag(&node("n3"), 1_000).expect("a lag");
+    let slo = Slo::new(999_000).expect("an objective");
+    let budget = slo.budget_left(9_998, 10_000).expect("a budget");
+
+    println!("meshkv-budget lag_n2={lag_two}");
+    println!("meshkv-budget lag_n3={lag_three}");
+    println!("meshkv-budget worst_lag_max={}", lag_three.max(lag_two));
+    println!("meshkv-budget lost_elections={}", metrics.lost_elections());
+    println!("meshkv-budget suspect={}", u8::from(metrics.is_suspect()));
+    println!("meshkv-budget commits={}", metrics.commits);
+    println!("meshkv-budget refusals={}", metrics.refusals);
+    println!("meshkv-budget budget_left={budget}");
+    println!(
+        "meshkv-budget budget_broken={}",
+        u8::from(slo.is_broken(9_998, 10_000).expect("a verdict"))
+    );
+
+    assert_eq!(lag_two, 10);
+    assert_eq!(lag_three, 50);
+    assert_eq!(budget, 8, "ten allowed failures minus two");
+    assert!(!metrics.is_suspect());
+}
