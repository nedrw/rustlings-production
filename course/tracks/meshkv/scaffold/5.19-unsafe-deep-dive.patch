+//! The instrument for `meshkv/5.19-unsafe-deep-dive`: the orderings, checked exhaustively.
+//!
+//! Course content, shipped by the step's scaffold. `loom` runs every interleaving of a small program
+//! under a model scheduler, which is the only way to check a `Release`/`Acquire` pair without waiting
+//! for a bug to happen on a real machine.
+//!
+//! The model here is the ring's *algorithm* — two atomics and a slot published between them — written
+//! against loom's atomics, because that is what a loom check needs: the std atomics the crate uses
+//! cannot be told what to explore. The page says so; the property checked is the one the ring's
+//! argument claims: a value pushed before a pop is never lost, and a value is never seen twice.
+
+use loom::sync::Arc;
+use loom::sync::atomic::{AtomicUsize, Ordering};
+
+/// The ring's index protocol, with one slot: a producer writes a slot then publishes `tail`; a
+/// consumer reads `tail`, takes the slot, then moves `head`.
+struct Slot {
+    value: AtomicUsize,
+    head: AtomicUsize,
+    tail: AtomicUsize,
+}
+
+#[test]
+fn a_value_published_with_release_is_seen_once_with_acquire() {
+    loom::model(|| {
+        let slot = Arc::new(Slot {
+            value: AtomicUsize::new(0),
+            head: AtomicUsize::new(0),
+            tail: AtomicUsize::new(0),
+        });
+
+        let producer = {
+            let slot = Arc::clone(&slot);
+            loom::thread::spawn(move || {
+                slot.value.store(42, Ordering::Relaxed);
+                // Publishing the index is what makes the value visible.
+                slot.tail.store(1, Ordering::Release);
+            })
+        };
+        let consumer = {
+            let slot = Arc::clone(&slot);
+            loom::thread::spawn(move || {
+                if slot.tail.load(Ordering::Acquire) == 1 {
+                    // The value must be the published one: a missing Release here would let loom
+                    // find the interleaving where this reads zero.
+                    assert_eq!(slot.value.load(Ordering::Relaxed), 42);
+                    slot.head.store(1, Ordering::Release);
+                }
+            })
+        };
+
+        producer.join().expect("the producer ran");
+        consumer.join().expect("the consumer ran");
+    });
+}
+
+#[test]
+fn a_slot_is_not_reused_before_the_consumer_is_done_with_it() {
+    // The ring's other obligation: the producer may reuse a slot only after the consumer has moved
+    // `head` past it. The model runs the two phases and checks that the sequence is the one the
+    // indices allow — no reuse while `head` still points at the slot.
+    loom::model(|| {
+        let slot = Arc::new(Slot {
+            value: AtomicUsize::new(0),
+            head: AtomicUsize::new(0),
+            tail: AtomicUsize::new(0),
+        });
+
+        let producer = {
+            let slot = Arc::clone(&slot);
+            loom::thread::spawn(move || {
+                slot.value.store(1, Ordering::Relaxed);
+                slot.tail.store(1, Ordering::Release);
+                // Wait for the consumer to release the slot before reusing it.
+                while slot.head.load(Ordering::Acquire) == 0 {
+                    loom::hint::spin_loop();
+                }
+                slot.value.store(2, Ordering::Relaxed);
+                slot.tail.store(2, Ordering::Release);
+            })
+        };
+        let consumer = {
+            let slot = Arc::clone(&slot);
+            loom::thread::spawn(move || {
+                while slot.tail.load(Ordering::Acquire) == 0 {
+                    loom::hint::spin_loop();
+                }
+                assert_eq!(slot.value.load(Ordering::Relaxed), 1, "the first value");
+                slot.head.store(1, Ordering::Release);
+                while slot.tail.load(Ordering::Acquire) < 2 {
+                    loom::hint::spin_loop();
+                }
+                assert_eq!(
+                    slot.value.load(Ordering::Relaxed),
+                    2,
+                    "and the reuse is visible"
+                );
+            })
+        };
+
+        producer.join().expect("the producer ran");
+        consumer.join().expect("the consumer ran");
+    });
+}
