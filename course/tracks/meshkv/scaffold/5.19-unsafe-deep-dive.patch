+//! A hand-rolled ring buffer: `unsafe` where it pays, and the argument for every block.
+//!
+//! `meshkv/5.19-unsafe-deep-dive` is the one step of this track that is allowed to use `unsafe`. Up
+//! to here the crate denied it (`unsafe_code = "deny"` in the scaffold), and that was the right
+//! default: none of the previous steps needed it. This step needs it for one reason: a **bounded
+//! queue whose head and tail are read by a producer and a consumer on different threads** is the case
+//! where the safe version costs the thing a queue exists to save.
+//!
+//! The structure is a single-producer, single-consumer ring of `MaybeUninit<T>`, and it has exactly
+//! three unsafe obligations — initialisation, exclusive access, and dropping each value exactly once.
+//! Each is named where it is discharged, and each block says which one it rests on with a
+//! `// SAFETY:` note. The page (`docs/unsafe.md`) is the whole argument; this file is where it is
+//! carried out.
+//!
+//! The orderings are the part that is easy to get wrong and hard to see: the producer publishes a
+//! written slot with `Release`, the consumer observes it with `Acquire`, and the indices are
+//! `Relaxed` only where the value they order is not read. `loom` (the step's harness) is what turns
+//! that argument into a check. `miri` is not available on this course's pinned toolchain, and the
+//! page says so.
+
+#![allow(dead_code)] // the stub keeps the structure the implementation will fill; the reference
+// solution drops the allowance.
+
+use std::cell::UnsafeCell;
+use std::mem::MaybeUninit;
+use std::sync::atomic::AtomicUsize;
+
+/// A bounded single-producer, single-consumer queue.
+///
+/// The capacity is the number of slots and is fixed at construction. One producer and one consumer
+/// may use it concurrently; more than that is a misuse the type does not detect, and the page says
+/// so.
+pub struct Ring<T> {
+    slots: Box<[UnsafeCell<MaybeUninit<T>>]>,
+    head: AtomicUsize,
+    tail: AtomicUsize,
+}
+
+impl<T> Ring<T> {
+    /// A queue of `capacity` slots.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when the capacity is zero: a queue with no slot can never hold anything.
+    pub fn new(capacity: usize) -> crate::error::Result<Self> {
+        let _ = capacity;
+        todo!("meshkv/5.19-unsafe-deep-dive: Ring::new")
+    }
+
+    /// How many slots the queue has.
+    #[must_use]
+    pub fn capacity(&self) -> usize {
+        self.slots.len()
+    }
+
+    /// How many values it holds. A hint: the number is read from two atomics, so it is a snapshot.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        todo!("meshkv/5.19-unsafe-deep-dive: Ring::len")
+    }
+
+    /// `true` when it holds nothing, according to the same snapshot.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
