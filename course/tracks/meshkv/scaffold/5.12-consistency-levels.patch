+//! The instrument for `meshkv/5.12-consistency-levels`: the same three nodes, read three ways.
+//!
+//! Course content, shipped by the step's scaffold. The scenario is the dial: a cluster whose nodes
+//! are at different applied indices, and one read per node per level. What the seed decides is the
+//! order the reads happen in — and, because the nodes' indices are drawn from it too, which node is
+//! furthest behind. What it does not decide is the *verdict* for a level at a given lag, because
+//! that is the contract.
+//!
+//! The transcript is the `meshkv-sim <name>=<value>` lines below: names, counts and verdicts, never
+//! a clock or a path.
+
+use meshkv::cluster::NodeId;
+use meshkv::consistency::{Answer, Level, answer};
+
+/// The variable the `sim` gate sets the seed with.
+const SEED: &str = "KILN_SIM_SEED";
+
+fn seed() -> u64 {
+    std::env::var(SEED)
+        .ok()
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .unwrap_or(1)
+}
+
+fn id(text: &str) -> NodeId {
+    NodeId::parse(text).expect("a valid name")
+}
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+
+    fn below(&mut self, bound: usize) -> usize {
+        (self.next() % bound as u64) as usize
+    }
+}
+
+#[test]
+fn each_level_answers_what_it_promises_and_refuses_what_it_cannot() {
+    let seed = seed();
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+    let commit = 40u64;
+    let leader = id("n1");
+
+    // Three nodes, at applied indices the seed picks below the commit.
+    let mut nodes: Vec<(&str, u64)> = vec![
+        ("n1", commit - rng.below(5) as u64),
+        ("n2", commit - rng.below(20) as u64),
+        ("n3", commit - rng.below(20) as u64),
+    ]
+    .into_iter()
+    .collect::<Vec<_>>();
+    nodes.sort_by_key(|(_, applied)| *applied);
+    println!(
+        "meshkv-sim applied behind={}",
+        commit - nodes.first().map(|(_, applied)| *applied).unwrap_or(commit)
+    );
+
+    // Linearizable: only the leader, and only with a lease.
+    let served = answer(
+        Level::Linearizable,
+        true,
+        Some(commit),
+        commit,
+        Some(commit),
+        None,
+    );
+    println!(
+        "meshkv-sim linearizable_leader served={}",
+        u8::from(served.is_served())
+    );
+    let follower = answer(
+        Level::Linearizable,
+        false,
+        None,
+        commit,
+        Some(commit),
+        Some(&leader),
+    );
+    println!(
+        "meshkv-sim linearizable_follower served={}",
+        u8::from(follower.is_served())
+    );
+    assert!(served.is_served(), "the leader with a lease serves it");
+    assert!(!follower.is_served(), "a follower refuses it");
+
+    // Bounded-stale over every node: served exactly when the lag fits.
+    for (name, applied) in &nodes {
+        let lag = commit - applied;
+        let within = answer(
+            Level::BoundedStale { max_lag: 5 },
+            false,
+            None,
+            *applied,
+            Some(commit),
+            Some(&leader),
+        );
+        println!(
+            "meshkv-sim bounded peer={name} lag={lag} served={}",
+            u8::from(within.is_served())
+        );
+        assert_eq!(
+            within.is_served(),
+            lag <= 5,
+            "the bound is the verdict: {name} is {lag} behind"
+        );
+        if let Answer::Served { index } = within {
+            assert_eq!(
+                index, *applied,
+                "an answered read names the position it is correct at"
+            );
+        }
+    }
+
+    // Local: every node answers, whatever its lag.
+    for (name, applied) in &nodes {
+        let local = answer(
+            Level::Local,
+            false,
+            None,
+            *applied,
+            Some(commit),
+            Some(&leader),
+        );
+        println!(
+            "meshkv-sim local peer={name} index={}",
+            match local {
+                Answer::Served { index } => index,
+                Answer::Refused { .. } => 0,
+            }
+        );
+        assert!(local.is_served(), "a local read promises only this node");
+    }
+}
