+#![allow(dead_code)]
+// the stub keeps the values the implementation will read; the reference
+// solution drops the allowance, because by then every one is used.
+
+//! Consistency is a dial: what each level promises, and what it costs.
+//!
+//! `meshkv/5.6-lease-reads` gave one answer: a leader with a lease may serve a read, and it is
+//! linearizable. That is the strongest promise and the most expensive one — every read needs the
+//! leader, and the leader is one node out of three.
+//!
+//! Most reads do not need that. A dashboard that refreshes every ten seconds does not care whether
+//! it sees the write that landed one millisecond ago; a cache warmer does not care about a second
+//! of staleness; a debugging tool wants *some* answer quickly and will say so. The dial is how a
+//! caller says what it needs, and the three levels here are the ones every replicated store offers:
+//!
+//! * [`Level::Linearizable`]: the answer is correct as of a moment after the read began. It needs
+//!   the leader (`5.6`), and it is the only level that can be served by one node.
+//! * [`Level::BoundedStale`]: the answer is at most `max_lag` entries behind the cluster's commit.
+//!   Any node that can show it is within the bound may answer — a follower with a fresh enough
+//!   state, which spreads the read load off the leader.
+//! * [`Level::Local`]: the answer is whatever this node has applied. No bound at all; useful when
+//!   the caller is asking about *this node* (an operator's view, a test, a cache fill).
+//!
+//! The interesting part is not the enum. It is that **each level has to be refused when it cannot be
+//! honoured**: a follower asked for linearizable reads has to say so rather than answer from its
+//! own state, and a node asked for bounded-stale has to be able to *show* its lag rather than assume
+//! it. A level that is silently downgraded is worse than a level that is refused, because the caller
+//! never learns which promise it got.
+//!
+//! The lag is an argument, not a measurement the module makes itself: a node knows its applied index
+//! and learns the leader's commit index from the leader's messages (`5.3`), and the caller passes
+//! both. That keeps the module free of time and of the network, for the same reason every other
+//! module here is.
+
+use crate::cluster::NodeId;
+use crate::error::Result;
+use crate::raft::Index;
+
+/// How fresh a read has to be.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Level {
+    /// Correct as of a moment after the read began: the leader's lease (`5.6`).
+    Linearizable,
+    /// At most `max_lag` entries behind the cluster's commit.
+    BoundedStale {
+        /// The largest lag, in entries, this read may accept.
+        max_lag: Index,
+    },
+    /// Whatever this node has applied. No promise about staleness at all.
+    Local,
+}
+
+impl Level {
+    /// Parse `linearizable`, `bounded-stale:<entries>` or `local`.
+    ///
+    /// # Errors
+    ///
+    /// [`Error::Invalid`] when the text is not one of the three, or when a bound is not a number.
+    pub fn parse(text: &str) -> Result<Self> {
+        let _ = text;
+        todo!("meshkv/5.12-consistency-levels: Level::parse")
+    }
+
+    /// The level as it is written.
+    #[must_use]
+    pub fn render(self) -> String {
+        todo!("meshkv/5.12-consistency-levels: Level::render")
+    }
+
+    /// `true` when the level is the strongest one.
+    #[must_use]
+    pub fn is_linearizable(self) -> bool {
+        todo!("meshkv/5.12-consistency-levels: Level::is_linearizable")
+    }
+}
+
+/// What a node answers a read at a level with.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Answer {
+    /// The answer is correct at this index (the promise is the level that was asked for).
+    Served {
+        /// The position the answer is correct at.
+        index: Index,
+    },
+    /// The level cannot be honoured here, and this is why.
+    Refused {
+        /// What would have to change for this node to answer.
+        reason: String,
+    },
+}
+
+impl Answer {
+    /// `true` when the read was answered.
+    #[must_use]
+    pub fn is_served(&self) -> bool {
+        todo!("meshkv/5.12-consistency-levels: Answer::is_served")
+    }
+}
+
+/// Answer a read at `level`, from one node's view.
+///
+/// * `is_leader`: whether this node is the leader.
+/// * `lease_index`: the index the leader's lease was granted at (`5.6`), if it has one.
+/// * `applied`: how far this node has applied.
+/// * `commit`: the leader's commit index, as this node last heard it — `None` when it has heard of
+///   no leader, which is exactly when a bounded-stale read cannot be shown to be within its bound.
+///
+/// The function is pure: every fact it needs is an argument, including the lag, so a caller can test
+/// the boundary of a level without a cluster.
+#[must_use]
+pub fn answer(
+    level: Level,
+    is_leader: bool,
+    lease_index: Option<Index>,
+    applied: Index,
+    commit: Option<Index>,
+    leader: Option<&NodeId>,
+) -> Answer {
