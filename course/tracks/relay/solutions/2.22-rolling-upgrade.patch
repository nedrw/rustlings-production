+/// Announce the schema this process found, in the line an operator reads before the one that says
+/// where it listens.
+///
+/// The order is the contract `relay/2.22-rolling-upgrade` establishes: the migrations run, the
+/// process says which schema it is on, and only then does it say where it listens. A log whose
+/// listening line came first would be a service that took traffic before it knew whether it could
+/// answer.
+pub fn announce_schema(run: &RunId, schema: &Schema) {
+    tracing::info!(run = %run, schema = %schema, "the schema is in place");
