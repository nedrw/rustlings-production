+-- The work this service owes a subscriber: one row per (event, endpoint).
+--
+-- The row is the unit of a claim (step relay/2.5-atomic-claim) and the unit of an attempt: it holds
+-- the state machine, the failure count, the instant the next attempt may happen, and the lease of
+-- whoever is working on it. `unique (event_id, endpoint_id)` is what makes "one event, one delivery
+-- to this endpoint" a fact rather than a hope: a fan-out that runs twice — a retried request, a
+-- replayed event, two workers racing — must not create a second debt.
+create table deliveries (
+    id uuid primary key,
+    event_id uuid not null references events (id) on delete cascade,
+    endpoint_id uuid not null references endpoints (id) on delete cascade,
+    state text not null default 'pending',
+    attempts integer not null default 0,
+    next_attempt_at timestamptz not null default now(),
+    locked_by text,
+    locked_at timestamptz,
+    lease_expires_at timestamptz,
+    last_error text,
+    created_at timestamptz not null default now(),
+    constraint deliveries_one_per_target unique (event_id, endpoint_id),
+    constraint deliveries_state_known
+        check (state in ('pending', 'claimed', 'sent', 'retrying', 'dead'))
+);
+
+-- The claim runs once per tick and reads the oldest work that is due: this index is in exactly that
+-- order, so a claim is a range scan that stops after `limit` rows. Without it every tick sorts
+-- every delivery this service has ever owed, and the cost of a claim grows with the tenant's
+-- history instead of with the batch.
+create index deliveries_claimable_idx
+    on deliveries (next_attempt_at, id)
+    where state in ('pending', 'retrying');
