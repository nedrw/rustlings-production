+                    .get(end.saturating_add(4)..)
+                    .unwrap_or_default()
+                    .to_vec();
+                return Ok((head, rest));
+            }
+            if raw.len() > MAX_HEAD {
+                return Err("the answer's head is longer than any HTTP head".to_owned());
+            }
+            if self.read_more(stream, &mut raw).await? == 0 {
+                return Err("the connection closed before the answer arrived".to_owned());
+            }
+        }
+    }
