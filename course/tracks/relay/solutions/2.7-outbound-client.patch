+    ///
+    /// Two ways for a body to end, and both are in the wild: a `content-length`, or the close of the
+    /// connection. Reading only the first loses the bodies of every target that uses the second.
+    async fn read_body(
+        &self,
+        stream: &mut TcpStream,
+        status: u16,
+        headers: &[(String, String)],
+        mut body: Vec<u8>,
+    ) -> Result<(Vec<u8>, bool), String> {
+        let closes =
+            header(headers, "connection").is_some_and(|value| value.eq_ignore_ascii_case("close"));
+        // A status that means "there is no body, whatever the headers say".
+        if matches!(status, 204 | 304) || (100..200).contains(&status) {
+            return Ok((Vec::new(), !closes));
+        }
+        match content_length(headers) {
+            Some(length) => {
+                while body.len() < length {
+                    if self.read_more(stream, &mut body).await? == 0 {
+                        return Err(format!(
+                            "the answer promised {length} bytes of body and sent {}",
+                            body.len()
+                        ));
+                    }
+                }
+                body.truncate(length);
+                Ok((body, !closes))
+            }
+            None => {
+                // No length: the end of the body is the end of the connection, so the connection is
+                // finished by definition.
+                loop {
+                    if self.read_more(stream, &mut body).await? == 0 {
+                        return Ok((body, false));
+                    }
+                }
+            }
+        }
+    }
+
+    /// One read, cut at the read deadline: the deadline a target that went quiet runs into.
+    async fn read_more(&self, stream: &mut TcpStream, into: &mut Vec<u8>) -> Result<usize, String> {
+        let mut buffer = [0u8; 4096];
+        match timeout(self.policy.read, stream.read(&mut buffer)).await {
+            Ok(Ok(read)) => {
+                into.extend_from_slice(buffer.get(..read).unwrap_or_default());
+                Ok(read)
+            }
+            Ok(Err(error)) => Err(format!("the connection broke while reading: {error}")),
+            Err(_) => Err(format!(
+                "the subscriber sent nothing for {:?}",
+                self.policy.read
+            )),
+        }
+    }
+
+    /// A connection an earlier answer left open for `authority`, if there is one.
+    fn take_connection(&self, authority: &str) -> Option<TcpStream> {
+        self.connections().get_mut(authority)?.pop()
+    }
+
+    /// Keep `authority`'s connection for the next attempt, up to a small number of them.
+    fn keep_connection(&self, authority: &str, stream: TcpStream) {
+        let mut idle = self.connections();
+        let kept = idle.entry(authority.to_owned()).or_default();
+        if kept.len() < MAX_IDLE {
+            kept.push(stream);
+        }
+        // Anything over the limit is dropped here, which closes it.
+    }
+
+    /// The pool, whether or not another thread panicked while holding it: a poisoned pool is not a
+    /// reason to fail a delivery.
+    fn connections(&self) -> MutexGuard<'_, HashMap<String, Vec<TcpStream>>> {
+        self.idle
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
     }
 }
 
