+/// Connect to an authority, which for an `http` URL without a port means port 80.
+async fn connect_target(authority: &str) -> std::io::Result<TcpStream> {
+    if authority.contains(':') {
+        TcpStream::connect(authority).await
+    } else {
+        TcpStream::connect((authority, DEFAULT_PORT)).await
+    }
+}
+
+/// One request, as bytes: the request line, the headers that are not the connection's business, and
+/// the body.
+fn request_bytes(
+    method: &str,
+    url: &EndpointUrl,
+    authority: &str,
+    headers: &[(String, String)],
+    body: &[u8],
+) -> Vec<u8> {
+    let mut head = format!(
+        "{method} {} HTTP/1.1\r\nhost: {authority}\r\n",
+        path_of(url)
+    );
+    for (name, value) in headers {
+        if is_hop_by_hop(name) {
+            continue;
+        }
+        head.push_str(&format!("{name}: {value}\r\n"));
+    }
+    head.push_str(&format!("content-length: {}\r\n\r\n", body.len()));
+    let mut bytes = head.into_bytes();
+    bytes.extend_from_slice(body);
+    bytes
+}
+
+/// The path (with its query) a request line carries.
+fn path_of(url: &EndpointUrl) -> String {
+    let text = url.as_str();
+    let after_scheme = text.split_once("://").map_or(text, |(_, rest)| rest);
+    match after_scheme.find(['/', '?']) {
+        Some(index) => {
+            let rest = after_scheme.get(index..).unwrap_or("/");
+            if rest.starts_with('/') {
+                rest.to_owned()
+            } else {
+                format!("/{rest}")
+            }
+        }
+        None => "/".to_owned(),
+    }
+}
+
+/// Where a `location` points, resolved against the URL that carried it.
+fn resolve(url: &EndpointUrl, location: &str) -> Result<EndpointUrl, String> {
+    let location = location.trim();
+    let absolute = if location.contains("://") {
+        location.to_owned()
+    } else {
+        let scheme = url
+            .as_str()
+            .split_once("://")
+            .map_or("http", |(scheme, _)| scheme);
+        let authority = url.authority();
+        if location.starts_with('/') {
+            format!("{scheme}://{authority}{location}")
+        } else {
+            let path = path_of(url);
+            let directory = path.rsplit_once('/').map_or("", |(directory, _)| directory);
+            format!("{scheme}://{authority}{directory}/{location}")
+        }
+    };
+    absolute.parse().map_err(|error| {
+        format!(
+            "the redirect points at `{location}`, which this service cannot deliver to: {error}"
+        )
+    })
+}
+
+/// `true` for a header that describes the connection rather than the request.
+fn is_hop_by_hop(name: &str) -> bool {
+    let name = name.trim().to_ascii_lowercase();
+    HOP_BY_HOP.contains(&name.as_str())
+}
+
+/// One header by name, case-insensitively.
+fn header<'a>(headers: &'a [(String, String)], name: &str) -> Option<&'a str> {
+    headers
+        .iter()
+        .find(|(header, _)| header.eq_ignore_ascii_case(name))
+        .map(|(_, value)| value.as_str())
+}
+
+/// The length an answer promised, when it promised one.
+fn content_length(headers: &[(String, String)]) -> Option<usize> {
+    header(headers, "content-length")?.trim().parse().ok()
+}
+
+/// The status and headers of a response head.
+fn parse_head(head: &str) -> Result<(u16, Vec<(String, String)>), String> {
+    let mut lines = head.split("\r\n");
+    let status_line = lines.next().unwrap_or_default();
+    let status = status_line
+        .split_whitespace()
+        .nth(1)
+        .and_then(|code| code.parse().ok())
+        .ok_or_else(|| format!("the answer's status line is not HTTP: `{status_line}`"))?;
+    let headers = lines
+        .filter_map(|line| line.split_once(':'))
+        .map(|(name, value)| (name.trim().to_owned(), value.trim().to_owned()))
+        .collect();
+    Ok((status, headers))
+}
+
+/// Where `needle` sits in `haystack`.
+fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    if needle.is_empty() || haystack.len() < needle.len() {
+        return None;
     }
+    (0..=haystack.len() - needle.len())
+        .find(|start| haystack.get(*start..start + needle.len()) == Some(needle))
 }
