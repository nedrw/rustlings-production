+            // while it sat idle, and this client cannot tell that from any other broken socket. The
+            // attempt is retryable; the pool drops the connection because it is not put back.
+            return Err(format!(
+                "writing the request to {authority} failed: {error}"
+            ));
+        }
+        if let Err(error) = stream.flush().await {
+            return Err(format!(
+                "writing the request to {authority} failed: {error}"
+            ));
+        }
