+
+/// Take up to `limit` pieces of work that belong to one tenant.
+///
+/// The claim of [`claim`], narrowed to a tenant: one statement, the same lease, the same answer, and
+/// one more condition on it. It exists because a *bounded* worker deals its seats out between the
+/// tenants that have work (`relay/2.14-backpressure`): a claim that could not say whose work it
+/// takes could not give every tenant a share, and one tenant's flood would be served until it was
+/// over. The rows are the same rows and the states are the same states, so the statement lives here
+/// with the rest of them — a second file that knows the column names is a second place to forget one.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the claim cannot be written or read back, and
+/// [`Error::Endpoint`] when a claimed row's target is no longer a URL this service accepts.
+pub async fn for_tenant(
+    pool: &PgPool,
+    worker: &str,
+    tenant: Uuid,
+    limit: i64,
+    lease: Duration,
+) -> Result<Vec<Claimed>, Error> {
+    let rows: Vec<Row> = sqlx::query_as(
+        "update deliveries as d \
+            set state = 'claimed', locked_by = $1, locked_at = now(), \
+                lease_expires_at = now() + make_interval(secs => $4::double precision) \
+           from endpoints as e, events as v \
+          where d.endpoint_id = e.id and d.event_id = v.id and e.tenant_id = $3 \
+            and d.id in (select id from deliveries \
+                          where state in ('pending', 'retrying') \
+                            and next_attempt_at <= now() \
+                            and endpoint_id in (select id from endpoints where tenant_id = $3) \
+                          order by next_attempt_at, id \
+                          for update skip locked \
+                          limit $2) \
+         returning d.id, d.attempts, d.next_attempt_at, e.url, v.id, v.tenant_id, v.kind, \
+                   v.payload::text, v.received_at",
+    )
+    .bind(worker)
+    .bind(limit)
+    .bind(tenant)
+    .bind(lease.as_secs_f64())
+    .fetch_all(pool)
+    .await
+    .map_err(Error::Database)?;
+
+    rows.into_iter().map(described_by).collect()
+}
+
+/// One row of a claim's `returning` clause, as the work it describes.
+///
+/// Both claims read the same columns in the same order, and this is the one place that knows what
+/// they mean: a second mapping is a second place for the column order to drift.
+fn described_by(row: Row) -> Result<Claimed, Error> {
+    let (delivery, attempts, due_at, url, event, tenant, kind, payload, received_at) = row;
+    Ok(Claimed {
+        delivery,
+        attempts,
+        due_at,
+        url: url.parse().map_err(Error::Endpoint)?,
+        event: Event {
+            id: event,
+            tenant_id: TenantId::from_uuid(tenant),
+            kind,
+            payload: events::decode_payload(&payload)?,
+            received_at,
+        },
+    })
 }
 
