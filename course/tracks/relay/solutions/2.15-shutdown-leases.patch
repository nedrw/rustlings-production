+    name: &str,
+) -> Result<Option<Duration>, Error> {
+    match read_count(env_layer, file, name)? {
+        None => Ok(None),
+        Some(0) => Err(Error::Config(format!(
+            "`{name}` cannot be zero: that is a lease that expires at once, or a drain that lets              nothing finish"
+        ))),
+        Some(seconds) => Ok(Some(Duration::from_secs(u64::from(seconds)))),
+    }
+}
