@@ -0,0 +1,11 @@
+-- A worker that is killed leaves its rows in `claimed`, and the only thing that brings them back is
+-- `lease_expires_at` (step relay/2.15-shutdown-leases). Recovering them is one `update` over exactly
+-- those rows, so this index is in exactly that shape: partial on `claimed`, keyed on the instant the
+-- lease ends.
+--
+-- Without it that statement walks every delivery this service has ever owed — once per worker, per
+-- turn — and the cost of *recovering* from a crash grows with the tenant's history. With it, the
+-- statement reads the rows that have expired and nothing else.
+create index deliveries_expired_lease_idx
+    on deliveries (lease_expires_at)
+    where state = 'claimed';
