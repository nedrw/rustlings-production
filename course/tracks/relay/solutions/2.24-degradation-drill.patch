+/// The worker's database goes away while it is holding the deliveries it claimed.
+///
+/// What is broken is the connection the worker runs on, which is the failure this service actually
+/// sees when a database fails over or a network partition is closed: the pool it holds is gone, and
+/// the rows it had claimed are stamped with a holder that will never answer. Nothing is lost —
+/// because a claim is a *lease* (`relay/2.15-shutdown-leases`) and the rows are still there.
+async fn database_away(drill: &Drill, recovery: Recovery) -> (usize, String) {
+    drill.register(ACME.1, "database-away");
+    let accepted = drill.accept_many(ACME.1, &keys("database-away", EVENTS));
+    let deliveries = drill.count("select count(*) from deliveries");
+    let seats = u32::try_from(deliveries).unwrap_or(SEATS);
+
+    // The connection the worker runs on, which is about to go away: it claims every delivery — the
+    // work this process is holding — and then the pool is closed under it.
+    let worker_pool = drill.pool().await;
+    let held = concurrency::claim_fair(&worker_pool, "drill-database-away", deliveries, LEASE)
+        .await
+        .expect("the claim runs");
+    assert_eq!(
+        held.len(),
+        usize::try_from(deliveries).unwrap_or(0),
+        "the worker claimed every delivery before its database went away"
+    );
+    worker_pool.close().await;
+
+    // The failure is real before anything is decided about the recovery: every row is held by a
+    // worker whose database is not answering.
+    let held = drill.count("select count(*) from deliveries where state = 'claimed'");
+    assert_eq!(
+        held, deliveries,
+        "the database went away while this worker was holding every row, and the rows say so: a \
+         fixture that had already recovered would prove nothing about either world"
+    );
+
+    match recovery {
+        Recovery::Never => (
+            accepted,
+            format!(
+                "the worker's database never came back: {held} delivery(ies) are stamped with a \
+                 holder that is gone, and nobody will reclaim them until a lease expires"
+            ),
+        ),
+        Recovery::ComesBack => {
+            // The lease is what a worker that is gone leaves behind, and the drill ages it rather
+            // than waiting for one: the deadline is the knob a deployment turns, and sleeping
+            // through a real one would make the drill a sleep rather than a replay.
+            drill.postgres.execute(
+                "update deliveries set lease_expires_at = now() - interval '1 second' \
+                  where state = 'claimed'",
+            );
+            let pool = drill.pool().await;
+            let reclaimed = lease::reclaim_expired(&pool)
+                .await
+                .expect("the reclaim runs");
+            assert_eq!(
+                reclaimed,
+                u64::try_from(deliveries).unwrap_or(0),
+                "the next worker found every row the dead one was holding: this is the recovery, \
+                 and it is the lease that made it possible"
+            );
+            let counted = Arc::new(Counted::new());
+            let report = drill
+                .worker(&pool, seats, &counted)
+                .work(4)
+                .await
+                .expect("the worker runs");
+            (
+                accepted,
+                format!(
+                    "the database came back, {reclaimed} delivery(ies) came back with it, and {} \
+                     attempt(s) were made in {report:?}",
+                    counted.finished()
+                ),
+            )
+        }
+    }
+}
+
+/// The subscriber stops answering, so every attempt that is in flight stays in flight.
+async fn slow_subscriber(drill: &Drill, recovery: Recovery) -> (usize, String) {
+    // One subscriber per attempt the drill wants in flight: `relay/2.9-ordering` gives each endpoint
+    // a lane of its own, so attempts to one subscriber are serialised on purpose — which is right
+    // for a subscriber and useless for a drill that wants to see *every* delivery in flight.
+    for lane in 0..LANES {
+        drill.register(ACME.1, &format!("slow-subscriber-{lane}"));
+    }
+    let accepted = drill.accept_many(ACME.1, &keys("slow-subscriber", EVENTS));
+    let deliveries = drill.count("select count(*) from deliveries");
+    let seats = u32::try_from(deliveries).unwrap_or(SEATS);
+    let pool = drill.pool().await;
+
+    // The subscriber takes every attempt and holds it (`tests/support/load.rs`): the failure is
+    // real — every delivery is in flight and none is answered — before the recovery is decided.
+    let counted = Arc::new(Counted::new());
+    counted.hold();
+    let worker = drill.worker(&pool, seats, &counted);
+    let working = tokio::spawn(async move { worker.turn().await });
+    // Every lane is occupied: the failure is real — a full set of attempts is in flight and none of
+    // them has been answered — before anything is decided about the recovery.
+    counted.wait_for_started(LANES).await;
+    let held = drill.count("select count(*) from deliveries where state = 'claimed'");
+    assert_eq!(
+        held, deliveries,
+        "every delivery was claimed by the worker that is waiting on the subscriber"
+    );
+
+    match recovery {
+        Recovery::Never => {
+            // Nobody ever lets them through. The attempts stay in flight and the rows stay claimed:
+            // the drill reports what is owed rather than waiting for a subscriber that is not
+            // coming back — which is the difference between an incident and an outage nobody ends.
+            working.abort();
+            (
+                accepted,
+                format!(
+                    "the subscriber never answered: {} attempt(s) are in flight and {held} \
+                     delivery(ies) are claimed by a worker waiting on them",
+                    counted.in_flight()
+                ),
+            )
+        }
+        Recovery::ComesBack => {
+            counted.release();
+            let tick = working
+                .await
+                .expect("the turn ends")
+                .expect("the turn runs");
+            (
+                accepted,
+                format!(
+                    "the subscriber started answering and the attempts in flight finished: \
+                     {tick:?}"
+                ),
+            )
+        }
+    }
+}
+
+/// One tenant floods the queue while another tenant's one event waits behind it.
+async fn tenant_storm(drill: &Drill, recovery: Recovery) -> (usize, String) {
+    drill.register(ACME.1, "flooding-tenant");
+    drill.register(GLOBEX.1, "quiet-tenant");
+    let mut accepted = drill.accept_many(ACME.1, &keys("tenant-storm", FLOOD));
+    accepted += drill.accept_many(GLOBEX.1, &keys("quiet-tenant", 1));
+    let pool = drill.pool().await;
+    let counted = Arc::new(Counted::new());
+    let worker = drill.worker(&pool, SEATS, &counted);
+
+    match recovery {
+        Recovery::Never => {
+            // The flood does not end: every turn accepts more events than the seats can attempt, so
+            // the queue grows while the service is as fast as it was ever going to be. That is what
+            // a storm is, and the drill stops after a bounded number of turns to report what is
+            // still owed.
+            for turn in 0..TURNS {
+                accepted += drill.accept_many(ACME.1, &keys(&format!("storm-{turn}"), PER_TURN));
+                worker.turn().await.expect("the worker runs");
+            }
+            (
+                accepted,
+                format!(
+                    "the flood never ended: {TURNS} turns of {PER_TURN} new event(s) against \
+                     {SEATS} seats, and the queue is what grew"
+                ),
+            )
+        }
+        Recovery::ComesBack => {
+            // The storm ends, and the seats work through what was accepted — including the quiet
+            // tenant's one delivery, which the claim deals a share of the seats to
+            // (`relay/2.14-backpressure`).
+            let report = worker.work(TURNS).await.expect("the worker runs");
+            let served = drill.count(
+                "select count(*) from deliveries as d \
+                   join endpoints as e on e.id = d.endpoint_id \
+                  where e.url like '%quiet-tenant' and d.state = 'sent'",
+            );
+            assert_eq!(
+                served, 1,
+                "the tenant with one event was served while the other tenant's flood was being \
+                 worked through: a claim that took the oldest rows would serve the flood first, \
+                 because every one of its rows is older"
+            );
+            (
+                accepted,
+                format!(
+                    "the flood ended, the queue drained ({report:?}), and the quiet tenant was served"
+                ),
+            )
+        }
     }
 }
 
