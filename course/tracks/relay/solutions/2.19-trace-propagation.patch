--- /dev/null
+++ b/migrations/0009_trace.sql
@@ -0,0 +1,18 @@
+-- The trace a delivery belongs to (step relay/2.19-trace-propagation).
+--
+-- Written when the event was accepted, read when the delivery goes out: the two halves are minutes
+-- or hours apart and live in different processes, so the trace context travels with the work rather
+-- than with the process that created it. That is the whole reason these are columns.
+--
+-- Both are nullable, and that is a decision rather than an oversight: a delivery accepted before
+-- this service carried traces has none, and it goes out with no `traceparent` rather than with one
+-- invented at delivery time — an invented trace id is a link to a request nobody made.
+alter table deliveries
+    add column trace_id text,
+    add column tracestate text;
+
+-- A trace id this service would not have written is a row this service would not have written, and
+-- the shape is checked where the row is, not only where it is read.
+alter table deliveries
+    add constraint deliveries_trace_id_well_formed
+        check (trace_id is null or trace_id ~ '^[0-9a-f]{32}$');
