+/// Run the backfill of a column a migration added, on the database this configuration names.
+///
+/// `relay/2.23-online-schema` puts it here rather than in the library because it is the same
+/// decision the rest of this file makes: which pieces happen, in which order, and what the process
+/// exits with. The work itself is [`relay::backfill`].
+fn backfill_now(config: &Config) -> Result<relay::backfill::Backfilled, Error> {
+    let url = config.database.url.clone().ok_or_else(|| {
+        Error::Config(
+            "no database configured: set RELAY__DATABASE__URL or database.url in the config file"
+                .to_owned(),
+        )
+    })?;
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .map_err(|error| Error::Config(format!("tokio runtime: {error}")))?;
+    runtime.block_on(async move {
+        let db = relay::db::Db::connect(&url).await?;
+        // The migrations first: a backfill of a column that is not there yet is a statement about a
+        // table nobody has, and this is the one phase that cannot assume the schema arrived.
+        db.migrate().await?;
+        relay::backfill::run(db.pool(), relay::backfill::BATCH).await
+    })
+}
