+/// One event in a page, as the API hands it to a caller: the event, and the size of what it carried.
+///
+/// `relay/2.23-online-schema`: the field is answered from the column the expand migration added,
+/// with the payload computed as the fallback, so a row nobody has backfilled yet is answered like
+/// any other. The document declares a schema of its own for the page's items (`ListedEvent`) rather
+/// than reusing `Event`, because the answer really does have a field the other route does not.
+#[derive(Debug, serde::Serialize)]
+struct ListedEventBody<'a> {
+    /// The event itself, spread into this object rather than nested: a caller that wants the id
+    /// should not have to know which route it asked.
+    #[serde(flatten)]
+    event: EventBody<'a>,
+    /// Bytes of the payload this event was accepted with.
+    bytes: i64,
+}
+
+impl<'a> ListedEventBody<'a> {
+    /// The body one listed event is answered with.
+    fn of(listed: &'a pagination::Listed) -> Self {
+        Self {
+            event: EventBody::of(&listed.event),
+            bytes: listed.bytes,
+        }
+    }
+}
