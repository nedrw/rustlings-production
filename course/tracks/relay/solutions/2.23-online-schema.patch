-    todo!("step relay/2.23-online-schema")
+    // One statement, and the whole of the phase is in it: the rows are chosen by *not having a
+    // value*, in the order the partial index is in, at most a batch of them, and the value written
+    // is the same expression the read path falls back to (`src/pagination.rs`) — the stored number
+    // and the computed one have to be the same number, or the column is a second answer rather than
+    // a cache of the first.
+    let written = sqlx::query(
+        "update events as v \
+            set payload_bytes = octet_length(v.payload::text) \
+          where v.id in (select e.id from events as e \
+                          where e.payload_bytes is null \
+                          order by e.received_at, e.id \
+                          limit $1)",
+    )
+    .bind(batch)
+    .execute(pool)
+    .await
+    .map_err(Error::Database)?
+    .rows_affected();
+    Ok(written)
 }
 
