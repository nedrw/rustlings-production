+/// Read one request — head and body — as bytes, so it can be forwarded verbatim.
+fn read_request(client: &mut TcpStream) -> Option<Vec<u8>> {
+    let mut raw = Vec::new();
+    let mut buffer = [0u8; 1024];
+    let end = loop {
+        if let Some(end) = find(&raw, b"\r\n\r\n") {
+            break end + 4;
+        }
+        if raw.len() > MAX_HEAD {
+            return None;
+        }
+        let read = client.read(&mut buffer).ok()?;
+        if read == 0 {
+            return None;
+        }
+        raw.extend_from_slice(&buffer[..read]);
+    };
+    // Whatever arrived past the head is the beginning of the body, and it is *kept*: a proxy that
+    // read a chunk and threw away what was in it would wait for bytes that have already arrived,
+    // which is a fixture bug that looks exactly like a slow subscriber.
+    let length = content_length(&String::from_utf8_lossy(&raw[..end]));
+    let mut request = raw[..end].to_vec();
+    let mut body = raw[end..].to_vec();
+    while body.len() < length {
+        let read = client.read(&mut buffer).ok()?;
+        if read == 0 {
+            break;
+        }
+        body.extend_from_slice(&buffer[..read]);
+    }
+    request.extend_from_slice(&body[..length.min(body.len())]);
+    Some(request)
+}
+
+/// Read a request head one byte at a time, and stop at the blank line that ends it.
+///
+/// Only [`Fault::Reset`] uses this, and it uses it for the reason written where it is called: the
+/// body has to stay unread in the socket for the close to be a reset.
+fn read_head_byte_by_byte(client: &mut TcpStream) -> Option<Vec<u8>> {
+    let mut raw = Vec::new();
+    let mut byte = [0u8; 1];
+    loop {
+        if raw.len() > MAX_HEAD {
+            return None;
+        }
+        let read = client.read(&mut byte).ok()?;
+        if read == 0 {
+            return None;
+        }
+        raw.push(byte[0]);
+        if raw.ends_with(b"\r\n\r\n") {
+            return Some(raw);
+        }
+    }
+}
+
+/// Copy one answer — head and body — from `upstream` to `client`.
+fn forward_answer(upstream: &mut TcpStream, client: &mut TcpStream) -> std::io::Result<()> {
+    let mut head = Vec::new();
+    let mut buffer = [0u8; 1024];
+    let end = loop {
+        if let Some(end) = find(&head, b"\r\n\r\n") {
+            break end + 4;
+        }
+        let read = upstream.read(&mut buffer)?;
+        if read == 0 {
+            // The target closed without a complete head: pass on what there was, and end the
+            // connection — the client's own client is the one that decides what that means.
+            client.write_all(&head)?;
+            client.flush()?;
+            return Ok(());
+        }
+        head.extend_from_slice(&buffer[..read]);
+    };
+    let length = content_length(&String::from_utf8_lossy(&head[..end]));
+    let body_start = end;
+    let mut body = head[body_start..].to_vec();
+    while body.len() < length {
+        let read = upstream.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        body.extend_from_slice(&buffer[..read]);
+    }
+    client.write_all(&head[..body_start])?;
+    client.write_all(&body[..length.min(body.len())])?;
+    client.flush()
+}
+
+/// The `content-length` of a head, or `0` when it does not carry one.
+fn content_length(head: &str) -> usize {
+    head.lines()
+        .filter_map(|line| line.split_once(':'))
+        .find(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+        .and_then(|(_, value)| value.trim().parse().ok())
+        .unwrap_or(0)
+}
+
+/// Where `needle` sits in `haystack`.
+fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    if needle.is_empty() || haystack.len() < needle.len() {
+        return None;
     }
+    (0..=haystack.len() - needle.len())
+        .find(|start| &haystack[*start..*start + needle.len()] == needle)
 }
