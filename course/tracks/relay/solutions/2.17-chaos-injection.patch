+/// Serve one connection: read a request, decide what the fault says about it, and act.
+///
+/// The fault in force is read once, when the connection is accepted: a test that heals a proxy
+/// while an attempt is in flight is testing the attempt that is in flight, and turning the fault
+/// off underneath it would make the outcome depend on the scheduler.
+fn serve(mut client: TcpStream, _number: usize, shared: &Shared) {
+    let _ = client.set_read_timeout(Some(IO));
+    let fault = {
+        *shared
+            .fault
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+    };
+
+    if fault == Fault::Reset {
+        // The head is read **one byte at a time** and the body is left where it is: closing a socket
+        // with unread bytes in its receive buffer is what makes the kernel answer with `RST` rather
+        // than an orderly `FIN`. One byte at a time because a single `read` would take the body with
+        // it, and the test would be injecting a closed connection instead of a reset one.
+        let _ = read_head_byte_by_byte(&mut client);
+        shared.dropped.fetch_add(1, Ordering::SeqCst);
+        return;
+    }
+
+    // How many requests have arrived on this connection: what `Fault::Loss` counts.
+    let mut seen = 0usize;
+    loop {
+        let Some(request) = read_request(&mut client) else {
+            return;
+        };
+        seen += 1;
+        if let Fault::Delay(wait) = fault {
+            std::thread::sleep(wait);
+        }
+        if fault.takes_request(seen) {
+            shared.dropped.fetch_add(1, Ordering::SeqCst);
+            return;
+        }
+        // One upstream connection per request, deliberately: a pooled connection here would be the
+        // proxy's own policy to get wrong, and what a test is reading is the service's.
+        let Ok(mut upstream) = TcpStream::connect(shared.target) else {
+            return;
+        };
+        let _ = upstream.set_read_timeout(Some(IO));
+        if upstream.write_all(&request).is_err() {
+            return;
+        }
+        shared.forwarded.fetch_add(1, Ordering::SeqCst);
+        if fault == Fault::HalfOpen {
+            // The request is delivered and the answer is never passed back: the subscriber had it
+            // and said nothing, which is the one failure a client can only end with its own
+            // deadline. The connection stays open for longer than any deadline a test uses.
+            std::thread::sleep(PARK);
+            return;
+        }
+        if forward_answer(&mut upstream, &mut client).is_err() {
+            return;
+        }
+    }
+}
