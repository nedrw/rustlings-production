diff --git a/migrations/0008_audit.sql b/migrations/0008_audit.sql
new file mode 100644
index 0000000..71eacc9
--- /dev/null
+++ b/migrations/0008_audit.sql
@@ -0,0 +1,40 @@
+-- Who may do what, and what they did.
+--
+-- Two things live here, and they are two halves of one decision: a tenant has a *role*, and a
+-- privileged action leaves a *row* (step relay/2.16-authz-audit).
+--
+-- The role is a column on `tenants` rather than a table of its own, and that is this service's
+-- simplification rather than the general answer: a tenant here has exactly one API key, so a role
+-- per tenant and a role per credential are the same thing. A service whose tenants hold several
+-- keys — a laptop, a CI runner, a person — needs a table keyed by the credential, and the shape of
+-- the matrix does not change when it does.
+alter table tenants
+    add column role text not null default 'tenant-admin';
+
+-- A role this service does not have is not a role a row may hold: the second place the list of
+-- roles is written down is the database's, and it is the one that holds when somebody edits a row
+-- with `psql` at three in the morning.
+alter table tenants
+    add constraint tenants_role_known
+        check (role in ('tenant-admin', 'tenant-reader'));
+
+-- The trail. `decision` is both halves of the question — `allow`, or the reason a request was
+-- refused — because the two are always asked together by whoever reads it. The credential is not
+-- here, and never will be: this table outlives the key it is about, and a trail that quoted the
+-- key would be a second copy of it with a longer retention.
+create table audit_log (
+    id uuid primary key default gen_random_uuid(),
+    tenant_id uuid not null references tenants (id) on delete cascade,
+    role text not null,
+    action text not null,
+    target text not null,
+    decision text not null,
+    request_id text not null,
+    at timestamptz not null default now()
+);
+
+-- One query reads this table: one tenant's decisions, newest first. The index is in exactly that
+-- shape, so the listing is a range scan that stops after its limit instead of a sort over every
+-- decision this service has ever made.
+create index audit_log_tenant_at_idx
+    on audit_log (tenant_id, at desc, id desc);
