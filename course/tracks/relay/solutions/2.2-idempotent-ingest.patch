+/// One event, as the API hands it to a caller.
+#[derive(Debug, serde::Serialize)]
+struct EventBody<'a> {
+    /// Identity of the event: what a caller quotes when it asks about this one.
+    id: String,
+    /// What the event is about.
+    kind: &'a str,
+    /// The JSON the tenant sent.
+    payload: &'a serde_json::Value,
+    /// When this service accepted it, RFC 3339.
+    received_at: String,
+}
+
+impl<'a> EventBody<'a> {
+    /// The body one event is answered with.
+    fn of(event: &'a events::Event) -> Self {
+        Self {
+            id: event.id.to_string(),
+            kind: &event.kind,
+            payload: &event.payload,
+            received_at: event.received_at.to_rfc3339(),
+        }
+    }
+}
+
+/// The answer to `POST /events`: the event, and whether this answer is a replay of an earlier one.
+#[derive(Debug, serde::Serialize)]
+struct IngestBody<'a> {
+    /// The event itself, spread into this object rather than nested: a caller that wants the id
+    /// should not have to know which route it asked.
+    #[serde(flatten)]
+    event: EventBody<'a>,
+    /// `true` when the tenant had already sent this key.
+    replayed: bool,
+}
+
+/// The body `POST /events` accepts.
+#[derive(Debug, Deserialize)]
+struct CreateEvent {
+    /// What the event is about.
+    kind: String,
+    /// The JSON the tenant wants delivered.
+    payload: serde_json::Value,
+}
+
+/// Accept one event for the calling tenant.
+///
+/// The answer is about the idempotency key, not about this request: a new key is 201 with the event
+/// that was just stored, a key that has been used before is 200 with the event stored *then*. Both
+/// carry the same identity, which is what makes a retry safe to send.
+async fn create_event(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    headers: HeaderMap,
+    body: Result<Json<CreateEvent>, axum::extract::rejection::JsonRejection>,
+) -> Response {
+    let Ok(Json(body)) = body else {
+        return Error::BadRequest("the body must be JSON with a `kind` and a `payload`".to_owned())
+            .into_response();
+    };
+    let kind = body.kind.trim();
+    if kind.is_empty() {
+        return Error::BadRequest("`kind` must not be empty".to_owned()).into_response();
+    }
+    if !body.payload.is_object() {
+        return Error::BadRequest("`payload` must be a JSON object".to_owned()).into_response();
+    }
+    let Some(key) = idempotency_key(&headers) else {
+        return Error::BadRequest(
+            "the `Idempotency-Key` header is required: two requests carrying it are one event"
+                .to_owned(),
+        )
+        .into_response();
+    };
+    match events::ingest(
+        state.db().pool(),
+        principal.tenant_id,
+        &key,
+        kind,
+        &body.payload,
+    )
+    .await
+    {
+        Err(error) => error.into_response(),
+        Ok(ingested) => {
+            let replayed = ingested.was_replayed();
+            let status = if replayed {
+                StatusCode::OK
+            } else {
+                StatusCode::CREATED
+            };
+            let answer = IngestBody {
+                event: EventBody::of(ingested.event()),
+                replayed,
+            };
+            (status, Json(answer)).into_response()
+        }
+    }
+}
+
+/// The `Idempotency-Key` header, when it carries something usable.
+///
+/// Header names are case-insensitive and so is this lookup; the value is trimmed, because `Key: `
+/// is a client that meant to send a key and did not.
+fn idempotency_key(headers: &HeaderMap) -> Option<String> {
+    let value = headers.get("idempotency-key")?.to_str().ok()?.trim();
+    (!value.is_empty()).then(|| value.to_owned())
+}
