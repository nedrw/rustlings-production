+-- What a tenant sent, once. `idempotency_key` is the caller's promise that two requests carrying
+-- it are one event, and the unique constraint is what lets the database hold that promise: the
+-- second insert is refused by the index, not by a `select` that both requests can pass before
+-- either one writes.
+create table events (
+    id uuid primary key,
+    tenant_id uuid not null references tenants (id) on delete cascade,
+    idempotency_key text not null,
+    kind text not null,
+    payload jsonb not null,
+    received_at timestamptz not null default now(),
+    unique (tenant_id, idempotency_key)
+);
