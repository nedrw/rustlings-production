+        .next()
+        .and_then(|part| part.parse::<i64>().ok())
+        .ok_or_else(|| malformed("no timestamp"))?;
+    let delivery = parts
+        .next()
+        .and_then(|part| part.parse::<Uuid>().ok())
+        .ok_or_else(|| malformed("no delivery id"))?;
+    let tag = parts.next().ok_or_else(|| malformed("no tag"))?;
+    if parts.next().is_some() {
