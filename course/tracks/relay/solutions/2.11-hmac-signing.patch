+/// The parts of a signature header after its version: the instant, the delivery, and the tag.
+fn parse(signature: &str) -> Result<(i64, Uuid, String), SignatureError> {
+    let mut parts = signature.split('.');
+    let version = parts
+        .next()
+        .filter(|version| !version.is_empty())
+        .ok_or_else(|| SignatureError::Malformed("an empty signature".to_owned()))?;
+    if version != VERSION {
+        return Err(SignatureError::UnknownVersion(version.to_owned()));
+    }
+    let malformed = |what: &str| SignatureError::Malformed(format!("{what} in `{signature}`"));
