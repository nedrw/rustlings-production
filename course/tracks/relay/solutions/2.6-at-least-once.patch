+
+/// Write down what one accepted event owes: one delivery per endpoint of its tenant.
+///
+/// Takes a connection rather than a pool because it runs **inside the transaction that accepted the
+/// event** (`events::ingest`): an accepted event and the work it creates are one commit. A crash
+/// between the two would be an event nobody is ever told about, which is the one failure this
+/// service's guarantee does not allow.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the deliveries cannot be written.
+pub(crate) async fn fan_out(
+    connection: &mut PgConnection,
+    event: Uuid,
+    tenant: TenantId,
+) -> Result<u64, Error> {
+    // `on conflict do nothing` against `unique (event_id, endpoint_id)`: a fan-out that happens
+    // twice — a retried request, a replay, two processes — writes no second debt.
+    let written = sqlx::query(
+        "insert into deliveries (id, event_id, endpoint_id) \
+         select gen_random_uuid(), $1, endpoints.id from endpoints where endpoints.tenant_id = $2 \
+         on conflict (event_id, endpoint_id) do nothing",
+    )
+    .bind(event)
+    .bind(tenant.as_uuid())
+    .execute(connection)
+    .await
+    .map_err(Error::Database)?;
+    Ok(written.rows_affected())
+}
+
+/// What one attempt came to, before it is written down.
+enum Outcome {
+    /// The subscriber took it.
+    Sent,
+    /// Another attempt may succeed, with this reason.
+    Retry(String),
+    /// Nothing more will be tried, with this reason.
+    Dead(String),
+}
+
+/// How many failed attempts a delivery is given before it is buried.
+///
+/// A constant, and a small one: what a *deployment* wants here is a setting (with per-tenant
+/// budgets and a breaker), which is step `relay/2.8-retry-budget`. What matters now is that the
+/// number exists at all — a retry policy with no end is a delivery that is never late, only
+/// forever.
+pub const MAX_ATTEMPTS: i32 = 5;
+
+/// The wait after the first failure; each further failure doubles it.
+const BACKOFF: Duration = Duration::from_secs(30);
+/// The longest a delivery may wait between attempts.
+const MAX_BACKOFF: Duration = Duration::from_secs(60 * 60 * 6);
+/// How many times the wait may double before `MAX_BACKOFF` takes over.
+const MAX_DOUBLINGS: u32 = 32;
+
+/// When a delivery that has failed `attempts` times may be tried again.
+///
+/// Exponential, deterministic, and without jitter: a fleet of workers retrying a subscriber that
+/// just came back all wake up on the same second. Jitter and a budget are step
+/// `relay/2.8-retry-budget`; the shape is here because a claim needs an instant to write down.
+fn next_attempt(attempts: i32) -> DateTime<Utc> {
+    let doublings = u32::try_from(attempts.max(1) - 1)
+        .unwrap_or(MAX_DOUBLINGS)
+        .min(MAX_DOUBLINGS);
+    let wait = BACKOFF
+        .saturating_mul(1u32 << doublings.min(31))
+        .min(MAX_BACKOFF);
+    Utc::now() + chrono::Duration::from_std(wait).unwrap_or_else(|_| chrono::Duration::zero())
 }
