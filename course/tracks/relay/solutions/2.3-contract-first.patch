+/// One event as a caller sees it, with or without the field that says the answer is a replay.
+///
+/// One function for both shapes on purpose: `POST /events` answers with the event and whether it
+/// was already there, and the listing answers with the events alone. A field renamed in one of them
+/// and not the other is the kind of drift a document is supposed to make impossible.
+fn event_schema(replayed: bool) -> Value {
+    let mut properties = Map::new();
+    properties.insert(
+        "id".to_owned(),
+        json!({ "type": "string", "format": "uuid" }),
+    );
+    properties.insert("kind".to_owned(), json!({ "type": "string" }));
+    properties.insert("payload".to_owned(), json!({ "type": "object" }));
+    properties.insert(
+        "received_at".to_owned(),
+        json!({ "type": "string", "format": "date-time" }),
+    );
+    let mut required = vec!["id", "kind", "payload", "received_at"];
+    if replayed {
+        properties.insert("replayed".to_owned(), json!({ "type": "boolean" }));
+        required.push("replayed");
+    }
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "required": required,
+        "properties": properties,
+    })
 }
