+/// One JSON answer: the schema a caller gets, and what the status means.
+fn answer(schema: &str, description: &str) -> Value {
+    json!({
+        "description": description,
+        "content": {
+            "application/json": {
+                "schema": { "$ref": format!("#/components/schemas/{schema}") },
+            },
+        },
+    })
+}
