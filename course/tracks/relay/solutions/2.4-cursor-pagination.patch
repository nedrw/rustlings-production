+/// The parameters `GET /events` accepts.
+///
+/// Every one of them is text: what makes a size usable and a cursor real is decided by
+/// [`pagination::page`], in one place, next to the query that needs them.
+#[derive(Debug, Deserialize)]
+struct ListEvents {
+    /// `limit=`: how many rows this page may hold.
+    limit: Option<String>,
+    /// `cursor=`: the position this page continues from.
+    cursor: Option<String>,
+    /// `kind=`: only events of this kind.
+    kind: Option<String>,
+}
+
+/// One page of the calling tenant's events, newest first.
+///
+/// A page is bounded and it says where it stopped: `next` is the cursor that continues it, and
+/// `null` means the caller has read everything that existed when this page was answered.
+async fn list_events(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    Query(params): Query<ListEvents>,
+) -> Response {
+    let query = pagination::Query {
+        limit: params.limit,
+        cursor: params.cursor,
+        kind: params.kind,
+    };
+    match pagination::page(state.db().pool(), principal.tenant_id, &query).await {
+        Err(error) => error.into_response(),
+        Ok(page) => {
+            let events = page.events.iter().map(EventBody::of).collect();
+            let next = page.next.as_ref().map(|cursor| cursor.as_str().to_owned());
+            (StatusCode::OK, Json(PageBody { events, next })).into_response()
+        }
+    }
+}
