+/// The parameters `GET /dlq` accepts.
+///
+/// Text rather than a number on purpose: `?limit=abc` is a caller mistake, and a query struct that
+/// could not be parsed is a 400 with the same shape every other bad request has.
+#[derive(Debug, Deserialize)]
+struct ListDeadLetters {
+    /// `limit=`: how many letters this answer may hold.
+    limit: Option<String>,
+}
+
+/// One dead letter, as the API answers with it.
+///
+/// A shape of its own rather than `dlq::DeadLetter`'s fields: the service's types are the service's
+/// (`EndpointUrl` is not a string until somebody says it is), and the document in `openapi.rs`
+/// describes *this* object. The two have to agree, which is what the snapshot in the spec of
+/// `relay/2.3-contract-first` is for.
+fn dead_letter_body(letter: &dlq::DeadLetter) -> Value {
+    json!({
+        "id": letter.delivery.to_string(),
+        "event_id": letter.event.to_string(),
+        "kind": letter.kind,
+        "url": letter.url.as_str(),
+        "replays": letter.replays,
+        "lives": letter
+            .lives
+            .iter()
+            .map(|life| {
+                json!({
+                    "attempts": life.attempts,
+                    "reason": life.reason,
+                    "died_at": life.died_at.to_rfc3339(),
+                    "replayed_at": life.replayed_at.map(|at| at.to_rfc3339()),
+                })
+            })
+            .collect::<Vec<Value>>(),
+    })
+}
+
+/// The calling tenant's dead letters, newest death first.
+async fn list_dead_letters(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    Query(params): Query<ListDeadLetters>,
+) -> Response {
+    let limit = match params.limit {
+        None => dlq::DEFAULT_LIMIT,
+        Some(text) => match text.trim().parse::<i64>() {
+            Ok(limit) if (1..=dlq::MAX_LIMIT).contains(&limit) => limit,
+            _ => {
+                return Error::BadRequest(format!(
+                    "`limit` has to be a number between 1 and {}",
+                    dlq::MAX_LIMIT
+                ))
+                .into_response();
+            }
+        },
+    };
+    match dlq::list(state.db().pool(), principal.tenant_id, limit).await {
+        Err(error) => error.into_response(),
+        Ok(letters) => (
+            StatusCode::OK,
+            Json(json!({
+                "dead_letters": letters.iter().map(dead_letter_body).collect::<Vec<Value>>(),
+            })),
+        )
+            .into_response(),
+    }
+}
+
+/// Put one dead letter back in the queue.
+///
+/// The statuses are the boundary of a replay, written down: `200` with `replayed: false` for a
+/// delivery that is not a dead letter (nothing was reset, and it is not an error to ask), `400` for
+/// something that is not a delivery id at all, and `404` for a delivery this tenant cannot see —
+/// including one that belongs to somebody else.
+async fn replay_dead_letter(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    Path(id): Path<String>,
+) -> Response {
+    let Ok(delivery) = id.parse::<Uuid>() else {
+        return Error::BadRequest(format!("`{id}` is not a delivery id")).into_response();
+    };
+    match dlq::replay(state.db().pool(), principal.tenant_id, delivery).await {
+        Err(error) => error.into_response(),
+        Ok(None) => Error::NotFound.into_response(),
+        Ok(Some(dlq::Replay::Resurrected { replays })) => (
+            StatusCode::OK,
+            Json(json!({
+                "id": id,
+                "replayed": true,
+                "replays": replays,
+                "state": "pending",
+            })),
+        )
+            .into_response(),
+        Ok(Some(dlq::Replay::NotDead { state, replays })) => (
+            StatusCode::OK,
+            Json(json!({
+                "id": id,
+                "replayed": false,
+                "replays": replays,
+                "state": state,
+            })),
+        )
+            .into_response(),
+    }
+}
