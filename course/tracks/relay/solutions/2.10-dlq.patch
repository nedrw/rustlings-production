+    // that never happened.
+    let mut transaction = pool.begin().await.map_err(Error::Database)?;
+
+    // `for update` is what makes the decision below safe: the read and the writes are one
+    // transaction and nobody else can change this row's state in between. Two callers replaying the
+    // same id at the same moment therefore queue, and the second one finds a delivery that is
+    // already owed again.
+    let found: Option<(String, i32)> = sqlx::query_as(
+        "select d.state, \
+                (select count(*)::int from dead_letters as l \
+                  where l.delivery_id = d.id and l.replayed_at is not null) \
+           from deliveries as d \
+           join events as v on v.id = d.event_id \
+          where d.id = $1 and v.tenant_id = $2 \
+            for update of d",
+    )
+    .bind(delivery)
+    .bind(tenant.as_uuid())
+    .fetch_optional(&mut *transaction)
+    .await
+    .map_err(Error::Database)?;
+
+    let Some((state, replays)) = found else {
+        // Not this tenant's delivery, or no such delivery: one answer for both, because a caller
+        // must not be able to tell them apart.
+        transaction.rollback().await.map_err(Error::Database)?;
+        return Ok(None);
+    };
+
+    if state != "dead" {
+        // Nothing to undo. A delivery that is owed again, or one a subscriber has taken, is not a
+        // dead letter, and a replay that reset it anyway would send a duplicate nobody asked for.
+        transaction.rollback().await.map_err(Error::Database)?;
+        return Ok(Some(Replay::NotDead { state, replays }));
+    }
+
+    // The row moves: owed again, nothing spent, due now. `last_error` stays, because "what went
+    // wrong last time" is worth reading until the delivery succeeds (`mark_sent` is what clears it).
+    sqlx::query(
+        "update deliveries \
+            set state = 'pending', attempts = 0, next_attempt_at = now(), locked_by = null, \
+                locked_at = null, lease_expires_at = null \
+          where id = $1",
+    )
+    .bind(delivery)
+    .execute(&mut *transaction)
+    .await
+    .map_err(Error::Database)?;
+
+    // And the life that just ended is stamped as undone: the history keeps what it cost, and says
+    // that somebody has since replayed it.
+    sqlx::query(
+        "update dead_letters set replayed_at = now() \
+          where delivery_id = $1 and replayed_at is null",
+    )
+    .bind(delivery)
+    .execute(&mut *transaction)
+    .await
+    .map_err(Error::Database)?;
+
+    transaction.commit().await.map_err(Error::Database)?;
