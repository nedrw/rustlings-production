+
+impl FileLayer {
+    /// Read a TOML file, flattening tables to `table.key`.
+    fn read(path: &std::path::Path) -> Result<Self, Error> {
+        let text = std::fs::read_to_string(path)
+            .map_err(|error| Error::Config(format!("cannot read {}: {error}", path.display())))?;
+        let value: toml::Value = toml::from_str(&text).map_err(|error| {
+            Error::Config(format!("{} is not valid TOML: {error}", path.display()))
+        })?;
+        let mut settings = std::collections::BTreeMap::new();
+        flatten(&value, "", &mut settings);
+        Ok(Self { settings })
+    }
+
+    /// One setting, as text (arrays are joined with commas, which is how `tenants` is written).
+    fn get(&self, key: &str) -> Option<String> {
+        self.settings.get(key).cloned()
+    }
+}
+
+/// Flatten a TOML document to `dotted.key = text`, the shape every layer speaks.
+fn flatten(
+    value: &toml::Value,
+    prefix: &str,
+    settings: &mut std::collections::BTreeMap<String, String>,
+) {
+    match value {
+        toml::Value::Table(table) => {
+            for (key, value) in table {
+                let name = if prefix.is_empty() {
+                    key.clone()
+                } else {
+                    format!("{prefix}.{key}")
+                };
+                flatten(value, &name, settings);
+            }
+        }
+        toml::Value::Array(items) => {
+            let joined = items
+                .iter()
+                .filter_map(|item| match item {
+                    toml::Value::String(text) => Some(text.clone()),
+                    toml::Value::Table(_) => None,
+                    other => Some(other.to_string()),
+                })
+                .collect::<Vec<_>>()
+                .join(",");
+            settings.insert(prefix.to_owned(), joined);
+        }
+        toml::Value::String(text) => {
+            settings.insert(prefix.to_owned(), text.clone());
+        }
+        other => {
+            settings.insert(prefix.to_owned(), other.to_string());
+        }
+    }
+}
