+/// The secret is generated here and answered exactly once: a service that can print it again is a
+/// service where a database leak is a signing-key leak.
+async fn create_endpoint(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    payload: Result<Json<CreateEndpoint>, axum::extract::rejection::JsonRejection>,
+) -> Response {
+    let Ok(Json(payload)) = payload else {
+        return Error::BadRequest("the body must be JSON with a `url` field".to_owned())
+            .into_response();
+    };
+    let url: EndpointUrl = match payload.url.parse() {
+        Ok(url) => url,
+        Err(error) => return Error::Endpoint(error).into_response(),
+    };
+    let id = EndpointId::new();
+    let secret = new_secret();
+    let inserted = sqlx::query(
+        "insert into endpoints (id, tenant_id, url, secret) values ($1, $2, $3, $4) \
+         on conflict (tenant_id, url) do nothing",
+    )
+    .bind(id.as_uuid())
+    .bind(principal.tenant_id.as_uuid())
+    .bind(url.as_str())
+    .bind(&secret)
+    .execute(state.db().pool())
+    .await;
+    match inserted {
+        Err(error) => Error::Database(error).into_response(),
+        // A target that is already registered is the same target: answering with the existing row
+        // would leak a secret this caller may not be the one who created, so it is a 409-shaped
+        // sentence and the client asks for the listing instead.
+        Ok(result) if result.rows_affected() == 0 => {
+            Error::BadRequest(format!("`{url}` is already registered for this tenant"))
+                .into_response()
+        }
+        Ok(_) => (
+            StatusCode::CREATED,
+            Json(json!({ "id": id.to_string(), "url": url.as_str(), "secret": secret })),
+        )
+            .into_response(),
+    }
+}
+
+/// The endpoints the calling tenant owns: never the secrets.
+async fn list_endpoints(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+) -> Response {
+    let rows: Result<Vec<(uuid::Uuid, String)>, sqlx::Error> = sqlx::query_as(
+        "select id, url from endpoints where tenant_id = $1 order by created_at, id",
+    )
+    .bind(principal.tenant_id.as_uuid())
+    .fetch_all(state.db().pool())
+    .await;
+    match rows {
+        Err(error) => Error::Database(error).into_response(),
+        Ok(rows) => {
+            let endpoints: Vec<serde_json::Value> = rows
+                .into_iter()
+                .map(|(id, url)| json!({ "id": id.to_string(), "url": url }))
+                .collect();
+            (StatusCode::OK, Json(json!({ "endpoints": endpoints }))).into_response()
+        }
+    }
+}
+
+/// No route matched: an answer a client can read, not an empty one.
+async fn not_found() -> Response {
+    Error::NotFound.into_response()
+}
+
+/// 32 bytes of signing secret, hex.
+fn new_secret() -> String {
+    let mut secret = uuid::Uuid::new_v4().simple().to_string();
+    secret.push_str(&uuid::Uuid::new_v4().simple().to_string());
+    secret
+}
+
+/// Errors answer with their kind, their status and their retryability: the caller's side of the
+/// error table `mailer/1.5-errors` established.
+impl IntoResponse for Error {
+    fn into_response(self) -> Response {
+        let status =
+            StatusCode::from_u16(self.status()).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR);
+        let body = Json(json!({
+            "error": self.kind(),
+            "message": self.to_string(),
+            "retryable": self.is_retryable(),
+        }));
+        (status, body).into_response()
+    }
 }
