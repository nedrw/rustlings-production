+fn parse_tenants(text: Option<&str>) -> Result<Vec<(String, String)>, Error> {
+    let Some(text) = text else {
+        return Ok(Vec::new());
+    };
+    let mut tenants = Vec::new();
+    for entry in text
+        .split(',')
+        .map(str::trim)
+        .filter(|entry| !entry.is_empty())
+    {
+        let Some((name, key)) = entry.split_once('=') else {
+            return Err(Error::Config(format!(
+                "`{entry}` is not a tenant: expected `name=api-key`"
+            )));
+        };
+        crate::domain::TenantName::parse(name.trim())
+            .map_err(|error| Error::Config(error.to_string()))?;
+        if key.trim().len() < 8 {
+            return Err(Error::Config(format!(
+                "the API key of `{}` is shorter than 8 characters",
+                name.trim()
+            )));
+        }
+        tenants.push((name.trim().to_owned(), key.trim().to_owned()));
+    }
+    Ok(tenants)
+}
