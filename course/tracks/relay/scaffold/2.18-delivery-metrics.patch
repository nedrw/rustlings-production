+        todo!("step relay/2.18-delivery-metrics")
+    }
+}
+
+/// One tenant, and how much of its work this service still owes.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Backlog {
+    /// The tenant's name: the label's value.
+    pub tenant: String,
+    /// How many of its deliveries are neither delivered nor buried.
+    pub depth: i64,
+}
+
