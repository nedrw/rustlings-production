@@ -0,0 +1,155 @@
+//! What this service does under load, and the numbers that say something about it.
+//!
+//! Three things live here, and each one is a decision a load test is worth having:
+//!
+//! * **a generator that is a function.** [`keys`] hands out the same list on every machine, so a
+//!   run can be *repeated* and its ledger compared with the one before it. A generator seeded by the
+//!   clock produces a different run every time and a report nobody can diff;
+//! * **percentiles by nearest rank**, not by interpolating between two neighbours: with `n` samples
+//!   sorted ascending, the `q` quantile is the `ceil(q * n)`-th of them. Every number this module
+//!   reports is therefore *an observation* — never an average of two observations that never
+//!   happened — and a reader can recompute any of them from the sample by hand;
+//! * **a curve rather than a number.** [`Point`] records what one concurrency level cost: the p99 of
+//!   its requests and the backlog it left behind. [`Curve`] is the list of them, with the shape
+//!   check and the table the capacity page is written from. A p99 without the concurrency it was
+//!   measured at is a number nobody can act on.
+//!
+//! The module is deliberately free of clocks and I/O: it is arithmetic over samples that a test (or
+//! a person with `--nocapture`) hands in, which is why the shape of a curve can be *proved* here
+//! rather than hoped for in a run against a machine that is also doing something else.
+
+use std::fmt;
+use std::time::Duration;
+
+/// The prefix every key the generator hands out carries, so a load run's rows are recognisable in
+/// the ledger it created them in.
+const PREFIX: &str = "load";
+
+/// How much a level's p99 may fall below the level under it before the curve is not a curve.
+///
+/// Not zero, and the reason is the machine rather than this service: the p99 of a small sample is
+/// close to its largest observation, and a shared machine puts its one long request wherever it
+/// likes. What a tolerance this wide cannot hide is a curve whose levels *all* go the wrong way,
+/// which is the shape worth failing on.
+pub const JITTER: f64 = 0.5;
+
+/// The idempotency keys of one load run: `count` of them, unique, in a fixed order.
+#[must_use]
+pub fn keys(count: usize) -> Vec<String> {
+    keys_from(0, count)
+}
+
+/// `count` keys, starting at `first`, so consecutive levels of a curve offer different events.
+#[must_use]
+pub fn keys_from(first: usize, count: usize) -> Vec<String> {
+    let _ = (first, count);
+    todo!("step relay/2.20-load-testing")
+}
+
+/// The `q` quantile of `samples`, by nearest rank.
+///
+/// `samples` may be in any order; `q` is clamped to `[0, 1]`; an empty sample answers zero, because
+/// a percentile of nothing is nothing rather than a panic at three in the morning.
+#[must_use]
+pub fn percentile(samples: &[Duration], q: f64) -> Duration {
+    let _ = (samples, q);
+    todo!("step relay/2.20-load-testing")
+}
+
+/// What a run cost, at the three quantiles a capacity page reports.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Percentiles {
+    /// Half the requests were faster than this.
+    pub p50: Duration,
+    /// One in twenty was slower.
+    pub p95: Duration,
+    /// One in a hundred was slower: the number a budget is written against.
+    pub p99: Duration,
+}
+
+impl Percentiles {
+    /// The three quantiles of one sample.
+    #[must_use]
+    pub fn of(samples: &[Duration]) -> Self {
+        let _ = samples;
+        todo!("step relay/2.20-load-testing")
+    }
+
+    /// How many samples a report is about — the caller's count, printed beside the numbers.
+    #[must_use]
+    pub fn one_line(&self) -> String {
+        todo!("step relay/2.20-load-testing")
+    }
+}
+
+impl fmt::Display for Percentiles {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.one_line())
+    }
+}
+
+/// One level of a curve: what the service cost at `concurrency` producers, and what it still owed
+/// when the level stopped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Point {
+    /// How many producers were offering events at once.
+    pub concurrency: usize,
+    /// The p99 of the requests they made, as they measured them.
+    pub p99: Duration,
+    /// The deliveries this service still owed at the end of the level: the queue's depth, which is
+    /// the half of the picture a latency number cannot show.
+    pub backlog: i64,
+}
+
+impl Point {
+    /// How much this level's p99 grew over the one under it, as a factor (`1.0` is no change).
+    #[must_use]
+    pub fn growth_from(&self, previous: &Self) -> f64 {
+        let _ = previous;
+        todo!("step relay/2.20-load-testing")
+    }
+}
+
+/// The record of a load run: one [`Point`] per concurrency level, in the order they were measured.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Curve {
+    points: Vec<Point>,
+}
+
+impl Curve {
+    /// An empty curve.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Add one level. Levels are recorded in the order they were run.
+    pub fn record(&mut self, point: Point) {
+        let _ = point;
+        todo!("step relay/2.20-load-testing")
+    }
+
+    /// The levels, in the order they were run.
+    #[must_use]
+    pub fn points(&self) -> &[Point] {
+        &self.points
+    }
+
+    /// Whether every level's p99 is at least `(1 - jitter)` of the level under it.
+    ///
+    /// This is a *shape* check and it is written down rather than imagined so that it can be argued
+    /// with: it says nothing about the absolute numbers (the caller checks those against a bound)
+    /// and it is the reason a curve can be reported as "flat, rising, or broken".
+    #[must_use]
+    pub fn is_monotone_within(&self, jitter: f64) -> bool {
+        let _ = jitter;
+        todo!("step relay/2.20-load-testing")
+    }
+
+    /// The curve as the table a capacity page quotes: one line per level, with the p99's growth
+    /// over the level below it and the backlog it left.
+    #[must_use]
+    pub fn render(&self) -> String {
+        todo!("step relay/2.20-load-testing")
+    }
+}
