@@ -0,0 +1,71 @@
+//! The signing secrets a test decides on: a [`Secrets`] store that is a map.
+//!
+//! `relay/2.11-hmac-signing` puts the adapter's secret lookup behind a trait, and a spec about
+//! signatures is not a spec about a database: what it needs is a store that answers the secrets it
+//! chose, for the endpoints it registered. `signing::DbSecrets` is the production one and its own
+//! test uses it; this fixture is what a spec about the *format* uses.
+//!
+//! The spec loads this file with `#[path = "support/keys.rs"] mod keys;` — it is the harness, not
+//! the course, and `tests/support/mod.rs` does not have to mention it.
+
+#![allow(dead_code)] // a spec uses the part of this harness it needs, not all of it
+
+use std::collections::HashMap;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Mutex;
+
+use relay::domain::{EndpointUrl, TenantId};
+use relay::error::Error;
+use relay::signing::{Secret, Secrets};
+
+/// One test's secrets, keyed the way the service keys them: one endpoint per tenant.
+///
+/// `Debug` is derived and safe to derive: a [`Secret`] prints as `Secret(<redacted>)`, which is why
+/// the type is a type and not a `String`.
+#[derive(Debug, Default)]
+pub struct Keys {
+    secrets: Mutex<HashMap<(TenantId, String), Secret>>,
+}
+
+impl Keys {
+    /// No secrets yet.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Add one endpoint's secret, as registering it would have answered.
+    #[must_use]
+    pub fn with(self, tenant: TenantId, endpoint: &str, secret: &str) -> Self {
+        self.secrets
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .insert(
+                (tenant, endpoint.to_owned()),
+                Secret::new(secret.to_owned()),
+            );
+        self
+    }
+}
+
+impl Secrets for Keys {
+    fn secret_for(
+        &self,
+        tenant: TenantId,
+        endpoint: &EndpointUrl,
+    ) -> Pin<Box<dyn Future<Output = Result<Option<Secret>, Error>> + Send + '_>> {
+        // Copied out of the caller's request for the same reason `DbSecrets` copies it: the future
+        // borrows the store, not the URL.
+        let endpoint = endpoint.as_str().to_owned();
+        Box::pin(async move {
+            let found = self
+                .secrets
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner())
+                .get(&(tenant, endpoint))
+                .cloned();
+            Ok(found)
+        })
+    }
+}
