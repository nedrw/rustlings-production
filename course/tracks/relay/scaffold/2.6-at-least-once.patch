index 0000000..90a2086
--- /dev/null
+++ b/tests/support/sender.rs
@@ -0,0 +1,188 @@
+//! A sender that remembers: the fixture a spec hands to the worker instead of an HTTP client.
+//!
+//! The worker talks to [`relay::delivery::Sender`], so a spec does not need a subscriber to judge
+//! what the worker does: it needs something that *records* what it was asked to send and answers
+//! what the test says. That is all this is — no mocking framework, no expectations language, and
+//! nothing about the service, so a test that wants to know what happened reads [`Recording`].
+//!
+//! Three answers cover every test in the step:
+//!
+//! * **it takes it** (`200`), which is what a healthy subscriber does;
+//! * **it fails**, permanently or in a way worth another attempt — the two categories the worker
+//!   decides between;
+//! * **it never answers**, after recording the request and telling the test. That one exists to
+//!   reproduce a window rather than a state: the subscriber has the request and the worker is about
+//!   to be dropped mid-flight, which is what a process that dies between the send and the record
+//!   leaves behind.
+//!
+//! The spec loads this file with `#[path = "support/sender.rs"] mod sender;` — it is the harness,
+//! not the course, and `tests/support/mod.rs` does not have to mention it.
+
+#![allow(dead_code)] // a spec uses the part of this harness it needs, not all of it
+
+use std::collections::VecDeque;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Mutex;
+
+use relay::delivery::{Receipt, SendError, SendRequest, Sender};
+use tokio::sync::oneshot;
+use uuid::Uuid;
+
+/// A subscriber that answers what the test planned, and keeps every request it was handed.
+pub struct Recording {
+    state: Mutex<State>,
+}
+
+/// What the sender holds while a test is running.
+struct State {
+    /// Requests in the order they arrived.
+    requests: Vec<SendRequest>,
+    /// One planned failure per attempt; an empty script means "answer with `then`".
+    script: VecDeque<SendError>,
+    /// What every attempt after the script is answered with: `None` takes the request.
+    then: Option<SendError>,
+    /// Failures for one target, whatever the script says.
+    refusing: Vec<(String, SendError)>,
+    /// The next attempt records itself, tells the test, and never answers.
+    park: Option<oneshot::Sender<()>>,
+}
+
+impl Recording {
+    /// A subscriber that takes everything.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            state: Mutex::new(State {
+                requests: Vec::new(),
+                script: VecDeque::new(),
+                then: None,
+                refusing: Vec::new(),
+                park: None,
+            }),
+        }
+    }
+
+    /// A subscriber that fails every attempt with `error`.
+    #[must_use]
+    pub fn always(error: SendError) -> Self {
+        let recording = Self::new();
+        recording.state().then = Some(error);
+        recording
+    }
+
+    /// A subscriber that fails the first attempts with `script`, in order, and then takes everything.
+    #[must_use]
+    pub fn scripted(script: Vec<SendError>) -> Self {
+        let recording = Self::new();
+        recording.state().script = script.into();
+        recording
+    }
+
+    /// A subscriber that takes everything except what goes to `url`, which fails with `error`.
+    ///
+    /// By target rather than in order, because a batch of deliveries arrives in the order the
+    /// database chose: a test that said "the second one fails" would be testing the sort.
+    #[must_use]
+    pub fn refusing(url: &str, error: SendError) -> Self {
+        let recording = Self::new();
+        recording.state().refusing = vec![(url.to_owned(), error)];
+        recording
+    }
+
+    /// A subscriber that records the next attempt, tells `called`, and then never answers.
+    ///
+    /// The worker stays parked in this future until the test drops it, which is how a spec
+    /// reproduces "the subscriber has it and the process died before the row said so".
+    #[must_use]
+    pub fn stuck(called: oneshot::Sender<()>) -> Self {
+        let recording = Self::new();
+        recording.state().park = Some(called);
+        recording
+    }
+
+    /// The requests this sender was handed, in order.
+    pub fn requests(&self) -> Vec<SendRequest> {
+        self.state().requests.clone()
+    }
+
+    /// The deliveries it was asked about, in order: one entry per attempt.
+    pub fn deliveries(&self) -> Vec<Uuid> {
+        self.state()
+            .requests
+            .iter()
+            .map(|request| request.delivery)
+            .collect()
+    }
+
+    /// Which attempt each request was, in order.
+    pub fn attempts(&self) -> Vec<i32> {
+        self.state()
+            .requests
+            .iter()
+            .map(|request| request.attempt)
+            .collect()
+    }
+
+    /// The state, whether or not another thread panicked while holding it.
+    fn state(&self) -> std::sync::MutexGuard<'_, State> {
+        self.state
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+}
+
+impl Default for Recording {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl std::fmt::Debug for Recording {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Recording")
+            .field("requests", &self.state().requests.len())
+            .finish()
+    }
+}
+
+impl Sender for Recording {
+    fn send(
+        &self,
+        request: SendRequest,
+    ) -> Pin<Box<dyn Future<Output = Result<Receipt, SendError>> + Send + '_>> {
+        Box::pin(async move {
+            // The lock is released before anything is awaited: a sender that held it across a parked
+            // attempt would deadlock the next one, and the fixture would be the bug.
+            let (parked, answer) = {
+                let mut state = self.state();
+                let url = request.url.as_str().to_owned();
+                state.requests.push(request);
+                let parked = state.park.take();
+                let answer = state.answer(&url);
+                (parked, answer)
+            };
+            if let Some(called) = parked {
+                let _ = called.send(());
+                return std::future::pending::<Result<Receipt, SendError>>().await;
+            }
+            answer.map(|status| Receipt { status })
+        })
+    }
+}
+
+impl State {
+    /// What this sender answers a request to `url`.
+    fn answer(&mut self, url: &str) -> Result<u16, SendError> {
+        if let Some((_, error)) = self.refusing.iter().find(|(target, _)| target == url) {
+            return Err(error.clone());
+        }
+        if let Some(error) = self.script.pop_front() {
+            return Err(error);
+        }
+        match &self.then {
+            Some(error) => Err(error.clone()),
+            None => Ok(200),
+        }
+    }
+}
