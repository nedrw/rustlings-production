+++ b/src/delivery.rs
@@ -0,0 +1,140 @@
+//! Delivery: what this service owes a subscriber, and what it does about what it owes.
+//!
+//! An event is accepted, and from that instant every endpoint of its tenant is owed one delivery.
+//! This module is the other half of that promise: what one worker *does* with a piece of work, and
+//! what the service guarantees while it does it.
+//!
+//! The guarantee is **at least once**, and it is a decision with a price:
+//!
+//! * a delivery is forgotten only when the subscriber has taken it (`sent`) or when the worker has
+//!   given up on it (`dead`). Everything in between is still owed, and comes back until one of those
+//!   two is true;
+//! * between the instant a subscriber has taken a request and the instant the row says so there is a
+//!   window: the worker can die, the write can fail. A delivery that returns through that window is
+//!   sent **twice**, and that is allowed — the receiver deduplicates on the delivery id, which is
+//!   why every attempt carries one.
+//!
+//! The argument for that guarantee, and what it costs, is written down in
+//! `docs/adr/0001-at-least-once.md`: a decision a reader can disagree with is worth more than a
+//! sentence buried in a comment.
+//!
+//! Two shapes in this file are decisions rather than taste:
+//!
+//! * **the port is a trait, and its future is boxed.** The worker holds `&dyn Sender`, because what
+//!   a deployment talks to is not a compile-time parameter, and a trait's `async fn` is not
+//!   dispatchable through a trait object. One allocation per attempt is the price of the seam —
+//!   the same trade `mailer/1.13-email-port` made for email;
+//! * **an attempt has two outcomes, not a hundred status codes.** The worker decides between "try
+//!   again" and "stop" and nothing else. What a 404 or a refused connection means is the *adapter's*
+//!   judgement (`relay/2.7-outbound-client`), and it arrives here as [`SendError::Retryable`] or
+//!   [`SendError::Permanent`].
+
+use std::fmt;
+use std::future::Future;
+use std::pin::Pin;
+
+use sqlx::PgPool;
+use uuid::Uuid;
+
+use crate::domain::EndpointUrl;
+use crate::error::Error;
+use crate::events::Event;
+
+/// One attempt: what a subscriber is sent, and what makes this attempt identifiable.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SendRequest {
+    /// The delivery row this attempt is for. Stable across attempts, which is what makes it the
+    /// receiver's deduplication key.
+    pub delivery: Uuid,
+    /// The event the subscriber is being told about.
+    pub event: Event,
+    /// Which attempt this is, counting from 1.
+    pub attempt: i32,
+    /// Where it goes.
+    pub url: EndpointUrl,
+}
+
+/// What a subscriber answered when it took the delivery.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Receipt {
+    /// The status the subscriber answered with.
+    pub status: u16,
+}
+
+/// Why an attempt failed, in the only two categories the worker acts on.
+///
+/// The words are kept: they end up in `last_error`, and the sentence an operator reads at 3 a.m. is
+/// the difference between "the subscriber is gone" and "the subscriber was busy".
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SendError {
+    /// Trying again cannot help (a subscriber that answered "never send this again", a target this
+    /// service is not allowed to talk to). The delivery is buried.
+    Permanent(String),
+    /// The attempt failed for a reason that may pass (a timeout, a connection refused, a 5xx). The
+    /// delivery is owed again, later.
+    Retryable(String),
+}
+
+impl SendError {
+    /// The reason, as it will be written down.
+    #[must_use]
+    pub fn reason(&self) -> &str {
+        match self {
+            SendError::Permanent(why) | SendError::Retryable(why) => why,
+        }
+    }
+}
+
+impl fmt::Display for SendError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            SendError::Permanent(why) => write!(f, "permanent: {why}"),
+            SendError::Retryable(why) => write!(f, "retryable: {why}"),
+        }
+    }
+}
+
+/// The port: everything this service needs from "something that can hand a request to a subscriber".
+///
+/// `Debug` is a supertrait so that a value holding one can still be printed; `Send + Sync + 'static`
+/// are what a trait object moved between threads and held across `await` points needs.
+pub trait Sender: Send + Sync + fmt::Debug + 'static {
+    /// Hand one attempt to the subscriber.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`SendError::Retryable`] when another attempt may succeed, and
+    /// [`SendError::Permanent`] when it may not. Which of the two an adapter reports is the
+    /// adapter's judgement; what the worker does about it is this module's.
+    fn send(
+        &self,
+        request: SendRequest,
+    ) -> Pin<Box<dyn Future<Output = Result<Receipt, SendError>> + Send + '_>>;
+}
+
+/// What one turn of the worker did.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Tick {
+    /// How many deliveries the claim handed to this worker.
+    pub claimed: usize,
+    /// How many the subscriber took.
+    pub sent: usize,
+    /// How many failed in a way that is worth another attempt.
+    pub retried: usize,
+    /// How many this worker gave up on.
+    pub dead: usize,
+    /// How many attempts could not be written down because the row was no longer this worker's to
+    /// record. Not a failure of the delivery: a fact about the worker that has to be visible.
+    pub lost: usize,
+}
+
+/// One turn of the worker: claim a batch, attempt each delivery, write down what happened.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the claim or one of the records fails. A failure here is not a
+/// lost delivery: the row is wherever the last write left it, and the next turn finds it again.
+pub async fn tick(pool: &PgPool, sender: &dyn Sender, worker: &str) -> Result<Tick, Error> {
+    let _ = (pool, sender, worker);
+    todo!("step relay/2.6-at-least-once")
+}
