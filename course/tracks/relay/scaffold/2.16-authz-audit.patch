+++ b/src/audit.rs
@@ -0,0 +1,100 @@
+//! The audit trail: one row per privileged decision, and a way to read it back.
+//!
+//! A log line is written for a person watching a process; an audit row is written for a question
+//! asked months later — "who moved this, and what did we decide about it" — and the two are
+//! different artifacts. The log rotates, it goes to a collector with its own retention, and it
+//! holds whatever the format of the day holds. The trail is a table in the database the service
+//! already owns, filtered by the same tenant rule as every other table, and it survives the
+//! process that wrote it.
+//!
+//! Two decisions shape this module, and both are about *when*:
+//!
+//! * **the row is written before the action runs, not after.** The reason is the failure the trail
+//!   exists for: a process that dies halfway through a privileged action has to have left a row
+//!   saying that it was about to do it. A trail written afterwards is silent in exactly the case
+//!   somebody will want it for. What the row says is therefore a *decision*, not an outcome — and
+//!   a decision is a fact whether or not the action it authorized then succeeded;
+//! * **a trail that cannot be written refuses the action.** [`record`] answers with an error and
+//!   the caller does not run the handler: "we act only on what we can account for" is the only
+//!   version of an audit trail that is worth having, and it is testable, which the weaker version
+//!   is not.
+//!
+//! What is deliberately *not* here: the API key, the signing secret, the payload, and the request
+//! headers. A trail that quotes the credential it is about is a second copy of the credential, in
+//! a table with a longer retention than the one it was stolen from. The actors are named by tenant
+//! and role, and the target is the route that was asked for, not the body that was sent.
+
+use chrono::{DateTime, Utc};
+use sqlx::PgPool;
+use uuid::Uuid;
+
+use crate::authz::{Action, Decision, Role};
+use crate::domain::{TenantId, TenantName};
+use crate::error::Error;
+
+/// How many rows one page of the trail holds when the caller does not ask.
+pub const DEFAULT_LIMIT: i64 = 50;
+/// The most one page may hold.
+pub const MAX_LIMIT: i64 = 200;
+
+/// One decision about to be acted on, on its way into the table.
+///
+/// Borrowed rather than owned: the caller has the request's id and the route in hand, and a
+/// structure that copied them would be a second place for them to be wrong.
+#[derive(Debug, Clone, Copy)]
+pub struct Entry<'a> {
+    /// The tenant whose request this was.
+    pub tenant: TenantId,
+    /// The role it acted with — the answer to "as what", which is not always the same question as
+    /// "who".
+    pub role: Role,
+    /// What it asked to do.
+    pub action: Action,
+    /// What it asked it of: the route, with the id it named when it named one.
+    pub target: &'a str,
+    /// What the matrix decided.
+    pub decision: Decision,
+    /// The correlation id of the request, so a row and a log line can be tied together.
+    pub request_id: &'a str,
+}
+
+/// One row of the trail, as the API reads it back.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Record {
+    /// Identity of the row.
+    pub id: Uuid,
+    /// The tenant that acted.
+    pub tenant: TenantName,
+    /// The role it acted with.
+    pub role: Role,
+    /// The action, as its stable token.
+    pub action: String,
+    /// What the action was aimed at.
+    pub target: String,
+    /// The decision, as its stable token: `allow`, or the reason it was refused.
+    pub decision: String,
+    /// The correlation id of the request that produced it.
+    pub request_id: String,
+    /// When the decision was written.
+    pub at: DateTime<Utc>,
+}
+
+/// Write one row: the decision about a privileged action, before the action runs.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the row cannot be written. The caller lets that end the
+/// request rather than acting on it.
+pub async fn record(pool: &PgPool, entry: &Entry<'_>) -> Result<(), Error> {
+    todo!("step relay/2.16-authz-audit")
+}
+
+/// The calling tenant's trail, newest first.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the rows cannot be read, including a row this service would
+/// not have written (an action or a role token it does not know).
+pub async fn list(pool: &PgPool, tenant: TenantId, limit: i64) -> Result<Vec<Record>, Error> {
+    todo!("step relay/2.16-authz-audit")
+}
