+/// Why a target is not one this service will deliver to.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Refusal {
+    /// The authority is not one a delivery can be made to: it cannot be split into a
+    /// host and a port.
+    Authority(String),
+    /// The authority carries credentials (`http://user@host/`). A subscriber's URL is
+    /// not a place to put a password, and the credentials hide the host from every
+    /// reader of the URL — including a check that reads the wrong side of the `@`.
+    Credentials(String),
+    /// The host is a name that can only mean this machine, or the network it is on.
+    Name(String),
+    /// The address is one no delivery has any business reaching.
+    Address {
+        /// The address that was refused.
+        address: IpAddr,
+        /// What kind of address it is.
+        class: Class,
+    },
+}
