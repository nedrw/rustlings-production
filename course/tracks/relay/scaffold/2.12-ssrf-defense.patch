+/// Where a name becomes addresses: the seam that makes "resolved once" observable.
+///
+/// A port rather than a call to `tokio::net::lookup_host` inside the client, for the
+/// reason every port in this service exists: a test cannot ask a real name service
+/// to answer one thing and then another, and the property this step is about is
+/// exactly the difference between the two. The future is boxed for the same reason
+/// [`crate::delivery::Sender`]'s is: a trait's `async fn` is not dispatchable
+/// through a trait object.
+pub trait Resolver: Send + Sync + fmt::Debug + 'static {
+    /// Every address `host` answers with right now, in the order they should be
+    /// tried.
+    ///
+    /// # Errors
+    ///
+    /// Returns a sentence when the name service could not be asked at all. That is a
+    /// *failure*, not a refusal: it says nothing about the target, and the attempt
+    /// is worth repeating.
+    fn resolve(
+        &self,
+        host: &str,
+        port: u16,
+    ) -> Pin<Box<dyn Future<Output = Result<Vec<SocketAddr>, String>> + Send + '_>>;
+}
