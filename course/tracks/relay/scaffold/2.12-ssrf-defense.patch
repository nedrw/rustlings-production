+/// The class of an address, as far as a delivery is concerned.
+///
+/// The classes exist because a refusal has to be able to say *which* rule it broke:
+/// "169.254.169.254" is not refused for being an address, it is refused for being a
+/// cloud provider's metadata endpoint, and that sentence is what an operator reads
+/// at three in the morning.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Class {
+    /// An address on the public internet: the only class a delivery is for.
+    Public,
+    /// The machine talking to itself: `127.0.0.0/8`, `::1`.
+    Loopback,
+    /// A network that is not on the public internet and is not one of the three
+    /// classes below — RFC 1918, carrier-grade NAT, multicast, the blocks reserved
+    /// for documentation and benchmarking, and IPv6 unique-local (`fc00::/7`).
+    Private,
+    /// A network that exists on one link: `169.254.0.0/16`, `fe80::/10`.
+    LinkLocal,
+    /// The address a cloud provider answers its instance metadata on, which is the
+    /// one address in this file that hands out credentials.
+    Metadata,
+}
