+    pool: &PgPool,
+    delivery: Uuid,
+    why: &str,
+    next_attempt_at: DateTime<Utc>,
+) -> Result<bool, Error> {
+    let _ = (pool, delivery, why, next_attempt_at);
+    todo!("step relay/2.5-atomic-claim")
+}
