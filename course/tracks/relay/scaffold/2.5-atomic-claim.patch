+/// Give up on a delivery: it will not be attempted again, and `why` is what an operator reads.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the update fails.
+pub async fn mark_dead(pool: &PgPool, delivery: Uuid, why: &str) -> Result<bool, Error> {
+    let _ = (pool, delivery, why);
+    todo!("step relay/2.5-atomic-claim")
+}
