+    let _ = (pool, delivery);
+    todo!("step relay/2.5-atomic-claim")
+}
+
+/// Record a failed attempt: the row is owed again at `next_attempt_at`, and `attempts` grows.
+///
+/// The instant is a parameter rather than `now()` plus something: how long to wait is the worker's
+/// retry policy (step `relay/2.8-retry-budget`), and a test can put the instant in the past instead
+/// of waiting for it.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the update fails.
