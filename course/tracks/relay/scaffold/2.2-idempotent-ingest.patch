+//! Events: what this service accepts, and the rule that accepting the same thing twice changes
+//! nothing at all.
+//!
+//! Step `relay/2.2-idempotent-ingest` implements it. An event is a `kind` (what happened) and a
+//! `payload` (the JSON a subscriber will be handed), and the caller's `Idempotency-Key` is a
+//! promise: two requests carrying the same key are one event. The service holds the other half of
+//! that promise — the event is stored once, and the caller that sends it again is answered with the
+//! event it already sent, *as it sent it then*, rather than with an error or with a second row.
+//!
+//! The table is yours to write (`migrations/0003_events.sql`); the step's body says what it has to
+//! hold, and the spec asks the database itself, so how it is written down is judged too.
+
+use chrono::{DateTime, Utc};
+use sqlx::PgPool;
+use uuid::Uuid;
+
+use crate::domain::TenantId;
+use crate::error::Error;
+
+/// An event this service has taken responsibility for.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Event {
+    /// Identity of the event, generated by this service: the caller's idempotency key is not one,
+    /// and two tenants may use the same key.
+    pub id: Uuid,
+    /// The tenant that sent it.
+    pub tenant_id: TenantId,
+    /// What the event is about (`invoice.paid`).
+    pub kind: String,
+    /// The JSON the tenant wants delivered, as it was sent.
+    pub payload: serde_json::Value,
+    /// When this service accepted it.
+    pub received_at: DateTime<Utc>,
+}
+
+/// What one call to [`ingest`] did.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Ingested {
+    /// The event is new: it is stored now, and this is it.
+    Accepted(Event),
+    /// The tenant used this key before: the event below is the one it sent *then*.
+    Replayed(Event),
+}
+
+impl Ingested {
+    /// The event, whether it was accepted now or earlier.
+    #[must_use]
+    pub fn event(&self) -> &Event {
+        match self {
+            Ingested::Accepted(event) | Ingested::Replayed(event) => event,
+        }
+    }
+
+    /// `true` when this key had already been stored.
+    #[must_use]
+    pub fn was_replayed(&self) -> bool {
+        matches!(self, Ingested::Replayed(_))
+    }
+}
+
+/// Store one event, or answer with the one this tenant already stored under `idempotency_key`.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the row cannot be written or read back. A key this tenant has
+/// already used is not an error: it is [`Ingested::Replayed`].
+pub async fn ingest(
+    pool: &PgPool,
+    tenant: TenantId,
+    idempotency_key: &str,
+    kind: &str,
+    payload: &serde_json::Value,
+) -> Result<Ingested, Error> {
+    let _ = (pool, tenant, idempotency_key, kind, payload);
+    todo!("step relay/2.2-idempotent-ingest")
+}
