@@ -0,0 +1,112 @@
+//! Ordering: one delivery at a time per endpoint, and every other endpoint in parallel.
+//!
+//! A subscriber that is handed two events of the same kind in the wrong order has to sort them
+//! itself, and most of them cannot. A worker that serializes its whole queue to keep one
+//! subscriber's events in order gives that subscriber's slowness to every other subscriber, and one
+//! that runs everything at once turns a burst of retries into a burst of requests at a target that
+//! just came back. This module is the middle: **a lane per endpoint**.
+//!
+//! Three shapes in this file are decisions rather than taste:
+//!
+//! * **the key is the endpoint, not the tenant.** A tenant's endpoints are independent receivers
+//!   (a tenant with two webhooks is two integrations), and the thing that must not be asked twice at
+//!   once is the endpoint's server;
+//! * **a lane is held for the attempt, not for the turn.** The hold ends when the attempt answers —
+//!   including when it fails, times out, or the task that held it is dropped. Anything longer is a
+//!   lock, and a lock held by a request that never answers is the whole queue waiting on one
+//!   subscriber;
+//! * **the lanes are per process.** Two processes delivering to the same endpoint do not see each
+//!   other's lanes, so what this guarantees is *one worker per endpoint at a time*. Across
+//!   processes, ordering is a question of partitioning (which worker owns which endpoint) or of a
+//!   lock in the database, and that is a decision for `relay/2.15-shutdown-leases` and beyond.
+//!
+//! The lane is where fairness comes from as well: a turn hands one task to *every* delivery it
+//! claimed, and each task waits for its own endpoint's lane. The first attempt of every endpoint is
+//! therefore in flight before any endpoint's second one starts, which is what keeps a slow endpoint
+//! from eating a turn.
+//!
+//! **This file is the scaffold**: the types are here, and the two functions this step is about
+//! answer `todo!()`, so the spec fails here until they are written.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use sqlx::PgPool;
+
+use crate::backoff::Budget;
+use crate::delivery::{Sender, Tick};
+use crate::error::Error;
+
+/// One lane per endpoint, shared by every turn every worker in this process runs.
+///
+/// `Clone` is not implemented on purpose: a lane set is one per process (or one per worker that
+/// means to be ordered against itself), and copying it would quietly give two halves of a worker
+/// their own lanes and no ordering at all.
+#[derive(Debug, Default)]
+pub struct Lanes {
+    /// One gate per endpoint somebody is holding or waiting for.
+    gates: Mutex<HashMap<String, Arc<tokio::sync::Mutex<()>>>>,
+}
+
+impl Lanes {
+    /// No lanes, nobody holding anything.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Wait for this endpoint's lane, and hold it for as long as the answer takes.
+    ///
+    /// The wait is fair (whoever asked first gets the lane first), and it is a wait on a *lane*:
+    /// another endpoint's lane is not affected by this one, which is the whole reason this is a map
+    /// of mutexes rather than a mutex.
+    pub async fn enter(&self, endpoint: &str) -> Lane<'_> {
+        todo!("step relay/2.9-ordering: one lane per endpoint, first come first served")
+    }
+
+    /// How many endpoints have a gate right now.
+    ///
+    /// A number that has to come back down: a worker that keeps a gate for every endpoint it has
+    /// ever talked to grows with its tenants' URL history, and a spec of this step checks that it
+    /// does not.
+    pub fn known(&self) -> usize {
+        todo!("step relay/2.9-ordering: how many endpoints are being kept apart right now")
+    }
+}
+
+/// One endpoint's lane, held for as long as this value lives.
+///
+/// Dropping it lets the next attempt to that endpoint in — and a lane nobody holds is not worth an
+/// entry in [`Lanes`], which is what the gate here is for: the set has to be able to ask whether
+/// this lane is the only thing left keeping its gate alive.
+#[derive(Debug)]
+pub struct Lane<'a> {
+    /// The set this lane came from.
+    lanes: &'a Lanes,
+    /// Which endpoint this lane is.
+    endpoint: String,
+    /// The gate itself, held here as well as in the set.
+    gate: Arc<tokio::sync::Mutex<()>>,
+    /// The permit, held but never read: dropping it is what lets the next attempt in.
+    _held: tokio::sync::OwnedMutexGuard<()>,
+}
+
+/// One turn of the worker across every endpoint at once.
+///
+/// The claim is `relay/2.5-atomic-claim`'s, one attempt per delivery is `relay/2.8-retry-budget`'s,
+/// and what this function adds is the schedule: a task per claimed delivery, every task waiting for
+/// its own endpoint's lane.
+///
+/// # Errors
+///
+/// Returns [`Error::Database`] when the claim or a record fails, and [`Error::Delivery`] when a
+/// task ends without an answer (a panic, or a runtime that is shutting down).
+pub async fn spread(
+    pool: &PgPool,
+    sender: Arc<dyn Sender>,
+    worker: &str,
+    lanes: Arc<Lanes>,
+    budget: &Budget,
+) -> Result<Tick, Error> {
+    todo!("step relay/2.9-ordering: a turn with one lane per endpoint")
+}
