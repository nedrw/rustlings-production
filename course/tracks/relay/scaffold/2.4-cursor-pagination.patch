+    /// Returns [`Error::BadRequest`] when the text is not a cursor this service issued.
+    pub fn parse(text: &str) -> Result<Self, Error> {
+        let _ = text;
+        todo!("step relay/2.4-cursor-pagination")
+    }
+
+    /// The text form, as the API hands it out and takes it back.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+/// One page request, exactly as `GET /events` received it.
+///
+/// The parameters are kept as text on purpose: "a size within `1..=MAX_LIMIT`" and "a cursor this
+/// service issued" are decided by the query that needs them, so one place answers what makes a
+/// request usable for the whole route.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Query {
+    /// `limit=`, when the caller asked for a size.
+    pub limit: Option<String>,
+    /// `cursor=`, when the caller asked to continue from somewhere.
+    pub cursor: Option<String>,
+    /// `kind=`, when the caller wants one kind of event.
+    pub kind: Option<String>,
+}
+
+/// One page of a tenant's events, newest first.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Page {
+    /// The events in this page, in the order the cursor continues from.
+    pub events: Vec<Event>,
+    /// Where the next page starts, or `None` when this page is the end of the stream.
+    pub next: Option<Cursor>,
+}
+
