diff --git a/migrations/0006_dead_letters.sql b/migrations/0006_dead_letters.sql
new file mode 100644
index 0000000..53722c4
--- /dev/null
+++ b/migrations/0006_dead_letters.sql
@@ -0,0 +1,24 @@
+-- A delivery this service has given up on is still something somebody has to be able to read, and
+-- the history of *why* has to survive the day somebody replays it: one row per life a delivery lost.
+--
+-- `deliveries.state = 'dead'` says which deliveries are not coming back (`relay/2.5-atomic-claim`);
+-- this table is the story behind that state — how many attempts the life that ended had burned, and
+-- what the subscriber said — and a replay only adds to it: the old lives stay, stamped with the
+-- instant they were undone.
+create table dead_letters (
+    id bigserial primary key,
+    delivery_id uuid not null references deliveries (id) on delete cascade,
+    attempts integer not null,
+    reason text not null,
+    died_at timestamptz not null default now(),
+    replayed_at timestamptz,
+    constraint dead_letters_counts_a_life check (attempts >= 1)
+);
+
+-- The history is read one delivery at a time (a replay stamps it; a listing renders it), so the
+-- index is on the delivery and the order the rows were written in.
+create index dead_letters_delivery_idx on dead_letters (delivery_id, id);
+
+-- The listing is "the dead letters of one tenant", and a tenant's table holds everything it ever
+-- owed: a partial index keeps that listing from walking the deliveries it is not about.
+create index deliveries_dead_idx on deliveries (state, created_at, id) where state = 'dead';
